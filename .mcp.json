{
  "mcpServers": {
    "notebooklm": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "notebooklm-mcp@latest"
      ],
      "env": {
        "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium"
      }
    },
    "pal": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "cd /home/alex/pal-mcp-server && uv run python server.py"
      ],
      "env": {}
    },
    "gemini": {
      "type": "stdio",
      "command": "/home/alex/.local/bin/gemini-mcp",
      "args": [],
      "env": {}
    }
  }
}
