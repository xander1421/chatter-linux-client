<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: the dynamic shortcuts ShareTargets publishes (a few recent
     chats, by name) appear in other apps' share sheets as targets for
     MainActivity. The category ties a shortcut to this target. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.chatter.client.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.chatter.client.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
