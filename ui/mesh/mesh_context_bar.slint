// A compact action or status notice above the open mesh conversation.
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { MeshGlobal } from "mesh_global.slint";

export component MeshContextBar inherits Rectangle {
    property <bool> can-turn-on: !MeshGlobal.mesh-on;
    property <string> message:
        MeshGlobal.notice != "" ? MeshGlobal.notice
      : !MeshGlobal.mesh-on ? "Mesh is off"
      : MeshGlobal.radio-down == "bluetooth-off" ? "Bluetooth is off"
      : MeshGlobal.active-kind == "private-channel" && MeshGlobal.private-rekey-pending
            ? "Waiting for the creator to rotate the group key"
      : MeshGlobal.active-kind == "dm" && !MeshGlobal.active-reachable
            ? "No route to this person · waiting for a carrier"
      : "";
    height: 40px;
    background: Colors.surface;

    Rectangle {
        x: Spacing.md;
        y: Spacing.xs;
        width: parent.width - Spacing.md * 2;
        height: parent.height - Spacing.xs * 2;
        border-radius: Spacing.radius-full;
        background: Colors.primary.with-alpha(0.10);
        HorizontalLayout {
            padding-left: Spacing.md;
            padding-right: Spacing.md;
            spacing: Spacing.sm;
            VerticalLayout {
                alignment: center;
                Image {
                    source: Icons.radio;
                    width: 15px;
                    height: 15px;
                    colorize: Colors.primary;
                }
            }
            Text {
                text: root.message;
                color: Colors.text-secondary;
                font-size: Typography.xs;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                accessible-role: text;
                accessible-label: root.message;
            }
            if root.can-turn-on: Rectangle {
                width: 62px;
                height: parent.height;
                Text {
                    text: "Turn On";
                    color: Colors.primary;
                    font-size: Typography.xs;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Turn on mesh";
                    y: -Spacing.xs;
                    height: Spacing.button-height;
                    clicked => { MeshGlobal.set-mesh-on(true); }
                }
            }
            if MeshGlobal.notice != "" && !root.can-turn-on: Rectangle {
                width: 24px;
                height: parent.height;
                Text {
                    text: "×";
                    color: Colors.text-muted;
                    font-size: Typography.base;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Dismiss mesh notice";
                    y: -Spacing.xs;
                    height: Spacing.button-height;
                    clicked => { MeshGlobal.notice = ""; }
                }
            }
        }
    }
}
