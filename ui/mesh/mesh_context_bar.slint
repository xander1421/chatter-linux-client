// The strip above a mesh conversation.
//
// Four things a server chat never has to say, said once, quietly, in the one
// place the user is already looking:
//
//   1. this works with no server and no internet;
//   2. the connectivity signal is a peer count, and zero is normal;
//   3. exactly which geohash cell is being published with each message;
//   4. delivery is best-effort and may be deferred by hours.
//
// Every value here comes from `MeshGlobal`, which Rust fills from
// `chatter-core`. The bar chooses wording, never facts.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { MeshGlobal } from "mesh_global.slint";

export component MeshContextBar inherits Rectangle {
    // What this scope is, in one line.
    property <string> scope-line:
        MeshGlobal.active-kind == "geohash"
            ? "#" + MeshGlobal.active-scope + " · public to everyone in this area"
      : MeshGlobal.active-kind == "room"
            ? "Public mesh room · everyone in radio range"
      : MeshGlobal.active-verified
            ? "Encrypted one to one · key verified"
            : "Encrypted one to one · nickname unverified";

    // Peers, as a count. Never a dot, never red — zero is a normal state of a
    // mesh, not a failure of one.
    //
    // The radio being *down* is the exception, and the only thing here that is
    // actionable: styling it like "none nearby" would hide the one state the
    // user can do something about behind the one they cannot.
    property <bool> radio-down: !MeshGlobal.radio-running;
    property <string> peer-line:
        root.radio-down ? "Bluetooth off"
      : MeshGlobal.peer-count == 0 ? "none nearby"
      : MeshGlobal.peer-count == 1 ? "1 nearby"
      : MeshGlobal.peer-count + " nearby";

    // A geohash cell does not ride the radio — it is published to Nostr relays,
    // which are servers reached over the internet. Claiming otherwise here is
    // the kind of over-promise that gets someone to rely on it offline.
    property <string> standing-claim:
        MeshGlobal.active-kind == "geohash"
            ? (MeshGlobal.relay-count == 0
                ? "Public cell · no relay connected"
              : MeshGlobal.relay-count == 1
                ? "Public cell · carried by 1 relay"
                : "Public cell · carried by " + MeshGlobal.relay-count + " relays")
            : "No server, no internet";

    // What "sent" means here, which is not what it means anywhere else.
    property <string> delivery-line:
        MeshGlobal.active-kind == "dm"
            ? (MeshGlobal.active-reachable
                ? "Best-effort: sent means handed on, not arrived."
                : "No route right now. What you send is kept and offered to passing devices — it may arrive hours later.")
            : (MeshGlobal.peer-count == 0
                ? "Nobody is in range. What you send waits to be carried, and may be read hours from now."
                : "Best-effort: reaches whoever is in range now, and travels further as devices move.");

    // Deliberately not a fixed height. This strip carries the only explanation
    // of why an empty room is normal, and on a phone a single elided line cuts
    // that sentence in half — leaving "Nobody is in range" and dropping the part
    // that says so is expected.
    min-height: 46px;
    background: Colors.surface.with-alpha(0.7);

    // Bottom hairline, matching the other in-chat strips.
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Colors.neo-highlight;
    }

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: Spacing.sm;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Image {
                source: Icons.radio;
                width: 16px;
                height: 16px;
                colorize: root.radio-down ? Colors.warning
                    : MeshGlobal.peer-count > 0 ? Colors.glow-cyan
                    : Colors.text-muted;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.scope-line;
                    color: Colors.text-secondary;
                    font-size: Typography.xs;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if MeshGlobal.active-kind == "geohash": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.globe;
                        width: 12px;
                        height: 12px;
                        colorize: Colors.text-muted;
                    }
                }
            }

            // Split, so that the peer count is never what gets truncated.
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.standing-claim + " · ";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    overflow: elide;
                }
                Text {
                    text: root.peer-line;
                    color: root.radio-down ? Colors.warning : Colors.text-muted;
                    font-size: Typography.xs;
                    font-weight: root.radio-down ? 600 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            Text {
                text: root.delivery-line;
                color: Colors.text-muted;
                font-size: Typography.xs;
                wrap: word-wrap;
            }

            // A send that failed outright. This is the only place it can be
            // seen on a phone: the sidebar copy renders inside the expanded
            // sidebar, which is collapsed by default on a narrow screen — so a
            // failed send was reported to nobody. Tap to dismiss.
            if MeshGlobal.notice != "": Rectangle {
                height: notice-text.preferred-height + 6px;
                border-radius: Spacing.radius-sm;
                background: notice-touch.has-hover
                    ? Colors.warning.with-alpha(0.16)
                    : Colors.warning.with-alpha(0.10);
                notice-text := Text {
                    x: 6px;
                    y: 3px;
                    width: parent.width - 12px;
                    text: MeshGlobal.notice;
                    color: Colors.warning;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: MeshGlobal.notice;
                }
                notice-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        MeshGlobal.notice = "";
                    }
                }
            }
        }

        // Leaving a cell belongs next to the cell name, where it is
        // unambiguous which one is being left.
        if MeshGlobal.active-kind == "geohash": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: leave-label.preferred-width + Spacing.md;
                // The control that stops you broadcasting your location should
                // not be the hardest thing on the screen to hit.
                height: Spacing.touch-target-min;
                border-radius: Spacing.radius-sm;
                background: leave-touch.has-hover ? Colors.surface-hover : transparent;
                border-width: 1px;
                border-color: Colors.neo-highlight;
                leave-label := Text {
                    text: "Leave cell";
                    color: leave-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    font-size: Typography.xxs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                leave-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { MeshGlobal.leave-geohash(MeshGlobal.active-scope); }
                }
            }
        }
    }
}
