import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { HoldArea } from "../components/hold_area.slint";

export component MeshListItem inherits Rectangle {
    in property <string> title: "";
    in property <string> kind: "room";
    in property <string> scope: "";
    in property <string> timestamp: "";
    in property <int> unread-count: 0;
    in property <bool> reachable: false;
    in property <bool> verified: false;
    in property <bool> muted: false;
    in property <bool> blocked: false;
    in property <string> binding-label: "";
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <bool> touch: false;
    callback clicked();
    callback leave();
    callback toggle-mute();
    property <bool> menu-open: false;

    property <string> secondary: root.kind == "geohash" ? "Public · " + root.scope
        : root.kind == "room" ? "Everyone in radio range"
        : root.kind == "channel" ? "Public to nearby listeners"
        : root.kind == "private-channel" ? "Invited devices · encrypted"
        : root.binding-label == "Verified Chatter contact" ? "Verified Chatter contact"
        : root.reachable ? "Encrypted · nearby" : "Waiting for a carrier";
    property <image> glyph: root.kind == "private-channel" ? Icons.lock
        : root.kind == "geohash" || root.kind == "channel" ? Icons.hash
        : root.kind == "dm" ? Icons.user : Icons.radio;

    height: (root.collapsed ? Spacing.touch-target-min : root.touch ? Spacing.row-height-touch : max(56px, Spacing.row-height-desktop))
        + (root.menu-open ? Spacing.button-height : 0px);
    background: root.selected ? Colors.row-selected : row-touch.has-hover ? Colors.surface-control-hover : Colors.surface-section;
    accessible-role: button;
    accessible-label: root.title + ", " + root.secondary;
    accessible-action-default => { root.clicked(); }
    row-touch := HoldArea {
        mouse-cursor: pointer;
        enabled-for-touch: root.touch;
        clicked => { if !self.hold-fired { root.clicked(); } }
        held => { if root.kind == "channel" { root.menu-open = true; } }
    }
    keys := FocusScope {
        width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }

    if !root.collapsed: HorizontalLayout {
        height: root.height - (root.menu-open ? Spacing.button-height : 0px);
        padding-left: Spacing.md; padding-right: Spacing.md; spacing: Spacing.md; alignment: center;
        Rectangle {
            width: 40px; height: 40px;
            border-radius: root.kind == "private-channel" ? Spacing.radius-md : Spacing.radius-full;
            background: root.kind == "private-channel" ? Colors.group-accent
                : root.kind == "dm" ? Colors.avatar-blue : Colors.tint-strong;
            Image {
                source: root.glyph; width: 20px; height: 20px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                colorize: root.kind == "private-channel" || root.kind == "dm" ? Colors.on-action : Colors.primary;
            }
            if root.kind == "dm" && root.reachable: Rectangle {
                width: 10px; height: 10px; x: parent.width - self.width; y: parent.height - self.height;
                border-radius: Spacing.radius-full; background: Colors.online;
                border-width: 2px; border-color: Colors.surface-section;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: Spacing.xxs;
            HorizontalLayout {
                spacing: Spacing.xs;
                Text {
                    text: root.title; color: Colors.text-primary; font-size: Typography.base;
                    font-weight: Typography.semibold; overflow: elide;
                    horizontal-stretch: 1; vertical-alignment: center;
                }
                if root.kind == "dm" && (root.verified || root.binding-label == "Verified Chatter contact"): Image {
                    source: Icons.shield; width: 14px; height: 14px; colorize: Colors.success;
                }
                if root.muted: Image { source: Icons.bell-off; width: 14px; height: 14px; colorize: Colors.text-muted; }
            }
            Text { text: root.secondary; color: Colors.text-muted; font-size: Typography.sm; overflow: elide; wrap: no-wrap; }
        }
        VerticalLayout {
            alignment: center; spacing: Spacing.xs;
            if root.timestamp != "": Text {
                text: root.timestamp; color: Colors.text-muted; font-size: Typography.xs; horizontal-alignment: right;
            }
            if root.unread-count > 0: Rectangle {
                width: max(20px, unread-label.preferred-width + 12px); height: 20px;
                border-radius: Spacing.radius-full; background: Colors.action-fill;
                unread-label := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.on-action; font-size: Typography.xs; font-weight: Typography.bold;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
    if root.collapsed: TooltipArea {
        width: 100%; height: 100%; tooltip-text: root.title; tooltip-enabled: true; placement: "right";
        Image {
            source: root.glyph; width: 20px; height: 20px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            colorize: root.selected ? Colors.primary : Colors.text-secondary;
        }
        if root.unread-count > 0: Rectangle {
            width: Spacing.badge-sm; height: Spacing.badge-sm;
            x: parent.width / 2 + Spacing.xs; y: Spacing.xs;
            border-radius: Spacing.radius-full; background: Colors.action-fill;
        }
    }
    if root.menu-open: HorizontalLayout {
        y: root.height - Spacing.button-height;
        height: Spacing.button-height;
        padding-left: Spacing.md; padding-right: Spacing.md; spacing: Spacing.sm;
        Rectangle {
            horizontal-stretch: 1; border-radius: Spacing.radius-md;
            background: mute-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
            Text { text: root.muted ? "Unmute" : "Mute"; color: Colors.primary;
                font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; }
            mute-touch := TouchArea {
                mouse-cursor: pointer; accessible-role: button;
                accessible-label: root.muted ? "Unmute channel" : "Mute channel";
                clicked => { root.menu-open = false; root.toggle-mute(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1; border-radius: Spacing.radius-md;
            background: leave-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
            Text { text: "Leave"; color: Colors.danger; font-size: Typography.sm;
                horizontal-alignment: center; vertical-alignment: center; }
            leave-touch := TouchArea {
                mouse-cursor: pointer; accessible-role: button; accessible-label: "Leave channel";
                clicked => { root.menu-open = false; root.leave(); }
            }
        }
    }
    if !root.collapsed: Rectangle {
        x: 64px; y: root.height - 1px; width: root.width - 64px; height: 1px;
        background: Colors.divider;
    }
}
