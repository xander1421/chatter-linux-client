import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Toggle } from "../components/toggle.slint";
import { MeshGlobal } from "mesh_global.slint";
import { MeshListItem } from "mesh_list_item.slint";

export component MeshList inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> touch: false;
    callback setup-requested();
    property <string> device-count: MeshGlobal.peer-count == 1 ? "1 device nearby"
        : MeshGlobal.peer-count + " devices nearby";
    property <string> relay-count: MeshGlobal.relay-count == 1 ? "1 relay"
        : MeshGlobal.relay-count + " relays";
    property <string> status-title: !MeshGlobal.mesh-on ? "Mesh Off"
        : MeshGlobal.radio-down == "bluetooth-off" ? "Bluetooth Off" : "Mesh On";
    property <string> status-detail: !MeshGlobal.mesh-on ? "Radio off · " + root.relay-count
        : MeshGlobal.radio-down == "bluetooth-off" ? "Bluetooth is off · " + root.relay-count
        : !MeshGlobal.radio-running ? "Radio unavailable · " + root.relay-count
        : root.device-count + " · " + root.relay-count;

    height: content.preferred-height;
    background: transparent;
    content := VerticalLayout {
        spacing: Spacing.lg;
        if root.collapsed: Rectangle {
            height: Spacing.touch-target-min;
            border-radius: Spacing.radius-md;
            background: rail-touch.has-hover ? Colors.surface-hover : transparent;
            Image {
                source: Icons.radio; width: Spacing.button-icon; height: Spacing.button-icon;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                colorize: MeshGlobal.mesh-on ? Colors.primary : Colors.text-muted;
            }
            rail-touch := TouchArea {
                mouse-cursor: pointer; accessible-role: button; accessible-label: "Mesh setup";
                clicked => { MeshGlobal.open-setup(); }
            }
        }
        if !root.collapsed: VerticalLayout {
            spacing: Spacing.lg;
            HorizontalLayout {
                padding-left: Spacing.lg; padding-right: Spacing.sm; spacing: Spacing.xs;
                Text {
                    text: "Mesh"; color: Colors.text-primary; font-size: Typography.xxxl;
                    font-weight: Typography.bold; vertical-alignment: center; horizontal-stretch: 1;
                }
                Rectangle {
                    width: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    height: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    border-radius: Spacing.radius-full;
                    background: compose-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                    Image {
                        source: Icons.plus; width: Spacing.header-glyph; height: Spacing.header-glyph;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }
                    compose-touch := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: "New mesh conversation";
                        clicked => { MeshGlobal.open-sheet("mesh-compose"); }
                    }
                }
                Rectangle {
                    width: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    height: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    border-radius: Spacing.radius-full;
                    background: setup-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                    Image {
                        source: Icons.settings; width: Spacing.header-glyph; height: Spacing.header-glyph;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }
                    setup-touch := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: "Mesh settings";
                        clicked => { MeshGlobal.open-setup(); }
                    }
                }
            }
            VerticalLayout {
                padding-left: Spacing.lg; padding-right: Spacing.lg;
                Rectangle {
                    height: status-content.preferred-height;
                    border-radius: Spacing.radius-lg; background: Colors.surface-section;
                    status-content := VerticalLayout {
                        padding: Spacing.md; spacing: Spacing.sm;
                        HorizontalLayout {
                            spacing: Spacing.md; alignment: center;
                            Rectangle {
                                width: 40px; height: 40px; border-radius: Spacing.radius-full;
                                background: Colors.tint-weak;
                                Image {
                                    source: Icons.radio; width: 20px; height: 20px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    colorize: Colors.primary;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: Spacing.xxs;
                                Text {
                                    text: root.status-title; color: Colors.text-primary;
                                    font-size: Typography.base; font-weight: Typography.semibold;
                                }
                                Text {
                                    text: root.status-detail;
                                    color: Colors.text-muted; font-size: Typography.sm; overflow: elide;
                                }
                            }
                            Toggle {
                                checked: MeshGlobal.mesh-on;
                                accessible-text: "Mesh radio";
                                toggled(value) => { MeshGlobal.set-mesh-on(value); }
                            }
                        }
                        if MeshGlobal.notice != "": Text {
                            text: MeshGlobal.notice; color: Colors.text-muted;
                            font-size: Typography.xs; wrap: word-wrap;
                        }
                    }
                }
            }
            if MeshGlobal.pending-private-id != "": VerticalLayout {
                padding-left: Spacing.lg; padding-right: Spacing.lg;
                Rectangle {
                    height: invitation-content.preferred-height;
                    border-radius: Spacing.radius-lg; background: Colors.surface-section;
                    invitation-content := VerticalLayout {
                        padding: Spacing.md; spacing: Spacing.md;
                        Text {
                            text: MeshGlobal.pending-private-peer + " invited you to " + MeshGlobal.pending-private-name;
                            color: Colors.text-primary; font-size: Typography.sm;
                            font-weight: Typography.semibold; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Spacing.sm;
                            Rectangle {
                                height: Spacing.button-height; horizontal-stretch: 1;
                                border-radius: Spacing.radius-md;
                                background: decline-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                                Text { text: "Decline"; color: Colors.text-secondary; font-size: Typography.sm;
                                    horizontal-alignment: center; vertical-alignment: center; }
                                decline-touch := TouchArea {
                                    mouse-cursor: pointer; accessible-role: button; accessible-label: "Decline mesh invitation";
                                    clicked => { MeshGlobal.decide-private-invitation(MeshGlobal.pending-private-id, false); }
                                }
                            }
                            Rectangle {
                                height: Spacing.button-height; horizontal-stretch: 1;
                                border-radius: Spacing.radius-md; background: Colors.action-fill;
                                Text { text: "Join"; color: Colors.on-action; font-size: Typography.sm;
                                    font-weight: Typography.semibold; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea {
                                    mouse-cursor: pointer; accessible-role: button; accessible-label: "Join mesh invitation";
                                    clicked => { MeshGlobal.decide-private-invitation(MeshGlobal.pending-private-id, true); }
                                }
                            }
                        }
                    }
                }
            }
            if MeshGlobal.nearby-peers.length > 0: VerticalLayout {
                spacing: Spacing.sm;
                HorizontalLayout {
                    padding-left: Spacing.lg;
                    Text {
                        text: "NEARBY"; color: Colors.text-muted; font-size: Typography.xs;
                        font-weight: Typography.semibold;
                    }
                }
                Flickable {
                    height: 80px;
                    viewport-width: nearby-row.preferred-width + Spacing.lg * 2;
                    nearby-row := HorizontalLayout {
                        x: Spacing.lg; spacing: Spacing.md;
                        for peer[index] in MeshGlobal.nearby-peers: VerticalLayout {
                            width: 64px; spacing: Spacing.xs; alignment: start;
                            Rectangle {
                                width: 52px; height: 52px; border-radius: Spacing.radius-full;
                                background: Math.mod(index, 3) == 0 ? Colors.avatar-teal
                                    : Math.mod(index, 3) == 1 ? Colors.avatar-blue : Colors.avatar-purple;
                                Text {
                                    text: peer.name.to-uppercase();
                                    width: 16px; height: 28px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    color: Colors.on-action; font-size: Typography.xxl;
                                    font-weight: Typography.semibold; overflow: clip;
                                }
                                TouchArea {
                                    mouse-cursor: pointer; accessible-role: button;
                                    accessible-label: "Open nearby mesh peer " + peer.name;
                                    clicked => { MeshGlobal.open-peer(peer.id); }
                                }
                            }
                            Text {
                                text: peer.name; width: 64px; color: Colors.text-secondary;
                                font-size: Typography.xs; overflow: elide; horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
            if MeshGlobal.conversations.length == 0: VerticalLayout {
                padding-left: Spacing.lg; padding-right: Spacing.lg;
                spacing: Spacing.md; alignment: center;
                Rectangle {
                    width: 64px; height: 64px; border-radius: Spacing.radius-full;
                    background: Colors.tint-weak;
                    Image {
                        source: Icons.message-circle; width: 30px; height: 30px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }
                }
                Text { text: "No mesh conversations"; color: Colors.text-primary;
                    font-size: Typography.base; font-weight: Typography.semibold; horizontal-alignment: center; }
                Text { text: "Create a group or start a nearby conversation.";
                    color: Colors.text-muted; font-size: Typography.sm; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle {
                    height: Spacing.button-height; border-radius: Spacing.radius-md;
                    background: Colors.action-fill;
                    Text { text: "New Group"; color: Colors.on-action; font-size: Typography.sm;
                        font-weight: Typography.semibold; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: "New mesh group";
                        clicked => { MeshGlobal.open-sheet("mesh-compose"); }
                    }
                }
            }
            if MeshGlobal.conversations.length > 0: VerticalLayout {
                spacing: Spacing.lg;
                for section in ["private-channel", "channel", "dm"]: VerticalLayout {
                    visible: section-rows.preferred-height > 0px;
                    padding-left: Spacing.lg; padding-right: Spacing.lg; spacing: Spacing.sm;
                    Text {
                        text: section == "private-channel" ? "GROUPS"
                            : section == "channel" ? "CHANNELS" : "DIRECT MESSAGES";
                        color: Colors.text-muted; font-size: Typography.xs;
                        font-weight: Typography.semibold;
                    }
                    Rectangle {
                        height: section-rows.preferred-height;
                        border-radius: Spacing.radius-lg; clip: true;
                        background: Colors.surface-section;
                        section-rows := VerticalLayout {
                            for item in MeshGlobal.conversations: MeshListItem {
                                visible: section == "private-channel" ? item.kind == "private-channel"
                                    : section == "channel" ? item.kind == "room" || item.kind == "channel" || item.kind == "geohash"
                                    : item.kind == "dm";
                                title: item.title; kind: item.kind; scope: item.scope;
                                timestamp: item.timestamp; unread-count: item.unread-count;
                                reachable: item.reachable; verified: item.verified; muted: item.muted;
                                blocked: item.blocked; binding-label: item.binding-label;
                                selected: item.is-selected; touch: root.touch;
                                clicked => { MeshGlobal.conversation-selected(item.id); }
                                leave => { MeshGlobal.leave-channel(item.scope); }
                                toggle-mute => { MeshGlobal.toggle-channel-mute(item.scope); }
                            }
                        }
                    }
                }
            }
        }
        if root.collapsed: VerticalLayout {
            for item in MeshGlobal.conversations: MeshListItem {
                title: item.title; kind: item.kind; scope: item.scope;
                timestamp: item.timestamp; unread-count: item.unread-count;
                reachable: item.reachable; verified: item.verified; muted: item.muted;
                blocked: item.blocked; binding-label: item.binding-label;
                selected: item.is-selected; collapsed: true; touch: root.touch;
                clicked => { MeshGlobal.conversation-selected(item.id); }
            }
        }
    }
}
