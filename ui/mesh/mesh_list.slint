// The mesh section of the sidebar.
//
// Reads `MeshGlobal` directly rather than taking properties, the same way the
// sidebar reads `AnonMode` / `TorStatus` — the whole section is one runtime
// flag away from not existing, and threading five properties through
// `app.slint` for that would be worse.
//
// The caption line under the header is the feature's one standing claim: no
// server, no internet, and a peer count in place of a connection dot. Zero
// peers reads as "none nearby", never as an error.

import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { MeshGlobal } from "mesh_global.slint";
import { MeshListItem } from "mesh_list_item.slint";

export component MeshList inherits Rectangle {
    in property <bool> collapsed: false;
    // Touch density: the wipe row and the join field are full touch targets.
    in property <bool> touch: false;

    property <bool> expanded: true;
    property <bool> joining: false;
    property <bool> confirming-wipe: false;

    // Transparent on purpose: the sidebar tints its own surface (anon mode),
    // and a section that repainted over that would fight it.
    VerticalLayout {
        // ── Section header ──
        // Same header rhythm as the sidebar's own sections — see sidebar.slint.
        if !root.collapsed: Rectangle {
            height: Spacing.button-height + Spacing.md;
            HorizontalLayout {
                padding-top: Spacing.md;
                padding-left: Spacing.sm;
                padding-right: Spacing.xs;

                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: pointer;
                    clicked => { root.expanded = !root.expanded; }
                    HorizontalLayout {
                        padding-left: Spacing.xxs;
                        spacing: Spacing.xs;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.chevron-right;
                                width: 10px;
                                height: 10px;
                                colorize: Colors.text-muted;
                                transform-rotation: root.expanded ? 90deg : 0deg;
                                animate transform-rotation { duration: Materials.motion-standard; easing: Materials.spring; }
                            }
                        }
                        Text {
                            text: "Mesh";
                            color: Colors.text-muted;
                            font-size: Typography.xs2;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Join a geohash cell.
                Rectangle {
                    width: Spacing.button-height;
                    horizontal-stretch: 0;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: Spacing.radius-sm;
                        background: join-touch.has-hover ? Colors.surface-hover : transparent;
                        transform-scale-x: join-touch.pressed ? 88% : 100%;
                        transform-scale-y: join-touch.pressed ? 88% : 100%;
                        animate transform-scale-x { duration: join-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                        animate transform-scale-y { duration: join-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                        Image {
                            source: Icons.plus;
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: join-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                        }
                    }
                    join-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.joining = !root.joining;
                            root.expanded = true;
                        }
                    }
                }
            }
        }

        // ── The standing claim: serverless, and a peer count for connectivity ──
        if !root.collapsed && root.expanded: Rectangle {
            height: 20px * Appearance.text-grow;
            clip: true;
            caption := HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                spacing: Spacing.xs;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.radio;
                        width: 11px;
                        height: 11px;
                        colorize: !MeshGlobal.mesh-on ? Colors.text-muted
                            : !MeshGlobal.radio-running ? Colors.warning
                            : MeshGlobal.peer-count > 0 ? Colors.primary
                            : Colors.text-muted;
                    }
                }
                // What the mesh needs, not what this device lacks: worded as a
                // capability so it is not read as a status while the server is up.
                Text {
                    // Short enough for the 240px sidebar beside the peer count;
                    // the long form ("Works without server or internet") elided
                    // mid-sentence on every desktop frame.
                    text: "Works offline · ";
                    wrap: no-wrap;
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    overflow: elide;
                }
                // Zero peers is normal and stays muted; a radio that is *off* is
                // the one state here the user can act on, so it is the one
                // allowed a warning colour.
                // A switched-off mesh has no radio running either; that is the
                // user's own choice, not Bluetooth being off (chat_header agrees).
                property <bool> radio-down: MeshGlobal.mesh-on && !MeshGlobal.radio-running;
                Text {
                    text: !MeshGlobal.mesh-on ? "mesh off"
                        : caption.radio-down
                            ? (MeshGlobal.radio-down == "bluetooth-off" ? "Bluetooth off" : "mesh unavailable")
                        : MeshGlobal.peer-count == 0 ? "none nearby"
                        : MeshGlobal.peer-count == 1 ? "1 nearby"
                        : MeshGlobal.peer-count + " nearby";
                    color: caption.radio-down ? Colors.warning : Colors.text-muted;
                    font-weight: caption.radio-down ? 600 : 400;
                    font-size: Typography.xs;
                    wrap: no-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        // ── Join-a-cell input ──
        if !root.collapsed && root.joining: Rectangle {
            height: root.touch ? Spacing.touch-target-min + Spacing.xs : 34px;
            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                padding-bottom: Spacing.xs;

                Rectangle {
                    height: root.touch ? Spacing.touch-target-min : 28px;
                    background: Colors.inset;
                    border-radius: Spacing.radius-sm;
                    border-width: Spacing.stroke;
                    border-color: cell-input.has-focus ? Colors.primary : Colors.border;

                    HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.xs;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.hash;
                                width: 11px;
                                height: 11px;
                                colorize: Colors.text-muted;
                            }
                        }

                        cell-input := TextInput {
                            horizontal-stretch: 1;
                            color: Colors.text-primary;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                MeshGlobal.join-geohash(self.text);
                                self.text = "";
                                root.joining = false;
                            }
                        }
                    }

                    if cell-input.text == "": Text {
                        x: Spacing.sm + 11px + 4px;
                        height: 100%;
                        text: "geohash cell, e.g. u4pruy";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── Rows ──
        if root.expanded: VerticalLayout {
            padding-left: Spacing.xs;
            padding-right: Spacing.xs;
            spacing: Spacing.xxs;

            for item in MeshGlobal.conversations: MeshListItem {
                title: item.title;
                kind: item.kind;
                scope: item.scope;
                timestamp: item.timestamp;
                unread-count: item.unread-count;
                reachable: item.reachable;
                verified: item.verified;
                binding-label: item.binding-label;
                selected: item.is-selected;
                collapsed: root.collapsed;
                touch: root.touch;

                clicked => { MeshGlobal.conversation-selected(item.id); }
            }
        }

        // Nothing at all yet — say what this is instead of leaving a blank gap.
        if !root.collapsed && root.expanded && MeshGlobal.conversations.length == 0: Rectangle {
            height: empty-text.preferred-height + 12px;
            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                padding-bottom: Spacing.sm;
                empty-text := Text {
                    text: "Nothing here yet. Messages arrive over Bluetooth from whoever is nearby, and can be relayed onwards hours later.";
                    color: Colors.text-muted;
                    font-size: Typography.xxs;
                    wrap: word-wrap;
                }
            }
        }

        // ── Panic wipe ── two taps, because it cannot be undone. Says exactly
        // what goes and what stays: the chatter account is untouched.
        if !root.collapsed && root.expanded && !root.confirming-wipe: Rectangle {
            height: root.touch ? Spacing.touch-target-min : 22px;
            clip: true;
            HorizontalLayout {
                padding-left: Spacing.md;
                alignment: start;
                // The hit box is the row, not the glyphs of a 12px label.
                Rectangle {
                    width: wipe-label.preferred-width + Spacing.sm * 2;
                    accessible-role: button;
                    accessible-label: "Wipe mesh data";
                    accessible-action-default => { root.confirming-wipe = true; }
                    wipe-label := Text {
                        x: Spacing.sm;
                        width: max(0px, parent.width - Spacing.sm * 2);
                        height: parent.height;
                        text: "Wipe mesh data…";
                        wrap: no-wrap;
                        overflow: elide;
                        color: wipe-touch.has-hover ? Colors.error : Colors.text-muted;
                        font-size: Typography.xxs;
                        vertical-alignment: center;
                    }
                    wipe-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirming-wipe = true; }
                    }
                }
            }
        }
        if !root.collapsed && root.expanded && root.confirming-wipe: Rectangle {
            height: confirm-layout.preferred-height;
            confirm-layout := VerticalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                padding-bottom: Spacing.sm;
                spacing: Spacing.xs;
                Text {
                    text: "Erase the mesh identity, every mesh message, carried mail and favourites from this device? Your chatter account and its messages are not touched. This cannot be undone.";
                    color: Colors.warning;
                    font-size: Typography.xxs;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: start;
                    Text {
                        text: "Wipe";
                        color: Colors.error;
                        font-size: Typography.xs;
                        font-weight: 600;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.confirming-wipe = false;
                                MeshGlobal.panic-wipe();
                            }
                        }
                    }
                    Text {
                        text: "Cancel";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirming-wipe = false; }
                        }
                    }
                }
            }
        }
    }
}
