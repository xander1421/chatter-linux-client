import { Appearance } from "../theme/appearance.slint";
import { Button } from "../components/button.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Toggle } from "../components/toggle.slint";
import { MeshGlobal } from "mesh_global.slint";
import { MeshListItem } from "mesh_list_item.slint";

export component MeshList inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> touch: false;
    property <string> relay-count: @tr("{n} relay" | "{n} relays" % MeshGlobal.relay-count);
    property <string> status-title: !MeshGlobal.mesh-on ? @tr("Mesh off")
        : MeshGlobal.radio-down == "bluetooth-off" ? @tr("Bluetooth off") : @tr("Mesh on");
    property <string> status-detail: !MeshGlobal.mesh-on ? @tr("Radio off · {n} relay" | "Radio off · {n} relays" % MeshGlobal.relay-count)
        : MeshGlobal.radio-down == "bluetooth-off" ? @tr("Bluetooth is off · {n} relay" | "Bluetooth is off · {n} relays" % MeshGlobal.relay-count)
        : !MeshGlobal.radio-running ? @tr("Radio unavailable · {n} relay" | "Radio unavailable · {n} relays" % MeshGlobal.relay-count)
        : root.relay-count;

    height: content.preferred-height;
    background: transparent;
    content := VerticalLayout {
        spacing: Spacing.panel-gutter;
        if root.collapsed: Rectangle {
            height: Spacing.touch-target-min;
            border-radius: Spacing.radius-md;
            background: rail-touch.has-hover ? Colors.surface-hover : transparent;
            Image {
                source: Icons.radio; width: Spacing.button-icon; height: Spacing.button-icon;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                colorize: Colors.text-muted;
            }
            rail-touch := TouchArea {
                mouse-cursor: pointer; accessible-role: button; accessible-label: @tr("Mesh setup");
                clicked => { MeshGlobal.open-setup(); }
            }
        }
        if !root.collapsed: VerticalLayout {
            spacing: Spacing.panel-gutter;
            HorizontalLayout {
                padding-left: Spacing.lg; padding-right: Spacing.sm; spacing: Spacing.xs;
                Text {
                    text: @tr("Mesh"); color: Colors.text-primary; font-size: Typography.xxxl;
                    font-weight: Typography.bold; vertical-alignment: center; horizontal-stretch: 1;
                }
            }
            VerticalLayout {
                padding-left: Spacing.panel-gutter; padding-right: Spacing.panel-gutter;
                Rectangle {
                    height: status-content.preferred-height;
                    border-radius: Spacing.radius-panel; background: Colors.surface-card;
                    status-content := VerticalLayout {
                        padding: Spacing.sm; spacing: Spacing.sm;
                        HorizontalLayout {
                            spacing: Spacing.md;
                            Rectangle {
                                width: 40px; height: 40px; border-radius: Spacing.radius-full;
                                background: transparent;
                                border-width: 1px;
                                border-color: Colors.border;
                                Image {
                                    source: Icons.radio; width: 20px; height: 20px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    colorize: Colors.text-secondary;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: Spacing.xxs;
                                Text {
                                    text: root.status-title; color: Colors.text-primary;
                                    font-size: Typography.base; font-weight: Typography.semibold;
                                }
                                Text {
                                    text: root.status-detail;
                                    color: Colors.text-muted; font-size: Typography.sm; wrap: word-wrap;
                                }
                            }
                            Toggle {
                                checked: MeshGlobal.mesh-on;
                                accessible-text: @tr("Mesh radio");
                                toggled(value) => { MeshGlobal.set-mesh-on(value); }
                            }
                        }
                        if MeshGlobal.notice != "": Text {
                            text: MeshGlobal.notice; color: Colors.text-muted;
                            font-size: Typography.xs; wrap: word-wrap;
                        }
                    }
                }
            }
            if MeshGlobal.pending-private-id != "": VerticalLayout {
                padding-left: Spacing.panel-gutter; padding-right: Spacing.panel-gutter;
                Rectangle {
                    height: invitation-content.preferred-height;
                    border-radius: Spacing.radius-panel; background: Colors.surface-card;
                    invitation-content := VerticalLayout {
                        padding: Spacing.sm; spacing: Spacing.md;
                        Text {
                            text: @tr("{0} invited you to {1}", MeshGlobal.pending-private-peer, MeshGlobal.pending-private-name);
                            color: Colors.text-primary; font-size: Typography.sm;
                            font-weight: Typography.semibold; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Spacing.sm;
                            Button {
                                text: @tr("Decline");
                                label: @tr("Decline mesh invitation");
                                variant: "secondary";
                                touch: root.touch;
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-control;
                                clicked => { MeshGlobal.decide-private-invitation(MeshGlobal.pending-private-id, false); }
                            }
                            Button {
                                text: @tr("Join");
                                label: @tr("Join mesh invitation");
                                variant: "primary";
                                touch: root.touch;
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-control;
                                clicked => { MeshGlobal.decide-private-invitation(MeshGlobal.pending-private-id, true); }
                            }
                        }
                    }
                }
            }
            if MeshGlobal.conversations.length == 0: VerticalLayout {
                padding-left: Spacing.panel-gutter; padding-right: Spacing.panel-gutter;
                spacing: Spacing.md; alignment: center;
                Rectangle {
                    width: 64px; height: 64px; border-radius: Spacing.radius-full;
                    background: transparent;
                    border-width: 1px;
                    border-color: Colors.border;
                    Image {
                        source: Icons.message-circle; width: 30px; height: 30px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }
                }
                Text { text: @tr("No mesh conversations"); color: Colors.text-primary;
                    font-size: 14px * Appearance.text-scale; font-weight: Typography.semibold; horizontal-alignment: center; }
                Text {
                    text: @tr("Create a private group or pair a contact in Mesh settings.");
                    color: Colors.text-muted; font-size: Typography.xs; horizontal-alignment: center; wrap: word-wrap; }
                Button {
                    text: @tr("New group");
                    label: @tr("New mesh group");
                    variant: "primary";
                    touch: root.touch;
                    border-radius: Spacing.radius-control;
                    clicked => { MeshGlobal.open-sheet("mesh-compose"); }
                }
            }
            if MeshGlobal.conversations.length > 0: VerticalLayout {
                spacing: Spacing.panel-gutter;
                if MeshGlobal.group-conversations.length > 0: VerticalLayout {
                    padding-left: Spacing.panel-gutter; padding-right: Spacing.panel-gutter; spacing: Spacing.sm;
                    Text {
                        text: @tr("GROUPS"); color: Colors.text-muted; font-size: 11px * Appearance.text-scale;
                        letter-spacing: self.font-size * 0.06;
                        font-weight: Typography.semibold;
                    }
                    Rectangle {
                        border-radius: Spacing.radius-panel; clip: true;
                        background: Colors.surface-card;
                        VerticalLayout {
                            padding: Spacing.sm;
                            for item[i] in MeshGlobal.group-conversations: MeshListItem {
                                title: item.title; kind: item.kind; scope: item.scope;
                                timestamp: item.timestamp; unread-count: item.unread-count;
                                reachable: item.reachable; verified: item.verified; muted: item.muted;
                                blocked: item.blocked; binding-label: item.binding-label;
                                selected: item.is-selected; touch: root.touch;
                                last: i == MeshGlobal.group-conversations.length - 1;
                                clicked => { MeshGlobal.conversation-selected(item.id); }
                                leave => { MeshGlobal.leave-channel(item.scope); }
                                toggle-mute => { MeshGlobal.toggle-channel-mute(item.scope); }
                            }
                        }
                    }
                }
                if MeshGlobal.channel-conversations.length > 0: VerticalLayout {
                    padding-left: Spacing.panel-gutter; padding-right: Spacing.panel-gutter; spacing: Spacing.sm;
                    Text {
                        text: @tr("CHANNELS"); color: Colors.text-muted; font-size: 11px * Appearance.text-scale;
                        letter-spacing: self.font-size * 0.06;
                        font-weight: Typography.semibold;
                    }
                    Rectangle {
                        border-radius: Spacing.radius-panel; clip: true;
                        background: Colors.surface-card;
                        VerticalLayout {
                            padding: Spacing.sm;
                            for item[i] in MeshGlobal.channel-conversations: MeshListItem {
                                title: item.title; kind: item.kind; scope: item.scope;
                                timestamp: item.timestamp; unread-count: item.unread-count;
                                reachable: item.reachable; verified: item.verified; muted: item.muted;
                                blocked: item.blocked; binding-label: item.binding-label;
                                selected: item.is-selected; touch: root.touch;
                                last: i == MeshGlobal.channel-conversations.length - 1;
                                clicked => { MeshGlobal.conversation-selected(item.id); }
                                leave => { MeshGlobal.leave-channel(item.scope); }
                                toggle-mute => { MeshGlobal.toggle-channel-mute(item.scope); }
                            }
                        }
                    }
                }
                if MeshGlobal.dm-conversations.length > 0: VerticalLayout {
                    padding-left: Spacing.panel-gutter; padding-right: Spacing.panel-gutter; spacing: Spacing.sm;
                    Text {
                        text: @tr("DIRECT MESSAGES"); color: Colors.text-muted; font-size: 11px * Appearance.text-scale;
                        letter-spacing: self.font-size * 0.06;
                        font-weight: Typography.semibold;
                    }
                    Rectangle {
                        border-radius: Spacing.radius-panel; clip: true;
                        background: Colors.surface-card;
                        VerticalLayout {
                            padding: Spacing.sm;
                            for item[i] in MeshGlobal.dm-conversations: MeshListItem {
                                title: item.title; kind: item.kind; scope: item.scope;
                                timestamp: item.timestamp; unread-count: item.unread-count;
                                reachable: item.reachable; verified: item.verified; muted: item.muted;
                                blocked: item.blocked; binding-label: item.binding-label;
                                selected: item.is-selected; touch: root.touch;
                                last: i == MeshGlobal.dm-conversations.length - 1;
                                clicked => { MeshGlobal.conversation-selected(item.id); }
                                leave => { MeshGlobal.leave-channel(item.scope); }
                                toggle-mute => { MeshGlobal.toggle-channel-mute(item.scope); }
                            }
                        }
                    }
                }
            }
        }
        if root.collapsed: VerticalLayout {
            for item in MeshGlobal.conversations: MeshListItem {
                title: item.title; kind: item.kind; scope: item.scope;
                timestamp: item.timestamp; unread-count: item.unread-count;
                reachable: item.reachable; verified: item.verified; muted: item.muted;
                blocked: item.blocked; binding-label: item.binding-label;
                selected: item.is-selected; collapsed: true; touch: root.touch;
                clicked => { MeshGlobal.conversation-selected(item.id); }
            }
        }
    }
}
