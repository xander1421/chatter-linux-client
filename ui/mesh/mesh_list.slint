// Mesh destination list. Setup lives in MeshSetupSheet.
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { MeshGlobal } from "mesh_global.slint";
import { MeshListItem } from "mesh_list_item.slint";

export component MeshList inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> touch: false;
    callback setup-requested();
    property <bool> expanded: true;
    property <string> status: !MeshGlobal.mesh-on ? "Stopped"
        : !MeshGlobal.radio-running ? "Unavailable"
        : MeshGlobal.peer-count == 0 ? "0 nearby"
        : MeshGlobal.peer-count == 1 ? "1 nearby"
        : MeshGlobal.peer-count + " nearby";

    VerticalLayout {
        spacing: Spacing.xxs;
        if !root.collapsed: Rectangle {
            height: root.touch ? Spacing.touch-target-min : Spacing.button-height;
            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.xs;
                spacing: Spacing.xs;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Spacing.radius-md;
                    background: header-touch.has-hover ? Colors.surface-hover : transparent;
                    transform-scale-x: header-touch.pressed ? 98% : 100%;
                    transform-scale-y: header-touch.pressed ? 96% : 100%;
                    animate transform-scale-x { duration: Materials.motion-standard; easing: Materials.spring; }
                    animate transform-scale-y { duration: Materials.motion-standard; easing: Materials.spring; }
                    HorizontalLayout {
                        padding-left: Spacing.xs;
                        spacing: Spacing.sm;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: Icons.chevron-right;
                                width: 11px; height: 11px;
                                colorize: Colors.text-muted;
                                transform-rotation: root.expanded ? 90deg : 0deg;
                                animate transform-rotation { duration: Materials.motion-standard; easing: Materials.spring; }
                            }
                        }
                        Text {
                            text: "Conversations";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    header-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: root.expanded ? "Collapse mesh conversations" : "Expand mesh conversations";
                        clicked => { root.expanded = !root.expanded; }
                    }
                }
                // The status is read-only and outside every switch hit target.
                Text {
                    text: root.status;
                    color: MeshGlobal.mesh-on && !MeshGlobal.radio-running ? Colors.warning : Colors.text-secondary;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 78px;
                }
                Rectangle {
                    width: root.touch ? Spacing.touch-target-min : Spacing.button-height;
                    height: root.touch ? Spacing.touch-target-min : Spacing.button-height;
                    border-radius: Spacing.radius-md;
                    border-width: 1px;
                    border-color: Colors.border;
                    background: switch-touch.has-hover ? Colors.surface-hover : transparent;
                    Text {
                        text: MeshGlobal.mesh-on ? "On" : "Off";
                        color: MeshGlobal.mesh-on ? Colors.primary : Colors.text-primary;
                        font-size: Typography.xs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    switch-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: MeshGlobal.mesh-on ? "Turn mesh off" : "Turn mesh on";
                        clicked => { MeshGlobal.set-mesh-on(!MeshGlobal.mesh-on); }
                    }
                }
                Rectangle {
                    width: root.touch ? Spacing.touch-target-min : Spacing.button-height;
                    border-radius: Spacing.radius-md;
                    background: setup-touch.has-hover ? Colors.surface-hover : transparent;
                    transform-scale-x: setup-touch.pressed ? 90% : 100%;
                    transform-scale-y: setup-touch.pressed ? 90% : 100%;
                    animate transform-scale-x { duration: Materials.motion-standard; easing: Materials.spring; }
                    animate transform-scale-y { duration: Materials.motion-standard; easing: Materials.spring; }
                    Image {
                        source: Icons.settings;
                        width: Spacing.button-icon;
                        height: Spacing.button-icon;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: setup-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }
                    setup-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Mesh setup";
                        clicked => { root.setup-requested(); }
                    }
                }
            }
        }
        if root.collapsed: Rectangle {
            height: Spacing.touch-target-min;
            border-radius: Spacing.radius-md;
            background: rail-touch.has-hover ? Colors.surface-hover : transparent;
            Image {
                source: Icons.radio;
                width: Spacing.button-icon;
                height: Spacing.button-icon;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: MeshGlobal.mesh-on ? Colors.primary : Colors.text-muted;
            }
            rail-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "Mesh setup, " + root.status;
                clicked => { root.setup-requested(); }
            }
        }
        if !root.collapsed && root.expanded && !MeshGlobal.mesh-on: Rectangle {
            height: root.touch ? Spacing.touch-target-min : Spacing.button-height;
            border-radius: Spacing.radius-md;
            background: turn-on-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
            transform-scale-x: turn-on-touch.pressed ? 98% : 100%;
            transform-scale-y: turn-on-touch.pressed ? 96% : 100%;
            animate transform-scale-x { duration: Materials.motion-standard; easing: Materials.spring; }
            animate transform-scale-y { duration: Materials.motion-standard; easing: Materials.spring; }
            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                Text { text: "Turn on mesh"; color: Colors.text-primary; font-size: Typography.sm; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "Set up  ›"; color: Colors.primary; font-size: Typography.sm; vertical-alignment: center; }
            }
            turn-on-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "Turn on mesh, open setup";
                clicked => { root.setup-requested(); }
            }
        }
        if root.expanded: VerticalLayout {
            padding-left: Spacing.xs;
            padding-right: Spacing.xs;
            spacing: Spacing.xxs;
            for item in MeshGlobal.conversations: MeshListItem {
                title: item.title;
                kind: item.kind;
                scope: item.scope;
                timestamp: item.timestamp;
                unread-count: item.unread-count;
                reachable: item.reachable;
                verified: item.verified;
                muted: item.muted;
                blocked: item.blocked;
                binding-label: item.binding-label;
                selected: item.is-selected;
                collapsed: root.collapsed;
                touch: root.touch;
                clicked => { MeshGlobal.conversation-selected(item.id); }
                leave => { MeshGlobal.leave-channel(item.scope); }
                toggle-mute => { MeshGlobal.toggle-channel-mute(item.scope); }
            }
        }
        if !root.collapsed && root.expanded && MeshGlobal.mesh-on && MeshGlobal.conversations.length == 0: Rectangle {
            height: empty-text.preferred-height + Spacing.md * 2;
            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                empty-text := Text {
                    text: "No mesh conversations yet. Open mesh setup to find nearby people or join a channel.";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                }
            }
        }
        if !root.collapsed && MeshGlobal.nearby-peers.length > 0: VerticalLayout {
            padding-left: Spacing.sm;
            padding-right: Spacing.sm;
            spacing: Spacing.xxs;
            Text {
                text: "Nearby people";
                color: Colors.text-secondary;
                font-size: Typography.sm;
                font-weight: 600;
            }
            for peer in MeshGlobal.nearby-peers: Rectangle {
                height: Spacing.touch-target-min;
                border-radius: Spacing.radius-md;
                background: peer-touch.has-hover ? Colors.surface-hover : transparent;
                HorizontalLayout {
                    padding-left: Spacing.sm;
                    padding-right: Spacing.sm;
                    spacing: Spacing.sm;
                    VerticalLayout {
                        alignment: center;
                        Image { source: Icons.radio; width: 18px; height: 18px; colorize: Colors.text-muted; }
                    }
                    // The name keeps its width; the binding label elides first in a narrow sidebar.
                    Text { text: peer.name; color: Colors.text-primary; font-size: Typography.sm; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        min-width: min(self.preferred-width, 120px); }
                    Text { text: peer.binding-label; color: Colors.text-muted; font-size: Typography.xs; vertical-alignment: center; overflow: elide; }
                }
                peer-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Open nearby mesh peer " + peer.name;
                    clicked => { MeshGlobal.open-peer(peer.id); }
                }
            }
        }
    }
}
