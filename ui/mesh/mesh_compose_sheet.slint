import { Button } from "../components/button.slint";
import { Appearance } from "../theme/appearance.slint";
import { GlassSurface } from "../components/glass_surface.slint";
import { ModalContainer } from "../components/modal_container.slint";
import { Input } from "../components/input.slint";
import { SettingsRow } from "../components/settings_row.slint";
import { MeshGlobal } from "mesh_global.slint";
import { Colors } from "../theme/colors.slint";
import { Icons } from "../theme/icons.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

component ComposeMenuRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> detail;
    in property <color> tint: Colors.primary;
    in property <bool> touch: false;
    callback clicked();
    height: root.touch ? Spacing.list-row-height-touch : 56px;
    background: row-touch.pressed ? Colors.surface-control-hover : row-touch.has-hover ? Colors.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.detail;
    accessible-action-default => { root.clicked(); }
    FocusScope {
        width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: Spacing.md; padding-right: Spacing.md;
        spacing: Spacing.md;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px; height: 40px; border-radius: Spacing.radius-md;
                background: root.tint.with-alpha(0.16);
                Image { source: root.icon; width: Spacing.button-icon; height: Spacing.button-icon;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    colorize: root.tint; }
            }
        }
        VerticalLayout { horizontal-stretch: 1; alignment: center;
            Text { text: root.title; color: Colors.text-primary; font-size: Typography.base;
                font-weight: Typography.semibold; overflow: elide; }
            Text { text: root.detail; color: Colors.text-secondary; font-size: Typography.sm; overflow: elide; }
        }
        Image { source: Icons.chevron-right; width: Spacing.button-icon; image-fit: contain;
            colorize: Colors.text-muted; }
    }
    row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component MeshComposeSheet inherits Rectangle {
    in property <bool> show-modal: false;
    in property <bool> touch: false;
    callback close();
    property <string> page: "menu";
    property <string> group-draft: "";
    property <string> channel-draft: "";
    property <string> invite-draft: "";
    property <string> cell-draft: "";
    function go-back() {
        if root.page == "menu" { root.close(); } else { root.page = "menu"; }
    }
    function submit() {
        if root.page == "group" && root.group-draft != "" {
            if MeshGlobal.create-private-channel(root.group-draft) {
                root.group-draft = "";
            }
        } else if root.page == "channel" && root.channel-draft != "" {
            if MeshGlobal.join-channel(root.channel-draft) {
                root.channel-draft = "";
                root.close();
            }
        } else if root.page == "invite" && root.invite-draft != "" {
            if MeshGlobal.join-private-channel(root.invite-draft) {
                root.invite-draft = "";
                root.close();
            }
        } else if root.page == "cell" && root.cell-draft != "" {
            if MeshGlobal.join-geohash(root.cell-draft) {
                root.cell-draft = "";
                root.close();
            }
        }
    }
    property <bool> can-submit: root.page == "group" ? root.group-draft != ""
        : root.page == "channel" ? root.channel-draft != ""
        : root.page == "invite" ? root.invite-draft != ""
        : root.page == "cell" && root.cell-draft != "";
    property <string> page-title: root.page == "group" ? @tr("New private group")
        : root.page == "channel" ? @tr("Join public channel")
        : root.page == "invite" ? @tr("Join with invite")
        : root.page == "cell" ? @tr("Join location cell") : @tr("compose menu" => "New");

    ModalContainer {
        show: root.show-modal;
        accessible-title: root.page-title;
        modal-width: 500px;
        max-modal-height: 700px;
        fill-height: true;
        close => { root.close(); }
        VerticalLayout {
            padding: Spacing.panel-gutter;
            spacing: Spacing.panel-gutter;
            GlassSurface {
                height: Spacing.touch-target-min + 2 * Spacing.xxs;
                border-radius: Spacing.radius-panel;
                elevation: 0;
                HorizontalLayout {
                    padding: Spacing.xxs;
                    spacing: Spacing.xs;
                    Button {
                        text: root.page == "menu" ? @tr("Cancel") : @tr("Back");
                        variant: "ghost";
                        touch: root.touch;
                        border-radius: Spacing.radius-control;
                        clicked => { root.go-back(); }
                    }
                    Text {
                        text: root.page-title;
                        color: Colors.text-primary;
                        font-size: 14px * Appearance.text-scale;
                        font-weight: Typography.semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.page != "menu": Button {
                        text: root.page == "group" ? @tr("Create") : @tr("Join");
                        disabled: !root.can-submit;
                        touch: root.touch;
                        border-radius: Spacing.radius-control;
                        clicked => { root.submit(); }
                    }
                }
            }
            Flickable {
                width: 100%; vertical-stretch: 1;
                viewport-height: compose-content.preferred-height;
                compose-content := VerticalLayout {
                    width: parent.width;
                    spacing: Spacing.panel-gutter;
                    padding-bottom: Spacing.xl;
                    if root.page == "menu": VerticalLayout {
                        spacing: Spacing.sm;
                        Text { text: "START A CONVERSATION"; color: Colors.text-muted; font-size: 11px * Appearance.text-scale; font-weight: Typography.semibold; letter-spacing: self.font-size * 0.06; }
                        Rectangle {
                            background: Colors.surface-card; border-radius: Spacing.radius-panel;
                            VerticalLayout {
                                ComposeMenuRow { icon: Icons.lock; title: @tr("New private group"); detail: @tr("Invite only");
                                    tint: Colors.text-secondary; touch: root.touch;
                                    clicked => { root.page = "group"; } }
                                if MeshGlobal.public-chat: Rectangle { height: 1px; background: Colors.divider; }
                                if MeshGlobal.public-chat: ComposeMenuRow { icon: Icons.hash; title: @tr("Join public channel"); detail: @tr("Talk with devices nearby"); touch: root.touch;
                                    clicked => { root.page = "channel"; } }
                                Rectangle { height: 1px; background: Colors.divider; }
                                ComposeMenuRow { icon: Icons.link; title: @tr("Join with invite"); detail: @tr("Paste or scan a private invite");
                                    tint: Colors.info; touch: root.touch;
                                    clicked => { root.page = "invite"; } }
                                if MeshGlobal.bridge-mode: Rectangle { height: 1px; background: Colors.divider; }
                                if MeshGlobal.bridge-mode: ComposeMenuRow { icon: Icons.radio; title: @tr("Join location cell"); detail: @tr("Connect through nearby relays");
                                    tint: Colors.accent; touch: root.touch;
                                    clicked => { root.page = "cell"; } }
                            }
                        }
                    }
                    if root.page == "group": VerticalLayout {
                        spacing: Spacing.sm;
                        Rectangle { background: Colors.surface-card; border-radius: Spacing.radius-panel;
                            HorizontalLayout { padding: Spacing.sm; spacing: Spacing.sm;
                                Input { placeholder: @tr("Group name"); text <=> root.group-draft; control-height: Spacing.touch-target-min;
                                    horizontal-stretch: 1; accepted(value) => { root.submit(); } }
                            }
                        }
                        Text {
                            width: parent.width;
                            text: @tr("Only devices you invite can read it. You can add members after creating it.");
                            color: Colors.text-muted; font-size: Typography.sm; wrap: word-wrap; }
                    }
                    if root.page == "channel": VerticalLayout {
                        spacing: Spacing.sm;
                        Rectangle { background: Colors.surface-card; border-radius: Spacing.radius-panel;
                            HorizontalLayout { padding: Spacing.sm;
                                Input { placeholder: "#channel"; text <=> root.channel-draft; control-height: Spacing.touch-target-min;
                                    horizontal-stretch: 1; accepted(value) => { root.submit(); } }
                            }
                        }
                        if MeshGlobal.nearby-channels.length > 0: Text { text: @tr("SEEN NEARBY"); color: Colors.text-muted;
                            font-size: Typography.xs; font-weight: Typography.semibold; letter-spacing: self.font-size * 0.06; }
                        if MeshGlobal.nearby-channels.length > 0: Rectangle {
                            background: Colors.surface-card; border-radius: Spacing.radius-panel;
                            VerticalLayout {
                                for name in MeshGlobal.nearby-channels: SettingsRow {
                                    icon: Icons.hash; title: "#" + name; touch: root.touch;
                                    clicked => { if MeshGlobal.join-channel(name) { root.close(); } }
                                }
                            }
                        }
                    }
                    if root.page == "invite": VerticalLayout {
                        spacing: Spacing.sm;
                        Rectangle { background: Colors.surface-card; border-radius: Spacing.radius-panel;
                            VerticalLayout {
                                HorizontalLayout { padding: Spacing.sm;
                                    Input { placeholder: @tr("Paste private invite"); text <=> root.invite-draft;
                                        control-height: Spacing.touch-target-min; horizontal-stretch: 1;
                                        accepted(value) => { root.submit(); } }
                                }
                                Rectangle { height: 1px; background: Colors.divider; }
                                SettingsRow { icon: Icons.image; title: @tr("Scan QR code"); touch: root.touch;
                                    clicked => { MeshGlobal.open-private-scanner(); } }
                            }
                        }
                    }
                    if root.page == "cell": VerticalLayout {
                        spacing: Spacing.sm;
                        Rectangle { background: Colors.surface-card; border-radius: Spacing.radius-panel;
                            HorizontalLayout { padding: Spacing.sm;
                                Input { placeholder: @tr("Location cell (e.g. u4pruy)"); text <=> root.cell-draft;
                                    control-height: Spacing.touch-target-min; horizontal-stretch: 1;
                                    accepted(value) => { root.submit(); } }
                            }
                        }
                        Text {
                            width: parent.width;
                            text: @tr("Location cells use geohashes and available relays to connect devices in an area.");
                            color: Colors.text-muted; font-size: Typography.sm; wrap: word-wrap; }
                    }
                    if MeshGlobal.notice != "": Text {
                        width: parent.width;
                        text: MeshGlobal.notice; color: Colors.text-secondary;
                        font-size: Typography.sm; wrap: word-wrap; }
                }
            }
        }
    }
}
