    in property <string> code-preview-selected-text <=> app.code-preview-selected-text;
    callback close-code-preview <=> app.close-code-preview;
    callback copy-code <=> app.copy-code;
    callback copy-code-selection <=> app.copy-code-selection;
    callback open-code-external <=> app.open-code-external;
    callback code-preview-pointer-down <=> app.code-preview-pointer-down;
    callback code-preview-pointer-move <=> app.code-preview-pointer-move;
    callback code-preview-pointer-up <=> app.code-preview-pointer-up;

    // ========== PDF preview state ==========
    in-out property <bool> pdf-preview-visible <=> app.pdf-preview-visible;
    in property <string> pdf-preview-filename <=> app.pdf-preview-filename;
    in property <int> pdf-preview-page-count <=> app.pdf-preview-page-count;
    in property <int> pdf-preview-current-page <=> app.pdf-preview-current-page;
    in property <string> pdf-preview-error <=> app.pdf-preview-error;
    in property <image> pdf-preview-image <=> app.pdf-preview-image;
