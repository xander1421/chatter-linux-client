    callback call-toggle-video <=> app.call-toggle-video;
    callback call-toggle-screen-share <=> app.call-toggle-screen-share;
    callback call-end <=> app.call-end;
    callback show-audio-device-picker <=> app.show-audio-device-picker;
    callback show-audio-output-picker <=> app.show-audio-output-picker;
    callback show-screen-source-picker <=> app.show-screen-source-picker;
    callback audio-device-selected <=> app.audio-device-selected;
    callback audio-output-selected <=> app.audio-output-selected;
    callback screen-source-selected <=> app.screen-source-selected;

    // App fills the entire window - explicit sizing ensures width flows to children
    app := App {
        width: root.width;
        height: root.height;
    }
}
