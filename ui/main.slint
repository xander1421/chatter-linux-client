    callback call-end <=> app.call-end;
    callback call-peer-audio-mute-toggle <=> app.call-peer-audio-mute-toggle;
    callback call-peer-video-pause-toggle <=> app.call-peer-video-pause-toggle;
    callback show-audio-device-picker <=> app.show-audio-device-picker;
    callback show-audio-output-picker <=> app.show-audio-output-picker;
    callback show-screen-source-picker <=> app.show-screen-source-picker;
    callback audio-device-selected <=> app.audio-device-selected;
    callback audio-output-selected <=> app.audio-output-selected;
    callback screen-source-selected <=> app.screen-source-selected;


    // ========== Anon mode (PIN gate + toggle) ==========
    in-out property <string> anon-mode-pin <=> app.anon-mode-pin;
    in property <string> anon-mode-pin-error <=> app.anon-mode-pin-error;
    in property <bool> anon-mode-verifying <=> app.anon-mode-verifying;
    callback toggle-anon-mode <=> app.toggle-anon-mode;
    callback submit-anon-mode-pin <=> app.submit-anon-mode-pin;

    // ========== Toast notification properties ==========
    in-out property <bool> toast-visible <=> app.toast-visible;
    in property <string> toast-message <=> app.toast-message;
    in property <string> toast-variant <=> app.toast-variant;

    // Initial keyboard focus goes to `back-scope`. Without this NOTHING has
    // focus on startup, and `WindowInner::process_key_input` only delivers key
    // events to the focus item and its ancestors — so a Back press before the
    // user has tapped a text field would be dropped on the floor, which is the
    // reported bug. Once the user focuses the composer, Back still arrives here
    // because unhandled key events bubble UP the focus chain to this ancestor.
    forward-focus: back-scope;

    // Once a TextInput has had focus, popping the screen it lived on leaves
    // NOTHING focused — and `WindowInner::process_key_input` delivers only to
    // the focus item and its ancestors, so Back is dropped on the floor. The
    // symptom was reproduced from a clean launch every time: open a
    // conversation, type ONE character, Back out to the list, and from then on
    // Back does nothing anywhere — it neither pops a layer nor backgrounds the
    // app, and only a force-stop recovers it (§112y). Re-take focus whenever
    // the conversation pane or a modal closes, which is when the focused text
    // field goes away.
    changed mobile-show-chat => {
        if (!root.mobile-show-chat) {
            back-scope.focus();
            // The pickers belong to the conversation's composer; they are
            // app-level overlays, so leaving the chat has to close them or
            // they float over whatever screen comes next.
            root.composer-gif-picker-visible = false;
            root.composer-emoji-picker-visible = false;
            root.chat-pane-closed();
        }
    }
    // Same hole for the search palette: its field holds focus, and picking a
    // result closes the palette, so Back from the chat it opened did nothing
    // (RC20, 3/3). Back from that chat returns to the list, like the header ←.
    changed unified-search-open => {
        if (!root.unified-search-open) {
            back-scope.focus();
        }
    }
    changed active-modal => {
        root.secure-screen(root.active-modal == "recovery-codes");
        // On open too: taking focus off the composer is what hides the soft
        // keyboard (a TextInput's FocusOut sends InputMethodRequest::Disable),
        // which otherwise stays up over the modal (F78).
        back-scope.focus();
    }
    // Modals scroll their card clear of the keyboard only while it is up
    // (modal_container.slint, §112i), and only the Window can see it.
    changed virtual-keyboard-size => {
        VirtualKeyboard.height = root.virtual-keyboard-size.height;
    }

    // Catches Android's hardware/gesture Back. It wraps `app` so it is an
    // ANCESTOR of every focusable item — that is the only position from which
    // it can see keys a focused TextInput chose not to consume.
    //
    // focus-on-click / focus-on-tab-navigation are both off on purpose: this
    // scope must never take focus AWAY from the composer or a text field. It
    // receives focus from `forward-focus` above and from the two `changed`
    // handlers, and otherwise works purely by event bubbling.
    back-scope := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        key-pressed(event) => {
            if (event.text == Key.Back) {
                root.back-pressed();
                // Always consume. The android backend turns EventAccepted into
                // InputStatus::Handled, which is what stops the framework's
                // default Back (finish the Activity) from also running.
                return accept;
            }
            return reject;
        }

        // Swallow the matching key-up too, WITHOUT re-firing back-pressed.
        // Android's default Back acts on ACTION_UP, so consuming only the press
        // would leave the release for the framework to act on — one physical
        // press then both pops a layer here and runs the default handler.
        key-released(event) => {
            return event.text == Key.Back ? accept : reject;
        }

        // App fills the entire window - explicit sizing ensures width flows to children.
        //
        // Slint 1.15 splits two separate out-props:
        //   * `safe-area-insets`  — system bars only (status bar / nav bar).
        //   * `virtual-keyboard-size.height` — IME height when the keyboard is up.
        // The Android backend feeds them from `WindowInsets.Type.systemBars()` and
        // `WindowInsets.Type.ime()` respectively, so they must both be subtracted
        // from the content area to lift the composer above the keyboard.
        app := App {
            width: root.width;
            height: root.height;
            safe-area-top: root.safe-area-insets.top;
            safe-area-bottom: root.safe-area-insets.bottom + root.virtual-keyboard-size.height;
        }
    }
}
