    callback channel-settings-unban-member <=> app.channel-settings-unban-member;
    callback channel-settings-transfer-ownership <=> app.channel-settings-transfer-ownership;
    callback channel-settings-invite-members <=> app.channel-settings-invite-members;
    callback channel-settings-invite-channel-members <=> app.channel-settings-invite-channel-members;
    callback invite-member-toggle-user <=> app.invite-member-toggle-user;
    callback invite-member-confirm <=> app.invite-member-confirm;
    callback invite-member-search-changed <=> app.invite-member-search-changed;
    callback channel-settings-archive <=> app.channel-settings-archive;
    callback channel-settings-leave <=> app.channel-settings-leave;
    callback channel-settings-delete <=> app.channel-settings-delete;

    // ========== Call callbacks ==========
    callback calls-tab-clicked <=> app.calls-tab-clicked;
    in property <[CallHistoryRow]> call-history-rows <=> app.call-history-rows;
    in property <bool> call-history-loading <=> app.call-history-loading;
    in-out property <string> call-history-filter <=> app.call-history-filter;
    in property <int> missed-call-count <=> app.missed-call-count;
    callback call-history-filter-changed <=> app.call-history-filter-changed;
    callback call-history-open <=> app.call-history-open;
    callback call-history-redial <=> app.call-history-redial;
    callback call-history-clear <=> app.call-history-clear;
    callback accept-incoming-call <=> app.accept-incoming-call;
    callback decline-incoming-call <=> app.decline-incoming-call;
    callback call-toggle-mute <=> app.call-toggle-mute;
    callback call-toggle-speaker <=> app.call-toggle-speaker;
