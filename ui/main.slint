// Chatter Linux Client - Main UI
// Root component for the application

import { App, ChannelListItemData, DMListItemData, PrivateGroupListItemData, MessageItemData, MessageAttachmentData, FriendRequest, ForwardTarget, SessionInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, UserSearchResult, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, ChannelMemberData, PrivateGroupFriend, LocalAIProviderData, CatalogModelData, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData, InviteUser, ReactionEntry, CustomSectionData, SectionConversationData, QuickSwitcherItem } from "app.slint";
import { JarvisGlobal } from "jarvis/jarvis_global.slint";
import { TextFormat } from "chat/message_composer.slint";
import { AnonMode, TorStatus } from "anon_mode/anon_mode_global.slint";
import { MeshGlobal, MeshConversationData } from "mesh/mesh_global.slint";
import { Typography } from "theme/typography.slint";

// Re-export all types for Rust binding
export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, MessageItemData, MessageAttachmentData, FriendRequest, ForwardTarget, SessionInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, UserSearchResult, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, ChannelMemberData, PrivateGroupFriend, LocalAIProviderData, CatalogModelData, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData, InviteUser, ReactionEntry, CustomSectionData, SectionConversationData, QuickSwitcherItem }
export { JarvisGlobal }
export { TextFormat }
export { AnonMode }
export { TorStatus }
// bitchat mesh: runtime feature flag + the sidebar row shape. Written from
// `bin_ui::features::mesh`; inert when the `mesh` Cargo feature is off.
export { MeshGlobal, MeshConversationData }

export component MainWindow inherits Window {
    title: "Chatter";
    icon: @image-url("../assets/icon-256.png");
    // Responsive: allow narrow widths for phones (360dp minimum)
    min-width: 360px;
    min-height: 480px;
    preferred-width: 800px;
    preferred-height: 600px;
    default-font-family: Typography.font-family;
    default-font-size: Typography.sm;

    // Expose App properties through MainWindow for Rust binding
    // ========== Safe area insets (Android status bar / nav bar) ==========
    in property <length> safe-area-top <=> app.safe-area-top;
    in property <length> safe-area-bottom <=> app.safe-area-bottom;

    in property <bool> is-mobile-platform <=> app.is-mobile-platform;

    // ========== View routing ==========
    in-out property <string> current-view <=> app.current-view;

    // ========== Connection status ==========
    in property <string> connection-status <=> app.connection-status;
    in property <int> connection-reconnect-attempt <=> app.connection-reconnect-attempt;
    in property <int> connection-queue-count <=> app.connection-queue-count;

    in property <bool> server-unreachable <=> app.server-unreachable;

    // ========== Working without an account ==========
    in property <bool> account-free-surfaces <=> app.account-free-surfaces;
    in property <bool> is-signed-in <=> app.is-signed-in;
    callback continue-without-account <=> app.continue-without-account;

    // ========== Loading page properties ==========
    in property <string> loading-message <=> app.loading-message;
    in property <string> loading-secondary-message <=> app.loading-secondary-message;

    // ========== Auth page properties ==========
    in-out property <string> login-username <=> app.login-username;
    in-out property <string> login-password <=> app.login-password;
    in-out property <string> login-pin <=> app.login-pin;
    in property <bool> login-loading <=> app.login-loading;
    in property <string> login-error <=> app.login-error;

    in-out property <string> register-display-name <=> app.register-display-name;
    in-out property <string> register-username <=> app.register-username;
    in-out property <string> register-password <=> app.register-password;
    in-out property <string> register-confirm-password <=> app.register-confirm-password;
    in-out property <string> register-pin <=> app.register-pin;
    in-out property <string> register-server-url <=> app.register-server-url;
    in property <bool> register-loading <=> app.register-loading;
    in property <string> register-error <=> app.register-error;
    in property <image> register-avatar-source <=> app.register-avatar-source;
    in property <bool> register-has-avatar <=> app.register-has-avatar;
    in-out property <int> register-selected-default-idx <=> app.register-selected-default-idx;
    in property <string> register-username-status <=> app.register-username-status;
    in property <int> register-password-strength <=> app.register-password-strength;
    in property <int> register-pin-strength <=> app.register-pin-strength;
    callback register-select-avatar <=> app.register-select-avatar;
    callback register-select-default-avatar <=> app.register-select-default-avatar;
    callback register-check-username <=> app.register-check-username;
    callback register-password-changed <=> app.register-password-changed;
    callback register-pin-changed <=> app.register-pin-changed;

    // ========== Recovery codes modal properties ==========
    in property <[string]> recovery-codes <=> app.recovery-codes;
    callback recovery-codes-confirmed <=> app.recovery-codes-confirmed;
    callback recovery-codes-copy-all <=> app.recovery-codes-copy-all;

    // ========== Sealed sender onboarding explainer ==========
    callback sealed-sender-intro-confirmed <=> app.sealed-sender-intro-confirmed;

    // ========== Account recovery page properties ==========
    in-out property <string> recovery-username <=> app.recovery-username;
    in-out property <string> recovery-code <=> app.recovery-code;
    in-out property <string> recovery-new-password <=> app.recovery-new-password;
    in-out property <string> recovery-confirm-password <=> app.recovery-confirm-password;
    in-out property <string> recovery-new-pin <=> app.recovery-new-pin;
    in property <bool> recovery-loading <=> app.recovery-loading;
    in property <string> recovery-error <=> app.recovery-error;
    in property <string> recovery-success <=> app.recovery-success;
    callback recover-account <=> app.recover-account;

    // ========== Sidebar properties ==========
    in property <[ChannelListItemData]> channels <=> app.channels;
    in property <[DMListItemData]> dm-conversations <=> app.dm-conversations;
    in property <[PrivateGroupListItemData]> private-groups <=> app.private-groups;
    in property <int> total-unread-count <=> app.total-unread-count;
    in property <string> user-display-name <=> app.user-display-name;
    in property <image> user-avatar-source <=> app.user-avatar-source;
    in property <string> user-initials <=> app.user-initials;
    in property <string> user-presence-status <=> app.user-presence-status;
    in property <string> user-custom-status <=> app.user-custom-status;
    in-out property <bool> sidebar-collapsed <=> app.sidebar-collapsed;

    // ========== Custom sections properties ==========
    in property <[CustomSectionData]> custom-sections <=> app.custom-sections;
    in property <[SectionConversationData]> section-conversations <=> app.section-conversations;

    // ========== Chat properties ==========
    in property <string> channel-id <=> app.channel-id;
    in property <string> channel-name <=> app.channel-name;
    in property <string> channel-type <=> app.channel-type;
    in property <int> member-count <=> app.member-count;
    in property <string> topic <=> app.topic;
    in property <bool> is-archived <=> app.is-archived;
    in-out property <bool> is-dm <=> app.is-dm;
    in property <string> typing-indicator <=> app.typing-indicator;
    in property <string> header-presence-status <=> app.header-presence-status;
    in property <image> channel-avatar-source <=> app.channel-avatar-source;
    in property <bool> channel-has-avatar <=> app.channel-has-avatar;
    in property <[MessageItemData]> messages <=> app.messages;
    in property <bool> loading-messages <=> app.loading-messages;
    in property <int> scroll-to-message-index <=> app.scroll-to-message-index;
    in property <string> highlighted-message-id <=> app.highlighted-message-id;
    in-out property <length> message-scroll-position <=> app.message-scroll-position;
    in-out property <bool> is-at-bottom <=> app.is-at-bottom;  // True when scrolled to bottom
    in property <bool> should-auto-scroll <=> app.should-auto-scroll;  // Enable auto-scroll
    in-out property <string> composer-text <=> app.composer-text;
    in property <string> composer-placeholder <=> app.composer-placeholder;
    in property <bool> composer-disabled <=> app.composer-disabled;
    in property <[PendingAttachmentData]> pending-attachments <=> app.pending-attachments;
    in-out property <bool> composer-is-editing <=> app.composer-is-editing;
    in-out property <string> composer-edit-message-id <=> app.composer-edit-message-id;

    // ========== Reply-to state (Signal-style: sender_id + timestamp) ==========
    in-out property <bool> composer-is-replying <=> app.composer-is-replying;
    in-out property <string> composer-reply-to-sender <=> app.composer-reply-to-sender;
    in-out property <string> composer-reply-to-sender-name <=> app.composer-reply-to-sender-name;
    in-out property <string> composer-reply-to-timestamp <=> app.composer-reply-to-timestamp;
    in-out property <string> composer-reply-preview <=> app.composer-reply-preview;
    in-out property <bool> composer-reply-has-thumbnail <=> app.composer-reply-has-thumbnail;
    in-out property <image> composer-reply-thumbnail <=> app.composer-reply-thumbnail;

    // ========== Audio playback state ==========
    in-out property <string> current-playing-attachment-id <=> app.current-playing-attachment-id;
    in-out property <bool> is-media-playing <=> app.is-media-playing;
    in-out property <float> audio-progress <=> app.audio-progress;
    in-out property <string> audio-elapsed <=> app.audio-elapsed;

    // ========== Image viewer state ==========
    in-out property <bool> image-viewer-visible <=> app.image-viewer-visible;
    in property <image> image-viewer-source <=> app.image-viewer-source;
    in property <string> image-viewer-filename <=> app.image-viewer-filename;
    in property <string> image-viewer-size <=> app.image-viewer-size;
    callback close-image-viewer <=> app.close-image-viewer;

    // ========== Code preview state ==========
