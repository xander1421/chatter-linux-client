// Chatter Linux Client - Main UI
// Root component for the application

import { App, ChannelListItemData, DMListItemData, MessageItemData, MessageAttachmentData, FriendRequest, ForwardTarget, SessionInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, UserSearchResult, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, ChannelMemberData } from "app.slint";

// Re-export all types for Rust binding
export { ChannelListItemData, DMListItemData, MessageItemData, MessageAttachmentData, FriendRequest, ForwardTarget, SessionInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, UserSearchResult, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, ChannelMemberData }

export component MainWindow inherits Window {
    title: "Chatter";
    icon: @image-url("../assets/icon-256.png");
    min-width: 800px;
    min-height: 600px;

    // Expose App properties through MainWindow for Rust binding
    // ========== View routing ==========
    in-out property <string> current-view <=> app.current-view;

    // ========== Loading page properties ==========
    in property <string> loading-message <=> app.loading-message;
    in property <string> loading-secondary-message <=> app.loading-secondary-message;

    // ========== Auth page properties ==========
    in-out property <string> login-username <=> app.login-username;
    in-out property <string> login-password <=> app.login-password;
    in property <bool> login-loading <=> app.login-loading;
    in property <string> login-error <=> app.login-error;

    in-out property <string> register-display-name <=> app.register-display-name;
    in-out property <string> register-username <=> app.register-username;
    in-out property <string> register-password <=> app.register-password;
    in-out property <string> register-confirm-password <=> app.register-confirm-password;
    in property <bool> register-loading <=> app.register-loading;
    in property <string> register-error <=> app.register-error;

    // ========== Sidebar properties ==========
    in property <[ChannelListItemData]> channels <=> app.channels;
    in property <string> selected-channel-id <=> app.selected-channel-id;
    in property <[DMListItemData]> dm-conversations <=> app.dm-conversations;
    in property <string> selected-dm-id <=> app.selected-dm-id;
    in property <string> user-display-name <=> app.user-display-name;
    in property <image> user-avatar-source <=> app.user-avatar-source;
    in property <string> user-initials <=> app.user-initials;
    in property <string> user-presence-status <=> app.user-presence-status;
    in property <string> user-custom-status <=> app.user-custom-status;
    in-out property <bool> sidebar-collapsed <=> app.sidebar-collapsed;

    // ========== Chat properties ==========
    in property <string> channel-id <=> app.channel-id;
    in property <string> channel-name <=> app.channel-name;
    in property <string> channel-type <=> app.channel-type;
    in property <int> member-count <=> app.member-count;
    in property <string> topic <=> app.topic;
    in property <bool> is-archived <=> app.is-archived;
    in-out property <bool> is-dm <=> app.is-dm;
    in property <string> typing-indicator <=> app.typing-indicator;
    in property <[MessageItemData]> messages <=> app.messages;
    in property <bool> loading-messages <=> app.loading-messages;
    in property <int> scroll-to-message-index <=> app.scroll-to-message-index;
    in-out property <length> message-scroll-position <=> app.message-scroll-position;
