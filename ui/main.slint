// Chatter Linux Client - Main UI
// Root component for the application

import { App, ChatRowData, MessageItemData, MessageAttachmentData, ForwardTarget, SessionInfo, PendingLinkInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, CallHistoryRow, AudioDeviceData, ScreenSourceData, ChannelMemberData, BannedMemberData, PrivateGroupFriend, LocalAIProviderData, CatalogModelData, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData, InviteUser, ReactionEntry, CustomSectionData, QuickSwitcherItem, SharedContentItem, SharedTab } from "app.slint";
import { JarvisGlobal } from "jarvis/jarvis_global.slint";
import { AiIntegrationGlobal } from "ai/ai_global.slint";
import { TextFormat } from "chat/message_composer.slint";
import { AnonMode, TorStatus } from "anon_mode/anon_mode_global.slint";
import { MeshGlobal, MeshConversationData } from "mesh/mesh_global.slint";
import { Typography } from "theme/typography.slint";
import { Appearance } from "theme/appearance.slint";
import { NotificationSound } from "settings/notification_sound.slint";
import { Haptics } from "components/haptics.slint";
import { AvatarText } from "components/avatar.slint";
import { ConversationKind } from "chat/conversation_kind.slint";
import { DisappearingGlobal, DisappearingOption } from "chat/disappearing_global.slint";
import { VirtualKeyboard } from "components/modal_container.slint";

// Re-export all types for Rust binding
export { ChatRowData, MessageItemData, MessageAttachmentData, ForwardTarget, SessionInfo, PendingLinkInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, ChannelMemberData, BannedMemberData, PrivateGroupFriend, LocalAIProviderData, CatalogModelData, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData, InviteUser, ReactionEntry, CustomSectionData, QuickSwitcherItem, SharedContentItem, SharedTab }
export { JarvisGlobal }
// Server-side AI integration flags. FEAT-5: the create-channel "AI assistant"
// template is off unless the `ai-channel-template` Cargo feature is built.
export { AiIntegrationGlobal }
export { TextFormat }
export { AnonMode }
export { TorStatus }
// bitchat mesh: runtime feature flag + the sidebar row shape. Written from
// `bin_ui::features::mesh`; inert when the `mesh` Cargo feature is off.
export { MeshGlobal, MeshConversationData }
// Touch feedback. Bound in `bin_ui::haptics`; unbound (and so a no-op) on desktop.
export { Haptics }
export { AvatarText }
export { ConversationKind }
export { DisappearingGlobal, DisappearingOption }
// Theme choice. Bound in `bin_ui::features::modals::settings`.
export { Appearance }
// Settings › Notifications › Sound and vibration. Bound in `bin_ui::features::modals::settings`.
export { NotificationSound }

export component MainWindow inherits Window {
    title: "Chatter";
    icon: @image-url("../assets/icon-256.png");
    // Responsive: allow narrow widths for phones (360dp minimum)
    min-width: 360px;
    min-height: 480px;
    preferred-width: 800px;
    preferred-height: 600px;
    default-font-family: Typography.font-family;
    default-font-size: Typography.sm;

    // Expose App properties through MainWindow for Rust binding
    // ========== Safe area insets (Android status bar / nav bar) ==========
    in property <length> safe-area-top <=> app.safe-area-top;
    in property <length> safe-area-bottom <=> app.safe-area-bottom;

    in property <bool> is-mobile-platform <=> app.is-mobile-platform;
    out property <bool> compact-layout <=> app.compact-layout;
    in property <length> macos-titlebar-height <=> app.macos-titlebar-height;
    in property <length> macos-traffic-lights-width <=> app.macos-traffic-lights-width;

    // ========== Android back key ==========
    // Fired once per hardware/gesture Back press, from `back-scope` at the
    // bottom of this file. The DECISION (pop selection mode, else close the
    // modal, else background the task) lives in Rust so it is testable:
    // `bin_ui::features::back`. Slint only reports the press.
    callback back-pressed();

    // ========== View routing ==========
    in-out property <string> current-view <=> app.current-view;

    // ========== Connection status ==========
    in property <string> connection-status <=> app.connection-status;
    in property <int> connection-reconnect-attempt <=> app.connection-reconnect-attempt;
    in property <int> connection-queue-count <=> app.connection-queue-count;

    in property <bool> server-unreachable <=> app.server-unreachable;

    // ========== Working without an account ==========
    in property <bool> account-free-surfaces <=> app.account-free-surfaces;
    in property <bool> is-signed-in <=> app.is-signed-in;
    callback continue-without-account <=> app.continue-without-account;

    // ========== Loading page properties ==========
    in property <string> loading-message <=> app.loading-message;
    in property <string> loading-secondary-message <=> app.loading-secondary-message;

    // ========== Auth page properties ==========
    in-out property <string> login-username <=> app.login-username;
    in-out property <string> login-password <=> app.login-password;
    in-out property <string> login-pin <=> app.login-pin;
    in property <bool> login-loading <=> app.login-loading;
    in property <string> login-error <=> app.login-error;
    in property <bool> login-identity-reset-available <=> app.login-identity-reset-available;
    callback accept-new-identity <=> app.accept-new-identity;

    in-out property <string> register-display-name <=> app.register-display-name;
    in-out property <string> register-username <=> app.register-username;
    in-out property <string> register-password <=> app.register-password;
    in-out property <string> register-confirm-password <=> app.register-confirm-password;
    in-out property <string> register-pin <=> app.register-pin;
    in-out property <string> register-server-url <=> app.register-server-url;
    in-out property <string> login-server-url <=> app.login-server-url;
    in-out property <string> configured-server-url <=> app.configured-server-url;
    in property <bool> register-loading <=> app.register-loading;
    in property <string> register-error <=> app.register-error;
    in property <image> register-avatar-source <=> app.register-avatar-source;
    in property <bool> register-has-avatar <=> app.register-has-avatar;
    in-out property <int> register-selected-default-idx <=> app.register-selected-default-idx;
    in property <int> register-password-strength <=> app.register-password-strength;
    in property <int> register-pin-strength <=> app.register-pin-strength;
    callback register-select-avatar <=> app.register-select-avatar;
    callback register-select-default-avatar <=> app.register-select-default-avatar;
    callback register-password-changed <=> app.register-password-changed;
    callback register-pin-changed <=> app.register-pin-changed;

    // ========== Recovery codes modal properties ==========
    in property <[string]> recovery-codes <=> app.recovery-codes;
    in-out property <bool> recovery-codes-regenerated <=> app.recovery-codes-regenerated;
    callback recovery-codes-confirmed <=> app.recovery-codes-confirmed;
    callback recovery-codes-copy-all <=> app.recovery-codes-copy-all;
    // Android: FLAG_SECURE while the codes are on screen (lib.rs binds it).
    callback secure-screen(bool);
    // The phone's chat pane closed (Back, header back, a bottom tab): nothing
    // is on screen any more, so no conversation may stay "active".
    callback chat-pane-closed();

    // ========== Sealed sender onboarding explainer ==========
    callback sealed-sender-intro-confirmed <=> app.sealed-sender-intro-confirmed;

    // ========== Account recovery page properties ==========
    in-out property <string> recovery-username <=> app.recovery-username;
    in-out property <string> recovery-code <=> app.recovery-code;
    in-out property <string> recovery-new-password <=> app.recovery-new-password;
    in-out property <string> recovery-confirm-password <=> app.recovery-confirm-password;
    in-out property <string> recovery-new-pin <=> app.recovery-new-pin;
    in property <bool> recovery-loading <=> app.recovery-loading;
    in property <string> recovery-error <=> app.recovery-error;
    in property <string> recovery-success <=> app.recovery-success;
    callback recover-account <=> app.recover-account;

    // ========== Sidebar properties ==========
    in property <[ChatRowData]> chat-rows <=> app.chat-rows;
    in property <int> total-unread-count <=> app.total-unread-count;
    in property <string> user-display-name <=> app.user-display-name;
    in property <image> user-avatar-source <=> app.user-avatar-source;
    in property <string> user-initials <=> app.user-initials;
    in property <string> user-presence-status <=> app.user-presence-status;
    in-out property <string> user-presence-mode <=> app.user-presence-mode;
    in property <string> user-custom-status <=> app.user-custom-status;
    in-out property <bool> sidebar-collapsed <=> app.sidebar-collapsed;

    // ========== Custom sections properties ==========
    in property <[CustomSectionData]> custom-sections <=> app.custom-sections;

    // ========== Chat properties ==========
    in property <string> channel-id <=> app.channel-id;
    in property <string> channel-name <=> app.channel-name;
    in property <ConversationKind> conversation-kind <=> app.conversation-kind;
    in property <bool> private-channel <=> app.private-channel;
    in property <string> privacy-line-override <=> app.privacy-line-override;
    in property <bool> privacy-line-exposed <=> app.privacy-line-exposed;
    in property <int> member-count <=> app.member-count;
    in property <string> topic <=> app.topic;
    in-out property <bool> is-dm <=> app.is-dm;
    in property <string> typing-indicator <=> app.typing-indicator;
    in property <string> header-presence-status <=> app.header-presence-status;
    in property <image> channel-avatar-source <=> app.channel-avatar-source;
    in property <bool> channel-has-avatar <=> app.channel-has-avatar;
    in property <[MessageItemData]> messages <=> app.messages;
    in property <bool> loading-messages <=> app.loading-messages;
    in property <int> scroll-to-message-index <=> app.scroll-to-message-index;
    in property <string> highlighted-message-id <=> app.highlighted-message-id;
    in-out property <length> message-scroll-position <=> app.message-scroll-position;
    in-out property <bool> is-at-bottom <=> app.is-at-bottom;  // True when scrolled to bottom
    // Unread boundary from core — where the conversation opens, and the pill count.
    in-out property <int> unread-index <=> app.unread-index;
    in-out property <int> unread-count <=> app.unread-count;
    in property <bool> should-auto-scroll <=> app.should-auto-scroll;  // Enable auto-scroll
    in-out property <string> composer-text <=> app.composer-text;
    in-out property <string> composer-stash <=> app.composer-stash;
    in-out property <bool> composer-stash-held <=> app.composer-stash-held;
    in property <string> composer-placeholder <=> app.composer-placeholder;
    in property <string> composer-send-status <=> app.composer-send-status;
    in property <string> composer-notice <=> app.composer-notice;
    in property <[PendingAttachmentData]> pending-attachments <=> app.pending-attachments;
    in-out property <bool> composer-is-editing <=> app.composer-is-editing;
    in-out property <string> composer-edit-message-id <=> app.composer-edit-message-id;

    // ========== Reply-to state (Signal-style: sender_id + timestamp) ==========
    in-out property <bool> composer-is-replying <=> app.composer-is-replying;
    in-out property <string> composer-reply-to-sender <=> app.composer-reply-to-sender;
    in-out property <string> composer-reply-to-sender-name <=> app.composer-reply-to-sender-name;
    in-out property <string> composer-reply-to-timestamp <=> app.composer-reply-to-timestamp;
    in-out property <string> composer-reply-preview <=> app.composer-reply-preview;
    in-out property <bool> composer-reply-has-thumbnail <=> app.composer-reply-has-thumbnail;
    in-out property <image> composer-reply-thumbnail <=> app.composer-reply-thumbnail;

    // ========== Audio playback state ==========
    in-out property <string> current-playing-attachment-id <=> app.current-playing-attachment-id;
    in-out property <bool> is-media-playing <=> app.is-media-playing;
    in-out property <float> audio-progress <=> app.audio-progress;
    in-out property <string> audio-elapsed <=> app.audio-elapsed;

    // ========== Image viewer state ==========
    in-out property <bool> image-viewer-visible <=> app.image-viewer-visible;
    in property <image> image-viewer-source <=> app.image-viewer-source;
    in property <string> image-viewer-filename <=> app.image-viewer-filename;
    in property <string> image-viewer-size <=> app.image-viewer-size;
    callback close-image-viewer <=> app.close-image-viewer;

    // ========== Code preview state ==========
    in-out property <bool> code-preview-visible <=> app.code-preview-visible;
    in property <string> code-preview-filename <=> app.code-preview-filename;
    in property <string> code-preview-language <=> app.code-preview-language;
    in property <int> code-preview-line-count <=> app.code-preview-line-count;
    in property <image> code-preview-image <=> app.code-preview-image;
    in property <string> code-preview-plain-text <=> app.code-preview-plain-text;
    callback close-code-preview <=> app.close-code-preview;
    callback copy-code <=> app.copy-code;
    callback open-code-external <=> app.open-code-external;

    // ========== PDF preview state ==========
    in-out property <bool> pdf-preview-visible <=> app.pdf-preview-visible;
    in property <string> pdf-preview-filename <=> app.pdf-preview-filename;
    in property <int> pdf-preview-page-count <=> app.pdf-preview-page-count;
    in property <int> pdf-preview-current-page <=> app.pdf-preview-current-page;
    in property <string> pdf-preview-error <=> app.pdf-preview-error;
    in property <image> pdf-preview-image <=> app.pdf-preview-image;
    callback close-pdf-preview <=> app.close-pdf-preview;
    callback open-pdf-external <=> app.open-pdf-external;
    callback pdf-page-prev <=> app.pdf-page-prev;
    callback pdf-page-next <=> app.pdf-page-next;

    // ========== Video player state ==========
    in-out property <bool> video-player-visible <=> app.video-player-visible;
    in property <image> video-player-frame <=> app.video-player-frame;
    in property <string> video-player-filename <=> app.video-player-filename;
    in property <float> video-player-progress <=> app.video-player-progress;
    in property <string> video-player-elapsed <=> app.video-player-elapsed;
    in property <string> video-player-duration <=> app.video-player-duration;
    in property <bool> video-player-is-playing <=> app.video-player-is-playing;
    in-out property <float> video-player-volume <=> app.video-player-volume;
    callback close-video-player <=> app.close-video-player;
    callback video-player-toggle-play-pause <=> app.video-player-toggle-play-pause;
    callback video-player-seek <=> app.video-player-seek;
    callback video-player-set-volume <=> app.video-player-set-volume;

    // ========== Reaction picker state ==========
    in-out property <bool> reaction-picker-visible <=> app.reaction-picker-visible;
    in-out property <string> reaction-picker-message-id <=> app.reaction-picker-message-id;
    in-out property <string> reaction-picker-sender-id <=> app.reaction-picker-sender-id;
    in-out property <string> reaction-picker-timestamp-ns <=> app.reaction-picker-timestamp-ns;
    in property <[EmojiData]> reaction-picker-emojis <=> app.reaction-picker-emojis;
    in-out property <int> reaction-picker-selected-category <=> app.reaction-picker-selected-category;
    in-out property <string> reaction-picker-search-query <=> app.reaction-picker-search-query;
    callback reaction-selected <=> app.reaction-selected;
    callback reaction-picker-category-changed <=> app.reaction-picker-category-changed;
    callback reaction-picker-search-changed <=> app.reaction-picker-search-changed;

    // ========== Composer emoji picker state ==========
    in-out property <bool> composer-emoji-picker-visible <=> app.composer-emoji-picker-visible;
    in property <[EmojiData]> composer-emoji-list <=> app.composer-emoji-list;
    in-out property <int> composer-emoji-category <=> app.composer-emoji-category;
    in-out property <string> composer-emoji-search <=> app.composer-emoji-search;
    in-out property <int> composer-emoji-skin-tone <=> app.composer-emoji-skin-tone;
    callback composer-emoji-selected <=> app.composer-emoji-selected;
    callback composer-emoji-category-changed <=> app.composer-emoji-category-changed;
    callback composer-emoji-search-changed <=> app.composer-emoji-search-changed;
    callback composer-emoji-skin-tone-changed <=> app.composer-emoji-skin-tone-changed;

    // ========== GIF picker state ==========
    in-out property <bool> composer-gif-picker-visible <=> app.composer-gif-picker-visible;
    in property <bool> composer-gif-picker-loading <=> app.composer-gif-picker-loading;
    in property <[GifData]> composer-gif-picker-results <=> app.composer-gif-picker-results;
    in-out property <string> composer-gif-picker-search <=> app.composer-gif-picker-search;
    callback composer-gif-selected <=> app.composer-gif-selected;
    callback composer-gif-search-changed <=> app.composer-gif-search-changed;

    // ========== Mention autocomplete state ==========
    in-out property <bool> mention-autocomplete-visible <=> app.mention-autocomplete-visible;
    in property <[MentionSuggestion]> mention-suggestions <=> app.mention-suggestions;
    in-out property <int> mention-selected-index <=> app.mention-selected-index;
    callback mention-suggestion-selected <=> app.mention-suggestion-selected;

    // ========== Message context menu state ==========
    in-out property <bool> context-menu-visible <=> app.context-menu-visible;
    in-out property <string> context-menu-sender-id <=> app.context-menu-sender-id;
    in-out property <string> context-menu-timestamp-ns <=> app.context-menu-timestamp-ns;
    in-out property <length> context-menu-x <=> app.context-menu-x;
    in-out property <length> context-menu-y <=> app.context-menu-y;
    in property <bool> context-menu-is-own-message <=> app.context-menu-is-own-message;
    in property <bool> context-menu-can-delete-for-everyone <=> app.context-menu-can-delete-for-everyone;
    in property <bool> context-menu-is-pinned <=> app.context-menu-is-pinned;
    in property <bool> context-menu-has-attachments <=> app.context-menu-has-attachments;
    callback reply-message <=> app.reply-message;
    callback edit-message <=> app.edit-message;
    callback delete-message <=> app.delete-message;
    callback delete-everyone-message <=> app.delete-everyone-message;
    callback pin-message <=> app.pin-message;
    callback forward-message-action <=> app.forward-message-action;
    callback copy-message <=> app.copy-message;
    callback download-message <=> app.download-message;

    // Message context menu — thread and selection are keyed by message id.
    in-out property <string> context-menu-message-id <=> app.context-menu-message-id;

    // ========== Message multi-select ==========
    in-out property <bool> selection-mode <=> app.selection-mode;
    in-out property <bool> mobile-show-chat <=> app.mobile-show-chat;
    in property <int> selected-message-count <=> app.selected-message-count;
    callback message-selection-toggled <=> app.message-selection-toggled;
    callback selection-cleared <=> app.selection-cleared;
    callback selection-delete-clicked <=> app.selection-delete-clicked;
    callback selection-copy-clicked <=> app.selection-copy-clicked;
    callback selection-forward-clicked <=> app.selection-forward-clicked;

    // ========== Peer identity change (conversation wedged) ==========
    in property <bool> identity-change-visible <=> app.identity-change-visible;
    in property <string> identity-change-title <=> app.identity-change-title;
    in property <string> identity-change-detail <=> app.identity-change-detail;
    in property <bool> identity-change-attributed <=> app.identity-change-attributed;
    callback identity-change-accept-clicked <=> app.identity-change-accept-clicked;

    // ========== Pinned bar state ==========
    in property <bool> has-pinned-messages <=> app.has-pinned-messages;
    in property <string> pinned-message-preview <=> app.pinned-message-preview;
    in property <int> pinned-current-index <=> app.pinned-current-index;
    in property <int> pinned-total-count <=> app.pinned-total-count;
    callback pinned-prev-clicked <=> app.pinned-prev-clicked;
    callback pinned-next-clicked <=> app.pinned-next-clicked;
    callback pinned-dismiss-clicked <=> app.pinned-dismiss-clicked;
    callback pinned-show-clicked <=> app.pinned-show-clicked;
    callback pinned-go-to-message <=> app.pinned-go-to-message;

    // ========== Thread panel state ==========
    in property <bool> thread-panel-visible <=> app.thread-panel-visible;
    in property <string> thread-root-message-id <=> app.thread-root-message-id;
    in property <string> thread-root-sender-name <=> app.thread-root-sender-name;
    in property <string> thread-root-content-preview <=> app.thread-root-content-preview;
    in property <int> thread-reply-count <=> app.thread-reply-count;
    in property <[MessageItemData]> thread-replies <=> app.thread-replies;
    in property <bool> thread-loading <=> app.thread-loading;
    in-out property <string> thread-composer-text <=> app.thread-composer-text;
    callback close-thread-clicked <=> app.close-thread-clicked;
    callback send-thread-reply <=> app.send-thread-reply;
    callback load-more-thread-replies <=> app.load-more-thread-replies;

    // ========== Navigation state (rules: features/back.rs) ==========
    in-out property <string> active-tab <=> app.active-tab;
    in-out property <[string]> modal-stack <=> app.modal-stack;
    in-out property <bool> settings-open <=> app.settings-open;
    out property <string> active-modal <=> app.active-modal;
    callback nav-push <=> app.nav-push;
    callback nav-close <=> app.nav-close;
    callback nav-pop <=> app.nav-pop;

    // Create channel modal properties
    in-out property <string> create-channel-name <=> app.create-channel-name;
    in-out property <string> create-channel-description <=> app.create-channel-description;
    in-out property <string> create-channel-template <=> app.create-channel-template;
    in property <string> create-channel-error <=> app.create-channel-error;
    in property <bool> create-channel-loading <=> app.create-channel-loading;

    // Create channel AI config properties
    in-out property <string> create-channel-ai-provider <=> app.create-channel-ai-provider;
    in-out property <string> create-channel-ai-model <=> app.create-channel-ai-model;
    in property <[AIModelOption]> create-channel-ai-models <=> app.create-channel-ai-models;
    in property <bool> create-channel-ai-models-loading <=> app.create-channel-ai-models-loading;
    in property <string> create-channel-ai-models-error <=> app.create-channel-ai-models-error;

    // Create channel private group properties
    in-out property <[PrivateGroupFriend]> create-channel-available-friends <=> app.create-channel-available-friends;
    in-out property <int> create-channel-selected-friend-count <=> app.create-channel-selected-friend-count;

    // Create channel icon upload properties
    in-out property <string> create-channel-icon-url <=> app.create-channel-icon-url;
    in-out property <image> create-channel-icon-preview <=> app.create-channel-icon-preview;
    in-out property <bool> create-channel-has-icon-preview <=> app.create-channel-has-icon-preview;
    callback create-channel-pick-icon <=> app.create-channel-pick-icon;

    // Invite to private group modal properties
    in-out property <string> invite-private-group-id <=> app.invite-private-group-id;
    in-out property <[PrivateGroupFriend]> invite-private-group-friends <=> app.invite-private-group-friends;
    in-out property <int> invite-private-group-selected-count <=> app.invite-private-group-selected-count;
    in property <bool> invite-private-group-loading <=> app.invite-private-group-loading;

    // Invite member to channel modal properties
    in-out property <string> invite-member-channel-id <=> app.invite-member-channel-id;
    in-out property <string> invite-member-channel-name <=> app.invite-member-channel-name;
    in-out property <[InviteUser]> invite-member-users <=> app.invite-member-users;
    in-out property <int> invite-member-selected-count <=> app.invite-member-selected-count;
    in property <bool> invite-member-loading <=> app.invite-member-loading;

    // Join channel modal properties
    in-out property <string> join-channel-search-query <=> app.join-channel-search-query;
    in property <[SearchResultChannel]> join-channel-results <=> app.join-channel-results;
    in property <bool> join-channel-searching <=> app.join-channel-searching;
    in property <string> join-channel-error <=> app.join-channel-error;
    in-out property <string> join-channel-selected-id <=> app.join-channel-selected-id;
    in property <bool> join-channel-joining <=> app.join-channel-joining;

    // User profile modal properties
    in property <string> profile-user-id <=> app.profile-user-id;
    in property <string> profile-display-name <=> app.profile-display-name;
    in property <string> profile-username <=> app.profile-username;
    in property <image> profile-avatar-source <=> app.profile-avatar-source;
    in property <string> profile-initials <=> app.profile-initials;
