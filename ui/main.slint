    callback reaction-selected <=> app.reaction-selected;
    callback reaction-picker-category-changed <=> app.reaction-picker-category-changed;
    callback reaction-picker-search-changed <=> app.reaction-picker-search-changed;

    // ========== Composer emoji picker state ==========
