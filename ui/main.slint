    callback settings-typing-indicators-changed <=> app.settings-typing-indicators-changed;
    callback settings-notification-detail-changed <=> app.settings-notification-detail-changed;
    callback settings-profile-visibility-selected <=> app.settings-profile-visibility-selected;
    callback settings-profile-visibility-confirmed <=> app.settings-profile-visibility-confirmed;
    callback settings-profile-visibility-cancelled <=> app.settings-profile-visibility-cancelled;
    callback settings-search-shortcut-changed <=> app.settings-search-shortcut-changed;
    callback settings-copy-fingerprint <=> app.settings-copy-fingerprint;
    callback settings-sealed-sender-changed <=> app.settings-sealed-sender-changed;
    callback settings-username-discoverable-changed <=> app.settings-username-discoverable-changed;
    callback settings-change-pin <=> app.settings-change-pin;
    callback settings-retry-backup <=> app.settings-retry-backup;

    // Message-history backup
    callback settings-export-message-backup <=> app.settings-export-message-backup;
    callback settings-import-message-backup <=> app.settings-import-message-backup;
    callback settings-server-message-backup <=> app.settings-server-message-backup;
    callback settings-restore-message-backup <=> app.settings-restore-message-backup;
    in-out property <string> settings-message-backup-status <=> app.settings-message-backup-status;

    // AI settings callbacks
    callback settings-local-ai-enabled-changed <=> app.settings-local-ai-enabled-changed;
    callback settings-ai-prefer-cloud-changed <=> app.settings-ai-prefer-cloud-changed;
    callback settings-cloud-ai-mode-changed <=> app.settings-cloud-ai-mode-changed;
    callback settings-cloud-ai-api-key-changed <=> app.settings-cloud-ai-api-key-changed;
    callback settings-cloud-ai-refresh-quota <=> app.settings-cloud-ai-refresh-quota;
    callback settings-local-ai-load-model <=> app.settings-local-ai-load-model;
    callback settings-local-ai-unload-model <=> app.settings-local-ai-unload-model;
    callback settings-local-ai-refresh <=> app.settings-local-ai-refresh;
    callback settings-local-ai-select-provider <=> app.settings-local-ai-select-provider;
    callback settings-local-ai-select-model <=> app.settings-local-ai-select-model;
    callback settings-local-ai-download <=> app.settings-local-ai-download;

    // ========== Channel Settings callbacks ==========
    callback channel-settings-save <=> app.channel-settings-save;
    callback channel-settings-pick-icon <=> app.channel-settings-pick-icon;
    callback channel-settings-change-notification <=> app.channel-settings-change-notification;
    callback channel-settings-toggle-mute <=> app.channel-settings-toggle-mute;
    callback channel-settings-toggle-ai <=> app.channel-settings-toggle-ai;
    callback channel-settings-change-member-role <=> app.channel-settings-change-member-role;
    callback channel-settings-remove-member <=> app.channel-settings-remove-member;
    callback channel-settings-ban-member <=> app.channel-settings-ban-member;
