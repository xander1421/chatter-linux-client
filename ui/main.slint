    in property <bool> should-auto-scroll <=> app.should-auto-scroll;  // Enable auto-scroll
    in-out property <string> composer-text <=> app.composer-text;
    in property <string> composer-placeholder <=> app.composer-placeholder;
    in property <bool> composer-disabled <=> app.composer-disabled;
    in property <[PendingAttachmentData]> pending-attachments <=> app.pending-attachments;
    in-out property <bool> composer-is-editing <=> app.composer-is-editing;
    in-out property <string> composer-edit-message-id <=> app.composer-edit-message-id;

