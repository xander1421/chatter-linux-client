import { SidebarPane } from "app_sidebar_pane.slint";
import { LoginPage } from "pages/login.slint";
import { RegisterPage } from "pages/register.slint";
import { AccountRecoveryPage } from "pages/account_recovery.slint";
import { LinkDevicePage } from "pages/link_device.slint";
import { LoadingPage } from "pages/loading.slint";
import { WelcomePage } from "pages/welcome.slint";
import { AuthFlow } from "app_auth_flow.slint";

// The account entry flow uses AuthFlow for authentication state and actions.
export component AuthPages inherits Rectangle {
    in property <bool> account-free-surfaces;
    in property <string> current-view;
    in property <string> exiting-view;
    in property <bool> is-mobile-platform;
    in property <bool> server-unreachable;
    in property <float> view-progress;
    function view-shift(name: string) -> length {
        return root.current-view == name ? (1 - root.view-progress) * 24px
            : -root.view-progress * 12px;
    }
    function view-opacity(name: string) -> float {
        return root.current-view == name ? root.view-progress : 1 - root.view-progress;
    }

    // Loading page
    if current-view == "loading": LoadingPage {
        z: 2;
        x: root.view-shift("loading");
        opacity: root.view-opacity("loading");
        message: AuthFlow.loading-message;
        secondary-message: AuthFlow.loading-secondary-message;
    }

    // Login page
    if current-view == "login" || root.exiting-view == "login": LoginPage {
        z: 2;
        x: root.view-shift("login");
        opacity: root.view-opacity("login");
        touch: root.is-mobile-platform;
        server-url <=> AuthFlow.login-server-url;
        configured-server-url: AuthFlow.configured-server-url;
        username <=> AuthFlow.login-username;
        password <=> AuthFlow.login-password;
        pin <=> AuthFlow.login-pin;
        loading: AuthFlow.login-loading;
        error: AuthFlow.login-error;
        verifying: AuthFlow.login-verifying;
        identity-reset-available: AuthFlow.login-identity-reset-available;
        accept-new-identity => { AuthFlow.accept-new-identity(); }

        server-unreachable: root.server-unreachable;
        account-free-surfaces: root.account-free-surfaces;
        continue-without-account => { AuthFlow.continue-without-account(); }

        login(u, p, s, pin) => {
            AuthFlow.login(u, p, s, pin);
        }
        register => {
            AuthFlow.go-to-register();
        }
        go-to-recovery => {
            AuthFlow.go-to-recovery();
        }
        go-to-link-device => {
            AuthFlow.go-to-link-device();
        }
    }

    // Register page
    if current-view == "register" || root.exiting-view == "register": RegisterPage {
        z: 2;
        x: root.view-shift("register");
        opacity: root.view-opacity("register");
        touch: root.is-mobile-platform;
        display-name <=> AuthFlow.register-display-name;
        username <=> AuthFlow.register-username;
        password <=> AuthFlow.register-password;
        confirm-password <=> AuthFlow.register-confirm-password;
        pin <=> AuthFlow.register-pin;
        server-url <=> AuthFlow.register-server-url;
        loading: AuthFlow.register-loading;
        error: AuthFlow.register-error;
        avatar-source: AuthFlow.register-avatar-source;
        avatar-options: AuthFlow.avatar-options;
        has-avatar: AuthFlow.register-has-avatar;
        selected-default-idx <=> AuthFlow.register-selected-default-idx;
        avatar-color <=> AuthFlow.register-avatar-color;
        password-strength: AuthFlow.register-password-strength;
        pin-strength: AuthFlow.register-pin-strength;
        server-unreachable: root.server-unreachable;
        account-free-surfaces: root.account-free-surfaces;

        continue-without-account => { AuthFlow.continue-without-account(); }

        register(u, p, d, pin, s) => {
            AuthFlow.register(u, p, d, pin, s);
        }
        username-validation(u) => { AuthFlow.register-username-validation(u) }
        pin-validation(pin) => { AuthFlow.register-pin-validation(pin) }
        clear-error => { AuthFlow.register-clear-error(); }
        password-changed(p) => {
            AuthFlow.register-password-changed(p);
        }
        pin-changed(p) => {
            AuthFlow.register-pin-changed(p);
        }
        select-avatar => {
            AuthFlow.register-select-avatar();
        }
        select-default-avatar(idx) => {
            AuthFlow.register-select-default-avatar(idx);
        }
        remove-avatar => { AuthFlow.register-remove-avatar(); }
        go-to-login => {
            AuthFlow.go-to-login();
        }
    }

    // Link new device (new-device side QR display)
    if current-view == "link-device" || root.exiting-view == "link-device": LinkDevicePage {
        z: 2;
        x: root.view-shift("link-device");
        opacity: root.view-opacity("link-device");
        touch: root.is-mobile-platform;
        qr-image: AuthFlow.link-device-qr;
        link-url: AuthFlow.link-device-url;
        status-text: AuthFlow.link-device-status;
        error: AuthFlow.link-device-error;
        linking: AuthFlow.link-device-active;
        has-local-identity: AuthFlow.link-device-has-local-identity;

        start => { AuthFlow.link-device-start(); }
        cancel => { AuthFlow.link-device-cancel(); }
        copy-link => { AuthFlow.link-device-copy(); }
        go-to-login => { AuthFlow.go-to-login(); }
    }

    // Account recovery page
    if current-view == "recovery" || root.exiting-view == "recovery": AccountRecoveryPage {
        z: 2;
        x: root.view-shift("recovery");
        opacity: root.view-opacity("recovery");
        username <=> AuthFlow.recovery-username;
        recovery-code <=> AuthFlow.recovery-code;
        new-password <=> AuthFlow.recovery-new-password;
        confirm-password <=> AuthFlow.recovery-confirm-password;
        new-pin <=> AuthFlow.recovery-new-pin;
        loading: AuthFlow.recovery-loading;
        error: AuthFlow.recovery-error;
        success: AuthFlow.recovery-success;

        recover(u, code, pw, pin) => {
            AuthFlow.recover-account(u, code, pw, pin);
        }
        go-to-login => {
            AuthFlow.go-to-login();
        }
    }

    // Welcome page (shown after first registration)
    if current-view == "welcome" || root.exiting-view == "welcome": WelcomePage {
        z: 2;
        x: root.view-shift("welcome");
        opacity: root.view-opacity("welcome");
        display-name: SidebarPane.user-display-name;
        add-friends => { AuthFlow.welcome-add-friends(); }
        browse-channels => { AuthFlow.welcome-browse-channels(); }
        get-started => { AuthFlow.welcome-get-started(); }
    }
}
