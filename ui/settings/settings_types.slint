// A local AI provider found running on this machine.
export struct LocalAIProviderData {
    kind: string,          // "ollama" | "lm-studio" | "llama-cpp" | "vllm" | "mistralrs"
    display-name: string,
    detail: string,        // "12 models · localhost:11434" or "in-process GPU engine"
    is-active: bool,
}

// One row of the downloadable-model catalog.
export struct CatalogModelData {
    name: string,
    tag: string,           // ollama tag — the download key
    detail: string,        // "7.6B params · 4.7 GB"
    fit: string,           // "gpu" | "cpu" | "big"
    fit-label: string,     // "Fits GPU" | "CPU only (slow)" | "Too big"
    installed: bool,
    downloading: bool,
    progress: float,       // 0..1 while downloading
    error: string,
}
