import { Appearance } from "../theme/appearance.slint";
import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { ToggleRow } from "../components/toggle_row.slint";

export component EncryptionSettings inherits VerticalLayout {
    in property <bool> compact-mode;
    in property <string> identity-fingerprint;
    in property <bool> mobile-platform;
    in-out property <bool> sealed-sender-unrestricted;
    callback copy-fingerprint-clicked();
    callback sealed-sender-changed(bool);


    spacing: Spacing.panel-gutter;

    // Section header
    Text {
        text: @tr("Encryption");
        color: Colors.text-primary;
        font-size: Typography.sm;
        font-weight: Typography.semibold;
    }

    Text {
        width: parent.width;
        text: @tr("Your messages are protected with Signal Protocol end-to-end encryption");
        color: Colors.text-muted;
        font-size: Typography.sm;
        wrap: word-wrap;
    }

    // Identity Verification group
    Rectangle {
        background: Colors.surface-card;
        border-radius: Spacing.radius-panel;
        drop-shadow-blur: Elevation.card-blur;
        drop-shadow-offset-y: Elevation.card-offset;
        drop-shadow-color: Elevation.card-shadow;
        border-width: Elevation.rim-width;
        border-color: Elevation.card-rim;

        preferred-height: identity-content.preferred-height;

        // Measures the Copy label so the hint beside it leaves the button its
        // full width (Button: sm text, md padding each side).
        copy-measure := Text {
            x: 0;
            y: 0;
            visible: false;
            text: @tr("Copy");
            font-size: Typography.sm;
            font-weight: Typography.medium;
        }

        identity-content := VerticalLayout {
            padding: Spacing.sm;
            spacing: Spacing.sm;

            Text {
                // Our identity key's fingerprint. A safety
                // number is per conversation (Signal) and
                // lives on the contact's profile.
                text: @tr("Your identity key");
                color: Colors.text-primary;
                font-size: 13px * Appearance.text-scale;
                font-weight: Typography.semibold;
            }

            // Fingerprint display — Neo inset
            Rectangle {
                background: transparent;
                border-width: 1px;
                border-color: Colors.border;
                border-radius: Spacing.radius-control;

                preferred-height: fingerprint-content.preferred-height;

                fingerprint-content := VerticalLayout {
                    padding: Spacing.lg;

                    Text {
                        text: root.identity-fingerprint != "" ? root.identity-fingerprint : @tr("No fingerprint available");
                        color: root.identity-fingerprint != "" ? Colors.text-secondary : Colors.text-muted;
                        font-size: Typography.sm;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        min-width: 0px;
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                Text {
                    width: max(0px, parent.width - (root.compact-mode ? 0px : max(Spacing.button-min-width, copy-measure.preferred-width + Spacing.md * 2)));
                    text: @tr("To verify a contact, compare safety numbers from their profile");
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                if !root.compact-mode: Button {
                    border-radius: Spacing.radius-control;
                    touch: root.mobile-platform;
                    text: @tr("Copy");
                    variant: "ghost";
                    clicked => { root.copy-fingerprint-clicked(); }
                }
            }

            // Compact: full-width button stacked below
            if root.compact-mode: Button {
                border-radius: Spacing.radius-control;
                touch: root.mobile-platform;
                text: @tr("Copy");
                variant: "ghost";
                clicked => { root.copy-fingerprint-clicked(); }
            }
        }
    }

    // Sealed Sender setting
    Rectangle {
        background: Colors.surface-card;
        border-radius: Spacing.radius-panel;
        drop-shadow-blur: Elevation.card-blur;
        drop-shadow-offset-y: Elevation.card-offset;
        drop-shadow-color: Elevation.card-shadow;
        border-width: Elevation.rim-width;
        border-color: Elevation.card-rim;

        preferred-height: sealed-sender-row.preferred-height;

        sealed-sender-row := ToggleRow {
            border-radius: Spacing.radius-control;
            row-padding: Spacing.sm;
            row-spacing: Spacing.md;
            label-spacing: Spacing.sm;
            accessible-text: @tr("Allow sealed sender from anyone");
            checked <=> root.sealed-sender-unrestricted;
            toggled(value) => {
                root.sealed-sender-unrestricted = value;
                root.sealed-sender-changed(value);
            }

            Text {
                width: sealed-sender-row.label-width;
                text: @tr("Allow sealed sender from anyone");
                color: Colors.text-primary;
                font-size: 13px * Appearance.text-scale;
                font-weight: Typography.semibold;
                wrap: word-wrap;
            }
            Text {
                width: sealed-sender-row.label-width;
                text: @tr("Let people who aren't your contacts send you sealed messages. The server still can't see who sent them.");
                color: Colors.text-muted;
                font-size: Typography.xs;
                wrap: word-wrap;
            }
        }
    }
}
