import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// SettingsScreen - Main settings page with sidebar navigation

import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { SettingsRow } from "../components/settings_row.slint";
import { DismissButton } from "../components/dismiss_button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { ToggleRow } from "../components/toggle_row.slint";
import { JarvisGlobal } from "../jarvis/jarvis_global.slint";
import { Appearance } from "../theme/appearance.slint";
import { Icons } from "../theme/icons.slint";
import { NotificationSound, NotificationDelivery } from "notification_sound.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";

// A local AI provider found running on this machine.
export struct LocalAIProviderData {
    kind: string,          // "ollama" | "lm-studio" | "llama-cpp" | "vllm" | "mistralrs"
    display-name: string,
    detail: string,        // "12 models · localhost:11434" or "in-process GPU engine"
    is-active: bool,
}

// One row of the downloadable-model catalog.
export struct CatalogModelData {
    name: string,
    tag: string,           // ollama tag — the download key
    detail: string,        // "7.6B params · 4.7 GB"
    fit: string,           // "gpu" | "cpu" | "big"
    fit-label: string,     // "Fits GPU" | "CPU only (slow)" | "Too big"
    installed: bool,
    downloading: bool,
    progress: float,       // 0..1 while downloading
    error: string,
}

export component SettingsScreen inherits Rectangle {
    // User profile data
    in property <string> display-name: "";
    in property <string> username: "";
    // Room left for the mobile tab bar drawn over the bottom of the screen.
    in property <length> bottom-inset: 0px;
    in property <bool> mobile-platform: false;
    // Mobile has no save-document adapter; disclose before requesting a secret.
    property <bool> file-backup-available: !root.mobile-platform;
    in property <image> avatar;
    in property <int> session-count: 0;

    // Change password form state
    in-out property <string> current-password: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in property <bool> password-changing: false;
    in property <string> password-error: "";

    // Change PIN form state
    in-out property <string> change-pin-current: "";
    in-out property <string> change-pin-new: "";
    in-out property <string> change-pin-confirm: "";
    in property <bool> change-pin-loading: false;
    in property <string> change-pin-error: "";
    in property <string> change-pin-success: "";

    // Key backup state
    in property <string> backup-status: "unknown";  // "backed_up", "not_backed_up", "unknown"
    in-out property <string> backup-retry-pin: "";
    in property <bool> backup-retry-loading: false;
    in property <string> backup-retry-error: "";

    // Message-history backup (encrypted export/restore)
    in-out property <string> message-backup-passphrase: "";
    in-out property <string> message-backup-pin: "";
    in property <string> message-backup-status: "";

    // Privacy settings
    in-out property <bool> read-receipts-enabled: true;
    in-out property <bool> typing-indicators-enabled: true;
    in-out property <string> notification-detail: "none";  // "none" | "name_only" | "name_and_message"
    in-out property <string> search-shortcut: "both";   // "k" | "f" | "both"
    // "Who can see my photo and name": "everyone" | "contacts" | "nobody".
    // A restricting choice that needs the PIN parks in
    // profile-visibility-pending until confirmed (Rust sets it).
    in property <string> profile-visibility: "everyone";
    in property <string> profile-visibility-pending: "";
    in property <bool> profile-visibility-busy: false;
    in property <string> profile-visibility-error: "";
    in-out property <string> profile-visibility-pin: "";

    // Encryption settings
    in property <string> identity-fingerprint: "";
    in-out property <bool> sealed-sender-unrestricted: false;
    // "Who can find me by my username": true = Everyone, false = Nobody.
    in-out property <bool> username-discoverable: true;

    // AI settings
    in-out property <bool> local-ai-enabled: true;
    in-out property <string> local-ai-model-id: "Qwen/Qwen2.5-7B-Instruct-GGUF";
    in property <bool> local-ai-loading: false;
    in property <string> local-ai-status: "";  // "not loaded", "loading", "loaded: ModelName"
    in property <string> local-ai-error: "";
    in property <string> local-ai-hardware-summary: "";
    in property <bool> local-ai-detecting: false;
    in property <[LocalAIProviderData]> local-ai-providers: [];
    in property <string> local-ai-active-provider: "";
    in property <[string]> local-ai-models: [];
    in property <string> local-ai-active-model: "";
    in property <[CatalogModelData]> local-ai-catalog: [];

    // Cloud AI (off-device). Separate from local AI on purpose: this is the
    // surface where content leaves the machine, so it states plainly what goes
    // where.
    in-out property <bool> ai-prefer-cloud: false;
    in-out property <string> cloud-ai-mode: "direct-anthropic";  // | "server-broker"
    in-out property <string> cloud-ai-api-key: "";
    in property <bool> cloud-ai-configured: false;
    in property <string> cloud-ai-status: "";
    in property <string> cloud-ai-balance: "";

    // Delete-account confirmation state
    in-out property <string> delete-password: "";
    in property <bool> delete-loading: false;
    in property <string> delete-error: "";

    // Recovery-code regeneration (password-confirmed; the new codes open in
    // RecoveryCodesModal, the old ones stop working)
    in-out property <string> recovery-regen-password: "";
    in property <bool> recovery-regen-loading: false;
    in property <string> recovery-regen-error: "";

    // Navigation state
    // Mirror of AnonMode.enabled for the Privacy pane's Shield switch; the
    // switch writes it, so it is re-synced from the global on every change.
    property <bool> shield-switch: AnonMode.enabled;
    property <bool> shield-on: AnonMode.enabled;
    changed shield-on => { root.shield-switch = root.shield-on; }
    property <string> active-section: "account";  // "account", "devices", "privacy", "notifications", "encryption", "ai", "appearance"
    property <bool> show-password-form: false;
    property <bool> show-pin-form: false;
    property <bool> show-backup-retry: false;
    property <bool> show-delete-confirm: false;
    property <bool> show-recovery-regen: false;
    // Log Out asks once: on a phone it sits one thumb-width from Delete Account.
    property <bool> show-logout-confirm: false;

    // Callbacks
    callback edit-profile-clicked();
    callback change-password(string, string);  // current, new
    callback view-sessions-clicked();
    callback logout-clicked();
    callback delete-account-clicked();
    callback delete-account-confirmed(string);  // password — fired only after explicit confirm
    callback regenerate-recovery-codes(string);  // password — fired only after explicit confirm
    callback close-settings();

    // Privacy callbacks
    callback read-receipts-changed(bool);
    callback typing-indicators-changed(bool);
    callback notification-detail-changed(string);
    callback search-shortcut-changed(string);
    callback profile-visibility-selected(string);           // option key
    callback profile-visibility-confirmed(string, string);  // option key, PIN
    callback profile-visibility-cancelled();
    // Shield switch — the same toggle as the chat-list header's shield: ON
    // opens the PIN gate, OFF leaves directly (sidebar/anon_mode.rs).
    callback shield-toggled();

    // Encryption callbacks
    callback copy-fingerprint-clicked();
    callback sealed-sender-changed(bool);
    callback username-discoverable-changed(bool);  // true = Everyone, false = Nobody

    // Security callbacks
    callback change-pin(string, string);  // current_pin, new_pin
    callback retry-backup(string);  // pin

    // Message-history backup callbacks
    callback export-message-backup(string);   // passphrase (file save picker opens in Rust)
    callback import-message-backup(string);   // passphrase (file open picker opens in Rust)
    callback server-message-backup(string);   // pin
    callback restore-message-backup(string);  // pin

    // AI callbacks
    callback local-ai-enabled-changed(bool);
    callback local-ai-load-model(string);  // model_id
    callback local-ai-unload-model();
    callback local-ai-refresh();                 // re-probe providers + hardware
    callback local-ai-open-memory();             // open the memory browser
    callback local-ai-select-provider(string);   // provider kind
    callback local-ai-select-model(string);      // chat model name
    callback local-ai-download(string);          // ollama tag

    // Cloud AI callbacks
    callback ai-prefer-cloud-changed(bool);
    callback cloud-ai-mode-changed(string);      // "direct-anthropic" | "server-broker"
    callback cloud-ai-api-key-changed(string);
    callback cloud-ai-refresh-quota();

    background: Materials.ambient;

    // Responsive breakpoint: compact mode when width < 500px
    property <bool> compact-mode: root.width < 500px;

    // Responsive content padding
    property <length> content-padding: compact-mode ? Spacing.md : Spacing.xl;

    VerticalLayout {



        HorizontalLayout {

        // Sidebar navigation — hidden in compact mode — Neo surface
        if !compact-mode: GlassSurface {
            material-level: 2;
            elevation: 3;

            width: min(240px, root.width * 0.35);

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.xs;

                // Header — back chevron on the LEADING edge, then the title.
                // Settings is a full-window page you pushed into from the
                // sidebar, not a dialog floating over it, so it takes the same
                // affordance the chat header and every full-screen modal take.
                // `touch: false` because this is the one full-screen surface
                // that also exists at mouse density.
                HorizontalLayout {
                    height: Spacing.header-action-box;
                    spacing: Spacing.sm;
                    alignment: start;

                    DismissButton {
                        back: true;
                        plain: true;
                        touch: false;
                        clicked => { root.close-settings(); }
                    }

                    Text {
                        text: "Settings";
                        color: Colors.text-primary;
                        font-size: Typography.xl;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: Spacing.md; }

                // Navigation items
                for item[index] in [
                    { id: "account", label: "Account", enabled: true },
                    { id: "privacy", label: "Privacy", enabled: true },
                    { id: "notifications", label: "Notifications", enabled: true },
                    { id: "devices", label: "Linked devices", enabled: true },
                    { id: "appearance", label: "Appearance", enabled: true },
                    { id: "encryption", label: "Encryption", enabled: true },
                    { id: "ai", label: "AI Assistant", enabled: true }
                ]: Rectangle {
                    height: root.mobile-platform ? Spacing.touch-target-min : Spacing.button-height;
                    border-radius: Spacing.radius-md;
                    background: active-section == item.id ? (root.compact-mode ? Colors.action-fill : Colors.row-selected) :
                               (nav-touch.has-hover && item.enabled ? Colors.row-hover : transparent);
                    opacity: item.enabled ? 1.0 : 0.5;

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.sm;
                        alignment: start;

                        if !root.compact-mode: Image {
                            source: item.id == "account" ? Icons.user
                                : item.id == "devices" ? Icons.smartphone
                                : item.id == "privacy" ? Icons.shield
                                : item.id == "notifications" ? Icons.bell
                                : item.id == "encryption" ? Icons.lock
                                : item.id == "ai" ? Icons.sparkles : Icons.moon;
                            width: Spacing.button-icon;
                            height: Spacing.button-icon;
                            colorize: active-section == item.id ? Colors.selected-indicator : Colors.text-secondary;
                            vertical-alignment: center;
                        }

                        Text {
                            text: item.label;
                            color: active-section == item.id ? (root.compact-mode ? Colors.on-action : Colors.text-primary) :
                                   (item.enabled ? Colors.text-secondary : Colors.text-muted);
                            font-size: Typography.sm;
                            font-weight: active-section == item.id ? Typography.medium : Typography.normal;
                            vertical-alignment: center;
                        }
                    }

                    nav-touch := TouchArea {
                        mouse-cursor: item.enabled ? pointer : default;
                        clicked => {
                            if item.enabled {
                                active-section = item.id;
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Content area
        Rectangle {
            horizontal-stretch: 1;
            background: Colors.background;

            Flickable {
                viewport-width: self.width;
                viewport-height: content-layout.preferred-height + root.content-padding * 2 + root.bottom-inset;

                content-layout := VerticalLayout {
                    padding: root.content-padding;
                    padding-top: root.content-padding + (root.compact-mode ? Spacing.touch-target-min + Spacing.sm : Spacing.none);
                    spacing: root.compact-mode ? Spacing.md : Spacing.lg;
                    alignment: start;

                    // Center content with max-width (wider in compact mode to use space).
                    // A layout, not a Rectangle: a Rectangle does not pass its
                    // `if` children's height up, so `content-layout` reported
                    // ~0 and the page could not scroll to anything below the
                    // fold (Key Backup was stranded under the tab bar).
                    VerticalLayout {
                        max-width: root.compact-mode ? root.width : 600px;

                        // Account section
                        if active-section == "account": VerticalLayout {
                            spacing: Spacing.sm;

                            // Section header
                            Text {
                                text: "Account";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            // Profile info row
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        // Avatar
                                        Avatar {
                                            size: 64px;
                                            source: root.avatar;
                                            name: root.display-name;
                                        }

                                        // Name and username
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: root.display-name;
                                                color: Colors.text-primary;
                                                font-size: Typography.lg;
                                                font-weight: Typography.medium;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: root.username != "" ? "@" + root.username : "";
                                                color: Colors.text-secondary;
                                                font-size: Typography.sm;
                                                overflow: elide;
                                            }
                                        }

                                        // Edit button — beside the name on wide screens
                                        if !root.compact-mode: Button {
                                            touch: root.mobile-platform;
                                            text: "Edit Profile";
                                            variant: "secondary";
                                            icon: Icons.edit;
                                            clicked => { root.edit-profile-clicked(); }
                                        }
                                    }

                                    // Compact: full-width button stacked below
                                    if root.compact-mode: Button {
                                        text: "Edit Profile";
                                        variant: "secondary";
                                        touch: true;
                                        icon: Icons.edit;
                                        clicked => { root.edit-profile-clicked(); }
                                    }
                                }
                            }

                            // Security subsection
                            Rectangle { height: Spacing.lg; }

                            Text {
                                text: "Security";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                VerticalLayout {
                                    spacing: Spacing.none;
                            // Change Password group
                            Rectangle {
                                background: transparent;
                                border-radius: Spacing.none;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    SettingsRow {
                                        touch: root.mobile-platform;
                                        icon: Icons.lock;
                                        title: "Password";
                                        detail: "Choose a strong, unique password for your account.";
                                        clickable: false;
                                        show-chevron: false;
                                        action-label: show-password-form ? "" : "Change";
                                        clicked => { show-password-form = true; }
                                    }

                                    // Inline password form
                                    if show-password-form: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.divider;
                                        }

                                        Input {
                                            placeholder: "Current password";
                                            password: true;
                                            text <=> root.current-password;
                                        }

                                        // Stacked: side by side on a phone the
                                        // placeholders clipped ("Confirm new pa…").
                                        VerticalLayout {
                                            spacing: Spacing.md;

                                            Input {
                                                placeholder: "New password";
                                                password: true;
                                                text <=> root.new-password;
                                                horizontal-stretch: 1;
                                            }

                                            Input {
                                                placeholder: "Confirm new password";
                                                password: true;
                                                text <=> root.confirm-password;
                                                error: root.password-error != "";
                                                error-message: root.password-error;
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-password-form = false;
                                                    root.current-password = "";
                                                    root.new-password = "";
                                                    root.confirm-password = "";
                                                }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Save";
                                                variant: "primary";
                                                loading: root.password-changing;
                                                disabled: root.current-password == "" ||
                                                         root.new-password == "" ||
                                                         root.confirm-password == "";
                                                clicked => {
                                                    root.change-password(root.current-password, root.new-password);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Colors.divider; }

                            // Recovery Codes group
                            Rectangle {
                                background: transparent;
                                border-radius: Spacing.none;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    SettingsRow {
                                        touch: root.mobile-platform;
                                        icon: Icons.shield;
                                        title: "Recovery Codes";
                                        detail: "Lost or used up your codes? Get a new set.";
                                        clickable: false;
                                        show-chevron: false;
                                        action-label: show-recovery-regen ? "" : "Regenerate";
                                        clicked => { show-recovery-regen = true; }
                                    }

                                    // Inline confirm: nothing is replaced until the password is in.
                                    if show-recovery-regen: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.divider;
                                        }

                                        Text {
                                            text: "Your current recovery codes stop working and a new set is shown once. Enter your password to confirm.";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }

                                        Input {
                                            placeholder: "Password";
                                            password: true;
                                            text <=> root.recovery-regen-password;
                                            error: root.recovery-regen-error != "";
                                            error-message: root.recovery-regen-error;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-recovery-regen = false;
                                                    root.recovery-regen-password = "";
                                                }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Regenerate";
                                                variant: "primary";
                                                loading: root.recovery-regen-loading;
                                                disabled: root.recovery-regen-password == "";
                                                clicked => {
                                                    root.regenerate-recovery-codes(root.recovery-regen-password);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Colors.divider; }

                            // Change PIN group
                            Rectangle {
                                background: transparent;
                                border-radius: Spacing.none;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    SettingsRow {
                                        touch: root.mobile-platform;
                                        icon: Icons.lock;
                                        title: "Backup PIN";
                                        detail: "Your PIN secures your encrypted key backup.";
                                        clickable: false;
                                        show-chevron: false;
                                        action-label: show-pin-form ? "" : "Change";
                                        clicked => { show-pin-form = true; }
                                    }

                                    // Inline PIN form
                                    if show-pin-form: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.divider;
                                        }

                                        Input {
                                            placeholder: "Current PIN";
                                            password: true;
                                            text <=> root.change-pin-current;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            Input {
                                                placeholder: "New PIN (8+ characters)";
                                                password: true;
                                                text <=> root.change-pin-new;
                                                horizontal-stretch: 1;
                                            }

                                            Input {
                                                placeholder: "Confirm new PIN";
                                                password: true;
                                                text <=> root.change-pin-confirm;
                                                error: root.change-pin-confirm != "" && root.change-pin-new != root.change-pin-confirm;
                                                error-message: "PINs do not match";
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        if root.change-pin-error != "": Text {
                                            text: root.change-pin-error;
                                            color: Colors.error;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }

                                        if root.change-pin-success != "": Text {
                                            text: root.change-pin-success;
                                            color: Colors.success;
                                            font-size: Typography.xs;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-pin-form = false;
                                                    root.change-pin-current = "";
                                                    root.change-pin-new = "";
                                                    root.change-pin-confirm = "";
                                                }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Save";
                                                variant: "primary";
                                                loading: root.change-pin-loading;
                                                disabled: root.change-pin-current == "" ||
                                                         root.change-pin-new == "" ||
                                                         root.change-pin-confirm == "";
                                                clicked => {
                                                    root.change-pin(root.change-pin-current, root.change-pin-new);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Colors.divider; }

                            // Key Backup group
                            Rectangle {
                                background: transparent;
                                border-radius: Spacing.none;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    SettingsRow {
                                        touch: root.mobile-platform;
                                        icon: Icons.download;
                                        title: "Key Backup";
                                        detail: "Status: " + (root.backup-status == "backed_up" ? "Backed up" : root.backup-status == "not_backed_up" ? "Not backed up" : "Unknown");
                                        detail-color: root.backup-status == "backed_up" ? Colors.success : root.backup-status == "not_backed_up" ? Colors.warning : Colors.text-secondary;
                                        clickable: false;
                                        show-chevron: false;
                                        action-label: !show-backup-retry && root.backup-status != "backed_up" ? "Retry" : "";
                                        clicked => { show-backup-retry = true; }
                                    }

                                    // Inline retry form
                                    if show-backup-retry && root.backup-status != "backed_up": VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.divider;
                                        }

                                        Input {
                                            placeholder: "Enter your PIN to retry backup";
                                            password: true;
                                            text <=> root.backup-retry-pin;
                                        }

                                        if root.backup-retry-error != "": Text {
                                            text: root.backup-retry-error;
                                            color: Colors.error;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-backup-retry = false;
                                                    root.backup-retry-pin = "";
                                                }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Retry";
                                                variant: "primary";
                                                loading: root.backup-retry-loading;
                                                disabled: root.backup-retry-pin == "";
                                                clicked => {
                                                    root.retry-backup(root.backup-retry-pin);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                                }
                            }

                            // Message Backup group (encrypted history export/restore)
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Message Backup";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    Text {
                                        text: "Encrypted backup of your message history, conversations, and contacts. Neither the file nor the server copy can be read without your passphrase or PIN.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    if !root.file-backup-available: Text {
                                        text: "File backup is unavailable on this device. Use server backup below.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    if root.file-backup-available: Input {
                                        placeholder: "Backup passphrase (for file backup)";
                                        password: true;
                                        text <=> root.message-backup-passphrase;
                                    }

                                    if root.file-backup-available: HorizontalLayout {
                                        spacing: Spacing.sm;
                                        alignment: end;

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Export to File…";
                                            variant: "secondary";
                                            disabled: root.message-backup-passphrase == "";
                                            clicked => {
                                                root.export-message-backup(root.message-backup-passphrase);
                                            }
                                        }

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Restore from File…";
                                            variant: "secondary";
                                            disabled: root.message-backup-passphrase == "";
                                            clicked => {
                                                root.import-message-backup(root.message-backup-passphrase);
                                            }
                                        }
                                    }

                                    Input {
                                        placeholder: "PIN (for server backup)";
                                        password: true;
                                        text <=> root.message-backup-pin;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        alignment: end;

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Back Up to Server";
                                            variant: "secondary";
                                            disabled: root.message-backup-pin == "";
                                            clicked => {
                                                root.server-message-backup(root.message-backup-pin);
                                            }
                                        }

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Restore from Server";
                                            variant: "secondary";
                                            disabled: root.message-backup-pin == "";
                                            clicked => {
                                                root.restore-message-backup(root.message-backup-pin);
                                            }
                                        }
                                    }

                                    if root.message-backup-status != "": Text {
                                        text: root.message-backup-status;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Danger Zone
                            Rectangle { height: Spacing.md; }

                            Text {
                                text: "Danger Zone";
                                color: Colors.error;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            Rectangle {
                                background: Colors.error.with-alpha(0.05);
                                border-radius: Spacing.radius-lg;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    // Logout row
                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Session on this device";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: "Sign out of your account on this device.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }

                                        if !show-logout-confirm && !root.compact-mode: Button {
                                            touch: root.mobile-platform;
                                            text: "Log Out";
                                            variant: "destructive";
                                            clicked => { show-logout-confirm = true; }
                                        }
                                    }

                                    // Compact: full-width button stacked below
                                    if !show-logout-confirm && root.compact-mode: Button {
                                        touch: root.mobile-platform;
                                        text: "Log Out";
                                        variant: "destructive";
                                        clicked => { show-logout-confirm = true; }
                                    }

                                    if show-logout-confirm: HorizontalLayout {
                                        alignment: end;
                                        spacing: Spacing.sm;

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Cancel";
                                            variant: "secondary";
                                            clicked => { show-logout-confirm = false; }
                                        }

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Log Out of This Device";
                                            variant: "destructive";
                                            clicked => {
                                                show-logout-confirm = false;
                                                root.logout-clicked();
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: Colors.error.with-alpha(0.2);
                                    }

                                    // Delete account row
                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                // Not plain "Account" — that is the
                                                // section header a few rows up.
                                                text: "This account";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: "Permanently delete your account and all associated data. This action cannot be undone.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // First click reveals a confirmation step
                                        // (with password) — never deletes directly.
                                        if !show-delete-confirm && !root.compact-mode: Button {
                                            touch: root.mobile-platform;
                                            text: "Delete Account";
                                            variant: "destructive";
                                            clicked => {
                                                root.delete-account-clicked();
                                                show-delete-confirm = true;
                                            }
                                        }
                                    }

                                    // Compact: full-width button stacked below
                                    if !show-delete-confirm && root.compact-mode: Button {
                                        touch: root.mobile-platform;
                                        text: "Delete Account";
                                        variant: "destructive";
                                        clicked => {
                                            root.delete-account-clicked();
                                            show-delete-confirm = true;
                                        }
                                    }

                                    // Inline delete confirmation (explicit confirm gate)
                                    if show-delete-confirm: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.error.with-alpha(0.2);
                                        }

                                        Text {
                                            text: "This permanently deletes your account and all associated data. This cannot be undone. Enter your password to confirm.";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }

                                        Input {
                                            placeholder: "Password";
                                            password: true;
                                            text <=> root.delete-password;
                                            error: root.delete-error != "";
                                            error-message: root.delete-error;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-delete-confirm = false;
                                                    root.delete-password = "";
                                                }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Delete Forever";
                                                variant: "destructive";
                                                loading: root.delete-loading;
                                                disabled: root.delete-password == "";
                                                clicked => {
                                                    root.delete-account-confirmed(root.delete-password);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Linked devices section. The device list and "Link
                        // new device" live in the sessions pane this opens, so
                        // there is one place for both, not two.
                        if active-section == "devices": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Linked devices";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            HorizontalLayout {
                                                spacing: Spacing.sm;

                                                Text {
                                                    text: "Devices";
                                                    color: Colors.text-primary;
                                                    font-size: Typography.sm;
                                                    font-weight: Typography.medium;
                                                }

                                                // Zero is also the initial value before sessions load.
                                                // Display an unknown count until a signed-in session is known.
                                                Rectangle {
                                                    width: 24px;
                                                    height: 20px;
                                                    border-radius: Spacing.radius-sm;
                                                    background: Colors.action-fill;

                                                    Text {
                                                        text: root.session-count > 0 ? "\{root.session-count}" : "—";
                                                        color: Colors.on-action;
                                                        font-size: Typography.xs;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: 100%;
                                                        height: 100%;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "Phones and computers signed in to your account. Link a new device or sign one out.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if !root.compact-mode: Button {
                                            touch: root.mobile-platform;
                                            text: "Manage devices";
                                            variant: "secondary";
                                            clicked => { root.view-sessions-clicked(); }
                                        }
                                    }

                                    // Compact: full-width button stacked below
                                    if root.compact-mode: Button {
                                        touch: root.mobile-platform;
                                        text: "Manage devices";
                                        variant: "secondary";
                                        clicked => { root.view-sessions-clicked(); }
                                    }
                                }
                            }
                        }

                        // Privacy section
                        if active-section == "privacy": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Privacy";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "Control what information you share with others";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                            }

                            // Who can see my photo and name. Enforced by who
                            // receives our profile key (core profile_visibility);
                            // restricting rotates the key, so it may ask for the PIN.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Who can see my photo and name";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    Text {
                                        text: "Everyone else sees your initials. Narrowing this gives your profile a new key, so people who could see it before can't.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    for opt in [
                                        { key: "everyone", label: "Everyone" },
                                        { key: "contacts", label: "My contacts" },
                                        { key: "nobody", label: "Nobody" },
                                    ]: Rectangle {
                                        property <bool> selected: (root.profile-visibility-pending != "" ? root.profile-visibility-pending : root.profile-visibility) == opt.key;
                                        height: Spacing.touch-target-min;
                                        border-radius: Spacing.radius-md;
                                        background: visibility-touch.has-hover ? Colors.surface-hover : transparent;
                                        accessible-role: button;
                                        accessible-label: opt.label;
                                        accessible-action-default => {
                                            if !root.profile-visibility-busy { root.profile-visibility-selected(opt.key); }
                                        }

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.md;
                                            alignment: start;

                                            // Radio indicator
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    border-width: Spacing.stroke;
                                                    border-color: selected ? Colors.primary : Colors.text-muted;

                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: selected ? Colors.primary : transparent;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: opt.label;
                                                vertical-alignment: center;
                                                color: selected ? Colors.text-primary : Colors.text-secondary;
                                                font-size: Typography.sm;
                                                font-weight: selected ? Typography.medium : Typography.normal;
                                            }
                                        }

                                        visibility-touch := TouchArea {
                                            enabled: !root.profile-visibility-busy;
                                            mouse-cursor: pointer;
                                            clicked => { root.profile-visibility-selected(opt.key); }
                                        }
                                    }

                                    if root.profile-visibility-pending != "": VerticalLayout {
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Enter your PIN to change this";
                                            color: Colors.text-secondary;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }

                                        Input {
                                            placeholder: "PIN";
                                            password: true;
                                            text <=> root.profile-visibility-pin;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Cancel";
                                                variant: "secondary";
                                                disabled: root.profile-visibility-busy;
                                                clicked => { root.profile-visibility-cancelled(); }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Confirm";
                                                loading: root.profile-visibility-busy;
                                                disabled: root.profile-visibility-busy || root.profile-visibility-pin == "";
                                                clicked => {
                                                    root.profile-visibility-confirmed(root.profile-visibility-pending, root.profile-visibility-pin);
                                                }
                                            }
                                        }
                                    }

                                    if root.profile-visibility-error != "": Text {
                                        text: root.profile-visibility-error;
                                        color: Colors.error;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Shield setting. The switch shows AnonMode, never
                            // its own guess: turning ON only asks for the PIN
                            // and may be cancelled, so a tap snaps the switch
                            // back to the truth and `changed shield-on` below
                            // moves it once the mode actually flips.
                            // Offered without Tor too (see the chat-list
                            // header shield); only the Tor promise is gated.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Shield";
                                    checked <=> root.shield-switch;
                                    toggled(value) => {
                                        root.shield-switch = AnonMode.enabled;
                                        root.shield-toggled();
                                    }

                                    Text {
                                        text: "Shield";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: AnonMode.onion-built
                                            ? "Show only anonymous conversations and route traffic over Tor. Turning it on asks for your PIN"
                                            : "Show only anonymous conversations. Turning it on asks for your PIN";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Who can find me by my username. The server
                            // enforces it; the choice shows the persisted value.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Who can find me by my username";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: root.username-discoverable
                                            ? "Anyone who types your exact username can find you"
                                            : "Only people with your friend code or username link can find you";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        alignment: start;

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Everyone";
                                            variant: root.username-discoverable ? "primary" : "secondary";
                                            clicked => {
                                                if !root.username-discoverable {
                                                    root.username-discoverable = true;
                                                    root.username-discoverable-changed(true);
                                                }
                                            }
                                        }

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Nobody";
                                            variant: root.username-discoverable ? "secondary" : "primary";
                                            clicked => {
                                                if root.username-discoverable {
                                                    root.username-discoverable = false;
                                                    root.username-discoverable-changed(false);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Read Receipts setting
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Read Receipts";
                                    checked <=> root.read-receipts-enabled;
                                    toggled(value) => {
                                        root.read-receipts-enabled = value;
                                        root.read-receipts-changed(value);
                                    }

                                    Text {
                                        text: "Read Receipts";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Let others know when you've read their messages";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Typing Indicators setting
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Typing Indicators";
                                    checked <=> root.typing-indicators-enabled;
                                    toggled(value) => {
                                        root.typing-indicators-enabled = value;
                                        root.typing-indicators-changed(value);
                                    }

                                    Text {
                                        text: "Typing Indicators";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Show when you're typing a message";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Search shortcut setting (3-way segmented selector).
                            // Keyboard shortcuts mean nothing on a phone.
                            if !root.mobile-platform: Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Search shortcut";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Which keys open search";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.xs;
                                        vertical-stretch: 0;
                                        alignment: center;

                                        for opt[idx] in [
                                            { key: "k", label: "Ctrl+K" },
                                            { key: "f", label: "Ctrl+F" },
                                            { key: "both", label: "Both" },
                                        ]: Rectangle {
                                            property <bool> selected: root.search-shortcut == opt.key;
                                            height: Spacing.button-height;
                                            min-width: 56px;
                                            border-radius: Spacing.radius-md;
                                            background: selected ? Colors.action-fill : Colors.surface-hover;
                                            border-width: 0px;

                                            HorizontalLayout {
                                                padding-left: Spacing.sm;
                                                padding-right: Spacing.sm;
                                                Text {
                                                    text: opt.label;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                    color: selected ? Colors.on-action : Colors.text-secondary;
                                                    font-size: Typography.xs;
                                                    font-weight: selected ? Typography.semibold : Typography.medium;
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.search-shortcut = opt.key;
                                                    root.search-shortcut-changed(opt.key);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Notifications section
                        if active-section == "notifications": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Notifications";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            VerticalLayout {
                                spacing: Spacing.sm;
                                init => { NotificationDelivery.load(); }

                                ToggleRow {
                                    accessible-text: "Account push notifications";
                                    checked <=> NotificationDelivery.push-enabled;
                                    disabled: NotificationDelivery.busy || !NotificationDelivery.loaded;
                                    toggled(value) => { NotificationDelivery.push-enabled-changed(value); }

                                    Text {
                                        text: "Account push notifications";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                    }
                                    Text {
                                        text: "Allow server push notifications for all devices on this account. Device notification settings still apply.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                                if NotificationDelivery.busy: Text {
                                    text: "Saving or loading notification preferences…";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }
                                if NotificationDelivery.error != "": Text {
                                    text: NotificationDelivery.error;
                                    color: Colors.error;
                                    font-size: Typography.xs;
                                    wrap: word-wrap;
                                }
                                if NotificationDelivery.error != "": Button {
                                    touch: root.mobile-platform;
                                    text: "Retry";
                                    variant: "ghost";
                                    disabled: NotificationDelivery.busy;
                                    clicked => { NotificationDelivery.load(); }
                                }
                            }

                            // Notification content (Signal: Settings > Notifications >
                            // Show). Governs what reaches the OS notification shade —
                            // enforced in core (NotificationService::show_message_notification);
                            // sealed-sender messages never show a sender regardless.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Notification content";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    Text {
                                        text: "What message notifications show on this device";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    for opt in [
                                        { key: "name_and_message", label: "Name and message" },
                                        { key: "name_only", label: "Name only" },
                                        { key: "none", label: "No name or content" },
                                    ]: Rectangle {
                                        property <bool> selected: root.notification-detail == opt.key;
                                        height: Spacing.touch-target-min;
                                        border-radius: Spacing.radius-md;
                                        background: detail-touch.has-hover ? Colors.surface-hover : transparent;
                                        accessible-role: button;
                                        accessible-label: opt.label;
                                        accessible-action-default => {
                                            root.notification-detail = opt.key;
                                            root.notification-detail-changed(opt.key);
                                        }

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.md;
                                            alignment: start;

                                            // Radio indicator
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    border-width: Spacing.stroke;
                                                    border-color: selected ? Colors.primary : Colors.text-muted;

                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: selected ? Colors.primary : transparent;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: opt.label;
                                                vertical-alignment: center;
                                                color: selected ? Colors.text-primary : Colors.text-secondary;
                                                font-size: Typography.sm;
                                                font-weight: selected ? Typography.medium : Typography.normal;
                                            }
                                        }

                                        detail-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.notification-detail = opt.key;
                                                root.notification-detail-changed(opt.key);
                                            }
                                        }
                                    }
                                }
                            }

                            // Sound and vibration. On Android both belong to the
                            // OS notification channel, so the row opens its page;
                            // on desktop it is a switch the notifier honours.
                            if NotificationSound.mode == "system": Rectangle {
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;
                                min-height: Spacing.touch-target-min;
                                background: sound-touch.has-hover ? Colors.surface-hover : Colors.surface;
                                accessible-role: button;
                                accessible-label: "Sound and vibration";
                                accessible-action-default => { NotificationSound.open-system-settings(); }

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: Spacing.xxs;

                                        Text {
                                            text: "Sound and vibration";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: "Opens this device's settings for message notifications";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: 18px;
                                            height: 18px;
                                            source: Icons.chevron-right;
                                            colorize: Colors.text-muted;
                                        }
                                    }
                                }

                                sound-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { NotificationSound.open-system-settings(); }
                                }
                            }

                            if NotificationSound.mode == "toggle": Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Notification sound";
                                    checked <=> NotificationSound.enabled;
                                    toggled(value) => { NotificationSound.enabled-changed(value); }

                                    Text {
                                        text: "Notification sound";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Play a sound when a message notification arrives";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // Encryption section
                        if active-section == "encryption": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Encryption";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "Your messages are protected with Signal Protocol end-to-end encryption";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }

                            // Identity Verification group
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        // Our identity key's fingerprint. A safety
                                        // number is per conversation (Signal) and
                                        // lives on the contact's profile.
                                        text: "Your identity key";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }

                                    // Fingerprint display — Neo inset
                                    Rectangle {
                                        background: Colors.inset;
                                        border-radius: Spacing.radius-md;

                                        VerticalLayout {
                                            padding: Spacing.lg;

                                            Text {
                                                text: root.identity-fingerprint != "" ? root.identity-fingerprint : "No fingerprint available";
                                                color: root.identity-fingerprint != "" ? Colors.text-secondary : Colors.text-muted;
                                                font-size: Typography.sm;
                                                letter-spacing: 1px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;

                                        Text {
                                            text: "To verify a contact, compare safety numbers from their profile";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                        }

                                        if !root.compact-mode: Button {
                                            touch: root.mobile-platform;
                                            text: "Copy";
                                            variant: "ghost";
                                            clicked => { root.copy-fingerprint-clicked(); }
                                        }
                                    }

                                    // Compact: full-width button stacked below
                                    if root.compact-mode: Button {
                                        touch: root.mobile-platform;
                                        text: "Copy";
                                        variant: "ghost";
                                        clicked => { root.copy-fingerprint-clicked(); }
                                    }
                                }
                            }

                            // Sealed Sender setting
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Allow sealed sender from anyone";
                                    checked <=> root.sealed-sender-unrestricted;
                                    toggled(value) => {
                                        root.sealed-sender-unrestricted = value;
                                        root.sealed-sender-changed(value);
                                    }

                                    Text {
                                        text: "Allow sealed sender from anyone";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Accept messages from unknown senders without revealing your identity";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // AI Assistant section
                        if active-section == "ai": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "AI Assistant";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            if JarvisGlobal.enabled : Text {
                                init => { root.local-ai-refresh(); }
                                text: "Chat with Jarvis in the AI channel. Local models run on your device; cloud models send your prompts and conversation context to the selected provider.";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }

                            // Enable Local AI toggle
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Enable Local AI";
                                    checked <=> root.local-ai-enabled;
                                    glow-mode: "cyan";
                                    toggled(value) => {
                                        root.local-ai-enabled = value;
                                        root.local-ai-enabled-changed(value);
                                    }

                                    Text {
                                        text: "Enable Local AI";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Run AI models on this device for privacy";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // ── Cloud AI ───────────────────────────────────
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    ToggleRow {
                                        row-spacing: Spacing.md;
                                        label-spacing: Spacing.sm;
                                        accessible-text: "Use cloud AI";
                                        checked <=> root.ai-prefer-cloud;
                                        glow-mode: "cyan";
                                        toggled(value) => {
                                            root.ai-prefer-cloud = value;
                                            root.ai-prefer-cloud-changed(value);
                                        }

                                        Text {
                                            text: "Use cloud AI";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }
                                        Text {
                                            text: "Send prompts to a cloud model for better answers. Only in channels — direct messages always stay on this device.";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    // Who pays, and who sees the prompt.
                                    if root.ai-prefer-cloud: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.divider;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "My API key";
                                                variant: root.cloud-ai-mode == "direct-anthropic" ? "primary" : "secondary";
                                                clicked => {
                                                    root.cloud-ai-mode = "direct-anthropic";
                                                    root.cloud-ai-mode-changed("direct-anthropic");
                                                }
                                            }

                                            Button {
                                                touch: root.mobile-platform;
                                                text: "Buy tokens";
                                                variant: root.cloud-ai-mode == "server-broker" ? "primary" : "secondary";
                                                clicked => {
                                                    root.cloud-ai-mode = "server-broker";
                                                    root.cloud-ai-mode-changed("server-broker");
                                                }
                                            }
                                        }

                                        // Bring-your-own-key: nobody but the
                                        // provider sees the prompt.
                                        if root.cloud-ai-mode == "direct-anthropic": VerticalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: "Your key is stored on this device only. Prompts go straight to the provider — our servers never see them.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }

                                            Input {
                                                placeholder: root.cloud-ai-configured ? "API key saved — enter a new one to replace it" : "Anthropic API key";
                                                password: true;
                                                text <=> root.cloud-ai-api-key;
                                            }

                                            HorizontalLayout {
                                                alignment: start;
                                                Button {
                                                    touch: root.mobile-platform;
                                                    text: "Save key";
                                                    variant: "secondary";
                                                    clicked => {
                                                        root.cloud-ai-api-key-changed(root.cloud-ai-api-key);
                                                        root.cloud-ai-api-key = "";
                                                    }
                                                }
                                            }
                                        }

                                        // Managed tokens: state the trade plainly.
                                        if root.cloud-ai-mode == "server-broker": VerticalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: "No API key needed. Prompts are sent through our servers, which see them in order to meter usage.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }

                                            if root.cloud-ai-balance != "": Text {
                                                text: root.cloud-ai-balance;
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                            }

                                            HorizontalLayout {
                                                alignment: start;
                                                Button {
                                                    touch: root.mobile-platform;
                                                    text: "Refresh balance";
                                                    variant: "secondary";
                                                    clicked => { root.cloud-ai-refresh-quota(); }
                                                }
                                            }
                                        }

                                        if root.cloud-ai-status != "": Text {
                                            text: root.cloud-ai-status;
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // Memory browser entry
                            if root.local-ai-enabled: HorizontalLayout {
                                alignment: start;
                                Button {
                                    touch: root.mobile-platform;
                                    text: "View Memory";
                                    variant: "secondary";
                                    clicked => { root.local-ai-open-memory(); }
                                }
                            }

                            // Hardware summary
                            if root.local-ai-enabled && root.local-ai-hardware-summary != "": Text {
                                text: "Hardware: " + root.local-ai-hardware-summary;
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }

                            // Detected providers
                            if root.local-ai-enabled: Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: "Detected Providers";
                                            color: Colors.text-primary;
                                            font-size: Typography.lg;
                                            font-weight: Typography.medium;
                                        }
                                        Button {
                                            touch: root.mobile-platform;
                                            text: root.local-ai-detecting ? "Scanning..." : "Rescan";
                                            variant: "ghost";
                                            disabled: root.local-ai-detecting;
                                            clicked => { root.local-ai-refresh(); }
                                        }
                                    }

                                    if root.local-ai-providers.length == 0 && !root.local-ai-detecting: Text {
                                        text: "No local AI providers found. Start Ollama (ollama.com), LM Studio, llama.cpp server, or vLLM and rescan.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    for provider in root.local-ai-providers: Rectangle {
                                        height: 44px * Appearance.text-grow;
                                        border-radius: Spacing.radius-md;
                                        background: provider.is-active ? Colors.surface-hover : transparent;
                                        provider-touch := TouchArea {
                                            clicked => { root.local-ai-select-provider(provider.kind); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.sm;
                                            // health dot: listed == reachable
                                            Rectangle {
                                                width: 8px; height: 8px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                background: Colors.success;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text {
                                                    text: provider.display-name;
                                                    color: Colors.text-primary;
                                                    font-size: Typography.sm;
                                                    font-weight: provider.is-active ? Typography.semibold : Typography.medium;
                                                }
                                                Text {
                                                    text: provider.detail;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                }
                                            }
                                            if provider.is-active: Text {
                                                text: "Active";
                                                color: Colors.primary;
                                                font-size: Typography.xs;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Chat model of the active provider
                            if root.local-ai-enabled && root.local-ai-models.length > 0: Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Chat Model";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }

                                    for model in root.local-ai-models: Rectangle {
                                        height: Spacing.button-height;
                                        border-radius: Spacing.radius-md;
                                        background: model == root.local-ai-active-model ? Colors.surface-hover : transparent;
                                        model-touch := TouchArea {
                                            clicked => { root.local-ai-select-model(model); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: model;
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                vertical-alignment: center;
                                            }
                                            if model == root.local-ai-active-model: Text {
                                                text: "✓";
                                                color: Colors.primary;
                                                font-size: Typography.sm;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Downloadable model catalog (hardware-fit tagged)
                            if root.local-ai-enabled && root.local-ai-catalog.length > 0: Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Popular Models";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Downloads go through Ollama — no account needed. Suggestions are filtered by your hardware.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    for entry in root.local-ai-catalog: Rectangle {
                                        height: entry.error != "" ? 64px : 48px;
                                        border-radius: Spacing.radius-md;

                                        VerticalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.xxs;

                                            HorizontalLayout {
                                                spacing: Spacing.sm;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    Text {
                                                        text: entry.name;
                                                        color: entry.fit == "big" ? Colors.text-muted : Colors.text-primary;
                                                        font-size: Typography.sm;
                                                        font-weight: Typography.medium;
                                                    }
                                                    Text {
                                                        text: entry.detail + " · " + entry.fit-label;
                                                        color: entry.fit == "gpu" ? Colors.success : (entry.fit == "cpu" ? Colors.warning : Colors.text-muted);
                                                        font-size: Typography.xs;
                                                    }
                                                }
                                                if entry.installed: Text {
                                                    text: "Installed";
                                                    color: Colors.success;
                                                    font-size: Typography.xs;
                                                    vertical-alignment: center;
                                                }
                                                if !entry.installed && entry.downloading: Text {
                                                    text: floor(entry.progress * 100) + "%";
                                                    color: Colors.text-secondary;
                                                    font-size: Typography.xs;
                                                    vertical-alignment: center;
                                                }
                                                if !entry.installed && !entry.downloading: Button {
                                                    touch: root.mobile-platform;
                                                    text: entry.error != "" ? "Retry" : "Download";
                                                    variant: "secondary";
                                                    disabled: entry.fit == "big";
                                                    clicked => { root.local-ai-download(entry.tag); }
                                                }
                                            }

                                            // Download progress bar
                                            if entry.downloading: Rectangle {
                                                height: 4px;
                                                border-radius: 2px;
                                                background: Colors.surface-hover;
                                                Rectangle {
                                                    x: 0;
                                                    width: parent.width * entry.progress;
                                                    height: parent.height;
                                                    border-radius: 2px;
                                                    background: Colors.primary;
                                                }
                                            }

                                            if entry.error != "": Text {
                                                text: entry.error;
                                                color: Colors.error;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            // In-process (mistralrs) model configuration
                            if root.local-ai-enabled && root.local-ai-active-provider == "mistralrs": Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    Text {
                                        text: "Model Configuration";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }

                                    // Status display
                                    HorizontalLayout {
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Status:";
                                            color: Colors.text-muted;
                                            font-size: Typography.sm;
                                        }

                                        Text {
                                            text: root.local-ai-status != "" ? root.local-ai-status : "Not loaded";
                                            color: root.local-ai-status == "" ? Colors.text-muted :
                                                   (root.local-ai-loading ? Colors.warning : Colors.success);
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }
                                    }

                                    // Error display
                                    if root.local-ai-error != "": Text {
                                        text: root.local-ai-error;
                                        color: Colors.error;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    // Model ID input
                                    VerticalLayout {
                                        spacing: Spacing.xs;

                                        Text {
                                            text: "Model ID (HuggingFace)";
                                            color: Colors.text-secondary;
                                            font-size: Typography.xs;
                                        }

                                        Input {
                                            text <=> root.local-ai-model-id;
                                            placeholder: "mistralai/Mistral-7B-Instruct-v0.3";
                                            disabled: root.local-ai-loading;
                                        }

                                        Text {
                                            text: "Enter a HuggingFace model ID (e.g., mistralai/Mistral-7B-Instruct-v0.3)";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    // Load/Unload buttons
                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        alignment: end;

                                        Button {
                                            touch: root.mobile-platform;
                                            text: "Unload";
                                            variant: "ghost";
                                            disabled: root.local-ai-loading || root.local-ai-status == "";
                                            clicked => { root.local-ai-unload-model(); }
                                        }

                                        Button {
                                            touch: root.mobile-platform;
                                            text: root.local-ai-loading ? "Loading..." : "Load Model";
                                            variant: "primary";
                                            loading: root.local-ai-loading;
                                            disabled: root.local-ai-model-id == "" || root.local-ai-loading;
                                            clicked => { root.local-ai-load-model(root.local-ai-model-id); }
                                        }
                                    }
                                }
                            }

                        }

                        // Appearance section
                        if active-section == "appearance": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Appearance";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            // Theme. Kept on this device (core: `ThemeMode`),
                            // applied live through the `Appearance` global.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Theme";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    for opt in [
                                        { key: "system", label: "System", hint: "Match this device's light or dark setting" },
                                        { key: "light", label: "Light", hint: "" },
                                        { key: "dark", label: "Dark", hint: "" },
                                    ]: Rectangle {
                                        property <bool> selected: Appearance.theme == opt.key;
                                        min-height: Spacing.touch-target-min;
                                        border-radius: Spacing.radius-md;
                                        background: theme-touch.has-hover ? Colors.surface-hover : transparent;
                                        accessible-role: button;
                                        accessible-label: opt.label;
                                        accessible-action-default => {
                                            Appearance.theme = opt.key;
                                            Appearance.theme-changed(opt.key);
                                        }

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.md;
                                            alignment: start;

                                            // Radio indicator
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    border-width: Spacing.stroke;
                                                    border-color: selected ? Colors.primary : Colors.text-muted;

                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: selected ? Colors.primary : transparent;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                Text {
                                                    text: opt.label;
                                                    color: selected ? Colors.text-primary : Colors.text-secondary;
                                                    font-size: Typography.sm;
                                                    font-weight: selected ? Typography.medium : Typography.normal;
                                                }

                                                if opt.hint != "": Text {
                                                    text: opt.hint;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        theme-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                Appearance.theme = opt.key;
                                                Appearance.theme-changed(opt.key);
                                            }
                                        }
                                    }
                                }
                            }

                            // Text size. Kept on this device (core: `TextSize`); every
                            // Typography step is drawn at `Appearance.text-scale`.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Text size";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    for opt in [
                                        { key: "small", label: "Small", hint: "" },
                                        { key: "default", label: "Default", hint: "Match this device's font size" },
                                        { key: "large", label: "Large", hint: "" },
                                        { key: "largest", label: "Largest", hint: "" },
                                    ]: Rectangle {
                                        property <bool> selected: Appearance.text-size == opt.key;
                                        min-height: Spacing.touch-target-min;
                                        border-radius: Spacing.radius-md;
                                        background: text-size-touch.has-hover ? Colors.surface-hover : transparent;
                                        accessible-role: button;
                                        accessible-label: opt.label;
                                        accessible-action-default => {
                                            Appearance.text-size = opt.key;
                                            Appearance.text-size-changed(opt.key);
                                        }

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.md;
                                            alignment: start;

                                            // Radio indicator
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    border-width: Spacing.stroke;
                                                    border-color: selected ? Colors.primary : Colors.text-muted;

                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: selected ? Colors.primary : transparent;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                Text {
                                                    text: opt.label;
                                                    color: selected ? Colors.text-primary : Colors.text-secondary;
                                                    font-size: Typography.sm;
                                                    font-weight: selected ? Typography.medium : Typography.normal;
                                                }

                                                if opt.hint != "": Text {
                                                    text: opt.hint;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        text-size-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                Appearance.text-size = opt.key;
                                                Appearance.text-size-changed(opt.key);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Glass effects";
                                    checked <=> Appearance.glass-effects;
                                    toggled(value) => { Appearance.glass-effects-changed(value); }

                                    Text {
                                        text: "Glass effects";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Translucent navigation and controls. Turn off for a simpler appearance and better performance.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;

                                ToggleRow {
                                    row-padding: Spacing.md;
                                    row-spacing: Spacing.md;
                                    label-spacing: Spacing.sm;
                                    accessible-text: "Reduce animations";
                                    checked <=> Appearance.reduce-motion;
                                    toggled(value) => { Appearance.reduce-motion-changed(value); }

                                    Text {
                                        text: "Reduce animations";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Menus, sheets and switches change without motion; loading shimmer, typing dots and the ringing pulse hold still.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Message spacing. Kept on this device (core: `MessageDensity`);
                            // read through the density tokens in `Spacing`.
                            Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                drop-shadow-blur: Elevation.card-blur;
                                drop-shadow-offset-y: Elevation.card-offset;
                                drop-shadow-color: Elevation.card-shadow;
                                border-width: Elevation.rim-width;
                                border-color: Elevation.card-rim;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Message spacing";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    for opt in [
                                        { key: "comfortable", label: "Comfortable", hint: "" },
                                        { key: "compact", label: "Compact", hint: "Fit more messages and conversations on screen" },
                                    ]: Rectangle {
                                        property <bool> selected: Appearance.density == opt.key;
                                        min-height: Spacing.touch-target-min;
                                        border-radius: Spacing.radius-md;
                                        background: density-touch.has-hover ? Colors.surface-hover : transparent;
                                        accessible-role: button;
                                        accessible-label: opt.label;
                                        accessible-action-default => {
                                            Appearance.density = opt.key;
                                            Appearance.density-changed(opt.key);
                                        }

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            spacing: Spacing.md;
                                            alignment: start;

                                            // Radio indicator
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    border-width: Spacing.stroke;
                                                    border-color: selected ? Colors.primary : Colors.text-muted;

                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: selected ? Colors.primary : transparent;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                Text {
                                                    text: opt.label;
                                                    color: selected ? Colors.text-primary : Colors.text-secondary;
                                                    font-size: Typography.sm;
                                                    font-weight: selected ? Typography.medium : Typography.normal;
                                                }

                                                if opt.hint != "": Text {
                                                    text: opt.hint;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        density-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                Appearance.density = opt.key;
                                                Appearance.density-changed(opt.key);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        } // HorizontalLayout
    } // VerticalLayout

    // Compact navigation floats over the full-height content scroll, pinned
    // to the top edge where `content-layout`'s padding-top reserves its room.
    // Explicit x/y: a sized child of a plain Rectangle is CENTRED by default,
    // which put this bar mid-screen over the content on phones (§138).
    if compact-mode: GlassSurface {
        x: 0px;
        y: 0px;
        width: root.width;
        material-enabled: false;
        background: Colors.surface-page;
        border-radius: Spacing.none;

        height: Spacing.touch-target-min + Spacing.sm;

        HorizontalLayout {
            padding-left: Spacing.sm;
            padding-right: Spacing.sm;

            // The only way out of Settings in compact mode — and Settings
            // is a full-screen page, so it is a back chevron on the
            // leading edge, not an X. Was an X here and a "Close Settings"
            // text button at the bottom of the desktop rail: three
            // spellings of one action across two breakpoints.
            DismissButton {
                touch: root.mobile-platform;
                back: true;
                plain: true;
                clicked => { root.close-settings(); }
            }

            // A clipped scrolling strip needs a soft edge beside the back button.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                clip: true;
                tabs := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: tab-layout.preferred-width;
                    viewport-height: self.height;

                    tab-layout := HorizontalLayout {
                        spacing: Spacing.xxs;
                        padding: Spacing.xs;

                        for item in [
                            { id: "account", label: "Account" },
                            { id: "privacy", label: "Privacy" },
                            { id: "notifications", label: "Notifications" },
                            { id: "devices", label: "Linked devices" },
                            { id: "appearance", label: "Appearance" },
                            { id: "encryption", label: "Encryption" },
                            { id: "ai", label: "AI" }
                        ]: Button {
                            touch: root.mobile-platform;
                            text: item.label;
                            height: Spacing.touch-target-min;
                            // Selected tab = the neutral raised pill every other tab bar uses
                            // (bottom nav, Calls, Contacts); teal fill is for actions.
                            variant: root.active-section == item.id ? "secondary" : "ghost";
                            clicked => {
                                root.active-section = item.id;
                                // Bring the selected pill fully clear of the fixed Back
                                // button and the scrolling strip's faded edges.
                                if self.x + tabs.viewport-x < Spacing.sm {
                                    tabs.viewport-x = min(0px, max(tabs.width - tabs.viewport-width, Spacing.sm - self.x));
                                } else if self.x + self.width + tabs.viewport-x > tabs.width - Spacing.sm {
                                    tabs.viewport-x = min(0px, max(tabs.width - tabs.viewport-width, tabs.width - Spacing.sm - self.x - self.width));
                                }
                            }
                        }
                    }
                }
                if tabs.viewport-x < 0px: Rectangle {
                    width: Spacing.lg;
                    height: parent.height;
                    background: @linear-gradient(90deg, Colors.background 0%, Colors.background.with-alpha(0) 100%);
                }
                if tabs.viewport-width + tabs.viewport-x > tabs.width: Rectangle {
                    x: parent.width - self.width;
                    width: Spacing.lg;
                    height: parent.height;
                    background: @linear-gradient(90deg, Colors.background.with-alpha(0) 0%, Colors.background 100%);
                }
            }
        }
    }
}
