// SettingsScreen - Main settings page with sidebar navigation

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { Toggle } from "../components/toggle.slint";
import { NeoActionToggle } from "../components/neo_action_toggle.slint";
import { JarvisGlobal } from "../jarvis/jarvis_global.slint";

export component SettingsScreen inherits Rectangle {
    // User profile data
    in property <string> display-name: "";
    in property <string> username: "";
    in property <image> avatar;
    in property <int> session-count: 0;

    // Change password form state
    in-out property <string> current-password: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in property <bool> password-changing: false;
    in property <string> password-error: "";

    // Change PIN form state
    in-out property <string> change-pin-current: "";
    in-out property <string> change-pin-new: "";
    in-out property <string> change-pin-confirm: "";
    in property <bool> change-pin-loading: false;
    in property <string> change-pin-error: "";
    in property <string> change-pin-success: "";

    // Key backup state
    in property <string> backup-status: "unknown";  // "backed_up", "not_backed_up", "unknown"
    in-out property <string> backup-retry-pin: "";
    in property <bool> backup-retry-loading: false;
    in property <string> backup-retry-error: "";

    // Privacy settings
    in-out property <bool> read-receipts-enabled: true;
    in-out property <bool> typing-indicators-enabled: true;

    // Encryption settings
    in property <string> identity-fingerprint: "";
    in-out property <bool> sealed-sender-unrestricted: false;
    in property <int> prekey-count: 0;

    // AI settings
    in-out property <bool> local-ai-enabled: true;
    in-out property <string> local-ai-model-id: "Qwen/Qwen2.5-7B-Instruct-GGUF";
    in property <bool> local-ai-loading: false;
    in property <string> local-ai-status: "";  // "not loaded", "loading", "loaded: ModelName"
    in property <string> local-ai-error: "";

    // Navigation state
    property <string> active-section: "account";  // "account", "privacy", "encryption", "appearance"
    property <bool> show-password-form: false;
    property <bool> show-pin-form: false;
    property <bool> show-backup-retry: false;

    // Callbacks
    callback edit-profile-clicked();
    callback change-password(string, string);  // current, new
    callback view-sessions-clicked();
    callback logout-clicked();
    callback delete-account-clicked();
    callback close-settings();

    // Privacy callbacks
    callback read-receipts-changed(bool);
    callback typing-indicators-changed(bool);

    // Encryption callbacks
    callback copy-fingerprint-clicked();
    callback sealed-sender-changed(bool);
    callback refresh-keys-clicked();

    // Security callbacks
    callback change-pin(string, string);  // current_pin, new_pin
    callback retry-backup(string);  // pin

    // AI callbacks
    callback local-ai-enabled-changed(bool);
    callback local-ai-load-model(string);  // model_id
    callback local-ai-unload-model();

    background: Colors.background;

    // Responsive breakpoint: compact mode when width < 500px
    property <bool> compact-mode: root.width < 500px;

    // Responsive content padding
    property <length> content-padding: compact-mode ? Spacing.md : Spacing.xl;

    VerticalLayout {

        // Compact mode: horizontal tab bar at top — Neo glass
        if compact-mode: Rectangle {
            height: 48px;
            background: Colors.surface.with-alpha(0.85);
            border-width: 1px;
            border-color: Colors.neo-highlight;
            drop-shadow-blur: Spacing.neo-blur-sm;
            drop-shadow-offset-y: Spacing.neo-offset-sm;
            drop-shadow-color: Colors.neo-shadow;

            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;

                // Close button
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: Spacing.radius-sm;
                    background: compact-close-touch.has-hover ? Colors.surface-hover : transparent;

                    Text {
                        text: "\u{2715}";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    compact-close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-settings(); }
                    }
                }

                // Tab bar (scrollable)
                Flickable {
                    horizontal-stretch: 1;
                    viewport-width: tab-layout.preferred-width;

                    tab-layout := HorizontalLayout {
                        spacing: 2px;
                        padding: Spacing.xs;

                        for item in [
                            { id: "account", label: "Account", enabled: true },
                            { id: "privacy", label: "Privacy", enabled: true },
                            { id: "encryption", label: "Encrypt", enabled: true },
                            { id: "ai", label: "AI", enabled: true },
                            { id: "appearance", label: "Theme", enabled: true }
                        ]: Rectangle {
                            width: compact-tab-text.preferred-width + Spacing.md * 2;
                            height: 32px;
                            border-radius: Spacing.radius-sm;
                            background: active-section == item.id ? Colors.primary :
                                       (compact-tab-touch.has-hover ? Colors.surface-hover : transparent);

                            compact-tab-text := Text {
                                text: item.label;
                                color: active-section == item.id ? Colors.text-primary : Colors.text-secondary;
                                font-size: Typography.xs;
                                font-weight: active-section == item.id ? Typography.medium : Typography.normal;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            compact-tab-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if item.enabled { active-section = item.id; }
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {

        // Sidebar navigation — hidden in compact mode — Neo surface
        if !compact-mode: Rectangle {
            width: min(240px, root.width * 0.35);
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.neo-highlight;
            drop-shadow-blur: Spacing.neo-blur-sm;
            drop-shadow-offset-x: Spacing.neo-offset-sm;
            drop-shadow-color: Colors.neo-shadow;

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.xs;

                // Header
                Text {
                    text: "Settings";
                    color: Colors.text-primary;
                    font-size: Typography.xl;
                    font-weight: Typography.semibold;
                }

                Rectangle { height: Spacing.md; }

                // Navigation items
                for item[index] in [
                    { id: "account", label: "Account", enabled: true },
                    { id: "privacy", label: "Privacy", enabled: true },
                    { id: "encryption", label: "Encryption", enabled: true },
                    { id: "ai", label: "AI Assistant", enabled: true },
                    { id: "appearance", label: "Appearance", enabled: true }
                ]: Rectangle {
                    height: 40px;
                    border-radius: Spacing.radius-md;
                    background: active-section == item.id ? Colors.primary :
                               (nav-touch.has-hover && item.enabled ? Colors.surface-hover : transparent);
                    opacity: item.enabled ? 1.0 : 0.5;

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        alignment: start;

                        Text {
                            text: item.label;
                            color: active-section == item.id ? Colors.text-primary :
                                   (item.enabled ? Colors.text-secondary : Colors.text-muted);
                            font-size: Typography.sm;
                            font-weight: active-section == item.id ? Typography.medium : Typography.normal;
                            vertical-alignment: center;
                        }
                    }

                    nav-touch := TouchArea {
                        mouse-cursor: item.enabled ? pointer : default;
                        clicked => {
                            if item.enabled {
                                active-section = item.id;
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { vertical-stretch: 1; }

                // Back/Close button
                Button {
                    text: "Close Settings";
                    variant: "ghost";
                    clicked => { root.close-settings(); }
                }
            }
        }

        // Content area
        Rectangle {
            horizontal-stretch: 1;
            background: Colors.background;

            Flickable {
                viewport-width: self.width;
                viewport-height: content-layout.preferred-height + root.content-padding * 2;

                content-layout := VerticalLayout {
                    padding: root.content-padding;
                    spacing: root.compact-mode ? Spacing.md : Spacing.lg;
                    alignment: start;

                    // Center content with max-width (wider in compact mode to use space)
                    Rectangle {
                        max-width: root.compact-mode ? root.width : 600px;

                        // Account section
                        if active-section == "account": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Account";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            // Profile info row
                            Rectangle {
                                height: 80px;
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    // Avatar
                                    Avatar {
                                        size: 64px;
                                        source: root.avatar;
                                        fallback-text: root.display-name;
                                    }

                                    // Name and username
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: Spacing.xs;

                                        Text {
                                            text: root.display-name;
                                            color: Colors.text-primary;
                                            font-size: Typography.lg;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "@" + root.username;
                                            color: Colors.text-secondary;
                                            font-size: Typography.sm;
                                        }
                                    }

                                    // Edit button
                                    Button {
                                        text: "Edit Profile";
                                        variant: "ghost";
                                        clicked => { root.edit-profile-clicked(); }
                                    }
                                }
                            }

                            // Security subsection
                            Rectangle { height: Spacing.md; }

                            Text {
                                text: "Security";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            // Change Password group
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Change Password";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: "Update your password regularly to keep your account secure.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if !show-password-form: Button {
                                            text: "Change Password";
                                            variant: "secondary";
                                            clicked => { show-password-form = true; }
                                        }
                                    }

                                    // Inline password form
                                    if show-password-form: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.text-muted.with-alpha(0.2);
                                        }

                                        Input {
                                            placeholder: "Current password";
                                            password: true;
                                            text <=> root.current-password;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            Input {
                                                placeholder: "New password";
                                                password: true;
                                                text <=> root.new-password;
                                                horizontal-stretch: 1;
                                            }

                                            Input {
                                                placeholder: "Confirm new password";
                                                password: true;
                                                text <=> root.confirm-password;
                                                error: root.password-error != "";
                                                error-message: root.password-error;
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-password-form = false;
                                                    root.current-password = "";
                                                    root.new-password = "";
                                                    root.confirm-password = "";
                                                }
                                            }

                                            Button {
                                                text: "Save";
                                                variant: "primary";
                                                loading: root.password-changing;
                                                disabled: root.current-password == "" ||
                                                         root.new-password == "" ||
                                                         root.confirm-password == "";
                                                clicked => {
                                                    root.change-password(root.current-password, root.new-password);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Active Sessions group
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.xs;

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: "Active Sessions";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            // Count badge
                                            Rectangle {
                                                width: 24px;
                                                height: 20px;
                                                border-radius: Spacing.radius-sm;
                                                background: Colors.primary;

                                                Text {
                                                    text: root.session-count;
                                                    color: Colors.text-primary;
                                                    font-size: Typography.xs;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "Manage devices that are signed in to your account.";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Button {
                                        text: "View All Sessions";
                                        variant: "secondary";
                                        clicked => { root.view-sessions-clicked(); }
                                    }
                                }
                            }

                            // Change PIN group
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Change PIN";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: "Your PIN secures your encrypted key backup.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if !show-pin-form: Button {
                                            text: "Change PIN";
                                            variant: "secondary";
                                            clicked => { show-pin-form = true; }
                                        }
                                    }

                                    // Inline PIN form
                                    if show-pin-form: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.text-muted.with-alpha(0.2);
                                        }

                                        Input {
                                            placeholder: "Current PIN";
                                            password: true;
                                            text <=> root.change-pin-current;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.md;

                                            Input {
                                                placeholder: "New PIN (8+ characters)";
                                                password: true;
                                                text <=> root.change-pin-new;
                                                horizontal-stretch: 1;
                                            }

                                            Input {
                                                placeholder: "Confirm new PIN";
                                                password: true;
                                                text <=> root.change-pin-confirm;
                                                error: root.change-pin-error != "" || (root.change-pin-confirm != "" && root.change-pin-new != root.change-pin-confirm);
                                                error-message: root.change-pin-error != "" ? root.change-pin-error : "PINs do not match";
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        if root.change-pin-success != "": Text {
                                            text: root.change-pin-success;
                                            color: Colors.success;
                                            font-size: Typography.xs;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-pin-form = false;
                                                    root.change-pin-current = "";
                                                    root.change-pin-new = "";
                                                    root.change-pin-confirm = "";
                                                }
                                            }

                                            Button {
                                                text: "Save";
                                                variant: "primary";
                                                loading: root.change-pin-loading;
                                                disabled: root.change-pin-current == "" ||
                                                         root.change-pin-new == "" ||
                                                         root.change-pin-confirm == "";
                                                clicked => {
                                                    root.change-pin(root.change-pin-current, root.change-pin-new);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Key Backup group
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Key Backup";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.sm;

                                                Text {
                                                    text: "Status:";
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                }

                                                Text {
                                                    text: root.backup-status == "backed_up" ? "Backed up" :
                                                          root.backup-status == "not_backed_up" ? "Not backed up" : "Unknown";
                                                    color: root.backup-status == "backed_up" ? Colors.success :
                                                           root.backup-status == "not_backed_up" ? Colors.warning : Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    font-weight: Typography.medium;
                                                }
                                            }
                                        }

                                        if !show-backup-retry: Button {
                                            text: "Retry Backup";
                                            variant: "secondary";
                                            clicked => { show-backup-retry = true; }
                                        }
                                    }

                                    // Inline retry form
                                    if show-backup-retry: VerticalLayout {
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            height: 1px;
                                            background: Colors.text-muted.with-alpha(0.2);
                                        }

                                        Input {
                                            placeholder: "Enter your PIN to retry backup";
                                            text <=> root.backup-retry-pin;
                                        }

                                        if root.backup-retry-error != "": Text {
                                            text: root.backup-retry-error;
                                            color: Colors.error;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;
                                            alignment: end;

                                            Button {
                                                text: "Cancel";
                                                variant: "ghost";
                                                clicked => {
                                                    show-backup-retry = false;
                                                    root.backup-retry-pin = "";
                                                }
                                            }

                                            Button {
                                                text: "Retry";
                                                variant: "primary";
                                                loading: root.backup-retry-loading;
                                                disabled: root.backup-retry-pin == "";
                                                clicked => {
                                                    root.retry-backup(root.backup-retry-pin);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Danger Zone
                            Rectangle { height: Spacing.md; }

                            Text {
                                text: "Danger Zone";
                                color: Colors.error;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            Rectangle {
                                background: Colors.error.with-alpha(0.05);
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.error.with-alpha(0.2);
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.error.with-alpha(0.1);

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    // Logout row
                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Log Out";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: "Sign out of your account on this device.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }

                                        Button {
                                            text: "Log Out";
                                            variant: "danger";
                                            clicked => { root.logout-clicked(); }
                                        }
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: Colors.error.with-alpha(0.2);
                                    }

                                    // Delete account row
                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Delete Account";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                            }

                                            Text {
                                                text: "Permanently delete your account and all associated data. This action cannot be undone.";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                wrap: word-wrap;
                                            }
                                        }

                                        Button {
                                            text: "Delete Account";
                                            variant: "danger";
                                            clicked => { root.delete-account-clicked(); }
                                        }
                                    }
                                }
                            }
                        }

                        // Privacy section
                        if active-section == "privacy": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Privacy";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "Control what information you share with others";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                            }

                            // Read Receipts setting
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Read Receipts";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Let others know when you've read their messages";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Toggle {
                                        checked: root.read-receipts-enabled;
                                        toggled(value) => {
                                            root.read-receipts-enabled = value;
                                            root.read-receipts-changed(value);
                                        }
                                    }
                                }
                            }

                            // Typing Indicators setting
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Typing Indicators";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Show when you're typing a message";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Toggle {
                                        checked: root.typing-indicators-enabled;
                                        toggled(value) => {
                                            root.typing-indicators-enabled = value;
                                            root.typing-indicators-changed(value);
                                        }
                                    }
                                }
                            }

                            // Profile Visibility placeholder (coming soon)
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;
                                opacity: 0.5;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Profile Visibility";
                                            color: Colors.text-secondary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Coming soon";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            font-italic: true;
                                        }
                                    }
                                }
                            }
                        }

                        // Encryption section
                        if active-section == "encryption": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Encryption";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "Your messages are protected with Signal Protocol end-to-end encryption";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }

                            // Identity Verification group
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Your Safety Number";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }

                                    // Fingerprint display — Neo inset
                                    Rectangle {
                                        background: Colors.neo-inset-bg;
                                        border-radius: Spacing.radius-md;
                                        border-width: 1px;
                                        border-color: Colors.neo-inset-shadow;

                                        VerticalLayout {
                                            padding: Spacing.lg;

                                            Text {
                                                text: root.identity-fingerprint != "" ? root.identity-fingerprint : "No fingerprint available";
                                                color: root.identity-fingerprint != "" ? Colors.text-secondary : Colors.text-muted;
                                                font-size: Typography.sm;
                                                letter-spacing: 1px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;

                                        Text {
                                            text: "Share this with your contacts to verify encryption";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                        }

                                        Button {
                                            text: "Copy";
                                            variant: "ghost";
                                            clicked => { root.copy-fingerprint-clicked(); }
                                        }
                                    }
                                }
                            }

                            // Sealed Sender setting
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Allow sealed sender from anyone";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Accept messages from unknown senders without revealing your identity";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Toggle {
                                        checked: root.sealed-sender-unrestricted;
                                        toggled(value) => {
                                            root.sealed-sender-unrestricted = value;
                                            root.sealed-sender-changed(value);
                                        }
                                    }
                                }
                            }

                            // Key Status group
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Encryption Keys";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.md;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xs;

                                            HorizontalLayout {
                                                spacing: Spacing.sm;

                                                Text {
                                                    text: "Prekeys available";
                                                    color: Colors.text-secondary;
                                                    font-size: Typography.sm;
                                                    vertical-alignment: center;
                                                }

                                                // Prekey count badge with color indicator
                                                Rectangle {
                                                    width: 32px;
                                                    height: 22px;
                                                    border-radius: Spacing.radius-sm;
                                                    background: root.prekey-count >= 10 ? Colors.success :
                                                               (root.prekey-count >= 5 ? Colors.warning : Colors.error);

                                                    Text {
                                                        text: root.prekey-count;
                                                        color: Colors.text-primary;
                                                        font-size: Typography.xs;
                                                        font-weight: Typography.medium;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: 100%;
                                                        height: 100%;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: root.prekey-count >= 10 ? "Keys are healthy" :
                                                      (root.prekey-count >= 5 ? "Consider refreshing soon" : "Keys are low, refresh recommended");
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }

                                        Button {
                                            text: "Refresh Keys";
                                            variant: "secondary";
                                            clicked => { root.refresh-keys-clicked(); }
                                        }
                                    }
                                }
                            }
                        }

                        // AI Assistant section
                        if active-section == "ai": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "AI Assistant";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            if JarvisGlobal.enabled : Text {
                                text: "Configure local AI for Jarvis assistant (requires GPU)";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }

                            // Enable Local AI toggle
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Enable Local AI";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Run AI models locally on your GPU for privacy";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    NeoActionToggle {
                                        checked: root.local-ai-enabled;
                                        glow-mode: "cyan";
                                        toggled(value) => {
                                            root.local-ai-enabled = value;
                                            root.local-ai-enabled-changed(value);
                                        }
                                    }
                                }
                            }

                            // Model configuration (only show if enabled)
                            if root.local-ai-enabled: Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    Text {
                                        text: "Model Configuration";
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.medium;
                                    }

                                    // Status display
                                    HorizontalLayout {
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Status:";
                                            color: Colors.text-muted;
                                            font-size: Typography.sm;
                                        }

                                        Text {
                                            text: root.local-ai-status != "" ? root.local-ai-status : "Not loaded";
                                            color: root.local-ai-status == "" ? Colors.text-muted :
                                                   (root.local-ai-loading ? Colors.warning : Colors.success);
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }
                                    }

                                    // Error display
                                    if root.local-ai-error != "": Text {
                                        text: root.local-ai-error;
                                        color: Colors.error;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }

                                    // Model ID input
                                    VerticalLayout {
                                        spacing: Spacing.xs;

                                        Text {
                                            text: "Model ID (HuggingFace)";
                                            color: Colors.text-secondary;
                                            font-size: Typography.xs;
                                        }

                                        Input {
                                            text <=> root.local-ai-model-id;
                                            placeholder: "mistralai/Mistral-7B-Instruct-v0.3";
                                            disabled: root.local-ai-loading;
                                        }

                                        Text {
                                            text: "Enter a HuggingFace model ID (e.g., mistralai/Mistral-7B-Instruct-v0.3)";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }

                                    // Load/Unload buttons
                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        alignment: end;

                                        Button {
                                            text: "Unload";
                                            variant: "ghost";
                                            disabled: root.local-ai-loading || root.local-ai-status == "";
                                            clicked => { root.local-ai-unload-model(); }
                                        }

                                        Button {
                                            text: root.local-ai-loading ? "Loading..." : "Load Model";
                                            variant: "primary";
                                            loading: root.local-ai-loading;
                                            disabled: root.local-ai-model-id == "" || root.local-ai-loading;
                                            clicked => { root.local-ai-load-model(root.local-ai-model-id); }
                                        }
                                    }
                                }
                            }

                            // Recommended models
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;

                                VerticalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    Text {
                                        text: "Recommended Models";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }

                                    Text {
                                        text: "• lmstudio-community/Qwen2.5-7B-Instruct-GGUF (default, 4.4GB)\n• Qwen/Qwen2.5-3B-Instruct (faster, 5.8GB)\n• Qwen/Qwen2.5-7B-Instruct (best quality, 15GB)";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // Appearance section
                        if active-section == "appearance": VerticalLayout {
                            spacing: Spacing.lg;

                            // Section header
                            Text {
                                text: "Appearance";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "Dark theme is the only theme for v1.";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                            }

                            // Theme selector (grayed out for v1)
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;
                                opacity: 0.5;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Theme";
                                            color: Colors.text-secondary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Choose your preferred color theme";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                        }
                                    }

                                    // Disabled dropdown indicator
                                    Rectangle {
                                        width: 100px;
                                        height: 36px;
                                        border-radius: Spacing.radius-md;
                                        background: Colors.background;

                                        HorizontalLayout {
                                            padding-left: Spacing.sm;
                                            padding-right: Spacing.sm;
                                            alignment: space-between;

                                            Text {
                                                text: "Dark";
                                                color: Colors.text-secondary;
                                                font-size: Typography.sm;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: "v";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Font Size placeholder (grayed out)
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;
                                opacity: 0.5;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Font Size";
                                            color: Colors.text-secondary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Coming soon";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            font-italic: true;
                                        }
                                    }
                                }
                            }

                            // Message Density placeholder (grayed out)
                            Rectangle {
                                background: Colors.surface;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Colors.neo-highlight;
                                drop-shadow-blur: Spacing.neo-blur-sm;
                                drop-shadow-offset-x: Spacing.neo-offset-sm;
                                drop-shadow-offset-y: Spacing.neo-offset-sm;
                                drop-shadow-color: Colors.neo-shadow;
                                opacity: 0.5;

                                HorizontalLayout {
                                    padding: Spacing.md;
                                    spacing: Spacing.md;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: "Message Density";
                                            color: Colors.text-secondary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Coming soon";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            font-italic: true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        } // HorizontalLayout
    } // VerticalLayout
}
