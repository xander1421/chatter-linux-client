import { AccountSettings } from "account_settings.slint";
import { DevicesSettings } from "devices_settings.slint";
import { PrivacySettings } from "privacy_settings.slint";
import { NotificationsSettings } from "notifications_settings.slint";
import { EncryptionSettings } from "encryption_settings.slint";
import { AISettings } from "ai_settings.slint";
import { AppearanceSettings } from "appearance_settings.slint";
import { AboutSettings } from "about_settings.slint";
import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// SettingsScreen - Main settings page with sidebar navigation

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { DismissButton } from "../components/dismiss_button.slint";
import { Appearance } from "../theme/appearance.slint";
import { Icons } from "../theme/icons.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";
import { SessionInfo, PendingLinkInfo } from "../modals/sessions.slint";

// Shared model data remains exported through this screen for its callers.
import { LocalAIProviderData, CatalogModelData } from "settings_types.slint";
export { LocalAIProviderData, CatalogModelData } from "settings_types.slint";

export component SettingsScreen inherits Rectangle {
    // User profile data
    in property <string> display-name: "";
    in property <string> username: "";
    // Room left for the mobile tab bar drawn over the bottom of the screen.
    in property <length> bottom-inset: 0px;
    in property <bool> mobile-platform: false;
    in property <image> avatar;
    in property <int> session-count: 0;
    in property <[SessionInfo]> sessions: [];
    in property <[PendingLinkInfo]> pending-links: [];
    in property <bool> sessions-loaded: false;
    in property <bool> sessions-loading: false;
    in property <bool> sessions-revoking: false;
    in property <string> sessions-error: "";
    property <int> confirm-revoke-id: 0;

    // Change password form state
    in-out property <string> current-password: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in property <bool> password-changing: false;
    in property <string> password-error: "";

    // Change PIN form state
    in-out property <string> change-pin-current: "";
    in-out property <string> change-pin-new: "";
    in-out property <string> change-pin-confirm: "";
    in property <bool> change-pin-loading: false;
    in property <string> change-pin-error: "";
    in property <string> change-pin-success: "";

    // Key backup state
    in property <string> backup-status: "unknown";  // "backed_up", "not_backed_up", "unknown"
    in-out property <string> backup-retry-pin: "";
    in property <bool> backup-retry-loading: false;
    in property <string> backup-retry-error: "";

    // Message-history backup (encrypted export/restore)
    in-out property <string> message-backup-passphrase: "";
    in-out property <string> message-backup-pin: "";
    in property <string> message-backup-status: "";

    // Privacy settings
    in-out property <bool> read-receipts-enabled: true;
    in-out property <bool> typing-indicators-enabled: true;
    in-out property <string> notification-detail: "none";  // "none" | "name_only" | "name_and_message"
    in-out property <string> search-shortcut: "both";   // "k" | "f" | "both"
    // "Who can see my photo and name": "everyone" | "contacts" | "nobody".
    // A restricting choice that needs the PIN parks in
    // profile-visibility-pending until confirmed (Rust sets it).
    in property <string> profile-visibility: "everyone";
    in property <string> profile-visibility-pending: "";
    in property <bool> profile-visibility-busy: false;
    in property <string> profile-visibility-error: "";
    in-out property <string> profile-visibility-pin: "";

    // Encryption settings
    in property <string> identity-fingerprint: "";
    in-out property <bool> sealed-sender-unrestricted: false;
    // "Who can find me by my username": true = Everyone, false = Nobody.
    in-out property <bool> username-discoverable: true;

    // AI settings
    in-out property <bool> local-ai-enabled: true;
    in-out property <string> local-ai-model-id: "Qwen/Qwen2.5-7B-Instruct-GGUF";
    in property <bool> local-ai-loading: false;
    in property <string> local-ai-status: "";  // "not loaded", "loading", "loaded: ModelName"
    in property <string> local-ai-error: "";
    in property <string> local-ai-hardware-summary: "";
    in property <bool> local-ai-detecting: false;
    in property <[LocalAIProviderData]> local-ai-providers: [];
    in property <string> local-ai-active-provider: "";
    in property <[string]> local-ai-models: [];
    in property <string> local-ai-active-model: "";
    in property <[CatalogModelData]> local-ai-catalog: [];

    // Cloud AI (off-device). Separate from local AI on purpose: this is the
    // surface where content leaves the machine, so it states plainly what goes
    // where.
    in-out property <bool> ai-prefer-cloud: false;
    in-out property <string> cloud-ai-mode: "direct-anthropic";  // | "server-broker"
    in-out property <string> cloud-ai-api-key: "";
    in property <bool> cloud-ai-configured: false;
    in property <string> cloud-ai-status: "";
    in property <string> cloud-ai-balance: "";

    // Delete-account confirmation state
    in-out property <string> delete-password: "";
    in property <bool> delete-loading: false;
    in property <string> delete-error: "";

    // Recovery-code regeneration (password-confirmed; the new codes open in
    // RecoveryCodesModal, the old ones stop working)
    in-out property <string> recovery-regen-password: "";
    in property <bool> recovery-regen-loading: false;
    in property <string> recovery-regen-error: "";

    // Navigation state
    // Mirror of AnonMode.enabled for the Privacy pane's Shield switch; the
    // switch writes it, so it is re-synced from the global on every change.
    property <bool> shield-switch: AnonMode.enabled;
    property <bool> shield-on: AnonMode.enabled;
    changed shield-on => { root.shield-switch = root.shield-on; }
    in-out property <string> active-section: "account";  // "account", "devices", "privacy", "notifications", "encryption", "ai", "appearance"
    property <bool> page-appearing: false;
    property <float> page-entry: 1;
    changed active-section => {
        root.confirm-revoke-id = 0;
        content-scroll.viewport-y = 0px;
        if root.active-section == "devices" { root.refresh-sessions(); }
        // Snap the new section a little toward its source, then let it glide
        // into the same content column. The timer separates the two frames.
        root.page-appearing = false;
        root.page-entry = 0;
        page-entry-timer.running = true;
    }
    page-entry-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.page-appearing = true;
            root.page-entry = 1;
        }
    }
    animate page-entry {
        duration: root.page-appearing ? Materials.motion-standard : 0ms;
        easing: Materials.glide;
    }
    // Log Out asks once: on a phone it sits one thumb-width from Delete Account.

    property <bool> show-password-form: false;
    property <bool> show-pin-form: false;
    property <bool> show-backup-retry: false;
    property <bool> show-delete-confirm: false;
    property <bool> show-recovery-regen: false;
    // Log Out asks once: on a phone it sits one thumb-width from Delete Account.
    property <bool> show-logout-confirm: false;

    // Callbacks
    callback edit-profile-clicked();
    callback change-password(string, string);  // current, new
    callback view-sessions-clicked();
    callback refresh-sessions();
    callback revoke-session(int);
    callback cancel-pending-link(string);
    callback link-new-device();
    callback logout-clicked();
    callback delete-account-clicked();
    callback delete-account-confirmed(string);  // password — fired only after explicit confirm
    callback regenerate-recovery-codes(string);  // password — fired only after explicit confirm
    callback close-settings();
    callback open-licenses();

    // Privacy callbacks
    callback read-receipts-changed(bool);
    callback typing-indicators-changed(bool);
    callback notification-detail-changed(string);
    callback search-shortcut-changed(string);
    callback profile-visibility-selected(string);           // option key
    callback profile-visibility-confirmed(string, string);  // option key, PIN
    callback profile-visibility-cancelled();
    // Shield switch — the same toggle as the chat-list header's shield: ON
    // opens the PIN gate, OFF leaves directly (sidebar/anon_mode.rs).
    callback shield-toggled();

    // Encryption callbacks
    callback copy-fingerprint-clicked();
    callback sealed-sender-changed(bool);
    callback username-discoverable-changed(bool);  // true = Everyone, false = Nobody

    // Security callbacks
    callback change-pin(string, string);  // current_pin, new_pin
    callback retry-backup(string);  // pin

    // Message-history backup callbacks
    callback export-message-backup(string);   // passphrase (file save picker opens in Rust)
    callback import-message-backup(string);   // passphrase (file open picker opens in Rust)
    callback server-message-backup(string);   // pin
    callback restore-message-backup(string);  // pin

    // AI callbacks
    callback local-ai-enabled-changed(bool);
    callback local-ai-load-model(string);  // model_id
    callback local-ai-unload-model();
    callback local-ai-refresh();                 // re-probe providers + hardware
    callback local-ai-open-memory();             // open the memory browser
    callback local-ai-select-provider(string);   // provider kind
    callback local-ai-select-model(string);      // chat model name
    callback local-ai-download(string);          // ollama tag

    // Cloud AI callbacks
    callback ai-prefer-cloud-changed(bool);
    callback cloud-ai-mode-changed(string);      // "direct-anthropic" | "server-broker"
    callback cloud-ai-api-key-changed(string);
    callback cloud-ai-refresh-quota();

    background: Materials.ambient;

    // Responsive breakpoint: compact mode when width < 500px
    property <bool> compact-mode: root.width < 500px;

    // Responsive content padding
    property <length> content-padding: compact-mode ? Spacing.md : Spacing.xl;

    VerticalLayout {
        width: root.width;
        height: root.height;

        HorizontalLayout {
            horizontal-stretch: 1;

        // Sidebar navigation — hidden in compact mode — Neo surface
        if !compact-mode: GlassSurface {
            material-level: 2;
            elevation: 3;

            width: min(240px, root.width * 0.35);

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.xs;

                // Header — back chevron on the LEADING edge, then the title.
                // Settings is a full-window page you pushed into from the
                // sidebar, not a dialog floating over it, so it takes the same
                // affordance the chat header and every full-screen modal take.
                // `touch: false` because this is the one full-screen surface
                // that also exists at mouse density.
                HorizontalLayout {
                    height: Spacing.header-action-box;
                    spacing: Spacing.sm;
                    alignment: start;

                    DismissButton {
                        back: true;
                        plain: true;
                        touch: false;
                        clicked => { root.close-settings(); }
                    }

                    Text {
                        text: "Settings";
                        color: Colors.text-primary;
                        font-size: Typography.xl;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: Spacing.md; }

                // Navigation items
                for item[index] in [
                    { id: "account", label: "Account", enabled: true },
                    { id: "privacy", label: "Privacy", enabled: true },
                    { id: "notifications", label: "Notifications", enabled: true },
                    { id: "devices", label: "Linked devices", enabled: true },
                    { id: "appearance", label: "Appearance", enabled: true },
                    { id: "encryption", label: "Encryption", enabled: true },
                    { id: "ai", label: "AI Assistant", enabled: true },
                    { id: "about", label: "About", enabled: true }
                ]: Rectangle {
                    height: root.mobile-platform ? Spacing.touch-target-min : Spacing.button-height;
                    border-radius: Spacing.radius-md;
                    background: active-section == item.id ? Colors.row-selected :
                               (nav-touch.pressed && item.enabled ? Materials.pressed
                               : nav-touch.has-hover && item.enabled ? Colors.row-hover : transparent);
                    animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                    opacity: item.enabled ? 1.0 : 0.5;

                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.sm;
                        alignment: start;

                        if !root.compact-mode: VerticalLayout {
                            alignment: center;
                            Image {
                                source: item.id == "account" ? Icons.user
                                    : item.id == "devices" ? Icons.smartphone
                                    : item.id == "privacy" ? Icons.shield
                                    : item.id == "notifications" ? Icons.bell
                                    : item.id == "encryption" ? Icons.lock
                                    : item.id == "ai" ? Icons.sparkles
                                    : item.id == "about" ? Icons.info : Icons.moon;
                                width: Spacing.button-icon;
                                height: Spacing.button-icon;
                                colorize: active-section == item.id ? Colors.selected-indicator : Colors.text-secondary;
                            }
                        }

                        Text {
                            text: item.label;
                            color: active-section == item.id ? (root.compact-mode ? Colors.on-action : Colors.text-primary) :
                                   (item.enabled ? Colors.text-secondary : Colors.text-muted);
                            font-size: Typography.sm;
                            font-weight: active-section == item.id ? Typography.medium : Typography.normal;
                            vertical-alignment: center;
                        }
                    }

                    nav-touch := TouchArea {
                        mouse-cursor: item.enabled ? pointer : default;
                        clicked => {
                            if item.enabled {
                                active-section = item.id;
                            }
                        }

                    }
                }

                // Spacer
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Content area
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Colors.background;

            content-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: content-layout.preferred-height;

                content-layout := VerticalLayout {
                    width: parent.width;
                    padding: root.content-padding;
                    padding-left: root.content-padding + Spacing.md * (1 - root.page-entry);
                    padding-top: root.content-padding + (root.compact-mode ? Spacing.touch-target-min + Spacing.sm : Spacing.none);
                    padding-bottom: root.content-padding + root.bottom-inset;
                    spacing: root.compact-mode ? Spacing.md : Spacing.lg;
                    alignment: start;

                    // Center content with max-width (wider in compact mode to use space).
                    // A layout, not a Rectangle: a Rectangle does not pass its
                    // `if` children's height up, so `content-layout` reported
                    // ~0 and the page could not scroll to anything below the
                    // fold (Key Backup was stranded under the tab bar).
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        width: min(root.compact-mode ? root.width : 600px, parent.width);

                        // Account section
                        if active-section == "account": AccountSettings {
                            show-password-form <=> root.show-password-form;
                            show-pin-form <=> root.show-pin-form;
                            show-backup-retry <=> root.show-backup-retry;
                            show-delete-confirm <=> root.show-delete-confirm;
                            show-recovery-regen <=> root.show-recovery-regen;
                            show-logout-confirm <=> root.show-logout-confirm;
                            avatar : root.avatar;
                            backup-retry-error : root.backup-retry-error;
                            backup-retry-loading : root.backup-retry-loading;
                            backup-retry-pin <=> root.backup-retry-pin;
                            backup-status : root.backup-status;
                            change-pin-confirm <=> root.change-pin-confirm;
                            change-pin-current <=> root.change-pin-current;
                            change-pin-error : root.change-pin-error;
                            change-pin-loading : root.change-pin-loading;
                            change-pin-new <=> root.change-pin-new;
                            change-pin-success : root.change-pin-success;
                            compact-mode : root.compact-mode;
                            confirm-password <=> root.confirm-password;
                            current-password <=> root.current-password;
                            delete-error : root.delete-error;
                            delete-loading : root.delete-loading;
                            delete-password <=> root.delete-password;
                            display-name : root.display-name;
                            message-backup-passphrase <=> root.message-backup-passphrase;
                            message-backup-pin <=> root.message-backup-pin;
                            message-backup-status : root.message-backup-status;
                            mobile-platform : root.mobile-platform;
                            new-password <=> root.new-password;
                            password-changing : root.password-changing;
                            password-error : root.password-error;
                            recovery-regen-error : root.recovery-regen-error;
                            recovery-regen-loading : root.recovery-regen-loading;
                            recovery-regen-password <=> root.recovery-regen-password;
                            username : root.username;
                            change-password(arg0, arg1) => { root.change-password(arg0, arg1); }
                            change-pin(arg0, arg1) => { root.change-pin(arg0, arg1); }
                            delete-account-clicked() => { root.delete-account-clicked(); }
                            delete-account-confirmed(arg0) => { root.delete-account-confirmed(arg0); }
                            edit-profile-clicked() => { root.edit-profile-clicked(); }
                            export-message-backup(arg0) => { root.export-message-backup(arg0); }
                            import-message-backup(arg0) => { root.import-message-backup(arg0); }
                            logout-clicked() => { root.logout-clicked(); }
                            regenerate-recovery-codes(arg0) => { root.regenerate-recovery-codes(arg0); }
                            restore-message-backup(arg0) => { root.restore-message-backup(arg0); }
                            retry-backup(arg0) => { root.retry-backup(arg0); }
                            server-message-backup(arg0) => { root.server-message-backup(arg0); }
                        }

                        // Linked devices share the Sessions modal's model and
                        // actions. Keep the full modal available for compact
                        // screens and its revoke-all action.
                        if active-section == "devices": DevicesSettings {
                            compact-mode : root.compact-mode;
                            confirm-revoke-id <=> root.confirm-revoke-id;
                            mobile-platform : root.mobile-platform;
                            pending-links : root.pending-links;
                            session-count : root.session-count;
                            sessions : root.sessions;
                            sessions-error : root.sessions-error;
                            sessions-loaded : root.sessions-loaded;
                            sessions-loading : root.sessions-loading;
                            sessions-revoking : root.sessions-revoking;
                            cancel-pending-link(arg0) => { root.cancel-pending-link(arg0); }
                            link-new-device() => { root.link-new-device(); }
                            revoke-session(arg0) => { root.revoke-session(arg0); }
                            view-sessions-clicked() => { root.view-sessions-clicked(); }
                        }

                        // Privacy section
                        if active-section == "privacy": PrivacySettings {
                            mobile-platform : root.mobile-platform;
                            profile-visibility : root.profile-visibility;
                            profile-visibility-busy : root.profile-visibility-busy;
                            profile-visibility-error : root.profile-visibility-error;
                            profile-visibility-pending : root.profile-visibility-pending;
                            profile-visibility-pin <=> root.profile-visibility-pin;
                            read-receipts-enabled <=> root.read-receipts-enabled;
                            search-shortcut <=> root.search-shortcut;
                            shield-switch <=> root.shield-switch;
                            typing-indicators-enabled <=> root.typing-indicators-enabled;
                            username-discoverable <=> root.username-discoverable;
                            profile-visibility-cancelled() => { root.profile-visibility-cancelled(); }
                            profile-visibility-confirmed(arg0, arg1) => { root.profile-visibility-confirmed(arg0, arg1); }
                            profile-visibility-selected(arg0) => { root.profile-visibility-selected(arg0); }
                            read-receipts-changed(arg0) => { root.read-receipts-changed(arg0); }
                            search-shortcut-changed(arg0) => { root.search-shortcut-changed(arg0); }
                            shield-toggled() => { root.shield-toggled(); }
                            typing-indicators-changed(arg0) => { root.typing-indicators-changed(arg0); }
                            username-discoverable-changed(arg0) => { root.username-discoverable-changed(arg0); }
                        }

                        // Notifications section
                        if active-section == "notifications": NotificationsSettings {
                            mobile-platform : root.mobile-platform;
                            notification-detail <=> root.notification-detail;
                            notification-detail-changed(arg0) => { root.notification-detail-changed(arg0); }
                        }

                        // Encryption section
                        if active-section == "encryption": EncryptionSettings {
                            compact-mode : root.compact-mode;
                            identity-fingerprint : root.identity-fingerprint;
                            mobile-platform : root.mobile-platform;
                            sealed-sender-unrestricted <=> root.sealed-sender-unrestricted;
                            copy-fingerprint-clicked() => { root.copy-fingerprint-clicked(); }
                            sealed-sender-changed(arg0) => { root.sealed-sender-changed(arg0); }
                        }

                        // AI Assistant section
                        if active-section == "ai": AISettings {
                            ai-prefer-cloud <=> root.ai-prefer-cloud;
                            cloud-ai-api-key <=> root.cloud-ai-api-key;
                            cloud-ai-balance : root.cloud-ai-balance;
                            cloud-ai-configured : root.cloud-ai-configured;
                            cloud-ai-mode <=> root.cloud-ai-mode;
                            cloud-ai-status : root.cloud-ai-status;
                            local-ai-active-model : root.local-ai-active-model;
                            local-ai-active-provider : root.local-ai-active-provider;
                            local-ai-catalog : root.local-ai-catalog;
                            local-ai-detecting : root.local-ai-detecting;
                            local-ai-enabled <=> root.local-ai-enabled;
                            local-ai-error : root.local-ai-error;
                            local-ai-hardware-summary : root.local-ai-hardware-summary;
                            local-ai-loading : root.local-ai-loading;
                            local-ai-model-id <=> root.local-ai-model-id;
                            local-ai-models : root.local-ai-models;
                            local-ai-providers : root.local-ai-providers;
                            local-ai-status : root.local-ai-status;
                            mobile-platform : root.mobile-platform;
                            ai-prefer-cloud-changed(arg0) => { root.ai-prefer-cloud-changed(arg0); }
                            cloud-ai-api-key-changed(arg0) => { root.cloud-ai-api-key-changed(arg0); }
                            cloud-ai-mode-changed(arg0) => { root.cloud-ai-mode-changed(arg0); }
                            cloud-ai-refresh-quota() => { root.cloud-ai-refresh-quota(); }
                            local-ai-download(arg0) => { root.local-ai-download(arg0); }
                            local-ai-enabled-changed(arg0) => { root.local-ai-enabled-changed(arg0); }
                            local-ai-load-model(arg0) => { root.local-ai-load-model(arg0); }
                            local-ai-open-memory() => { root.local-ai-open-memory(); }
                            local-ai-refresh() => { root.local-ai-refresh(); }
                            local-ai-select-model(arg0) => { root.local-ai-select-model(arg0); }
                            local-ai-select-provider(arg0) => { root.local-ai-select-provider(arg0); }
                            local-ai-unload-model() => { root.local-ai-unload-model(); }
                        }

                        // Appearance section
                        if active-section == "appearance": AppearanceSettings {
                        }
                        if active-section == "about": AboutSettings {
                            mobile-platform : root.mobile-platform;
                            open-licenses() => { root.open-licenses(); }
                        }
                    }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
        } // HorizontalLayout
    } // VerticalLayout

    // Compact navigation floats over the full-height content scroll, pinned
    // to the top edge where `content-layout`'s padding-top reserves its room.
    // Explicit x/y: a sized child of a plain Rectangle is CENTRED by default,
    // which put this bar mid-screen over the content on phones (§138).
    if compact-mode: GlassSurface {
        x: 0px;
        y: 0px;
        width: root.width;
        material-enabled: false;
        background: Colors.surface-page;
        border-radius: Spacing.none;

        height: Spacing.touch-target-min + Spacing.sm;

        HorizontalLayout {
            padding-left: Spacing.sm;
            padding-right: Spacing.sm;

            // The only way out of Settings in compact mode — and Settings
            // is a full-screen page, so it is a back chevron on the
            // leading edge, not an X. Was an X here and a "Close Settings"
            // text button at the bottom of the desktop rail: three
            // spellings of one action across two breakpoints.
            DismissButton {
                touch: root.mobile-platform;
                back: true;
                plain: true;
                clicked => { root.close-settings(); }
            }

            // The section chips scroll across the remaining phone width. Fades
            // hint at more sections without adding a second navigation arrow.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                clip: true;
                tabs := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: tab-layout.preferred-width;
                    viewport-height: self.height;
                    animate viewport-x { duration: Materials.motion-standard; easing: Materials.glide; }

                    tab-layout := HorizontalLayout {
                        spacing: Spacing.xxs;
                        padding: Spacing.xs;

                        for item in [
                            { id: "account", label: "Account" },
                            { id: "privacy", label: "Privacy" },
                            { id: "notifications", label: "Notifications" },
                            { id: "devices", label: "Linked devices" },
                            { id: "appearance", label: "Appearance" },
                            { id: "encryption", label: "Encryption" },
                            { id: "ai", label: "AI" },
                            { id: "about", label: "About" }
                        ]: Button {
                            touch: root.mobile-platform;
                            hover-enabled: !root.mobile-platform;
                            text: item.label;
                            height: Spacing.touch-target-min;
                            // Selected tab = the neutral raised pill every other tab bar uses
                            // (bottom nav, Calls, Contacts); teal fill is for actions.
                            variant: root.active-section == item.id ? "secondary" : "ghost";
                            clicked => {
                                root.active-section = item.id;
                            }
                        }
                    }
                }
                if tabs.viewport-x < 0px: Rectangle {
                    x: 0;
                    width: Spacing.md;
                    height: parent.height;
                    background: @linear-gradient(90deg, Colors.surface-page 0%, Colors.surface-page.with-alpha(0) 100%);
                }
                if tabs.viewport-width + tabs.viewport-x > tabs.width: Rectangle {
                    x: parent.width - self.width;
                    width: Spacing.md;
                    height: parent.height;
                    background: @linear-gradient(90deg, Colors.surface-page.with-alpha(0) 0%, Colors.surface-page 100%);
                }
            }
        }
    }
}
