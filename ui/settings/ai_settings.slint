import { JarvisGlobal } from "../jarvis/jarvis_global.slint";
import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { ToggleRow } from "../components/toggle_row.slint";

export component AISettings inherits VerticalLayout {
    in-out property <bool> ai-prefer-cloud;
    in-out property <string> cloud-ai-api-key;
    in property <string> cloud-ai-balance;
    in property <bool> cloud-ai-configured;
    in-out property <string> cloud-ai-mode;
    in property <string> cloud-ai-status;
    in property <bool> mobile-platform;
    callback open-memory();
    callback ai-prefer-cloud-changed(bool);
    callback cloud-ai-api-key-changed(string);
    callback cloud-ai-mode-changed(string);
    callback cloud-ai-refresh-quota();


    spacing: Spacing.lg;
    Text { text: "Remote AI"; color: Colors.text-primary; font-size: Typography.xl; font-weight: Typography.semibold; }
    // ── Cloud AI ───────────────────────────────────
    Rectangle {
        background: Colors.surface-section;
        border-radius: Spacing.radius-lg;
        drop-shadow-blur: Elevation.card-blur;
        drop-shadow-offset-y: Elevation.card-offset;
        drop-shadow-color: Elevation.card-shadow;
        border-width: Elevation.rim-width;
        border-color: Elevation.card-rim;

        VerticalLayout {
            padding: Spacing.md;
            spacing: Spacing.md;

            cloud-ai-row := ToggleRow {
                row-spacing: Spacing.md;
                label-spacing: Spacing.sm;
                accessible-text: "Use cloud AI";
                checked <=> root.ai-prefer-cloud;
                toggled(value) => {
                    root.ai-prefer-cloud = value;
                    root.ai-prefer-cloud-changed(value);
                }

                Text {
                    text: "Use cloud AI";
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                }
                Text {
                    width: cloud-ai-row.label-width;
                    text: "Send prompts and permitted remote conversation history to the selected provider. Existing local AI history stays on this device. Direct and secret messages are never sent to a cloud provider.";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                }
            }

            // Who pays, and who sees the prompt.
            if root.ai-prefer-cloud: VerticalLayout {
                spacing: Spacing.sm;

                Rectangle {
                    height: 1px;
                    background: Colors.divider;
                }

                HorizontalLayout {
                    spacing: Spacing.sm;

                    Button {
                        touch: root.mobile-platform;
                        text: "My API key";
                        variant: root.cloud-ai-mode == "direct-anthropic" ? "primary" : "secondary";
                        clicked => {
                            root.cloud-ai-mode = "direct-anthropic";
                            root.cloud-ai-mode-changed("direct-anthropic");
                        }
                    }

                    Button {
                        touch: root.mobile-platform;
                        text: "Buy tokens";
                        variant: root.cloud-ai-mode == "server-broker" ? "primary" : "secondary";
                        clicked => {
                            root.cloud-ai-mode = "server-broker";
                            root.cloud-ai-mode-changed("server-broker");
                        }
                    }
                }

                // Bring-your-own-key: nobody but the
                // provider sees the prompt.
                if root.cloud-ai-mode == "direct-anthropic": VerticalLayout {
                    spacing: Spacing.sm;

                    Text {
                        width: parent.width;
                        text: "Your key is stored on this device only. Prompts go straight to the provider — our servers never see them.";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        wrap: word-wrap;
                    }

                    Input {
                        placeholder: root.cloud-ai-configured ? "API key saved — enter a new one to replace it" : "Anthropic API key";
                        password: true;
                        text <=> root.cloud-ai-api-key;
                    }

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            touch: root.mobile-platform;
                            text: "Save key";
                            variant: "secondary";
                            clicked => {
                                root.cloud-ai-api-key-changed(root.cloud-ai-api-key);
                                root.cloud-ai-api-key = "";
                            }
                        }
                    }
                }

                // Managed tokens: state the trade plainly.
                if root.cloud-ai-mode == "server-broker": VerticalLayout {
                    spacing: Spacing.sm;

                    Text {
                        width: parent.width;
                        text: "No API key needed. Prompts are sent through our servers, which see them in order to meter usage.";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        wrap: word-wrap;
                    }

                    if root.cloud-ai-balance != "": Text {
                        text: root.cloud-ai-balance;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                    }

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            touch: root.mobile-platform;
                            text: "Refresh balance";
                            variant: "secondary";
                            clicked => { root.cloud-ai-refresh-quota(); }
                        }
                    }
                }

                if root.cloud-ai-status != "": Text {
                    width: parent.width;
                    text: root.cloud-ai-status;
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                }
            }
        }
    }

    if JarvisGlobal.enabled: Button {
        touch: root.mobile-platform;
        text: "Assistant memory";
        variant: "secondary";
        clicked => { root.open-memory(); }
    }
}
