import { SidebarPane } from "app_sidebar_pane.slint";
import { SearchPane } from "app_search_pane.slint";
import { ModalHostState } from "app_modal_host_state.slint";
import { ChatPane } from "app_chat_pane.slint";
import { CallView } from "app_call_view.slint";
import { JarvisGlobal } from "jarvis/jarvis_global.slint";

// Keyboard commands for the main view. The surrounding Back scope retains
// focus ownership so closing a picker or dialog still receives Back/Escape.
export component AppShortcuts inherits FocusScope {
    in property <string> current-view;
    in property <string> active-modal;
    callback back-pressed();

    width: 0;
    height: 0;
    enabled: root.current-view == "main";

    // The Ctrl commands. Called from the window's back scope, which is an
    // ancestor of every focused field: this zero-size scope is a sibling of
    // the content, so its own key-pressed only ran while it held focus and
    // Ctrl+K/F, Ctrl+, Ctrl+/ and Ctrl+J did nothing from the composer or
    // after a click in the chat.
    public function handle-command(event: KeyEvent) -> bool {
        if (!self.enabled || !event.modifiers.control) { return false; }
        // Ctrl+J: open the local AI channel
        if (root.active-modal == "none" && !SearchPane.unified-search-open
            && JarvisGlobal.enabled && event.modifiers.control && event.text == "j") {
            SidebarPane.active-tab = "chats";
            SidebarPane.mobile-show-chat = true;
            SidebarPane.channel-selected("00000000-0000-0000-0000-000000000000");
            return true;
        }
        // Ctrl+K / Ctrl+F: open unified search (which combo depends on pref)
        if (root.active-modal == "none" && event.modifiers.control
            && ((event.text == "k" && SearchPane.search-shortcut-pref != "f")
             || (event.text == "f" && SearchPane.search-shortcut-pref != "k"))) {
            SearchPane.unified-search-selected-index = 0;
            SearchPane.unified-search-open = true;
            SearchPane.unified-search-opened();
            return true;
        }
        // Ctrl+,: Open settings
        if (root.active-modal == "none" && !SearchPane.unified-search-open
            && event.modifiers.control && event.text == ",") {
            ModalHostState.nav-push("settings");
            SidebarPane.settings-clicked();
            return true;
        }
        // Ctrl+/: Toggle keyboard shortcuts help
        if (event.modifiers.control && event.text == "/"
            && (root.active-modal == "none" || root.active-modal == "keyboard-shortcuts")) {
            if (root.active-modal == "keyboard-shortcuts") {
                ModalHostState.nav-close("keyboard-shortcuts");
            } else {
                ModalHostState.nav-push("keyboard-shortcuts");
            }
            return true;
        }
        false
    }

    key-pressed(event) => {
        if (root.handle-command(event)) { return accept; }
        // Escape: close the top modal, else leave a non-Chats tab
        if (event.text == Key.Escape) {
            if (CallView.calls-more-menu-visible || CallView.call-history-selecting || ChatPane.delete-confirm-count > 0) {
                root.back-pressed();
                return accept;
            }
            if (root.active-modal != "none") {
                root.back-pressed();
                return accept;
            }
            if (SearchPane.unified-search-open || ChatPane.thread-panel-visible
                || ChatPane.context-menu-visible || ChatPane.reaction-picker-visible
                || ChatPane.composer-emoji-picker-visible || ChatPane.composer-gif-picker-visible
                || ChatPane.pdf-preview-visible || ChatPane.code-preview-visible
                || ChatPane.video-player-visible || ChatPane.image-viewer-visible
                || ChatPane.selection-mode
                || SidebarPane.active-tab != "chats") {
                root.back-pressed();
                return accept;
            }
        }
        reject
    }
}
