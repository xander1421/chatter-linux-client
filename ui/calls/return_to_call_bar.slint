import { GlassSurface } from "../components/glass_surface.slint";
import { Materials } from "../theme/materials.slint";
// "Return to call" pill — the active call's presence everywhere the docked
// call view is not on screen (the chat list, Contacts, any modal). Tapping it
// goes back to the call.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { ActiveCallData } from "types.slint";
import { IconAction } from "../components/icon_action.slint";
import { Avatar } from "../components/avatar.slint";

export component ReturnToCallBar inherits GlassSurface {
    material-level: 2;
    elevation: 0;
    property <float> arrival: 0;
    init => { root.arrival = 1; }
    opacity: arrival;
    transform-scale-x: return-touch.pressed ? 96% : 90% + arrival * 10%;
    transform-scale-y: return-touch.pressed ? 94% : 82% + arrival * 18%;
    animate arrival { duration: Materials.motion-standard; easing: Materials.spring; }
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

    in property <ActiveCallData> call-data;
    in property <[image]> remote-video-frames;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: false;
    callback clicked();
    callback toggle-mute();
    callback toggle-video();
    callback end-call();

    // The call roster pins the local participant last. Prefer a speaking
    // remote with video, then the first remote with video, then an avatar.
    private property <int> remote-count: max(0, call-data.participants.length - 1);
    private property <int> speaking-video-index:
          (remote-count > 0 && call-data.participants[0].is-speaking && call-data.participants[0].is-video-enabled) ? 0
        : (remote-count > 1 && call-data.participants[1].is-speaking && call-data.participants[1].is-video-enabled) ? 1
        : (remote-count > 2 && call-data.participants[2].is-speaking && call-data.participants[2].is-video-enabled) ? 2
        : (remote-count > 3 && call-data.participants[3].is-speaking && call-data.participants[3].is-video-enabled) ? 3
        : (remote-count > 4 && call-data.participants[4].is-speaking && call-data.participants[4].is-video-enabled) ? 4
        : -1;
    private property <int> video-index:
          (remote-count > 0 && call-data.participants[0].is-video-enabled) ? 0
        : (remote-count > 1 && call-data.participants[1].is-video-enabled) ? 1
        : (remote-count > 2 && call-data.participants[2].is-video-enabled) ? 2
        : (remote-count > 3 && call-data.participants[3].is-video-enabled) ? 3
        : (remote-count > 4 && call-data.participants[4].is-video-enabled) ? 4
        : -1;
    private property <int> remote-index: speaking-video-index >= 0 ? speaking-video-index
        : video-index >= 0 ? video-index : remote-count > 0 ? 0 : -1;
    private property <bool> remote-has-video: remote-index >= 0
        && call-data.participants[remote-index].is-video-enabled;

    // Connection is explicit: roster size and a zero-second duration also
    // occur in connected calls.
    property <bool> is-connecting: !call-data.is-connected;

    height: 116px;
    border-radius: Spacing.radius-lg;

    accessible-role: button;
    accessible-label: "Return to call with " + call-data.title;
    accessible-action-default => { root.clicked(); }

    return-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: Spacing.xs;
        spacing: Spacing.xs;

        HorizontalLayout {
            spacing: Spacing.sm;

            Rectangle {
                width: 88px;
                height: 56px;
                border-radius: Spacing.radius-sm;
                background: Colors.surface-hover;
                clip: true;

                if root.remote-has-video: Image {
                    source: root.remote-video-frames.length > root.remote-index
                        ? root.remote-video-frames[root.remote-index] : @image-url("");
                    width: 100%;
                    height: 100%;
                    image-fit: root.call-data.participants[root.remote-index].is-screen-sharing ? contain : cover;
                }
                if !root.remote-has-video: Avatar {
                    size: 40px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.remote-index >= 0 ? root.call-data.participants[root.remote-index].avatar-source : @image-url("");
                    fallback-text: root.remote-index >= 0 ? root.call-data.participants[root.remote-index].initials : "";
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                alignment: center;
                spacing: Spacing.xs;
                Text {
                    text: root.remote-index >= 0 ? root.call-data.participants[root.remote-index].display-name : root.call-data.title;
                    width: 100%;
                    font-size: Typography.sm;
                    font-weight: Typography.semibold;
                    color: Colors.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.is-connecting ? "Calling…" : root.format-duration(call-data.duration-seconds);
                    font-size: Typography.sm;
                    color: Colors.text-primary;
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: Spacing.md;
            IconAction {
                icon: root.is-muted ? Icons.mic-off : Icons.mic;
                label: root.is-muted ? "Unmute microphone" : "Mute microphone";
                active: root.is-muted;
                clicked => { root.toggle-mute(); }
            }
            IconAction {
                enabled: root.call-data.is-connected;
                icon: root.is-video-enabled ? Icons.video : Icons.video-off;
                label: root.is-video-enabled ? "Turn camera off" : "Turn camera on";
                active: root.is-video-enabled;
                clicked => { root.toggle-video(); }
            }
            IconAction {
                icon: Icons.phone-off;
                label: "End call";
                destructive: true;
                clicked => { root.end-call(); }
            }
        }
    }

    pure function format-duration(seconds: int) -> string {
        if seconds < 3600 {
            return Math.floor(seconds / 60) + ":" + (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
        }
        return Math.floor(seconds / 3600) + ":" +
               (Math.mod(Math.floor(seconds / 60), 60) < 10 ? "0" : "") + Math.mod(Math.floor(seconds / 60), 60) + ":" +
               (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
    }
}
