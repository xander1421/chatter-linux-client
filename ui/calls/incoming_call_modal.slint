import { KeyFocus } from "../components/key_focus.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Incoming call notification modal

import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "../components/avatar.slint";
import { IncomingCallData } from "types.slint";

export component IncomingCallModal inherits Rectangle {
    // Screen readers and Tab stay inside while open (vendored winit
    // AccessKit adapter, Android bridge, i-slint-core window.rs).
    accessible-role: groupbox;
    accessible-id: root.show ? "modal-overlay" : "";
    in property <bool> show: false;
    in property <IncomingCallData> call-data;
    /// True when there is already an active call — accepting this one will
    /// end the current call. Drives the "Accept & end current call" hint.
    in property <bool> replaces-active: false;

    callback accept-call();
    callback decline-call();
    property <float> card-arrival: 0;
    init => { root.card-arrival = root.show ? 1 : 0; }
    changed show => { root.card-arrival = root.show ? 1 : 0; }
    animate card-arrival { duration: Materials.motion-standard; easing: Materials.spring; }

    // Full screen overlay
    width: 100%;
    height: 100%;
    background: Materials.scrim;
    opacity: min(1, card-arrival);
    visible: root.show || self.opacity > 0;

    // Swallow every tap on the scrim and on the card's background: without it
    // a tap beside the card opened the chat underneath while the call kept
    // ringing (RC20). It deliberately does NOT decline — unlike a modal's
    // tap-outside-to-close, a stray tap must not reject a call.
    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.show;
    }

    GlassSurface {
        material-level: 3;
        elevation: 5;

        // Center card — Neo strong surface
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1 - root.card-arrival) * 28px;
        width: min(320px, parent.width - 32px);
        height: min(card-content.preferred-height, parent.height - 48px);
        border-radius: Spacing.radius-sheet;

        card-content := VerticalLayout {
            alignment: center;
            spacing: Spacing.xl;
            padding: Spacing.xxl;

            // Caller avatar with pulse ring — horizontally centered
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 96px;
                    height: 96px;
                    horizontal-stretch: 0;

                    // The ring expands from the avatar instead of flashing in place.
                    Rectangle {
                        property <float> ripple: 0;
                        width: Appearance.reduce-motion ? 96px : 80px + ripple * 32px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: transparent;
                        border-width: Spacing.stroke;
                        border-color: Colors.primary.with-alpha(Appearance.reduce-motion ? 0.65 : (1 - ripple) * 0.9);
                        drop-shadow-blur: Elevation.halo-blur-strong;
                        drop-shadow-color: Colors.primary.with-alpha(Appearance.reduce-motion ? 0.12 : (1 - ripple) * 0.18);
                        animate ripple {
                            duration: Materials.motion-emphasized * 3;
                            iteration-count: Appearance.reduce-motion ? 1 : -1;
                            easing: Materials.glide;
                        }
                        init => { self.ripple = 1; }
                    }

                    Avatar {
                        width: 80px;
                        height: 80px;
                        x: 8px;
                        y: 8px;
                        size: 80px;
                        source: call-data.caller-avatar-source;
                        fallback-text: call-data.caller-initials;
                    }
                }
            }

            // Caller info
            VerticalLayout {
                alignment: center;
                spacing: Spacing.sm;

                Text {
                    text: call-data.caller-name;
                    font-size: Typography.xl;
                    font-weight: Typography.semibold;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    // A channel call rings with its channel: answering joins
                    // a call already under way rather than starting one.
                    text: call-data.channel-name != ""
                        ? (call-data.is-video-call ? "Join group video call" : "Join group voice call")
                        : (call-data.is-video-call ? "Incoming video call..." : "Incoming voice call...");
                    font-size: Typography.sm;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                if call-data.channel-name != "": Text {
                    text: "in " + call-data.channel-name;
                    font-size: Typography.xs;
                    color: Colors.text-muted;
                    horizontal-alignment: center;
                }

                if root.replaces-active: Rectangle {
                    background: Colors.error.with-alpha(0.15);
                    border-radius: Spacing.radius-sm;

                    VerticalLayout {
                        padding: Spacing.sm;
                        Text {
                            text: "Accepting will end your current call";
                            font-size: Typography.xs;
                            color: Colors.error;
                            font-weight: Typography.semibold;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                if call-data.identity-warning != "": Rectangle {
                    background: Colors.error.with-alpha(0.1);
                    border-radius: Spacing.radius-sm;
                    
                    VerticalLayout {
                        padding: Spacing.sm;
                        Text {
                            text: "⚠️ " + call-data.identity-warning;
                            font-size: Typography.xs;
                            color: Colors.error;
                            font-weight: Typography.semibold;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Action buttons
            HorizontalLayout {
                alignment: center;
                spacing: Spacing.xxl;

                // Decline button (red circle) — Neo glow
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: decline-hover.has-hover ? Colors.error-hover : Colors.error;
                    drop-shadow-blur: decline-hover.has-hover ? Elevation.halo-blur-strong : Elevation.halo-blur;
                    drop-shadow-offset-y: Elevation.popover-contact-offset;
                    drop-shadow-color: Colors.error.with-alpha(0.4);
                    transform-scale-x: decline-hover.pressed ? 91% : 100%;
                    transform-scale-y: decline-hover.pressed ? 91% : 100%;
                    animate transform-scale-x { duration: decline-hover.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                    animate transform-scale-y { duration: decline-hover.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    accessible-role: button;
                    accessible-label: "Decline call";
                    accessible-action-default => { if root.show { root.decline-call(); } }
                    KeyFocus { border-radius: parent.border-radius; activate => { if root.show { root.decline-call(); } } }

                    decline-hover := TouchArea {
                        enabled: root.show;
                        clicked => { decline-call(); }
                    }

                    // SVG, not a Unicode multiplication sign or an emoji: the
                    // Android font has no glyph for either, so the accept and
                    // decline buttons on the one screen you have seconds to
                    // answer both rendered as tofu boxes there. Same rule
                    // dismiss_button.slint states.
                    Image {
                        source: Icons.phone-off;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.on-error;
                    }
                }

                // Accept button (green circle) — Neo glow
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: accept-hover.has-hover ? Colors.success-fill-hover : Colors.success-fill;
                    drop-shadow-blur: accept-hover.has-hover ? Elevation.halo-blur-strong : Elevation.halo-blur;
                    drop-shadow-offset-y: Elevation.popover-contact-offset;
                    drop-shadow-color: Colors.success-fill.with-alpha(0.4);
                    transform-scale-x: accept-hover.pressed ? 91% : 100%;
                    transform-scale-y: accept-hover.pressed ? 91% : 100%;
                    animate transform-scale-x { duration: accept-hover.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                    animate transform-scale-y { duration: accept-hover.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    accessible-role: button;
                    accessible-label: "Accept call";
                    accessible-action-default => { if root.show { root.accept-call(); } }
                    KeyFocus { border-radius: parent.border-radius; activate => { if root.show { root.accept-call(); } } }

                    accept-hover := TouchArea {
                        enabled: root.show;
                        clicked => { accept-call(); }
                    }

                    Image {
                        source: call-data.is-video-call ? Icons.video : Icons.phone;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.on-success;
                    }
                }
            }
        }
    }
}
