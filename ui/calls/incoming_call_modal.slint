// Incoming call notification modal

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Avatar } from "../components/avatar.slint";
import { IncomingCallData } from "types.slint";

export component IncomingCallModal inherits Rectangle {
    in property <bool> show: false;
    in property <IncomingCallData> call-data;

    callback accept-call();
    callback decline-call();

    // Full screen overlay
    width: 100%;
    height: 100%;
    background: Colors.overlay;
    opacity: show ? 1.0 : 0.0;
    visible: show;

    animate opacity { duration: 200ms; }

    if show: Rectangle {
        // Center card — Neo strong surface
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(320px, parent.width - 32px);
        height: min(380px, parent.height - 48px);
        background: Colors.surface;
        border-radius: Spacing.radius-lg;
        border-width: 1px;
        border-color: Colors.neo-highlight-strong;
        drop-shadow-blur: Spacing.neo-blur-lg;
        drop-shadow-offset-x: Spacing.neo-offset-lg;
        drop-shadow-offset-y: Spacing.neo-offset-lg;
        drop-shadow-color: Colors.neo-shadow-strong;

        VerticalLayout {
            alignment: center;
            spacing: Spacing.xl;
            padding: Spacing.xxl;

            // Caller avatar with pulse ring
            Rectangle {
                width: 96px;
                height: 96px;
                horizontal-stretch: 0;

                // Pulse ring animation — Neo glow pulse
                Rectangle {
                    width: 96px;
                    height: 96px;
                    border-radius: 48px;
                    background: transparent;
                    border-width: 2px;
                    border-color: Colors.glow-cyan.with-alpha(pulse-opacity);
                    drop-shadow-blur: Spacing.neo-blur-md;
                    drop-shadow-color: Colors.glow-cyan-soft;

                    property <float> pulse-opacity: 0.0;

                    animate pulse-opacity {
                        duration: 1500ms;
                        iteration-count: -1;
                        easing: ease-out;
                    }

                    init => {
                        self.pulse-opacity = 0.8;
                    }
                }

                Avatar {
                    width: 80px;
                    height: 80px;
                    x: 8px;
                    y: 8px;
                    size: 80px;
                    fallback-text: call-data.caller-name;
                }
            }

            // Caller info
            VerticalLayout {
                alignment: center;
                spacing: Spacing.sm;

                Text {
                    text: call-data.caller-name;
                    font-size: Typography.xl;
                    font-weight: Typography.semibold;
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: call-data.is-video-call ? "Incoming video call..." : "Incoming voice call...";
                    font-size: Typography.sm;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                }

                if call-data.channel-name != "": Text {
                    text: "in " + call-data.channel-name;
                    font-size: Typography.xs;
                    color: Colors.text-muted;
                    horizontal-alignment: center;
                }

                if call-data.identity-warning != "": Rectangle {
                    background: Colors.error.with-alpha(0.1);
                    border-radius: Spacing.radius-sm;
                    
                    VerticalLayout {
                        padding: Spacing.sm;
                        Text {
                            text: "⚠️ " + call-data.identity-warning;
                            font-size: Typography.xs;
                            color: Colors.error;
                            font-weight: Typography.semibold;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Action buttons
            HorizontalLayout {
                alignment: center;
                spacing: Spacing.xxl;

                // Decline button (red circle) — Neo glow
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: decline-hover.has-hover ? Colors.error-hover : Colors.error;
                    drop-shadow-blur: decline-hover.has-hover ? Spacing.neo-blur-md : Spacing.neo-blur-sm;
                    drop-shadow-offset-x: Spacing.neo-offset-sm;
                    drop-shadow-offset-y: Spacing.neo-offset-sm;
                    drop-shadow-color: Colors.error.with-alpha(0.4);

                    decline-hover := TouchArea {
                        clicked => { decline-call(); }
                    }

                    Text {
                        text: "\u{2715}";
                        font-size: 28px;
                        color: Colors.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Accept button (green circle) — Neo glow
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: accept-hover.has-hover ? Colors.success-hover : Colors.success;
                    drop-shadow-blur: accept-hover.has-hover ? Spacing.neo-blur-md : Spacing.neo-blur-sm;
                    drop-shadow-offset-x: Spacing.neo-offset-sm;
                    drop-shadow-offset-y: Spacing.neo-offset-sm;
                    drop-shadow-color: Colors.success.with-alpha(0.4);

                    accept-hover := TouchArea {
                        clicked => { accept-call(); }
                    }

                    Text {
                        text: call-data.is-video-call ? "\u{1F4F9}\u{FE0F}" : "\u{1F4DE}\u{FE0F}";
                        font-size: 28px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }
}
