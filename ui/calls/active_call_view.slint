import { VerificationEmoji } from "verification_emoji.slint";
import { KeyFocus } from "../components/key_focus.slint";
import { IconAction } from "../components/icon_action.slint";
import { Button } from "../components/button.slint";
import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Active call view as a dock on top of the chat pane (Discord-style).
//
// The participant stage fills the surface; the status/verification header
// and bottom controls overlay it. Defaults to a dock; the
// maximize button grows it to fill the whole window (app.slint hides the
// sidebar + chat while `fullscreen`). Hidden when `show` is false — collapses
// to zero height so the surrounding chat layout reclaims the space.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Appearance } from "../theme/appearance.slint";
import { HeaderButton } from "../components/header_button.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "../components/avatar.slint";
import { CallControls } from "call_controls.slint";
import { ActiveCallData, CallParticipantData } from "types.slint";

component ParticipantTile inherits Rectangle {
    in property <CallParticipantData> participant;
    in property <image> video-frame;
    in property <bool> is-local: false;
    in property <bool> show-video: true;
    in property <bool> interactive: true;
    in property <length> bottom-clearance: 0px;
    // The front/back lens swap sits on the local self-view, not in the call
    // bar: with full 44px device carets the bar holds seven targets, all a
    // 320px phone fits (owner 2026-11-13).
    in property <bool> show-camera-swap: false;
    in property <length> top-clearance: 0px;
    in property <bool> camera-swap-enabled: true;
    callback clicked();
    callback swap-camera();
    callback video-size(string, length, length, bool);
    in property <int> video-layout-revision;
    private property <string> video-id: participant.user-id;
    private property <bool> screen-frame: participant.is-screen-sharing;
    function report-size() {
        if root.video-id != "" && root.width > 0px && root.height > 0px {
            root.video-size(root.video-id, root.width, root.height, root.screen-frame);
        }
    }
    changed width => { root.report-size(); }
    changed height => { root.report-size(); }
    changed video-layout-revision => { root.report-size(); }
    changed video-id => { root.report-size(); }
    changed screen-frame => { root.report-size(); }


    accessible-role: button;
    accessible-label: root.participant.display-name;
    accessible-enabled: root.interactive;
    accessible-action-default => { if root.interactive { root.clicked(); } }
    KeyFocus { border-radius: parent.border-radius; activate => { if root.interactive { root.clicked(); } } }

    TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }

    background: show-video && participant.is-video-enabled ? Colors.background : Colors.surface-card;
    border-radius: Spacing.radius-panel;
    // Retain spatial continuity when the stage or picture-in-picture resizes.
    animate x { duration: Materials.motion-standard; easing: Materials.spring; }
    animate y { duration: Materials.motion-standard; easing: Materials.spring; }
    animate width { duration: Materials.motion-standard; easing: Materials.spring; }
    animate height { duration: Materials.motion-standard; easing: Materials.spring; }
    // A neutral rim marks the current speaker on the video stage.
    border-width: participant.is-speaking ? 2 * Spacing.stroke : 0px;
    border-color: Colors.text-secondary;
    clip: true;

    animate border-width { duration: Materials.motion-quick; easing: Materials.settle; }

    // Preserve the entire camera or shared-screen frame at every tile size.
    if show-video && participant.is-video-enabled: Image {
        source: video-frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if !show-video || !participant.is-video-enabled: Rectangle {
        width: 100%;
        height: 100%;
        background: Colors.surface-hover;

        // Avatar scales with the tile instead of a fixed thumbnail.
        property <length> avatar-size: clamp(min(root.width, root.height) * 36%, 24px, 144px);

        VerticalLayout {
            alignment: center;
            spacing: Spacing.sm;

            HorizontalLayout {
                alignment: center;

                Avatar {
                    size: avatar-size;
                    source: participant.avatar-source;
                    fallback-text: participant.initials;
                }
            }

            Text {
                text: is-local ? @tr("You") : participant.display-name;
                font-size: Typography.sm;
                color: Colors.text-primary;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    // Mute indicator
    if participant.is-muted: Rectangle {
        x: Spacing.xs;
        y: parent.height - 24px - root.bottom-clearance;
        width: 20px;
        height: 20px;
        border-radius: Spacing.radius-full;
        background: transparent;
        border-width: 1px;
        border-color: Colors.border;

        Image {
            source: Icons.mic-off;
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.text-primary;
        }
    }

    // Screen-share indicator (top-right) — tells the streamer themselves
    // "you are sharing" and tells viewers which tile is the screen feed.
    if participant.is-screen-sharing: Rectangle {
        x: parent.width - self.width - Spacing.xs;
        y: Spacing.xs;
        width: 22px;
        height: 22px;
        border-radius: Spacing.radius-full;
        background: transparent;
        border-width: 1px;
        border-color: Colors.border;

        Image {
            source: Icons.monitor;
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.text-primary;
        }
    }

    // Name label (bottom-center, clear of the control buttons) — only over
    // live video; the avatar branch already shows the name under the avatar.
    if show-video && participant.is-video-enabled: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Spacing.xs - root.bottom-clearance;
        width: name-text.preferred-width + Spacing.md;
        height: Spacing.badge-md;
        border-radius: Spacing.radius-sm;
        background: Colors.overlay-heavy;

        name-text := Text {
            x: Spacing.xs;
            text: is-local ? @tr("You") : participant.display-name;
            font-size: Typography.xs;
            color: Colors.text-primary;
            vertical-alignment: center;
        }
    }

    // Top-left: the screen-share mark owns the top-right corner.
    if root.show-camera-swap: IconAction {
        x: Spacing.xs;
        y: root.top-clearance + Spacing.xs;
        width: 44px;
        height: 44px;
        enabled: root.camera-swap-enabled;
        icon: Icons.rotate-ccw;
        label: @tr("Switch camera");
        clicked => { root.swap-camera(); }
    }
}

export component ActiveCallView inherits Rectangle {
    in property <bool> show: false;
    in property <ActiveCallData> call-data;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    // See CallControls: phone route toggle vs desktop output picker.
    in property <bool> speaker-toggle: false;
    in property <bool> speaker-on: false;
    // Drives the mobile-only camera-swap button on the local tile.
    in property <bool> is-mobile-platform: false;
    callback video-size(string, length, length, bool);
    in property <int> video-layout-revision;
    in property <image> local-video-frame;
    in property <[image]> remote-video-frames;
    private property <CallParticipantData> empty-participant;
    pure callback select-tile-indices([CallParticipantData], string) -> [int];
    property <string> pinned-id: "";
    property <bool> roster-open: false;
    private property <[int]> tile-indices: root.select-tile-indices(call-data.participants, pinned-id);
    // When true, the dock expands to fill the viewport (chat panel hides at
    // the parent layout). Driven by app.slint, toggled via the fullscreen
    // button on the maximized tile.
    in property <bool> fullscreen: false;
    // Window height, passed from app.slint so the non-fullscreen dock can
    // scale with the viewport instead of a fixed band.
    in property <length> viewport-height: 720px;
    // The user's explicit focus choice: -2 = auto (follow any screen share),
    // -1 = user chose the grid, 0..n = user maximized that tile.
    property <int> user-focus: -2;
    private property <string> displayed-call-id: call-data.call-id;
    changed displayed-call-id => { user-focus = -2; pinned-id = ""; roster-open = false; }
    // Selection is computed by core; screen share auto-focuses within those slots.
    property <int> screen-share-index:
          (tile-indices.length > 0 && call-data.participants[tile-indices[0]].is-screen-sharing) ? 0
        : (tile-indices.length > 1 && call-data.participants[tile-indices[1]].is-screen-sharing) ? 1
        : (tile-indices.length > 2 && call-data.participants[tile-indices[2]].is-screen-sharing) ? 2
        : (tile-indices.length > 3 && call-data.participants[tile-indices[3]].is-screen-sharing) ? 3
        : (tile-indices.length > 4 && call-data.participants[tile-indices[4]].is-screen-sharing) ? 4
        : (tile-indices.length > 5 && call-data.participants[tile-indices[5]].is-screen-sharing) ? 5
        : -1;
    property <int> maximized-index: user-focus >= tile-indices.length
        ? -1 : (user-focus == -2 ? screen-share-index : user-focus);
    changed screen-share-index => { user-focus = -2; }
    // Connection is explicit: roster size and a zero-second duration also
    // occur in connected calls.
    property <bool> is-connecting: !call-data.is-connected;
    property <bool> any-video: is-video-enabled || is-screen-sharing
        || (tile-indices.length > 0 && call-data.participants[tile-indices[0]].is-video-enabled)
        || (tile-indices.length > 1 && call-data.participants[tile-indices[1]].is-video-enabled)
        || (tile-indices.length > 2 && call-data.participants[tile-indices[2]].is-video-enabled)
        || (tile-indices.length > 3 && call-data.participants[tile-indices[3]].is-video-enabled)
        || (tile-indices.length > 4 && call-data.participants[tile-indices[4]].is-video-enabled)
        || (tile-indices.length > 5 && call-data.participants[tile-indices[5]].is-video-enabled);
    property <bool> maximized-is-local: maximized-index >= 0
        && tile-indices[maximized-index] == call-data.participants.length - 1;

    callback toggle-mute();
    callback toggle-video();
    callback swap-camera();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-input();
    callback show-audio-output();
    callback toggle-speaker();
    // Per-peer local controls — only the local viewer is affected.
    callback peer-audio-mute-toggle(string);
    callback peer-video-pause-toggle(string);
    // Asks the parent layout to grow the dock to the full viewport.
    callback fullscreen-toggle();

    // The call is the primary task on a wide screen, including voice calls.
    // Keep the conversation below it; fullscreen still uses the entire slot.
    property <bool> spacious: root.width >= 600px;
    property <length> button-size: is-mobile-platform ? Spacing.touch-target-min : Spacing.button-height;
    // Retain the compact audio selectors’ 48px control row.
    property <length> controls-height: 48px;
    property <length> verification-height: call-data.is-encrypted ? 36px * Appearance.text-grow : 0px;
    property <length> call-header-height: max(button-size, 32px * Appearance.text-grow);
    in property <bool> compact-layout: root.is-mobile-platform;
    property <length> frame-gutter: root.compact-layout ? 0px : Spacing.panel-gutter;
    property <length> stage-inset: root.frame-gutter > 0px ? Spacing.panel-gutter : 0px;
    property <length> chrome-gutter: Spacing.panel-gutter;
    property <length> overlay-bottom: controls-height + 3 * root.chrome-gutter;
    property <length> voice-stage-height: tile-indices.length > 2 ? 200px : 140px;
    property <length> dock-height: spacious
        ? clamp(viewport-height * 0.60, 360px, 840px)
        : any-video ? clamp(viewport-height * 0.48, 320px, 560px)
        : voice-stage-height + call-header-height + controls-height + 3 * Spacing.panel-gutter;
    visible: show;
    min-height: show ? (fullscreen ? 0px : dock-height) : 0px;
    max-height: show ? (fullscreen ? 100000px : dock-height) : 0px;
    preferred-height: show ? dock-height : 0px;
    background: Colors.background;

    if show: Rectangle {
        x: root.frame-gutter;
        y: root.frame-gutter;
        width: parent.width - 2 * root.frame-gutter;
        height: parent.height - 2 * root.frame-gutter;
        background: Colors.background;
        border-radius: root.frame-gutter > 0px ? Spacing.radius-panel : 0px;
        border-width: root.frame-gutter > 0px ? 1px : 0px;
        border-color: Colors.border;
        clip: true;
        // The video stage fills the call surface behind both overlay rows.
        Rectangle {
            accessible-role: groupbox;
            accessible-label: @tr("Call participants grid");
            width: 100%;
            height: 100%;
            background: transparent;

            // Keep each participant tile mounted while the roster or focus
            // changes. A tile travels from its grid cell to the stage (and
            // back) instead of being destroyed and recreated by a branch.
            // Fixed slots keep their Slint items across a new roster model.
            // Core replaces the model on call updates, so iterating that
            // model directly would recreate every tile and lose its travel.
            for slot[idx] in [0, 1, 2, 3, 4, 5]: ParticipantTile {
                property <int> source-index: idx < root.tile-indices.length ? root.tile-indices[idx] : -1;
                property <int> columns: root.tile-indices.length >= 5 ? 3 : 2;
                property <length> grid-width: (parent.width - 2 * root.chrome-gutter - (columns - 1) * Spacing.sm) / columns;
                property <length> grid-height: (parent.height - 2 * root.chrome-gutter - Spacing.sm) / 2;
                property <length> pip-height: pip-width * 0.62;
                property <length> pip-width: clamp(parent.width * 0.24, 88px, 180px);
                property <bool> full-stage: root.maximized-index >= 0 || root.tile-indices.length <= 1
                    || (root.tile-indices.length == 2 && idx == 0);
                property <bool> pip: root.maximized-index < 0 && root.tile-indices.length == 2 && idx == 1;
                x: full-stage ? root.stage-inset
                    : pip ? parent.width - pip-width - 2 * Spacing.sm
                    : Spacing.sm + Math.mod(idx, columns) * (grid-width + Spacing.sm);
                y: full-stage ? root.stage-inset
                    : pip ? parent.height - pip-height - root.overlay-bottom - Spacing.sm
                    : Spacing.sm + Math.floor(idx / columns) * (grid-height + Spacing.sm);
                width: full-stage ? parent.width - 2 * root.stage-inset : pip ? pip-width : grid-width;
                height: full-stage ? parent.height - 2 * root.stage-inset : pip ? pip-height : grid-height;
                opacity: idx >= root.tile-indices.length
                    || (root.tile-indices.length == 2 && !root.any-video && idx == 1)
                    || (root.maximized-index >= 0 && root.maximized-index != idx) ? 0 : 1;
                animate opacity { duration: Materials.motion-standard; easing: Materials.settle; }
                visible: idx < root.tile-indices.length || self.opacity > 0;
                interactive: source-index >= 0 && source-index < call-data.participants.length
                    && self.opacity > 0.95
                    && (root.maximized-index < 0 || root.maximized-index == idx);
                participant: root.tile-indices.length > idx
                    ? call-data.participants[source-index] : root.empty-participant;
                video-frame: source-index >= 0 && source-index == call-data.participants.length - 1 ? local-video-frame
                    : source-index >= 0 && remote-video-frames.length > source-index ? remote-video-frames[source-index] : local-video-frame;
                bottom-clearance: full-stage ? root.overlay-bottom : 0px;
                top-clearance: full-stage ? root.call-header-height + root.chrome-gutter : 0px;
                border-radius: full-stage && root.stage-inset == 0px ? 0px : Spacing.radius-panel;
                is-local: source-index == call-data.participants.length - 1;
                // Mobile + camera on: offer the front/back lens swap.
                show-camera-swap: self.is-local && root.is-mobile-platform && root.is-video-enabled
                    && self.opacity > 0.95;
                camera-swap-enabled: root.call-data.is-connected;
                swap-camera => { root.swap-camera(); }
                video-layout-revision: root.video-layout-revision;
                video-size(id, width, height, screen) => { root.video-size(id, width, height, screen); }
                clicked => {
                    if source-index >= 0 && source-index < call-data.participants.length {
                        let was-maximized = root.maximized-index == idx;
                        root.pinned-id = call-data.participants[source-index].user-id;
                        root.user-focus = was-maximized ? -1 : idx;
                    }
                }
            }

            // Per-peer controls bar — top of the maximized tile, remote only.
            if maximized-index >= 0 && !maximized-is-local
               && maximized-index < tile-indices.length: GlassSurface {
                material-level: 3;
                elevation: 0;

                x: (parent.width - self.width) / 2;
                y: root.call-header-height + 2 * root.chrome-gutter;
                width: Spacing.button-height * 2 + Spacing.xs * 3;
                height: Spacing.button-height + Spacing.xs * 2;
                border-radius: Spacing.radius-panel;
                border-width: 1px;
                border-color: Colors.border;

                HorizontalLayout {
                    padding-top: Spacing.xs;
                    padding-bottom: Spacing.xs;
                    padding-left: Spacing.xs;
                    padding-right: Spacing.xs;
                    spacing: Spacing.xs;
                    alignment: center;

                    // Audio mute toggle for this peer.
                    IconAction {
                        label: call-data.participants[tile-indices[maximized-index]].is-audio-muted-locally
                            ? @tr("Unmute {} for you", call-data.participants[tile-indices[maximized-index]].display-name)
                            : @tr("Mute {} for you", call-data.participants[tile-indices[maximized-index]].display-name);
                        icon: call-data.participants[tile-indices[maximized-index]].is-audio-muted-locally
                                ? Icons.mic-off : Icons.mic;
                        clicked => {
                                root.peer-audio-mute-toggle(
                                    call-data.participants[tile-indices[maximized-index]].user-id);
                        }
                    }

                    // Video pause toggle for this peer.
                    IconAction {
                        label: call-data.participants[tile-indices[maximized-index]].is-video-paused-locally
                            ? @tr("Resume {}'s video for you", call-data.participants[tile-indices[maximized-index]].display-name)
                            : @tr("Pause {}'s video for you", call-data.participants[tile-indices[maximized-index]].display-name);
                        icon: call-data.participants[tile-indices[maximized-index]].is-video-paused-locally
                                ? Icons.play : Icons.pause;
                        active: call-data.participants[tile-indices[maximized-index]].is-video-paused-locally;
                        clicked => {
                                root.peer-video-pause-toggle(
                                    call-data.participants[tile-indices[maximized-index]].user-id);
                        }
                    }
                }
            }

            // Persistent "you are sharing" banner — bottom of the stage, just
            // above the control row. The toggled toolbar icon alone is too easy
            // to forget; a live share needs an always-visible state + one-click stop.
            if root.is-screen-sharing: GlassSurface {
                material-level: 3;
                elevation: 0;

                x: (parent.width - self.width) / 2;
                y: parent.height - root.overlay-bottom - Spacing.sm - self.height;
                width: min(share-banner-row.preferred-width, parent.width - 2 * root.chrome-gutter);
                height: Spacing.button-height + Spacing.sm;
                border-radius: Spacing.radius-panel;
                border-width: 1px;
                border-color: Colors.border;

                share-banner-row := HorizontalLayout {
                    padding-left: Spacing.md;
                    padding-right: Spacing.md;
                    spacing: Spacing.sm;
                    alignment: center;

                    Image {
                        source: Icons.monitor;
                        width: 13px;
                        height: 13px;
                        colorize: Colors.text-secondary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("Sharing your screen");
                        overflow: elide;
                        font-size: Typography.xs;
                        color: Colors.text-primary;
                        vertical-alignment: center;
                    }

                    Button {
                        text: @tr("Stop");
                        label: @tr("Stop screen sharing");
                        variant: "destructive";
                        border-radius: Spacing.radius-control;
                        clicked => { root.toggle-screen-share(); }
                    }
                }
            }

            if root.call-data.participants.length > root.tile-indices.length: Rectangle {
                x: parent.width - self.width - Spacing.sm;
                y: root.call-header-height + 2 * root.chrome-gutter;
                width: 64px;
                height: Spacing.button-height;
                border-radius: Spacing.radius-control;
                background: Colors.overlay-heavy;
                accessible-role: button;
                accessible-label: @tr("Show all call participants");
                accessible-action-default => { root.roster-open = !root.roster-open; }
                KeyFocus { border-radius: parent.border-radius; activate => { root.roster-open = !root.roster-open; } }
                Text {
                    text: "+" + (root.call-data.participants.length - root.tile-indices.length);
                    color: Colors.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.roster-open = !root.roster-open; }
                }
            }

            if root.roster-open && root.call-data.participants.length > root.tile-indices.length: Rectangle {
                x: parent.width - self.width - Spacing.sm;
                y: root.call-header-height + Spacing.button-height + 3 * root.chrome-gutter;
                width: min(260px, parent.width - 2 * Spacing.sm);
                height: min(320px, parent.height - self.y - Spacing.sm);
                border-radius: Spacing.radius-panel;
                background: Colors.surface-card;
                clip: true;

                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: roster-list.preferred-height;
                    roster-list := VerticalLayout {
                        padding: Spacing.sm;
                        spacing: Spacing.xxs;
                        for participant[index] in root.call-data.participants: Rectangle {
                            height: Spacing.list-row-height-touch;
                            background: participant.user-id == root.pinned-id ? Colors.tint-strong : transparent;
                            border-radius: Spacing.radius-control;
                            accessible-role: button;
                            accessible-label: @tr("Pin {}", participant.display-name);
                            accessible-action-default => {
                                root.pinned-id = participant.user-id;
                                root.user-focus = -1;
                                root.roster-open = false;
                            }
                            KeyFocus {
                                border-radius: parent.border-radius;
                                activate => {
                                    root.pinned-id = participant.user-id;
                                    root.user-focus = -1;
                                    root.roster-open = false;
                                }
                            }
                            Text {
                                x: Spacing.sm;
                                width: parent.width - 2 * Spacing.sm;
                                text: participant.display-name;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => {
                                    root.pinned-id = participant.user-id;
                                    root.user-focus = -1;
                                    root.roster-open = false;
                                }
                            }
                        }
                    }
                }
            }
        }

        // This material is painted after the full-size stage: it overlays
        // the video without reserving a separate strip of layout space.
        GlassSurface {
            x: root.chrome-gutter;
            y: root.chrome-gutter;
            width: parent.width - 2 * root.chrome-gutter;
            height: root.call-header-height;
            material-level: 3;
            elevation: 0;
            border-radius: Spacing.radius-panel;
            border-width: 1px;
            border-color: Colors.border;
            accessible-role: groupbox;
            accessible-label: @tr("Call information");
            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.sm;
                spacing: Spacing.md;
                Text {
                    accessible-role: text;
                    accessible-label: @tr("Call duration");
                    accessible-value: self.text;
                    text: root.is-connecting ? @tr("Calling…") : root.format-duration(call-data.duration-seconds);
                    font-size: Typography.sm;
                    font-weight: Typography.semibold;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    max-width: 76px;
                    overflow: elide;
                }
                if call-data.participant-count > 2 && root.width >= 600px: Text {
                    accessible-role: text;
                    accessible-label: @tr("Call participants");
                    accessible-value: call-data.participant-count;
                    text: call-data.participant-count + " people";
                    font-size: Typography.xs;
                    color: Colors.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle { horizontal-stretch: 1; }
                HeaderButton {
                    touch: root.is-mobile-platform;
                    icon: fullscreen ? Icons.minimize : Icons.maximize;
                    label: fullscreen ? @tr("Exit full screen") : @tr("Full screen");
                    clicked => { root.fullscreen-toggle(); }
                }
            }
            // Center independently of the duration and full-screen control.
            if call-data.is-encrypted: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 160px, call-data.verification-emoji-1 == "" ? 152px
                    : 4 * Typography.lg + 3 * Spacing.sm
                        + (call-data.verification-key-version != "" ? 56px : 0px));
                height: Typography.lg;
                accessible-role: groupbox;
                accessible-label: @tr("Call verification");
                accessible-description: @tr("Compare these four emojis with everyone in the call.");
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.sm;
                    if call-data.verification-emoji-1 != "": HorizontalLayout {
                        spacing: Spacing.sm;
                        VerificationEmoji { accessible-role: text; accessible-label: @tr("Call verification emoji 1: {}", call-data.verification-emoji-1); emoji: call-data.verification-emoji-1; }
                        VerificationEmoji { accessible-role: text; accessible-label: @tr("Call verification emoji 2: {}", call-data.verification-emoji-2); emoji: call-data.verification-emoji-2; }
                        VerificationEmoji { accessible-role: text; accessible-label: @tr("Call verification emoji 3: {}", call-data.verification-emoji-3); emoji: call-data.verification-emoji-3; }
                        VerificationEmoji { accessible-role: text; accessible-label: @tr("Call verification emoji 4: {}", call-data.verification-emoji-4); emoji: call-data.verification-emoji-4; }
                    }
                    if call-data.verification-emoji-1 != "" && call-data.verification-key-version != "": Text {
                        accessible-role: text;
                        accessible-label: @tr("Call key version {}", call-data.verification-key-version);
                        // The key changes as people join and leave; emojis only
                        // match between people on the same key, so say which.
                        text: "key " + call-data.verification-key-version;
                        font-size: Typography.xs;
                        color: Colors.text-muted;
                        vertical-alignment: center;
                    }
                    if call-data.verification-emoji-1 == "": Text {
                        accessible-role: text;
                        accessible-label: @tr("Call verification pending");
                        text: @tr("Verification pending");
                        font-size: Typography.xs;
                        color: Colors.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

        }

        // Controls float over the bottom of the video. Self-view and labels
        // reserve this area so they remain visible above the toolbar.
        CallControls {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - root.chrome-gutter;
            // Seven separate 44px targets fill a 320px phone's row.
            width: 7 * 44px;
            height: controls-height;
            button-size: root.button-size;
            is-connected: root.call-data.is-connected;
            is-muted: is-muted;
            is-video-enabled: is-video-enabled;
            is-screen-sharing: is-screen-sharing;
            is-video-call: call-data.is-video-call;
            speaker-toggle: root.speaker-toggle;
            speaker-on: root.speaker-on;
            toggle-speaker => { root.toggle-speaker(); }

            toggle-mute => { root.toggle-mute(); }
            toggle-video => { root.toggle-video(); }
            toggle-screen-share => { root.toggle-screen-share(); }
            end-call => { root.end-call(); }
            show-audio-input => { root.show-audio-input(); }
            show-audio-output => { root.show-audio-output(); }
        }
    }

    pure function format-duration(seconds: int) -> string {
        if seconds < 3600 {
            return Math.floor(seconds / 60) + ":" + (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
        } else {
            return Math.floor(seconds / 3600) + ":" +
                   (Math.mod(Math.floor(seconds / 60), 60) < 10 ? "0" : "") + Math.mod(Math.floor(seconds / 60), 60) + ":" +
                   (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
        }
    }
}
