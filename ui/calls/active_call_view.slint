// Active call view as a dock on top of the chat pane (Discord-style).
//
// Renders a compact header strip (title + duration + verification), a bounded
// video/avatar grid, and a floating control pill. Defaults to a dock; the
// maximize button grows it to fill the whole window (app.slint hides the
// sidebar + chat while `fullscreen`). Hidden when `show` is false — collapses
// to zero height so the surrounding chat layout reclaims the space.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "../components/avatar.slint";
import { CallControls } from "call_controls.slint";
import { ActiveCallData, CallParticipantData } from "types.slint";

component ParticipantTile inherits Rectangle {
    in property <CallParticipantData> participant;
    in property <image> video-frame;
    in property <bool> is-local: false;
    in property <bool> show-video: true;
    callback clicked();

    TouchArea {
        clicked => { root.clicked(); }
    }

    background: Colors.surface;
    border-radius: Spacing.radius-lg;
    // Border + outer glow drive the "is speaking" affordance — both animate
    // between idle and active so the transition feels alive rather than a
    // hard on/off flip. Uses the sidebar accent teal so "talking" matches the
    // rest of the app's green instead of a one-off neon.
    border-width: participant.is-speaking ? 3px : 1px;
    border-color: participant.is-speaking ? Colors.primary : Colors.neo-highlight;
    drop-shadow-blur: participant.is-speaking ? 18px : 0px;
    drop-shadow-color: participant.is-speaking ? Colors.primary.with-alpha(0.6) : transparent;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 0px;
    clip: true;

    animate border-width { duration: 160ms; easing: ease-in-out; }
    animate border-color { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 240ms; easing: ease-in-out; }
    animate drop-shadow-color { duration: 240ms; easing: ease-in-out; }

    // Video frame or avatar placeholder. Screen-share streams ALWAYS use
    // `contain` — never crop. Cropping a screen share hides content (the
    // viewer sees only a slice of the shared desktop); letterbox bars are the
    // correct tradeoff. Camera tracks stay on `cover` so a 16:9 face video
    // fills the tile cleanly without bars.
    if show-video && participant.is-video-enabled: Image {
        source: video-frame;
        width: 100%;
        height: 100%;
        image-fit: participant.is-screen-sharing ? contain : cover;
    }

    if !show-video || !participant.is-video-enabled: Rectangle {
        width: 100%;
        height: 100%;
        background: Colors.surface-hover;

        // Avatar scales with the tile instead of a fixed thumbnail.
        property <length> avatar-size: clamp(min(root.width, root.height) * 36%, 45px, 144px);

        VerticalLayout {
            alignment: center;
            spacing: Spacing.sm;

            HorizontalLayout {
                alignment: center;

                Avatar {
                    size: avatar-size;
                    source: participant.avatar-source;
                    fallback-text: participant.initials;
                }
            }

            Text {
                text: is-local ? "You" : participant.display-name;
                font-size: Typography.sm;
                color: Colors.text-primary;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    // Mute indicator
    if participant.is-muted: Rectangle {
        x: Spacing.xs;
        y: parent.height - 24px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Colors.error.with-alpha(0.85);

        Image {
            source: Icons.mic-off;
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.text-primary;
        }
    }

    // Screen-share indicator (top-right) — tells the streamer themselves
    // "you are sharing" and tells viewers which tile is the screen feed.
    if participant.is-screen-sharing: Rectangle {
        x: parent.width - self.width - Spacing.xs;
        y: Spacing.xs;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: Colors.glow-cyan.with-alpha(0.85);

        Image {
            source: Icons.monitor;
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.text-primary;
        }
    }

    // Name label (bottom-right) — only over live video; the avatar branch
    // already shows the name under the avatar.
    if show-video && participant.is-video-enabled: Rectangle {
        x: parent.width - self.width - Spacing.xs;
        y: parent.height - self.height - Spacing.xs;
        width: name-text.preferred-width + Spacing.md;
        height: 18px;
        border-radius: Spacing.radius-sm;
        background: Colors.overlay-heavy;

        name-text := Text {
            x: Spacing.xs;
            text: is-local ? "You" : participant.display-name;
            font-size: Typography.xs;
            color: Colors.text-primary;
            vertical-alignment: center;
        }
    }
}

export component ActiveCallView inherits Rectangle {
    in property <bool> show: false;
    in property <ActiveCallData> call-data;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <image> local-video-frame;
    in property <[image]> remote-video-frames;
    // When true, the dock expands to fill the viewport (chat panel hides at
    // the parent layout). Driven by app.slint, toggled via the fullscreen
    // button on the maximized tile.
    in property <bool> fullscreen: false;
    // Window height, passed from app.slint so the non-fullscreen dock can
    // scale with the viewport instead of a fixed band.
    in property <length> viewport-height: 720px;
    // The user's explicit focus choice: -2 = auto (follow any screen share),
    // -1 = user chose the grid, 0..n = user maximized that tile.
    property <int> user-focus: -2;
    // Index of the first screen-sharing tile, else -1. Slint has no array-find
    // in expressions, so this is a bounded manual scan.
    // ponytail: capped at 6 tiles — the grid renders at most 4 cameras plus a
    // screen tile; widen the ladder if calls ever show more tiles at once.
    property <int> screen-share-index:
          (call-data.participants.length > 0 && call-data.participants[0].is-screen-sharing) ? 0
        : (call-data.participants.length > 1 && call-data.participants[1].is-screen-sharing) ? 1
        : (call-data.participants.length > 2 && call-data.participants[2].is-screen-sharing) ? 2
        : (call-data.participants.length > 3 && call-data.participants[3].is-screen-sharing) ? 3
        : (call-data.participants.length > 4 && call-data.participants[4].is-screen-sharing) ? 4
        : (call-data.participants.length > 5 && call-data.participants[5].is-screen-sharing) ? 5
        : -1;
    // Effective focus: honor the user's explicit choice, otherwise auto-focus a
    // screen share so it comes forward big instead of a letterboxed grid cell.
    // -1 = grid view, 0..n = that tile is maximized. Render branches read this.
    property <int> maximized-index: user-focus == -2 ? screen-share-index : user-focus;
    // A new/changed screen share re-arms auto-focus even if the user had dropped
    // back to the grid, so the share always surfaces.
    changed screen-share-index => { user-focus = -2; }
    // Derived properties only evaluate meaningfully when maximized-index >= 0;
    // the explicit guard avoids `remote-video-frames[-1]` (Slint indexes the
    // array eagerly and a negative index aborts the per-frame property
    // re-eval, which silently drops the binding update path for the grid
    // tiles too).
    property <bool> maximized-is-local: maximized-index >= 0
        && maximized-index == call-data.participant-count - 1;
    property <image> maximized-video-frame: maximized-index < 0
        ? local-video-frame
        : (maximized-is-local
            ? local-video-frame
            : (remote-video-frames.length > maximized-index
                ? remote-video-frames[maximized-index]
                : local-video-frame));

    callback toggle-mute();
    callback toggle-video();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-settings();
    // Per-peer local controls — only the local viewer is affected.
    callback peer-audio-mute-toggle(string);
    callback peer-video-pause-toggle(string);
    // Asks the parent layout to grow the dock to the full viewport.
    callback fullscreen-toggle();

    // Dock: collapses to zero height when hidden so parent VerticalLayout
    // reclaims the space and the underlying chat header/messages fill it.
    // In fullscreen mode `vertical-stretch: 1` (set by the parent in
    // app.slint) plus a large `max-height` lets the dock grow to occupy the
    // full chat-column slot. Otherwise it's a responsive dock: ~45% of the
    // window height, clamped so chat stays visible on tall screens and the
    // dock isn't oversized on short/mobile ones (was a fixed 280px band that
    // ignored the viewport).
    property <length> dock-height: clamp(viewport-height * 0.45, 240px, 560px);
    visible: show;
    min-height: show ? (fullscreen ? 0px : dock-height) : 0px;
    max-height: show ? (fullscreen ? 100000px : dock-height) : 0px;
    preferred-height: show ? dock-height : 0px;
    background: Colors.surface.with-alpha(0.6);
    border-width: 1px;
    border-color: Colors.neo-inset-shadow;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-y: Spacing.neo-offset-sm;
    drop-shadow-color: Colors.neo-shadow;

    if show: VerticalLayout {
        // Video grid area — bounded, tiles scale to fit
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            if maximized-index < 0 && call-data.participant-count == 1: ParticipantTile {
                x: Spacing.sm;
                y: Spacing.sm;
                width: parent.width - 2 * Spacing.sm;
                height: parent.height - 2 * Spacing.sm;
                participant: call-data.participants[0];
                video-frame: local-video-frame;
                is-local: true;
                clicked => { root.user-focus = 0; }
            }

            if maximized-index < 0 && call-data.participant-count == 2: HorizontalLayout {
                padding: Spacing.sm;
                spacing: Spacing.sm;

                ParticipantTile {
                    horizontal-stretch: 1;
                    participant: call-data.participants[0];
                    video-frame: remote-video-frames.length > 0 ? remote-video-frames[0] : local-video-frame;
                    clicked => { root.user-focus = 0; }
                }

                ParticipantTile {
                    horizontal-stretch: 1;
                    participant: call-data.participants.length > 1 ? call-data.participants[1] : call-data.participants[0];
                    video-frame: local-video-frame;
                    is-local: true;
                    clicked => { root.user-focus = 1; }
                }
            }

            if maximized-index < 0 && call-data.participant-count >= 3 && call-data.participant-count <= 4: VerticalLayout {
                padding: Spacing.sm;
                spacing: Spacing.sm;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    ParticipantTile {
                        horizontal-stretch: 1;
                        participant: call-data.participants[0];
                        video-frame: remote-video-frames.length > 0 ? remote-video-frames[0] : local-video-frame;
                        clicked => { root.user-focus = 0; }
                    }
                    ParticipantTile {
                        horizontal-stretch: 1;
                        participant: call-data.participants.length > 1 ? call-data.participants[1] : call-data.participants[0];
                        video-frame: remote-video-frames.length > 1 ? remote-video-frames[1] : local-video-frame;
                        clicked => { root.user-focus = 1; }
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.sm;

                    ParticipantTile {
                        horizontal-stretch: 1;
                        participant: call-data.participants.length > 2 ? call-data.participants[2] : call-data.participants[0];
                        video-frame: remote-video-frames.length > 2 ? remote-video-frames[2] : local-video-frame;
                        clicked => { root.user-focus = 2; }
                    }
                    ParticipantTile {
                        horizontal-stretch: 1;
                        participant: call-data.participants.length > 3 ? call-data.participants[3] : call-data.participants[0];
                        video-frame: local-video-frame;
                        is-local: call-data.participant-count >= 4;
                        opacity: call-data.participant-count >= 4 ? 1.0 : 0.0;
                        clicked => {
                            if (call-data.participant-count >= 4) { root.user-focus = 3; }
                        }
                    }
                }
            }

            // Maximized single tile — click the tile to restore the grid.
            // Per-peer controls (mute/pause) are rendered as a small overlay
            // bar above the tile when the maximized participant is remote.
            // Fullscreen + maximized fills (cover) so ultrawide screen-share
            // captures aren't squashed into a thin letterboxed band.
            if maximized-index >= 0 && maximized-index < call-data.participant-count: ParticipantTile {
                x: Spacing.sm;
                y: Spacing.sm;
                width: parent.width - 2 * Spacing.sm;
                height: parent.height - 2 * Spacing.sm;
                participant: call-data.participants[maximized-index];
                video-frame: maximized-video-frame;
                is-local: maximized-is-local;
                clicked => { root.user-focus = -1; }
            }

            // Per-peer controls bar — top of the maximized tile, remote only.
            if maximized-index >= 0 && !maximized-is-local
               && maximized-index < call-data.participant-count: Rectangle {
                x: (parent.width - self.width) / 2;
                y: Spacing.sm + Spacing.sm;
                width: 96px;
                height: 40px;
                border-radius: 20px;
                background: Colors.overlay-heavy;

                HorizontalLayout {
                    padding-left: Spacing.xs;
                    padding-right: Spacing.xs;
                    spacing: Spacing.xs;
                    alignment: center;

                    // Audio mute toggle for this peer.
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: call-data.participants[maximized-index].is-audio-muted-locally
                            ? Colors.error.with-alpha(0.85)
                            : Colors.surface-hover;

                        mute-touch := TouchArea {
                            clicked => {
                                root.peer-audio-mute-toggle(
                                    call-data.participants[maximized-index].user-id);
                            }
                        }

                        Image {
                            source: call-data.participants[maximized-index].is-audio-muted-locally
                                ? Icons.mic-off : Icons.mic;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: Colors.text-primary;
                        }
                    }

                    // Video pause toggle for this peer.
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: call-data.participants[maximized-index].is-video-paused-locally
                            ? Colors.error.with-alpha(0.85)
                            : Colors.surface-hover;

                        pause-touch := TouchArea {
                            clicked => {
                                root.peer-video-pause-toggle(
                                    call-data.participants[maximized-index].user-id);
                            }
                        }

                        Image {
                            source: call-data.participants[maximized-index].is-video-paused-locally
                                ? Icons.play : Icons.pause;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: Colors.text-primary;
                        }
                    }
                }
            }

            // Call info overlay — top-left: duration, participant count, and
            // the security indicator (SAS emojis when available, else lock).
            Rectangle {
                x: Spacing.sm + Spacing.xs;
                y: Spacing.sm + Spacing.xs;
                width: info-row.preferred-width + Spacing.md;
                height: 24px;
                border-radius: 12px;
                background: Colors.overlay-heavy;

                info-row := HorizontalLayout {
                    padding-left: Spacing.sm;
                    padding-right: Spacing.sm;
                    spacing: Spacing.sm;

                    Text {
                        text: format-duration(call-data.duration-seconds);
                        font-size: Typography.xs;
                        color: Colors.text-secondary;
                        vertical-alignment: center;
                    }

                    if call-data.participant-count > 2: Text {
                        text: "• " + call-data.participant-count;
                        font-size: Typography.xs;
                        color: Colors.text-secondary;
                        vertical-alignment: center;
                    }

                    if call-data.is-encrypted && call-data.verification-emoji-1 != "": HorizontalLayout {
                        spacing: 2px;

                        Text { font-family: Typography.font-family-emoji; text: call-data.verification-emoji-1; font-size: Typography.xs; vertical-alignment: center; }
                        Text { font-family: Typography.font-family-emoji; text: call-data.verification-emoji-2; font-size: Typography.xs; vertical-alignment: center; }
                        Text { font-family: Typography.font-family-emoji; text: call-data.verification-emoji-3; font-size: Typography.xs; vertical-alignment: center; }
                        Text { font-family: Typography.font-family-emoji; text: call-data.verification-emoji-4; font-size: Typography.xs; vertical-alignment: center; }
                    }

                    if call-data.is-encrypted && call-data.verification-emoji-1 == "": Image {
                        source: Icons.lock;
                        width: 12px;
                        height: 12px;
                        colorize: Colors.primary.with-alpha(0.7);
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Fullscreen toggle — top-right of the call dock. Visible in both
            // grid and maximized modes. Asks the parent layout to expand the
            // dock to cover the chat area.
            Rectangle {
                x: parent.width - self.width - Spacing.sm;
                y: Spacing.sm;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: Colors.overlay-heavy;

                fullscreen-touch := TouchArea {
                    clicked => { root.fullscreen-toggle(); }
                }

                Image {
                    source: fullscreen ? Icons.minimize : Icons.maximize;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-primary;
                }
            }

            // Floating control pill overlay — centered horizontally, floats
            // over the bottom edge of the tiles instead of reserving a band.
            CallControls {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - Spacing.md;
                width: min(256px, parent.width - 2 * Spacing.md);
                height: 40px;
                is-muted: is-muted;
                is-video-enabled: is-video-enabled;
                is-screen-sharing: is-screen-sharing;
                is-video-call: call-data.is-video-call;

                toggle-mute => { root.toggle-mute(); }
                toggle-video => { root.toggle-video(); }
                toggle-screen-share => { root.toggle-screen-share(); }
                end-call => { root.end-call(); }
                show-audio-settings => { root.show-audio-settings(); }
            }
        }
    }

    pure function format-duration(seconds: int) -> string {
        if seconds < 3600 {
            return Math.floor(seconds / 60) + ":" + (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
        } else {
            return Math.floor(seconds / 3600) + ":" +
                   (Math.mod(Math.floor(seconds / 60), 60) < 10 ? "0" : "") + Math.mod(Math.floor(seconds / 60), 60) + ":" +
                   (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60);
        }
    }
}
