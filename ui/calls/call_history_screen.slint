import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// CallHistoryScreen — the mobile bottom nav's "Calls" tab.
//
// A list of past calls across every conversation type that can host one
// (channel, server DM, anon DM, anon group). Rows are built by core; this
// file only lays them out. Tapping a row reopens the conversation, the two
// buttons redial it as voice or video.
//
// Deleting: hold (touch) or right-click (pointer) a row, or ⋮ → Select calls,
// to pick rows; ⋮ → Clear call history for the whole list under the current
// filter. Both delete from this device only — Calls history has no server
// copy and no peer-side delete, and chat Call messages are separate.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Avatar } from "../components/avatar.slint";
import { HeaderButton } from "../components/header_button.slint";
import { HoldArea } from "../components/hold_area.slint";
import { CallHistoryRow } from "types.slint";

export component CallHistoryScreen inherits Rectangle {
    in property <bool> show-modal: false;
    // "Touch input", same meaning as the sidebar's and the Contacts screen's.
    // On a phone this is a full-screen page reached from the tab bar, so its
    // rows read the shared touch geometry rather than desktop density.
    in property <bool> mobile-mode: false;
    in property <length> bottom-inset: 0px;
    // A tab's root screen (see Modal): no back chevron, the tab bar navigates.
    in property <bool> root-screen: false;
    in property <[CallHistoryRow]> rows: [];
    in property <bool> loading: false;
    in property <string> error-message: "";
    callback retry();
    in property <string> active-filter: "all";  // "all" or "missed"

    property <length> row-height: root.mobile-mode ? Spacing.row-height-touch : 56px * Appearance.text-grow;
    property <length> row-avatar: root.mobile-mode ? Spacing.row-avatar-touch : 40px;
    property <length> row-name-size: root.mobile-mode ? Typography.base : Typography.sm;
    property <length> row-sub-size: root.mobile-mode ? Typography.sm : Typography.xs;

    callback close();
    callback filter-changed(string);
    // conversation-id, conversation-type
    callback open-conversation(string, string);
    // conversation-id, conversation-type, is-video
    callback call-back(string, string, bool);
    callback clear-history();

    // Selection, owned by Rust (`features/calls/history.rs`): it sets the
    // rows' `selected` marks, the count, and `selecting`.
    in property <bool> selecting: false;
    in property <int> selected-count: 0;
    // Enter selection with this row marked, or flip its mark once selecting.
    callback toggle-select(string);
    // Mark every loaded row (true) or none (false); also enters selection.
    callback select-all(bool);
    callback end-selection();
    callback delete-selected();

    // Clear-history confirmation reveal. Presentation state only — nothing
    // leaves the UI until the second click. Reset on every open, or a screen
    // closed mid-confirm reopens already asking to wipe the list.
    property <bool> show-clear-confirm: false;
    // Which delete the confirmation is for: the selected rows, or the list.
    property <bool> confirm-selected: false;
    // The header ⋮ menu, which holds Clear call history.
    in-out property <bool> show-more-menu: false;
    // Desktop has a close button after overflow; mobile has overflow last.
    property <length> more-menu-trailing-inset: root.mobile-mode ? 0px
        : Spacing.header-action-box + Spacing.header-action-gap;
    // Entering or leaving selection changes what a pending confirmation
    // would delete, so it never survives the switch.
    changed selecting => { self.show-clear-confirm = false; }
    changed show-modal => {
        self.show-clear-confirm = false;
        self.show-more-menu = false;
    }

    Modal {
        floating-content: root.mobile-mode;
        show: root.show-modal;
        title: "Calls";
        modal-width: 560px;
        max-modal-height: 800px;
        full-screen: root.mobile-mode;
        root-screen: root.root-screen;
        bottom-inset: root.bottom-inset;
        // The scrollable list needs a viewport on desktop too. Its overlay
        // wrapper cannot supply a content-sized preferred height to Modal.
        fill-height: true;
        show-more: !root.loading && root.rows.length > 0 && !root.selecting;
        more-clicked => { root.show-more-menu = !root.show-more-menu; }

        close => {
            // Backdrop taps and Escape dismiss the topmost surface first.
            if root.show-more-menu {
                root.show-more-menu = false;
            } else {
                root.close();
            }
        }

        Rectangle {
            vertical-stretch: 1;

        VerticalLayout {
            spacing: Spacing.md;
            vertical-stretch: 1;

            // Filter tabs — mirrors core's `CallHistoryFilter`. Same box
            // height as the header row's dismissal control above it.
            // Selection bar — stands in for the filter tabs while picking
            // rows, as the chat's SelectionBar stands in for its header.
            if root.selecting: GlassSurface {
                material-enabled: root.mobile-mode;
                elevation: 0;
                z: 1;
                height: root.mobile-mode ? Spacing.header-action-box-touch : Spacing.header-action-box;

                HorizontalLayout {
                    spacing: Spacing.header-action-gap;

                    HeaderButton {
                        touch: root.mobile-mode;
                        icon: Icons.x;
                        label: "Exit selection";
                        clicked => { root.end-selection(); }
                    }

                    Text {
                        text: root.selected-count == 1 ? "1 selected" : root.selected-count + " selected";
                        color: Colors.text-primary;
                        font-size: Typography.base;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // One toggle: everything loaded selected → clears it.
                    HeaderButton {
                        touch: root.mobile-mode;
                        icon: Icons.check;
                        active: root.rows.length > 0 && root.selected-count == root.rows.length;
                        label: root.rows.length > 0 && root.selected-count == root.rows.length ? "Deselect all" : "Select all";
                        clicked => { root.select-all(!(root.rows.length > 0 && root.selected-count == root.rows.length)); }
                    }

                    HeaderButton {
                        touch: root.mobile-mode;
                        icon: Icons.trash;
                        label: "Delete selected";
                        destructive: true;
                        enabled: root.selected-count > 0;
                        clicked => {
                            root.confirm-selected = true;
                            root.show-clear-confirm = true;
                        }
                    }
                }
            }

            if !root.selecting: GlassSurface {
                material-enabled: root.mobile-mode;
                elevation: 0;
                z: 1;
                height: root.mobile-mode ? Spacing.header-action-box-touch : Spacing.header-action-box;

                HorizontalLayout {
                    for tab in [
                        { id: "all", label: "All" },
                        { id: "missed", label: "Missed" }
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        background: root.active-filter == tab.id ? Colors.text-primary.with-alpha(0.12) : (tab-touch.has-hover ? Colors.surface-hover.with-alpha(0.3) : transparent);

                        VerticalLayout {
                            HorizontalLayout {
                                alignment: center;
                                vertical-stretch: 1;

                                Text {
                                    text: tab.label;
                                    color: root.active-filter == tab.id ? Colors.text-primary : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: root.active-filter == tab.id ? Typography.semibold : Typography.normal;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 2px;
                                background: root.active-filter == tab.id ? Colors.primary : transparent;
                            }
                        }

                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.filter-changed(tab.id);
                            }
                        }
                    }
                }
            }

            if root.loading: HorizontalLayout {
                alignment: center;
                vertical-stretch: 1;

                Text {
                    text: "Loading…";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
            }

            if !root.loading && root.error-message == "" && root.rows.length == 0: VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                spacing: Spacing.sm;

                HorizontalLayout {
                    alignment: center;

                    Image {
                        source: Icons.phone;
                        colorize: Colors.text-muted;
                        width: 32px;
                        height: 32px;
                    }
                }

                Text {
                    text: root.active-filter == "missed" ? "No missed calls" : "No calls yet";
                    color: Colors.text-muted;
                    font-size: Typography.base;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.active-filter == "missed" ? "Calls you did not answer show up here." : "Start one from the phone icon in any conversation.";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }

            if root.error-message != "": VerticalLayout {
                spacing: Spacing.sm;
                Text { text: root.error-message; color: Colors.text-muted; horizontal-alignment: center; }
                Button { text: "Retry"; disabled: root.loading; clicked => { root.retry(); } }
            }

            if !root.loading && root.rows.length > 0: Rectangle {
                vertical-stretch: 1;
                property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                scroll-calls-list := Flickable {
                    property <length> chrome-inset: parent.chrome-inset;
                    width: parent.width;
                    y: root.mobile-mode ? -parent.chrome-inset : 0px;
                    // Keep the usual floating list behind mobile chrome. When
                    // confirmation is visible, end at the allocated list slot:
                    // root.height would carry rows through the footer below it.
                    height: root.mobile-mode
                        ? (root.show-clear-confirm ? parent.height + parent.chrome-inset : root.height)
                        : parent.height;

                    viewport-height: calls-list.preferred-height;

                    calls-list := VerticalLayout {
                        padding-top: root.mobile-mode ? scroll-calls-list.chrome-inset : Spacing.none;
                        padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                        spacing: Spacing.xs;

                        for row in root.rows: Rectangle {
                            height: root.row-height;
                            background: root.selecting && row.selected ? Colors.text-primary.with-alpha(0.12)
                                : row-touch.has-hover ? Colors.surface-hover : transparent;
                            border-radius: Spacing.radius-md;

                            // Under the row's content, not over it: declared last it
                            // sat on top and took the redial buttons' taps, so
                            // "call back" opened the DM instead of calling.
                            // Hold (touch) or right-click starts selection here.
                            row-touch := HoldArea {
                                enabled-for-touch: root.mobile-mode && !root.selecting;
                                held => {
                                    if !root.selecting { root.toggle-select(row.id); }
                                }
                                clicked => {
                                    if self.hold-fired { return; }
                                    if root.selecting {
                                        root.toggle-select(row.id);
                                    } else {
                                        root.open-conversation(row.conversation-id, row.conversation-type);
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding: Spacing.sm;
                                spacing: Spacing.sm;

                                // Passive mark: the row's HoldArea takes the tap.
                                // Checkbox would flip its own `checked` and drop
                                // the binding to the model Rust updates.
                                if root.selecting: Rectangle {
                                    width: Spacing.switch-thumb;
                                    height: self.width;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Spacing.radius-sm;
                                    border-width: Spacing.stroke;
                                    border-color: row.selected ? Colors.action-fill : Colors.text-muted;
                                    background: row.selected ? Colors.action-fill : transparent;
                                    accessible-role: checkbox;
                                    accessible-label: "Select call with " + row.name;
                                    accessible-checkable: true;
                                    accessible-checked: row.selected;

                                    if row.selected: Image {
                                        source: Icons.check;
                                        width: Spacing.md;
                                        height: self.width;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Colors.on-action;
                                    }
                                }

                                Avatar {
                                    size: root.row-avatar;
                                    name: row.name;
                                    source: row.avatar-source;
                                    anonymous: row.conversation-type == "anon_dm" || row.conversation-type == "anon_group";
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: root.mobile-mode ? Spacing.xs : Spacing.xxs;

                                    Text {
                                        // A missed call is the one thing on this
                                        // screen you came looking for, so it is the
                                        // name that carries the colour, not a badge
                                        // tucked into the second line.
                                        text: row.name;
                                        color: row.is-missed ? Colors.error : Colors.text-primary;
                                        font-size: root.row-name-size;
                                        font-weight: Typography.medium;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.xs;

                                        Image {
                                            source: row.is-video ? Icons.video : Icons.phone;
                                            colorize: row.is-missed ? Colors.error : Colors.text-muted;
                                            width: 12px;
                                            height: 12px;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        // The outcome takes all the slack and may
                                        // elide; the time keeps its natural width
                                        // and never does. Sizing the outcome to
                                        // exactly its preferred width (FX4) still
                                        // elided "Incoming · 0:16" to "0…" on the
                                        // phone with the row half empty.
                                        Text {
                                            text: row.detail;
                                            color: Colors.text-muted;
                                            font-size: root.row-sub-size;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: row.timestamp;
                                            color: Colors.text-muted;
                                            font-size: root.row-sub-size;
                                            horizontal-stretch: 0;
                                        }
                                    }
                                }

                                // Redial. Both types are offered rather than
                                // repeating the original call's type: wanting to
                                // switch is exactly why you'd come back to a row.
                                // Fixed width, no stretch, so the two buttons
                                // sit at the same x on every row.
                                if row.can-call-back && !root.selecting: HorizontalLayout {
                                    spacing: Spacing.xs;
                                    alignment: center;
                                    horizontal-stretch: 0;

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: Spacing.radius-sm;
                                        background: voice-touch.has-hover ? Colors.surface : transparent;

                                        Image {
                                            source: Icons.phone;
                                            colorize: Colors.primary;
                                            width: 18px;
                                            height: 18px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        voice-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.call-back(row.conversation-id, row.conversation-type, false);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: Spacing.radius-sm;
                                        background: video-touch.has-hover ? Colors.surface : transparent;

                                        Image {
                                            source: Icons.video;
                                            colorize: Colors.primary;
                                            width: 18px;
                                            height: 18px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        video-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.call-back(row.conversation-id, row.conversation-type, true);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                }
            }

            // Clearing is irreversible, so it takes the same two-step reveal
            // Channel Settings uses for Leave and Delete — one destructive
            // vocabulary across the app, not one per screen. Reached from the
            // header ⋮ menu below.
            if !root.loading && root.show-clear-confirm: Rectangle {
                vertical-stretch: 0;
                // Fixed at the body's wrapped height so the shared column takes
                // any shortage from the list slot above, never from this card:
                // left implicit, the card was squeezed and Cancel/Delete spilled
                // past its bottom edge onto the mobile tab dock.
                height: confirm-body.preferred-height;
                background: Colors.surface;
                border-radius: Spacing.radius-lg;
                // Shield whitespace as well as the controls from row actions.
                TouchArea {}

                confirm-body := VerticalLayout {
                    spacing: Spacing.sm;
                    padding: Spacing.sm;

                    Text {
                        text: !root.confirm-selected
                            ? "Delete every call in this list from this device? This cannot be undone."
                            : root.selected-count == 1
                            ? "Delete 1 selected call from this device? This cannot be undone."
                            : "Delete " + root.selected-count + " selected calls from this device? This cannot be undone.";
                        color: Colors.error;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // Scope, stated: nothing here reaches another device.
                    Text {
                        text: "Other people's call history and the call messages in your chats are not changed. A call in progress is kept.";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.sm;

                        // Cancel first and non-danger: the safe answer is the one
                        // the eye and the thumb land on.
                        Button {
                            text: "Cancel";
                            variant: "secondary";
                            clicked => { root.show-clear-confirm = false; }
                        }

                        Button {
                            text: root.confirm-selected ? "Delete" : "Clear history";
                            variant: "destructive";
                            clicked => {
                                root.show-clear-confirm = false;
                                if root.confirm-selected {
                                    root.delete-selected();
                                } else {
                                    root.clear-history();
                                }
                            }
                        }
                    }
                }
            }
        }

            // The Modal body shares the header's padded edges. On desktop,
            // reserve the trailing close button so the menu aligns with ⋮,
            // even when the card is centred in a much wider window.
            if root.show-more-menu: Rectangle {
                width: 100%;
                height: 100%;
                background: Materials.scrim;
                TouchArea {
                    clicked => { root.show-more-menu = false; }
                }

                GlassSurface {
                    material-level: 3;
                    elevation: 4;
                    x: parent.width - root.more-menu-trailing-inset - self.width;
                    y: 0;
                    width: min(max(select-label.preferred-width, menu-label.preferred-width) + 2 * Spacing.lg,
                        max(0px, parent.width - root.more-menu-trailing-inset));
                    height: 2 * Spacing.touch-target-min;
                    border-radius: Spacing.radius-xl;

                    VerticalLayout {
                        Rectangle {
                            height: Spacing.touch-target-min;

                            select-label := Text {
                                text: "Select calls";
                                color: Colors.text-primary;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-more-menu = false;
                                    root.show-clear-confirm = false;
                                    root.select-all(false);
                                }
                            }
                        }

                        Rectangle {
                            height: Spacing.touch-target-min;

                            menu-label := Text {
                                text: "Clear call history";
                                color: Colors.error;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            menu-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-more-menu = false;
                                    root.confirm-selected = false;
                                    root.show-clear-confirm = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
