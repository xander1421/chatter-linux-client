// Call UI type definitions

export struct CallParticipantData {
    user-id: string,
    display-name: string,
    initials: string,
    avatar-source: image,
    is-muted: bool,
    is-video-enabled: bool,
    is-screen-sharing: bool,
    is-speaking: bool,
    // Local viewer controls — affect this client only, not the wire.
    is-audio-muted-locally: bool,
    is-video-paused-locally: bool,
}

export struct ActiveCallData {
    call-id: string,
    channel-id: string,
    title: string,
    is-video-call: bool,
    is-anonymous-call: bool,
    is-encrypted: bool,
    is-identity-verified: bool,
    identity-warning: string,
    participant-count: int,
    duration-seconds: int,
    participants: [CallParticipantData],
    // Verification emojis (SAS) - both parties should see the same emojis
    verification-emoji-1: string,
    verification-emoji-2: string,
    verification-emoji-3: string,
    verification-emoji-4: string,
}

export struct IncomingCallData {
    call-id: string,
    caller-id: string,
    caller-name: string,
    caller-initials: string,
    caller-avatar: string,
    caller-avatar-source: image,
    channel-name: string,
    is-video-call: bool,
    is-anonymous-call: bool,
    is-identity-verified: bool,
    identity-warning: string,
    // Encryption key from caller (base64 encoded for UI transport)
    encryption-key: string,
    // Call start timestamp (nanoseconds since epoch, stored as string for precision)
    call-start-timestamp-ns: string,
}

// One row of the Calls screen. Built by core
// (`chatter_core::ui::CallHistoryRowData`) — every string here is already
// formatted, and `conversation-id` / `conversation-type` are the same pair
// the sidebar's section rows route on.
export struct CallHistoryRow {
    id: string,
    conversation-id: string,
    conversation-type: string,   // "channel" | "server_dm" | "anon_dm" | "anon_group" | ...
    name: string,
    initials: string,
    avatar-source: image,
    timestamp: string,           // "Yesterday 4:12 PM"
    detail: string,              // "Outgoing · 3:42" | "Missed"
    is-missed: bool,
    is-video: bool,
    is-incoming: bool,
    can-call-back: bool,
}

// Device/source selection types
export struct AudioDeviceData {
    id: string,
    name: string,
    is-default: bool,
}

export struct ScreenSourceData {
    id: string,
    name: string,
    width: int,
    height: int,
    is-monitor: bool,  // true = monitor, false = window
    is-primary: bool,
}
