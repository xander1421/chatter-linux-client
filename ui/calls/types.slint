// Call UI type definitions

export struct CallParticipantData {
    user-id: string,
    display-name: string,
    avatar-url: string,
    is-muted: bool,
    is-video-enabled: bool,
    is-screen-sharing: bool,
    is-speaking: bool,
}

export struct ActiveCallData {
    call-id: string,
    channel-id: string,
    title: string,
    is-video-call: bool,
    is-anonymous-call: bool,
    is-encrypted: bool,
    is-identity-verified: bool,
    identity-warning: string,
    participant-count: int,
    duration-seconds: int,
    participants: [CallParticipantData],
    // Verification emojis (SAS) - both parties should see the same emojis
    verification-emoji-1: string,
    verification-emoji-2: string,
    verification-emoji-3: string,
    verification-emoji-4: string,
}

export struct IncomingCallData {
    call-id: string,
    caller-id: string,
    caller-name: string,
    caller-avatar: string,
    channel-name: string,
    is-video-call: bool,
    is-anonymous-call: bool,
    is-identity-verified: bool,
    identity-warning: string,
    // Encryption key from caller (base64 encoded for UI transport)
    encryption-key: string,
    // Call start timestamp (nanoseconds since epoch, stored as string for precision)
    call-start-timestamp-ns: string,
}

// Device/source selection types
export struct AudioDeviceData {
    id: string,
    name: string,
    is-default: bool,
}

export struct ScreenSourceData {
    id: string,
    name: string,
    width: int,
    height: int,
    is-monitor: bool,  // true = monitor, false = window
    is-primary: bool,
}
