import { ActiveCallView } from "mod.slint";
import { ActiveCallData } from "../calls/mod.slint";
import { CallView } from "../app_call_view.slint";

// The active call occupies the chat column above the conversation.
export component AppCallDock inherits ActiveCallView {
    in property <ActiveCallData> active-call-data;
    in-out property <bool> active-call-fullscreen;
    in property <bool> active-call-visible;
    in property <bool> call-is-muted;
    in property <bool> call-is-screen-sharing;
    in property <bool> call-is-video-enabled;
    in property <image> call-local-video-frame;
    in property <[image]> call-remote-video-frames;
    in property <bool> call-speaker-on;
    in property <bool> call-speaker-toggle;
    in property <length> window-height;
    callback call-end();
    callback call-swap-camera();
    callback call-peer-audio-mute-toggle(string);
    callback call-peer-video-pause-toggle(string);
    callback call-toggle-mute();
    callback call-toggle-screen-share();
    callback call-toggle-speaker();
    callback call-toggle-video();
    callback show-screen-source-picker();
    callback show-audio-output-picker();

        // Fullscreen fills the chat column. Otherwise the child computes a
        // responsive call area, with more room on tablet and desktop.
        vertical-stretch: root.active-call-fullscreen ? 1 : 0;
        show: root.active-call-visible;
        fullscreen: root.active-call-fullscreen;
        viewport-height: root.window-height;
        call-data: root.active-call-data;
        select-tile-indices(participants, pinned_id) => {
            return CallView.select-call-tile-indices(participants, pinned_id);
        }
        video-layout-revision: CallView.call-video-layout-revision;
        video-size(id, width, height, screen) => { CallView.report-call-video-size(id, width, height, screen); }
        is-muted: root.call-is-muted;
        is-video-enabled: root.call-is-video-enabled;
        is-screen-sharing: root.call-is-screen-sharing;
        speaker-toggle: root.call-speaker-toggle;
        speaker-on: root.call-speaker-on;
        toggle-speaker => { root.call-toggle-speaker(); }
        local-video-frame: root.call-local-video-frame;
        remote-video-frames: root.call-remote-video-frames;

        toggle-mute => { root.call-toggle-mute(); }
        toggle-video => { root.call-toggle-video(); }
        swap-camera => { root.call-swap-camera(); }
        toggle-screen-share => {
            if root.call-is-screen-sharing {
                root.call-toggle-screen-share();
            } else {
                root.show-screen-source-picker();
            }
        }
        end-call => { root.call-end(); root.active-call-fullscreen = false; }
        show-audio-input => { CallView.show-audio-device-picker(); }
        show-audio-output => { root.show-audio-output-picker(); }
        peer-audio-mute-toggle(uid) => { root.call-peer-audio-mute-toggle(uid); }
        peer-video-pause-toggle(uid) => { root.call-peer-video-pause-toggle(uid); }
        fullscreen-toggle => {
            if !root.active-call-fullscreen { CallView.save-call-route(); }
            root.active-call-fullscreen = !root.active-call-fullscreen;
            if !root.active-call-fullscreen { CallView.restore-call-route(); }
        }
}
