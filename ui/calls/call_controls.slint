import { Colors } from "../theme/colors.slint";
import { IconAction } from "../components/icon_action.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Call control bar with mute, video, screen share, and end call buttons
// Shared flat icon actions inside one glass control group.

import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";

export component CallControls inherits GlassSurface {
    material-level: 3;
    elevation: 3;
    border-radius: Spacing.radius-panel;
    border-width: 1px;
    border-color: Colors.border;
    property <float> arrival: 0;
    init => { root.arrival = 1; }
    opacity: arrival;
    transform-scale-x: 90% + arrival * 10%;
    transform-scale-y: 82% + arrival * 18%;
    animate arrival { duration: Materials.motion-standard; easing: Materials.spring; }

    in property <bool> is-connected: false;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <bool> is-video-call: true;
    // Phones show linked microphone/output routes; desktop shows independent devices.
    // `speaker-on` reflects the communication route acknowledged by Android.
    in property <bool> speaker-toggle: false;
    in property <bool> speaker-on: false;
    // Shared minimum target at both densities.
    in property <length> button-size: Spacing.button-height;

    callback toggle-mute();
    callback toggle-video();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-input();
    callback show-audio-output();
    callback toggle-speaker();

    height: 48px;
    HorizontalLayout {
        alignment: center;
        spacing: Spacing.none;
        padding: Spacing.none;
        // Each audio route is a pair of shared targets: the device-select
        // caret to the LEFT of the circle (outside it — owner 2026-11-06: a
        // caret overlapping the button top edge read as part of the circle),
        // then the circle. Both are full 44px targets (owner 2026-11-13).
        // Microphone: the caret opens the input-device list, the circle
        // toggles mute.
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            icon: Icons.chevron-down;
            label: root.speaker-toggle ? @tr("Select microphone, linked audio route") : @tr("Select microphone");
            clicked => { root.show-audio-input(); }
        }
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            icon: root.is-muted ? Icons.mic-off : Icons.mic;
            label: root.is-muted ? @tr("Unmute microphone") : @tr("Mute microphone");
            clicked => { root.toggle-mute(); }
        }
        // Output: the caret always opens the output-device list; the circle
        // toggles speaker (phone) or opens the output list (desktop).
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            icon: Icons.chevron-down;
            label: root.speaker-toggle ? @tr("Select output, linked audio route") : @tr("Select output");
            clicked => { root.show-audio-output(); }
        }
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            icon: Icons.volume-2;
            label: root.speaker-toggle ? @tr("Toggle speaker") : @tr("Select audio output");
            active: root.speaker-toggle && root.speaker-on;
            clicked => {
                if root.speaker-toggle { root.toggle-speaker(); }
                else { root.show-audio-output(); }
            }
        }

        // Video toggle — always available so the user can turn the camera on
        // mid-call, even on a call that started as voice-only. Camera off is
        // the neutral state; teal means it is on.
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            enabled: root.is-connected;
            icon: root.is-video-enabled ? Icons.video : Icons.video-off;
            label: root.is-video-enabled ? @tr("Turn camera off") : @tr("Turn camera on");
            active: is-video-enabled;
            clicked => { toggle-video(); }
        }

        // Screen share toggle (system consent is requested on Android).
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            enabled: root.is-connected || root.is-screen-sharing;
            icon: Icons.monitor;
            label: root.is-screen-sharing ? @tr("Stop sharing screen") : @tr("Share screen");
            active: is-screen-sharing;
            clicked => { toggle-screen-share(); }
        }

        IconAction {
            size: root.button-size;
            width: 44px;
            height: 48px;
            icon: Icons.phone-off;
            label: @tr("End call");
            destructive: true;
            clicked => { root.end-call(); }
        }
    }
}
