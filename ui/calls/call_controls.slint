import { Colors } from "../theme/colors.slint";
import { IconAction } from "../components/icon_action.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Call control bar with mute, video, screen share, and end call buttons
// Shared flat icon actions inside one glass control group.

import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";

// A device-route button with its own device-select caret to the LEFT of the
// circle (outside it — owner 2026-11-06: the caret overlapping the button top
// edge read as part of the circle). Tapping the circle runs `clicked` (mute /
// speaker); tapping the caret runs `select`, which opens that category's list.
component DeviceButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> select-label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    callback select();
    // caret column (18) + the circle (44).
    width: 18px + 44px;
    height: 48px;
    IconAction {
        width: 44px;
        height: 48px;
        // Pushed right so the caret sits clear to its left.
        x: parent.width - self.width;
        icon: root.icon;
        label: root.label;
        active: root.active;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    // Selector caret, its own tap target, to the left of the circle.
    caret := Rectangle {
        width: 16px;
        height: 26px;
        x: 0;
        y: (parent.height - self.height) / 2;
        border-radius: 8px;
        background: ctouch.pressed ? Materials.pressed : Colors.fill-secondary;
        border-width: key.has-focus ? 2px : 0px;
        border-color: Colors.focus-ring;
        accessible-role: button;
        accessible-label: root.select-label;
        accessible-action-default => { root.select(); }
        key := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return {
                    root.select();
                    return accept;
                }
                return reject;
            }
        }
        Image {
            source: Icons.chevron-left;
            transform-rotation: 90deg;
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.text-primary;
        }
        ctouch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.select(); }
        }
    }
}

export component CallControls inherits GlassSurface {
    material-level: 3;
    elevation: 3;
    border-radius: Spacing.radius-lg;
    property <float> arrival: 0;
    init => { root.arrival = 1; }
    opacity: arrival;
    transform-scale-x: 90% + arrival * 10%;
    transform-scale-y: 82% + arrival * 18%;
    animate arrival { duration: Materials.motion-standard; easing: Materials.spring; }

    in property <bool> is-connected: false;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <bool> is-video-call: true;
    // Camera-lens swap (front/back). Only mobile has a second facing, so the
    // parent gates this on the platform + the camera being on.
    in property <bool> show-camera-swap: false;
    // Phones show linked microphone/output routes; desktop shows independent devices.
    // `speaker-on` reflects the communication route acknowledged by Android.
    in property <bool> speaker-toggle: false;
    in property <bool> speaker-on: false;
    // Shared minimum target at both densities.
    in property <length> button-size: Spacing.button-height;

    callback toggle-mute();
    callback toggle-video();
    callback swap-camera();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-input();
    callback show-audio-output();
    callback toggle-speaker();

    height: 48px;
    HorizontalLayout {
        alignment: center;
        spacing: 0px;
        padding: 0px;
        // Microphone: body toggles mute, caret opens the input-device list.
        DeviceButton {
            icon: root.is-muted ? Icons.mic-off : Icons.mic;
            label: root.is-muted ? "Unmute microphone" : "Mute microphone";
            select-label: root.speaker-toggle ? "Select microphone, linked audio route" : "Select microphone";
            active: root.is-muted;
            clicked => { root.toggle-mute(); }
            select => { root.show-audio-input(); }
        }
        // Output: body toggles speaker (phone) or opens output list (desktop);
        // caret always opens the output-device list.
        DeviceButton {
            icon: Icons.volume-2;
            label: root.speaker-toggle ? "Toggle speaker" : "Select audio output";
            select-label: root.speaker-toggle ? "Select output, linked audio route" : "Select output";
            active: root.speaker-toggle && root.speaker-on;
            clicked => {
                if root.speaker-toggle { root.toggle-speaker(); }
                else { root.show-audio-output(); }
            }
            select => { root.show-audio-output(); }
        }

        // Video toggle — always available so the user can turn the camera on
        // mid-call, even on a call that started as voice-only. Camera off is
        // the neutral state; teal means it is on.
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            enabled: root.is-connected;
            icon: root.is-video-enabled ? Icons.video : Icons.video-off;
            label: root.is-video-enabled ? "Turn camera off" : "Turn camera on";
            active: is-video-enabled;
            clicked => { toggle-video(); }
        }

        // Swap front/back camera. Mobile-only (desktop has one camera); shown
        // via `if` so it reserves no row space on desktop.
        if root.show-camera-swap: IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            enabled: root.is-connected;
            icon: Icons.rotate-ccw;
            label: "Switch camera";
            clicked => { swap-camera(); }
        }

        // Screen share toggle (system consent is requested on Android).
        IconAction {
            size: button-size;
            width: 44px;
            height: 48px;
            enabled: root.is-connected || root.is-screen-sharing;
            icon: Icons.monitor;
            label: root.is-screen-sharing ? "Stop sharing screen" : "Share screen";
            active: is-screen-sharing;
            clicked => { toggle-screen-share(); }
        }

        IconAction {
            size: root.button-size;
            width: 44px;
            height: 48px;
            icon: Icons.phone-off;
            label: "End call";
            destructive: true;
            clicked => { root.end-call(); }
        }
    }
}
