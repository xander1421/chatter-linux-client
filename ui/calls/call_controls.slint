// Call control bar with mute, video, screen share, and end call buttons
// Neo 2.0 styled — raised buttons with glow on active states

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";

component ControlButton inherits Rectangle {
    in property <image> icon;
    in property <image> icon-active;
    in property <bool> active: false;

    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    // Active (muted / camera-off / sharing) uses the brand teal, NOT red —
    // red is reserved for the end-call button alone. The icon flips
    // (mic → mic-off) so the specific state is still legible.
    background: {
        if active {
            touch.has-hover ? Colors.primary-hover : Colors.primary
        } else {
            touch.has-hover ? Colors.surface-hover : Colors.surface
        }
    };
    border-width: 1px;
    border-color: {
        if active {
            transparent
        } else {
            touch.has-hover ? Colors.neo-highlight-strong : Colors.neo-highlight
        }
    };
    drop-shadow-blur: touch.has-hover ? Spacing.neo-blur-md : Spacing.neo-blur-sm;
    drop-shadow-offset-x: Spacing.neo-offset-sm;
    drop-shadow-offset-y: Spacing.neo-offset-sm;
    drop-shadow-color: active ? Colors.primary.with-alpha(0.3) : Colors.neo-shadow;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: active ? icon-active : icon;
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Colors.text-primary;
    }
}

export component CallControls inherits Rectangle {
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <bool> is-video-call: true;

    callback toggle-mute();
    callback toggle-video();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-settings();
    callback show-audio-output-settings();

    height: 36px;
    background: Colors.surface;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-x: Spacing.neo-offset-md;
    drop-shadow-offset-y: Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    HorizontalLayout {
        alignment: center;
        spacing: Spacing.sm;
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: (root.height - 34px) / 2;
        padding-bottom: (root.height - 34px) / 2;

        // Audio settings button (device picker)
        ControlButton {
            icon: Icons.settings;
            icon-active: Icons.settings;
            active: false;
            clicked => { show-audio-settings(); }
        }

        // Speaker / headphones picker (audio output device)
        ControlButton {
            icon: Icons.volume-2;
            icon-active: Icons.volume-2;
            active: false;
            clicked => { show-audio-output-settings(); }
        }

        // Mute button
        ControlButton {
            icon: Icons.mic;
            icon-active: Icons.mic-off;
            active: is-muted;
            clicked => { toggle-mute(); }
        }

        // Video toggle — always available so the user can turn the camera on
        // mid-call, even on a call that started as voice-only.
        ControlButton {
            icon: Icons.video;
            icon-active: Icons.video-off;
            active: !is-video-enabled;
            clicked => { toggle-video(); }
        }

        // Screen share toggle
        ControlButton {
            icon: Icons.monitor;
            icon-active: Icons.monitor;
            active: is-screen-sharing;
            clicked => { toggle-screen-share(); }
        }

        // Spacer
        Rectangle {
            width: Spacing.sm;
            background: transparent;
        }

        // End call button (larger, always red) — Neo glow
        Rectangle {
            width: 40px;
            height: 34px;
            border-radius: 17px;
            background: end-touch.has-hover ? Colors.error-hover : Colors.error;
            drop-shadow-blur: end-touch.has-hover ? Spacing.neo-blur-md : Spacing.neo-blur-sm;
            drop-shadow-offset-x: Spacing.neo-offset-sm;
            drop-shadow-offset-y: Spacing.neo-offset-sm;
            drop-shadow-color: Colors.error.with-alpha(0.4);

            end-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { end-call(); }
            }

            Image {
                source: Icons.phone-off;
                width: 17px;
                height: 17px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-primary;
            }
        }
    }
}
