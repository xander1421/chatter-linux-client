import { Button } from "../components/button.slint";
import { IconAction } from "../components/icon_action.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Call control bar with mute, video, screen share, and end call buttons
// Shared flat icon actions inside one glass control group.

import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";

export component CallControls inherits GlassSurface {
    material-level: 3;
    elevation: 3;
    border-radius: Spacing.radius-lg;
    property <float> arrival: 0;
    init => { root.arrival = 1; }
    opacity: arrival;
    transform-scale-x: 90% + arrival * 10%;
    transform-scale-y: 82% + arrival * 18%;
    animate arrival { duration: Materials.motion-standard; easing: Materials.spring; }

    in property <bool> is-connected: false;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <bool> is-video-call: true;
    // Phones show linked microphone/output routes; desktop shows independent devices.
    // `speaker-on` reflects the communication route acknowledged by Android.
    in property <bool> speaker-toggle: false;
    in property <bool> speaker-on: false;
    // Shared minimum target at both densities.
    in property <length> button-size: Spacing.button-height;

    callback toggle-mute();
    callback toggle-video();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-settings();
    callback toggle-speaker();

    height: max(Spacing.button-height, button-size) * 2 + Spacing.sm;

    VerticalLayout {
        padding-top: Spacing.xs;
        padding-bottom: Spacing.xs;
        HorizontalLayout {
            alignment: center;
            Button {
                text: "Audio devices";
                label: root.speaker-toggle ? "Audio devices, microphone and output linked" : "Audio devices";
                variant: "ghost";
                touch: root.speaker-toggle;
                height: root.button-size;
                clicked => { root.show-audio-settings(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: root.speaker-toggle ? Spacing.xs : Spacing.sm;
            padding-left: root.speaker-toggle ? Spacing.xs : Spacing.md;
            padding-right: root.speaker-toggle ? Spacing.xs : Spacing.md;
            height: root.button-size;
            padding-top: 0px;
            padding-bottom: 0px;

            // Mute button
            IconAction {
                size: button-size;
                icon: root.is-muted ? Icons.mic-off : Icons.mic;
                label: root.is-muted ? "Unmute microphone" : "Mute microphone";
                active: is-muted;
                clicked => { toggle-mute(); }
            }

            // Video toggle — always available so the user can turn the camera on
            // mid-call, even on a call that started as voice-only. Camera off is
            // the neutral state; teal means it is on.
            IconAction {
                size: button-size;
                enabled: root.is-connected;
                icon: root.is-video-enabled ? Icons.video : Icons.video-off;
                label: root.is-video-enabled ? "Turn camera off" : "Turn camera on";
                active: is-video-enabled;
                clicked => { toggle-video(); }
            }

            // Screen share toggle (system consent is requested on Android).
            IconAction {
                size: button-size;
                enabled: root.is-connected || root.is-screen-sharing;
                icon: Icons.monitor;
                label: root.is-screen-sharing ? "Stop sharing screen" : "Share screen";
                active: is-screen-sharing;
                clicked => { toggle-screen-share(); }
            }

            // Spacer
            if !root.speaker-toggle: Rectangle {
                width: Spacing.sm;
                background: transparent;
            }

            IconAction {
                size: root.button-size;
                icon: Icons.phone-off;
                label: "End call";
                destructive: true;
                clicked => { root.end-call(); }
            }
        }

    }
}
