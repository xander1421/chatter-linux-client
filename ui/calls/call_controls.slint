import { IconAction } from "../components/icon_action.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Call control bar with mute, video, screen share, and end call buttons
// Shared flat icon actions inside one glass control group.

import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";

export component CallControls inherits GlassSurface {
    material-level: 3;
    elevation: 3;
    border-radius: self.height / 2;

    in property <bool> is-connected: false;
    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <bool> is-video-call: true;
    // Phones: the speaker button toggles the call route (earpiece/headset vs
    // loudspeaker) and `speaker-on` is the route actually applied. Desktop
    // leaves it false and the button opens the output device picker.
    in property <bool> speaker-toggle: false;
    in property <bool> speaker-on: false;
    // Shared minimum target at both densities.
    in property <length> button-size: Spacing.button-height;

    callback toggle-mute();
    callback toggle-video();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-settings();
    callback show-audio-output-settings();
    callback toggle-speaker();

    height: max(Spacing.button-height, button-size) + Spacing.sm;

    HorizontalLayout {
        alignment: center;
        spacing: Spacing.sm;
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: (root.height - button-size) / 2;
        padding-bottom: (root.height - button-size) / 2;

        // Audio settings button (device picker). Not on phones
        // (`speaker-toggle`): one mic, and the route is the speaker button.
        if !root.speaker-toggle: IconAction {
            size: button-size;
            icon: Icons.settings;
            label: "Audio input settings";
            active: false;
            clicked => { show-audio-settings(); }
        }

        // Speaker: route toggle on phones, output device picker on desktop
        IconAction {
            size: button-size;
            icon: Icons.volume-2;
            label: root.speaker-toggle ? "Toggle speaker" : "Audio output settings";
            active: root.speaker-toggle && root.speaker-on;
            clicked => {
                if root.speaker-toggle {
                    root.toggle-speaker();
                } else {
                    root.show-audio-output-settings();
                }
            }
        }

        // Mute button
        IconAction {
            size: button-size;
            icon: root.is-muted ? Icons.mic-off : Icons.mic;
            label: root.is-muted ? "Unmute microphone" : "Mute microphone";
            active: is-muted;
            clicked => { toggle-mute(); }
        }

        // Video toggle — always available so the user can turn the camera on
        // mid-call, even on a call that started as voice-only. Camera off is
        // the neutral state; teal means it is on.
        IconAction {
            size: button-size;
            enabled: root.is-connected;
            icon: root.is-video-enabled ? Icons.video : Icons.video-off;
            label: root.is-video-enabled ? "Turn camera off" : "Turn camera on";
            active: is-video-enabled;
            clicked => { toggle-video(); }
        }

        // Screen share toggle — desktop only; phones cannot share a screen.
        if !root.speaker-toggle: IconAction {
            size: button-size;
            icon: Icons.monitor;
            label: root.is-screen-sharing ? "Stop sharing screen" : "Share screen";
            active: is-screen-sharing;
            clicked => { toggle-screen-share(); }
        }

        // Spacer
        Rectangle {
            width: Spacing.sm;
            background: transparent;
        }

        IconAction {
            size: root.button-size;
            icon: Icons.phone-off;
            label: "End call";
            destructive: true;
            clicked => { root.end-call(); }
        }
    }
}
