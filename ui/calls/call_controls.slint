import { GlassSurface } from "../components/glass_surface.slint";
// Call control bar with mute, video, screen share, and end call buttons
// Neo 2.0 styled — raised buttons with glow on active states

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";

component ControlButton inherits Rectangle {
    in property <image> icon;
    in property <image> icon-active;
    in property <bool> active: false;
    in property <length> size: 34px;

    callback clicked();

    width: size;
    height: size;
    border-radius: size / 2;
    // Active (muted / camera on / speaker on / sharing) uses the brand teal,
    // NOT red — red is reserved for the end-call button alone. Teal marks a
    // state the user switched on, never a default one. The icon flips
    // (mic → mic-off) so the specific state is still legible.
    background: {
        if active {
            touch.has-hover ? Colors.primary-hover : Colors.primary
        } else {
            touch.has-hover ? Colors.surface-hover : Colors.surface
        }
    };





    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: active ? icon-active : icon;
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Colors.text-primary;
    }
}

export component CallControls inherits GlassSurface {
    material-level: 3;
    elevation: 2;
    border-radius: self.height / 2;

    in property <bool> is-muted: false;
    in property <bool> is-video-enabled: true;
    in property <bool> is-screen-sharing: false;
    in property <bool> is-video-call: true;
    // Phones: the speaker button toggles the call route (earpiece/headset vs
    // loudspeaker) and `speaker-on` is the route actually applied. Desktop
    // leaves it false and the button opens the output device picker.
    in property <bool> speaker-toggle: false;
    in property <bool> speaker-on: false;
    // 34px suits a mouse; a touch screen needs the 48dp minimum target.
    in property <length> button-size: 34px;

    callback toggle-mute();
    callback toggle-video();
    callback toggle-screen-share();
    callback end-call();
    callback show-audio-settings();
    callback show-audio-output-settings();
    callback toggle-speaker();

    height: button-size + 6px;

    HorizontalLayout {
        alignment: center;
        spacing: Spacing.sm;
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: (root.height - button-size) / 2;
        padding-bottom: (root.height - button-size) / 2;

        // Audio settings button (device picker). Not on phones
        // (`speaker-toggle`): one mic, and the route is the speaker button.
        if !root.speaker-toggle: ControlButton {
            size: button-size;
            icon: Icons.settings;
            icon-active: Icons.settings;
            active: false;
            clicked => { show-audio-settings(); }
        }

        // Speaker: route toggle on phones, output device picker on desktop
        ControlButton {
            size: button-size;
            icon: Icons.volume-2;
            icon-active: Icons.volume-2;
            active: root.speaker-toggle && root.speaker-on;
            clicked => {
                if root.speaker-toggle {
                    root.toggle-speaker();
                } else {
                    root.show-audio-output-settings();
                }
            }
        }

        // Mute button
        ControlButton {
            size: button-size;
            icon: Icons.mic;
            icon-active: Icons.mic-off;
            active: is-muted;
            clicked => { toggle-mute(); }
        }

        // Video toggle — always available so the user can turn the camera on
        // mid-call, even on a call that started as voice-only. Camera off is
        // the neutral state; teal means it is on.
        ControlButton {
            size: button-size;
            icon: Icons.video-off;
            icon-active: Icons.video;
            active: is-video-enabled;
            clicked => { toggle-video(); }
        }

        // Screen share toggle — desktop only; phones cannot share a screen.
        if !root.speaker-toggle: ControlButton {
            size: button-size;
            icon: Icons.monitor;
            icon-active: Icons.monitor;
            active: is-screen-sharing;
            clicked => { toggle-screen-share(); }
        }

        // Spacer
        Rectangle {
            width: Spacing.sm;
            background: transparent;
        }

        // End call button (larger, always red) — Neo glow
        Rectangle {
            width: button-size + 8px;
            height: button-size;
            border-radius: button-size / 2;
            background: end-touch.has-hover ? Colors.error-hover : Colors.error;





            end-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { end-call(); }
            }

            Image {
                source: Icons.phone-off;
                width: 17px;
                height: 17px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-primary;
            }
        }
    }
}
