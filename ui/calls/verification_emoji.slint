// Bitmap glyphs extracted from our bundled Noto Color Emoji font.
// Keep call verification artwork identical on CoreText and FreeType platforms.
import { Typography } from "../theme/typography.slint";

export component VerificationEmoji inherits Image {
    in property <string> emoji;
    width: Typography.lg;
    height: Typography.lg;
    image-fit: contain;
    source: root.artwork(root.emoji);
    pure function artwork(value: string) -> image {
