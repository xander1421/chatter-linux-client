// Virtualized message list component
//
// Displays a scrollable list of messages with loading and empty states.
// Features: animated scrolling, scroll-to-bottom button, auto-scroll on new messages.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Skeleton } from "../components/skeleton.slint";
import { MessageItem } from "message_item.slint";
import { MessageAttachmentData, MessageItemData, ReactionEntry } from "types.slint";

// Re-export types for parent components
export { MessageAttachmentData, MessageItemData, ReactionEntry }

export component MessageList inherits Rectangle {
    // Properties
    in property <[MessageItemData]> messages: [];
    in property <bool> loading: false;
    in property <bool> is-dm: false;  // When true, messages show minimal UI (no avatars/names in DMs)
    in-out property <length> scroll-position: 0;
    in property <int> scroll-to-index: -1;  // Set to message index to scroll to it
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;
    in property <float> audio-progress: 0.0;
    in property <string> audio-elapsed: "0:00";

    // Scroll state - exposed for parent to detect and control auto-scroll
    out property <bool> is-at-bottom: true;
    in property <bool> should-auto-scroll: true;  // Enable/disable auto-scroll behavior

    // Internal animated scroll target
    property <length> scroll-target: 0px;
    property <bool> animating: false;

    // Callbacks - Signal-style identification (sender_id, timestamp_ns)
    callback message-clicked(string);
    callback reply-clicked(string, string);  // (sender_id, timestamp_ns)
    callback react-clicked(string, string);  // (sender_id, timestamp_ns)
    callback thread-clicked(string);
    callback more-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback load-more();
    callback attachment-clicked(string);  // attachment ID
    callback audio-seek(string, float);  // attachment ID, position 0.0-1.0
    callback scroll-to-bottom-clicked();  // Emitted when scroll-to-bottom button clicked

    // Layout - explicit width ensures text wrapping in message items
    // Width flows: root → Flickable → messages-layout → MessageItem → Text
    background: Colors.background;

    // Loading state: skeleton placeholders
    if root.loading: VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.lg;

        for _ in [1, 2, 3, 4, 5]: HorizontalLayout {
            spacing: Spacing.sm;

            // Avatar skeleton
            Skeleton {
                width: Spacing.avatar-sm;
                height: Spacing.avatar-sm;
                border-radius: Spacing.avatar-sm / 2;
            }

            // Content skeleton
            VerticalLayout {
                spacing: Spacing.xs;

                // Name and timestamp
                HorizontalLayout {
                    spacing: Spacing.sm;

                    Skeleton {
                        width: 80px;
                        height: 14px;
                        border-radius: 4px;
                    }

                    Skeleton {
                        width: 40px;
                        height: 12px;
                        border-radius: 4px;
                    }
                }

                // Message content (2 lines)
                Skeleton {
                    width: 200px;
                    height: 14px;
                    border-radius: 4px;
                }

                Skeleton {
                    width: 150px;
                    height: 14px;
                    border-radius: 4px;
                }
            }
        }
    }

    // Empty state
    if !root.loading && root.messages.length == 0: Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: Spacing.md;

            Text {
                text: "\u{1F4AC}\u{FE0F}"; // Speech bubbles emoji (with emoji variant selector)
                font-size: 48px;
                horizontal-alignment: center;
            }

            Text {
                text: "No messages yet";
                color: Colors.text-secondary;
                font-size: Typography.lg;
                horizontal-alignment: center;
            }

            Text {
                text: "Be the first to say something!";
                color: Colors.text-muted;
                font-size: Typography.sm;
                horizontal-alignment: center;
            }

            // Encryption indicator in empty state
            Rectangle {
                height: Spacing.lg;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                Image {
                    source: Icons.lock;
                    width: 14px;
                    height: 14px;
                    colorize: Colors.success;
                    vertical-alignment: center;
                }

                Text {
                    text: "Messages are end-to-end encrypted";
                    color: Colors.success;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Message list with animated scrolling
    if !root.loading && root.messages.length > 0: Rectangle {
        width: 100%;
        height: 100%;

        flickable := Flickable {
            // Explicit width constraints for proper text wrapping
            width: 100%;
            height: 100%;
            // Constrain horizontal viewport to prevent content from expanding beyond visible width
            viewport-width: self.width;
            viewport-height: messages-layout.preferred-height;
            viewport-y <=> root.scroll-position;

            // Animate scroll position for smooth scrolling
            animate viewport-y {
                duration: 300ms;
                easing: ease-out;
            }

            // Update is-at-bottom when scroll position changes
            changed viewport-y => {
                // Calculate if we're at bottom (within 50px threshold)
                // viewport-y is negative, so at bottom means:
                // viewport-y >= -(viewport-height - self.height)
                // Rearranged: viewport-height + viewport-y <= self.height + threshold
                root.is-at-bottom = (self.viewport-height + self.viewport-y) <= (self.height + 50px);
            }

            messages-layout := VerticalLayout {
            // Explicit width from parent for proper text wrapping
            width: parent.width;
            padding: Spacing.md;
            spacing: 2px;

            // Load more trigger at top (for infinite scroll)
            Rectangle {
                height: Spacing.lg;

                load-trigger := TouchArea {
                    // This area triggers load-more when scrolled to top
                    // In practice, you'd detect scroll position
                }
            }

            for item in root.messages: VerticalLayout {
                width: parent.width - Spacing.md * 2;
                spacing: 2px;

                // Date separator bar
                if item.show-date-separator: HorizontalLayout {
                    width: 100%;
                    height: 32px;
                    spacing: Spacing.md;
                    alignment: center;
                    padding-top: Spacing.sm;
                    padding-bottom: Spacing.sm;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: Colors.surface-hover;
                    }

                    Text {
                        text: item.date-separator-text;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: Colors.surface-hover;
                    }
                }

            MessageItem {
                width: 100%;
                message-id: item.message-id;
                sender-id: item.sender-id;
                timestamp-ns: item.timestamp-ns;
                sender-name: item.sender-name;
                sender-initials: item.sender-initials;
                sender-avatar-url: item.sender-avatar-url;
                sender-avatar-source: item.sender-avatar-source;
                has-avatar: item.has-avatar;
                content: item.content;
                rich-content: item.rich-content;
                timestamp: item.timestamp;
                is-own: item.is-own;
                is-edited: item.is-edited;
                is-pinned: item.is-pinned;
                is-deleted: item.is-deleted;
                is-system: item.is-system;
                is-ai: item.is-ai;
                is-dm: root.is-dm;
                is-call: item.is-call;
                call-type: item.call-type;
                call-duration: item.call-duration;
                has-attachments: item.has-attachments;
                attachment-count: item.attachment-count;
                attachments: item.attachments;
                current-playing-attachment-id: root.current-playing-attachment-id;
                is-media-playing: root.is-media-playing;
                audio-progress: root.audio-progress;
                audio-elapsed: root.audio-elapsed;
                has-reactions: item.has-reactions;
                reaction-summary: item.reaction-summary;
                reactions: item.reactions;
                reply-count: item.reply-count;
                reply-count-text: item.reply-count-text;
                is-thread-reply: item.is-thread-reply;
                is-reply: item.is-reply;
                reply-to-sender-name: item.reply-to-sender-name;
                reply-to-preview: item.reply-to-preview;
                show-sender: item.show-sender;
                delivery-status: item.delivery-status;
                is-continuation: item.is-continuation;

                message-clicked(id) => {
                    root.message-clicked(id);
                }

                reply-clicked(sender-id, timestamp-ns) => {
                    root.reply-clicked(sender-id, timestamp-ns);
                }

                react-clicked(sender-id, timestamp-ns) => {
                    root.react-clicked(sender-id, timestamp-ns);
                }

                thread-clicked(id) => {
                    root.thread-clicked(id);
                }

                more-clicked(sender-id, timestamp-ns, x, y) => {
                    root.more-clicked(sender-id, timestamp-ns, x, y);
                }

                attachment-clicked(id) => {
                    root.attachment-clicked(id);
                }

                audio-seek(id, pos) => {
                    root.audio-seek(id, pos);
                }
            }
            } // end VerticalLayout wrapper (date separator + message)
        }
        }

        // Scroll-to-bottom floating button
        // Appears when user has scrolled up from the bottom
        if !root.is-at-bottom: Rectangle {
            x: root.width - 60px;
            y: root.height - 60px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: Colors.primary;
            accessible-role: button;
            accessible-label: "Scroll to bottom";
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Colors.shadow;

            // Fade in animation
            opacity: 1.0;
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }

            // Down arrow icon
            Text {
                text: "↓";
                color: Colors.text-primary;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            scroll-btn := TouchArea {
                clicked => {
                    // Scroll to bottom: viewport-y = -(viewport-height - visible-height)
                    root.scroll-position = -(flickable.viewport-height - flickable.height);
                    root.is-at-bottom = true;
                    root.scroll-to-bottom-clicked();
                }
            }

            // Hover effect
            states [
                hover when scroll-btn.has-hover: {
                    background: Colors.primary-hover;
                }
            ]
        }
    }
}
