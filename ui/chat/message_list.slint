// Virtualized message list component
//
// Displays a scrollable list of messages with loading and empty states.
// Only the rows that fit on screen exist at any time (see the list below);
// features: scroll-to-bottom / "N new messages" pill, open on the unread
// divider, auto-follow of new messages, older history on reaching the top.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Skeleton } from "../components/skeleton.slint";
import { MessageItem } from "message_item.slint";
import { MessageAttachmentData, MessageItemData, ReactionEntry } from "types.slint";

// Re-export types for parent components
export { MessageAttachmentData, MessageItemData, ReactionEntry }

// The bare Flickable with Slint's lazy row runtime enabled. The compiler turns
// a `for` into a virtualized one when its parent element is named `ListView`
// and carries these length properties (i-slint-compiler object_tree.rs,
// "Custom ListView is OK"); defining it here rather than importing the
// std-widgets one keeps out the ScrollView chrome and its scrollbars.
component ListView inherits Flickable {
    out property <length> visible-height: self.height;
    out property <length> visible-width: self.width;
    @children
}

export component MessageList inherits Rectangle {
    // Properties
    in property <[MessageItemData]> messages: [];
    in property <bool> loading: false;
    /// Every message here rode the mesh, so delivery is reported in words
    /// rather than ticks.
    in property <bool> is-mesh: false;
    /// Anything said here goes out in the clear to whoever is listening — the
    /// mesh room and geohash cells. Mesh DMs are not: those run over Noise.
    in property <bool> public-broadcast: false;
    /// The one sentence the empty state makes about privacy. Set by the caller
    /// so this component never has to know what a geohash cell is.
    in property <string> privacy-line: "Messages are end-to-end encrypted";
    in property <bool> is-dm: false;  // When true, messages show minimal UI (no avatars/names in DMs)
    in property <bool> can-thread: true;
    // No longer the list's viewport: a binding on `viewport-y` disables both
    // clamps that keep a short conversation from opening pushed down from the
    // top (the ListView runtime's and the Flickable's own — each checks
    // `has_binding` first). Kept declared only because chat_layout / app /
    // main still alias it; nothing reads or writes it any more.
    in-out property <length> scroll-position: 0;
    in property <int> scroll-to-index: -1;  // Set to message index to scroll to it
    in property <string> highlighted-message-id: "";  // Message id to briefly flash (quote jump)
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;
    in property <float> audio-progress: 0.0;
    in property <string> audio-elapsed: "0:00";

    // Scroll state - exposed for parent to detect and control auto-scroll.
    // in-out, not out: opening a conversation has to be able to reset it. When
    // it was write-only-upward, a list left scrolled up in one conversation
    // stayed "not at bottom" in the next one, and the next one opened wherever
    // the previous scroll happened to leave the viewport.
    in-out property <bool> is-at-bottom: true;
    in property <bool> should-auto-scroll: true;  // Enable/disable auto-scroll behavior

    // ── Where this conversation opens ────────────────────────────────────────
    // Row index of the first unread message, decided by core
    // (`UnreadAnchor::divider_index`, captured before the open marks everything
    // read). -1 = nothing unread, open at the newest message. in-out because
    // tapping the "N new messages" pill consumes the anchor.
    in-out property <int> unread-index: -1;
    // Unread total behind that boundary — the pill's number. May exceed the
    // loaded page.
    in-out property <int> unread-count: 0;

    // Every conversation open raises `loading` before it installs a model, and
    // only the server-backed opens then supply an anchor. Clearing on that one
    // edge is what stops a mesh room or the AI channel from inheriting the
    // previous DM's divider and opening three rows from the top.
    changed loading => {
        if (root.loading) {
            root.unread-index = -1;
            root.unread-count = 0;
            root.end-pending = false;
            root.jump-row = -1;
            // Root state, so it outlives the list: left true from a previous
            // conversation, it would drag the next one to its end on the
            // first layout pass, over its unread divider.
            root.at-end = false;
            root.load-more-armed = true;
        }
    }

    // ── Navigation targets ──────────────────────────────────────────────────
    // Row positions are the runtime's estimates until a row is live, so a
    // target is re-issued over a few layout passes (bounded) until it holds.
    private property <bool> end-pending: false;
    private property <int> end-passes: 0;
    // Sitting exactly on the newest message, as of the last layout pass.
    private property <bool> at-end: false;
    // Row to land at the top edge, until the list has an estimate to seek by.
    private property <int> jump-row: -1;
    // Older history is requested once per approach to the top.
    private property <bool> load-more-armed: true;
    // A mirror `changed` can watch: a message arriving, or a page of history.
    property <int> row-count: root.messages.length;
    changed row-count => {
        root.load-more-armed = true;
        if (root.is-at-bottom && root.should-auto-scroll && root.jump-row < 0) {
            root.go-to-end();
        }
    }

    // The list lives under `!loading`, out of reach of root functions, so a
    // target is recorded here and the list pursues it on `changed nav-serial`.
    private property <int> nav-serial: 0;

    // Newest message flush with the bottom edge, and stay there.
    function go-to-end() {
        root.jump-row = -1;
        root.end-pending = true;
        root.end-passes = 0;
        root.nav-serial += 1;
    }

    // Row `i` at the top edge.
    function go-to-row(i: int) {
        root.end-pending = false;
        root.jump-row = i;
        root.nav-serial += 1;
    }

    // Callbacks - Signal-style identification (sender_id, timestamp_ns)
    // Multi-select: while on, a plain tap toggles selection instead of opening
    // the message, and each bubble renders its `selected` flag.
    in property <bool> selection-mode: false;
    // Touch platform — gates the press-and-hold gesture so a desktop
    // left-button hold does not open the message menu.
    in property <bool> mobile: false;
    callback selection-toggled(string);
    callback message-clicked(string);
    callback reply-clicked(string, string);  // (sender_id, timestamp_ns)
    callback react-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback reaction-toggled(string, string, string);  // (sender_id, timestamp_ns, emoji)
    callback thread-clicked(string);
    callback more-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback quote-clicked(string);  // (reply-to-message-id) — jump to quoted original
    callback load-more();
    callback attachment-clicked(string);  // attachment ID
    callback audio-seek(string, float);  // attachment ID, position 0.0-1.0
    callback scroll-to-bottom-clicked();  // Emitted when scroll-to-bottom button clicked

    // Layout — flat background to avoid neomorphic fatigue in scrolling content.
    // The messages themselves carry the depth; the list stays neutral.
    background: Colors.background;

    // Loading state: skeleton placeholders
    if root.loading: VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.lg;

        for _ in [1, 2, 3, 4, 5]: HorizontalLayout {
            spacing: Spacing.sm;

            // Avatar skeleton
            Skeleton {
                width: Spacing.avatar-sm;
                height: Spacing.avatar-sm;
                border-radius: Spacing.avatar-sm / 2;
            }

            // Content skeleton
            VerticalLayout {
                spacing: Spacing.xs;

                // Name and timestamp
                HorizontalLayout {
                    spacing: Spacing.sm;

                    Skeleton {
                        width: 80px;
                        height: 14px;
                        border-radius: 4px;
                    }

                    Skeleton {
                        width: 40px;
                        height: 12px;
                        border-radius: 4px;
                    }
                }

                // Message content (2 lines)
                Skeleton {
                    width: 200px;
                    height: 14px;
                    border-radius: 4px;
                }

                Skeleton {
                    width: 150px;
                    height: 14px;
                    border-radius: 4px;
                }
            }
        }
    }

    // Empty state
    if !root.loading && root.messages.length == 0: Rectangle {
        VerticalLayout {
            alignment: center;
            spacing: Spacing.md;

            Text {
                text: "\u{1F4AC}\u{FE0F}"; // Speech bubbles emoji (with emoji variant selector)
                font-family: Typography.font-family-emoji;
                font-size: Typography.huge;
                horizontal-alignment: center;
            }

            Text {
                text: "No messages yet";
                color: Colors.text-secondary;
                font-size: Typography.lg;
                horizontal-alignment: center;
            }

            Text {
                text: "Be the first to say something!";
                color: Colors.text-muted;
                font-size: Typography.sm;
                horizontal-alignment: center;
            }

            // Encryption indicator in empty state
            Rectangle {
                height: Spacing.lg;
            }

            // What is true about this conversation's privacy, which is not the
            // same sentence everywhere. A mesh room and a geohash cell are
            // plaintext broadcasts with no recipient to be encrypted *to*;
            // saying otherwise here, in green, under a lock, is the one error on
            // this screen that could get somebody hurt.
            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                Image {
                    source: root.public-broadcast ? Icons.globe : Icons.lock;
                    width: 14px;
                    height: 14px;
                    colorize: root.public-broadcast ? Colors.warning : Colors.success;
                    vertical-alignment: center;
                }

                Text {
                    text: root.privacy-line;
                    color: root.public-broadcast ? Colors.warning : Colors.success;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── The list ─────────────────────────────────────────────────────────────
    // Rows exist only while they fit the viewport: the Slint runtime creates
    // and destroys them as the user scrolls, measures each one for real, and
    // estimates the total height from their average. Two consequences:
    //   - `viewport-y` is a scrollbar-grade estimate, rewritten by the runtime
    //     after every layout pass. Nothing here animates it — the next pass
    //     would cancel the animation anyway — and every navigation is a target
    //     the runtime is asked to refine (`go-to-end`, `go-to-row`), not a
    //     pixel offset. Those passes all run inside one frame's instantiation
    //     loop, so an open is drawn already sitting on the newest message or
    //     the unread divider.
    //   - rows inserted above the first live row shift its index without
    //     moving anything on screen, which is what lets older history load at
    //     the top without a jump.
    if !root.loading && root.messages.length > 0: Rectangle {
        width: 100%;
        height: 100%;

        list := ListView {
            width: 100%;
            height: 100%;

            // How far the content extends below the bottom edge. Exact once the
            // last row is live (the runtime's estimate then closes on the real
            // bottom edge), and at least one average row while any row is
            // still below — so "at bottom" cannot be claimed early.
            pure function bottom-gap() -> length {
                return self.viewport-height + self.viewport-y - self.height;
            }

            function update-at-bottom() {
                root.is-at-bottom = self.bottom-gap() <= 50px;
                // Reaching the newest message is what "caught up" means; the
                // pill must stop claiming N new messages after that, including
                // when the user scrolls back up later in the same session.
                if (root.is-at-bottom) {
                    root.unread-count = 0;
                }
            }

            function seek-end() {
                self.viewport-y = self.height - self.viewport-height;
            }

            // True once the runtime has written its first estimate. Before
            // that `viewport-height` still holds the Flickable default (the
            // list's own height), and a row seek computed from it lands on
            // row 0.
            property <bool> measured: false;

            // Carry out whatever root just recorded.
            property <int> nav: root.nav-serial;
            changed nav => {
                self.pursue();
            }
            function pursue() {
                if (root.end-pending) {
                    self.seek-end();
                } else if (root.jump-row >= 0) {
                    self.seek-row(root.jump-row);
                }
            }

            // Land row `i` at the top edge. The runtime seeks by its average
            // row height: more than 1.5 screens from the live rows (every
            // open, since a fresh list has measured one row) it places row
            // `i` at exactly y = 0; nearer, it walks measured rows from the
            // current anchor, and the row lands within about a row of the
            // top — the highlight flash pins which one it is. Needs an
            // estimate to seek by, so before the first layout this waits.
            function seek-row(i: int) {
                if (root.messages.length > 0 && self.measured) {
                    // 1px past the row's estimated top so the runtime's
                    // floor() picks `i`, not `i - 1`.
                    self.viewport-y = -(i * self.viewport-height / root.messages.length) - 1px;
                    root.jump-row = -1;
                }
            }

            // Every layout pass ends with the runtime rewriting viewport-y
            // and/or viewport-height; this is where pending targets are
            // re-issued until they hold, and where load-more fires.
            function settle() {
                // The runtime's "content shorter than the view" fix-up can
                // leave viewport-y positive (rows pushed down from the top,
                // blank above them); the Flickable's own clamp does not
                // always catch it. Rows start at the top edge, always.
                if (self.viewport-y > 0px) {
                    self.viewport-y = 0px;
                    return;
                }
                self.update-at-bottom();
                root.at-end = self.bottom-gap() <= 1px;
                if (root.end-pending) {
                    if (root.at-end || root.end-passes >= 6) {
                        root.end-pending = false;
                    } else {
                        root.end-passes += 1;
                        self.seek-end();
                    }
                } else if (root.jump-row >= 0) {
                    self.seek-row(root.jump-row);
                } else if (root.load-more-armed && self.viewport-y > -Spacing.xl * 4) {
                    // Near the true top (the estimate is exact once row 0 is
                    // live). Once per approach; re-armed when the model grows.
                    root.load-more-armed = false;
                    root.load-more();
                }
            }

            changed viewport-y => {
                self.settle();
            }
            // A content re-estimate (a row measured, a thumbnail grown) while
            // sitting exactly on the end keeps the end in place. A finger
            // moves viewport-y first, which clears `at-end` before any
            // re-estimate its scrolling causes — so this never fights a drag.
            changed viewport-height => {
                self.measured = true;
                if (root.at-end && !root.end-pending) {
                    self.seek-end();
                }
                self.settle();
            }

            // The view itself shrinking (soft keyboard opening) must keep the
            // newest message in sight too, not just content growing. Decided
            // on the pre-resize `is-at-bottom`, then settled against the new
            // height (which alone can change how far the end is).
            changed height => {
                if (root.is-at-bottom) {
                    root.go-to-end();
                }
                self.settle();
            }

            // Mirror the root properties locally so `changed` fires inside
            // list scope.
            property <int> open-index: root.unread-index;
            changed open-index => {
                if (self.open-index >= 0) {
                    root.go-to-row(self.open-index);
                }
            }

            // Jump-to-message (quote click, search result, pinned bar).
            property <int> jump-index: root.scroll-to-index;
            changed jump-index => {
                if (self.jump-index >= 0) {
                    root.go-to-row(self.jump-index);
                }
            }

            // The list is created fresh on every open (it lives under
            // `!loading`), before any row is laid out: record the intent and
            // let the first layout pass, inside this same frame, carry it out.
            init => {
                if (root.unread-index >= 0) {
                    root.go-to-row(root.unread-index);
                } else {
                    root.go-to-end();
                }
                self.pursue();
            }

            for item[idx] in root.messages: VerticalLayout {
                width: root.width;
                height: self.preferred-height;
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                padding-top: idx == 0 ? Spacing.md : 0px;
                // Extra bottom clearance under the last row so the
                // scroll-to-bottom FAB (44px, docked bottom-right) never
                // covers its corner.
                padding-bottom: idx == root.messages.length - 1
                    ? Spacing.md + 48px
                    : Spacing.message-gap;
                spacing: 2px;

                // Unread divider — everything below this line arrived while
                // the user was away.
                if idx == root.unread-index: HorizontalLayout {
                    width: 100%;
                    height: 32px;
                    spacing: Spacing.md;
                    alignment: center;
                    padding-top: Spacing.sm;
                    padding-bottom: Spacing.sm;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: Colors.primary;
                        opacity: 0.5;
                    }

                    Text {
                        text: "Unread messages";
                        color: Colors.primary;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: Colors.primary;
                        opacity: 0.5;
                    }
                }

                // Date separator: wherever core's day label changes from the
                // row above. Derived here from the neighbour rather than stored
                // per row, so no insert/prepend/delete path can leave it stale.
                if item.date-separator-text != ""
                    && (idx == 0 || root.messages[idx - 1].date-separator-text != item.date-separator-text): HorizontalLayout {
                    width: 100%;
                    height: 32px;
                    spacing: Spacing.md;
                    alignment: center;
                    padding-top: Spacing.sm;
                    padding-bottom: Spacing.sm;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: Colors.surface-hover;
                    }

                    Text {
                        text: item.date-separator-text;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: Colors.surface-hover;
                    }
                }

                MessageItem {
                    width: 100%;
                    message-id: item.message-id;
                    sender-id: item.sender-id;
                    timestamp-ns: item.timestamp-ns;
                    sender-name: item.sender-name;
                    sender-initials: item.sender-initials;
                    sender-avatar-source: item.sender-avatar-source;
                    has-avatar: item.has-avatar;
                    content: item.content;
                    rich-content: item.rich-content;
                    timestamp: item.timestamp;
                    is-own: item.is-own;
                    is-edited: item.is-edited;
                    is-pinned: item.is-pinned;
                    is-deleted: item.is-deleted;
                    is-system: item.is-system;
                    is-ai: item.is-ai;
                    is-dm: root.is-dm;
                    can-thread: root.can-thread;
                    is-mesh: root.is-mesh;
                    is-call: item.is-call;
                    call-type: item.call-type;
                    call-duration: item.call-duration;
                    has-attachments: item.has-attachments;
                    attachment-count: item.attachment-count;
                    attachments: item.attachments;
                    current-playing-attachment-id: root.current-playing-attachment-id;
                    is-media-playing: root.is-media-playing;
                    audio-progress: root.audio-progress;
                    audio-elapsed: root.audio-elapsed;
                    has-reactions: item.has-reactions;
                    reaction-summary: item.reaction-summary;
                    reactions: item.reactions;
                    reply-count: item.reply-count;
                    reply-count-text: item.reply-count-text;
                    is-thread-reply: item.is-thread-reply;
                    is-reply: item.is-reply;
                    reply-to-not-found: item.reply-to-not-found;
                    reply-to-message-id: item.reply-to-message-id;
                    highlighted: item.message-id == root.highlighted-message-id;
                    reply-to-sender-name: item.reply-to-sender-name;
                    reply-to-preview: item.reply-to-preview;
                    reply-to-category: item.reply-to-category;
                    reply-to-attachment-id: item.reply-to-attachment-id;
                    reply-to-duration: item.reply-to-duration;
                    reply-to-filename: item.reply-to-filename;
                    reply-to-waveform: item.reply-to-waveform;
                    reply-to-has-thumbnail: item.reply-to-has-thumbnail;
                    reply-to-thumbnail: item.reply-to-thumbnail;
                    reply-to-thumbnail-width: item.reply-to-thumbnail-width;
                    reply-to-thumbnail-height: item.reply-to-thumbnail-height;
                    show-sender: item.show-sender;
                    delivery-status: item.delivery-status;
                    is-continuation: item.is-continuation;
                    selected: item.selected;
                    selection-mode: root.selection-mode;
                    mobile: root.mobile;

                    selection-toggled(id) => {
                        root.selection-toggled(id);
                    }

                    message-clicked(id) => {
                        root.message-clicked(id);
                    }

                    reply-clicked(sender-id, timestamp-ns) => {
                        root.reply-clicked(sender-id, timestamp-ns);
                    }

                    react-clicked(sender-id, timestamp-ns, x, y) => {
                        root.react-clicked(sender-id, timestamp-ns, x, y);
                    }

                    reaction-toggled(sender-id, timestamp-ns, emoji) => {
                        root.reaction-toggled(sender-id, timestamp-ns, emoji);
                    }

                    thread-clicked(id) => {
                        root.thread-clicked(id);
                    }

                    more-clicked(sender-id, timestamp-ns, x, y) => {
                        root.more-clicked(sender-id, timestamp-ns, x, y);
                    }

                    quote-clicked(id) => {
                        root.quote-clicked(id);
                    }

                    attachment-clicked(id) => {
                        root.attachment-clicked(id);
                    }

                    audio-seek(id, pos) => {
                        root.audio-seek(id, pos);
                    }
                }
            }
        }

        // Scroll-to-bottom floating button
        // Appears when user has scrolled up from the bottom
        // Scroll-to-bottom — Neo convex floating button
        // Scroll-to-bottom, which becomes a "N new messages" pill when the
        // conversation opened on an unread boundary — the affordance that says
        // how much is below you and takes you there in one tap.
        if !root.is-at-bottom: Rectangle {
            x: root.width - self.width - 16px;
            y: root.height - 60px;
            width: pill-content.preferred-width + Spacing.lg * 2;
            height: 44px;
            border-radius: 22px;
            background: Colors.primary;
            accessible-role: button;
            accessible-label: root.unread-count > 0
                ? root.unread-count + " new messages, jump to newest"
                : "Scroll to bottom";
            drop-shadow-blur: Spacing.neo-blur-lg;
            drop-shadow-offset-x: Spacing.neo-offset-md;
            drop-shadow-offset-y: Spacing.neo-offset-md;
            drop-shadow-color: Colors.neo-shadow-strong;

            // Fade in animation
            opacity: 1.0;
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }

            pill-content := HorizontalLayout {
                alignment: center;
                spacing: Spacing.sm;

                if root.unread-count > 0: Text {
                    text: root.unread-count == 1
                        ? "1 new message"
                        : root.unread-count + " new messages";
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                    vertical-alignment: center;
                }

                // Down arrow icon
                Text {
                    text: "↓";
                    color: Colors.text-primary;
                    font-size: Typography.xl;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            scroll-btn := TouchArea {
                clicked => {
                    // Consume the anchor: the user has chosen the newest
                    // message, so no later relayout may drag them back up.
                    root.unread-index = -1;
                    root.unread-count = 0;
                    root.is-at-bottom = true;
                    root.go-to-end();
                    root.scroll-to-bottom-clicked();
                }
            }

            // Hover effect
            states [
                hover when scroll-btn.has-hover: {
                    background: Colors.primary-hover;
                }
            ]
        }
    }
}
