import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { IconAction } from "../components/icon_action.slint";

export component MessageActions inherits Rectangle {
    in property <length> bubble-height;
    in property <length> bubble-width;
    in property <length> bubble-x;
    in property <length> bubble-y;
    in property <bool> can-thread;
    in property <bool> is-call;
    in property <bool> is-deleted;
    in property <bool> is-hovered;
    in property <bool> is-own;
    in property <bool> is-system;
    in property <string> message-id;
    in property <length> origin-x;
    in property <length> left-limit;
    in property <length> right-limit;
    in property <length> chrome-bottom: 0px;
    in property <string> sender-id;
    in property <string> timestamp-ns;
    callback reply-clicked(string, string);
    callback react-clicked(string, string, length, length);
    callback thread-clicked(string);
    callback request-menu(length, length, length, length, length, length);

    // Try beside the bubble first, then tuck inside its near edge.
    // Clamp the tucked position too: a short bubble can be narrower than the bar.
    private property <length> outside-x: root.is-own
        ? root.bubble-x - Spacing.xxs - self.width
        : root.bubble-x + root.bubble-width + Spacing.xxs;
    private property <length> inside-x: root.is-own
        ? root.bubble-x + Spacing.sm
        : root.bubble-x + root.bubble-width - self.width - Spacing.sm;
    private property <length> preferred-x: self.outside-x < root.left-limit
        || self.outside-x + self.width > root.right-limit ? self.inside-x : self.outside-x;
    x: clamp(self.preferred-x, root.left-limit, max(root.left-limit, root.right-limit - self.width))
        - root.origin-x;
    // Float halfway above the top edge, but never under the floating header
    // and pinned bar: a bubble scrolled up to them hid its own actions.
    y: max(-root.btn / 2, root.chrome-bottom - root.bubble-y);
    width: action-btns.width;
    height: action-btns.height;
    visible: root.is-hovered && !root.is-system && !root.is-deleted && !root.is-call;

    // IconAction's own size: it never shrinks below the touch target, so a
    // bar sized from button-height let the buttons run past its end and
    // over the bubble.
    property <length> btn: max(Spacing.touch-target-min, Spacing.button-height);

    action-btns := Rectangle {
        height: root.btn + Spacing.xxs * 2;
        width: (root.can-thread ? 4 : 3) * root.btn + (root.can-thread ? 5 : 4) * Spacing.xxs;
        background: Colors.surface-card;
        border-radius: Spacing.radius-panel;
        border-width: Spacing.stroke;
        border-color: Colors.border;

        HorizontalLayout {
            padding: Spacing.xxs;
            spacing: Spacing.xxs;
            alignment: center;

            // Reply button
            IconAction {
                label: @tr("Reply to message");
                visual-size: Spacing.button-height - Spacing.sm;
                icon: Icons.reply;
                clicked => {
                        root.reply-clicked(root.sender-id, root.timestamp-ns);
                }
            }

            // React button
            react-btn := IconAction {
                label: @tr("Add reaction");
                visual-size: Spacing.button-height - Spacing.sm;
                icon: Icons.smile;
                clicked => {
                        root.react-clicked(root.sender-id, root.timestamp-ns,
                            react-btn.absolute-position.x,
                            react-btn.absolute-position.y + react-btn.height);
                }
            }

            // Reply-in-thread button — opens/starts a thread on
            // this message. Previously the ONLY thread entry was
            // the "N replies" badge (rendered `if reply-count > 0`),
            // so a message with no replies could never START a thread.
            if root.can-thread: thread-btn := IconAction {
                label: @tr("Reply in thread");
                visual-size: Spacing.button-height - Spacing.sm;
                icon: Icons.message-circle;
                clicked => {
                        root.thread-clicked(root.message-id);
                }
            }

            // More button
            more-btn := IconAction {
                label: @tr("More message actions");
                visual-size: Spacing.button-height - Spacing.sm;
                icon: Icons.more-horizontal;
                clicked => {
                        root.request-menu(more-btn.absolute-position.x,
                            more-btn.absolute-position.y + more-btn.height,
                            root.bubble-y, root.bubble-y + root.bubble-height,
                            root.bubble-x, root.bubble-x + root.bubble-width);
                }
            }
        }
    }
}
