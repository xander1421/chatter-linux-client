import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";

// Presentation state only; capture, duration limits and attachment preparation
// are owned by chatter-core's recording session.
export global VoiceRecording {
    in-out property <bool> active: false;
    in-out property <bool> busy: false;
    // Kept for API compatibility with older layout harnesses. The recording
    // bar no longer has a lock control or a slide-to-lock interaction.
    in-out property <bool> locked: false;
    in-out property <string> elapsed: "00:00";
    in-out property <string> status: "";
    in-out property <[int]> live-levels: [];
    in-out property <bool> pulse-bright: false;
    callback start();
    callback finish();
    callback cancel();
}

// The bars arrive from the capture worker at 25 Hz. There is no idle timer.
export component LiveVoiceWaveform inherits Rectangle {
    background: transparent;
    min-width: 96px;
    height: 24px;
    horizontal-stretch: 1;
    clip: true;

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 2px;
        alignment: space-between;
        for level in VoiceRecording.live-levels: VerticalLayout {
            width: 3px;
            height: parent.height;
            alignment: center;
            Rectangle {
                width: 3px;
                // The capture meter is already compressed to 0..100. Give
                // quiet speech visible motion and let normal speech use the
                // full track without clipping louder peaks.
                height: 4px + 20px * min(100, level * 2.5) / 100;
                border-radius: Spacing.radius-full;
                background: Colors.glass-accent;
                opacity: level < 2 ? 0.34 : 0.95;
                animate height { duration: Appearance.reduce-motion ? 0ms : Materials.motion-quick; easing: Materials.settle; }
            }
        }
    }
}
