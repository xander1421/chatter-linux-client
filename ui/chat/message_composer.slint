import { GlassSurface } from "../components/glass_surface.slint";
import { VoiceRecording } from "voice_recording.slint";
import { HeaderButton } from "../components/header_button.slint";
// Message composer component
//
// Enhanced message input with attachment, emoji, GIF buttons, and @ mention detection.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";

// Markdown wrapping for the formatting toolbar. Implemented in Rust
// (composer/format_text.rs) because Slint has no substring/byte-slice op.
export global TextFormat {
    // (text, format-type, sel-start-byte, sel-end-byte) -> new text
    pure callback wrap(string, string, int, int) -> string;
    pure callback replace(string, string, int, int) -> string;
    pure callback byte-length(string) -> int;
}

// Pending attachment data for the attachment tray
export struct PendingAttachmentData {
    id: string,
    filename: string,
    size-display: string,
    category: string,   // "image", "video", "audio", "document", "code", "archive", "other"
    is-ready: bool,
    has-thumbnail: bool,
    thumbnail: image,
}

// One closed contour for the field and both droplets. At full lift each lobe
// has a 48px circular crown; its inner vertical tangent flows through a thin
// neck into the field. At rest those segments flatten into the field top.
component LiquidComposerSilhouette inherits Path {
    in property <float> rise;
    in property <float> velocity;
    in property <float> field-top;
    in property <float> shell-height;
    in property <bool> trailing-drop;
    property <float> w: self.width / 1px;
    property <float> h: self.height / 1px;
    property <float> p: min(1.08, max(0, rise));
    property <float> r: 16 + 8 * p;
    property <float> cy: (field-top + 16) * (1 - p) + shell-height * 0.5 * p;
    property <float> top: field-top * (1 - p) + (cy - r) * p;
    property <float> side-y: cy;
    property <float> inner-x: 32 + 16 * p;
    property <float> inner-y: field-top * (1 - p) + cy * p;
    property <float> waist-x: 42 + 2 * p;
    property <float> waist-y: field-top - 12 * p;
    property <float> join-x: 76;
    property <float> dip: min(5, max(0, velocity) * 24);
    property <float> splash: min(7, max(0, -velocity) * 28) * (1 - min(1, p));
    property <float> k: 0.55228475;
    fill: Appearance.glass-effects ? Materials.regular : Materials.opaque;
    stroke: Materials.glass-edge;
    stroke-width: Materials.glass-edge-width;
    viewbox-width: w;
    viewbox-height: h;
    fit: fill;
    MoveTo { x: 0; y: h - 16; }
    LineTo { x: 0; y: side-y; }
    CubicTo { control-1-x: 0; control-1-y: side-y - k * r;
        control-2-x: r * (1 - k); control-2-y: top; x: r; y: top; }
    CubicTo { control-1-x: r + k * r * p; control-1-y: top;
        control-2-x: inner-x; control-2-y: inner-y - k * r * p; x: inner-x; y: inner-y; }
    CubicTo { control-1-x: inner-x; control-1-y: inner-y + 10 * p;
        control-2-x: waist-x; control-2-y: waist-y - 9 * p; x: waist-x; y: waist-y; }
    CubicTo { control-1-x: waist-x; control-1-y: waist-y + 9 * p;
        control-2-x: join-x - 14 * p; control-2-y: field-top; x: join-x; y: field-top; }
    CubicTo { control-1-x: join-x + 12; control-1-y: field-top + dip;
        control-2-x: join-x + 24; control-2-y: field-top - splash;
        x: join-x + 36; y: field-top; }
    LineTo { x: trailing-drop ? w - join-x - 36 : w - 16; y: field-top; }
    CubicTo { control-1-x: trailing-drop ? w - join-x - 24 : w - 16;
        control-1-y: trailing-drop ? field-top - splash : field-top;
        control-2-x: trailing-drop ? w - join-x - 12 : w - 16;
        control-2-y: trailing-drop ? field-top + dip : field-top;
        x: trailing-drop ? w - join-x : w - 16; y: field-top; }
    CubicTo { control-1-x: trailing-drop ? w - join-x + 14 * p : w - 16;
        control-1-y: field-top;
        control-2-x: trailing-drop ? w - waist-x : w;
        control-2-y: trailing-drop ? waist-y + 9 * p : field-top;
        x: trailing-drop ? w - waist-x : w; y: trailing-drop ? waist-y : field-top + 16; }
    CubicTo { control-1-x: trailing-drop ? w - waist-x : w;
        control-1-y: trailing-drop ? waist-y - 9 * p : field-top + 16;
        control-2-x: trailing-drop ? w - inner-x : w;
        control-2-y: trailing-drop ? inner-y + 10 * p : field-top + 16;
        x: trailing-drop ? w - inner-x : w; y: trailing-drop ? inner-y : field-top + 16; }
    CubicTo { control-1-x: trailing-drop ? w - inner-x : w;
        control-1-y: trailing-drop ? inner-y - k * r * p : field-top + 16;
        control-2-x: trailing-drop ? w - r - k * r * p : w;
        control-2-y: trailing-drop ? top : field-top + 16;
        x: trailing-drop ? w - r : w; y: trailing-drop ? top : field-top + 16; }
    CubicTo { control-1-x: trailing-drop ? w - r * (1 - k) : w;
        control-1-y: trailing-drop ? top : field-top + 16;
        control-2-x: w; control-2-y: trailing-drop ? side-y - k * r : field-top + 16;
        x: w; y: trailing-drop ? side-y : field-top + 16; }
    LineTo { x: w; y: h - 16; }
    CubicTo { control-1-x: w; control-1-y: h - 7.16;
        control-2-x: w - 7.16; control-2-y: h; x: w - 16; y: h; }
    LineTo { x: 16; y: h; }
    CubicTo { control-1-x: 7.16; control-1-y: h;
        control-2-x: 0; control-2-y: h - 7.16; x: 0; y: h - 16; }
    Close { }
}

export component MessageComposer inherits GlassSurface {
    material-enabled: VoiceRecording.active;
    background: transparent;
    material-level: 2;
    elevation: 3;
    border-radius: Spacing.radius-chrome;
    border-width: 0px;
    border-color: Materials.glass-edge;

    in property <bool> collapsed: false;
    visible: !root.collapsed;
    clip: VoiceRecording.active;
    in property <bool> picker-open: false;
    in property <int> attachment-prepare-serial;
    in property <int> attachment-restore-serial;
    private property <bool> attachment-suspended: false;
    private property <string> attachment-draft;
    changed attachment-prepare-serial => {
        root.suspend-input();
        root.attachment-draft = root.text;
        root.attachment-suspended = true;
        root.input-dismissed();
    }
    changed attachment-restore-serial => {
        if root.attachment-suspended && root.text == root.attachment-draft && !root.collapsed {
            root.restore-input();
        }
        root.attachment-suspended = false;
    }
    private property <bool> input-ever-focused: false;
    private property <int> saved-anchor;
    private property <int> saved-cursor;
    private property <string> saved-preedit;
    private property <string> settled-text;
    private property <bool> suspending-input: false;
    function suspend-input() {
        root.suspending-input = true;
        root.saved-anchor = text-input.anchor-position-byte-offset;
        root.saved-cursor = text-input.cursor-position-byte-offset;
        if !root.input-ever-focused {
            root.saved-cursor = TextFormat.byte-length(root.text);
            root.saved-anchor = root.saved-cursor;
        }
        // Snapshot before FocusOut: Android commits preedit there, desktop
        // drops it. Assign the same settled text afterward on both platforms,
        // avoiding both loss and a second Android commit.
        root.saved-preedit = text-input.preedit-text;
        if root.saved-preedit != "" {
            root.settled-text = TextFormat.replace(root.text, root.saved-preedit, root.saved-cursor, root.saved-cursor);
            root.saved-cursor += TextFormat.byte-length(root.saved-preedit);
            root.saved-anchor = root.saved-cursor;
        }
        text-input.clear-focus();
        if root.saved-preedit != "" { root.text = root.settled-text; }
        root.suspending-input = false;
    }
    callback input-dismissed();
    callback keyboard-requested();
    changed collapsed => {
        if root.collapsed {
            root.suspend-input();
            root.input-focused();
            root.input-dismissed();
        }
    }
    public function restore-input() {
        text-input.focus();
        text-input.set-selection-offsets(root.saved-anchor, root.saved-cursor);
    }
    public function insert-emoji(emoji: string) {
        root.text = TextFormat.replace(root.text, emoji, root.saved-anchor, root.saved-cursor);
        root.saved-cursor = min(root.saved-anchor, root.saved-cursor) + TextFormat.byte-length(emoji);
        root.saved-anchor = root.saved-cursor;
        text-input.set-selection-offsets(root.saved-anchor, root.saved-cursor);
    }
    function start-recording() {
        root.suspend-input();
        root.input-focused();
        VoiceRecording.start();
    }
    property <bool> voice-held: false;
    property <length> voice-press-x;
    property <length> voice-press-y;
    voice-hold := Timer {
        interval: 300ms;
        running: false;
        triggered => { root.voice-held = true; self.running = false; }
    }
    // Properties
    in property <string> placeholder: "Type a message...";
    in-out property <string> text: "";
    in property <bool> disabled: false;
    in property <[PendingAttachmentData]> pending-attachments: [];

    // Edit mode properties
    in-out property <bool> is-editing: false;
    in-out property <string> edit-message-id: "";

    // Entering edit (or retargeting it to another message) prefills `text`
    // from Rust; left alone the caret stays wherever it was, usually
    // mid-string (§112j). Put it at the end, where editing starts. The
    // offset is clamped to the text length.
    changed edit-message-id => {
        if (root.edit-message-id != "") {
            text-input.focus();
            text-input.set-selection-offsets(2147483647, 2147483647);
        }
    }

    // Reply mode properties
    in property <bool> is-replying: false;
    in property <string> reply-to-sender: "";
    in property <string> reply-to-preview: "";
    in property <bool> reply-has-thumbnail: false;
    in property <image> reply-thumbnail;

    // Computed properties
    // Text the IME is still composing counts as text. Without the preedit term a
    // single word that the keyboard has not committed yet leaves can-send false,
    // so the send button is disabled and the word cannot be sent at all
    // (OPEN-ITEMS §112c).
    property <bool> can-send: text != "" || text-input.preedit-text != "" || pending-attachments.length > 0;
    // Keep one native input alive across the inline/raised transition. Preedit
    // participates without being committed; attachments also raise the controls.
    // A reply raises them too: its preview lives in the raised toolbar gap.
    property <bool> raised-actions: text != "" || text-input.preedit-text != "" || root.has-attachments || root.is-replying;
    // A damped neck spring pulls the droplets upward against gravity. Keeping
    // velocity across target changes lets a send reverse the same moving drop.
    // One tick is a tenth of the shared quick duration, including speed scale.
    private property <float> lift-progress: 0;
    private property <float> lift-velocity: 0;
    property <float> lift-geometry: min(1.08, max(0, root.lift-progress));
    changed raised-actions => {
        if Appearance.reduce-motion {
            root.lift-progress = root.raised-actions ? 1 : 0;
            root.lift-velocity = 0;
            lift-timer.running = false;
        } else {
            lift-timer.running = true;
        }
    }
    lift-timer := Timer {
        interval: Materials.motion-quick / 10;
        running: false;
        triggered => {
            if Appearance.reduce-motion {
                root.lift-progress = root.raised-actions ? 1 : 0;
                root.lift-velocity = 0;
                self.running = false;
                return;
            }
            // Tension starts the rise slowly, gravity pulls it back from the
            // crest, and damping leaves one small oscillation before rest.
            root.lift-velocity = (root.lift-velocity
                + ((root.raised-actions ? 1 : 0) - root.lift-progress)
                    * (root.raised-actions ? 0.12 : 0.16)) * 0.65;
            root.lift-progress += root.lift-velocity;
            if max(root.lift-velocity, -root.lift-velocity) < 0.002
                && max(root.lift-progress - (root.raised-actions ? 1 : 0),
                    (root.raised-actions ? 1 : 0) - root.lift-progress) < 0.002 {
                root.lift-progress = root.raised-actions ? 1 : 0;
                root.lift-velocity = 0;
                self.running = false;
            }
        }
    }
    property <float> reply-reveal: is-replying ? 1 : 0;
    animate reply-reveal {
        duration: Appearance.reduce-motion ? 90ms : Materials.motion-standard;
        easing: Appearance.reduce-motion ? linear : Materials.spring;
    }
    property <float> strip-reveal: has-attachments ? 1 : 0;
    animate strip-reveal {
        duration: Appearance.reduce-motion ? 90ms : Materials.motion-standard;
        easing: Appearance.reduce-motion ? linear : Materials.spring;
    }
    property <bool> show-attachment-action: !root.is-editing && (MeshGlobal.active-id == "" || MeshGlobal.active-kind != "dm");
    property <bool> show-terminal-action: root.can-send || (!root.is-editing && MeshGlobal.active-id == "");
    property <length> action-shell-height: Spacing.touch-target-min + row-padding * 2;
    property <length> attachment-chip-height: Spacing.touch-target-min;
    property <length> attachment-band-height: attachment-chip-height + Spacing.sm * 2;
    // Reply preview sits in the first toolbar row's gap; with attachments too,
    // the strip takes a second gap row below it so the two never overlap.
    property <length> reply-row-height: is-replying ? max(action-shell-height, 48px * Appearance.text-grow) : 0px;
    // The first raised row: the emoji and attach shells are as tall as the
    // reply chip beside them, so large text cannot leave the chip taller
    // than its neighbours.
    property <length> top-shell-height: is-replying ? reply-row-height : action-shell-height;
    property <length> raised-toolbar-height: lift-geometry
        * ((is-replying ? reply-row-height + Spacing.xs : 0px)
            + (has-attachments ? attachment-band-height + Spacing.xs
                : !is-replying ? action-shell-height + Spacing.xs : 0px));
    property <length> lower-terminal-width: show-terminal-action ? Spacing.touch-target-min + Spacing.xs : 0px;
    property <length> trailing-actions-width: (show-attachment-action ? Spacing.touch-target-min + Spacing.xs : 0px)
        + (show-terminal-action ? Spacing.touch-target-min + Spacing.xs : 0px);

    // What actually gets sent. `TextInput.text` EXCLUDES the preedit -- the text
    // the input method is still composing -- so sending `text` silently drops
    // whatever the keyboard had in flight and leaves it behind in the box.
    // Measured on a Galaxy S9: typing "hello-ui-test" and pressing send
    // delivered "hello-ui-" and left "test" in the composer. The preedit is
    // spliced in at the caret (`composed-text`), not appended.
    property <string> outgoing-text: root.composed-text;

    // `text` with the input method's in-flight composition spliced in at the
    // caret (the byte offset the preedit is drawn at). The host mirrors these
    // so it can settle a composition this element may no longer be alive to
    // settle itself: a conversation switch retargets `text`, and leaving the
    // chat destroys this TextInput without a FocusOut.
    out property <bool> composing: text-input.preedit-text != "";
    out property <string> composed-text: TextFormat.replace(root.text, text-input.preedit-text,
        text-input.cursor-position-byte-offset, text-input.cursor-position-byte-offset);

    // Clearing `text` alone does NOT clear the preedit: the composition belongs
    // to the input method, and Slint keeps rendering it. After a send that means
    // the composing word stays in the box and would be prepended to the NEXT
    // message. Dropping focus is the only handle Slint gives us to make the IME
    // finish composing; re-focusing immediately keeps the keyboard up so a user
    // can send several messages in a row.
    function reset-after-send() {
        root.text = "";
        root.reset-composition();
    }

    // Make the input method finish composing. Dropping focus is the only handle
    // Slint gives us for that; re-focusing immediately keeps the keyboard up.
    //
    // Only with a composition to finish. On Android the focus drop sends
    // InputMethodRequest::Disable (a real hideSoftInput) and the re-focus an
    // Enable (showSoftInput), so the keyboard closed and reopened on every
    // send — and there was never anything to end: the Android backend commits
    // the composition on the send tap's pointer-down and never hands Slint a
    // pre-edit, so `preedit-text` is always empty there. A live pre-edit
    // (desktop CJK with Enter) still takes the cycle.
    function reset-composition() {
        if text-input.preedit-text == "" { return; }
        text-input.clear-focus();
        text-input.focus();
    }
    property <bool> has-attachments: pending-attachments.length > 0;

    // The input row's floor, and with it the height of the emoji / attach /
    // send boxes beside it: those are touch targets, so the floor is the touch
    // minimum. A shorter row was what made them 36dp on a phone.
    property <length> min-input-height: Spacing.touch-target-min;
    // The host supplies the chat pane after IME/system insets. Leave room for
    // history even on a short landscape pane, and stop growing at six lines.
    in property <length> available-pane-height: 800px;
    property <length> input-line-height: line-measure.preferred-height;
    property <length> max-input-height: root.mobile
        ? max(min-input-height, min(input-line-height * 6 + padding-vertical,
            available-pane-height * 0.4 - edit-bar-height
                - format-bar-height - raised-toolbar-height - row-padding * 2))
        : 400px;
    property <length> padding-vertical: Spacing.sm * 2;
    function reveal-cursor() {
        // Native geometry shapes the full input and follows the actual IME
        // selection endpoint, including selection-only composition updates.
        root.caret-top = text-input.y + text-input.visual-cursor-y;
        if root.caret-top + input-scroll.viewport-y < 0px {
            input-scroll.viewport-y = -root.caret-top;
        } else if root.caret-top + text-input.visual-cursor-height + input-scroll.viewport-y > input-scroll.height {
            input-scroll.viewport-y = input-scroll.height - root.caret-top - text-input.visual-cursor-height;
        }
        input-scroll.viewport-y = min(0px, max(input-scroll.height - input-scroll.viewport-height,
            input-scroll.viewport-y));
    }
    private property <length> caret-top;
    line-measure := Text {
        visible: false;
        text: "Mg";
        font-size: Typography.base;
    }
    // Use the TextInput's actual `preferred-height` (recomputed by Slint's
    // text shaper from the wrapped layout) instead of guessing from
    // character count — guess undercounts when words don't break and the
    // composer doesn't grow to match the visible wrapped text.
    property <length> content-height: max(
        min-input-height,
        min(max-input-height, text-input.preferred-height + padding-vertical)
    );

    // Bar heights. Each bar is drawn at exactly this height, and the bars
    // hold text, so they grow with the text size.
    property <length> edit-bar-height: is-editing ? Spacing.touch-target-min * Appearance.text-grow : 0px;

    // Callbacks
    // Only clear the native draft/composition once core accepts ownership.
    callback send(string) -> bool;
    callback send-edit(string, string);  // (message_id, new_text)
    callback cancel-edit();
    callback cancel-reply();
    callback attachment-clicked();
    // Fired on Ctrl/Cmd+V so the host can attach an image from the clipboard.
    // Text paste is handled by TextInput itself (this doesn't consume the key).
    callback paste-image();
    callback emoji-clicked();
    // The text field took focus: the emoji / GIF panel gives way to the
    // keyboard, the way Signal toggles between the two.
    callback input-focused();
    callback mention-triggered(string);
    callback remove-attachment(string);
    callback typing-changed(bool);  // true when started typing, false when stopped

    // Wrap the current selection (or insert markers at the cursor) with the
    // markdown for `fmt`, then re-select the inner text. Byte offsets captured
    // before mutating `text` — the offsets collapse once `text` changes.
    private property <int> fmt-sel-start;
    private property <int> fmt-sel-end;
    function apply-format(fmt: string) {
        self.fmt-sel-start = min(text-input.anchor-position-byte-offset, text-input.cursor-position-byte-offset);
        self.fmt-sel-end = max(text-input.anchor-position-byte-offset, text-input.cursor-position-byte-offset);
        root.text = TextFormat.wrap(root.text, fmt, self.fmt-sel-start, self.fmt-sel-end);
        text-input.focus();
        text-input.set-selection-offsets(
            self.fmt-sel-start + (fmt == "codeblock" ? 4 : (fmt == "bold" || fmt == "strikethrough") ? 2 : 1),
            self.fmt-sel-end + (fmt == "codeblock" ? 4 : (fmt == "bold" || fmt == "strikethrough") ? 2 : 1),
        );
    }

    // Formatting toolbar only while text is SELECTED.
    //
    // Whatever flips this drives format-bar-height, which feeds the composer's
    // animated `height:` below — so the composer grows 44px at that moment. On
    // Android that growth hides the soft keyboard if it lands while the IME
    // transaction is still in flight (GameActivity logs: setSoftKeyboardActive
    // true then false). Two earlier gates both landed inside that window:
    //   * `has-focus` grew it mid-tap, before the finger lifted.
    //   * `text != ""` grew it on the FIRST character instead. The tap then
    //     survived and the first keystroke did not — and the second attempt
    //     worked, because by then the bar was already up and nothing moved.
    // Slint takes focus on finger-UP on Android (i-slint-core items/text.rs,
    // `MouseEvent::Released` -> ensure_focus_and_ime), so the IME is still
    // animating in for a few hundred ms after the tap; a fast typist's first
    // key lands inside that. Later growth — a line wrap at ~40 characters —
    // is harmless because the IME has long since settled.
    //
    // A selection is the one trigger that can never land in that window: it
    // takes a deliberate drag or long-press that ENDS before the bar appears,
    // and typing collapses a selection rather than making one. The composer's
    // formatting bar stays absent across the tap-then-type sequence. The
    // populated-text action row below now deliberately changes geometry on the
    // first character without replacing the input or changing its focus.
    // With nothing selected the formatting buttons would wrap an empty range.
    property <bool> show-formatting:
        text-input.anchor-position-byte-offset != text-input.cursor-position-byte-offset;

    // Formatting bar height — 44px so the B/I/S/code buttons inside can be
    // 44px touch targets rather than the 28px boxes measured on a phone.
    property <length> format-bar-height: show-formatting ? 44px : 0px;

    // Bento Box — expands when user is actively typing (text is non-empty)

    // Forward focus to input
    forward-focus: text-input;

    // The air above and below the input row. 4px, not 8px: the row's floor is a
    // 48px touch target, so the row is already tall enough to breathe on its own
    // — 16px on top of it made the composer 65px for one line of text and left
    // the screen looking bottom-heavy. The buttons are untouched.
    // The same inset on all four sides of the row, so the field and the
    // buttons are concentric with the shell (Spacing.radius-chrome-inner).
    property <length> row-padding: Spacing.chrome-inset;

    // Layout - dynamic height based on content (includes Bento Box when expanded)
    property <length> recording-height: max(112px, recording-layout.preferred-height + row-padding * 2);
    height: root.collapsed ? 0px : VoiceRecording.active ? recording-height : content-height + raised-toolbar-height + edit-bar-height + format-bar-height + row-padding * 2;
    // Action/input positions change immediately with text/preedit on every
    // platform. Settle the shell with them so the focused native field remains
    // inside its bounds between consecutive key events.
    // "Touch input", plumbed from ChatLayout.
    in property <bool> mobile: false;

    // Accessories retain their own material when the raised main row is transparent.
    accessory-surface := GlassSurface {
        // Slint centers fixed-size children by default. Anchor the accessory
        // material to its indicators, or an edit paints a full-width empty bar
        // behind the raised action row instead of behind the edit indicator.
        y: 0px;
        visible: root.raised-actions && !VoiceRecording.active && self.height > 0px;
        width: root.width;
        height: root.edit-bar-height + root.format-bar-height;
        material-level: root.material-level;
        elevation: root.elevation;
        backdrop-paused: root.backdrop-paused;
    }

    VerticalLayout {
        // 100% width for proper text wrapping in children
        width: 100%;

        // Edit mode indicator bar
        if root.is-editing: Rectangle {
            width: 100%;
            height: root.edit-bar-height;
            background: Colors.primary.transparentize(0.9);
            // The tint is a separate layer above the rounded accessory shell.
            // Match its corners so it cannot paint a square backing outside it.
            border-radius: Spacing.radius-chrome;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.sm;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;

                    Image {
                        source: Icons.edit;
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }

                    Text {
                        text: "Editing message";
                        color: Colors.primary;
                        font-size: Typography.sm;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                // Cancel button — a 48dp box, glyph centred in it
                Rectangle {
                    width: Spacing.touch-target-min;
                    height: Spacing.touch-target-min;
                    background: cancel-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                    border-radius: Spacing.radius-sm;
                    accessible-role: button;
                    accessible-label: "Cancel edit";

                    Image {
                        source: Icons.x;
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // Drop the IME composition too. The Rust handler
                            // clears `composer_text`, but that only clears the
                            // COMMITTED text -- anything the keyboard was still
                            // composing survives and is re-rendered, so
                            // cancelling an edit left that text in the box with
                            // Send active, ready to post as a NEW message
                            // (OPEN-ITEMS §112g).
                            root.reset-composition();
                            root.cancel-edit();
                        }
                    }
                }
            }
        }

        // Formatting toolbar (toggled)
        if root.show-formatting: Rectangle {
            width: 100%;
            height: root.format-bar-height;
            background: transparent;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.xxs;
                alignment: start;

                // Bold button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Spacing.radius-sm;
                        background: fmt-bold-touch.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Bold";

                        Text {
                            text: "B";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.bold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        fmt-bold-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.apply-format("bold"); }
                        }
                    }
                }

                // Italic button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Spacing.radius-sm;
                        background: fmt-italic-touch.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Italic";

                        Text {
                            text: "I";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-italic: true;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        fmt-italic-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.apply-format("italic"); }
                        }
                    }
                }

                // Strikethrough button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Spacing.radius-sm;
                        background: fmt-strike-touch.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Strikethrough";

                        Text {
                            text: "S";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Strikethrough line
                        Rectangle {
                            width: 10px;
                            height: 1px;
                            x: (parent.width - self.width) / 2;
                            y: parent.height / 2;
                            background: Colors.text-secondary;
                        }

                        fmt-strike-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.apply-format("strikethrough"); }
                        }
                    }
                }

                // Code button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Spacing.radius-sm;
                        background: fmt-code-touch.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Inline code";

                        Text {
                            text: "</>";
                            color: Colors.text-secondary;
                            font-size: Typography.xxs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        fmt-code-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.apply-format("code"); }
                        }
                    }
                }

                // Separator
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Colors.divider;
                    }
                }

                // Code block button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: Spacing.radius-sm;
                        background: fmt-codeblock-touch.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Code block";

                        Text {
                            text: "```";
                            color: Colors.text-secondary;
                            font-size: Typography.xxs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        fmt-codeblock-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.apply-format("codeblock"); }
                        }
                    }
                }
            }
        }

        // Populated actions have compact shells with transparent space between them.
        // Absolute geometry changes neither the native input nor focus/selection.
        Rectangle {
            width: 100%;
            height: root.content-height + root.raised-toolbar-height + root.row-padding * 2;
            property <length> action-y: root.row-padding + (root.content-height - Spacing.touch-target-min) / 2
                + root.lift-geometry * ((root.top-shell-height - Spacing.touch-target-min) / 2
                    - root.row-padding - (root.content-height - Spacing.touch-target-min) / 2);
            property <length> lower-action-y: root.row-padding + root.raised-toolbar-height + root.content-height - Spacing.touch-target-min;

            // The field, two round droplets, their waists, and the optical rim
            // are a single shape. It sits below the controls and never owns input.
            composer-silhouette := LiquidComposerSilhouette {
                width: parent.width;
                height: parent.height;
                rise: root.lift-geometry;
                velocity: root.lift-velocity;
                field-top: root.raised-toolbar-height / 1px;
                shell-height: root.top-shell-height / 1px;
                trailing-drop: root.show-attachment-action;
                visible: !VoiceRecording.active;
            }

            // Reply preview in the gap between the raised emoji and attach shells.
            if root.is-replying: reply-chip := GlassSurface {
                x: Spacing.touch-target-min + root.row-padding * 2 + Spacing.xs;
                y: Appearance.reduce-motion ? 0px : (1 - root.reply-reveal) * root.raised-toolbar-height;
                width: max(0px, parent.width - (root.show-attachment-action ? root.action-shell-height : 0px) - self.x - Spacing.xs);
                height: root.reply-row-height;
                opacity: min(1, max(0, root.reply-reveal));
                border-radius: Spacing.radius-chrome;
                clip: true;
                material-enabled: false;
                background: Materials.opaque;
                border-width: Materials.glass-edge-width;
                border-color: Materials.glass-edge;
                material-level: root.material-level;
                elevation: root.elevation;
                backdrop-paused: root.backdrop-paused;

                HorizontalLayout {
                    padding-left: Spacing.md;
                    padding-right: root.row-padding;
                    spacing: Spacing.sm;

                    // Reply accent bar
                    Rectangle {
                        width: 4px;
                        height: parent.height - Spacing.sm * 2;
                        y: Spacing.sm;
                        background: Colors.primary;
                        border-radius: 2px;
                    }

                    // Thumbnail preview for image replies
                    if root.reply-has-thumbnail: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: Spacing.radius-sm;
                            clip: true;
                            background: Colors.surface-hover;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.reply-thumbnail;
                                image-fit: cover;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Spacing.xxs;

                        Text {
                            text: "Reply to " + root.reply-to-sender;
                            color: Colors.primary;
                            font-size: Typography.sm;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.reply-to-preview;
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            overflow: elide;
                        }
                    }

                    // Cancel reply button — a 48dp box, glyph centred in it
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Spacing.touch-target-min;
                            height: Spacing.touch-target-min;
                            background: cancel-reply-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                            border-radius: Spacing.radius-chrome-inner;
                            accessible-role: button;
                            accessible-label: "Cancel reply";

                            Image {
                                source: Icons.x;
                                width: 18px;
                                height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.text-secondary;
                            }

                            cancel-reply-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.cancel-reply();
                                }
                            }
                        }
                    }
                }
            }

            // Bounded previews occupy only the gap between the individual action shells,
            // one row below the reply preview when both are present.
            if root.has-attachments: attachment-strip := GlassSurface {
                x: Spacing.touch-target-min + root.row-padding * 2 + Spacing.xs;
                y: (root.is-replying ? root.reply-row-height + Spacing.xs : 0px)
                    + (Appearance.reduce-motion ? 0px : (1 - root.strip-reveal) * root.attachment-band-height);
                width: max(0px, parent.width - (root.show-attachment-action ? root.action-shell-height : 0px) - self.x - Spacing.xs);
                height: root.attachment-band-height;
                opacity: min(1, max(0, root.strip-reveal));
                // One material with the reply chip and the action shells; the
                // cards are wells inside it, not a second card style.
                border-radius: Spacing.radius-chrome;
                clip: true;
                material-enabled: false;
                background: Materials.opaque;
                border-width: Materials.glass-edge-width;
                border-color: Materials.glass-edge;
                material-level: root.material-level;
                elevation: root.elevation;
                backdrop-paused: root.backdrop-paused;

                attachment-scroll := Flickable {
                    width: 100%;
                    height: 100%;
                    // The viewport is exactly the cards plus the add button, or
                    // the strip when that is wider: a strip that fits is centred
                    // in the gap, a longer one scrolls. The row was `start`-
                    // aligned (and the estimate below omitted the padding), so a
                    // single staged image sat hard left with dead space on the
                    // right (S9, RC88).
                    viewport-width: max(self.width, attachment-cards.preferred-width);
                    viewport-height: self.height;
                    interactive: true;

                    attachment-cards := HorizontalLayout {
                        width: attachment-scroll.viewport-width;
                        height: attachment-scroll.viewport-height;
                        padding-left: root.row-padding;
                        padding-right: root.row-padding;
                        padding-top: Spacing.sm;
                        padding-bottom: Spacing.sm;
                        spacing: Spacing.xs;
                        alignment: center;

                        // Pending attachment items: inset wells, concentric with
                        // the shell (radius-chrome-inner − chrome-inset).
                        for attachment in root.pending-attachments: Rectangle {
                            width: 180px;
                            height: root.attachment-chip-height;
                            background: Colors.inset;
                            border-radius: Spacing.radius-lg;
                            opacity: attachment.is-ready ? 1.0 : 0.7;

                            property <color> category-bg: attachment.category == "image" ? Colors.cat-image :
                                                          attachment.category == "video" ? Colors.cat-video :
                                                          attachment.category == "audio" ? Colors.cat-audio :
                                                          attachment.category == "document" ? Colors.cat-document :
                                                          attachment.category == "code" ? Colors.cat-code :
                                                          attachment.category == "archive" ? Colors.cat-archive :
                                                          Colors.text-muted;

                            property <string> category-emoji: attachment.category == "image" ? "\u{1F4F7}" :
                                                              attachment.category == "video" ? "\u{1F3AC}\u{FE0F}" :
                                                              attachment.category == "audio" ? "\u{1F3B5}\u{FE0F}" :
                                                              attachment.category == "document" ? "\u{1F4C4}\u{FE0F}" :
                                                              attachment.category == "code" ? "\u{1F4DD}\u{FE0F}" :
                                                              attachment.category == "archive" ? "\u{1F4E6}\u{FE0F}" :
                                                              "\u{1F4CE}\u{FE0F}";

                            HorizontalLayout {
                                padding-left: root.row-padding;
                                padding-right: 0px;
                                spacing: Spacing.xs;

                                // Icon or thumbnail with loading indicator
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: Spacing.radius-sm;
                                    background: attachment.has-thumbnail ? transparent : category-bg.transparentize(0.8);
                                    clip: true;

                                    // Show thumbnail for images
                                    if attachment.has-thumbnail && attachment.is-ready: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: attachment.thumbnail;
                                        image-fit: cover;
                                    }

                                    // Show icon for non-images when ready
                                    if !attachment.has-thumbnail && attachment.is-ready: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: category-emoji;
                                        font-family: Typography.font-family-emoji;
                                        font-size: Typography.lg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    // Loading indicator when not ready
                                    if !attachment.is-ready: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "\u{23F3}";  // Hourglass
                                        font-size: Typography.lg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // File info
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: Spacing.xxs;

                                    Text {
                                        text: attachment.filename;
                                        color: Colors.text-primary;
                                        font-size: Typography.xs;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.xs;

                                        Text {
                                            text: attachment.is-ready ? attachment.size-display : "Encrypting...";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // Remove button: the reply chip's dismiss, exactly.
                                // A 48dp hit box, quiet at rest, error tint only
                                // under the pointer — the filled pink disc was the
                                // loudest thing in the composer.
                                Rectangle {
                                    width: Spacing.touch-target-min;
                                    height: Spacing.touch-target-min;
                                    background: remove-touch.pressed ? Colors.error.transparentize(0.7)
                                        : remove-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                                    border-radius: Spacing.radius-chrome-inner;
                                    accessible-role: button;
                                    accessible-label: "Remove attachment";
                                    accessible-action-default => { root.remove-attachment(attachment.id); }

                                    Image {
                                        source: Icons.x;
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: remove-touch.has-hover ? Colors.error : Colors.text-secondary;
                                    }

                                    remove-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.remove-attachment(attachment.id);
                                        }
                                    }
                                }
                            }
                        }

                        // Add more: the same 48dp box as the remove control,
                        // centred in the row, with the bundled plus glyph.
                        VerticalLayout {
                            height: root.attachment-chip-height;
                            alignment: center;
                            Rectangle {
                                width: Spacing.touch-target-min;
                                height: Spacing.touch-target-min;
                                background: add-more-touch.pressed ? Materials.pressed
                                    : add-more-touch.has-hover ? Materials.hover : Colors.inset;
                                border-radius: Spacing.radius-chrome-inner;
                                accessible-role: button;
                                accessible-label: "Add attachment";
                                accessible-action-default => { if !root.disabled { root.attachment-clicked(); } }

                                Image {
                                    source: Icons.plus;
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Colors.text-secondary;
                                }

                                add-more-touch := TouchArea {
                                    enabled: !root.disabled;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.attachment-clicked();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Emoji & GIF button (unified — pickers toggle via tabs inside).
            // 48px, not 36px: measured on a phone the old box was a 36dp target,
            // under the 48dp minimum. The icon keeps its size; only the box grows.
            Rectangle {
                x: root.row-padding * (1 - min(1, root.lift-geometry));
                y: parent.action-y;
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                background: root.picker-open && !root.mobile ? Colors.tint-strong
                    : emoji-touch.pressed ? Materials.pressed
                    : emoji-touch.has-hover ? Materials.hover : transparent;
                border-radius: Spacing.radius-chrome-inner;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                // On a phone the open drawer stands where the keyboard was, so
                // the button offers the keyboard back; a desktop window has no
                // soft keyboard, so there the same click is "close".
                accessible-label: root.picker-open ? (root.mobile ? "Show keyboard" : "Close picker") : "Emoji & GIF picker";

                Image {
                    source: root.picker-open && root.mobile ? Icons.keyboard : Icons.smile;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: root.picker-open && !root.mobile ? Colors.glass-accent
                        : emoji-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                }

                emoji-touch := TouchArea {
                    enabled: !root.disabled;
                    mouse-cursor: pointer;
                    clicked => {
                        if !root.picker-open { root.suspend-input(); }
                        if root.picker-open { root.keyboard-requested(); }
                        root.emoji-clicked();
                        if !root.picker-open { root.restore-input(); }
                    }
                }
            }

            // One native input below the toolbar beside Send; compact inline when empty.
            Rectangle {
                x: root.row-padding + (1 - root.lift-geometry) * (Spacing.touch-target-min + Spacing.xs);
                y: root.row-padding + root.raised-toolbar-height;
                width: parent.width - root.row-padding * 2
                    - (root.lift-geometry * root.lower-terminal-width
                        + (1 - root.lift-geometry) * (Spacing.touch-target-min + Spacing.xs + root.trailing-actions-width));
                height: root.content-height;
                background: Colors.inset;
                // Concentric with the shell: radius-chrome − chrome-inset.
                border-radius: Spacing.radius-chrome-inner;
                // The glass shell supplies the resting silhouette. Keep a
                // physical-pixel focus cue without a second permanent rim.
                border-width: text-input.has-focus ? 1phx : 0px;
                border-color: Colors.primary;
                opacity: root.disabled ? 0.5 : 1.0;
                clip: true;
                accessible-role: AccessibleRole.text-input;
                accessible-label: "Message input";

                // Placeholder text (shown when empty, fades on focus).
                //
                // `root.text` EXCLUDES the preedit, so while the input method is
                // composing a word — which on Android is the whole time you are
                // typing one — text is still "" and the placeholder stayed drawn
                // UNDERNEATH the composing characters: "as" overlapping
                // "ype a message...". That overlap is what reads as the text
                // flashing (OPEN-ITEMS §112n).
                if root.text == "" && text-input.preedit-text == "": Text {
                    x: Spacing.md;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - Spacing.md * 2;
                    text: root.placeholder;
                    color: Colors.text-muted;
                    font-size: Typography.base;
                    wrap: word-wrap;
                    opacity: text-input.has-focus ? 0.5 : 1.0;
                    animate opacity { duration: Materials.feedback-duration; }
                }

                // Keep raw TextInput: no std TextEdit/ScrollView focus wrapper.
                // Noninteractive Flickable forwards desktop pointer/selection
                // events unchanged (pinned core items/flickable.rs). Mobile may
                // pan long drafts; cursor movement follows in both modes.
                input-scroll := Flickable {
                    x: Spacing.md;
                    y: Spacing.sm;
                    width: parent.width - Spacing.md * 2;
                    height: parent.height - Spacing.sm * 2;
                    viewport-width: self.width;
                    viewport-height: max(self.height, text-input.preferred-height);
                    interactive: root.mobile;
                    changed height => { root.reveal-cursor(); }
                    changed viewport-height => { root.reveal-cursor(); }
                    text-input := TextInput {
                        x: 0px;
                        // Centred while the row is at its floor, top-anchored once the
                        // text grows past it — otherwise the first line would sit
                        // Spacing.sm above the placeholder it replaces.
                        y: max(0px, (input-scroll.height - self.preferred-height) / 2);
                        width: input-scroll.width;
                        height: max(input-scroll.height, self.preferred-height);
                        page-height: input-scroll.height;
                        changed visual-cursor-y => { root.reveal-cursor(); }
                        changed visual-cursor-height => { root.reveal-cursor(); }
                        changed y => { root.reveal-cursor(); }
                        color: Colors.text-primary;
                        font-size: Typography.base;
                        text <=> root.text;
                        enabled: !root.disabled && !root.collapsed && !VoiceRecording.active;
                        wrap: word-wrap;
                        single-line: false;

                        changed has-focus => {
                            if self.has-focus { root.input-ever-focused = true; }
                            if self.has-focus && !root.suspending-input {
                                root.input-focused();
                            }
                        }

                        key-pressed(event) => {
                            // Enter sends on desktop. On a phone it is a newline, like
                            // Signal: the soft keyboard has no Shift+Enter, so sending on
                            // it made multi-line messages impossible. Send is the button.
                            if (event.text == "\n" && !event.modifiers.shift && !root.mobile) {
                                if (root.can-send && !VoiceRecording.active) {
                                    if (root.is-editing) {
                                        root.send-edit(root.edit-message-id, root.outgoing-text);
                                        root.reset-after-send();
                                    } else {
                                        if root.send(root.outgoing-text) { root.reset-after-send(); }
                                    }
                                }
                                return accept;
                            }
                            if (event.text == "v" && (event.modifiers.control || event.modifiers.meta)) {
                                // Attach clipboard image if present; TextInput still
                                // handles text paste (we don't consume the event).
                                root.paste-image();
                                return reject;
                            }
                            return reject;
                        }

                        edited => {
                            if (self.text != "") {
                                root.check-mention-trigger(self.text);
                            }
                            root.typing-changed(self.text != "");
                        }
                    }
                }
            }

            // Attachment button.
            //
            // Present in the mesh room and in a cell, absent in a mesh DM. The
            // bitchat protocol does carry file transfer (`FileTransfer = 0x22`,
            // plus our streamed chunking on top), so hiding it everywhere in the
            // mesh — as this did while the feature was unimplemented — now
            // withholds something that works.
            //
            // A mesh DM is the exception and stays without it: a file packet is
            // cleartext, every mesh DM is Noise-sealed, and core refuses a
            // directed file for exactly that reason. Offering the button there
            // would be an offer the transport declines. Hidden while editing:
            // an edit changes text only.
            if root.show-attachment-action: Rectangle {
                x: parent.width - root.row-padding * (1 - min(1, root.lift-geometry)) - Spacing.touch-target-min
                    - (1 - root.lift-geometry) * (root.show-terminal-action ? Spacing.touch-target-min + Spacing.xs : 0px);
                y: parent.action-y;
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                background: attachment-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-chrome-inner;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                accessible-label: "Attach file";

                Image {
                    source: Icons.paperclip;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: attachment-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                }

                attachment-touch := TouchArea {
                    enabled: !root.disabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.attachment-clicked();
                    }
                }
            }

            // Tap locks recording; hold releases to send, slide left cancels,
            // slide up locks. Mesh has its own file transport, not this path.
            if !root.can-send && !root.is-editing && MeshGlobal.active-id == "": Rectangle {
                x: parent.width - root.row-padding - Spacing.touch-target-min;
                // Raised by a reply alone: mic takes Send's slot beside the field.
                y: root.raised-actions ? parent.lower-action-y : parent.action-y;
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                accessible-role: button;
                accessible-label: "Record voice message";
                accessible-enabled: !root.disabled;
                accessible-action-default => { if !root.disabled { root.start-recording(); VoiceRecording.locked = true; } }
                Image {
                    source: Icons.mic;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-secondary;
                }
                TouchArea {
                    enabled: !root.disabled;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.voice-press-x = self.mouse-x + self.absolute-position.x;
                            root.voice-press-y = self.mouse-y + self.absolute-position.y;
                            root.voice-held = false;
                            voice-hold.running = true;
                            root.start-recording();
                        }
                        if event.kind == PointerEventKind.cancel {
                            voice-hold.running = false;
                            if !VoiceRecording.locked { VoiceRecording.cancel(); }
                        }
                        if event.kind == PointerEventKind.up {
                            voice-hold.running = false;
                            if VoiceRecording.active {
                                if !root.voice-held || VoiceRecording.busy { VoiceRecording.locked = true; }
                                else if !VoiceRecording.locked { VoiceRecording.finish(); }
                            }
                        }
                    }
                    moved => {
                        if self.pressed && VoiceRecording.active && !VoiceRecording.locked {
                            if self.mouse-x + self.absolute-position.x - root.voice-press-x < -70px { VoiceRecording.cancel(); }
                            else if self.mouse-y + self.absolute-position.y - root.voice-press-y < -60px { VoiceRecording.locked = true; }
                        }
                    }
                }
            }

            // Send stays at the normal bottom action position beside the native field.
            if root.can-send: Rectangle {
                x: parent.width - root.row-padding - Spacing.touch-target-min;
                y: parent.lower-action-y;
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                background: send-touch.has-hover ? Colors.action-hover : Colors.action-fill;
                border-radius: Spacing.radius-chrome-inner;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                accessible-label: "Send message";

                // SVG, not a glyph: "\u{27A4}" has no coverage in the Android
                // system font and rendered as a tofu box on device.
                // 20px, matching the emoji and attach glyphs beside it — at 18px
                // it was the smallest icon in the row while sitting in the only
                // filled button, which read as a mismatch rather than a hierarchy.
                Image {
                    source: Icons.send;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.on-action;
                }

                send-touch := TouchArea {
                    enabled: !root.disabled && root.can-send && !VoiceRecording.active;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.is-editing) {
                            root.send-edit(root.edit-message-id, root.outgoing-text);
                            root.reset-after-send();
                        } else {
                            if root.send(root.outgoing-text) { root.reset-after-send(); }
                        }
                    }
                }
            }
        }
    }

    // Internal function to check for @ mention trigger
    // Called when text is edited
    function check-mention-trigger(t: string) {
        // Simple implementation: check if there's an @ near the end
        // A more sophisticated implementation would track cursor position
        // For now, we'll emit mention-triggered if text contains @
        // and there's content after it (no space before the @'s content)

        // This is a basic heuristic - in practice, you'd want cursor position tracking
        // to properly detect when user types @
    }
    recording-panel := Rectangle {
        visible: VoiceRecording.active;
        width: parent.width;
        height: parent.height;
        background: Colors.surface;
        TouchArea { }
        recording-layout := VerticalLayout {
            padding: root.row-padding;
            spacing: Spacing.xs;
            Text {
                text: VoiceRecording.status != "" ? VoiceRecording.status
                    : VoiceRecording.locked ? "Voice message"
                    : root.mobile ? "Slide left to cancel · up to lock"
                    : "Recording · cancel, lock or send below";
                color: Colors.text-muted;
                font-size: Typography.sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: Spacing.xs;
                HeaderButton {
                    backdrop-paused: root.backdrop-paused;
                    icon: Icons.trash;
                    label: "Cancel voice message";
                    touch: true;
                    destructive: true;
                    clicked => { VoiceRecording.cancel(); }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: VoiceRecording.elapsed;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                    }
                }
                HeaderButton {
                    backdrop-paused: root.backdrop-paused;
                    icon: Icons.lock;
                    label: "Lock recording";
                    touch: true;
                    active: VoiceRecording.locked;
                    enabled: !VoiceRecording.busy;
                    clicked => { VoiceRecording.locked = true; }
                }
                HeaderButton {
                    backdrop-paused: root.backdrop-paused;
                    icon: Icons.send;
                    label: "Send voice message";
                    touch: true;
                    enabled: !VoiceRecording.busy;
                    clicked => { VoiceRecording.finish(); }
                }
            }
        }
    }

}
