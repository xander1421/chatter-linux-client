// Message composer component
//
// Enhanced message input with attachment, emoji, GIF buttons, and @ mention detection.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

// Pending attachment data for the attachment tray
export struct PendingAttachmentData {
    id: string,
    filename: string,
    size-display: string,
    category: string,   // "image", "video", "audio", "document", "code", "archive", "other"
    is-ready: bool,
    has-thumbnail: bool,
    thumbnail: image,
}

export component MessageComposer inherits Rectangle {
    // Properties
    in property <string> placeholder: "Type a message...";
    in-out property <string> text: "";
    in property <bool> disabled: false;
    in property <[PendingAttachmentData]> pending-attachments: [];

    // Edit mode properties
    in-out property <bool> is-editing: false;
    in-out property <string> edit-message-id: "";

    // Reply mode properties
    in property <bool> is-replying: false;
    in property <string> reply-to-sender: "";
    in property <string> reply-to-preview: "";
    in property <bool> reply-has-thumbnail: false;
    in property <image> reply-thumbnail;

    // Computed properties
    property <bool> can-send: text != "" || pending-attachments.length > 0;
    property <bool> has-attachments: pending-attachments.length > 0;

    // Line height and sizing constants
    property <length> line-height: 22px;
    property <length> min-input-height: 36px;
    property <length> max-input-height: 160px;  // ~6-7 lines max
    property <length> padding-vertical: Spacing.sm * 2;

    // Estimate line count based on character count and available width
    // ~8px per character at 14px font size; accounts for word-wrap lines
    // On mobile the sidebar is hidden, so use full width; on desktop subtract sidebar width
    property <int> chars-per-line: max(20, (root.width - 80px) / 8px);
    property <int> estimated-wrap-lines: root.text.character-count / max(1, chars-per-line);
    property <int> estimated-lines: max(1, estimated-wrap-lines + 1);

    // Calculate input height based on content
    property <length> content-height: max(min-input-height, min(max-input-height, estimated-lines * line-height + padding-vertical));

    // Attachment tray height
    property <length> attachment-tray-height: has-attachments ? 72px : 0px;

    // Edit bar height
    property <length> edit-bar-height: is-editing ? 36px : 0px;
    
    // Reply bar height
    property <length> reply-bar-height: is-replying ? 48px : 0px;

    // Callbacks
    callback send(string);
    callback send-edit(string, string);  // (message_id, new_text)
    callback cancel-edit();
    callback cancel-reply();
    callback attachment-clicked();
    callback emoji-clicked();
    callback gif-clicked();
    callback mention-triggered(string);
    callback remove-attachment(string);
    callback typing-changed(bool);  // true when started typing, false when stopped
    callback process-text(string) -> string;  // Insert word breaks for wrapping
    callback format-text(string);  // Apply formatting: "bold", "italic", "code", "strikethrough"

    // Formatting toolbar always visible
    property <bool> show-formatting: true;

    // Formatting bar height
    property <length> format-bar-height: show-formatting ? 32px : 0px;

    // Forward focus to input
    forward-focus: text-input;

    // Layout - dynamic height based on content
    height: content-height + attachment-tray-height + edit-bar-height + reply-bar-height + format-bar-height + Spacing.sm * 2 + 1px;  // +1px for top border
    background: Colors.surface;

    // Top border
    Rectangle {
        y: 0;
        width: 100%;
        height: 1px;
        background: Colors.surface-hover;
    }

    VerticalLayout {
        // 100% width for proper text wrapping in children
        width: 100%;
        padding-top: 1px;

        // Edit mode indicator bar
        if root.is-editing: Rectangle {
            width: 100%;
            height: 36px;
            background: Colors.primary.transparentize(0.9);

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.sm;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;

                    Text {
                        text: "\u{270F}";  // Pencil emoji
                        font-size: Typography.base;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Editing message";
                        color: Colors.primary;
                        font-size: Typography.sm;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                // Cancel button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: cancel-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                    border-radius: Spacing.radius-sm;
                    accessible-role: button;
                    accessible-label: "Cancel edit";

                    Text {
                        text: "\u{2715}";  // X mark
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.cancel-edit();
                        }
                    }
                }
            }
        }

        // Reply mode indicator bar
        if root.is-replying: Rectangle {
            width: 100%;
            height: 48px;
            background: Colors.primary.transparentize(0.95);

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.sm;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;

                    // Reply accent bar
                    Rectangle {
                        width: 4px;
                        height: parent.height - Spacing.sm * 2;
                        y: Spacing.sm;
                        background: Colors.primary;
                        border-radius: 2px;
                    }

                    // Thumbnail preview for image replies
                    if root.reply-has-thumbnail: Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Spacing.radius-sm;
                        clip: true;
                        background: Colors.surface-hover;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.reply-thumbnail;
                            image-fit: cover;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: "Reply to " + root.reply-to-sender;
                            color: Colors.primary;
                            font-size: Typography.sm;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.reply-to-preview;
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            overflow: elide;
                        }
                    }
                }

                // Cancel reply button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: cancel-reply-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                    border-radius: Spacing.radius-sm;
                    accessible-role: button;
                    accessible-label: "Cancel reply";

                    Text {
                        text: "\u{2715}";  // X mark
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-reply-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.cancel-reply();
                        }
                    }
                }
            }
        }

        // Formatting toolbar (toggled)
        if root.show-formatting: Rectangle {
            width: 100%;
            height: 32px;
            background: Colors.background;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: 2px;
                alignment: start;

                // Bold button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: fmt-bold-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Bold";

                    Text {
                        text: "B";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    fmt-bold-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.format-text("bold"); }
                    }
                }

                // Italic button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: fmt-italic-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Italic";

                    Text {
                        text: "I";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        font-italic: true;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    fmt-italic-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.format-text("italic"); }
                    }
                }

                // Strikethrough button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: fmt-strike-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Strikethrough";

                    Text {
                        text: "S";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Strikethrough line
                    Rectangle {
                        width: 10px;
                        height: 1px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2;
                        background: Colors.text-secondary;
                    }

                    fmt-strike-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.format-text("strikethrough"); }
                    }
                }

                // Code button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: fmt-code-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Inline code";

                    Text {
                        text: "</>";
                        color: Colors.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    fmt-code-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.format-text("code"); }
                    }
                }

                // Separator
                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Colors.text-muted.with-alpha(0.2);
                }

                // Code block button
                Rectangle {
                    width: 36px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: fmt-codeblock-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Code block";

                    Text {
                        text: "```";
                        color: Colors.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    fmt-codeblock-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.format-text("codeblock"); }
                    }
                }
            }
        }

        // Attachment tray (shown when there are pending attachments)
        if root.has-attachments: Rectangle {
            width: 100%;
            height: 72px;
            background: Colors.background;

            Flickable {
                width: 100%;
                height: 100%;
                // Calculate content width: each attachment is 180px + spacing, plus add button 56px
                viewport-width: max(self.width, (180px + Spacing.sm) * root.pending-attachments.length + 56px + Spacing.md + Spacing.sm);
                viewport-height: self.height;
                interactive: true;

                HorizontalLayout {
                    padding: Spacing.sm;
                    padding-left: Spacing.md;
                    spacing: Spacing.sm;
                    alignment: start;

                    // Pending attachment items
                    for attachment in root.pending-attachments: Rectangle {
                        width: 180px;
                        height: 56px;
                        background: Colors.surface;
                        border-radius: Spacing.radius-sm;
                        opacity: attachment.is-ready ? 1.0 : 0.7;

                        property <color> category-bg: attachment.category == "image" ? #4ade80 :
                                                      attachment.category == "video" ? #f472b6 :
                                                      attachment.category == "audio" ? #a78bfa :
                                                      attachment.category == "document" ? #60a5fa :
                                                      attachment.category == "code" ? #fbbf24 :
                                                      attachment.category == "archive" ? #fb923c :
                                                      Colors.text-muted;

                        property <string> category-emoji: attachment.category == "image" ? "\u{1F5BC}\u{FE0F}" :
                                                          attachment.category == "video" ? "\u{1F3AC}\u{FE0F}" :
                                                          attachment.category == "audio" ? "\u{1F3B5}\u{FE0F}" :
                                                          attachment.category == "document" ? "\u{1F4C4}\u{FE0F}" :
                                                          attachment.category == "code" ? "\u{1F4DD}\u{FE0F}" :
                                                          attachment.category == "archive" ? "\u{1F4E6}\u{FE0F}" :
                                                          "\u{1F4CE}\u{FE0F}";

                        HorizontalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.sm;

                            // Icon or thumbnail with loading indicator
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: Spacing.radius-sm;
                                background: attachment.has-thumbnail ? transparent : category-bg.transparentize(0.8);
                                clip: true;

                                // Show thumbnail for images
                                if attachment.has-thumbnail && attachment.is-ready: Image {
                                    width: 100%;
                                    height: 100%;
                                    source: attachment.thumbnail;
                                    image-fit: cover;
                                }

                                // Show icon for non-images when ready
                                if !attachment.has-thumbnail && attachment.is-ready: Text {
                                    width: 100%;
                                    height: 100%;
                                    text: category-emoji;
                                    font-size: Typography.lg;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Loading indicator when not ready
                                if !attachment.is-ready: Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "\u{23F3}";  // Hourglass
                                    font-size: Typography.lg;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // File info
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: attachment.filename;
                                    color: Colors.text-primary;
                                    font-size: Typography.xs;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 4px;

                                    Text {
                                        text: attachment.is-ready ? attachment.size-display : "Encrypting...";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }
                            }

                            // Remove button
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: remove-touch.has-hover ? Colors.error.transparentize(0.7) : Colors.error.transparentize(0.9);
                                border-radius: Spacing.radius-full;
                                accessible-role: button;
                                accessible-label: "Remove attachment";

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "\u{2715}";
                                    font-size: Typography.xs;
                                    color: Colors.error;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                remove-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove-attachment(attachment.id);
                                    }
                                }
                            }
                        }
                    }

                    // Add more button
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        background: add-more-touch.has-hover ? Colors.surface-hover : transparent;
                        border-width: 2px;
                        border-color: Colors.text-muted;
                        border-radius: Spacing.radius-sm;
                        accessible-role: button;
                        accessible-label: "Add attachment";

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "+";
                            font-size: Typography.xxl;
                            color: Colors.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        add-more-touch := TouchArea {
                            enabled: !root.disabled;
                            mouse-cursor: pointer;
                            clicked => {
                                root.attachment-clicked();
                            }
                        }
                    }
                }
            }
        }

        // Main input area - using HorizontalLayout for proper width distribution
        HorizontalLayout {
            width: 100%;
            height: root.content-height + Spacing.sm * 2;
            padding-left: Spacing.md;
            padding-right: Spacing.md;
            padding-top: Spacing.sm;
            padding-bottom: Spacing.sm;
            spacing: Spacing.sm;
            alignment: stretch;

            // Attachment button (left side)
            Rectangle {
                width: 36px;
                height: 36px;
                background: attachment-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                accessible-label: "Attach file";

                Text {
                    text: "\u{1F4CE}\u{FE0F}";  // Paperclip (with emoji variant selector)
                    font-size: Typography.lg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                attachment-touch := TouchArea {
                    enabled: !root.disabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.attachment-clicked();
                    }
                }
            }

            // Text input area
            Rectangle {
                horizontal-stretch: 1;
                height: root.content-height;
                background: Colors.background;
                border-radius: Spacing.radius-md;
                border-width: 1px;
                border-color: text-input.has-focus ? Colors.primary : Colors.surface-hover;
                opacity: root.disabled ? 0.5 : 1.0;
                clip: true;  // Prevent text from overflowing outside input bounds
                accessible-role: AccessibleRole.text-input;
                accessible-label: "Message input";

                // Placeholder text (shown when empty, fades on focus)
                if root.text == "": Text {
                    x: Spacing.md;
                    y: (parent.height - self.preferred-height) / 2;
                    width: parent.width - Spacing.md * 2;
                    text: root.placeholder;
                    color: Colors.text-muted;
                    font-size: Typography.base;
                    wrap: word-wrap;
                    opacity: text-input.has-focus ? 0.5 : 1.0;
                    animate opacity { duration: 150ms; }
                }

                // Text input
                text-input := TextInput {
                    x: Spacing.md;
                    y: Spacing.sm;
                    width: parent.width - Spacing.md * 2;
                    color: Colors.text-primary;
                    font-size: Typography.base;
                    text <=> root.text;
                    enabled: !root.disabled;
                    wrap: word-wrap;
                    single-line: false;

                    // Handle Enter key - send on Enter, newline on Shift+Enter
                    key-pressed(event) => {
                        if (event.text == "\n" && !event.modifiers.shift) {
                            // Enter without Shift - send message
                            if (root.can-send) {
                                if (root.is-editing) {
                                    root.send-edit(root.edit-message-id, root.text);
                                } else {
                                    root.send(root.text);
                                }
                                root.text = "";
                            }
                            return accept;
                        }
                        return reject;
                    }

                    // Handle text changes for @ mention detection and typing indicator
                    edited => {
                        // Check for @ mention trigger
                        if (self.text != "") {
                            root.check-mention-trigger(self.text);
                        }
                        // Emit typing state change
                        root.typing-changed(self.text != "");
                    }
                }
            }

            // Emoji button
            Rectangle {
                width: 36px;
                height: 36px;
                background: emoji-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                accessible-label: "Emoji picker";

                Text {
                    text: "\u{1F600}\u{FE0F}";
                    font-size: Typography.lg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                emoji-touch := TouchArea {
                    enabled: !root.disabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.emoji-clicked();
                    }
                }
            }

            // GIF button
            Rectangle {
                width: 36px;
                height: 36px;
                background: gif-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                accessible-label: "GIF picker";

                Text {
                    text: "GIF";
                    color: Colors.text-secondary;
                    font-size: 11px;
                    font-weight: Typography.bold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                gif-touch := TouchArea {
                    enabled: !root.disabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.gif-clicked();
                    }
                }
            }

            // Send button (visible when can send)
            if root.can-send: Rectangle {
                width: 36px;
                height: 36px;
                background: send-touch.has-hover ? Colors.primary-hover : Colors.primary;
                border-radius: Spacing.radius-sm;
                opacity: root.disabled ? 0.5 : 1.0;
                accessible-role: button;
                accessible-label: "Send message";

                Text {
                    text: "\u{27A4}";  // Right arrow
                    color: Colors.text-primary;
                    font-size: Typography.base;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                send-touch := TouchArea {
                    enabled: !root.disabled && root.can-send;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.is-editing) {
                            root.send-edit(root.edit-message-id, root.text);
                        } else {
                            root.send(root.text);
                        }
                        root.text = "";
                    }
                }
            }
        }
    }

    // Internal function to check for @ mention trigger
    // Called when text is edited
    function check-mention-trigger(t: string) {
        // Simple implementation: check if there's an @ near the end
        // A more sophisticated implementation would track cursor position
        // For now, we'll emit mention-triggered if text contains @
        // and there's content after it (no space before the @'s content)

        // This is a basic heuristic - in practice, you'd want cursor position tracking
        // to properly detect when user types @
    }
}
