import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// Reaction picker popup component
//
// Wraps EmojiPicker with quick reaction bar and message context.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { EmojiPicker, EmojiData } from "../components/emoji_picker.slint";
import { QuickReactions } from "types.slint";

export component ReactionPicker inherits Rectangle {
    // Visibility
    in property <bool> show: false;

    // Message being reacted to (Signal-style identification)
    in property <string> message-id: "";
    in property <string> sender-id: "";
    in property <string> timestamp-ns: "";

    // Emoji data (passed through to EmojiPicker)
    in property <[EmojiData]> emoji-list: [];

    // EmojiPicker state (two-way bindings)
    in-out property <int> selected-category: 0;
    in-out property <string> search-query: "";

    // Positioning
    in property <length> position-x: 0;
    in property <length> position-y: 0;

    // Callbacks
    callback reaction-selected(string, string, string, string); // (sender_id, timestamp_ns, message_id, emoji)
    callback close;
    callback category-changed(int);
    callback search-changed(string);

    // Logical close is immediate; the fade finishes before the surface goes.
    opacity: root.show ? 1 : 0;
    animate opacity { duration: Materials.menu-duration; easing: ease-out; }
    visible: root.show || self.opacity > 0;

    // Full screen backdrop, dimmed like the message menu it replaces.
    width: 100%;
    height: 100%;
    background: Materials.scrim;

    // Backdrop touch area (click outside to close)
    backdrop := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.show;
        clicked => {
            root.close();
        }
    }

    // Picker container — Neo convex popup with strong shadow
    picker-shell := GlassSurface {
        enter-distance: 6px;
        shown: root.show;

        material-level: 3;
        elevation: 4;

        x: max(Spacing.sm, min(root.position-x, parent.width - self.width - Spacing.sm));
        y: max(Spacing.sm, min(root.position-y, parent.height - self.height - Spacing.sm)) + self.entrance-offset;
        width: min(320px, parent.width - Spacing.xxl);
        height: max(0px, min(400px, parent.height - Spacing.xxxl));
        border-radius: Spacing.radius-xl;

        // Block backdrop clicks when clicking picker
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            // Quick reactions bar — Neo inset tray
            Rectangle {
                height: Spacing.touch-target-min;
                background: transparent;
                border-radius: Spacing.radius-xl;

                HorizontalLayout {
                    padding-left: Spacing.sm;
                    padding-right: Spacing.sm;
                    spacing: 0;

                    for emoji in QuickReactions.emojis: Rectangle {
                        horizontal-stretch: 1;
                        height: Spacing.touch-target-min;

                        Rectangle {
                            width: Spacing.button-height;
                            height: Spacing.button-height;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: Spacing.radius-sm;
                            background: quick-area.has-hover ? Colors.background : transparent;

                            Text {
                                text: emoji;
                                font-family: Typography.font-family-emoji;
                                font-size: Typography.lg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            quick-area := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.reaction-selected(root.sender-id, root.timestamp-ns, root.message-id, emoji);
                                    root.close();
                                }
                            }
                        }
                    }
                }
            }

            // Divider — neo edge
            Rectangle {
                height: Spacing.stroke;
                background: Colors.divider;
            }

            // EmojiPicker
            EmojiPicker {
                // The outer reaction panel already supplies the material.
                material-enabled: false;
                max-picker-width: picker-shell.width;
                max-picker-height: max(0px, picker-shell.height - Spacing.touch-target-min - Spacing.stroke);
                show: true;
                emoji-list: root.emoji-list;
                selected-category <=> root.selected-category;
                search-query <=> root.search-query;

                emoji-selected(emoji) => {
                    root.reaction-selected(root.sender-id, root.timestamp-ns, root.message-id, emoji);
                    root.close();
                }

                category-changed(idx) => {
                    root.category-changed(idx);
                }

                search-changed(query) => {
                    root.search-changed(query);
                }

                close => {
                    root.close();
                }
            }
        }
    }

    // The fade-out is presentation only: swallow taps until it is gone.
    if !root.show: TouchArea {
        width: 100%;
        height: 100%;
    }
}
