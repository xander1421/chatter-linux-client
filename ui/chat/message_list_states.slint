// Loading and empty states for the virtualized conversation list.
import { Colors } from "../theme/colors.slint";
import { Icons } from "../theme/icons.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Skeleton } from "../components/skeleton.slint";

export component MessageListLoading inherits VerticalLayout {
    in property <length> top-inset;
    in property <length> bottom-inset;
    padding: Spacing.md;
    padding-top: root.top-inset + Spacing.md;
    padding-bottom: root.bottom-inset + Spacing.md;
    spacing: Spacing.lg;
    for _ in [1, 2, 3, 4, 5]: HorizontalLayout {
        spacing: Spacing.sm;
        // Avatar skeleton
        Skeleton {
            width: Spacing.avatar-sm;
            height: Spacing.avatar-sm;
            border-radius: Spacing.avatar-sm / 2;
        }
        // Content skeleton
        VerticalLayout {
            spacing: Spacing.xs;
            // Name and timestamp
            HorizontalLayout {
                spacing: Spacing.sm;
                Skeleton {
                    width: 80px;
                    height: 14px;
                    border-radius: 4px;
                }
                Skeleton {
                    width: 40px;
                    height: 12px;
                    border-radius: 4px;
                }
            }
            // Message content (2 lines)
            Skeleton {
                width: 200px;
                height: 14px;
                border-radius: 4px;
            }
            Skeleton {
                width: 150px;
                height: 14px;
                border-radius: 4px;
            }
        }
    }

}

export component MessageListEmpty inherits Rectangle {
    in property <bool> public-broadcast;
    in property <string> privacy-line;
    in property <bool> saved-messages;
    VerticalLayout {
        alignment: center;
        padding: Spacing.xl;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                max-width: 440px;
                horizontal-stretch: 1;
                spacing: Spacing.xl;
                VerticalLayout {
                    spacing: Spacing.lg;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: root.saved-messages ? Icons.bookmark : Icons.message-circle;
                            width: 18px;
                            height: 18px;
                            colorize: Colors.text-secondary;
                        }
                    }
                    VerticalLayout {
                        spacing: Spacing.sm;
                        Text {
                            text: root.saved-messages ? "Your saved messages" : "No messages yet";
                            color: Colors.text-primary;
                            font-size: Typography.lg;
                            font-weight: Typography.medium;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            min-width: 0px;
                        }
                        Text {
                            text: root.saved-messages ? "Forward messages here or write notes to yourself"
                                : "Write a message to start the conversation";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            min-width: 0px;
                        }
                    }
                }
                // Keep the caller's privacy statement: public broadcasts must
                // retain their globe and warning color, never an encryption claim.
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.sm;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.public-broadcast ? Icons.globe : Icons.lock;
                            width: 18px;
                            height: 18px;
                            colorize: root.public-broadcast ? Colors.warning : Colors.text-secondary;
                        }
                    }
                    Text {
                        text: root.privacy-line;
                        color: root.public-broadcast ? Colors.warning : Colors.text-secondary;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        min-width: 0px;
                    }
                }
            }
        }
    }

}
