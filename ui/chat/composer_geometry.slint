import { Spacing } from "../theme/spacing.slint";
import { Appearance } from "../theme/appearance.slint";
import { Materials } from "../theme/materials.slint";

// The field keeps its own clean edge. Its two brief surface waves are strongest
// while the controls leave their slots and disappear once they float free.
export component LiquidComposerSilhouette inherits Path {
    in property <float> rise;
    in property <float> velocity;
    in property <float> field-top;
    in property <bool> trailing-drop;
    property <float> w: self.width / 1px;
    property <float> h: self.height / 1px;
    property <float> p: min(1, max(0, rise));
    // The bar's own GlassSurface edge uses radius-chrome; a different corner
    // here drew a second, offset outline at every corner.
    property <float> r: Spacing.radius-chrome / 1px;
    property <float> k: r * 0.4477;
    property <float> wave: min(10, max(0, (1 - p) * p * 36 + max(0, -velocity) * 14));
    // The bar's GlassSurface owns the backdrop. A thin tint grows only with
    // the lifted wave, keeping the resting bar identical to the bottom dock.
    fill: Appearance.glass-effects ? transparent.mix(Materials.ultra-thin, p) : transparent;
    stroke: Materials.glass-edge;
    stroke-width: Materials.glass-edge-width;
    viewbox-width: w;
    viewbox-height: h;
    fit: fill;
    MoveTo { x: 0; y: h - r; }
    LineTo { x: 0; y: field-top + r; }
    CubicTo { control-1-x: 0; control-1-y: field-top + k;
        control-2-x: k; control-2-y: field-top; x: r; y: field-top; }
    CubicTo { control-1-x: r + 5; control-1-y: field-top - wave;
        control-2-x: r + 14; control-2-y: field-top - wave; x: r + 26; y: field-top; }
    LineTo { x: trailing-drop ? w - r - 26 : w - r; y: field-top; }
    CubicTo { control-1-x: trailing-drop ? w - r - 14 : w - r;
        control-1-y: trailing-drop ? field-top - wave : field-top;
        control-2-x: trailing-drop ? w - r - 5 : w - r;
        control-2-y: trailing-drop ? field-top - wave : field-top;
        x: w - r; y: field-top; }
    CubicTo { control-1-x: w - k; control-1-y: field-top;
        control-2-x: w; control-2-y: field-top + k; x: w; y: field-top + r; }
    LineTo { x: w; y: h - r; }
    CubicTo { control-1-x: w; control-1-y: h - k;
        control-2-x: w - k; control-2-y: h; x: w - r; y: h; }
    LineTo { x: r; y: h; }
    CubicTo { control-1-x: k; control-1-y: h;
        control-2-x: 0; control-2-y: h - k; x: 0; y: h - r; }
    Close { }
}

// A transient tapered bridge pinches off as the circle separates. Reversing
// the same lift progress reconnects it on the way back into the bar.
export component DropletNeck inherits Path {
    in property <float> rise;
    in property <float> field-top;
    in property <float> circle-bottom;
    property <float> p: min(1, max(0, rise));
    property <float> start: min(circle-bottom - 7, field-top - 6);
    property <float> half-width: 2 + 12 * (1 - p);
    width: 48px;
    fill: Appearance.glass-effects ? Materials.chat-chrome : Materials.opaque;
    opacity: min(1, max(0, (p - 0.08) * 8)) * min(1, max(0, (0.96 - p) * 14));
    viewbox-width: 48;
    viewbox-height: self.height / 1px;
    fit: fill;
    MoveTo { x: 15; y: start; }
    CubicTo { control-1-x: 20; control-1-y: start + 3;
        control-2-x: 24 - half-width; control-2-y: field-top - 3;
        x: 24 - half-width; y: field-top + 2; }
    LineTo { x: 24 + half-width; y: field-top + 2; }
    CubicTo { control-1-x: 24 + half-width; control-1-y: field-top - 3;
        control-2-x: 28; control-2-y: start + 3; x: 33; y: start; }
    Close { }
}

