// "Delete message?" — the confirm Signal shows before a delete-for-me, for
// one message (context menu) or a multi-select. Delete for me cannot be
// undone and syncs to the user's other devices (`delete_for_me`), so it never
// runs on the first tap.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";

export component DeleteForMeConfirm inherits Rectangle {
    // Messages the delete would remove; 0 hides the dialog.
    in property <int> count: 0;

    callback confirmed();
    callback cancelled();

    Modal {
        show: root.count > 0;
        title: root.count > 1 ? "Delete " + root.count + " messages?" : "Delete message?";
        modal-width: 400px;

        close => { root.cancelled(); }

        VerticalLayout {
            spacing: Spacing.md;

            Text {
                text: root.count > 1
                    ? "These messages will be deleted from all your devices."
                    : "This message will be deleted from all your devices.";
                color: Colors.text-secondary;
                font-size: Typography.sm;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Spacing.sm;
                alignment: end;

                Button {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.cancelled(); }
                }

                Button {
                    text: "Delete for me";
                    variant: "danger";
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
