// Members panel — right-side panel showing channel/group members and their roles.
//
// Toggled by the members button in the chat header.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { ScrollView } from "std-widgets.slint";
import { ChannelMemberData } from "../modals/channel_settings.slint";

// Re-export for parent
export { ChannelMemberData }

component RoleBadge inherits Rectangle {
    in property <string> role;

    property <color> badge-color: role == "owner"     ? Colors.warning
                                : role == "admin"      ? Colors.primary
                                : role == "moderator"  ? Colors.success
                                : transparent;

    property <bool> show-badge: role == "owner" || role == "admin" || role == "moderator";

    visible: show-badge;
    height: 18px;
    width: role-text.preferred-width + 10px;
    background: badge-color.with-alpha(0.15);
    border-radius: Spacing.radius-sm;

    role-text := Text {
        text: role;
        font-size: Typography.xs;
        font-weight: Typography.semibold;
        color: badge-color;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component MemberItem inherits Rectangle {
    in property <string> display-name;
    in property <string> username;
    in property <string> role;
    in property <string> user-id;

    callback clicked(string);  // user-id

    height: 48px;
    background: touch.has-hover ? Colors.surface-hover : transparent;
    border-radius: Spacing.radius-sm;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.user-id); }
    }

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.sm;

        // Avatar placeholder
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: Colors.primary.with-alpha(0.15);

            Text {
                text: {
                    // First letter of display name
                    if root.display-name.character-count > 0 {
                        root.display-name
                    } else {
                        "?"
                    }
                };
                font-size: Typography.sm;
                font-weight: Typography.semibold;
                color: Colors.primary;
                vertical-alignment: center;
                horizontal-alignment: center;
                // Only show first character
                max-width: 14px;
                overflow: clip;
            }
        }

        // Name + role
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Spacing.xs;

                Text {
                    text: root.display-name;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                    color: Colors.text-primary;
                    overflow: elide;
                    vertical-alignment: center;
                }

                RoleBadge {
                    role: root.role;
                }
            }

            if root.username != "" && root.username != root.display-name: Text {
                text: "@\{root.username}";
                font-size: Typography.xs;
                color: Colors.text-muted;
                overflow: elide;
            }
        }
    }
}

export component MembersPanel inherits Rectangle {
    in property <[ChannelMemberData]> members: [];
    in property <string> channel-name: "";
    in property <bool> loading: false;

    callback close-clicked();
    callback member-clicked(string);  // user-id

    width: 280px;
    background: Colors.surface;

    // Left border separator
    Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Colors.text-muted.with-alpha(0.2);
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        // Header (48px)
        Rectangle {
            height: 48px;

            HorizontalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.sm;

                // Title
                Text {
                    text: "Members";
                    font-size: Typography.base;
                    font-weight: Typography.semibold;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Member count
                Text {
                    text: "\{root.members.length}";
                    font-size: Typography.sm;
                    color: Colors.text-muted;
                    vertical-alignment: center;
                }

                // Close button
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: close-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;

                    Text {
                        text: "\u{2715}";
                        font-size: Typography.base;
                        color: close-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                    }
                }
            }

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Colors.text-muted.with-alpha(0.2);
            }
        }

        // Member list
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Spacing.sm;
                spacing: 2px;

                for member in root.members: MemberItem {
                    display-name: member.display-name;
                    username: member.username;
                    role: member.role;
                    user-id: member.user-id;
                    clicked(uid) => { root.member-clicked(uid); }
                }
            }
        }
    }
}
