// Disappearing messages — runtime state pushed from Rust
// (`bin_ui::features::chat::disappearing`). Every value here was produced by
// `chatter_core::services::disappearing`; the view only lays it out.

// One choice in the timer picker (Signal's presets: Off, 30s … 4 weeks).
export struct DisappearingOption {
    seconds: int,
    label: string,
}

export global DisappearingGlobal {
    // The open conversation's timer, compact ("1h", "4w"); "" = off. Drawn
    // next to the name in the chat header.
    in property <string> header-label: "";
    // The open conversation's timer in words ("1 hour"); "Off" when off.
    in property <string> active-label: "Off";

    // Contact screen (the DM's settings): whether this user can change the
    // timer of the DM with the profile shown (friends only), its current
    // value, and the choices.
    in property <bool> dm-can-set: false;
    in property <int> dm-seconds: 0;
    in property <string> dm-label: "Off";
    in property <[DisappearingOption]> options: [];

    // Change the DM timer with `peer-id` to `seconds` (0 = off).
    callback set-dm-timer(string /* peer-id */, int /* seconds */);
}
