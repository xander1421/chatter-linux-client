// The strip under a channel's header while its membership is not verified
// (failed verification, a fork, or no verified state yet). Sending is paused
// for exactly these states (`GroupStateGate::for_distribution`).
//
// Wording comes from chatter-core (`ChatterClient::channel_membership_header`).
// Not dismissable: it explains why the channel will not send. "Details"
// reveals the core-supplied explanation and state code; for a fork, which
// nothing else clears, it also offers "Resume sending" (core decides when).

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { MembershipGlobal } from "membership_global.slint";

export component MembershipBar inherits Rectangle {
    in property <string> channel-id;
    property <bool> alert: MembershipGlobal.banner-severity == "alert";
    property <color> accent: root.alert ? Colors.error : Colors.warning;
    property <bool> expanded: false;

    changed alert => { self.expanded = false; }

    min-height: 24px;
    // Opaque: the list scrolls under this strip.
    background: Colors.surface.mix(root.accent, root.alert ? 0.82 : 0.88);

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: root.accent.with-alpha(0.35);
    }

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: Spacing.sm;
        padding-bottom: Spacing.sm;
        spacing: Spacing.sm;

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            Image {
                source: root.alert ? Icons.alert-triangle : Icons.shield;
                width: 16px;
                height: 16px;
                colorize: root.accent;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Spacing.xxs;

            Text {
                text: MembershipGlobal.banner-title;
                color: Colors.text-primary;
                font-size: Typography.sm;
                font-weight: 600;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: MembershipGlobal.banner-title;
            }

            if root.expanded: Text {
                text: MembershipGlobal.banner-detail;
                color: Colors.text-muted;
                font-size: Typography.xs;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: MembershipGlobal.banner-detail;
            }

            if root.expanded && MembershipGlobal.banner-can-acknowledge: HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: resume-label.preferred-width + Spacing.lg;
                    height: Spacing.touch-target-min;
                    border-radius: Spacing.radius-sm;
                    background: resume-touch.has-hover ? root.accent.with-alpha(0.28) : root.accent.with-alpha(0.16);

                    resume-label := Text {
                        text: "Resume sending";
                        color: Colors.text-primary;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    resume-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Resume sending in this channel";
                        clicked => { MembershipGlobal.acknowledge-fork(root.channel-id); }
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: details-label.preferred-width + Spacing.lg;
                height: Spacing.touch-target-min;
                border-radius: Spacing.radius-sm;
                background: details-touch.has-hover ? root.accent.with-alpha(0.28) : root.accent.with-alpha(0.16);

                details-label := Text {
                    text: root.expanded ? "Hide" : "Details";
                    color: Colors.text-primary;
                    font-size: Typography.xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                details-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: root.expanded ? "Hide membership details" : "Show membership details";
                    clicked => { root.expanded = !root.expanded; }
                }
            }
        }
    }
}
