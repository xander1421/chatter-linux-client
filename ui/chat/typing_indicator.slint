import { GlassSurface } from "../components/glass_surface.slint";
// Typing indicator component
//
// Shows animated dots and smart user list formatting for typing status.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

// A single capsule for the status, with plain animated dots.
export component TypingIndicator inherits GlassSurface {
    // Properties - typing-text is pre-formatted by Rust
    in property <string> typing-text: "";
    in property <bool> visible: typing-text != "";

    // Accessibility: announce typing status to screen readers
    accessible-role: text;
    accessible-label: typing-text;

    // Animation timer (0.0 to 1.0 cycling)
    property <float> animation-progress: 0.0;

    // Animation: cycle through 0.0 to 1.0 over 600ms
    states [
        animating when visible: {
            animation-progress: 1.0;
            in {
                animate animation-progress {
                    duration: 600ms;
                    iteration-count: -1;
                }
            }
        }
    ]

    // Calculate dot opacities with staggered timing
    // Dot 1: 0ms offset (0.0-0.33 of cycle)
    // Dot 2: 200ms offset (0.33-0.66 of cycle)
    // Dot 3: 400ms offset (0.66-1.0 of cycle)
    pure function dot-opacity(dot-index: int) -> float {
        // Each dot peaks at a different phase
        // Use a smooth wave pattern
        if dot-index == 0 {
            // Dot 1: peaks at 0.0/1.0
            0.3 + 0.7 * Math.max(0.0, Math.cos(animation-progress * 6.28318))
        } else if dot-index == 1 {
            // Dot 2: peaks at 0.33
            0.3 + 0.7 * Math.max(0.0, Math.cos((animation-progress - 0.33) * 6.28318))
        } else {
            // Dot 3: peaks at 0.66
            0.3 + 0.7 * Math.max(0.0, Math.cos((animation-progress - 0.66) * 6.28318))
        }
    }

    // Layout
    height: visible ? 28px : 0px;
    border-radius: 14px;
    elevation: 0;
    opacity: visible ? 1.0 : 0.0;

    HorizontalLayout {
        spacing: Spacing.xs;
        alignment: start;
        padding-left: Spacing.sm;

        // Animated dots
        HorizontalLayout {
            spacing: 3px;
            alignment: center;

            // Dot 1 — Neo convex bump
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Colors.primary;
                opacity: dot-opacity(0);
            }

            // Dot 2 — Neo convex bump
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Colors.primary;
                opacity: dot-opacity(1);
            }

            // Dot 3 — Neo convex bump
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Colors.primary;
                opacity: dot-opacity(2);
            }
        }

        // Typing text
        Text {
            text: typing-text;
            color: Colors.text-muted;
            font-size: Typography.xs;
            font-style: italic;
            vertical-alignment: center;
        }
    }
}
