import { ActivityGlobal } from "../activity/activity_global.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component MessageThreadIndicator inherits HorizontalLayout {
    in property <bool> is-own;
    in property <string> message-id;
    in property <string> reply-count-text;
    callback thread-clicked(string);

    private property <bool> unread: ActivityGlobal.is-thread-unread(ActivityGlobal.unread-thread-roots, root.message-id);
    private property <brush> label-color: root.unread ? Colors.primary : Colors.text-secondary;

    alignment: root.is-own ? end : start;
    Rectangle {
        height: max(24px, thread-layout.preferred-height);
        width: thread-layout.preferred-width;
        border-radius: Spacing.radius-full;
        border-width: 1px;
        border-color: Colors.border;
        background: thread-touch.has-hover || thread-touch.pressed ? Colors.surface-control : transparent;
        accessible-role: button;
        accessible-label: @tr("Open thread: {}", root.reply-count-text);
        accessible-action-default => { root.thread-clicked(root.message-id); }

        thread-layout := HorizontalLayout {
            height: parent.height;
            padding: Spacing.xxs;
            padding-left: Spacing.sm;
            padding-right: Spacing.sm;
            alignment: center;

            Text {
                text: root.reply-count-text;
                color: root.label-color;
                font-size: Typography.xs;
                vertical-alignment: center;
            }
        }

        thread-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.thread-clicked(root.message-id); }
        }
    }
}
