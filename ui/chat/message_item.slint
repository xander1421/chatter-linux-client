import { IconAction } from "../components/icon_action.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
// Single message item component with bubble layout
//
// Displays an individual message with chat-style bubbles.
// Own messages: right-aligned with primary tint
// Others' messages: left-aligned with surface color
// DMs: No avatar/name (minimal), Channels: Avatar/name for others

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Elevation } from "../theme/elevation.slint";
import { Typography } from "../theme/typography.slint";
import { Avatar } from "../components/avatar.slint";
import { Haptics } from "../components/haptics.slint";
import { MessageAttachmentData, ReactionEntry, RichTextBlock } from "types.slint";
import { Icons } from "../theme/icons.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { AudioPlayer } from "audio_player.slint";
import { HoldArea } from "../components/hold_area.slint";

export component MessageItem inherits Rectangle {
    // Message identity
    in property <string> message-id: "";
    in property <string> sender-id: "";
    in property <string> timestamp-ns: "";

    // Sender info
    in property <string> sender-name: "";
    in property <string> sender-initials: "";
    in property <image> sender-avatar-source;
    in property <bool> has-avatar: false;

    // Content
    in property <string> content: "";
    in property <[RichTextBlock]> rich-content: [];
    in property <string> timestamp: "";

    // Ordinary messages have one span, even when they contain no markdown.
    // Keep that common case out of the nested rich-text layout/repeater.
    property <length> text-max-width: root.width * 0.7 - Spacing.sm * 2;

    // Flags
    in property <bool> is-own: false;
    in property <bool> is-edited: false;
    in property <bool> is-deleted: false;
    in property <bool> is-system: false;
    in property <bool> is-ai: false;
    in property <bool> is-pinned: false;
    in property <bool> show-sender: true;
    in property <bool> is-anonymous: false;
    in property <bool> is-dm: false;  // When true, hide avatar/name - just bubbles
    in property <bool> can-thread: true;  // Threads are a channel feature
    in property <string> failure-reason: "";
    in property <string> delivery-status: "";  // "sending", "unconfirmed", "sent", "failed", "delivered", "read" for own messages
    /// Whether this message went over the mesh. Set by the caller rather than
    /// inferred from the status string: "sent" is a mesh state too — in fact the
    /// most common one, since every room and cell message is a broadcast — so a
    /// string allowlist silently sends the majority of mesh traffic down the
    /// tick path it exists to avoid.
    in property <bool> is-mesh: false;
    // Mesh delivery is rendered as words, never ticks. Over couriers "sent" and
    // "delivered" can be hours apart, and a tick carries a learned promise
    // ("this lands in a second") that is wrong here by orders of magnitude.
    property <bool> mesh-delivery: root.is-mesh && root.delivery-status != "";

    // Call message
    in property <bool> is-call: false;
    callback sender-profile-requested(string);
    in property <string> call-type: "";
    in property <string> call-duration: "";

    // Attachments
    in property <bool> has-attachments: false;
    in property <int> attachment-count: 0;
    in property <[MessageAttachmentData]> attachments: [];

    // Audio playback state
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;
    in property <float> audio-progress: 0.0;
    in property <string> audio-elapsed: "0:00";

    // Reactions
    in property <bool> has-reactions: false;
    in property <string> reaction-summary: "";
    in property <[ReactionEntry]> reactions: [];

    // Thread
    in property <int> reply-count: 0;
    in property <string> reply-count-text: "";
    in property <bool> is-thread-reply: false;

    // Message grouping
    in property <bool> is-continuation: false;  // Hide avatar/name for consecutive same-sender messages

    // Quote / reply-to context
    in property <bool> is-reply: false;
    in property <bool> reply-to-not-found: false;  // Quoted parent missing/deleted
    in property <string> reply-to-message-id: "";  // Parent MessageId — tap-to-jump target
    in property <bool> highlighted: false;          // Brief green flash when this is a jump target
    // Animate outside the conditional overlay so it survives until fade-out ends.
    property <float> highlight-progress: root.highlighted ? 1.0 : 0.0;
    animate highlight-progress { duration: Materials.motion-standard; easing: Materials.glide; }
    in property <string> reply-to-sender-name: "";
    in property <string> reply-to-preview: "";
    in property <string> reply-to-category: "";        // Quoted parent media category ("audio"/"image"/"video"/"")
    in property <string> reply-to-attachment-id: "";    // Quoted parent's media attachment id (inline quote player)
    in property <string> reply-to-duration: "";         // Quoted audio parent duration ("0:37")
    in property <string> reply-to-filename: "";         // Quoted audio parent filename (inline quote player)
    in property <[int]> reply-to-waveform: [];          // Quoted audio parent waveform (32 values 0-100)
    in property <bool> reply-to-has-thumbnail: false;
    in property <image> reply-to-thumbnail;
    in property <int> reply-to-thumbnail-width: 0;      // Quoted thumbnail natural dims for aspect sizing (0 = unknown)
    in property <int> reply-to-thumbnail-height: 0;

    // Internal hover state — touch covers entire message row.
    //
    // Pointer-only, deliberately. `has-hover` is true while a finger is DOWN,
    // not just under a mouse: Slint sets it from any pointer event carrying a
    // position (i-slint-core input_items.rs), so on Android the action bar
    // below flashed into existence mid-press and vanished on release. You had
    // to predict where it would draw and land on it blind, and a plain scroll
    // spawned it under the thumb. Press-and-hold (below) is the touch entry
    // point to the same menu, so gating this on `!mobile` costs touch nothing.
    // While the context menu or reaction picker is up for any message, the
    // hover bar hides: two menus for one message read as competing controls.
    in property <bool> menu-open: false;
    property <bool> is-hovered: !root.mobile && !root.menu-open && touch.has-hover;

    // Multi-select
    in property <bool> selected: false;
    // The list marks only a newly appended row. Virtualized history rows
    // remain still when they are recycled during a scroll.
    in property <bool> animate-arrival: false;
    in property <int> arrival-stagger-index: 0;
    property <float> arrival-progress: 1;
    init => {
        if (root.animate-arrival) {
            arrival-timer.running = true;
            root.arrival-progress = 0;
        }
    }
    changed animate-arrival => {
        if (root.animate-arrival) {
            arrival-timer.running = true;
            root.arrival-progress = 0;
        }
    }
    arrival-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => { self.running = false; root.arrival-progress = 1; }
    }
    animate arrival-progress {
        duration: arrival-timer.running ? 0ms : Materials.motion-emphasized;
        easing: Materials.spring;
        delay: Appearance.reduce-motion ? 0ms : min(root.arrival-stagger-index, 5) * 30ms / Appearance.animation-speed;
    }
    in property <bool> selection-mode: false;
    // Touch platform. Gates the hold gesture so a desktop left-button hold
    // does not open the menu (desktop keeps right-click).
    in property <bool> mobile: false;
    // Core's permission for forwarding from the open conversation.
    in property <bool> can-forward: false;

    // Callbacks
    callback reply-clicked(string, string);
    // A horizontal bubble swipe owns the gesture: the host list stops
    // scrolling so a few pixels of vertical drift cannot steal it.
    callback swipe-engaged(bool);
    callback forward-clicked(string, string);
    callback react-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    // Tapping an existing reaction toggles YOUR reaction of that emoji. Before
    // this the whole pill only opened the picker, so there was no way to take a
    // reaction back except adding it again from the picker (§112w).
    callback reaction-toggled(string, string, string);  // (sender_id, timestamp_ns, emoji)
    callback thread-clicked(string);
    callback more-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    out property <length> menu-anchor-top: 0px;
    out property <length> menu-anchor-bottom: 0px;
    out property <length> menu-anchor-left: 0px;
    out property <length> menu-anchor-right: 0px;
    callback selection-toggled(string);
    callback open-message-link(string);
    callback message-clicked(string);
    callback attachment-clicked(string);
    // Synchronous image-viewer origin. The existing attachment callback stays
    // intact for direct MessageItem users such as the thread panel.
    out property <length> viewer-origin-x: 0px;
    out property <length> viewer-origin-y: 0px;
    out property <length> viewer-origin-width: 0px;
    out property <length> viewer-origin-height: 0px;
    function open-image(id: string, x: length, y: length, width: length, height: length) {
        root.viewer-origin-x = x;
        root.viewer-origin-y = y;
        root.viewer-origin-width = width;
        root.viewer-origin-height = height;
        root.attachment-clicked(id);
    }
    function open-other-attachment(id: string) {
        root.viewer-origin-width = 0px;
        root.viewer-origin-height = 0px;
        root.attachment-clicked(id);
    }
    callback audio-seek(string, float);
    callback quote-clicked(string);  // (reply-to-message-id) — jump to quoted original

    // ── Press-and-hold gesture (touch only) ──
    //
    // >= 500ms opens the message menu, anchored under the bubble. Moving more
    // than the slop cancels: it was a scroll, not a hold.
    //
    // A second tier (>= 1200ms escalating into multi-select) was built and
    // removed. It cannot work while tier 1 shows a full-screen-backdrop menu:
    // the backdrop takes the pointer grab the instant it appears, Slint
    // delivers the loss as PointerEventKind::Cancel, and the gesture ends
    // there. Verified on device — a 1600ms hold produced the menu and nothing
    // else. Multi-select is reached by "Select" in that menu instead.
    //
    // Driven by our own timers rather than by the platform long-press, because
    // there is no platform long-press to ride: the Android backend in this tree
    // only ever produces PointerEventButton::Right from a real secondary mouse
    // button (androidwindowadapter.rs button_for_event — a finger goes through
    // MotionAction::Down and yields Left). The right-button branch below is
    // therefore desktop-only, and the two paths cannot both fire.
    property <length> hold-slop: 12px;
    property <length> press-x: 0px;
    property <length> press-y: 0px;
    // Where the menu should anchor. Captured at touch-down from the bubble's
    // own TouchArea: `bubble` sits inside a conditional subtree, so its id is
    // not reachable from a component-level function.
    property <length> anchor-x: 0px;
    property <length> anchor-y: 0px;
    function request-menu(x: length, y: length, top: length, bottom: length, left: length, right: length) {
        root.menu-anchor-top = top;
        root.menu-anchor-bottom = bottom;
        root.menu-anchor-left = left;
        root.menu-anchor-right = right;
        root.more-clicked(root.sender-id, root.timestamp-ns, x, y);
    }
    property <bool> holding: false;
    // 0 = nothing fired yet, 1 = menu opened, 2 = selection engaged. Also used
    // to swallow the release-tap, so a hold never doubles as a click.
    property <int> hold-tier: 0;
    // Touch swipe starts only after horizontal travel wins over scrolling.
    out property <bool> swipe-tracking: false;
    property <bool> swipe-active: false;
    property <bool> swipe-armed: false;
    property <bool> swipe-haptic-fired: false;
    property <length> swipe-offset: 0px;
    property <length> swipe-threshold: 36px;
    property <bool> swipe-forward: false;

    function begin-swipe(x: length, y: length) {
        root.swipe-tracking = root.mobile && !root.selection-mode
            && !root.is-deleted && !root.is-system && !root.is-call
            && (!root.is-own || (root.delivery-status != "failed" && root.delivery-status != "sending"));
        root.swipe-active = false;
        root.swipe-armed = false;
        root.swipe-haptic-fired = false;
        root.swipe-forward = false;
        root.swipe-offset = 0px;
        root.press-x = x;
        root.press-y = y;
    }

    function move-swipe(x: length, y: length) {
        if (!root.swipe-tracking || root.hold-tier != 0) { return; }
        let dx = x - root.press-x;
        let dy = y - root.press-y;
        let toward-center = root.is-own ? -dx : dx;
        let forward = toward-center < 0px;
        if (forward && !root.can-forward) {
            root.swipe-offset = 0px;
            root.swipe-armed = false;
            return;
        }
        if (!root.swipe-active) {
            if (abs(dy) > 9px && abs(dy) >= abs(dx)) {
                root.swipe-tracking = false;
                return;
            }
            if (abs(dx) < 9px || abs(dx) <= abs(dy)) { return; }
            root.swipe-active = true;
            root.swipe-engaged(true);
            root.cancel-hold();
        }
        if (root.swipe-forward != forward) { root.swipe-haptic-fired = false; }
        root.swipe-forward = forward;
        // Resistance beyond the action threshold keeps a long drag attached
        // to the bubble without letting it run away from the finger.
        let travel = abs(toward-center);
        let direction = (root.is-own ? -1 : 1) * (forward ? -1 : 1);
        root.swipe-offset = direction
            * (min(travel, root.swipe-threshold)
                + min(max(travel - root.swipe-threshold, 0px) * 0.33, 24px));
        let armed = travel >= root.swipe-threshold;
        if (armed && !root.swipe-haptic-fired) {
            Haptics.reply-ready();
            root.swipe-haptic-fired = true;
        }
        root.swipe-armed = armed;
    }

    function end-swipe(cancelled: bool) {
        let trigger = !cancelled && root.swipe-active && root.swipe-armed;
        if (root.swipe-active) { root.hold-tier = 3; root.swipe-engaged(false); }
        root.swipe-tracking = false;
        root.swipe-active = false;
        root.swipe-armed = false;
        root.swipe-offset = 0px;
        if (trigger) {
            if (root.swipe-forward) {
                root.forward-clicked(root.sender-id, root.timestamp-ns);
            } else {
                root.reply-clicked(root.sender-id, root.timestamp-ns);
            }
        }
    }

    function cancel-hold() {
        root.holding = false;
        tier1-timer.running = false;
    }

    // Both the bubble TouchArea and link-owned StyledText stream use absolute
    // coordinates, so movement and anchoring are identical across inline runs.
    function begin-message-press(x: length, y: length, menu-x: length, menu-y: length, menu-top: length, menu-right: length) {
        root.cancel-hold();
        root.begin-swipe(x, y);
        root.press-x = x;
        root.press-y = y;
        root.anchor-x = menu-x;
        root.anchor-y = menu-y;
        root.menu-anchor-top = menu-top;
        root.menu-anchor-bottom = menu-y;
        root.menu-anchor-left = menu-x;
        root.menu-anchor-right = menu-right;
        root.hold-tier = 0;
        if (root.mobile && !root.selection-mode
            && (!root.is-system || root.is-call) && !root.is-deleted) {
            root.holding = true;
            tier1-timer.running = true;
        }
    }

    function move-message-press(x: length, y: length) {
        root.move-swipe(x, y);
        if (root.holding
            && (abs(x - root.press-x) > root.hold-slop
                || abs(y - root.press-y) > root.hold-slop)) {
            root.cancel-hold();
        }
    }

    function open-menu() {
        root.request-menu(root.anchor-x, root.anchor-y, root.menu-anchor-top, root.menu-anchor-bottom,
            root.menu-anchor-left, root.menu-anchor-right);
    }

    tier1-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.hold-tier = 1;
            // Same tick as every other hold in the app (ui/components/hold_area.slint).
            // The bubble gesture predates that component and keeps its own timer,
            // so the feedback has to be repeated here or holds would feel
            // different depending on what you held.
            Haptics.long-press();
            root.open-menu();
        }
    }

    // Bubble corners (one rule for text, media and call bubbles): round
    // everywhere except the outer side — its bottom corner is the tail, and
    // its top corner tightens where the bubble continues a same-sender run,
    // so a run reads as one stacked group.
    property <length> r-round: Spacing.radius-bubble;
    property <length> r-outer-top: root.is-continuation ? Spacing.radius-bubble-joint : Spacing.radius-bubble;
    property <length> r-outer-bottom: Spacing.radius-bubble-joint;

    // Styling
    min-height: main-layout.preferred-height;
    // Selected rows tint rather than outline the flat bubbles.
    // Animate a private property so Slint can share MessageItem between the
    // main conversation and thread panel instead of inlining both trees.
    property <brush> selection-background: root.selected ? Colors.tint-strong : transparent;
    background: root.selection-background;
    animate selection-background { duration: Materials.motion-quick; easing: Materials.settle; }

    // Wrap entire content in TouchArea for reliable hover detection.
    // Width/Height 100% ensures it covers the whole row.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            // In selection mode a plain tap anywhere on the row toggles this
            // message instead of doing whatever a tap normally does.
            if (root.selection-mode) {
                root.selection-toggled(root.message-id);
                return;
            }
            root.message-clicked(root.message-id);
        }

    main-layout := VerticalLayout {
        width: 100%;
        y: (root.is-own ? 42px : 20px) * (1 - root.arrival-progress);
        opacity: root.arrival-progress;
        transform-origin: { x: root.is-own ? self.width : 0px, y: self.height };
        transform-scale-x: root.is-own ? 84% + 16% * root.arrival-progress : 96% + 4% * root.arrival-progress;
        transform-scale-y: root.is-own ? 84% + 16% * root.arrival-progress : 96% + 4% * root.arrival-progress;
        padding: root.is-continuation ? Spacing.message-padding-continuation : Spacing.message-padding;
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: root.is-continuation ? Spacing.xxs : Spacing.xs;

        // System message (centered, no bubble)
        if root.is-system && !root.is-call: Rectangle {
            width: 100%;
            height: system-text.preferred-height + Spacing.sm;

            system-text := Text {
                width: 100%;
                text: root.content;
                color: Colors.text-muted;
                font-size: Typography.sm;
                font-italic: true;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Call message (card style, aligned based on direction)
        if root.is-call: HorizontalLayout {
            width: 100%;
            spacing: Spacing.sm;
            alignment: root.is-own ? end : start;

            // A continuation hides the avatar but keeps its column, so every
            // bubble of one sender shares a left edge.
            if !root.is-own && !root.is-dm && root.show-sender && root.is-continuation: Rectangle {
                width: Spacing.avatar-sm;
                height: 1px;
            }
            if !root.is-own && !root.is-dm && root.show-sender && !root.is-continuation: Avatar {
                size: Spacing.avatar-sm;
                anonymous: root.is-anonymous;
                source: root.sender-avatar-source;
                fallback-text: root.sender-initials;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.selection-mode { root.selection-toggled(root.message-id); }
                        else { root.sender-profile-requested(root.sender-id); }
                    }
                }

            }

            Rectangle {
                property <bool> is-missed: root.call-type == "missed";
                // Direction is who PLACED the call — `is-own` is exactly that
                // for a call message (converters/message.rs, initiator ==
                // current user). call-type only says outgoing/incoming for
                // answered calls, so a caller's "declined" drew ↙ (RC24 D4).
                property <bool> is-outgoing: root.is-own;

                // call-content carries its own padding; adding more here left
                // slack that the fixed-size icon did not share.
                width: min(call-content.preferred-width, root.width * 0.7);
                height: call-content.preferred-height;
                background: transparent;
                border-top-left-radius: root.is-own ? root.r-round : root.r-outer-top;
                border-top-right-radius: root.is-own ? root.r-outer-top : root.r-round;
                border-bottom-left-radius: root.is-own ? root.r-round : root.r-outer-bottom;
                border-bottom-right-radius: root.is-own ? root.r-outer-bottom : root.r-round;

                Rectangle {
                    y: 0;
                    width: parent.width;
                    height: call-content.preferred-height;
                    background: root.is-own ? Colors.bubble-own : Colors.bubble-other;
                    border-top-left-radius: parent.border-top-left-radius;
                    border-top-right-radius: parent.border-top-right-radius;
                    border-bottom-left-radius: parent.border-bottom-left-radius;
                    border-bottom-right-radius: parent.border-bottom-right-radius;
                    border-width: Elevation.rim-width;
                    border-color: Elevation.raised-rim;
                }

                call-content := VerticalLayout {
                    y: 0;
                    height: self.preferred-height;
                    padding: Spacing.md;
                    spacing: Spacing.xs;
                    alignment: start;

                    if !root.is-own && !root.is-dm && root.show-sender && !root.is-continuation: Text {
                        text: root.sender-name;
                        wrap: word-wrap;
                        color: Colors.sender-name;
                        font-size: Typography.sm;
                        font-weight: Typography.medium;
                    }

                    HorizontalLayout {
                        spacing: Spacing.md;

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.xxs;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                alignment: start;

                                Text {
                                    property <string> arrow: is-outgoing ? "\u{2197}" : "\u{2199}";
                                    text: arrow;
                                    color: is-missed ? Colors.error : (is-outgoing ? Colors.success : Colors.primary);
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: is-missed ? "Missed call"
                                        : root.call-type == "declined" ? "Declined call"
                                        : root.call-type == "started" ? "Call started"
                                        : root.call-type == "ended" ? "Call ended"
                                        : is-outgoing ? "Outgoing call" : "Incoming call";
                                    accessible-role: text;
                                    accessible-label: root.call-type == "started" || root.call-type == "ended"
                                        ? (is-outgoing ? "Outgoing call " : "Incoming call ") + root.call-type
                                        : self.text;
                                    color: is-missed ? Colors.error : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }
                            }

                            // Duration belongs to the call status, not the footer clock.
                            if root.call-duration != "": Text {
                                text: root.call-duration;
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                            }
                        }

                        // A fixed-size child of a HorizontalLayout sits at the
                        // row's top; centre the icon on the text block's axis.
                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                accessible-role: image;
                                accessible-label: "Call icon";
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: is-missed ? Colors.error.transparentize(0.8) : Colors.primary.transparentize(0.85);

                                Image {
                                    width: 20px;
                                    height: 20px;
                                    source: Icons.phone;
                                    colorize: is-missed ? Colors.error : Colors.primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    // Clock is a separate bottom/right footer, like normal bubbles.
                    HorizontalLayout {
                        alignment: end;
                        Text {
                            text: root.timestamp;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                        }
                    }
                }

                call-touch := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                            root.request-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                self.absolute-position.y, self.absolute-position.y + self.height,
                                self.absolute-position.x, self.absolute-position.x + self.width);
                        }
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.begin-message-press(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                self.absolute-position.x, self.absolute-position.y + self.height, self.absolute-position.y,
                                self.absolute-position.x + self.width);
                        }
                        if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.cancel-hold(); }
                    }
                    moved => { root.move-message-press(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                    clicked => {
                        if root.selection-mode { root.selection-toggled(root.message-id); return; }
                        if root.hold-tier != 0 { root.hold-tier = 0; return; }
                        root.message-clicked(root.message-id);
                    }
                }
            }
        }

        // Deleted message (simple text, aligned)
        if !root.is-system && !root.is-call && root.is-deleted: HorizontalLayout {
            width: 100%;
            alignment: root.is-own ? end : start;

            Text {
                text: "Message deleted";
                color: Colors.text-muted;
                font-size: Typography.sm;
                font-italic: true;
            }
        }

        // Normal message with bubble layout
        if !root.is-system && !root.is-call && !root.is-deleted: HorizontalLayout {
            width: 100%;
            spacing: Spacing.sm;
            alignment: root.is-own ? end : start;

            // Avatar for others in channels (before bubble, hidden in continuations)
            // A continuation hides the avatar but keeps its column, so every
            // bubble of one sender shares a left edge.
            if !root.is-own && !root.is-dm && root.show-sender && root.is-continuation: Rectangle {
                width: Spacing.avatar-sm;
                height: 1px;
            }
            if !root.is-own && !root.is-dm && root.show-sender && !root.is-continuation: Avatar {
                size: Spacing.avatar-sm;
                anonymous: root.is-anonymous;
                source: root.sender-avatar-source;
                fallback-text: root.sender-initials;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.selection-mode { root.selection-toggled(root.message-id); }
                        else { root.sender-profile-requested(root.sender-id); }
                    }
                }

            }

            // Message bubble
            VerticalLayout {
                spacing: Spacing.xs;
                // Limit bubble width to 70% of container
                max-width: root.width * 0.7;

                // Bubble wrapper; reactions participate in the content layout.
                Rectangle {
                    width: bubble.width;
                    height: bubble.height;

                Image {
                    source: root.swipe-forward ? Icons.send : Icons.reply;
                    width: 24px;
                    height: 24px;
                    x: (root.is-own == root.swipe-forward ? bubble.width : 0px)
                        + root.swipe-offset / 2 - self.width / 2;
                    y: (bubble.height - self.height) / 2;
                    colorize: root.swipe-armed ? Colors.primary : Colors.text-muted;
                    opacity: min(1, abs(root.swipe-offset) / root.swipe-threshold);
                    transform-scale-x: 60% + 40% * min(1, abs(root.swipe-offset) / root.swipe-threshold);
                    transform-scale-y: self.transform-scale-x;
                    visible: root.swipe-active || self.opacity > 0;
                    animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
                    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                }

                bubble := Rectangle {
                    x: root.swipe-offset;
                    animate x { duration: root.swipe-active ? 0ms : Materials.motion-standard; easing: Materials.spring; }
                    y: 0px;
                    property <bool> bubble-hovered: bubble-touch.has-hover;
                    accessible-role: text;
                    accessible-label: root.is-own ? "Your message: " + root.content : root.sender-name + " says: " + root.content;

                    // One rounded surface avoids a square backing at the corners.
                    background: transparent;
                    border-top-left-radius: root.is-own ? root.r-round : root.r-outer-top;
                    border-top-right-radius: root.is-own ? root.r-outer-top : root.r-round;
                    border-bottom-left-radius: root.is-own ? root.r-round : root.r-outer-bottom;
                    border-bottom-right-radius: root.is-own ? root.r-outer-bottom : root.r-round;

                    // Calculate height based on content
                    height: bubble-content.preferred-height;
                    width: bubble-content.preferred-width + (root.is-ai ? 4px : 0);

                    Rectangle {
                        y: 0;
                        width: parent.width;
                        height: bubble-content.preferred-height;
                        background: bubble-hovered
                            ? (root.is-own ? Colors.bubble-own-hover : Colors.bubble-other-hover)
                            : (root.is-own ? Colors.bubble-own : Colors.bubble-other);
                        border-top-left-radius: parent.border-top-left-radius;
                        border-top-right-radius: parent.border-top-right-radius;
                        border-bottom-left-radius: parent.border-bottom-left-radius;
                        border-bottom-right-radius: parent.border-bottom-right-radius;
                        border-width: Elevation.rim-width;
                        border-color: Elevation.raised-rim;
                    }

                    // Send progress: a thin line along the bubble's bottom edge
                    // while this message is on its way, red once it is not
                    // going. On the bubble, so it says which message is in
                    // flight and never moves the composer; a 2px line, so the
                    // bubble keeps its final height from the first frame. Core
                    // reports no byte progress for an upload, so the sending
                    // sweep is indeterminate and only the state is real:
                    // sending / landed (line gone, tick) / failed.
                    if root.is-own && !root.mesh-delivery
                        && (root.delivery-status == "sending" || root.delivery-status == "waiting-tor" || root.delivery-status == "failed"): send-line := Rectangle {
                        property <bool> failed: root.delivery-status == "failed";
                        // Inset past the bottom corners' curve so the line
                        // never pokes out of the rounded fill.
                        x: root.r-round;
                        width: parent.width - root.r-round * 2;
                        height: 2px;
                        y: bubble-content.preferred-height - self.height - Elevation.rim-width - 1px;
                        border-radius: 1px;
                        clip: true;
                        // Reduce animations: the line is a solid, still
                        // "Sending" mark — same state, no sweep, no tick.
                        background: failed ? Colors.error
                            : Appearance.reduce-motion ? Colors.primary
                            : Colors.primary.transparentize(0.8);
                        accessible-role: progress-indicator;
                        accessible-label: failed ? "Not sent" : root.delivery-status == "waiting-tor" ? "Waiting for Tor" : "Sending";

                        // One sweep per 1.4s; `animation-tick` only ticks while
                        // this element exists, i.e. while a send is pending
                        // and the user has not asked for reduced motion (then
                        // the element is never created, so nothing ticks).
                        if !send-line.failed && !Appearance.reduce-motion: Rectangle {
                            width: parent.width * 0.35;
                            x: (parent.width + self.width) * (Math.mod(animation-tick(), 1400ms / Appearance.animation-speed) / (1400ms / Appearance.animation-speed)) - self.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Colors.primary;
                        }
                    }

                    // AI message left accent bar
                    if root.is-ai: Rectangle {
                        x: 0;
                        y: 4px;
                        width: 3px;
                        height: parent.height - 8px;
                        border-radius: 1.5px;
                        background: Colors.primary;
                    }

                    bubble-touch := TouchArea {
                        mouse-cursor: pointer;

                        pointer-event(event) => {
                            // Desktop: right-click opens the menu at the cursor.
                            // Unreachable from a finger — see the note on the
                            // hold timers above.
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.request-menu(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y,
                                    bubble.absolute-position.y, bubble.absolute-position.y + bubble.height,
                                    bubble.absolute-position.x, bubble.absolute-position.x + bubble.width);
                                return;
                            }

                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.begin-message-press(
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y,
                                    self.absolute-position.x,
                                    self.absolute-position.y + self.height,
                                    self.absolute-position.y,
                                    self.absolute-position.x + self.width);
                            }

                            // Release, or a grab stolen by the scrolling
                            // Flickable (Slint delivers that as Cancel).
                            //
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                root.end-swipe(event.kind == PointerEventKind.cancel);
                                root.cancel-hold();
                            }
                        }

                        moved => {
                            root.move-message-press(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }

                        clicked => {
                            if (root.swipe-active) { return; }
                            if (root.selection-mode) {
                                root.selection-toggled(root.message-id);
                                return;
                            }
                            // Swallow the release that ends a hold, so opening
                            // the menu does not also count as a tap.
                            if (root.hold-tier != 0) {
                                root.hold-tier = 0;
                                return;
                            }
                            root.message-clicked(root.message-id);
                        }
                    }

                    bubble-content := VerticalLayout {
                        y: 0;
                        height: self.preferred-height;
                        padding: Spacing.sm + Spacing.xxs;
                        padding-left: root.is-ai ? Spacing.sm + Spacing.sm : Spacing.sm + Spacing.xxs;
                        spacing: Spacing.xs;

                        // Sender name + timestamp (only in channels for others, hidden in continuations)
                        if !root.is-own && !root.is-dm && root.show-sender && !root.is-continuation: HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            Text {
                                text: root.sender-name;
                                color: root.is-ai ? Colors.info : Colors.sender-name;
                                font-size: Typography.sm;
                                font-weight: Typography.medium;
                                overflow: elide;
                            }

                            if root.is-ai: Rectangle {
                                height: Spacing.badge-sm;
                                width: ai-text.preferred-width + 8px;
                                background: Colors.info;
                                border-radius: 4px;

                                ai-text := Text {
                                    x: 4px;
                                    text: "AI";
                                    color: Colors.text-primary;
                                    font-size: Typography.xs;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Thread-reply chip — marks a message that lives in a
                        // thread (vs a main-chat quote reply, which shows the
                        // quote block below). Purple to keep it distinct from
                        // the teal quote accent.
                        if root.is-thread-reply: HorizontalLayout {
                            spacing: Spacing.xs;
                            alignment: start;

                            Image {
                                width: 11px;
                                height: 11px;
                                source: Icons.message-circle;
                                colorize: Colors.accent-purple;
                            }

                            Text {
                                text: "Thread reply";
                                color: Colors.accent-purple;
                                font-size: Typography.xs;
                                font-italic: true;
                            }
                        }

                        // Quote / reply-to bubble
                        if root.is-reply: Rectangle {
                            background: Colors.bubble-inset;
                            border-radius: 6px;
                            max-width: root.text-max-width;
                            height: quote-row.preferred-height + Spacing.xs;

                            // Tap the quote to jump to the original message.
                            // Suppressed when the parent is gone/unknown.
                            //
                            // Declared BEFORE quote-row so it sits on the bottom
                            // z-layer: the inline audio player's play/seek
                            // TouchAreas (inside quote-row, above this) consume
                            // their own clicks, while taps on text/thumbnail —
                            // which carry no TouchArea — fall through here to jump.
                            quote-touch := TouchArea {
                                mouse-cursor: (root.reply-to-not-found || root.reply-to-message-id == "") ? default : pointer;
                                clicked => {
                                    if (!root.reply-to-not-found && root.reply-to-message-id != "") {
                                        root.quote-clicked(root.reply-to-message-id);
                                    }
                                }
                            }

                            // Compact Signal/Telegram-style quote: small media
                            // thumbnail on the LEFT, sender + label/player filling
                            // the right. A thin strip — no big block that leaves a
                            // wasted L-shape when the reply body is wide.
                            quote-row := HorizontalLayout {
                                padding: Spacing.xs;
                                spacing: Spacing.sm;
                                alignment: stretch;

                                // Accent bar
                                Rectangle {
                                    width: 3px;
                                    background: Colors.primary;
                                    border-radius: 1.5px;
                                }

                                // Small media thumbnail on the LEFT (image/gif/video).
                                // Aspect-fit within a compact box so the whole preview
                                // shows without dominating the bubble.
                                if root.reply-to-category != "audio" && root.reply-to-has-thumbnail: Rectangle {
                                    property <float> aspect: root.reply-to-thumbnail-width > 0 && root.reply-to-thumbnail-height > 0
                                        ? root.reply-to-thumbnail-width / root.reply-to-thumbnail-height
                                        : 1.4;
                                    property <length> max-h: 60px;
                                    property <length> max-w: 96px;
                                    height: min(self.max-h, self.max-w / self.aspect);
                                    width: self.height * self.aspect;
                                    border-radius: 4px;
                                    clip: true;

                                    Image {
                                        source: root.reply-to-thumbnail;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }

                                    // Video play badge (compact, centered).
                                    if root.reply-to-category == "video": Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Colors.overlay;
                                        Image {
                                            width: 9px;
                                            height: 9px;
                                            source: Icons.play;
                                            colorize: Colors.text-primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    // GIF chip — tiny corner tag.
                                    if root.reply-to-category == "gif": Rectangle {
                                        x: 2px;
                                        y: 2px;
                                        width: gif-label.preferred-width + 6px;
                                        height: 13px;
                                        border-radius: 3px;
                                        background: Colors.action-fill;
                                        gif-label := Text {
                                            text: "GIF";
                                            color: Colors.on-action;
                                            font-size: Typography.xxs;
                                            font-weight: Typography.semibold;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }

                                // Right column — sender name + label/player, fills
                                // the width beside the thumbnail (no empty gap).
                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: root.reply-to-sender-name;
                                        color: Colors.primary;
                                        font-size: Typography.xs;
                                        font-weight: Typography.semibold;
                                        overflow: elide;
                                    }

                                    // Audio parent — the shared inline player (compact
                                    // variant). Its play/seek TouchAreas sit above
                                    // quote-touch so they consume their clicks; the rest
                                    // of the quote still falls through to jump.
                                    if root.reply-to-category == "audio": AudioPlayer {
                                        mobile: root.mobile;
                                        compact: true;
                                        attachment-id: root.reply-to-attachment-id;
                                        filename: root.reply-to-filename;
                                        waveform: root.reply-to-waveform;
                                        duration-display: root.reply-to-duration;
                                        current-playing-attachment-id: root.current-playing-attachment-id;
                                        is-media-playing: root.is-media-playing;
                                        audio-progress: root.audio-progress;
                                        audio-elapsed: root.audio-elapsed;

                                        play-clicked(id) => { root.open-other-attachment(id); }
                                        audio-seek(id, pos) => { root.audio-seek(id, pos); }
                                    }

                                    // Non-audio: one-line preview/label filling the
                                    // right of the thumbnail. Guard the empty edge so
                                    // the quote is never just a bare sender name.
                                    if root.reply-to-category != "audio": Text {
                                        text: root.reply-to-preview != ""
                                            ? root.reply-to-preview
                                            : (root.reply-to-category != "" ? "📎 Attachment" : "Message");
                                        color: Colors.text-secondary;
                                        font-size: Typography.xs;
                                        overflow: elide;
                                    }

                                    // Signal-Desktop parity: warn when the original is gone.
                                    if root.reply-to-not-found: Text {
                                        text: "Original message not found";
                                        color: Colors.warning;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Message content. A body with markdown arrives as
                        // blocks: each inline run is ONE StyledText, so mixed
                        // bold/italic/strike/code flow and word-wrap in one
                        // paragraph; fenced code blocks are boxes of their own.
                        // Non-link text and right-click pass through to bubble-touch.
                        // Link taps own their stream and feed the same hold timer
                        // through pointer-event (vendored core/compiler patch).
                        if root.content != "" && root.rich-content.length > 0: VerticalLayout {
                            spacing: Spacing.xs;
                            max-width: root.text-max-width;

                            for block in root.rich-content: VerticalLayout {
                                if block.is-code-block: Rectangle {
                                    background: Colors.bubble-inset;
                                    border-radius: 4px;

                                    VerticalLayout {
                                        padding: Spacing.sm;

                                        Text {
                                            text: block.plain;
                                            color: !root.is-own ? Colors.code-text : Colors.text-primary;
                                            font-family: Typography.font-family-mono;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                            max-width: root.text-max-width - 16px;
                                        }
                                    }
                                }

                                if !block.is-code-block: StyledText {
                                    text: block.text;
                                    link-color: Colors.primary;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            root.begin-message-press(
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y,
                                                bubble-touch.absolute-position.x,
                                                bubble-touch.absolute-position.y + bubble-touch.height,
                                                bubble.absolute-position.y,
                                                bubble.absolute-position.x + bubble.width);
                                        }
                                        if (event.kind == PointerEventKind.move) {
                                            root.move-message-press(self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                            root.end-swipe(event.kind == PointerEventKind.cancel);
                                            root.cancel-hold();
                                        }
                                    }
                                    link-clicked(url) => {
                                        if (root.swipe-active) { return; }
                                        if (root.hold-tier != 0) { return; }
                                        if root.selection-mode { root.selection-toggled(root.message-id); }
                                        else { root.open-message-link(url); }
                                    }
                                    // Text gets these implicitly; StyledText does not.
                                    accessible-role: text;
                                    accessible-label: block.plain;
                                    default-color: Colors.text-primary;
                                    default-font-size: Typography.sm;
                                    max-width: root.text-max-width;
                                }
                            }
                        }

                        // A body with no markdown: one plain Text.
                        if root.content != "" && root.rich-content.length == 0: Text {
                            text: root.content;
                            color: Colors.text-primary;
                            font-size: Typography.sm;
                            wrap: word-wrap;
                            max-width: root.text-max-width;

                            // Text owns its pointer events. Give touch the same
                            // swipe/hold stream as the surrounding bubble;
                            // desktop keeps native text selection.
                            if root.mobile: TouchArea {
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.begin-message-press(self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y,
                                            bubble-touch.absolute-position.x,
                                            bubble-touch.absolute-position.y + bubble-touch.height,
                                            bubble.absolute-position.y,
                                            bubble.absolute-position.x + bubble.width);
                                    }
                                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                        root.end-swipe(event.kind == PointerEventKind.cancel);
                                        root.cancel-hold();
                                    }
                                }
                                moved => {
                                    root.move-message-press(self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                                clicked => {
                                    if (root.swipe-active) { return; }
                                    if (root.selection-mode) { root.selection-toggled(root.message-id); return; }
                                    if (root.hold-tier != 0) { root.hold-tier = 0; return; }
                                    root.message-clicked(root.message-id);
                                }
                            }
                        }

                        // Attachments
                        if root.has-attachments: VerticalLayout {
                            spacing: Spacing.sm;

                            for attachment in root.attachments: HorizontalLayout {
                                // Each row occupies the attachment column, including when
                                // another attachment or message text makes the bubble wider.
                                width: parent.width;
                                alignment: attachment.is-image || attachment.category == "video" ? center : start;

                                // Image attachments
                                if attachment.is-image: Rectangle {
                                    property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.5;
                                    property <length> max-w: min(280px, root.width * 0.7 - Spacing.md);
                                    property <length> max-h: 380px;
                                    property <length> calc-w: min(max-w, max-h * aspect-ratio);
                                    property <length> calc-h: min(max-h, calc-w / aspect-ratio);

                                    // Reserve the final geometry from stored dimensions before
                                    // the thumbnail is decoded, so rows above the viewport do
                                    // not grow and pull the opening anchor away from the end.
                                    width: attachment.width > 0 && attachment.height > 0 ? max(100px, calc-w) : 180px;
                                    height: attachment.width > 0 && attachment.height > 0 ? max(60px, calc-h) : 140px;
                                    background: Colors.bubble-inset;
                                    border-radius: Spacing.radius-sm;
                                    clip: true;

                                    if attachment.has-thumbnail: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: attachment.thumbnail;
                                        image-fit: contain;
                                    }

                                    if !attachment.has-thumbnail: Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Colors.surface-hover;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Spacing.xs;

                                            Image {
                                                width: 32px;
                                                height: 32px;
                                                source: Icons.image;
                                                colorize: Colors.text-muted;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: attachment.filename;
                                                color: Colors.text-secondary;
                                                font-size: Typography.xs;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Progress overlay
                                    if attachment.is-uploading || attachment.is-downloading: Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Colors.overlay;
                                        accessible-role: progress-indicator;
                                        accessible-label: attachment.is-uploading ? "Uploading " + attachment.filename : "Downloading " + attachment.filename;
                                        accessible-value: Math.round(attachment.progress * 100) + " percent";

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Spacing.sm;

                                            Text {
                                                text: attachment.is-uploading ? "Uploading..." : "Downloading...";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                horizontal-alignment: center;
                                            }

                                            Rectangle {
                                                width: 80%;
                                                height: 4px;
                                                background: Colors.surface-hover;
                                                border-radius: 2px;

                                                Rectangle {
                                                    width: parent.width * attachment.progress;
                                                    height: 100%;
                                                    background: Colors.primary;
                                                    border-radius: 2px;
                                                }
                                            }
                                        }
                                    }

                                    img-touch := HoldArea {
                                        enabled-for-touch: root.mobile;
                                        mouse-cursor: pointer;
                                        gesture-down(x, y) => { root.begin-swipe(x, y); }
                                        gesture-moved(x, y) => { root.move-swipe(x, y); }
                                        gesture-ended(cancelled) => { root.end-swipe(cancelled); }
                                        clicked => {
                                            if (self.hold-fired || root.swipe-active) { return; }
                                            root.open-image(attachment.id,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                        held => {
                                            root.request-menu(self.anchor-x, self.anchor-y,
                                                bubble.absolute-position.y, bubble.absolute-position.y + bubble.height,
                                                bubble.absolute-position.x, bubble.absolute-position.x + bubble.width);
                                        }
                                    }
                                }

                                // Audio attachments — shared inline player
                                if attachment.category == "audio": AudioPlayer {
                                    mobile: root.mobile;
                                    attachment-id: attachment.id;
                                    filename: attachment.filename;
                                    waveform: attachment.waveform;
                                    duration-display: attachment.duration-display;
                                    current-playing-attachment-id: root.current-playing-attachment-id;
                                    is-media-playing: root.is-media-playing;
                                    audio-progress: root.audio-progress;
                                    audio-elapsed: root.audio-elapsed;

                                    play-clicked(id) => { root.open-other-attachment(id); }
                                    audio-seek(id, pos) => { root.audio-seek(id, pos); }
                                    more-clicked(x, y) => {
                                        root.request-menu(x, y,
                                            bubble.absolute-position.y, bubble.absolute-position.y + bubble.height,
                                            bubble.absolute-position.x, bubble.absolute-position.x + bubble.width);
                                    }
                                }

                                // Video attachments
                                if attachment.category == "video": Rectangle {
                                    property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.6;
                                    property <length> max-w: min(280px, root.width * 0.7 - Spacing.md);
                                    property <length> max-h: 220px;
                                    property <length> calc-w: min(max-w, max-h * aspect-ratio);
                                    property <length> calc-h: min(max-h, calc-w / aspect-ratio);

                                    width: attachment.width > 0 && attachment.height > 0 ? max(160px, calc-w) : 260px;
                                    height: attachment.width > 0 && attachment.height > 0 ? max(100px, calc-h) : 160px;
                                    background: Colors.bubble-inset;
                                    border-radius: Spacing.radius-sm;
                                    clip: true;

                                    if attachment.has-thumbnail: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: attachment.thumbnail;
                                        image-fit: contain;
                                    }

                                    // No thumbnail: the play button IS the icon, stacked
                                    // above the filename rather than floated over it.
                                    // Previously this branch centred icon+name+size in
                                    // the tile and the overlay below centred a 56px
                                    // opaque circle on the same point, so the one thing
                                    // identifying the file — its name — was underneath
                                    // the button. A video with no thumbnail is exactly
                                    // the case where the name is all the user has.
                                    if !attachment.has-thumbnail: VerticalLayout {
                                        alignment: center;
                                        spacing: Spacing.xs;

                                        // Wrapped: a Rectangle has no alignment of its
                                        // own, so the row centres it.
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 56px;
                                                height: 56px;
                                                border-radius: 28px;
                                                background: video-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                                                Image {
                                                    width: 24px;
                                                    height: 24px;
                                                    source: Icons.play;
                                                    colorize: Colors.text-primary;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                        Text {
                                            text: attachment.filename;
                                            color: Colors.text-secondary;
                                            font-size: Typography.xs;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: attachment.size-display;
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Play button overlay — only over a thumbnail, where
                                    // there is a picture to float it on. Without one it
                                    // is drawn inline above, by the branch just above.
                                    if attachment.has-thumbnail: Rectangle {
                                        x: (parent.width - 56px) / 2;
                                        y: (parent.height - 56px) / 2;
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 28px;
                                        background: video-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                                        Image {
                                            width: 24px;
                                            height: 24px;
                                            source: Icons.play;
                                            colorize: Colors.text-primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    video-touch := HoldArea {
                                        enabled-for-touch: root.mobile;
                                        mouse-cursor: pointer;
                                        gesture-down(x, y) => { root.begin-swipe(x, y); }
                                        gesture-moved(x, y) => { root.move-swipe(x, y); }
                                        gesture-ended(cancelled) => { root.end-swipe(cancelled); }
                                        clicked => {
                                            if (self.hold-fired || root.swipe-active) { return; }
                                            root.open-other-attachment(attachment.id);
                                        }
                                        held => {
                                            root.request-menu(self.anchor-x, self.anchor-y,
                                                bubble.absolute-position.y, bubble.absolute-position.y + bubble.height,
                                                bubble.absolute-position.x, bubble.absolute-position.x + bubble.width);
                                        }
                                    }
                                }

                                // File attachments
                                if !attachment.is-image && attachment.category != "audio" && attachment.category != "video": Rectangle {
                                    width: min(240px, root.width * 0.7 - Spacing.md);
                                    height: 52px;
                                    background: Colors.bubble-inset;
                                    border-radius: Spacing.radius-md;

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: Spacing.radius-sm;
                                            background: Colors.primary.transparentize(0.85);

                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: Icons.file;
                                                colorize: Colors.primary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: Spacing.xxs;

                                            Text {
                                                text: attachment.filename;
                                                color: Colors.text-primary;
                                                font-size: Typography.xs;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: attachment.size-display;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }

                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            background: file-touch.has-hover ? Colors.surface-hover : transparent;
                                            border-radius: Spacing.radius-sm;

                                            Image {
                                                width: 14px;
                                                height: 14px;
                                                source: Icons.download;
                                                colorize: Colors.primary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }

                                    // Progress bar
                                    if attachment.is-uploading || attachment.is-downloading: Rectangle {
                                        y: parent.height - 3px;
                                        width: parent.width;
                                        height: 3px;
                                        background: Colors.surface-hover;
                                        border-radius: 1.5px;
                                        accessible-role: progress-indicator;
                                        accessible-label: attachment.is-uploading ? "Upload progress" : "Download progress";
                                        accessible-value: Math.round(attachment.progress * 100) + " percent";

                                        Rectangle {
                                            width: parent.width * attachment.progress;
                                            height: 100%;
                                            background: Colors.primary;
                                            border-radius: 1.5px;
                                        }
                                    }

                                    file-touch := HoldArea {
                                        enabled-for-touch: root.mobile;
                                        mouse-cursor: pointer;
                                        gesture-down(x, y) => { root.begin-swipe(x, y); }
                                        gesture-moved(x, y) => { root.move-swipe(x, y); }
                                        gesture-ended(cancelled) => { root.end-swipe(cancelled); }
                                        clicked => {
                                            if (self.hold-fired || root.swipe-active) { return; }
                                            root.open-other-attachment(attachment.id);
                                        }
                                        held => {
                                            root.request-menu(self.anchor-x, self.anchor-y,
                                                bubble.absolute-position.y, bubble.absolute-position.y + bubble.height,
                                                bubble.absolute-position.x, bubble.absolute-position.x + bubble.width);
                                        }
                                    }
                                }
                            }
                        }

                        // Footer: reactions start, clock and status end, on one row.
                        HorizontalLayout {
                            spacing: Spacing.sm;
                            if root.has-reactions: HorizontalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                reactions-pill := Rectangle {
                                    // Grows with the text size; on touch the row is
                                    // tall enough to tell neighbouring chips apart
                                    // under a thumb (22px was the whole hit box).
                                    height: (root.mobile ? 32px : 22px) * Appearance.text-grow;
                                    width: reactions-row.preferred-width + 8px;
                                    background: transparent;
                                    border-width: 0px;
                                    accessible-role: button;
                                    accessible-label: "Reactions: " + root.reaction-summary;

                                    reactions-row := HorizontalLayout {
                                        padding-left: Spacing.none;
                                        padding-right: Spacing.none;
                                        spacing: Spacing.sm;
                                        alignment: center;

                                        for reaction in root.reactions: Rectangle {
                                            width: max(root.mobile ? Spacing.button-height : 0px, entry.preferred-width + (root.mobile ? Spacing.sm : 4px));
                                            border-radius: self.height / 2;
                                            // Own reactions: a neutral 8% tint, no ring and no
                                            // brand-colour pill around a lone emoji (owner's
                                            // call); the accessible label carries "yours".
                                            border-width: 0px;
                                            background: reaction.own ? Colors.text-primary.with-alpha(0.08) : transparent;
                                            transform-scale-x: reaction-touch.pressed ? 90% : 100%;
                                            transform-scale-y: reaction-touch.pressed ? 90% : 100%;
                                            animate transform-scale-x { duration: reaction-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                                            animate transform-scale-y { duration: reaction-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                                            animate background { duration: Materials.motion-quick; easing: Materials.glide; }
                                            accessible-role: button;
                                            accessible-label: reaction.emoji + (reaction.own ? ", your reaction" : "");
                                            accessible-action-default => { root.reaction-toggled(root.sender-id, root.timestamp-ns, reaction.emoji); }

                                            entry := HorizontalLayout {
                                                spacing: Spacing.xxs;
                                                alignment: center;

                                                Text {
                                                    text: reaction.emoji;
                                                    font-family: Typography.font-family-emoji;
                                                    font-size: root.mobile ? Typography.sm : Typography.xs;
                                                    vertical-alignment: center;
                                                }

                                                if reaction.count > 1: Text {
                                                    text: reaction.count;
                                                    color: Colors.text-secondary;
                                                    font-size: Typography.xs;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Per-emoji, replacing a pill-wide TouchArea that
                                            // only opened the picker. The picker is still on
                                            // long-press → More reactions and on the hover
                                            // "Add reaction" button.
                                            reaction-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.reaction-toggled(root.sender-id, root.timestamp-ns,
                                                        reaction.emoji);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Clock and status sit on the row's bottom line beside a taller reaction pill.
                            VerticalLayout {
                                alignment: end;
                                horizontal-stretch: 0;
                                HorizontalLayout {
                                    spacing: Spacing.xs;
                                    alignment: end;

                                    if root.is-pinned: Image {
                                        source: Icons.pin;
                                        width: 12px;
                                        height: 12px;
                                        colorize: Colors.primary;
                                    }

                                    // "edited" before the time on both sides (Signal's order).
                                    if root.is-edited: Text {
                                        text: "edited";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                    }

                                    Text {
                                        text: root.timestamp;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }

                                    // Delivery status. Mesh states get a word rather
                                    // than a tick: over couriers "sent" and
                                    // "delivered" are hours apart, and two ticks
                                    // would claim an arrival nobody has confirmed.
                                    if root.is-own && root.mesh-delivery: Text {
                                        // "sent" is not reused for a radio
                                        // broadcast, including a private channel
                                        // packet: there is no recipient ACK.
                                        text: root.delivery-status == "queued" ? "queued"
                                            : root.delivery-status == "relayed" ? "relayed"
                                            : root.delivery-status == "carried" ? "carried"
                                            : root.delivery-status == "waiting" ? "waiting"
                                            : root.delivery-status == "undelivered" ? "not delivered"
                                            : root.delivery-status == "delivered" ? "delivered"
                                            : root.delivery-status == "read" ? "read"
                                            : root.delivery-status == "broadcast" ? "broadcast"
                                            : "sent";
                                        color: root.delivery-status == "undelivered" ? Colors.text-secondary : Colors.text-muted;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                        accessible-role: text;
                                        accessible-label: root.delivery-status == "queued"
                                                ? "Signal ciphertext queued on this device; no route has accepted it"
                                            : root.delivery-status == "relayed"
                                                ? "Sealed Signal ciphertext queued onto a courier link; recipient has not acknowledged it"
                                            : root.delivery-status == "carried"
                                                ? "Handed to a passing device; may arrive later"
                                            : root.delivery-status == "waiting"
                                                ? "Held on this device until something can carry it"
                                            : root.delivery-status == "undelivered"
                                                ? "Left the outbox without ever being acknowledged"
                                            : root.delivery-status == "delivered"
                                                ? "The peer's device acknowledged it"
                                            : root.delivery-status == "read"
                                                ? "Read by the peer"
                                            : root.delivery-status == "broadcast"
                                                ? "Put on the air without recipient acknowledgement"
                                            : "Handed to a live link; not yet acknowledged";
                                    }

                                    // Delivery status checkmarks. SVG, not "✓": the
                                    // glyph has no coverage in the Android system
                                    // font and rendered as a tofu box on every
                                    // message. Fixed 12px so the row — and the
                                    // bubble — keeps the height the text tick had.
                                    // Queued behind a Shield mailbox bootstrap, or
                                    // that queue's flush failed: a word, not a tick —
                                    // neither has reached the server, and "failed"
                                    // must never read as delivered.
                                    if root.is-own && !root.mesh-delivery && (root.delivery-status == "sending" || root.delivery-status == "waiting-tor"): Text {
                                        text: root.delivery-status == "waiting-tor" ? "waiting for Tor" : "sending";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                        accessible-role: text;
                                        accessible-label: root.delivery-status == "waiting-tor" ? "Waiting for Tor" : "Sending";
                                    }

                                    if root.is-own && !root.mesh-delivery && root.delivery-status == "parked": Text {
                                        text: root.failure-reason;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                        wrap: word-wrap;
                                        accessible-role: button;
                                        accessible-label: root.failure-reason + ". Tap to retry now";
                                        accessible-action-default => { root.message-clicked(root.message-id); }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.message-clicked(root.message-id); }
                                        }
                                    }

                                    // "not sent" is the retry control (Signal's "tap
                                    // to retry"): `message-clicked` resends it, reason or not.
                                    if root.is-own && !root.mesh-delivery && root.delivery-status == "failed": Text {
                                        text: root.failure-reason == "" ? "not sent \u{b7} retry" : "not sent \u{b7} " + root.failure-reason;
                                        color: Colors.error;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                        accessible-role: button;
                                        accessible-label: "Not sent, tap to retry";
                                        accessible-action-default => { root.message-clicked(root.message-id); }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.message-clicked(root.message-id); }
                                        }
                                    }

                                    // Submitted, but the transport died before the
                                    // server answered: it may well have arrived.
                                    // One tick with a warning, never "failed" and
                                    // never a retry (a resend could duplicate it).
                                    if root.is-own && !root.mesh-delivery && root.delivery-status == "unconfirmed": TooltipArea {
                                        tooltip-text: "Delivery could not be confirmed";
                                        placement: "top";
                                        width: 26px;
                                        height: 12px;
                                        accessible-role: text;
                                        accessible-label: "Delivery could not be confirmed";

                                        Image {
                                            source: Icons.check;
                                            width: 12px;
                                            height: 12px;
                                            x: 0px;
                                            colorize: Colors.text-muted;
                                        }

                                        Image {
                                            source: Icons.alert-triangle;
                                            width: 12px;
                                            height: 12px;
                                            x: parent.width - self.width;
                                            colorize: Colors.warning;
                                        }
                                    }

                                    if root.is-own && !root.mesh-delivery && root.delivery-status != "sending" && root.delivery-status != "waiting-tor" && root.delivery-status != "failed" && root.delivery-status != "unconfirmed" && root.delivery-status != "parked": ticks := Rectangle {
                                        property <bool> double-tick: root.delivery-status != "sent";
                                        property <color> tick-color: root.delivery-status == "read" ? Colors.bubble-accent : Colors.text-muted;
                                        width: self.double-tick ? 17px : 12px;
                                        height: 12px;
                                        animate width { duration: Materials.motion-standard; easing: Materials.spring; }
                                        accessible-role: text;
                                        accessible-label: root.delivery-status == "sent" ? "Sent"
                                            : root.delivery-status == "delivered" ? "Delivered"
                                            : root.delivery-status == "read" ? "Read" : "";

                                        // Second tick behind, offset left, so the
                                        // pair reads as the usual overlapping ✓✓.
                                        Image {
                                            source: Icons.check;
                                            width: 12px;
                                            height: 12px;
                                            x: 0px;
                                            y: 0px;
                                            opacity: ticks.double-tick ? 1 : 0;
                                            animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
                                            colorize: ticks.tick-color;
                                        }

                                        Image {
                                            source: Icons.check;
                                            width: 12px;
                                            height: 12px;
                                            x: parent.width - self.width;
                                            y: 0px;
                                            colorize: ticks.tick-color;
                                        }
                                    }
                                }
                            }
                        }

                    }

                    // Tap-to-jump flash — brief green highlight when this bubble
                    // is the scroll target of a quote click. Plain Rectangle
                    // (no TouchArea) so it never blocks input. Absent on idle rows.
                    if root.highlight-progress > 0: Rectangle {
                        width: 100%;
                        height: 100%;
                        border-top-left-radius: bubble.border-top-left-radius;
                        border-top-right-radius: bubble.border-top-right-radius;
                        border-bottom-left-radius: bubble.border-bottom-left-radius;
                        border-bottom-right-radius: bubble.border-bottom-right-radius;
                        background: Colors.primary.with-alpha(root.highlight-progress * 0.22);
                        border-width: root.highlight-progress * Spacing.stroke;
                        border-color: Colors.primary;
                    }
                }

                // Action buttons — float above top corner of bubble on opposed side.
                // Do not allocate hidden controls for every row (or any mobile row).
                if root.is-hovered: Rectangle {
                    // Peer bubbles in a narrow pane: the bar would run off the
                    // right edge, so it tucks inside the bubble's end instead.
                    property <bool> overflows-right: !root.is-own
                        && bubble.absolute-position.x + bubble.width - 8px + action-btns.width
                            > root.absolute-position.x + root.width - Spacing.xs;
                    x: root.is-own ? -action-btns.width + 8px
                        : self.overflows-right ? bubble.width - action-btns.width - Spacing.sm
                        : bubble.width - 8px;
                    y: -Spacing.button-height / 2; // Float halfway above the top edge
                    width: action-btns.width;
                    height: action-btns.height;
                    visible: root.is-hovered && !root.is-system && !root.is-deleted && !root.is-call;

                    action-btns := Rectangle {
                        height: Spacing.button-height + Spacing.xxs * 2;
                        width: (root.can-thread ? 4 : 3) * Spacing.button-height + (root.can-thread ? 5 : 4) * Spacing.xxs;
                        background: Colors.surface-raised;
                        border-radius: Spacing.radius-md;
                        border-width: Elevation.rim-width;
                        border-color: Elevation.raised-rim;

                        HorizontalLayout {
                            padding: Spacing.xxs;
                            spacing: Spacing.xxs;
                            alignment: center;

                            // Reply button
                            IconAction {
                                label: "Reply to message";
                                icon: Icons.reply;
                                clicked => {
                                        root.reply-clicked(root.sender-id, root.timestamp-ns);
                                }
                            }

                            // React button
                            react-btn := IconAction {
                                label: "Add reaction";
                                icon: Icons.smile;
                                clicked => {
                                        root.react-clicked(root.sender-id, root.timestamp-ns,
                                            react-btn.absolute-position.x,
                                            react-btn.absolute-position.y + react-btn.height);
                                }
                            }

                            // Reply-in-thread button — opens/starts a thread on
                            // this message. Previously the ONLY thread entry was
                            // the "N replies" badge (rendered `if reply-count > 0`),
                            // so a message with no replies could never START a thread.
                            if root.can-thread: thread-btn := IconAction {
                                label: "Reply in thread";
                                icon: Icons.message-circle;
                                clicked => {
                                        root.thread-clicked(root.message-id);
                                }
                            }

                            // More button
                            more-btn := IconAction {
                                label: "More message actions";
                                icon: Icons.more-horizontal;
                                clicked => {
                                        root.request-menu(more-btn.absolute-position.x,
                                            more-btn.absolute-position.y + more-btn.height,
                                            bubble.absolute-position.y, bubble.absolute-position.y + bubble.height,
                                            bubble.absolute-position.x, bubble.absolute-position.x + bubble.width);
                                }
                            }
                        }
                    }
                }
                } // end wrapper

                // Thread replies indicator (below bubble)
                if root.reply-count > 0: HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: root.is-own ? end : start;
                    padding-left: Spacing.xs;
                    padding-right: Spacing.xs;

                    // Pill button (not bare text) so the thread entry point
                    // reads as clickable.
                    Rectangle {
                        height: Spacing.button-height;
                        width: thread-layout.preferred-width + Spacing.sm * 2;
                        border-radius: self.height / 2;
                        background: thread-touch.has-hover
                            ? Colors.primary.transparentize(0.75)
                            : Colors.primary.transparentize(0.9);
                        accessible-role: button;
                        accessible-label: "Open thread: " + root.reply-count-text;

                        thread-layout := HorizontalLayout {
                            height: parent.height;
                            spacing: Spacing.xs;
                            padding-left: Spacing.sm;
                            alignment: center;

                            // A y on a layout child fights the layout; centre
                            // the icon on the text's line instead.
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 12px;
                                    height: 12px;
                                    source: Icons.message-circle;
                                    colorize: Colors.primary;
                                }
                            }

                            Text {
                                text: root.reply-count-text;
                                color: Colors.primary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }
                        }

                        thread-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.thread-clicked(root.message-id); }
                        }
                    }
                }
            }
        }
    } // end main-layout
    } // end touch wrapper
}
