// Single message item component
//
// Displays an individual message with avatar, sender, content, timestamp,
// reactions, thread indicator, and attachments.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Avatar } from "../components/avatar.slint";
import { MessageAttachmentData } from "types.slint";

export component MessageItem inherits Rectangle {
    // Message identity
    in property <string> message-id: "";
    in property <string> sender-id: "";
    in property <string> timestamp-ns: "";  // Nanosecond timestamp for Signal-style (sender_id, timestamp) lookups

    // Sender info
    in property <string> sender-name: "";
    in property <string> sender-initials: "";
    in property <string> sender-avatar-url: "";

    // Content
    in property <string> content: "";
    in property <string> timestamp: "";

    // Flags
    in property <bool> is-own: false;
    in property <bool> is-edited: false;
    in property <bool> is-deleted: false;
    in property <bool> is-system: false;
    in property <bool> is-ai: false;
    in property <bool> show-sender: true;

    // Call message
    in property <bool> is-call: false;
    in property <string> call-type: "";      // "outgoing", "incoming", "missed"
    in property <string> call-duration: "";  // "1 min 30 s" or empty for missed

    // Attachments
    in property <bool> has-attachments: false;
    in property <int> attachment-count: 0;
    in property <[MessageAttachmentData]> attachments: [];

    // Audio playback state (ID of currently playing attachment)
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;  // True when audio is actively playing
    in property <float> audio-progress: 0.0;  // 0.0-1.0
    in property <string> audio-elapsed: "0:00";

    // Reactions
    in property <bool> has-reactions: false;
    in property <string> reaction-summary: "";

    // Thread
    in property <int> reply-count: 0;
    in property <string> reply-count-text: "";
    in property <bool> is-thread-reply: false;

    // Internal hover state - true when hovering message OR action buttons
    property <bool> is-hovered: touch.has-hover || action-buttons-touch.has-hover;

    // Callbacks - Signal-style identification (sender_id, timestamp_ns)
    callback reply-clicked(string, string);  // (sender_id, timestamp_ns)
    callback react-clicked(string, string);  // (sender_id, timestamp_ns)
    callback thread-clicked(string);
    callback more-clicked(string, string);  // (sender_id, timestamp_ns)
    callback message-clicked(string);
    callback attachment-clicked(string);  // attachment ID
    callback audio-seek(string, float);  // attachment ID, position 0.0-1.0

    // Styling - no layout shift, just color change on hover
    min-height: main-layout.preferred-height;
    background: root.is-hovered ? Colors.surface-hover : (root.is-own ? Colors.surface : transparent);
    border-radius: Spacing.radius-sm;

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.message-clicked(root.message-id);
        }
    }

    // Action buttons overlay - positioned absolutely at top-right
    // Always rendered but invisible when not hovered (no layout shift)
    action-buttons-touch := TouchArea {
        x: parent.width - action-buttons.width - Spacing.sm;
        y: Spacing.xs;
        width: action-buttons.width;
        height: action-buttons.height;
        visible: !root.is-system && !root.is-deleted;

        action-buttons := Rectangle {
            height: 28px;
            width: 80px;
            background: Colors.surface;
            border-radius: Spacing.radius-sm;
            border-width: 1px;
            border-color: Colors.surface-hover;
            opacity: root.is-hovered ? 1.0 : 0.0;
            // Smooth transition would be nice but Slint doesn't support CSS transitions

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                alignment: center;

                // Reply button
                Rectangle {
                    height: 24px;
                    width: 24px;
                    background: reply-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;

                    Text {
                        text: "\u{21A9}"; // Reply arrow
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    reply-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reply-clicked(root.sender-id, root.timestamp-ns);
                        }
                    }
                }

                // React button
                Rectangle {
                    height: 24px;
                    width: 24px;
                    background: react-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;

                    Text {
                        text: "\u{1F642}\u{FE0F}"; // Smile emoji (with emoji variant selector)
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    react-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.react-clicked(root.sender-id, root.timestamp-ns);
                        }
                    }
                }

                // More button
                Rectangle {
                    height: 24px;
                    width: 24px;
                    background: more-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;

                    Text {
                        text: "\u{22EE}"; // Vertical ellipsis
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    more-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.more-clicked(root.sender-id, root.timestamp-ns);
                        }
                    }
                }
            }
        }
    }

    main-layout := VerticalLayout {
        // 100% width enables text wrapping - flows from parent layout
        width: 100%;
        padding: Spacing.sm;
        spacing: Spacing.xs;

        // System message (centered, italic)
        if root.is-system && !root.is-call: Rectangle {
            // 100% width for text wrapping
            width: 100%;
            height: system-text.preferred-height;

            system-text := Text {
                width: 100%;
                text: root.content;
                color: Colors.text-muted;
                font-size: Typography.sm;
                font-italic: true;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Call message
        if root.is-call: HorizontalLayout {
            width: 100%;
            spacing: Spacing.sm;
            alignment: root.is-own ? end : start;  // Outgoing = right, Incoming = left

            // Call card
            Rectangle {
                property <bool> is-missed: root.call-type == "missed";
                property <bool> is-outgoing: root.call-type == "outgoing";

                width: call-content.preferred-width + Spacing.lg * 2;
                height: call-content.preferred-height + Spacing.md * 2;
                background: is-missed ? Colors.error.transparentize(0.9) : Colors.surface;
                border-radius: Spacing.radius-md;
                border-width: 1px;
                border-color: is-missed ? Colors.error.transparentize(0.7) : Colors.surface-hover;

                call-content := HorizontalLayout {
                    padding: Spacing.md;
                    spacing: Spacing.md;
                    alignment: center;

                    // Arrow and text
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: Spacing.xs;
                            alignment: start;

                            // Direction arrow
                            Text {
                                property <string> arrow: is-outgoing ? "\u{2197}" : "\u{2199}";  // ↗ or ↙
                                text: arrow;
                                color: is-missed ? Colors.error : (is-outgoing ? Colors.success : Colors.primary);
                                font-size: Typography.sm;
                                vertical-alignment: center;
                            }

                            // Call type text
                            Text {
                                text: is-missed ? "Missed call" : (is-outgoing ? "Outgoing call" : "Incoming call");
                                color: is-missed ? Colors.error : Colors.text-primary;
                                font-size: Typography.sm;
                                font-weight: Typography.medium;
                            }
                        }

                        // Time and duration
                        HorizontalLayout {
                            spacing: Spacing.xs;
                            alignment: start;

                            Text {
                                text: root.timestamp;
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                            }

                            if root.call-duration != "": Text {
                                text: ", " + root.call-duration;
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                            }
                        }
                    }

                    // Phone icon
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: is-missed ? Colors.error.transparentize(0.8) : Colors.primary.transparentize(0.85);

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{1F4DE}";  // Phone receiver
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                call-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.message-clicked(root.message-id);
                    }
                }
            }
        }

        // Deleted message
        if !root.is-system && root.is-deleted: Rectangle {
            // 100% width for text wrapping
            width: 100%;
            height: deleted-text.preferred-height;

            deleted-text := Text {
                width: 100%;
                text: "[Message deleted]";
                color: Colors.text-muted;
                font-size: Typography.sm;
                font-italic: true;
                wrap: word-wrap;
            }
        }

        // Normal message
        if !root.is-system && !root.is-deleted: VerticalLayout {
            // 100% width for proper text wrapping in children
            width: 100%;
            spacing: Spacing.xs;

            // Sender row (avatar + name + timestamp)
            if root.show-sender: HorizontalLayout {
                spacing: Spacing.sm;
                alignment: start;

                Avatar {
                    size: Spacing.avatar-sm;
                    fallback-text: root.sender-initials;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: Spacing.sm;
                        alignment: start;

                        // Sender name
                        Text {
                            text: root.sender-name;
                            color: root.is-ai ? Colors.info : Colors.text-primary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        // AI badge
                        if root.is-ai: Rectangle {
                            height: 16px;
                            width: ai-badge-text.preferred-width + 8px;
                            background: Colors.info;
                            border-radius: 4px;

                            ai-badge-text := Text {
                                x: 4px;
                                text: "AI";
                                color: Colors.text-primary;
                                font-size: 10px;
                                font-weight: Typography.semibold;
                                vertical-alignment: center;
                            }
                        }

                        // Timestamp
                        Text {
                            text: root.timestamp;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                        }

                        // Edited indicator
                        if root.is-edited: Text {
                            text: "(edited)";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            font-italic: true;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Content area - explicit width calculation for text wrapping
            Rectangle {
                width: 100%;
                height: content-text.preferred-height;
                clip: true;  // Prevent overflow beyond container

                // Left spacer width for avatar alignment
                property <length> spacer-width: root.show-sender ? (Spacing.avatar-sm + Spacing.sm) : 0;

                // Content text with explicit width for proper word-wrap
                content-text := Text {
                    x: spacer-width;
                    // Explicit width = parent width minus spacer - required for word-wrap to work
                    width: parent.width - spacer-width;
                    text: root.content;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    wrap: word-wrap;
                }
            }

            // Attachments display
            if root.has-attachments: VerticalLayout {
                padding-left: root.show-sender ? (Spacing.avatar-sm + Spacing.sm) : 0;
                spacing: Spacing.sm;
                alignment: start;

                // Render each attachment
                for attachment in root.attachments: HorizontalLayout {
                    alignment: start;

                    // Image attachments - show thumbnail or placeholder
                    if attachment.is-image: Rectangle {
                        // Calculate size based on actual image dimensions
                        // Max width 300px, max height 400px (taller for phone screenshots)
                        property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.5;
                        property <length> max-w: 300px;
                        property <length> max-h: 400px;
                        // If image is wider than tall, constrain by width
                        // If image is taller than wide, constrain by height
                        property <length> calc-w: aspect-ratio >= 1 ? min(max-w, attachment.width * 1px) : min(max-h * aspect-ratio, attachment.width * 1px);
                        property <length> calc-h: aspect-ratio >= 1 ? min(max-h, calc-w / aspect-ratio) : min(max-h, attachment.height * 1px);
                        // Final dimensions - use calculated or fallback for no-thumbnail
                        width: attachment.has-thumbnail && attachment.width > 0 ? max(120px, min(max-w, calc-w)) : 200px;
                        height: attachment.has-thumbnail && attachment.height > 0 ? max(80px, min(max-h, calc-h)) : 160px;
                        background: Colors.surface;
                        border-radius: Spacing.radius-md;
                        clip: true;

                        // Show actual thumbnail if available
                        if attachment.has-thumbnail: Image {
                            width: 100%;
                            height: 100%;
                            source: attachment.thumbnail;
                            image-fit: contain;  // Show entire image, don't crop
                        }

                        // Show placeholder if no thumbnail
                        if !attachment.has-thumbnail: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Colors.surface-hover;

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.xs;

                                Text {
                                    text: "\u{1F5BC}\u{FE0F}";  // Frame with picture (with emoji variant selector)
                                    font-size: 40px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: attachment.filename;
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: attachment.size-display;
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Click to view";
                                    color: Colors.primary;
                                    font-size: Typography.xs;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Progress overlay for image uploads/downloads
                        if attachment.is-uploading || attachment.is-downloading: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: #00000080;

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.sm;

                                Text {
                                    text: attachment.is-uploading ? "Uploading..." : "Downloading...";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    horizontal-alignment: center;
                                }

                                // Progress bar
                                Rectangle {
                                    width: 80%;
                                    height: 6px;
                                    background: Colors.surface-hover;
                                    border-radius: 3px;

                                    Rectangle {
                                        width: parent.width * attachment.progress;
                                        height: 100%;
                                        background: attachment.is-uploading ? Colors.success : Colors.primary;
                                        border-radius: 3px;
                                    }
                                }

                                Text {
                                    text: round(attachment.progress * 100) + "%";
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        img-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.attachment-clicked(attachment.id);
                            }
                        }
                    }

                    // Audio attachments - show audio player
                    if attachment.category == "audio": Rectangle {
                        property <bool> is-this-playing: attachment.id == root.current-playing-attachment-id;

                        width: 320px;  // Fixed max width for audio player
                        height: 72px;
                        background: Colors.surface;
                        border-radius: Spacing.radius-md;
                        border-width: 1px;
                        border-color: is-this-playing ? Colors.primary : Colors.surface-hover;

                        HorizontalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.sm;

                            // Play/Pause button
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 24px;
                                background: audio-play-touch.has-hover ? Colors.primary.darker(0.1) : Colors.primary;

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    // Show pause icon only when this attachment is playing AND not paused
                                    text: (is-this-playing && root.is-media-playing) ? "\u{23F8}" : "\u{25B6}";  // Pause or Play
                                    color: Colors.text-primary;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                audio-play-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.attachment-clicked(attachment.id);
                                    }
                                }
                            }

                            // Waveform and info
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: Spacing.xs;

                                // Filename
                                Text {
                                    text: attachment.filename;
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    overflow: elide;
                                }

                                // Dynamic waveform visualization with progress
                                waveform-container := Rectangle {
                                    height: 24px;
                                    background: Colors.surface-hover;
                                    border-radius: Spacing.radius-sm;
                                    clip: true;

                                    // Waveform bars with progress highlighting
                                    HorizontalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: center;

                                        // Dynamic bars from waveform data - wrapped to align bottom
                                        for bar[idx] in attachment.waveform: VerticalLayout {
                                            alignment: end;  // Align bars to bottom (grow upward)
                                            width: 3px;

                                            Rectangle {
                                                property <float> bar-position: (idx + 1) / 32.0;
                                                property <bool> is-played: is-this-playing && bar-position <= root.audio-progress;

                                                width: 3px;
                                                // Scale bar height: 0-100 maps to 4-16px
                                                height: max(4px, bar * 0.12px + 4px);
                                                // Bright purple if played, dim purple otherwise
                                                background: is-played ? #a78bfa : #4c1d95;
                                                border-radius: 1px;
                                            }
                                        }
                                    }

                                    // Clickable area for seeking
                                    waveform-touch := TouchArea {
                                        // Track click position for seek calculation
                                        property <float> seek-pos: clamp((self.mouse-x - 4px) / (parent.width - 8px), 0.0, 1.0);

                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.audio-seek(attachment.id, self.seek-pos);
                                        }
                                    }
                                }

                                // Duration / elapsed time
                                HorizontalLayout {
                                    spacing: Spacing.xs;

                                    Text {
                                        text: is-this-playing ? root.audio-elapsed : (attachment.duration-display != "" ? attachment.duration-display : attachment.size-display);
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }

                                    // Show total duration when playing
                                    if is-this-playing && attachment.duration-display != "": Text {
                                        text: " / " + attachment.duration-display;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }
                            }
                        }

                        // Progress bar at bottom when downloading (audio files need download first)
                        if attachment.is-downloading: Rectangle {
                            x: 0;
                            y: parent.height - 4px;
                            width: parent.width;
                            height: 4px;
                            background: Colors.surface-hover;
                            border-radius: 2px;

                            Rectangle {
                                width: parent.width * attachment.progress;
                                height: 100%;
                                background: Colors.primary;
                                border-radius: 2px;
                            }
                        }
                    }

                    // Video attachments - show video preview with play overlay
                    if attachment.category == "video": Rectangle {
                        width: 300px;  // Fixed max width for video preview
                        height: 180px;
                        background: Colors.surface;
                        border-radius: Spacing.radius-md;
                        clip: true;

                        // Video thumbnail placeholder
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: #1a1a2e;

                            // Film strip pattern
                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.xs;

                                Text {
                                    text: "\u{1F3AC}\u{FE0F}";  // Clapper board (with emoji variant selector)
                                    font-size: 48px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: attachment.filename;
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: attachment.size-display;
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Play button overlay
                        Rectangle {
                            x: (parent.width - 64px) / 2;
                            y: (parent.height - 64px) / 2 - 20px;
                            width: 64px;
                            height: 64px;
                            border-radius: 32px;
                            background: video-play-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "\u{25B6}";
                                color: Colors.text-primary;
                                font-size: 28px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        video-play-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.attachment-clicked(attachment.id);
                            }
                        }
                    }

                    // Other non-image/audio/video attachments - show file card
                    if !attachment.is-image && attachment.category != "audio" && attachment.category != "video": Rectangle {
                        width: 280px;  // Fixed max width for file cards
                        height: 56px;
                        background: Colors.surface;
                        border-radius: Spacing.radius-sm;
                        border-width: 1px;
                        border-color: Colors.surface-hover;

                        HorizontalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.sm;

                            // Icon
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: Spacing.radius-sm;
                                background: attachment.icon-color.transparentize(0.85);

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: attachment.icon;
                                    font-size: Typography.lg;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // File info
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: attachment.filename;
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    overflow: elide;
                                }
                                Text {
                                    text: attachment.size-display;
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }
                            }

                            // Download icon or progress indicator
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                background: file-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-sm;

                                // Show spinner when uploading/downloading
                                if attachment.is-uploading || attachment.is-downloading: Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    x: 4px;
                                    y: 4px;
                                    border-radius: 12px;
                                    border-width: 2px;
                                    border-color: Colors.surface-hover;

                                    // Progress arc (simplified as a partial border)
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        border-width: 2px;
                                        border-color: Colors.primary;
                                        clip: true;

                                        // Progress fill
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * attachment.progress;
                                            height: parent.height;
                                            background: Colors.primary.transparentize(0.7);
                                        }
                                    }
                                }

                                // Show download icon when not transferring
                                if !attachment.is-uploading && !attachment.is-downloading: Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "\u{2B07}";  // Down arrow
                                    font-size: Typography.base;
                                    color: Colors.primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Progress bar at bottom when transferring
                        if attachment.is-uploading || attachment.is-downloading: Rectangle {
                            x: 0;
                            y: parent.height - 4px;
                            width: parent.width;
                            height: 4px;
                            background: Colors.surface-hover;
                            border-radius: 2px;

                            Rectangle {
                                width: parent.width * attachment.progress;
                                height: 100%;
                                background: attachment.is-uploading ? Colors.success : Colors.primary;
                                border-radius: 2px;
                            }
                        }

                        file-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.attachment-clicked(attachment.id);
                            }
                        }
                    }
                }
            }

            // Bottom row: reactions and thread
            if root.has-reactions || root.reply-count > 0: HorizontalLayout {
                padding-left: root.show-sender ? (Spacing.avatar-sm + Spacing.sm) : 0;
                padding-top: Spacing.xs;
                spacing: Spacing.md;
                alignment: start;

                // Reactions summary
                if root.has-reactions: Rectangle {
                    height: reactions-text.preferred-height + 4px;
                    width: reactions-text.preferred-width + Spacing.sm;
                    background: Colors.surface;
                    border-radius: Spacing.radius-sm;

                    reactions-text := Text {
                        x: Spacing.xs;
                        text: root.reaction-summary;
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }

                    reactions-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.react-clicked(root.sender-id, root.timestamp-ns);
                        }
                    }
                }

                // Thread indicator
                if root.reply-count > 0: Rectangle {
                    height: thread-layout.preferred-height + 4px;
                    width: thread-layout.preferred-width + Spacing.sm;

                    thread-layout := HorizontalLayout {
                        spacing: Spacing.xs;
                        padding: 2px;

                        Text {
                            text: "\u{1F5E8}\u{FE0F}"; // Speech balloon (with emoji variant selector)
                            font-size: Typography.xs;
                        }

                        Text {
                            text: root.reply-count-text;
                            color: Colors.primary;
                            font-size: Typography.xs;
                        }
                    }

                    thread-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.thread-clicked(root.message-id);
                        }
                    }
                }
            }
        }

    }
}
