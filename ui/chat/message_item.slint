// Single message item component with bubble layout
//
// Displays an individual message with chat-style bubbles.
// Own messages: right-aligned with primary tint
// Others' messages: left-aligned with surface color
// DMs: No avatar/name (minimal), Channels: Avatar/name for others

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Avatar } from "../components/avatar.slint";
import { Haptics } from "../components/haptics.slint";
import { MessageAttachmentData, ReactionEntry, RichTextSpan } from "types.slint";
import { Icons } from "../theme/icons.slint";
import { AudioPlayer } from "audio_player.slint";
import { HoldArea } from "../components/hold_area.slint";

export component MessageItem inherits Rectangle {
    // Message identity
    in property <string> message-id: "";
    in property <string> sender-id: "";
    in property <string> timestamp-ns: "";

    // Sender info
    in property <string> sender-name: "";
    in property <string> sender-initials: "";
    in property <image> sender-avatar-source;
    in property <bool> has-avatar: false;

    // Content
    in property <string> content: "";
    in property <[RichTextSpan]> rich-content: [];
    in property <string> timestamp: "";

    // Ordinary messages have one span, even when they contain no markdown.
    // Keep that common case out of the nested rich-text layout/repeater.
    property <bool> single-text-span: root.rich-content.length == 1
        && !root.rich-content[0].code && !root.rich-content[0].code-block
        && !root.rich-content[0].strikethrough;
    property <length> text-max-width: root.width * 0.7 - Spacing.sm * 2;

    // Flags
    in property <bool> is-own: false;
    in property <bool> is-edited: false;
    in property <bool> is-deleted: false;
    in property <bool> is-system: false;
    in property <bool> is-ai: false;
    in property <bool> is-pinned: false;
    in property <bool> show-sender: true;
    in property <bool> is-dm: false;  // When true, hide avatar/name - just bubbles
    in property <bool> can-thread: true;  // Threads are a channel feature
    in property <string> failure-reason: "";
    in property <string> delivery-status: "";  // "sending", "sent", "failed", "delivered", "read" for own messages
    /// Whether this message went over the mesh. Set by the caller rather than
    /// inferred from the status string: "sent" is a mesh state too — in fact the
    /// most common one, since every room and cell message is a broadcast — so a
    /// string allowlist silently sends the majority of mesh traffic down the
    /// tick path it exists to avoid.
    in property <bool> is-mesh: false;
    // Mesh delivery is rendered as words, never ticks. Over couriers "sent" and
    // "delivered" can be hours apart, and a tick carries a learned promise
    // ("this lands in a second") that is wrong here by orders of magnitude.
    property <bool> mesh-delivery: root.is-mesh && root.delivery-status != "";

    // Call message
    in property <bool> is-call: false;
    in property <string> call-type: "";
    in property <string> call-duration: "";

    // Attachments
    in property <bool> has-attachments: false;
    in property <int> attachment-count: 0;
    in property <[MessageAttachmentData]> attachments: [];

    // Audio playback state
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;
    in property <float> audio-progress: 0.0;
    in property <string> audio-elapsed: "0:00";

    // Reactions
    in property <bool> has-reactions: false;
    in property <string> reaction-summary: "";
    in property <[ReactionEntry]> reactions: [];

    // Thread
    in property <int> reply-count: 0;
    in property <string> reply-count-text: "";
    in property <bool> is-thread-reply: false;

    // Message grouping
    in property <bool> is-continuation: false;  // Hide avatar/name for consecutive same-sender messages

    // Quote / reply-to context
    in property <bool> is-reply: false;
    in property <bool> reply-to-not-found: false;  // Quoted parent missing/deleted
    in property <string> reply-to-message-id: "";  // Parent MessageId — tap-to-jump target
    in property <bool> highlighted: false;          // Brief green flash when this is a jump target
    // Animate outside the conditional overlay so it survives until fade-out ends.
    property <float> highlight-progress: root.highlighted ? 1.0 : 0.0;
    animate highlight-progress { duration: 400ms; easing: ease-out; }
    in property <string> reply-to-sender-name: "";
    in property <string> reply-to-preview: "";
    in property <string> reply-to-category: "";        // Quoted parent media category ("audio"/"image"/"video"/"")
    in property <string> reply-to-attachment-id: "";    // Quoted parent's media attachment id (inline quote player)
    in property <string> reply-to-duration: "";         // Quoted audio parent duration ("0:37")
    in property <string> reply-to-filename: "";         // Quoted audio parent filename (inline quote player)
    in property <[int]> reply-to-waveform: [];          // Quoted audio parent waveform (32 values 0-100)
    in property <bool> reply-to-has-thumbnail: false;
    in property <image> reply-to-thumbnail;
    in property <int> reply-to-thumbnail-width: 0;      // Quoted thumbnail natural dims for aspect sizing (0 = unknown)
    in property <int> reply-to-thumbnail-height: 0;

    // Internal hover state — touch covers entire message row.
    //
    // Pointer-only, deliberately. `has-hover` is true while a finger is DOWN,
    // not just under a mouse: Slint sets it from any pointer event carrying a
    // position (i-slint-core input_items.rs), so on Android the action bar
    // below flashed into existence mid-press and vanished on release. You had
    // to predict where it would draw and land on it blind, and a plain scroll
    // spawned it under the thumb. Press-and-hold (below) is the touch entry
    // point to the same menu, so gating this on `!mobile` costs touch nothing.
    property <bool> is-hovered: !root.mobile && touch.has-hover;

    // Multi-select
    in property <bool> selected: false;
    in property <bool> selection-mode: false;
    // Touch platform. Gates the hold gesture so a desktop left-button hold
    // does not open the menu (desktop keeps right-click).
    in property <bool> mobile: false;

    // Callbacks
    callback reply-clicked(string, string);
    callback react-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    // Tapping an existing reaction toggles YOUR reaction of that emoji. Before
    // this the whole pill only opened the picker, so there was no way to take a
    // reaction back except adding it again from the picker (§112w).
    callback reaction-toggled(string, string, string);  // (sender_id, timestamp_ns, emoji)
    callback thread-clicked(string);
    callback more-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback selection-toggled(string);
    callback message-clicked(string);
    callback attachment-clicked(string);
    callback audio-seek(string, float);
    callback quote-clicked(string);  // (reply-to-message-id) — jump to quoted original

    // ── Press-and-hold gesture (touch only) ──
    //
    // >= 500ms opens the message menu, anchored under the bubble. Moving more
    // than the slop cancels: it was a scroll, not a hold.
    //
    // A second tier (>= 1200ms escalating into multi-select) was built and
    // removed. It cannot work while tier 1 shows a full-screen-backdrop menu:
    // the backdrop takes the pointer grab the instant it appears, Slint
    // delivers the loss as PointerEventKind::Cancel, and the gesture ends
    // there. Verified on device — a 1600ms hold produced the menu and nothing
    // else. Multi-select is reached by "Select" in that menu instead.
    //
    // Driven by our own timers rather than by the platform long-press, because
    // there is no platform long-press to ride: the Android backend in this tree
    // only ever produces PointerEventButton::Right from a real secondary mouse
    // button (androidwindowadapter.rs button_for_event — a finger goes through
    // MotionAction::Down and yields Left). The right-button branch below is
    // therefore desktop-only, and the two paths cannot both fire.
    property <length> hold-slop: 12px;
    property <length> press-x: 0px;
    property <length> press-y: 0px;
    // Where the menu should anchor. Captured at touch-down from the bubble's
    // own TouchArea: `bubble` sits inside a conditional subtree, so its id is
    // not reachable from a component-level function.
    property <length> anchor-x: 0px;
    property <length> anchor-y: 0px;
    property <bool> holding: false;
    // 0 = nothing fired yet, 1 = menu opened, 2 = selection engaged. Also used
    // to swallow the release-tap, so a hold never doubles as a click.
    property <int> hold-tier: 0;

    function cancel-hold() {
        root.holding = false;
        tier1-timer.running = false;
    }

    function open-menu() {
        root.more-clicked(root.sender-id, root.timestamp-ns, root.anchor-x, root.anchor-y);
    }

    tier1-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.hold-tier = 1;
            // Same tick as every other hold in the app (ui/components/hold_area.slint).
            // The bubble gesture predates that component and keeps its own timer,
            // so the feedback has to be repeated here or holds would feel
            // different depending on what you held.
            Haptics.long-press();
            root.open-menu();
        }
    }

    // Styling
    min-height: main-layout.preferred-height;
    // Selected rows tint rather than outline the flat bubbles.
    background: root.selected ? Colors.primary.with-alpha(0.18) : transparent;
    animate background { duration: 150ms; easing: ease-out; }

    // Wrap entire content in TouchArea for reliable hover detection.
    // Width/Height 100% ensures it covers the whole row.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            // In selection mode a plain tap anywhere on the row toggles this
            // message instead of doing whatever a tap normally does.
            if (root.selection-mode) {
                root.selection-toggled(root.message-id);
                return;
            }
            root.message-clicked(root.message-id);
        }

    main-layout := VerticalLayout {
        width: 100%;
        padding: root.is-continuation ? Spacing.message-padding-continuation : Spacing.message-padding;
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: root.is-continuation ? Spacing.xxs : Spacing.xs;

        // System message (centered, no bubble)
        if root.is-system && !root.is-call: Rectangle {
            width: 100%;
            height: system-text.preferred-height + Spacing.sm;

            system-text := Text {
                width: 100%;
                text: root.content;
                color: Colors.text-muted;
                font-size: Typography.sm;
                font-italic: true;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Call message (card style, aligned based on direction)
        if root.is-call: HorizontalLayout {
            width: 100%;
            spacing: Spacing.sm;
            alignment: root.is-own ? end : start;

            Rectangle {
                property <bool> is-missed: root.call-type == "missed";
                // Direction is who PLACED the call — `is-own` is exactly that
                // for a call message (converters/message.rs, initiator ==
                // current user). call-type only says outgoing/incoming for
                // answered calls, so a caller's "declined" drew ↙ (RC24 D4).
                property <bool> is-outgoing: root.is-own;

                // call-content carries its own padding; adding more here left
                // slack that the fixed-size icon did not share.
                width: call-content.preferred-width;
                height: call-content.preferred-height;
                background: is-missed ? Colors.error.transparentize(0.9) : Colors.surface;
                border-radius: Spacing.radius-lg;

                call-content := HorizontalLayout {
                    padding: Spacing.md;
                    spacing: Spacing.md;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: Spacing.xs;
                            alignment: start;

                            Text {
                                property <string> arrow: is-outgoing ? "\u{2197}" : "\u{2199}";
                                text: arrow;
                                color: is-missed ? Colors.error : (is-outgoing ? Colors.success : Colors.primary);
                                font-size: Typography.sm;
                                vertical-alignment: center;
                            }

                            Text {
                                text: is-missed ? "Missed call"
                                    : root.call-type == "declined" ? "Declined call"
                                    : is-outgoing ? "Outgoing call" : "Incoming call";
                                color: is-missed ? Colors.error : Colors.text-primary;
                                font-size: Typography.sm;
                                font-weight: Typography.medium;
                            }
                        }

                        // One Text: two laid out side by side put the layout
                        // spacing before the separator ("01:36 , 17s").
                        Text {
                            text: root.call-duration != "" ? root.timestamp + " · " + root.call-duration : root.timestamp;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                        }
                    }

                    // A fixed-size child of a HorizontalLayout sits at the
                    // row's top; centre the icon on the text block's axis.
                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: is-missed ? Colors.error.transparentize(0.8) : Colors.primary.transparentize(0.85);

                            Image {
                                width: 20px;
                                height: 20px;
                                source: Icons.phone;
                                colorize: is-missed ? Colors.error : Colors.primary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                call-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.message-clicked(root.message-id);
                    }
                }
            }
        }

        // Deleted message (simple text, aligned)
        if !root.is-system && !root.is-call && root.is-deleted: HorizontalLayout {
            width: 100%;
            alignment: root.is-own ? end : start;

            Text {
                text: "Message deleted";
                color: Colors.text-muted;
                font-size: Typography.sm;
                font-italic: true;
            }
        }

        // Normal message with bubble layout
        if !root.is-system && !root.is-call && !root.is-deleted: HorizontalLayout {
            width: 100%;
            spacing: Spacing.sm;
            alignment: root.is-own ? end : start;

            // Avatar for others in channels (before bubble, hidden in continuations)
            if !root.is-own && !root.is-dm && root.show-sender && !root.is-continuation: Avatar {
                size: Spacing.avatar-sm;
                source: root.sender-avatar-source;
                fallback-text: root.sender-initials;
            }

            // Message bubble
            VerticalLayout {
                spacing: Spacing.xs;
                // Limit bubble width to 70% of container
                max-width: root.width * 0.7;

                // Wrapper for bubble + absolutely positioned reactions
                Rectangle {
                    width: bubble.width;
                    height: bubble.height + (root.has-reactions ? 11px : 0);

                bubble := Rectangle {
                    property <bool> bubble-hovered: bubble-touch.has-hover;
                    accessible-role: text;
                    accessible-label: root.is-own ? "Your message: " + root.content : root.sender-name + " says: " + root.content;

                    // Flat bubbles use tone to distinguish sender and AI messages.
                    background: root.is-ai
                        ? (bubble-hovered ? Colors.primary.with-alpha(0.12) : Colors.primary.with-alpha(0.08))
                        : (bubble-hovered
                            ? (root.is-own ? Colors.bubble-own-hover : Colors.bubble-other-hover)
                            : (root.is-own ? Colors.bubble-own : Colors.bubble-other));
                    border-radius: Spacing.radius-md;

                    // Calculate height based on content
                    height: bubble-content.preferred-height;
                    width: bubble-content.preferred-width + (root.is-ai ? 4px : 0);

                    // AI message left accent bar
                    if root.is-ai: Rectangle {
                        x: 0;
                        y: 4px;
                        width: 3px;
                        height: parent.height - 8px;
                        border-radius: 1.5px;
                        background: Colors.primary;
                    }

                    bubble-touch := TouchArea {
                        mouse-cursor: pointer;

                        pointer-event(event) => {
                            // Desktop: right-click opens the menu at the cursor.
                            // Unreachable from a finger — see the note on the
                            // hold timers above.
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.more-clicked(root.sender-id, root.timestamp-ns,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                                return;
                            }

                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.press-x = self.mouse-x;
                                root.press-y = self.mouse-y;
                                // Anchor under the bubble, not under the finger,
                                // so the menu does not open beneath the thumb
                                // that opened it.
                                root.anchor-x = self.absolute-position.x;
                                root.anchor-y = self.absolute-position.y + self.height;
                                root.hold-tier = 0;
                                // No hold while already selecting: there, a tap
                                // is the toggle and a hold would re-open a menu
                                // over the selection bar.
                                if (root.mobile && !root.selection-mode
                                    && !root.is-system && !root.is-deleted && !root.is-call) {
                                    root.holding = true;
                                    tier1-timer.running = true;
                                }
                            }

                            // Release, or a grab stolen by the scrolling
                            // Flickable (Slint delivers that as Cancel).
                            //
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                root.cancel-hold();
                            }
                        }

                        moved => {
                            if (root.holding
                                && (abs(self.mouse-x - root.press-x) > root.hold-slop
                                    || abs(self.mouse-y - root.press-y) > root.hold-slop)) {
                                root.cancel-hold();
                            }
                        }

                        clicked => {
                            if (root.selection-mode) {
                                root.selection-toggled(root.message-id);
                                return;
                            }
                            // Swallow the release that ends a hold, so opening
                            // the menu does not also count as a tap.
                            if (root.hold-tier != 0) {
                                root.hold-tier = 0;
                                return;
                            }
                            root.message-clicked(root.message-id);
                        }
                    }

                    bubble-content := VerticalLayout {
                        padding: Spacing.sm + 2px;
                        padding-left: root.is-ai ? Spacing.sm + 6px : Spacing.sm + 2px;
                        spacing: Spacing.xs;

                        // Sender name + timestamp (only in channels for others, hidden in continuations)
                        if !root.is-own && !root.is-dm && root.show-sender && !root.is-continuation: HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            Text {
                                text: root.sender-name;
                                color: root.is-ai ? Colors.info : Colors.primary;
                                font-size: Typography.sm;
                                font-weight: Typography.medium;
                            }

                            if root.is-ai: Rectangle {
                                height: Spacing.badge-sm;
                                width: ai-text.preferred-width + 8px;
                                background: Colors.info;
                                border-radius: 4px;

                                ai-text := Text {
                                    x: 4px;
                                    text: "AI";
                                    color: Colors.text-primary;
                                    font-size: Typography.xs;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Thread-reply chip — marks a message that lives in a
                        // thread (vs a main-chat quote reply, which shows the
                        // quote block below). Purple to keep it distinct from
                        // the teal quote accent.
                        if root.is-thread-reply: HorizontalLayout {
                            spacing: 4px;
                            alignment: start;

                            Image {
                                width: 11px;
                                height: 11px;
                                source: Icons.message-circle;
                                colorize: Colors.accent-purple;
                            }

                            Text {
                                text: "Thread reply";
                                color: Colors.accent-purple;
                                font-size: Typography.xs;
                                font-italic: true;
                            }
                        }

                        // Quote / reply-to bubble
                        if root.is-reply: Rectangle {
                            background: root.is-own ? Colors.background.with-alpha(0.08) : Colors.background.with-alpha(0.06);
                            border-radius: 6px;
                            max-width: root.text-max-width;
                            height: quote-row.preferred-height + Spacing.xs;

                            // Tap the quote to jump to the original message.
                            // Suppressed when the parent is gone/unknown.
                            //
                            // Declared BEFORE quote-row so it sits on the bottom
                            // z-layer: the inline audio player's play/seek
                            // TouchAreas (inside quote-row, above this) consume
                            // their own clicks, while taps on text/thumbnail —
                            // which carry no TouchArea — fall through here to jump.
                            quote-touch := TouchArea {
                                mouse-cursor: (root.reply-to-not-found || root.reply-to-message-id == "") ? default : pointer;
                                clicked => {
                                    if (!root.reply-to-not-found && root.reply-to-message-id != "") {
                                        root.quote-clicked(root.reply-to-message-id);
                                    }
                                }
                            }

                            // Compact Signal/Telegram-style quote: small media
                            // thumbnail on the LEFT, sender + label/player filling
                            // the right. A thin strip — no big block that leaves a
                            // wasted L-shape when the reply body is wide.
                            quote-row := HorizontalLayout {
                                padding: Spacing.xs;
                                spacing: Spacing.sm;
                                alignment: stretch;

                                // Accent bar
                                Rectangle {
                                    width: 3px;
                                    background: Colors.primary;
                                    border-radius: 1.5px;
                                }

                                // Small media thumbnail on the LEFT (image/gif/video).
                                // Aspect-fit within a compact box so the whole preview
                                // shows without dominating the bubble.
                                if root.reply-to-category != "audio" && root.reply-to-has-thumbnail: Rectangle {
                                    property <float> aspect: root.reply-to-thumbnail-width > 0 && root.reply-to-thumbnail-height > 0
                                        ? root.reply-to-thumbnail-width / root.reply-to-thumbnail-height
                                        : 1.4;
                                    property <length> max-h: 60px;
                                    property <length> max-w: 96px;
                                    height: min(self.max-h, self.max-w / self.aspect);
                                    width: self.height * self.aspect;
                                    border-radius: 4px;
                                    clip: true;

                                    Image {
                                        source: root.reply-to-thumbnail;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }

                                    // Video play badge (compact, centered).
                                    if root.reply-to-category == "video": Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Colors.overlay;
                                        Image {
                                            width: 9px;
                                            height: 9px;
                                            source: Icons.play;
                                            colorize: Colors.text-primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    // GIF chip — tiny corner tag.
                                    if root.reply-to-category == "gif": Rectangle {
                                        x: 2px;
                                        y: 2px;
                                        width: gif-label.preferred-width + 6px;
                                        height: 13px;
                                        border-radius: 3px;
                                        background: Colors.primary;
                                        gif-label := Text {
                                            text: "GIF";
                                            color: Colors.text-primary;
                                            font-size: 8px;
                                            font-weight: Typography.semibold;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }

                                // Right column — sender name + label/player, fills
                                // the width beside the thumbnail (no empty gap).
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: root.reply-to-sender-name;
                                        color: Colors.primary;
                                        font-size: Typography.xs;
                                        font-weight: Typography.semibold;
                                        overflow: elide;
                                    }

                                    // Audio parent — the shared inline player (compact
                                    // variant). Its play/seek TouchAreas sit above
                                    // quote-touch so they consume their clicks; the rest
                                    // of the quote still falls through to jump.
                                    if root.reply-to-category == "audio": AudioPlayer {
                                        mobile: root.mobile;
                                        compact: true;
                                        attachment-id: root.reply-to-attachment-id;
                                        filename: root.reply-to-filename;
                                        waveform: root.reply-to-waveform;
                                        duration-display: root.reply-to-duration;
                                        current-playing-attachment-id: root.current-playing-attachment-id;
                                        is-media-playing: root.is-media-playing;
                                        audio-progress: root.audio-progress;
                                        audio-elapsed: root.audio-elapsed;

                                        play-clicked(id) => { root.attachment-clicked(id); }
                                        audio-seek(id, pos) => { root.audio-seek(id, pos); }
                                    }

                                    // Non-audio: one-line preview/label filling the
                                    // right of the thumbnail. Guard the empty edge so
                                    // the quote is never just a bare sender name.
                                    if root.reply-to-category != "audio": Text {
                                        text: root.reply-to-preview != ""
                                            ? root.reply-to-preview
                                            : (root.reply-to-category != "" ? "📎 Attachment" : "Message");
                                        color: Colors.text-secondary;
                                        font-size: Typography.xs;
                                        overflow: elide;
                                    }

                                    // Signal-Desktop parity: warn when the original is gone.
                                    if root.reply-to-not-found: Text {
                                        text: "Original message not found";
                                        color: Colors.warning;
                                        font-size: Typography.xs;
                                        font-italic: true;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Message content — rich text rendering
                        // Uses parsed markdown spans when available, falls back to plain text
                        if root.content != "" && root.rich-content.length > 0 && !root.single-text-span: VerticalLayout {
                            spacing: 4px;
                            max-width: root.text-max-width;

                            for span in root.rich-content: VerticalLayout {
                                // Code block: monospace + dark background
                                if span.code-block: Rectangle {
                                    background: root.is-own ? Colors.background.with-alpha(0.12) : Colors.code-bg;
                                    border-radius: 4px;

                                    VerticalLayout {
                                        padding: 8px;

                                        Text {
                                            text: span.text;
                                            color: span.code-block && !root.is-own ? Colors.code-text : Colors.text-primary;
                                            font-family: Typography.font-family-mono;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                            max-width: root.text-max-width - 16px;
                                        }
                                    }
                                }

                                // Inline code: monospace + subtle background
                                if span.code && !span.code-block: HorizontalLayout {
                                    alignment: start;

                                    Rectangle {
                                        background: root.is-own ? Colors.background.with-alpha(0.08) : Colors.surface-hover;
                                        border-radius: 3px;
                                        width: code-text.preferred-width + 8px;
                                        height: code-text.preferred-height + 4px;

                                        code-text := Text {
                                            x: 4px;
                                            y: 2px;
                                            text: span.text;
                                            color: Colors.text-primary;
                                            font-family: Typography.font-family-mono;
                                            font-size: Typography.xs;
                                        }
                                    }
                                }

                                // Strikethrough: text with line-through overlay
                                if span.strikethrough && !span.code && !span.code-block: Rectangle {
                                    height: strike-text.preferred-height;
                                    width: strike-text.preferred-width;

                                    strike-text := Text {
                                        text: span.text;
                                        color: Colors.text-secondary;
                                        font-size: Typography.sm;
                                        wrap: word-wrap;
                                        max-width: root.text-max-width;
                                    }

                                    Rectangle {
                                        y: parent.height / 2;
                                        height: 1px;
                                        width: strike-text.preferred-width;
                                        background: Colors.text-secondary;
                                    }
                                }

                                // Normal / bold / italic text
                                if !span.code && !span.code-block && !span.strikethrough: Text {
                                    text: span.text;
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: span.bold ? 700 : 400;
                                    font-italic: span.italic;
                                    wrap: word-wrap;
                                    max-width: root.text-max-width;
                                }
                            }
                        }

                        // Plain text and a single normal/bold/italic span share one Text.
                        if root.content != "" && (root.rich-content.length == 0 || root.single-text-span): Text {
                            text: root.single-text-span ? root.rich-content[0].text : root.content;
                            font-weight: root.single-text-span && root.rich-content[0].bold ? 700 : 400;
                            font-italic: root.single-text-span && root.rich-content[0].italic;
                            color: Colors.text-primary;
                            font-size: Typography.sm;
                            wrap: word-wrap;
                            max-width: root.text-max-width;
                        }

                        // Attachments
                        if root.has-attachments: VerticalLayout {
                            spacing: Spacing.sm;

                            for attachment in root.attachments: HorizontalLayout {
                                alignment: start;

                                // Image attachments
                                if attachment.is-image: Rectangle {
                                    property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.5;
                                    property <length> max-w: min(280px, root.width * 0.7 - Spacing.md);
                                    property <length> max-h: 380px;
                                    property <length> calc-w: aspect-ratio >= 1 ? min(max-w, attachment.width * 1px) : min(max-h * aspect-ratio, attachment.width * 1px);
                                    property <length> calc-h: aspect-ratio >= 1 ? min(max-h, calc-w / aspect-ratio) : min(max-h, attachment.height * 1px);

                                    width: attachment.has-thumbnail && attachment.width > 0 ? max(100px, min(max-w, calc-w)) : 180px;
                                    height: attachment.has-thumbnail && attachment.height > 0 ? max(60px, min(max-h, calc-h)) : 140px;
                                    background: Colors.surface;
                                    border-radius: Spacing.radius-sm;
                                    clip: true;

                                    if attachment.has-thumbnail: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: attachment.thumbnail;
                                        image-fit: contain;
                                    }

                                    if !attachment.has-thumbnail: Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Colors.surface-hover;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Spacing.xs;

                                            Image {
                                                width: 32px;
                                                height: 32px;
                                                source: Icons.image;
                                                colorize: Colors.text-muted;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: attachment.filename;
                                                color: Colors.text-secondary;
                                                font-size: Typography.xs;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Progress overlay
                                    if attachment.is-uploading || attachment.is-downloading: Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Colors.overlay;
                                        accessible-role: progress-indicator;
                                        accessible-label: attachment.is-uploading ? "Uploading " + attachment.filename : "Downloading " + attachment.filename;
                                        accessible-value: Math.round(attachment.progress * 100) + " percent";

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Spacing.sm;

                                            Text {
                                                text: attachment.is-uploading ? "Uploading..." : "Downloading...";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                horizontal-alignment: center;
                                            }

                                            Rectangle {
                                                width: 80%;
                                                height: 4px;
                                                background: Colors.surface-hover;
                                                border-radius: 2px;

                                                Rectangle {
                                                    width: parent.width * attachment.progress;
                                                    height: 100%;
                                                    background: Colors.primary;
                                                    border-radius: 2px;
                                                }
                                            }
                                        }
                                    }

                                    img-touch := HoldArea {
                                        enabled-for-touch: root.mobile;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (self.hold-fired) { return; }
                                            root.attachment-clicked(attachment.id);
                                        }
                                        held => {
                                            root.more-clicked(root.sender-id, root.timestamp-ns,
                                                self.anchor-x, self.anchor-y);
                                        }
                                    }
                                }

                                // Audio attachments — shared inline player
                                if attachment.category == "audio": AudioPlayer {
                                    mobile: root.mobile;
                                    attachment-id: attachment.id;
                                    filename: attachment.filename;
                                    waveform: attachment.waveform;
                                    duration-display: attachment.duration-display;
                                    current-playing-attachment-id: root.current-playing-attachment-id;
                                    is-media-playing: root.is-media-playing;
                                    audio-progress: root.audio-progress;
                                    audio-elapsed: root.audio-elapsed;

                                    play-clicked(id) => { root.attachment-clicked(id); }
                                    audio-seek(id, pos) => { root.audio-seek(id, pos); }
                                    more-clicked(x, y) => {
                                        root.more-clicked(root.sender-id, root.timestamp-ns, x, y);
                                    }
                                }

                                // Video attachments
                                if attachment.category == "video": Rectangle {
                                    property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.6;
                                    property <length> max-w: min(280px, root.width * 0.7 - Spacing.md);
                                    property <length> max-h: 220px;
                                    property <length> calc-w: aspect-ratio >= 1 ? min(max-w, attachment.width * 1px) : min(max-h * aspect-ratio, attachment.width * 1px);
                                    property <length> calc-h: aspect-ratio >= 1 ? min(max-h, calc-w / aspect-ratio) : min(max-h, attachment.height * 1px);

                                    width: attachment.has-thumbnail && attachment.width > 0 ? max(160px, min(max-w, calc-w)) : 260px;
                                    height: attachment.has-thumbnail && attachment.height > 0 ? max(100px, min(max-h, calc-h)) : 160px;
                                    background: attachment.has-thumbnail ? Colors.surface-hover : Colors.surface;
                                    border-radius: Spacing.radius-sm;
                                    clip: true;

                                    if attachment.has-thumbnail: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: attachment.thumbnail;
                                        image-fit: contain;
                                    }

                                    // No thumbnail: the play button IS the icon, stacked
                                    // above the filename rather than floated over it.
                                    // Previously this branch centred icon+name+size in
                                    // the tile and the overlay below centred a 56px
                                    // opaque circle on the same point, so the one thing
                                    // identifying the file — its name — was underneath
                                    // the button. A video with no thumbnail is exactly
                                    // the case where the name is all the user has.
                                    if !attachment.has-thumbnail: VerticalLayout {
                                        alignment: center;
                                        spacing: Spacing.xs;

                                        // Wrapped: a Rectangle has no alignment of its
                                        // own, so the row centres it.
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 56px;
                                                height: 56px;
                                                border-radius: 28px;
                                                background: video-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                                                Image {
                                                    width: 24px;
                                                    height: 24px;
                                                    source: Icons.play;
                                                    colorize: Colors.text-primary;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                        Text {
                                            text: attachment.filename;
                                            color: Colors.text-secondary;
                                            font-size: Typography.xs;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: attachment.size-display;
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Play button overlay — only over a thumbnail, where
                                    // there is a picture to float it on. Without one it
                                    // is drawn inline above, by the branch just above.
                                    if attachment.has-thumbnail: Rectangle {
                                        x: (parent.width - 56px) / 2;
                                        y: (parent.height - 56px) / 2;
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 28px;
                                        background: video-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                                        Image {
                                            width: 24px;
                                            height: 24px;
                                            source: Icons.play;
                                            colorize: Colors.text-primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    video-touch := HoldArea {
                                        enabled-for-touch: root.mobile;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (self.hold-fired) { return; }
                                            root.attachment-clicked(attachment.id);
                                        }
                                        held => {
                                            root.more-clicked(root.sender-id, root.timestamp-ns,
                                                self.anchor-x, self.anchor-y);
                                        }
                                    }
                                }

                                // File attachments
                                if !attachment.is-image && attachment.category != "audio" && attachment.category != "video": Rectangle {
                                    width: min(240px, root.width * 0.7 - Spacing.md);
                                    height: 52px;
                                    background: Colors.surface;
                                    border-radius: Spacing.radius-md;

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: Spacing.radius-sm;
                                            background: Colors.primary.transparentize(0.85);

                                            Image {
                                                width: 18px;
                                                height: 18px;
                                                source: Icons.file;
                                                colorize: Colors.primary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: attachment.filename;
                                                color: Colors.text-primary;
                                                font-size: Typography.xs;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: attachment.size-display;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }

                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            background: file-touch.has-hover ? Colors.surface-hover : transparent;
                                            border-radius: Spacing.radius-sm;

                                            Image {
                                                width: 14px;
                                                height: 14px;
                                                source: Icons.download;
                                                colorize: Colors.primary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }

                                    // Progress bar
                                    if attachment.is-uploading || attachment.is-downloading: Rectangle {
                                        y: parent.height - 3px;
                                        width: parent.width;
                                        height: 3px;
                                        background: Colors.surface-hover;
                                        border-radius: 1.5px;
                                        accessible-role: progress-indicator;
                                        accessible-label: attachment.is-uploading ? "Upload progress" : "Download progress";
                                        accessible-value: Math.round(attachment.progress * 100) + " percent";

                                        Rectangle {
                                            width: parent.width * attachment.progress;
                                            height: 100%;
                                            background: Colors.primary;
                                            border-radius: 1.5px;
                                        }
                                    }

                                    file-touch := HoldArea {
                                        enabled-for-touch: root.mobile;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (self.hold-fired) { return; }
                                            root.attachment-clicked(attachment.id);
                                        }
                                        held => {
                                            root.more-clicked(root.sender-id, root.timestamp-ns,
                                                self.anchor-x, self.anchor-y);
                                        }
                                    }
                                }
                            }
                        }

                        // Timestamp row — bottom-right for all messages (messenger convention)
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: end;

                            if root.is-pinned: Image {
                                source: Icons.pin;
                                width: 12px;
                                height: 12px;
                                colorize: Colors.primary;
                            }

                            // "edited" before the time on both sides (Signal's order).
                            if root.is-edited: Text {
                                text: "edited";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                font-italic: true;
                            }

                            Text {
                                text: root.timestamp;
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                            }

                            // Delivery status. Mesh states get a word rather
                            // than a tick: over couriers "sent" and
                            // "delivered" are hours apart, and two ticks
                            // would claim an arrival nobody has confirmed.
                            if root.is-own && root.mesh-delivery: Text {
                                // "sent" is deliberately not reused for a
                                // broadcast: a room or cell message has no
                                // recipient to acknowledge it, so there is
                                // never anything to upgrade it to.
                                text: root.delivery-status == "carried" ? "carried"
                                    : root.delivery-status == "waiting" ? "waiting"
                                    : root.delivery-status == "undelivered" ? "not delivered"
                                    : root.delivery-status == "delivered" ? "delivered"
                                    : root.delivery-status == "read" ? "read"
                                    : root.delivery-status == "broadcast" ? "broadcast"
                                    : "sent";
                                color: root.delivery-status == "undelivered" ? Colors.text-secondary : Colors.text-muted;
                                font-size: Typography.xs;
                                font-italic: true;
                                accessible-role: text;
                                accessible-label: root.delivery-status == "carried"
                                        ? "Handed to a passing device; may arrive later"
                                    : root.delivery-status == "waiting"
                                        ? "Held on this device until something can carry it"
                                    : root.delivery-status == "undelivered"
                                        ? "Left the outbox without ever being acknowledged"
                                    : root.delivery-status == "delivered"
                                        ? "The peer's device acknowledged it"
                                    : root.delivery-status == "read"
                                        ? "Read by the peer"
                                    : root.delivery-status == "broadcast"
                                        ? "Went out to whoever is in range; nobody acknowledges a broadcast"
                                    : "Handed to a live link; not yet acknowledged";
                            }

                            // Delivery status checkmarks. SVG, not "✓": the
                            // glyph has no coverage in the Android system
                            // font and rendered as a tofu box on every
                            // message. Fixed 12px so the row — and the
                            // bubble — keeps the height the text tick had.
                            // Queued behind a Shield mailbox bootstrap, or
                            // that queue's flush failed: a word, not a tick —
                            // neither has reached the server, and "failed"
                            // must never read as delivered.
                            if root.is-own && !root.mesh-delivery && root.delivery-status == "sending": Text {
                                text: "sending";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                font-italic: true;
                                accessible-role: text;
                                accessible-label: "Sending";
                            }

                            // "not sent" is the retry control (Signal's "tap
                            // to retry"): `message-clicked` resends it.
                            if root.is-own && !root.mesh-delivery && root.delivery-status == "failed" && root.failure-reason == "": Text {
                                text: "not sent \u{b7} retry";
                                color: Colors.error;
                                font-size: Typography.xs;
                                font-italic: true;
                                accessible-role: button;
                                accessible-label: "Not sent, tap to retry";
                                accessible-action-default => { root.message-clicked(root.message-id); }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.message-clicked(root.message-id); }
                                }
                            }

                            if root.is-own && !root.mesh-delivery && root.delivery-status == "failed" && root.failure-reason != "": Text {
                                text: "not sent · " + root.failure-reason;
                                color: Colors.error;
                                font-size: Typography.xs;
                                accessible-role: text;
                            }

                            if root.is-own && !root.mesh-delivery && root.delivery-status != "sending" && root.delivery-status != "failed": ticks := Rectangle {
                                property <bool> double-tick: root.delivery-status != "sent";
                                property <color> tick-color: root.delivery-status == "read" ? Colors.primary : Colors.text-muted;
                                width: self.double-tick ? 17px : 12px;
                                height: 12px;
                                accessible-role: text;
                                accessible-label: root.delivery-status == "sent" ? "Sent"
                                    : root.delivery-status == "delivered" ? "Delivered"
                                    : root.delivery-status == "read" ? "Read" : "";

                                // Second tick behind, offset left, so the
                                // pair reads as the usual overlapping ✓✓.
                                if ticks.double-tick: Image {
                                    source: Icons.check;
                                    width: 12px;
                                    height: 12px;
                                    x: 0px;
                                    y: 0px;
                                    colorize: ticks.tick-color;
                                }

                                Image {
                                    source: Icons.check;
                                    width: 12px;
                                    height: 12px;
                                    x: parent.width - self.width;
                                    y: 0px;
                                    colorize: ticks.tick-color;
                                }
                            }
                        }

                    }

                    // Tap-to-jump flash — brief green highlight when this bubble
                    // is the scroll target of a quote click. Plain Rectangle
                    // (no TouchArea) so it never blocks input. Absent on idle rows.
                    if root.highlight-progress > 0: Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: bubble.border-radius;
                        background: Colors.primary.with-alpha(root.highlight-progress * 0.22);
                        border-width: root.highlight-progress * Spacing.stroke;
                        border-color: Colors.primary;
                    }
                }

                // Reactions pill - straddling bubble's bottom corner
                // Half inside / half outside on both X and Y
                if root.has-reactions: reactions-pill := Rectangle {
                    height: 22px;
                    width: reactions-row.preferred-width + 8px;
                    background: Colors.surface;
                    border-radius: 11px;

                    x: root.is-own ? -self.width + 8px : bubble.width - 8px;
                    y: bubble.height - 4px;
                    accessible-role: button;
                    accessible-label: "Reactions: " + root.reaction-summary;

                    reactions-row := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: center;

                        for reaction in root.reactions: Rectangle {
                            width: entry.preferred-width;

                            entry := HorizontalLayout {
                                spacing: 2px;
                                alignment: center;

                                Text {
                                    text: reaction.emoji;
                                    font-family: Typography.font-family-emoji;
                                    font-size: Typography.xs;
                                    vertical-alignment: center;
                                }

                                if reaction.count > 1: Text {
                                    text: reaction.count;
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    vertical-alignment: center;
                                }
                            }

                            // Per-emoji, replacing a pill-wide TouchArea that
                            // only opened the picker. The picker is still on
                            // long-press → More reactions and on the hover
                            // "Add reaction" button.
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.reaction-toggled(root.sender-id, root.timestamp-ns,
                                        reaction.emoji);
                                }
                            }
                        }
                    }
                }
                // Action buttons — float above top corner of bubble on opposed side.
                // Do not allocate hidden controls for every row (or any mobile row).
                if root.is-hovered: Rectangle {
                    x: root.is-own ? -action-btns.width + 8px : bubble.width - 8px;
                    y: -14px; // Float halfway above the top edge
                    width: action-btns.width;
                    height: action-btns.height;
                    visible: root.is-hovered && !root.is-system && !root.is-deleted && !root.is-call;

                    action-btns := Rectangle {
                        height: 28px;
                        width: 106px;
                        background: Colors.surface;
                        border-radius: Spacing.radius-md;

                        HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            alignment: center;

                            // Reply button
                            Rectangle {
                                height: 24px;
                                width: 24px;
                                background: reply-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-sm;
                                accessible-role: button;
                                accessible-label: "Reply to message";

                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: Icons.reply;
                                    colorize: Colors.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                reply-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.reply-clicked(root.sender-id, root.timestamp-ns);
                                    }
                                }
                            }

                            // React button
                            react-btn := Rectangle {
                                height: 24px;
                                width: 24px;
                                background: react-btn-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-sm;
                                accessible-role: button;
                                accessible-label: "Add reaction";

                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: Icons.smile;
                                    colorize: Colors.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                react-btn-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.react-clicked(root.sender-id, root.timestamp-ns,
                                            react-btn.absolute-position.x,
                                            react-btn.absolute-position.y + react-btn.height);
                                    }
                                }
                            }

                            // Reply-in-thread button — opens/starts a thread on
                            // this message. Previously the ONLY thread entry was
                            // the "N replies" badge (rendered `if reply-count > 0`),
                            // so a message with no replies could never START a thread.
                            if root.can-thread: thread-btn := Rectangle {
                                height: 24px;
                                width: 24px;
                                background: thread-btn-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-sm;
                                accessible-role: button;
                                accessible-label: "Reply in thread";

                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: Icons.message-circle;
                                    colorize: Colors.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                thread-btn-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.thread-clicked(root.message-id);
                                    }
                                }
                            }

                            // More button
                            more-btn := Rectangle {
                                height: 24px;
                                width: 24px;
                                background: more-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-sm;
                                accessible-role: button;
                                accessible-label: "More message actions";

                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: Icons.more-horizontal;
                                    colorize: Colors.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                more-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.more-clicked(root.sender-id, root.timestamp-ns,
                                            more-btn.absolute-position.x,
                                            more-btn.absolute-position.y + more-btn.height);
                                    }
                                }
                            }
                        }
                    }
                }
                } // end wrapper

                // Thread replies indicator (below bubble)
                if root.reply-count > 0: HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: root.is-own ? end : start;
                    padding-left: Spacing.xs;
                    padding-right: Spacing.xs;

                    // Pill button (not bare text) so the thread entry point
                    // reads as clickable.
                    Rectangle {
                        height: 22px;
                        width: thread-layout.preferred-width + Spacing.sm * 2;
                        border-radius: 11px;
                        background: thread-touch.has-hover
                            ? Colors.primary.transparentize(0.75)
                            : Colors.primary.transparentize(0.9);
                        accessible-role: button;
                        accessible-label: "Open thread: " + root.reply-count-text;

                        thread-layout := HorizontalLayout {
                            spacing: Spacing.xs;
                            padding: 2px;
                            padding-left: Spacing.sm;
                            alignment: center;

                            Image {
                                width: 12px;
                                height: 12px;
                                source: Icons.message-circle;
                                colorize: Colors.primary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.reply-count-text;
                                color: Colors.primary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }
                        }

                        thread-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.thread-clicked(root.message-id); }
                        }
                    }
                }
            }
        }
    } // end main-layout
    } // end touch wrapper
}
