import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { AudioPlayer } from "audio_player.slint";
import { HoldArea } from "../components/hold_area.slint";
import { MessageAttachmentData } from "types.slint";

export component MessageAttachments inherits VerticalLayout {
    in property <[MessageAttachmentData]> attachments;
    in property <string> audio-elapsed;
    in property <float> audio-progress;
    in property <length> bubble-height;
    in property <length> bubble-width;
    in property <length> bubble-x;
    in property <length> bubble-y;
    in property <string> current-playing-attachment-id;
    in property <bool> is-media-playing;
    in property <length> message-width;
    in property <bool> mobile;
    in property <bool> swipe-active;
    in property <length> text-max-width;
    callback begin-swipe(length, length);
    callback move-swipe(length, length);
    callback end-swipe(bool);
    callback open-image(string, length, length, length, length);
    callback open-other-attachment(string);
    callback request-menu(length, length, length, length, length, length);
    callback audio-seek(string, float);

    spacing: Spacing.sm;

    for attachment in root.attachments: HorizontalLayout {
        // Let the media set the bubble's preferred width. The
        // row may grow with a wider caption, where image and
        // video attachments stay centered.
        max-width: root.text-max-width;
        alignment: attachment.is-image || attachment.category == "video" ? center : start;

        // Image attachments
        if attachment.is-image: Rectangle {
            property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.5;
            property <length> max-w: min(280px, root.message-width * 0.7 - Spacing.md);
            property <length> max-h: 380px;
            property <length> calc-w: min(max-w, max-h * aspect-ratio);
            property <length> calc-h: min(max-h, calc-w / aspect-ratio);

            // Reserve the final geometry from stored dimensions before
            // the thumbnail is decoded, so rows above the viewport do
            // not grow and pull the opening anchor away from the end.
            width: attachment.width > 0 && attachment.height > 0 ? max(100px, calc-w) : 180px;
            height: attachment.width > 0 && attachment.height > 0 ? max(60px, calc-h) : 140px;
            background: Colors.bubble-inset;
            border-radius: Spacing.radius-sm;
            clip: true;

            if attachment.has-thumbnail: Image {
                width: 100%;
                height: 100%;
                source: attachment.thumbnail;
                image-fit: contain;
            }

            if !attachment.has-thumbnail: Rectangle {
                width: 100%;
                height: 100%;
                background: Colors.surface-hover;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xs;

                    Image {
                        width: 32px;
                        height: 32px;
                        source: Icons.image;
                        colorize: Colors.text-muted;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: attachment.filename;
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // Progress overlay
            if attachment.is-uploading || attachment.is-downloading: Rectangle {
                width: 100%;
                height: 100%;
                background: Colors.overlay;
                accessible-role: progress-indicator;
                accessible-label: attachment.is-uploading ? "Uploading " + attachment.filename : "Downloading " + attachment.filename;
                accessible-value: Math.round(attachment.progress * 100) + " percent";

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.sm;

                    Text {
                        text: attachment.is-uploading ? "Uploading..." : "Downloading...";
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 80%;
                        height: 4px;
                        background: Colors.surface-hover;
                        border-radius: 2px;

                        Rectangle {
                            width: parent.width * attachment.progress;
                            height: 100%;
                            background: Colors.primary;
                            border-radius: 2px;
                        }
                    }
                }
            }

            if attachment.is-download-failed: Rectangle {
                width: 100%;
                height: 100%;
                background: Colors.overlay;

                Text {
                    width: parent.width - Spacing.md;
                    height: parent.height;
                    text: "Download failed · Tap to retry";
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            img-touch := HoldArea {
                enabled-for-touch: root.mobile;
                mouse-cursor: pointer;
                gesture-down(x, y) => { root.begin-swipe(x, y); }
                gesture-moved(x, y) => { root.move-swipe(x, y); }
                gesture-ended(cancelled) => { root.end-swipe(cancelled); }
                clicked => {
                    if (self.hold-fired || root.swipe-active) { return; }
                    root.open-image(attachment.id,
                        self.absolute-position.x, self.absolute-position.y,
                        self.width, self.height);
                }
                held => {
                    root.request-menu(self.anchor-x, self.anchor-y,
                        root.bubble-y, root.bubble-y + root.bubble-height,
                        root.bubble-x, root.bubble-x + root.bubble-width);
                }
            }
        }

        // Audio attachments — shared inline player
        if attachment.category == "audio": AudioPlayer {
            mobile: root.mobile;
            attachment-id: attachment.id;
            filename: attachment.filename;
            waveform: attachment.waveform;
            duration-display: attachment.duration-display;
            is-download-failed: attachment.is-download-failed;
            current-playing-attachment-id: root.current-playing-attachment-id;
            is-media-playing: root.is-media-playing;
            audio-progress: root.audio-progress;
            audio-elapsed: root.audio-elapsed;

            play-clicked(id) => { root.open-other-attachment(id); }
            audio-seek(id, pos) => { root.audio-seek(id, pos); }
            more-clicked(x, y) => {
                root.request-menu(x, y,
                    root.bubble-y, root.bubble-y + root.bubble-height,
                    root.bubble-x, root.bubble-x + root.bubble-width);
            }
        }

        // Video attachments
        if attachment.category == "video": Rectangle {
            property <float> aspect-ratio: attachment.width > 0 ? attachment.width / max(1, attachment.height) : 1.6;
            property <length> max-w: min(280px, root.message-width * 0.7 - Spacing.md);
            property <length> max-h: 220px;
            property <length> calc-w: min(max-w, max-h * aspect-ratio);
            property <length> calc-h: min(max-h, calc-w / aspect-ratio);

            width: attachment.width > 0 && attachment.height > 0 ? max(160px, calc-w) : 260px;
            height: attachment.width > 0 && attachment.height > 0 ? max(100px, calc-h) : 160px;
            background: Colors.bubble-inset;
            border-radius: Spacing.radius-sm;
            clip: true;

            if attachment.has-thumbnail: Image {
                width: 100%;
                height: 100%;
                source: attachment.thumbnail;
                image-fit: contain;
            }

            // No thumbnail: the play button IS the icon, stacked
            // above the filename rather than floated over it.
            // Previously this branch centred icon+name+size in
            // the tile and the overlay below centred a 56px
            // opaque circle on the same point, so the one thing
            // identifying the file — its name — was underneath
            // the button. A video with no thumbnail is exactly
            // the case where the name is all the user has.
            if !attachment.has-thumbnail: VerticalLayout {
                alignment: center;
                spacing: Spacing.xs;

                // Wrapped: a Rectangle has no alignment of its
                // own, so the row centres it.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: video-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                        Image {
                            width: 24px;
                            height: 24px;
                            source: Icons.play;
                            colorize: Colors.text-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                Text {
                    text: attachment.filename;
                    color: Colors.text-secondary;
                    font-size: Typography.xs;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: attachment.size-display;
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    horizontal-alignment: center;
                }
            }

            // Play button overlay — only over a thumbnail, where
            // there is a picture to float it on. Without one it
            // is drawn inline above, by the branch just above.
            if attachment.has-thumbnail: Rectangle {
                x: (parent.width - 56px) / 2;
                y: (parent.height - 56px) / 2;
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: video-touch.has-hover ? Colors.primary : Colors.primary.transparentize(0.2);

                Image {
                    width: 24px;
                    height: 24px;
                    source: Icons.play;
                    colorize: Colors.text-primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            if attachment.is-download-failed: Rectangle {
                width: 100%;
                height: 100%;
                background: Colors.overlay;

                Text {
                    width: parent.width - Spacing.md;
                    height: parent.height;
                    text: "Download failed · Tap to retry";
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            video-touch := HoldArea {
                enabled-for-touch: root.mobile;
                mouse-cursor: pointer;
                gesture-down(x, y) => { root.begin-swipe(x, y); }
                gesture-moved(x, y) => { root.move-swipe(x, y); }
                gesture-ended(cancelled) => { root.end-swipe(cancelled); }
                clicked => {
                    if (self.hold-fired || root.swipe-active) { return; }
                    root.open-other-attachment(attachment.id);
                }
                held => {
                    root.request-menu(self.anchor-x, self.anchor-y,
                        root.bubble-y, root.bubble-y + root.bubble-height,
                        root.bubble-x, root.bubble-x + root.bubble-width);
                }
            }
        }

        // File attachments
        if !attachment.is-image && attachment.category != "audio" && attachment.category != "video": Rectangle {
            width: min(240px, root.message-width * 0.7 - Spacing.md);
            height: 52px;
            background: Colors.bubble-inset;
            border-radius: Spacing.radius-md;

            HorizontalLayout {
                padding: Spacing.sm;
                spacing: Spacing.sm;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: Spacing.radius-sm;
                    background: Colors.primary.transparentize(0.85);

                    Image {
                        width: 18px;
                        height: 18px;
                        source: Icons.file;
                        colorize: Colors.primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Spacing.xxs;

                    Text {
                        text: attachment.filename;
                        color: Colors.text-primary;
                        font-size: Typography.xs;
                        overflow: elide;
                    }
                    Text {
                        text: attachment.is-download-failed ? "Download failed · Tap to retry" : attachment.size-display;
                        color: attachment.is-download-failed ? Colors.primary : Colors.text-muted;
                        font-size: Typography.xs;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: file-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;

                    Image {
                        width: 14px;
                        height: 14px;
                        source: Icons.download;
                        colorize: Colors.primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Progress bar
            if attachment.is-uploading || attachment.is-downloading: Rectangle {
                y: parent.height - 3px;
                width: parent.width;
                height: 3px;
                background: Colors.surface-hover;
                border-radius: 1.5px;
                accessible-role: progress-indicator;
                accessible-label: attachment.is-uploading ? "Upload progress" : "Download progress";
                accessible-value: Math.round(attachment.progress * 100) + " percent";

                Rectangle {
                    width: parent.width * attachment.progress;
                    height: 100%;
                    background: Colors.primary;
                    border-radius: 1.5px;
                }
            }

            file-touch := HoldArea {
                enabled-for-touch: root.mobile;
                mouse-cursor: pointer;
                gesture-down(x, y) => { root.begin-swipe(x, y); }
                gesture-moved(x, y) => { root.move-swipe(x, y); }
                gesture-ended(cancelled) => { root.end-swipe(cancelled); }
                clicked => {
                    if (self.hold-fired || root.swipe-active) { return; }
                    root.open-other-attachment(attachment.id);
                }
                held => {
                    root.request-menu(self.anchor-x, self.anchor-y,
                        root.bubble-y, root.bubble-y + root.bubble-height,
                        root.bubble-x, root.bubble-x + root.bubble-width);
                }
            }
        }
    }
}
