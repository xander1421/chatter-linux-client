import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { DisappearingGlobal } from "disappearing_global.slint";

export component DisappearingSettings inherits VerticalLayout {
    in property <string> peer-id;
    in property <int> current-ttl;
    property <int> selected-ttl: root.current-ttl;
    changed current-ttl => { root.selected-ttl = root.current-ttl; }
    changed peer-id => { root.selected-ttl = root.current-ttl; }
    property <string> minutes: "5";
    spacing: Spacing.sm;
    Text { text: "Message lifetime"; color: Colors.text-primary; font-size: Typography.sm; }
    Text { text: "Each new message disappears after the selected time once its expiry clock starts."; color: Colors.text-muted; font-size: Typography.xs; wrap: word-wrap; }
    for opt in DisappearingGlobal.options: Button {
        text: opt.label;
        variant: root.selected-ttl == opt.seconds ? "primary" : "secondary";
        clicked => { root.selected-ttl = opt.seconds; }
    }
    Text { text: "How long to enable"; color: Colors.text-primary; font-size: Typography.sm; }
    Text { text: "Current: " + DisappearingGlobal.dm-activation-label + ". The window applies to new messages only."; color: Colors.text-muted; font-size: Typography.xs; wrap: word-wrap; }
    Button { text: "5 minutes"; variant: root.minutes == "5" ? "primary" : "secondary"; clicked => { root.minutes = "5"; } }
    Input { placeholder: "Custom duration in minutes"; text <=> root.minutes; }
    Button {
        text: root.selected-ttl == 0 ? "Turn off" : "Enable disappearing messages";
        variant: "primary";
        clicked => { DisappearingGlobal.set-dm-window(root.peer-id, root.selected-ttl, root.minutes); }
    }
}
