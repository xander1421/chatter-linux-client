import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { DisappearingGlobal } from "disappearing_global.slint";

export component SecretTimerModal inherits Rectangle {
    in property <bool> show-modal: false;
    callback close();
    callback choose(int);
    Modal {
        show: root.show-modal;
        title: "Disappearing messages";
        modal-width: 420px;
        close => { root.close(); }
        VerticalLayout {
            spacing: Spacing.sm;
            Text {
                text: "New messages disappear after this time. Received messages count down after you read them; your sent messages count down after sending.";
                color: Colors.text-secondary;
                font-size: Typography.sm;
                wrap: word-wrap;
            }
            Text {
                text: "Current: " + DisappearingGlobal.active-label;
                color: Colors.text-primary;
                font-size: Typography.sm;
            }
            for option in DisappearingGlobal.options: Button {
                text: option.label;
                variant: option.label == DisappearingGlobal.active-label ? "primary" : "secondary";
                clicked => { root.choose(option.seconds); }
            }
            Button {
                text: "1 minute";
                variant: DisappearingGlobal.active-label == "1 minute" ? "primary" : "secondary";
                clicked => { root.choose(60); }
            }
        }
    }
}
