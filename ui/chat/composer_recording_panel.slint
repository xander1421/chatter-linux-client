import { IconAction } from "../components/icon_action.slint";
import { VoiceRecording, LiveVoiceWaveform } from "voice_recording.slint";
import { HeaderButton } from "../components/header_button.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export component ComposerRecordingPanel inherits Rectangle {
    in property <bool> recording-here: false;
    in property <float> recording-reveal;
    in property <length> row-padding;
    in property <bool> surface-backdrop-paused;
    visible: root.recording-here;
    opacity: min(1, max(0, root.recording-reveal));
    background: transparent;
    TouchArea { }
    HorizontalLayout {
        padding: root.row-padding;
        spacing: Spacing.xs;
        HeaderButton {
            backdrop-paused: root.surface-backdrop-paused;
            icon: Icons.trash;
            label: @tr("Cancel voice message");
            touch: true;
            plain: true;
            destructive: true;
            clicked => { VoiceRecording.cancel(); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Spacing.none;
            Text {
                text: VoiceRecording.elapsed;
                color: Colors.text-primary;
                font-size: Typography.sm;
                horizontal-alignment: center;
            }
            LiveVoiceWaveform {
                height: 30px;
            }
        }
        VerticalLayout {
            alignment: center;
            IconAction {
                active: true;
                icon: Icons.send;
                label: @tr("Send voice message");
                enabled: !VoiceRecording.busy;
                clicked => { VoiceRecording.finish(); }
            }
        }
    }
}
