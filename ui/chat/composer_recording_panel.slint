import { GlassSurface } from "../components/glass_surface.slint";
import { Materials } from "../theme/materials.slint";
import { VoiceRecording, LiveVoiceWaveform } from "voice_recording.slint";
import { HeaderButton } from "../components/header_button.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export component ComposerRecordingPanel inherits Rectangle {
in property <bool> recording-here: false;
in property <float> recording-reveal;
in property <length> row-padding;
in property <int> surface-material-level;
in property <int> surface-elevation;
in property <bool> surface-backdrop-paused;
    visible: root.recording-here;
    opacity: min(1, max(0, root.recording-reveal));
    background: transparent;
    TouchArea { }
    recording-layout := VerticalLayout {
        height: parent.height;
        padding: root.row-padding;
        GlassSurface {
            horizontal-stretch: 1;
            height: Spacing.touch-target-min;
            border-radius: Spacing.radius-chrome;
            material-level: root.surface-material-level;
            material-tint: Materials.chat-chrome;
            elevation: root.surface-elevation;
            backdrop-paused: root.surface-backdrop-paused;
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: Spacing.xs;
                HeaderButton {
                    backdrop-paused: root.surface-backdrop-paused;
                    icon: Icons.trash;
                    label: "Cancel voice message";
                    touch: true;
                    plain: true;
                    destructive: true;
                    clicked => { VoiceRecording.cancel(); }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: VoiceRecording.elapsed;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                    }
                    LiveVoiceWaveform {
                        height: 30px;
                    }
                }
                HeaderButton {
                    backdrop-paused: root.surface-backdrop-paused;
                    icon: Icons.send;
                    label: "Send voice message";
                    touch: true;
                    plain: true;
                    enabled: !VoiceRecording.busy;
                    clicked => { VoiceRecording.finish(); }
                }
            }
        }
    }
}
