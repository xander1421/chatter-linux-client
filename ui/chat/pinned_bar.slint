// Pinned messages bar component
//
// Telegram-style always-visible bar for navigating pinned messages.
// Shows between header and message list when there are pinned messages.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component PinnedBar inherits Rectangle {
    // Properties
    in property <string> message-preview: "";
    in property <int> current-index: 1;  // 1-based for display
    in property <int> total-count: 1;
    in property <bool> has-multiple: false;

    // Callbacks
    callback prev-clicked();
    callback next-clicked();
    callback go-to-message();
    callback dismiss-clicked();

    // Computed
    property <string> position-text: has-multiple ? "Pinned message \{current-index} of \{total-count}" : "Pinned message";

    // Layout
    height: 40px;
    background: Colors.surface;

    // Main content
    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: start;

        // Navigation buttons on LEFT (only if multiple pinned)
        if root.has-multiple: HorizontalLayout {
            spacing: 2px;
            alignment: center;

            // Up/prev button
            Rectangle {
                width: 28px;
                height: 28px;
                background: prev-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;

                Text {
                    text: "\u{25B2}";  // Up triangle
                    font-size: 10px;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                prev-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.prev-clicked();
                    }
                }
            }

            // Down/next button
            Rectangle {
                width: 28px;
                height: 28px;
                background: next-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;

                Text {
                    text: "\u{25BC}";  // Down triangle
                    font-size: 10px;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                next-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.next-clicked();
                    }
                }
            }
        }

        // Left accent bar (Telegram-style)
        Rectangle {
            width: 3px;
            height: 24px;
            background: Colors.primary;
            border-radius: 1.5px;
        }

        // Clickable content area (go to message)
        Rectangle {
            horizontal-stretch: 1;

            bar-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.go-to-message();
                }
            }

            // Content area
            VerticalLayout {
                alignment: center;
                spacing: 1px;

                // Position text (small, muted)
                Text {
                    text: position-text;
                    color: Colors.primary;
                    font-size: Typography.xs;
                    font-weight: Typography.medium;
                }

                // Message preview
                Text {
                    text: root.message-preview;
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    overflow: TextOverflow.elide;
                    wrap: TextWrap.no-wrap;
                }
            }
        }

        // Close/dismiss button on RIGHT
        Rectangle {
            width: 28px;
            height: 28px;
            background: dismiss-touch.has-hover ? Colors.surface-hover : transparent;
            border-radius: Spacing.radius-sm;

            Text {
                text: "\u{2715}";  // X mark
                font-size: 12px;
                color: Colors.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            dismiss-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.dismiss-clicked();
                }
            }
        }
    }

    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Colors.surface-hover;
    }
}
