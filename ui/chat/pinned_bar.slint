// Pinned messages bar component
//
// Telegram-style always-visible bar for navigating pinned messages.
// Shows between header and message list when there are pinned messages.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export component PinnedBar inherits Rectangle {
    // Properties
    in property <string> message-preview: "";
    in property <int> current-index: 1;  // 1-based for display
    in property <int> total-count: 1;
    in property <bool> has-multiple: false;

    // Callbacks
    callback prev-clicked();
    callback next-clicked();
    callback go-to-message();
    callback dismiss-clicked();

    // Computed
    property <string> position-text: has-multiple ? "Pinned message \{current-index} of \{total-count}" : "Pinned message";

    // Layout — Neo floating bar: raised surface with shadow
    height: Spacing.touch-target-min * Appearance.text-grow;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-x: Spacing.neo-offset-sm;
    drop-shadow-offset-y: Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    // Main content
    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: 0px;
        spacing: Spacing.sm;
        // No `alignment`: under `start` Slint ignores horizontal-stretch, so
        // the preview never grew and the close button floated mid-row.

        // Navigation buttons on LEFT (only if multiple pinned)
        if root.has-multiple: HorizontalLayout {
            spacing: 2px;
            alignment: center;

            // Up/prev button
            Rectangle {
                width: 36px;
                height: 36px;
                background: prev-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;

                Text {
                    text: "\u{25B2}";  // Up triangle
                    font-size: Typography.xxs;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                prev-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.prev-clicked();
                    }
                }
            }

            // Down/next button
            Rectangle {
                width: 36px;
                height: 36px;
                background: next-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;

                Text {
                    text: "\u{25BC}";  // Down triangle
                    font-size: Typography.xxs;
                    color: Colors.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                next-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.next-clicked();
                    }
                }
            }
        }

        // Left accent bar — glow-tinted for neo depth
        Rectangle {
            width: 3px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            background: Colors.primary;
            border-radius: 1.5px;
            drop-shadow-blur: 4px;
            drop-shadow-color: Colors.glow-primary;
        }

        // Clickable content area (go to message)
        Rectangle {
            horizontal-stretch: 1;

            bar-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.go-to-message();
                }
            }

            // Content area
            VerticalLayout {
                alignment: center;
                spacing: 1px;

                // Position text (small, muted)
                Text {
                    text: position-text;
                    color: Colors.primary;
                    font-size: Typography.xs;
                    font-weight: Typography.medium;
                }

                // Message preview
                Text {
                    text: root.message-preview;
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    overflow: TextOverflow.elide;
                    wrap: TextWrap.no-wrap;
                }
            }
        }

        // Close/dismiss button on RIGHT — a full 48dp box flush with the edge
        Rectangle {
            width: Spacing.touch-target-min;
            height: Spacing.touch-target-min;
            background: dismiss-touch.has-hover ? Colors.surface-hover : transparent;
            border-radius: Spacing.radius-sm;
            accessible-role: button;
            accessible-label: "Hide pinned messages";

            Image {
                source: Icons.x;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-muted;
            }

            dismiss-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.dismiss-clicked();
                }
            }
        }
    }

    // Bottom edge — neo highlight
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Colors.neo-highlight;
    }
}
