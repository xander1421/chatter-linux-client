import { GlassSurface } from "../components/glass_surface.slint";
import { Materials } from "../theme/materials.slint";
// Pinned messages bar component
//
// Telegram-style always-visible bar for navigating pinned messages.
// Shows between header and message list when there are pinned messages.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export component PinnedBar inherits GlassSurface {
    // Properties
    in property <string> message-preview: "";
    in property <image> thumbnail;
    in property <int> current-index: 1;  // 1-based for display
    in property <int> total-count: 1;
    in property <bool> has-multiple: false;

    // Callbacks
    callback prev-clicked();
    callback next-clicked();
    callback go-to-message();
    callback dismiss-clicked();

    // Computed
    property <string> position-text: has-multiple ? "Pinned message \{current-index} of \{total-count}" : "Pinned message";

    // One material for the pinned-message chrome.
    height: Spacing.touch-target-min * Appearance.text-grow;
    elevation: 0;
    border-radius: Spacing.radius-chrome;

    // Main content
    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.none;
        spacing: Spacing.sm;
        // No `alignment`: under `start` Slint ignores horizontal-stretch, so
        // the preview never grew and the close button floated mid-row.

        // Navigation buttons on LEFT (only if multiple pinned)
        if root.has-multiple: HorizontalLayout {
            spacing: Spacing.xxs;
            alignment: center;

            // Up/prev button
            Rectangle {
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                background: prev-touch.pressed ? Materials.pressed : prev-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;
                transform-scale-x: prev-touch.pressed ? 90% : 100%;
                transform-scale-y: prev-touch.pressed ? 90% : 100%;
                animate transform-scale-x { duration: prev-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                animate transform-scale-y { duration: prev-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }

                Image {
                    source: Icons.chevron-right;
                    width: Spacing.button-icon;
                    height: Spacing.button-icon;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    transform-rotation: 270deg;
                    colorize: Colors.text-secondary;
                }

                prev-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.prev-clicked();
                    }
                }
            }

            // Down/next button
            Rectangle {
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                background: next-touch.pressed ? Materials.pressed : next-touch.has-hover ? Colors.surface-hover : transparent;
                border-radius: Spacing.radius-sm;
                transform-scale-x: next-touch.pressed ? 90% : 100%;
                transform-scale-y: next-touch.pressed ? 90% : 100%;
                animate transform-scale-x { duration: next-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                animate transform-scale-y { duration: next-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }

                Image {
                    source: Icons.chevron-right;
                    width: Spacing.button-icon;
                    height: Spacing.button-icon;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    transform-rotation: 90deg;
                    colorize: Colors.text-secondary;
                }

                next-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.next-clicked();
                    }
                }
            }
        }

        // Left accent bar — glow-tinted for neo depth
        Rectangle {
            width: 3px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            background: Colors.primary;
            border-radius: 1.5px;
        }

        if root.thumbnail.width > 0: Rectangle {
            // Layouts own child positions: center the thumbnail inside a full-height cell.
            vertical-stretch: 1;
            width: 36px;
            Rectangle {
                width: 36px; height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: Spacing.radius-sm; clip: true;
                Image { accessible-label: "Pinned message image"; source: root.thumbnail; width: 100%; height: 100%; image-fit: cover; }
            }
            TouchArea { clicked => { root.go-to-message(); } }
        }

        // Clickable content area (go to message)
        Rectangle {
            horizontal-stretch: 1;
            background: bar-touch.pressed ? Materials.pressed : bar-touch.has-hover ? Materials.hover : transparent;
            border-radius: Spacing.radius-sm;

            bar-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.go-to-message();
                }
            }

            // Content area
            VerticalLayout {
                alignment: center;
                spacing: Spacing.xxs;

                // Position text (small, muted)
                Text {
                    text: position-text;
                    color: Colors.primary;
                    font-size: Typography.xs;
                    font-weight: Typography.medium;
                }

                // Message preview
                Text {
                    text: root.message-preview;
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    overflow: TextOverflow.elide;
                    wrap: TextWrap.no-wrap;
                }
            }
        }

        // Close/dismiss button on RIGHT — a full 48dp box flush with the edge
        Rectangle {
            width: Spacing.touch-target-min;
            height: Spacing.touch-target-min;
            background: dismiss-touch.pressed ? Materials.pressed : dismiss-touch.has-hover ? Colors.surface-hover : transparent;
            border-radius: Spacing.radius-sm;
            transform-scale-x: dismiss-touch.pressed ? 90% : 100%;
            transform-scale-y: dismiss-touch.pressed ? 90% : 100%;
            animate transform-scale-x { duration: dismiss-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
            animate transform-scale-y { duration: dismiss-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
            accessible-role: button;
            accessible-label: "Hide pinned messages";

            Image {
                source: Icons.x;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-muted;
            }

            dismiss-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.dismiss-clicked();
                }
            }
        }
    }

}
