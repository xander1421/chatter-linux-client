import { KeyFocus } from "../components/key_focus.slint";
import { HeaderButton } from "../components/header_button.slint";
import { Materials } from "../theme/materials.slint";
// Pinned messages bar component
//
// Telegram-style always-visible bar for navigating pinned messages.
// Shows between header and message list when there are pinned messages.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export component PinnedBar inherits Rectangle {
    // Properties
    in property <string> message-preview: "";
    in property <image> thumbnail;
    in property <int> current-index: 1;  // 1-based for display
    in property <int> total-count: 1;
    in property <bool> has-multiple: false;

    // Callbacks
    callback prev-clicked();
    callback next-clicked();
    callback go-to-message();
    // Opens the page listing every pinned message. The bar itself cannot
    // be closed (owner, 2026-11-14): pins stay in view until unpinned.
    callback list-clicked();

    // Computed
    property <string> position-text: has-multiple ? @tr("Pinned message {0} of {1}", current-index, total-count) : @tr("Pinned message");

    height: Spacing.touch-target-min * Appearance.text-grow + 2 * Spacing.sm;
    background: Colors.surface-card;
    border-radius: Spacing.radius-panel;

    HorizontalLayout {
        padding: Spacing.sm;
        spacing: Spacing.sm;

        if root.has-multiple: HeaderButton {
            width: Spacing.touch-target-min;
            icon: Icons.chevron-down;
            label: @tr("Previous pinned message");
            plain: true;
            transform-rotation: 180deg;
            clicked => { root.prev-clicked(); }
        }
        if root.has-multiple: HeaderButton {
            width: Spacing.touch-target-min;
            icon: Icons.chevron-down;
            label: @tr("Next pinned message");
            plain: true;
            clicked => { root.next-clicked(); }
        }

        if root.thumbnail.width > 0: Rectangle {
            // Layouts own child positions: center the thumbnail inside a full-height cell.
            vertical-stretch: 1;
            width: 36px;
            Rectangle {
                width: 36px; height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: Spacing.radius-control; clip: true;
                Image { accessible-label: @tr("Pinned message image"); source: root.thumbnail; width: 100%; height: 100%; image-fit: cover; }
            }
            TouchArea { clicked => { root.go-to-message(); } }
        }

        // Clickable content area (go to message)
        Rectangle {
            horizontal-stretch: 1;
            background: bar-touch.pressed ? Materials.pressed : bar-touch.has-hover ? Materials.hover : transparent;
            border-radius: Spacing.radius-control;

            bar-touch := TouchArea {
                accessible-role: button;
                accessible-label: @tr("Go to pinned message: {}", root.message-preview);
                accessible-action-default => { root.go-to-message(); }
                KeyFocus { border-radius: Spacing.radius-control; activate => { root.go-to-message(); } }
                mouse-cursor: pointer;
                clicked => {
                    root.go-to-message();
                }
            }

            // Content area
            VerticalLayout {
                alignment: center;
                spacing: Spacing.xxs;

                // Position text (small, muted)
                Text {
                    text: root.position-text.to-uppercase();
                    color: Colors.text-muted;
                    font-size: 11px * Appearance.text-scale;
                    letter-spacing: self.font-size * 0.06;
                    font-weight: Typography.semibold;
                    overflow: elide;
                }

                // Message preview
                Text {
                    text: root.message-preview;
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    overflow: TextOverflow.elide;
                    wrap: TextWrap.no-wrap;
                }
            }
        }

        HeaderButton {
            width: Spacing.touch-target-min;
            icon: Icons.pin-list;
            label: @tr("All pinned messages");
            plain: true;
            clicked => { root.list-clicked(); }
        }
    }
}
