import { GlassSurface } from "../components/glass_surface.slint";
// Main chat layout component
//
// Integrates ChatHeader, MessageList, and MessageComposer into a complete chat view.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { ChatHeader } from "chat_header.slint";
import { ConversationKind } from "conversation_kind.slint";
import { MessageList, MessageItemData, MessageAttachmentData, ReactionEntry } from "message_list.slint";
import { MessageComposer, PendingAttachmentData } from "message_composer.slint";
import { PinnedBar } from "pinned_bar.slint";
import { IdentityChangeBar } from "identity_change_bar.slint";
import { MembershipBar } from "membership_bar.slint";
import { MembershipGlobal } from "membership_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { MeshContextBar } from "../mesh/mesh_context_bar.slint";

// Re-export types for parent components
export { MessageItemData, MessageAttachmentData, PendingAttachmentData, ReactionEntry }

export component ChatLayout inherits Rectangle {
    // Header properties
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <ConversationKind> conversation-kind;
    in property <bool> private-channel: false;
    // Core's own statement of where this conversation's messages go, for the
    // conversations whose kind cannot say it (the Jarvis channel: local or
    // cloud). Empty means "derive it from the kind". Every conversation open
    // resets it (bin_ui::converters::set_conversation_kind).
    in property <string> privacy-line-override: "";
    // With an override: whether the messages leave this device unencrypted.
    in property <bool> privacy-line-exposed: false;
    in property <bool> is-dm: false;  // When true, show minimal message UI (no avatars/names)
    in property <int> member-count: 0;
    in property <string> topic: "";
    in property <string> typing-indicator: "";
    in property <string> presence-status: "offline";
    in property <image> channel-avatar-source;
    in property <bool> channel-has-avatar: false;

    // When true, hide the chat header (e.g. during an active call where the
    // call dock already carries channel name/encryption/timer).
    in property <bool> hide-header: false;
    // Window y where the conversation content starts (below the header). The
    // message menu is a window-level overlay and clamps to this, so a tall
    // menu opened near the bottom never covers the conversation title.
    out property <length> content-top: root.absolute-position.y
        + (root.hide-header ? 0px
           : root.mobile ? Spacing.header-height-touch : Spacing.header-height);

    // Jarvis AI thinking state
    in-out property <bool> jarvis-thinking: false;

    // Message list properties
    in property <[MessageItemData]> messages: [];
    in property <bool> loading-messages: false;
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;
    in property <float> audio-progress: 0.0;
    in property <string> audio-elapsed: "0:00";
    in property <int> scroll-to-message-index: -1;  // Set to scroll to a specific message
    in property <string> highlighted-message-id: "";  // Message id to briefly flash (quote jump)
    in-out property <length> message-scroll-position: 0px;  // Scroll position for message list
    // Two-way: the open path resets it so a conversation left scrolled up
    // does not decide where the NEXT conversation opens.
    in-out property <bool> is-at-bottom <=> message-list.is-at-bottom;
    // Unread boundary from core — see MessageList.
    in-out property <int> unread-index: -1;
    in-out property <int> unread-count: 0;
    in property <bool> should-auto-scroll: true;  // Enable/disable auto-scroll on new messages

    // Picker properties
    in-out property <bool> emoji-picker-visible: false;
    in-out property <bool> gif-picker-visible: false;

    // Composer properties
    in-out property <string> composer-text: "";
    in property <string> composer-placeholder: "Type a message...";
    // Non-empty when the viewer may not post here (muted, removed): the
    // composer is replaced by this text, worded by chatter-core.
    in property <string> composer-notice: "";
    in property <bool> conversation-read-only: false;
    // Non-empty while a send is on the wire — see message_composer.slint.
    in property <string> composer-send-status: "";
    in property <[PendingAttachmentData]> pending-attachments: [];
    in-out property <bool> composer-is-editing: false;
    in-out property <string> composer-edit-message-id: "";
    
    // Reply properties
    in property <bool> composer-is-replying: false;
    in property <string> composer-reply-to-sender: "";
    in property <string> composer-reply-to-sender-name: "";
    in property <string> composer-reply-to-timestamp: "";
    in property <string> composer-reply-preview: "";
    in property <bool> composer-reply-has-thumbnail: false;
    in property <image> composer-reply-thumbnail;

    // Pinned bar properties (Telegram-style always visible)
    in property <bool> has-pinned-messages: false;
    in property <string> pinned-message-preview: "";
    in property <int> pinned-current-index: 1;
    in property <int> pinned-total-count: 1;

    // Mobile back button
    in property <bool> show-back-button: false;
    // macOS traffic-light clearance the header has to add for itself — see
    // app.slint. 0 unless the sidebar beside it is too narrow to cover them.
    in property <length> header-leading-inset: 0px;
    callback back-clicked();

    // Header callbacks
    callback settings-clicked();
    callback invite-clicked();
    callback voice-call-clicked();
    callback video-call-clicked();

    // Peer identity change — the conversation is wedged until the user decides.
    // Strings are formatted by chatter-core (`ChatterClient::identity_change_prompt`);
    // `identity-change-visible` is set by the DM open path and by the
    // PeerIdentityChanged domain event.
    in property <bool> identity-change-visible: false;
    in property <string> identity-change-title: "";
    in property <string> identity-change-detail: "";
    in property <bool> identity-change-attributed: false;
    callback identity-change-accept-clicked();

    // Pinned bar callbacks
    callback pinned-prev-clicked();
    callback pinned-next-clicked();
    callback pinned-go-to-message();
    callback pinned-dismiss-clicked();
    callback pinned-show-clicked();  // Re-show dismissed pinned bar

    // Message list callbacks
    in property <bool> selection-mode: false;
    in property <bool> mobile: false;
    callback selection-toggled(string);
    callback message-clicked(string);
    callback reply-clicked(string, string);  // (sender_id, timestamp_ns)
    callback react-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback reaction-toggled(string, string, string);  // (sender_id, timestamp_ns, emoji)
    callback thread-clicked(string);
    callback more-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback quote-clicked(string);  // (reply-to-message-id) — jump to quoted original
    callback view-attachment(string);  // attachment ID - for viewing attachment in messages
    callback audio-seek(string, float);  // attachment ID, position 0.0-1.0
    callback load-more();
    callback scroll-to-bottom-clicked();  // Emitted when scroll-to-bottom button is clicked

    // Composer callbacks
    callback send(string);
    callback send-edit(string, string);  // (message_id, new_text)
    callback cancel-edit();
    callback cancel-reply();
    callback attachment-clicked();
    callback paste-image();
    callback emoji-clicked();
    callback gif-clicked();
    callback mention-triggered(string);
    callback remove-attachment(string);
    callback typing-changed(bool);  // true when started typing, false when stopped
    callback process-text(string) -> string;  // Insert word breaks for text wrapping

    // Layout — Neo 2.0 surface continuity: deepest background as base plane
    background: Colors.background;

    message-list := MessageList {
        width: 100%;
        height: 100%;
        top-inset: top-chrome.height;
        bottom-inset: bottom-chrome.height;
        messages: root.messages;
        loading: root.loading-messages;
        selection-mode: root.selection-mode;
        mobile: root.mobile;
        is-dm: root.is-dm;
        can-thread: root.conversation-kind == ConversationKind.channel;
        is-mesh: MeshGlobal.active-id != "";
        // A mesh room and a geohash cell are plaintext broadcasts. Only a
        // mesh DM runs over Noise, so only it keeps the lock.
        //
        // A PUBLIC channel is plaintext too: the server creates it with
        // Encrypted:false and this client ships cleartext to it on purpose
        // (services/message/core.rs — "plaintext is the intended, visible
        // property"). It must not claim end-to-end encryption. The
        // default kind is a public channel, so a conversation whose kind
        // has not loaded yet understates privacy rather than overstating it.
        public-broadcast: root.privacy-line-override != ""
            ? root.privacy-line-exposed
          : MeshGlobal.active-kind == "room"
            || MeshGlobal.active-kind == "geohash"
            || (root.conversation-kind == ConversationKind.channel && !root.private-channel);
        privacy-line: root.privacy-line-override != ""
            ? root.privacy-line-override
          : MeshGlobal.active-kind == "room"
            ? "Anyone in radio range can read this"
          : MeshGlobal.active-kind == "geohash"
            ? "Anyone in this cell can read this"
          : root.conversation-kind == ConversationKind.channel && !root.private-channel
            ? "Public channel — anyone can read this"
            : "Messages are end-to-end encrypted";
        current-playing-attachment-id: root.current-playing-attachment-id;
        is-media-playing: root.is-media-playing;
        audio-progress: root.audio-progress;
        audio-elapsed: root.audio-elapsed;
        scroll-to-index: root.scroll-to-message-index;
        highlighted-message-id: root.highlighted-message-id;
        scroll-position <=> root.message-scroll-position;
        should-auto-scroll: root.should-auto-scroll;
        unread-index <=> root.unread-index;
        unread-count <=> root.unread-count;

        selection-toggled(id) => {
            root.selection-toggled(id);
        }

        message-clicked(id) => {
            root.message-clicked(id);
        }
        reply-clicked(sender-id, timestamp-ns) => {
            root.reply-clicked(sender-id, timestamp-ns);
        }
        reaction-toggled(sender-id, timestamp-ns, emoji) => {
            root.reaction-toggled(sender-id, timestamp-ns, emoji);
        }

        react-clicked(sender-id, timestamp-ns, x, y) => {
            root.react-clicked(sender-id, timestamp-ns, x, y);
        }
        thread-clicked(id) => {
            root.thread-clicked(id);
        }
        more-clicked(sender-id, timestamp-ns, x, y) => {
            root.more-clicked(sender-id, timestamp-ns, x, y);
        }
        quote-clicked(id) => {
            root.quote-clicked(id);
        }
        load-more => {
            root.load-more();
        }
        attachment-clicked(id) => {
            root.view-attachment(id);
        }
        audio-seek(id, pos) => {
            root.audio-seek(id, pos);
        }
        scroll-to-bottom-clicked => {
            root.scroll-to-bottom-clicked();
        }
    }

    // Floating chrome is positioned explicitly: a sized element without x/y
    // is centred in its parent, which put the header mid-screen.
    top-chrome := VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: self.preferred-height;
        // Header at top (fixed 56px). Hidden during active calls — the call
        // dock already shows channel name/encryption/timer.
        if !root.hide-header: ChatHeader {
            mobile: root.mobile;
            backdrop-paused: message-list.scrolling;
            pinned-bar-shown: root.has-pinned-messages;
            channel-id: root.channel-id;
            channel-name: root.channel-name;
            conversation-kind: root.conversation-kind;
            private-channel: root.private-channel;
            member-count: root.member-count;
            read-only: root.conversation-read-only;
            topic: root.topic;
            typing-indicator: root.typing-indicator;
            presence-status: root.presence-status;
            avatar-source: root.channel-avatar-source;
            has-avatar: root.channel-has-avatar;
            jarvis-thinking: root.jarvis-thinking;
            has-any-pinned: root.pinned-total-count > 0;
            show-back-button: root.show-back-button;
            leading-inset: root.header-leading-inset;

            back-clicked => {
                root.back-clicked();
            }
            settings-clicked => {
                root.settings-clicked();
            }
            invite-clicked => {
                root.invite-clicked();
            }
            pin-clicked => {
                root.pinned-show-clicked();
            }
            voice-call-clicked => {
                root.voice-call-clicked();
            }
            video-call-clicked => {
                root.video-call-clicked();
            }
        }

        // Peer identity change. Above the message list so it is the first thing
        // read, and directly above the marker for the message that could not be
        // decrypted. Gated on the kind as well as the flag: the flag is set
        // per DM open, and this keeps a stale one from ever surviving a switch
        // into a channel, group or mesh room.
        if root.identity-change-visible
            && root.conversation-kind == ConversationKind.server-dm: IdentityChangeBar {
            width: 100%;
            vertical-stretch: 0;
            title: root.identity-change-title;
            detail: root.identity-change-detail;
            attributed: root.identity-change-attributed;
            accept-clicked => {
                root.identity-change-accept-clicked();
            }
        }

        // Channel membership not verified (failed, fork, or no verified state
        // yet): sending is paused, and this says why. Core decides whether it
        // shows and what it says (`channel_membership_header`).
        if root.conversation-kind == ConversationKind.channel
            && MembershipGlobal.banner-severity != "": MembershipBar {
            width: 100%;
            vertical-stretch: 0;
        }

        // Mesh strip — only while a mesh conversation is open *and* it has
        // something to say. The serverless claim, the peer count and the cell now
        // sit in the header on one line; what is left here is the delivery
        // explanation, which is worth vertical space when the user could be
        // surprised and is furniture when the mesh is simply working.
        if MeshGlobal.active-id != "" && MeshGlobal.context-strip-needed: MeshContextBar {
            width: 100%;
            vertical-stretch: 0;
        }

        // Pinned messages bar (Telegram-style, always visible when pinned messages exist)
        if root.has-pinned-messages: PinnedBar {
            backdrop-paused: message-list.scrolling;
            message-preview: root.pinned-message-preview;
            current-index: root.pinned-current-index;
            total-count: root.pinned-total-count;
            has-multiple: root.pinned-total-count > 1;

            prev-clicked => {
                root.pinned-prev-clicked();
            }
            next-clicked => {
                root.pinned-next-clicked();
            }
            go-to-message => {
                root.pinned-go-to-message();
            }
            dismiss-clicked => {
                root.pinned-dismiss-clicked();
            }
        }

        // Message list in middle (fills remaining space)
        // Width 100% flows to children for text wrapping


    }

    bottom-chrome := VerticalLayout {
        x: 0;
        width: root.width;
        height: self.preferred-height;
        y: root.height - self.height;
        // Floating composer — placed directly in VerticalLayout so its
        // explicit height drives the layout slot. A wrapping plain Rectangle
        // does not auto-size from children, which collapses the hit-test
        // region to 0 even though the composer renders via overflow.
        if root.composer-notice != "": GlassSurface {
            vertical-stretch: 0;
            height: notice-text.preferred-height + 2 * Spacing.md;
            elevation: 0;
            backdrop-paused: message-list.scrolling;

            Rectangle {
                y: 0;
                width: 100%;
                height: 1px;
                background: Colors.border;
            }

            notice-text := Text {
                width: parent.width - 2 * Spacing.md;
                text: root.composer-notice;
                color: Colors.text-secondary;
                font-size: Typography.sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Hidden while selecting messages: the selection bar owns the screen
        // then, and a live composer invited typing into a mode that ignores it.
        if root.composer-notice == "" && !root.selection-mode: MessageComposer {
            width: 100%;
            vertical-stretch: 0;
            mobile: root.mobile;
            backdrop-paused: message-list.scrolling;
            text <=> root.composer-text;
            placeholder: root.composer-placeholder;
            send-status: root.composer-send-status;
            pending-attachments: root.pending-attachments;
            is-editing <=> root.composer-is-editing;
            edit-message-id <=> root.composer-edit-message-id;
            is-replying: root.composer-is-replying;
            reply-to-sender: root.composer-reply-to-sender-name;
            reply-to-preview: root.composer-reply-preview;
            reply-has-thumbnail: root.composer-reply-has-thumbnail;
            reply-thumbnail: root.composer-reply-thumbnail;

            send(text) => {
                root.send(text);
            }
            send-edit(msg-id, text) => {
                root.send-edit(msg-id, text);
            }
            cancel-edit => {
                root.cancel-edit();
            }
            cancel-reply => {
                root.cancel-reply();
            }
            attachment-clicked => {
                root.attachment-clicked();
            }
            paste-image => {
                root.paste-image();
            }
            emoji-clicked => {
                root.emoji-picker-visible = !root.emoji-picker-visible;
                root.gif-picker-visible = false;
                root.emoji-clicked();
            }
            gif-clicked => {
                root.gif-picker-visible = !root.gif-picker-visible;
                root.emoji-picker-visible = false;
                root.gif-clicked();
            }
            input-focused => {
                root.emoji-picker-visible = false;
                root.gif-picker-visible = false;
            }
            mention-triggered(query) => {
                root.mention-triggered(query);
            }
            remove-attachment(id) => {
                root.remove-attachment(id);
            }
            typing-changed(is-typing) => {
                root.typing-changed(is-typing);
            }
            process-text(text) => {
                return root.process-text(text);
            }
        }

        // Thumb room under the composer. On a phone it otherwise sits flush on
        // the bottom edge of the screen — the send/attach controls end up in
        // the same few millimetres as the system gesture strip, and the field
        // reads as falling off the display. Desktop keeps the composer docked.
        if root.mobile: Rectangle {
            vertical-stretch: 0;
            height: Spacing.sm;
        }
    }
}
