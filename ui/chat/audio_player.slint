// Inline audio player — a round play/pause button, filename, a seekable
// waveform, and an elapsed/duration readout. Shared by the main message
// attachment and the reply/quote bubble so both render identically. The
// `compact` variant shrinks the button/track for the tighter quote layout.

import { KeyFocus } from "../components/key_focus.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";
import { HoldArea } from "../components/hold_area.slint";

export component AudioPlayer inherits HorizontalLayout {
    // Audio identity / metadata
    in property <string> attachment-id: "";
    in property <string> filename: "";
    in property <[int]> waveform: [];
    in property <string> duration-display: "";
    in property <bool> is-download-failed: false;

    // Shared playback state (driven from the owning message list)
    in property <string> current-playing-attachment-id: "";
    in property <bool> is-media-playing: false;
    in property <float> audio-progress: 0.0;
    in property <string> audio-elapsed: "0:00";

    // Slightly smaller variant for the reply/quote bubble
    in property <bool> compact: false;

    // Touch input. Press-and-hold is the touch route to the context menu;
    // on a pointer device right-click already is, and arming the timer there
    // would fire the menu on every slow click.
    in property <bool> mobile: false;

    callback play-clicked(string);          // toggle playback for attachment-id
    callback audio-seek(string, float);     // attachment-id, 0..1 seek position
    callback more-clicked(length, length);  // absolute x, y for the context menu

    property <bool> is-this-playing: root.attachment-id != "" && root.attachment-id == root.current-playing-attachment-id;
    property <length> button-size: root.compact ? 28px : 40px;
    property <length> icon-size: root.compact ? 12px : 16px;
    property <length> track-width: root.compact ? 160px : 180px;
    property <float> displayed-progress: root.is-this-playing ? clamp(root.audio-progress, 0.0, 1.0) : 0.0;
    animate displayed-progress { duration: Materials.motion-quick; easing: Materials.settle; }

    spacing: root.compact ? Spacing.xs : Spacing.sm;

    // Play / pause button
    Rectangle {
        width: root.button-size;
        height: root.button-size;
        border-radius: root.button-size / 2;
        // TalkBack had no node for it: a voice message could not be played.
        accessible-role: button;
        accessible-label: root.is-download-failed ? "Retry download"
            : (root.is-this-playing && root.is-media-playing) ? "Pause voice message" : "Play voice message";
        accessible-action-default => { root.play-clicked(root.attachment-id); }
        KeyFocus { border-radius: parent.border-radius; activate => { root.play-clicked(root.attachment-id); } }
        background: play-touch.has-hover ? Colors.primary.darker(0.1) : Colors.primary;
        opacity: play-touch.pressed ? 0.82 : 1.0;
        animate opacity { duration: Materials.motion-quick; easing: Materials.spring; }

        Image {
            width: root.icon-size;
            height: root.icon-size;
            source: root.is-download-failed ? Icons.download : ((root.is-this-playing && root.is-media-playing) ? Icons.pause : Icons.play);
            colorize: Colors.text-primary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        play-touch := HoldArea {
            mouse-cursor: pointer;
            enabled-for-touch: root.mobile;
            // `hold-fired` guard: the release that ends a hold also raises
            // `clicked`, and a hold that both opens the menu and starts
            // playback is worse than no menu at all.
            clicked => {
                if (self.hold-fired) { return; }
                root.play-clicked(root.attachment-id);
            }
            held => { root.more-clicked(self.anchor-x, self.anchor-y); }
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xs;
        width: root.track-width;

        Text {
            text: root.filename;
            color: Colors.text-primary;
            font-size: Typography.xs;
            overflow: elide;
        }

        waveform := Rectangle {
            height: 16px;

            HorizontalLayout {
                spacing: Spacing.xs;

                for bar[idx] in root.waveform: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Rectangle {
                        property <float> bar-position: (idx + 1) / max(1.0, root.waveform.length);
                        property <bool> is-played: root.is-this-playing && bar-position <= root.displayed-progress;

                        height: 3px + clamp(bar / 100.0, 0.0, 1.0) * (waveform.height - 3px);
                        background: is-played ? Colors.primary : Colors.text-muted;
                        border-radius: 1px;
                        animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 2px;
                visible: root.is-this-playing && root.displayed-progress > 0;
                height: 2px;
                width: parent.width * root.displayed-progress;
                background: Colors.primary;
                border-radius: 1px;
            }
            Rectangle {
                x: max(0px, min(parent.width - self.width, parent.width * root.displayed-progress - self.width / 2));
                y: (parent.height - self.height) / 2;
                width: waveform-touch.pressed ? 10px : 6px;
                height: waveform-touch.pressed ? 10px : 6px;
                border-radius: self.width / 2;
                background: Colors.primary;
                visible: root.is-this-playing || waveform-touch.pressed;
                animate width { duration: Materials.motion-quick; easing: Materials.spring; }
                animate height { duration: Materials.motion-quick; easing: Materials.spring; }
            }

            waveform-touch := HoldArea {
                property <float> seek-pos: clamp(self.mouse-x / parent.width, 0.0, 1.0);
                mouse-cursor: pointer;
                enabled-for-touch: root.mobile;
                clicked => {
                    if (self.hold-fired) { return; }
                    root.audio-seek(root.attachment-id, self.seek-pos);
                }
                moved => { if (self.pressed) { root.audio-seek(root.attachment-id, self.seek-pos); } }
                held => { root.more-clicked(self.anchor-x, self.anchor-y); }
            }
        }

        Text {
            text: root.is-download-failed ? "Download failed · tap to retry" : (root.is-this-playing ? root.audio-elapsed + " / " + root.duration-display : root.duration-display);
            color: root.is-download-failed ? Colors.primary : Colors.text-muted;
            font-size: Typography.xs;
        }
    }
}
