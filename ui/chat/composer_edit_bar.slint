import { HeaderButton } from "../components/header_button.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Edit mode indicator bar
export component ComposerEditBar inherits Rectangle {
    callback cancel-edit();
    background: Colors.surface-control;
    border-radius: Spacing.radius-control;

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.sm;
        alignment: space-between;

        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: start;

            Image {
                source: Icons.edit;
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-secondary;
            }

            Text {
                text: @tr("Editing message");
                color: Colors.text-secondary;
                font-size: Typography.sm;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        HeaderButton {
            touch: true;
            plain: true;
            glyph: 18px;
            icon: Icons.x;
            label: @tr("Cancel edit");
            clicked => { root.cancel-edit(); }
        }
    }
}
