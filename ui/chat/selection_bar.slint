import { GlassSurface } from "../components/glass_surface.slint";
// Multi-select action bar.
//
// Stands in for the channel's own header while selection mode is active: how
// many messages are selected, the bulk actions, and the explicit way out.
// Android Back is the other way out and is handled in Rust, ahead of modal
// dismissal.
//
// Lives INSIDE the chat column, not at the window root. As a root-level overlay it
// spanned the whole window and sat on top of the sidebar and the chat header at
// once — the count floated above nav it was not part of. Here it replaces
// ChatHeader (`hide-header: root.selection-mode`), which is also why it does not
// apply `safe-area-top`: ChatHeader does not either, and insetting one of the
// two would misalign them. The property is kept, defaulted to 0, so the element
// still works if it is ever hoisted back to the root.
//
// Bulk actions: copy, forward (the forward modal takes the selected messages
// as a list and sends them in list order), delete.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { HeaderButton } from "../components/header_button.slint";

export global SelectionChrome {
    in-out property <bool> can-delete-everyone: false;
    callback select-all();
    callback delete-everyone();
}

export component SelectionBar inherits GlassSurface {
    material-level: 2;
    elevation: 3;
    border-radius: 0px;

    in property <bool> show: false;
    in property <int> count: 0;
    in property <length> safe-area-top: 0px;
    // Same density input as the ChatHeader this bar replaces, so the two rows
    // are one height and their buttons one box.
    in property <bool> touch: false;

    callback cleared();
    callback delete-clicked();
    callback copy-clicked();
    callback forward-clicked();

    visible: root.show;
    height: (root.touch ? Spacing.header-height-touch : Spacing.header-height) + root.safe-area-top;

    HorizontalLayout {
        y: root.safe-area-top;
        height: parent.height - root.safe-area-top;
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.header-action-gap;

        // Exit selection mode. Mirrors what Android Back does.
        HeaderButton {
            backdrop-paused: root.backdrop-paused;
            touch: root.touch;
            icon: Icons.x;
            label: "Exit selection";
            clicked => { root.cleared(); }
        }

        Text {
            text: root.count == 1 ? "1 selected" : root.count + " selected";
            color: Colors.text-primary;
            font-size: Typography.base;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        HeaderButton {
            backdrop-paused: root.backdrop-paused;
            touch: root.touch;
            icon: Icons.check;
            label: "Select all";
            enabled: true;
            clicked => { SelectionChrome.select-all(); }
        }

        HeaderButton {
            backdrop-paused: root.backdrop-paused;
            touch: root.touch;
            icon: Icons.copy;
            label: "Copy selected";
            enabled: root.count > 0;
            clicked => { root.copy-clicked(); }
        }

        HeaderButton {
            backdrop-paused: root.backdrop-paused;
            touch: root.touch;
            icon: Icons.send;
            label: "Forward selected";
            enabled: root.count > 0;
            clicked => { root.forward-clicked(); }
        }

        HeaderButton {
            backdrop-paused: root.backdrop-paused;
            touch: root.touch;
            icon: Icons.trash;
            label: "Delete selected";
            destructive: true;
            enabled: root.count > 0;
            clicked => { root.delete-clicked(); }
        }
    }
}
