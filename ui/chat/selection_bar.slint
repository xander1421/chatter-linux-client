// Multi-select action bar.
//
// Stands in for the channel's own header while selection mode is active: how
// many messages are selected, the bulk actions, and the explicit way out.
// Android Back is the other way out and is handled in Rust, ahead of modal
// dismissal.
//
// Lives INSIDE the chat column, not at App root. As a root-level overlay it
// spanned the whole window and sat on top of the sidebar and the chat header at
// once — the count floated above nav it was not part of. Here it replaces
// ChatHeader (`hide-header: root.selection-mode`), which is also why it does not
// apply `safe-area-top`: ChatHeader does not either, and insetting one of the
// two would misalign them. The property is kept, defaulted to 0, so the element
// still works if it is ever hoisted back to the root.
//
// Bulk actions: copy, forward (the forward modal takes the selected messages
// as a list and sends them in list order), delete.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    callback clicked();

    width: Spacing.touch-target-min;
    height: Spacing.touch-target-min;
    border-radius: Spacing.radius-sm;
    background: touch.has-hover ? Colors.surface-hover : transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    accessible-role: button;
    accessible-label: root.label;

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.destructive ? Colors.error : Colors.text-primary;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component SelectionBar inherits Rectangle {
    in property <bool> show: false;
    in property <int> count: 0;
    in property <length> safe-area-top: 0px;

    callback cleared();
    callback delete-clicked();
    callback copy-clicked();
    callback forward-clicked();

    visible: root.show;
    height: Spacing.touch-target-min + Spacing.sm * 2 + root.safe-area-top;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-y: Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    HorizontalLayout {
        y: root.safe-area-top;
        height: parent.height - root.safe-area-top;
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.xs;

        // Exit selection mode. Mirrors what Android Back does.
        BarButton {
            icon: Icons.x;
            label: "Exit selection";
            clicked => { root.cleared(); }
        }

        Text {
            text: root.count == 1 ? "1 selected" : root.count + " selected";
            color: Colors.text-primary;
            font-size: Typography.base;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        BarButton {
            icon: Icons.copy;
            label: "Copy selected";
            enabled: root.count > 0;
            clicked => { root.copy-clicked(); }
        }

        BarButton {
            icon: Icons.send;
            label: "Forward selected";
            enabled: root.count > 0;
            clicked => { root.forward-clicked(); }
        }

        BarButton {
            icon: Icons.trash;
            label: "Delete selected";
            destructive: true;
            enabled: root.count > 0;
            clicked => { root.delete-clicked(); }
        }
    }
}
