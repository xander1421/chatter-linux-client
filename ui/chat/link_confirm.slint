import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";

export component LinkConfirm inherits Rectangle {
    in property <string> url;
    callback confirmed();
    callback cancelled();

    Modal {
        show: root.url != "";
        title: "Open this link?";
        modal-width: 440px;
        show-close: false;
        close => { root.cancelled(); }

        VerticalLayout {
            spacing: Spacing.md;

            TextInput {
                text: root.url;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                height: 88px;
                color: Colors.text-primary;
                font-size: Typography.sm;
            }

            HorizontalLayout {
                spacing: Spacing.sm;
                alignment: end;
                Button {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: "Open";
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
