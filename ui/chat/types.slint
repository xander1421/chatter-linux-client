// Chat-related data types
//
// Shared structs used by message_list and message_item components.

// Data struct for individual reaction entries (emoji + count pill)
export struct ReactionEntry {
    emoji: string,
    count: int,
}

// Data struct for attachment items in messages
export struct MessageAttachmentData {
    id: string,
    filename: string,
    size-display: string,
    mime-type: string,
    category: string,       // "image", "video", "audio", "document", "code", "archive", "other"
    thumbnail-url: string,  // URL for image preview or empty
    download-url: string,   // URL to download full file
    is-image: bool,
    is-video: bool,
    width: int,             // Original width for images/videos
    height: int,            // Original height for images/videos
    thumbnail: image,       // Actual image data for display (loaded from local_path)
    has-thumbnail: bool,    // Whether thumbnail image is available
    is-playing: bool,       // Whether this audio/video is currently playing
    icon: string,           // Emoji icon for file type (set by Rust)
    icon-color: color,      // Color for icon background (set by Rust)
    waveform: [int],        // Audio waveform samples (32 values, 0-100)
    duration-display: string, // Formatted duration (e.g., "1:23")
    // Transfer progress
    is-uploading: bool,     // Whether upload is in progress
    is-downloading: bool,   // Whether download is in progress
    progress: float,        // Transfer progress 0.0 to 1.0
}

// Data struct for link previews embedded in messages
export struct LinkPreviewData {
    url: string,            // Full URL
    domain: string,         // Display domain (e.g., "github.com")
    title: string,          // Page title
    description: string,    // Meta description (truncated)
    has-image: bool,        // Whether a preview image is available
    preview-image: image,   // OG image thumbnail
}

// Styled text span for markdown-parsed message rendering.
// Each span has at most one style flag set (bold, italic, etc.).
export struct RichTextSpan {
    text: string,
    bold: bool,
    italic: bool,
    strikethrough: bool,
    code: bool,         // inline code (monospace)
    code-block: bool,   // fenced code block (monospace + background)
}

// Data struct for message items (mirrors Rust MessageItemData)
export struct MessageItemData {
    message-id: string,
    sender-id: string,
    sender-name: string,
    sender-initials: string,
    sender-avatar-source: image,
    has-avatar: bool,
    content: string,
    rich-content: [RichTextSpan],  // Parsed markdown spans for styled rendering
    timestamp: string,
    timestamp-ns: string,  // Nanosecond timestamp as string for event matching (reactions, edits, pins)
    is-own: bool,
    is-edited: bool,
    is-deleted: bool,
    is-system: bool,
    is-ai: bool,
    has-attachments: bool,
    attachment-count: int,
    attachments: [MessageAttachmentData],
    has-reactions: bool,
    reaction-summary: string,
    reactions: [ReactionEntry],
    reply-count: int,
    reply-count-text: string,  // Pre-formatted "1 reply" or "N replies"
    is-thread-reply: bool,
    // Quote / reply-to context
    is-reply: bool,                  // Whether this message is a reply to another
    reply-to-message-id: string,     // Stringified parent MessageId (empty when not a reply) — tap-to-jump target
    reply-to-not-found: bool,        // Quoted parent is missing/deleted ("Original message not found")
    reply-to-sender-name: string,    // Display name of quoted message author
    reply-to-preview: string,        // Preview text of the quoted message
    reply-to-has-thumbnail: bool,    // Whether the quoted message has a media thumbnail
    reply-to-thumbnail: image,       // Thumbnail image for the quoted message (e.g. photo, video)
    show-sender: bool,
    // Link preview
    has-link-preview: bool,
    link-preview: LinkPreviewData,
    delivery-status: string,  // "sent", "delivered", "read", or "" for non-own messages
    is-pinned: bool,          // Whether message is pinned
    // Call message fields
    is-call: bool,            // Whether this is a call event message
    call-type: string,        // "outgoing", "incoming", "missed"
    call-duration: string,    // Formatted duration "1 min 30 s" or empty for missed
    // Message grouping (set by Rust when preparing message list)
    show-date-separator: bool,     // Show date separator bar before this message
    date-separator-text: string,   // "Today", "Yesterday", "March 25, 2026"
    is-continuation: bool,         // Same sender as previous, within time window — hide avatar/name
}
