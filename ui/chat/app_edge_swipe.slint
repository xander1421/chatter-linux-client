// Only the leading edge handles the gesture, so message scrolling and text
// selection remain under the chat pane.
export component AppEdgeSwipe inherits TouchArea {
    in-out property <bool> chat-edge-swiping;
    in-out property <length> chat-edge-start;
    in-out property <float> chat-push-progress;
    in-out property <bool> mobile-show-chat;
    in property <length> window-width;

    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.chat-edge-swiping = true;
            root.chat-edge-start = self.absolute-position.x + self.mouse-x;
        }
        if event.kind == PointerEventKind.move && root.chat-edge-swiping {
            root.chat-push-progress = 1 - min(1, max(0,
                (self.absolute-position.x + self.mouse-x - root.chat-edge-start) / root.window-width));
        }
        // The system Back gesture can take this touch away;
        // only a completed in-app swipe may close the chat.
        if event.kind == PointerEventKind.cancel {
            root.chat-edge-swiping = false;
            root.chat-push-progress = 1;
        } else if event.kind == PointerEventKind.up {
            root.chat-edge-swiping = false;
            if root.chat-push-progress < 0.7 { root.mobile-show-chat = false; }
            else { root.chat-push-progress = 1; }
        }
    }
}
