// Chat header component
//
// Displays channel information, topic, and action buttons.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Data struct for chat header (mirrors Rust ChatHeaderData)
export struct ChatHeaderData {
    channel-id: string,
    channel-name: string,
    channel-type: string,  // "public", "private", "dm", "anon-dm", "private-group", "saved"
    member-count: int,
    topic: string,
    is-archived: bool,
    typing-indicator: string,
    presence-status: string,  // "online", "away", "dnd", "offline" — shown for DMs only
}

// Reusable icon button component — 44px minimum touch target for mobile
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Colors.text-secondary;
    in property <color> hover-color: Colors.text-primary;
    callback clicked();

    width: Spacing.touch-target-min;
    height: Spacing.touch-target-min;
    background: touch.has-hover ? Colors.surface-hover : transparent;
    border-radius: Spacing.radius-md;
    border-width: touch.has-hover ? 1px : 0px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: touch.has-hover ? Spacing.neo-blur-sm : 0px;
    drop-shadow-offset-x: touch.has-hover ? 1px : 0px;
    drop-shadow-offset-y: touch.has-hover ? 1px : 0px;
    drop-shadow-color: touch.has-hover ? Colors.neo-shadow : transparent;

    Image {
        source: icon;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: touch.has-hover ? hover-color : icon-color;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ChatHeader inherits Rectangle {
    // Properties from ChatHeaderData
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <string> channel-type: "public";  // "public", "private", "dm", "anon-dm", "private-group", "saved"
    in property <int> member-count: 0;
    in property <string> topic: "";
    in property <bool> is-archived: false;
    in property <string> typing-indicator: "";
    in property <string> presence-status: "offline";

    // Optional custom channel/peer avatar — replaces the type glyph (#, @,
    // shield, lock, bookmark) when the owner uploaded an icon.
    in property <image> avatar-source;
    in property <bool> has-avatar: false;

    // Jarvis AI thinking state
    in-out property <bool> jarvis-thinking: false;

    // Whether there are pinned messages (even if bar is dismissed)
    in property <bool> has-any-pinned: false;

    // Mobile back button (returns to chat list)
    in property <bool> show-back-button: false;
    callback back-clicked();

    // Callbacks
    callback search-clicked();
    callback settings-clicked();
    callback pin-clicked();
    callback members-clicked();
    callback voice-call-clicked();
    callback video-call-clicked();
    callback invite-clicked();

    // Type detection properties
    property <bool> is-private: channel-type == "private";
    property <bool> is-dm: channel-type == "dm";
    property <bool> is-anon-dm: channel-type == "anon-dm";
    property <bool> is-private-group: channel-type == "private-group";
    property <bool> is-saved: channel-type == "saved";

    // Show member count for channels and private groups (not DMs)
    property <bool> show-member-count: (channel-type == "public" || channel-type == "private" || is-private-group) && member-count > 0;

    // Show settings for regular channels and private groups, not for anon DMs or saved messages
    property <bool> show-settings: (!is-anon-dm && !is-saved) || is-private-group;

    // Show invite button for channels and private groups only (not DMs, anon DMs, or saved)
    property <bool> show-invite: !is-dm && !is-anon-dm && !is-saved;

    // Show call buttons for everything except saved messages
    property <bool> show-calls: !is-saved;

    // Layout (56px header) — Neo glassmorphism: translucent surface with edge definition
    height: 56px;
    background: Colors.surface.with-alpha(0.85);
    border-width: 1px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-sm;
    drop-shadow-offset-y: Spacing.neo-offset-sm;
    drop-shadow-color: Colors.neo-shadow;

    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: space-between;

        // Left section: Back button + Icon + Name
        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: start;

            // Mobile back button (returns to chat list)
            if root.show-back-button: IconButton {
                icon: Icons.chevron-left;
                width: Spacing.touch-target-min;
                clicked => { root.back-clicked(); }
            }

            // Single leading icon per conversation type — no standalone
            // "encrypted" shield (E2E is already implied by the purple shield
            // on anon / private-group chats and by app-wide guarantees).
            //
            //   has-avatar     → channel icon (overrides the type glyph)
            //   public         → `#`          (muted)
            //   private        → lock         (muted) — invite-only channel
            //   dm             → `@` + dot    (peer presence)
            //   anon-dm        → purple shield
            //   private-group  → purple shield
            //   saved          → bookmark

            if root.has-avatar: Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                clip: true;
                y: (parent.height - self.height) / 2;
                Image {
                    source: root.avatar-source;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }

            if !root.has-avatar && channel-type == "public": Text {
                text: "#";
                color: Colors.text-muted;
                font-size: Typography.lg;
                vertical-alignment: center;
            }

            if !root.has-avatar && is-private: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                Image {
                    source: Icons.lock;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-muted;
                }
            }

            if !root.has-avatar && is-dm: HorizontalLayout {
                spacing: 4px;
                alignment: center;
                Text {
                    text: "@";
                    color: Colors.text-muted;
                    font-size: Typography.lg;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    y: (parent.height - self.height) / 2;
                    background: root.presence-status == "online" ? Colors.online
                             : root.presence-status == "away" ? Colors.away
                             : root.presence-status == "dnd" ? Colors.dnd
                             : Colors.offline;
                }
            }

            if !root.has-avatar && (is-anon-dm || is-private-group): Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                Image {
                    source: Icons.shield;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.primary;
                }
            }

            if !root.has-avatar && is-saved: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                Image {
                    source: Icons.bookmark;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.primary;
                }
            }

            // Channel/conversation name (stretches to fill, then elides)
            Text {
                text: root.channel-name;
                color: Colors.text-primary;
                font-size: Typography.base;
                font-weight: Typography.semibold;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Member count
            if root.show-member-count: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: Colors.text-muted;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "\{root.member-count} members";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
            }
        }

        // Center section: Topic / Typing
        Rectangle {
            horizontal-stretch: 1;
            // Topic text
            if root.topic != "" && root.typing-indicator == "" && !root.jarvis-thinking: Text {
                width: 100%;
                text: root.topic;
                color: Colors.text-muted;
                font-size: Typography.sm;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // Typing indicator
            if root.typing-indicator != "" && !root.jarvis-thinking: HorizontalLayout {
                alignment: center;
                Text {
                    text: root.typing-indicator;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-italic: true;
                    vertical-alignment: center;
                }
            }

            // Jarvis thinking
            if root.jarvis-thinking: HorizontalLayout {
                spacing: 6px;
                alignment: center;
                for i in [0, 1, 2]: Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Colors.primary;
                    y: (parent.height - self.height) / 2 + 2px * Math.sin((animation-tick() / 250ms + i * 0.3) * 360deg);
                }
                Text {
                    text: "Jarvis is thinking...";
                    font-size: Typography.sm;
                    font-italic: true;
                    color: Colors.primary;
                    vertical-alignment: center;
                }
            }
        }

        // Right section: Action buttons
        HorizontalLayout {
            spacing: 2px;
            alignment: end;

            // Call buttons group
            if root.show-calls: HorizontalLayout {
                spacing: 2px;
                alignment: center;
                IconButton {
                    icon: Icons.phone;
                    clicked => { root.voice-call-clicked(); }
                }
                IconButton {
                    icon: Icons.video;
                    clicked => { root.video-call-clicked(); }
                }
                // Divider
                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Colors.text-muted.with-alpha(0.3);
                    y: (parent.height - self.height) / 2;
                }
            }

            // Utility buttons group
            HorizontalLayout {
                spacing: 2px;
                alignment: center;
                if root.show-invite: IconButton {
                    icon: Icons.user-plus;
                    clicked => { root.invite-clicked(); }
                }
                if root.show-member-count: IconButton {
                    icon: Icons.users;
                    clicked => { root.members-clicked(); }
                }
                if root.has-any-pinned: IconButton {
                    icon: Icons.pin;
                    icon-color: Colors.primary;
                    clicked => { root.pin-clicked(); }
                }
                if root.show-settings: IconButton {
                    icon: Icons.settings;
                    clicked => { root.settings-clicked(); }
                }
            }
        }
    }

    // Bottom edge — neo highlight creates glass edge
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Colors.neo-highlight;
    }
}
