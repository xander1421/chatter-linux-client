// Chat header component
//
// Displays channel information, topic, and action buttons.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Data struct for chat header (mirrors Rust ChatHeaderData)
export struct ChatHeaderData {
    channel-id: string,
    channel-name: string,
    channel-type: string,  // "public", "private", "dm", "anon-dm", "private-group"
    member-count: int,
    topic: string,
    is-archived: bool,
    typing-indicator: string,
}

// Reusable icon button component — 44px minimum touch target for mobile
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Colors.text-secondary;
    in property <color> hover-color: Colors.text-primary;
    callback clicked();

    width: 44px;
    height: 44px;
    background: touch.has-hover ? Colors.surface-hover : transparent;
    border-radius: Spacing.radius-sm;

    Image {
        source: icon;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: touch.has-hover ? hover-color : icon-color;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ChatHeader inherits Rectangle {
    // Properties from ChatHeaderData
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <string> channel-type: "public";  // "public", "private", "dm", "anon-dm", "private-group"
    in property <int> member-count: 0;
    in property <string> topic: "";
    in property <bool> is-archived: false;
    in property <string> typing-indicator: "";

    // Jarvis AI thinking state
    in-out property <bool> jarvis-thinking: false;

    // Whether there are pinned messages (even if bar is dismissed)
    in property <bool> has-any-pinned: false;

    // Callbacks
    callback search-clicked();
    callback settings-clicked();
    callback pin-clicked();
    callback members-clicked();
    callback voice-call-clicked();
    callback video-call-clicked();
    callback invite-clicked();

    // Type detection properties
    property <bool> is-private: channel-type == "private";
    property <bool> is-dm: channel-type == "dm";
    property <bool> is-anon-dm: channel-type == "anon-dm";
    property <bool> is-private-group: channel-type == "private-group";

    // Show member count for channels and private groups (not DMs)
    property <bool> show-member-count: (channel-type == "public" || channel-type == "private" || is-private-group) && member-count > 0;

    // Show settings for regular channels and private groups, not for anon DMs
    property <bool> show-settings: !is-anon-dm || is-private-group;

    // Show call buttons for everything except saved messages
    property <bool> show-calls: channel-type != "saved";

    // Layout (56px header + 22px encryption banner)
    height: 78px;
    background: Colors.surface;

    // Main content (constrained to top 56px)
    Rectangle {
        y: 0;
        width: 100%;
        height: 56px;

    HorizontalLayout {
        // Encryption indicator — always visible
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 20px;
                height: 20px;

                Image {
                    source: Icons.shield;
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.success;
                }
            }
        }

        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;

        // Left section: Channel icon and name
        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: start;

            // Channel icon - varies by type
            // Public channel: #
            if channel-type == "public": Text {
                text: "#";
                color: Colors.text-muted;
                font-size: Typography.lg;
                vertical-alignment: center;
            }

            // Private channel: lock icon
            if is-private: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: Icons.lock;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-muted;
                }
            }

            // Regular DM: @
            if is-dm: Text {
                text: "@";
                color: Colors.text-muted;
                font-size: Typography.lg;
                vertical-alignment: center;
            }

            // Anonymous DM: shield/lock icon to indicate privacy
            if is-anon-dm: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: Icons.lock;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.primary;
                }
            }

            // Private group: users icon
            if is-private-group: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: Icons.users;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.primary;
                }
            }

            // Channel/conversation name (constrained to leave room for action buttons)
            Text {
                text: root.channel-name;
                color: Colors.text-primary;
                font-size: Typography.base;
                font-weight: Typography.semibold;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            // Archived badge
            if root.is-archived: Rectangle {
                height: 18px;
                width: archived-text.preferred-width + 8px;
                background: Colors.text-muted;
                border-radius: 4px;

                archived-text := Text {
                    x: 4px;
                    text: "Archived";
                    color: Colors.surface;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }
            }

            // Member count (for channels and private groups)
            if root.show-member-count: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: center;

                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: Colors.text-muted;
                }

                Text {
                    text: "\{root.member-count} members";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
            }
        }

        // Center section: Topic (flex)
        Rectangle {
            horizontal-stretch: 1;

            // Topic text (truncated) - only show when no typing or Jarvis thinking
            if root.topic != "" && root.typing-indicator == "" && !root.jarvis-thinking: Text {
                width: 100%;
                text: root.topic;
                color: Colors.text-muted;
                font-size: Typography.sm;
                overflow: elide;
                vertical-alignment: center;
            }

            // Typing indicator (takes precedence over topic)
            if root.typing-indicator != "" && !root.jarvis-thinking: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: start;

                Text {
                    text: root.typing-indicator;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-italic: true;
                    vertical-alignment: center;
                }
            }

            // Jarvis thinking indicator (takes precedence over both)
            if root.jarvis-thinking: HorizontalLayout {
                spacing: 6px;
                padding-left: 12px;
                alignment: start;

                // Animated dots with bouncing effect
                for i in [0, 1, 2]: Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Colors.primary;
                    // Convert to angle using 1deg multiplier for sin function
                    y: 2px * Math.sin((animation-tick() / 250ms + i * 0.3) * 360deg);
                }

                Text {
                    text: "Jarvis is thinking...";
                    font-size: Typography.sm;
                    font-italic: true;
                    color: Colors.primary;
                    vertical-alignment: center;
                }
            }
        }

        // Right section: Action buttons (wrapped in VerticalLayout for vertical centering)
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 2px;
                alignment: end;

                // Call buttons group (hidden for saved messages)
                if root.show-calls: HorizontalLayout {
                    spacing: 2px;

                    // Phone icon — 44px touch target
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        background: phone-touch.has-hover ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;

                        Image {
                            source: Icons.phone;
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: phone-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                        }

                        phone-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.voice-call-clicked(); }
                        }
                    }

                    IconButton {
                        icon: Icons.video;
                        clicked => { root.video-call-clicked(); }
                    }
                }

                // Divider between button groups (hidden when calls are hidden)
                if root.show-calls: Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Colors.text-muted.with-alpha(0.3);
                }

                // Utility buttons group
                HorizontalLayout {
                    spacing: 2px;

                    // Invite button (channels and private groups)
                    if root.show-settings: IconButton {
                        icon: Icons.user-plus;
                        clicked => { root.invite-clicked(); }
                    }

                    // Members button (channels and private groups only)
                    if root.show-member-count: IconButton {
                        icon: Icons.users;
                        clicked => { root.members-clicked(); }
                    }

                    // Pin button (shows when there are pinned messages)
                    if root.has-any-pinned: IconButton {
                        icon: Icons.pin;
                        icon-color: Colors.primary;
                        clicked => { root.pin-clicked(); }
                    }

                    IconButton {
                        icon: Icons.search;
                        clicked => { root.search-clicked(); }
                    }

                    // Settings button (hidden for anon DMs - no channel settings)
                    if root.show-settings: IconButton {
                        icon: Icons.settings;
                        clicked => { root.settings-clicked(); }
                    }
                }
            }
        }
    }
    } // end main content Rectangle

    // Encryption trust banner
    Rectangle {
        y: parent.height - 22px;
        width: 100%;
        height: 22px;
        background: Colors.surface;

        HorizontalLayout {
            alignment: center;
            spacing: 4px;

            Image {
                source: Icons.lock;
                width: 10px;
                height: 10px;
                colorize: Colors.success;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.is-anon-dm ? "Anonymous · End-to-end encrypted"
                    : "Messages are end-to-end encrypted";
                color: Colors.success;
                font-size: Typography.xs;
                vertical-alignment: center;
            }
        }
    }

    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Colors.surface-hover;
    }
}
