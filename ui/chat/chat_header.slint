import { GlassSurface } from "../components/glass_surface.slint";
// Chat header component
//
// Displays channel information, topic, and action buttons.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { NeoActionToggle } from "../components/neo_action_toggle.slint";
import { Avatar } from "../components/avatar.slint";
import { HeaderButton } from "../components/header_button.slint";
import { JarvisGlobal } from "../jarvis/jarvis_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { ConversationKind } from "conversation_kind.slint";
import { MembershipGlobal } from "membership_global.slint";

export component ChatHeader inherits GlassSurface {
    material-level: 2;
    elevation: 3;
    border-radius: self.height / 2;

    // Properties from ChatHeaderData
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <ConversationKind> conversation-kind;
    // Only meaningful for `ConversationKind.channel`: an invite-only channel.
    in property <bool> private-channel: false;
    in property <int> member-count: 0;
    // A channel we left or were removed from: we no longer see its roster
    // (Channel Settings lists no one) and, as in Signal, cannot call it.
    in property <bool> read-only: false;
    in property <string> topic: "";
    in property <string> typing-indicator: "";
    in property <string> presence-status: "offline";

    // Optional custom channel/peer avatar — replaces the type glyph (#, @,
    // shield, lock, bookmark) when the owner uploaded an icon.
    in property <image> avatar-source;
    in property <bool> has-avatar: false;

    // Jarvis AI thinking state
    in-out property <bool> jarvis-thinking: false;

    // Whether there are pinned messages (even if bar is dismissed)
    in property <bool> has-any-pinned: false;
    in property <bool> pinned-bar-shown: false;

    // Mobile back button (returns to chat list)
    in property <bool> show-back-button: false;
    callback back-clicked();

    // Callbacks
    callback settings-clicked();
    callback pin-clicked();
    callback voice-call-clicked();
    callback invite-clicked();
    // The ⋯ button. The menu itself is on the window's modal stack (app.slint,
    // "chat-menu"); these say which of its rows apply to this conversation.
    callback more-clicked(/* video-call */ bool, /* settings */ bool);

    // Presence dot colour, drawn by the DM avatar (picture or initials).
    property <color> presence-dot:
        root.presence-status == "online" ? Colors.online
      : root.presence-status == "away" ? Colors.away
      : root.presence-status == "dnd" ? Colors.dnd
      : Colors.offline;

    // Type detection properties
    property <bool> is-channel: conversation-kind == ConversationKind.channel;
    property <bool> is-private: is-channel && private-channel;
    property <bool> is-dm: conversation-kind == ConversationKind.server-dm
        || conversation-kind == ConversationKind.mesh-dm;
    property <bool> is-anon-dm: conversation-kind == ConversationKind.anon-dm;
    property <bool> is-private-group: conversation-kind == ConversationKind.anon-group;
    property <bool> is-saved: conversation-kind == ConversationKind.saved-messages;

    // No conversation open → suppress all conversation-scoped actions.
    // Name is the reliable signal: anon DMs and saved messages can have
    // synthetic / empty channel-id but always carry a name when opened,
    // while nothing is set on app start before the user picks a chat.
    property <bool> has-channel: channel-name != "";

    // Show settings for regular channels and private groups, not for anon DMs or saved messages
    property <bool> show-settings: has-channel && ((!is-anon-dm && !is-saved) || is-private-group) && !is-mesh;

    // A mesh conversation is open. Calls, invites and channel settings are all
    // server operations; offering them over a transport that reaches no server
    // would be offering something that cannot happen.
    property <bool> is-mesh: MeshGlobal.active-id != "";

    // Whether the trailing button group will draw anything. Mirrors the three
    // `if`s on that group exactly; used by the mesh divider above it, which
    // otherwise hangs off the right edge with nothing to separate.
    property <bool> has-utility-actions:
        root.show-invite || root.show-more;
    // The pin only brings back a dismissed pinned bar (`pinned-show-clicked`),
    // so it exists only while that bar is hidden. Always-on, it duplicated the
    // bar and its extra box cut a phone title to five characters.
    property <bool> show-pin: false;

    // Mesh status wording. Kept here rather than in the strip below because this
    // is where it is now shown; the strip's remaining line is the one that has to
    // wrap, and these are the ones that must not.
    // Narrow enough that the header has to give something up.
    //
    // What it gives up is the standing claim and the word next to the switch, not
    // the conversation name: on a phone the mesh line squeezed "#mesh" down to
    // "#m…" while "No server, no inte…" kept its space, which is backwards. The
    // peer count stays because it is the connectivity signal, and the switch stays
    // because it is a control.
    property <bool> mesh-tight: root.width < 520px;
    // Narrow header. At 411dp minus the sidebar rail there is room for the
    // conversation name OR for every secondary action, not both — and the name
    // is what tells you where you are, so the actions yield. Both of the ones
    // dropped here stay reachable from channel settings (the kebab).
    property <bool> tight: root.width < 420px;
    property <bool> mesh-radio-down: !MeshGlobal.radio-running;
    property <string> mesh-standing:
        MeshGlobal.active-kind == "geohash"
            ? (MeshGlobal.relay-count == 0
                ? "Public cell · no relay"
              : MeshGlobal.relay-count == 1
                ? "Public cell · 1 relay"
                : "Public cell · " + MeshGlobal.relay-count + " relays")
      : !MeshGlobal.mesh-on
            ? "Mesh off"
            : "No server, no internet";
    property <string> mesh-peers:
        !MeshGlobal.mesh-on ? "radio stopped"
      : root.mesh-radio-down
            ? (MeshGlobal.radio-down == "bluetooth-off" ? "Bluetooth off" : "mesh unavailable")
      : MeshGlobal.peer-count == 0 ? "none nearby"
      : MeshGlobal.peer-count == 1 ? "1 nearby"
      : MeshGlobal.peer-count + " nearby";

    // Show invite button for channels and private groups only (not DMs, anon DMs, or saved)
    property <bool> show-invite: has-channel && !tight && !is-dm && !is-anon-dm && !is-saved && !is-mesh;

    // Show call buttons for everything except saved messages
    property <bool> show-calls: has-channel && !is-saved && !is-mesh && !read-only;
    // ⋯ holds Video call (owner, 2026-10-05: out of the header row, into the
    // menu) and Conversation settings, so it is there when either is.
    // Saved always has its pinned list (the only row its menu has), so the
    // overflow is reachable there before the first pin.
    property <bool> show-more: root.show-calls || root.show-settings || root.has-any-pinned || root.is-saved;

    // "Touch input", plumbed from ChatLayout. The 52px/28px/18px set below is
    // mouse density; on a phone this is the bar you navigate the whole app from
    // and it read as a strip of small grey furniture above a 72px conversation
    // list. Touch gets the proportions a native messenger header actually uses.
    in property <bool> mobile: false;
    // Both from Spacing: on desktop this row and the panel's first row beside
    // it are the same row across the seam, so they read one number.
    property <length> header-height: root.mobile ? Spacing.header-height-touch : Spacing.header-height;
    property <length> header-avatar: root.mobile ? 40px : 28px;
    // Every button in this row is the shared HeaderButton (touch: mobile), so
    // back, call, pin and ⋯ are one box and one glyph on one axis.
    // Signal's ~20sp title; xl elided "Carol Sweep" to "Carol …" on a phone.
    property <length> header-title-size: Typography.lg;

    // Leading clearance for the macOS traffic lights, from app.slint. Nonzero
    // only when the sidebar beside this is too narrow to cover them itself
    // (the rail), and 0 on every other platform.
    in property <length> leading-inset: 0px;

    // The shared material carries the header above plain conversation content.
    // 52px is a 44px touch row plus 4px of air above and below; the old 56px was
    // that plus a spare row of nothing, repeated at the top of every
    // conversation.
    height: root.header-height;
    HorizontalLayout {
        // Constrain to the header width so the name elides instead of growing
        // the whole chat column past the screen (which clipped the composer's
        // Send button in channels/groups, where the header has more icons).
        width: 100%;
        padding-left: Spacing.sm + root.leading-inset;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        // No `alignment` here, and none on the left section below. Under any
        // alignment other than stretch, Slint sizes every child to its preferred
        // width and turns the leftover into gaps between them — horizontal-stretch
        // is never consulted (i-slint-core layout.rs, solve_box_layout). So the
        // name could only ever shrink, never grow into the space beside it, and
        // on a phone it elided to one character ("# j…") with a wide gap to its
        // right. Stretching hands that space to the child that asked for it.

        // Left section: Back button + Icon + Name
        HorizontalLayout {
            spacing: Spacing.sm;
            horizontal-stretch: 1;
            min-width: 0px;

            // Mobile back button (returns to chat list)
            if root.show-back-button: HeaderButton {
                touch: root.mobile;
                backdrop-paused: root.backdrop-paused;
                icon: Icons.chevron-left;
                label: "Back";
                clicked => { root.back-clicked(); }
            }

            // Single leading icon per conversation type — no standalone
            // "encrypted" shield (E2E is already implied by the purple shield
            // on anon / private-group chats and by app-wide guarantees).
            //
            //   has-avatar     → channel icon (overrides the type glyph)
            //   public         → `#`          (muted)
            //   private        → lock         (muted) — invite-only channel
            //   dm             → initials avatar + dot (peer presence)
            //   anon-dm        → purple shield
            //   private-group  → purple shield
            //   saved          → bookmark

            // The peer's picture replaces the type glyph — but not the presence
            // dot. A DM whose peer had uploaded an avatar was the one DM that
            // never showed presence anywhere in the header, because the dot
            // lived inside the `@` block this branch skips. Avatar already
            // draws the dot; this is that same idiom, not a second one.
            if root.has-avatar: Avatar {
                size: root.header-avatar;
                source: root.avatar-source;
                anonymous: is-anon-dm || is-private-group;
                y: (parent.height - self.height) / 2;
                show-presence: root.is-dm;
                presence-color: root.presence-dot;
            }

            // Mesh rooms are their own kind, not a channel, and their names
            // already carry the mark: core labels them "#mesh" and
            // "#<geohash>" (services/mesh/timeline.rs), so the header draws no
            // "#" of its own ("# #mesh"). `is-mesh` stays as a second guard.
            if has-channel && !root.has-avatar && is-channel && !is-private && !root.is-mesh: Text {
                text: "#";
                color: Colors.text-muted;
                font-size: root.header-title-size;
                vertical-alignment: center;
            }

            // Private channels: muted lock. A teal dot here read as presence.
            if has-channel && !root.has-avatar && is-private: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                Image {
                    source: Icons.lock;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-muted;
                }
            }

            // No picture: the peer's initials, as the chat list draws them —
            // a bare `@` read as "unknown account".
            if has-channel && !root.has-avatar && is-dm: Avatar {
                size: root.header-avatar;
                name: root.channel-name;
                y: (parent.height - self.height) / 2;
                show-presence: true;
                presence-color: root.presence-dot;
            }

            if has-channel && !root.has-avatar && (is-anon-dm || is-private-group): Avatar {
                size: root.header-avatar;
                name: root.channel-name;
                anonymous: true;
                y: (parent.height - self.height) / 2;
            }

            if has-channel && !root.has-avatar && is-saved: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                Image {
                    source: Icons.bookmark;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.primary;
                }
            }

            // Channel/conversation name (stretches to fill, then elides).
            // min-width: 0 so a long name shrinks/elides instead of forcing the
            // header — and the whole chat column — wider than the screen. The
            // stretch lives on the wrapper so the Text keeps eliding inside it.
            //
            // Tapping the name opens the conversation's own screen — the peer's
            // profile for a DM, channel settings for a channel — which is the
            // same thing the kebab does and where a user reaches for it first.
            // Anon DMs and saved messages have no such screen (`show-settings`
            // is false for both), so there the name is not a target.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                VerticalLayout {
                    width: 100%;
                    alignment: center;
                    Text {
                        text: root.channel-name;
                        color: name-touch.has-hover ? Colors.primary : Colors.text-primary;
                        font-size: root.header-title-size;
                        font-weight: Typography.semibold;
                        min-width: 0px;
                        overflow: elide;
                    }
                    // Typing shares the title's bounded column, so long peer
                    // names yield to the call buttons instead of drawing over them.
                    if root.typing-indicator != "" && !(JarvisGlobal.enabled && root.jarvis-thinking): Text {
                        // The peer is already named above; preserve the status verb on narrow DMs.
                        text: root.mobile && root.is-dm ? "Typing…" : root.typing-indicator;
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        font-italic: true;
                        min-width: 0px;
                        overflow: elide;
                    }
                    // Keep member count in the title column at every width.
                    if root.typing-indicator == "" && has-channel && !root.read-only && (is-channel || is-private-group) && member-count > 0: Text {
                        // The public badge (core-worded) rides on the count
                        // line, so every open public channel says it.
                        text: (root.member-count == 1 ? "1 member" : "\{root.member-count} members")
                            + (root.is-channel && MembershipGlobal.public-badge != "" ? " \u{b7} " + MembershipGlobal.public-badge : "");
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        overflow: elide;
                    }
                }
                name-touch := TouchArea {
                    enabled: root.show-settings;
                    mouse-cursor: pointer;
                    clicked => { root.settings-clicked(); }
                }
            }

            // Mesh status, inline. The strip below the header used to carry three
            // lines of this; on a phone that was most of the space above the
            // first message. The facts that are short enough to sit on one line
            // live here now, and the strip keeps only the sentence that cannot
            // be shortened without changing what it says.
            //
            // The peer count is last and never elided: it is the connectivity
            // signal for this feature, and the part before it is context.
            if root.is-mesh: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: center;
                min-width: 0px;
                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: Colors.divider;
                    y: (parent.height - self.height) / 2;
                }
                if !root.mesh-tight: Text {
                    text: root.mesh-standing;
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if !root.mesh-tight: Text {
                    text: "·";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.mesh-peers;
                    color: root.mesh-radio-down ? Colors.warning : Colors.text-muted;
                    font-size: Typography.xs;
                    font-weight: root.mesh-radio-down ? 600 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
        }

        // Center section: Topic / Jarvis — only when there is something to put
        // in it. An unconditional centre claimed width in the middle of the row
        // and then drew nothing, which is the gap the name beside it was eliding
        // to make room for.
        // A phone has no width for the topic beside the name: it elided to a lone
        // muted "…". Typing lives under the title; Jarvis still shows here.
        if (root.topic != "" && !root.mobile && root.typing-indicator == "") || (JarvisGlobal.enabled && root.jarvis-thinking): Rectangle {
            horizontal-stretch: 1;
            // Topic text
            if root.topic != "" && !root.mobile && root.typing-indicator == "" && !(JarvisGlobal.enabled && root.jarvis-thinking): Text {
                width: 100%;
                text: root.topic;
                color: Colors.text-muted;
                font-size: Typography.sm;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // Jarvis thinking
            if JarvisGlobal.enabled && root.jarvis-thinking: HorizontalLayout {
                spacing: Spacing.sm;
                alignment: center;
                for i in [0, 1, 2]: Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Colors.primary;
                    y: (parent.height - self.height) / 2 + 2px * Math.sin((animation-tick() / 250ms + i * 0.3) * 360deg);
                }
                Text {
                    text: "Jarvis is thinking...";
                    font-size: Typography.sm;
                    font-italic: true;
                    color: Colors.primary;
                    vertical-alignment: center;
                }
            }
        }

        // Right section: Action buttons. stretch 0 so the row's spare width goes
        // to the name rather than being split with a group of fixed-size icons;
        // being the last child, it still ends flush with the right edge.
        HorizontalLayout {
            // One gap between every pair of header buttons, in every header.
            spacing: Spacing.header-action-gap;
            alignment: end;
            horizontal-stretch: 0;

            // Call buttons group
            if root.show-calls: HorizontalLayout {
                spacing: Spacing.header-action-gap;
                alignment: center;
                HeaderButton {
                    touch: root.mobile;
                    backdrop-paused: root.backdrop-paused;
                    icon: Icons.phone;
                    label: "Voice call";
                    clicked => { root.voice-call-clicked(); }
                }
                // Divider — wide screens only. At 411dp it draws a line between
                // two things the eye already reads as separate, in the one place
                // on the screen with the least room for a decoration.
                if !root.tight: Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Colors.divider;
                    y: (parent.height - self.height) / 2;
                }
            }

            // The mesh switch, where the mesh is — not in a settings screen the
            // user would have to leave the conversation to find, and would have
            // to reach through a working app in exactly the situation the mesh
            // exists for. Off stops the radio; the conversations stay listed and
            // readable, because they are messages that already arrived.
            if root.is-mesh: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: center;
                // Always labelled. This used to be dropped below 520px, which
                // left an unexplained pill switch in the corner of the one
                // screen where flipping the wrong thing costs the user their
                // only transport. "Mesh" is four characters; what the narrow
                // header gives up is the standing claim beside the title, which
                // is a sentence, not this.
                Text {
                    text: "Mesh";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }
                // Wrapped and centred, the same way the header's other fixed-size
                // children are: the toggle has its own height, and left to the
                // row it rides above the text it belongs to.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    NeoActionToggle {
                        checked: MeshGlobal.mesh-on;
                        glow-mode: "cyan";
                        accessible-text: "Bluetooth mesh";
                        toggled(value) => { MeshGlobal.set-mesh-on(value); }
                    }
                }
                // Separates the switch from the utility buttons — and only when
                // there are any. In a mesh conversation invite, pin and settings
                // are all suppressed (they are server operations), so this drew a
                // rule against the right edge with nothing on the other side of
                // it. A divider that divides one thing from nothing is a smudge.
                if root.has-utility-actions: Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Colors.divider;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Utility buttons group
            HorizontalLayout {
                spacing: Spacing.header-action-gap;
                alignment: center;
                if root.show-invite: HeaderButton {
                    touch: root.mobile;
                    backdrop-paused: root.backdrop-paused;
                    icon: Icons.user-plus;
                    label: "Invite";
                    clicked => { root.invite-clicked(); }
                }
                if root.show-more: HeaderButton {
                    touch: root.mobile;
                    backdrop-paused: root.backdrop-paused;
                    icon: Icons.more-vertical;
                    label: "More options";
                    clicked => { root.more-clicked(root.show-calls, root.show-settings); }
                }
            }
        }
    }


}
