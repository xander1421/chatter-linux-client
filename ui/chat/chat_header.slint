// Chat header component
//
// Displays channel information, topic, and action buttons.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Data struct for chat header (mirrors Rust ChatHeaderData)
export struct ChatHeaderData {
    channel-id: string,
    channel-name: string,
    channel-type: string,  // "public", "private", "dm"
    member-count: int,
    topic: string,
    is-archived: bool,
    typing-indicator: string,
}

// Reusable icon button component
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Colors.text-secondary;
    in property <color> hover-color: Colors.text-primary;
    callback clicked();

    width: 32px;
    height: 32px;
    background: touch.has-hover ? Colors.surface-hover : transparent;
    border-radius: Spacing.radius-sm;

    Image {
        source: icon;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: touch.has-hover ? hover-color : icon-color;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ChatHeader inherits Rectangle {
    // Properties from ChatHeaderData
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <string> channel-type: "public";  // "public", "private", "dm"
    in property <int> member-count: 0;
    in property <string> topic: "";
    in property <bool> is-archived: false;
    in property <string> typing-indicator: "";

    // Callbacks
    callback search-clicked();
    callback settings-clicked();
    callback voice-call-clicked();
    callback video-call-clicked();

    property <bool> show-member-count: channel-type != "dm" && member-count > 0;
    property <bool> is-private: channel-type == "private";
    property <bool> is-dm: channel-type == "dm";

    // Layout
    height: 56px;
    background: Colors.surface;

    // Main content
    HorizontalLayout {
        padding-left: Spacing.lg;
        padding-right: Spacing.lg;
        spacing: Spacing.md;

        // Left section: Channel icon and name
        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: start;

            // Channel icon - text for # and @, image for lock
            if !is-private: Text {
                text: is-dm ? "@" : "#";
                color: Colors.text-muted;
                font-size: Typography.lg;
                vertical-alignment: center;
            }

            if is-private: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: Icons.lock;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-muted;
                }
            }

            // Channel name (constrained width so typing indicator has space)
            Text {
                text: root.channel-name;
                color: Colors.text-primary;
                font-size: Typography.base;
                font-weight: Typography.semibold;
                vertical-alignment: center;
                max-width: 250px;
                overflow: elide;
            }

            // Archived badge
            if root.is-archived: Rectangle {
                height: 18px;
                width: archived-text.preferred-width + 8px;
                background: Colors.text-muted;
                border-radius: 4px;

                archived-text := Text {
                    x: 4px;
                    text: "Archived";
                    color: Colors.surface;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }
            }

            // Member count
            if root.show-member-count: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: center;

                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: Colors.text-muted;
                }

                Text {
                    text: "\{root.member-count} members";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
            }
        }

        // Center section: Topic (flex)
        Rectangle {
            horizontal-stretch: 1;

            // Topic text (truncated)
            if root.topic != "" && root.typing-indicator == "": Text {
                width: 100%;
                text: root.topic;
                color: Colors.text-muted;
                font-size: Typography.sm;
                overflow: elide;
                vertical-alignment: center;
            }

            // Typing indicator (takes precedence over topic)
            if root.typing-indicator != "": HorizontalLayout {
                spacing: Spacing.xs;
                alignment: start;

                Text {
                    text: root.typing-indicator;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-italic: true;
                    vertical-alignment: center;
                }
            }
        }

        // Right section: Action buttons
        HorizontalLayout {
            spacing: Spacing.xs;
            alignment: end;

            // Call buttons group
            HorizontalLayout {
                spacing: Spacing.xs;

                // Phone icon slightly smaller
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: phone-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;

                    Image {
                        source: Icons.phone;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: phone-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                    }

                    phone-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.voice-call-clicked(); }
                    }
                }

                IconButton {
                    icon: Icons.video;
                    clicked => { root.video-call-clicked(); }
                }
            }

            // Divider between button groups
            Rectangle {
                width: 1px;
                height: 20px;
                background: Colors.text-muted.with-alpha(0.3);
            }

            // Utility buttons group
            HorizontalLayout {
                spacing: Spacing.xs;

                IconButton {
                    icon: Icons.search;
                    clicked => { root.search-clicked(); }
                }

                IconButton {
                    icon: Icons.settings;
                    clicked => { root.settings-clicked(); }
                }
            }
        }
    }

    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Colors.surface-hover;
    }
}
