import { Colors } from "theme/colors.slint";
import { AvatarOption } from "components/avatar_picker.slint";
import { ChatRowData } from "sidebar/chat_list.slint";
import { CustomSectionData, SidebarRowData } from "sidebar/custom_section_list.slint";
import { MessageItemData, MessageAttachmentData, PendingAttachmentData, ReactionEntry } from "chat/chat_layout.slint";
import { ConversationKind } from "chat/conversation_kind.slint";
import { EmojiData } from "components/emoji_picker.slint";
import { GifData } from "components/gif_picker.slint";
import { MentionSuggestion } from "components/mention_autocomplete.slint";
import { AIProviderOption, AIModelOption, CreateChannelConfig, PrivateGroupFriend } from "modals/create_channel.slint";
import { SharedContentItem, SharedTab } from "modals/mod.slint";
import { FriendData, FriendRequestData, BlockedUserData } from "modals/friends.slint";
import { ForwardTarget } from "modals/forward_message.slint";
import { SessionInfo, PendingLinkInfo } from "modals/sessions.slint";
import { SearchResultChannel } from "modals/join_channel.slint";
import { ChannelMemberData, BannedMemberData } from "modals/channel_member_types.slint";
import { InviteUser } from "modals/invite_member.slint";
import { QuickSwitcherItem, SearchResult, CalendarDay } from "components/unified_search.slint";
import { PinnedItem } from "modals/pinned_messages.slint";
import { MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData } from "modals/jarvis_memory.slint";
import { IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, CallHistoryRow } from "calls/mod.slint";

export global SidebarPane {
    // ========== Sidebar properties ==========
    in property <[ChatRowData]> chat-rows: [];
    in property <[ChatRowData]> archived-rows: [];
    in-out property <bool> archive-open: false;
    in-out property <bool> chat-rows-loading: true;
    in property <[CustomSectionData]> custom-sections: [];
    in property <[SidebarRowData]> flat-rows: [];
    in property <int> total-unread-count: 0;
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    // Manual presence mode chosen in the status picker ("auto" default).
    in-out property <string> user-presence-mode: "auto";
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> sidebar-hidden: false;
    in-out property <int> sidebar-focus-index: 0;
    in-out property <bool> row-context-menu-open: false;
    in-out property <bool> section-context-menu-open: false;
    in-out property <bool> row-context-menu-muted: false;
    // Window-level sidebar menu anchors and selected row.
    in-out property <length> ctx-menu-x: 0px;
    in-out property <length> ctx-menu-y: 0px;
    in-out property <length> ctx-menu-row-y: 0px;
    in-out property <ChatRowData> ctx-menu-row;
    in-out property <string> ctx-menu-conv-id: "";
    in-out property <ConversationKind> ctx-menu-conv-type;
    in-out property <string> ctx-menu-current-section-id: "";
    in-out property <bool> ctx-menu-is-pinned: false;
    in-out property <bool> ctx-menu-is-archived: false;
    in-out property <bool> ctx-menu-can-leave: false;
    in-out property <bool> ctx-menu-can-delete-channel: false;
    in-out property <length> section-header-ctx-menu-x: 0px;
    in-out property <length> section-header-ctx-menu-y: 0px;
    in-out property <string> section-header-ctx-menu-section-id: "";
    in-out property <string> section-header-ctx-menu-sort-mode: "recent";
    // The current top-level destination: "chats", "mesh", "calls", "contacts" or
    // "profile" (the account menu). Separate from `modal-stack` below — a
    // screen pushed over a tab (someone's profile, Settings, Sessions) never
    // changes which tab you are on, so the bar's highlight and Back both stay
    // truthful. On a two-pane layout the sidebar's Calls / Contacts / avatar
    // select it.
    // Navigation rules: crates/chatter-ui/src/bin_ui/features/back.rs.
    in-out property <string> active-tab: "chats";
    // Single-pane routing on mobile: false = conversation list, true = the
    // conversation itself. The two are mutually exclusive and each takes the
    // whole width — there is no rail beside them, because the bottom tab bar
    // is what keeps navigation always-available now. Desktop ignores this
    // entirely and keeps the side-by-side panel it has always had.
    in-out property <bool> mobile-show-chat: false;
    in-out property <bool> chat-edge-swiping: false;
    in-out property <length> chat-edge-start: 0px;
    // ========== Sidebar callbacks ==========
    callback channel-selected(string);
    callback refresh-channel-call();
    callback dm-selected(string);
    callback private-group-selected(string);
    callback saved-messages-clicked();
    callback navigate-chat(int /* 1 next, -1 previous */);
    callback sidebar-focus-target(int /* current */, int /* move */, bool /* mobile */, bool /* shield */, bool /* requests */) -> int;
    callback settings-clicked();
    callback profile-clicked();
    callback change-user-status(string /* status */);
    pure callback get-user-status() -> string;
    callback toggle-sidebar();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ ConversationKind);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ ConversationKind, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);
    callback set-conversation-pinned(/* conversation-id */ string, /* pinned */ bool);
    callback set-conversation-archived(/* conversation-id */ string, /* archived */ bool);
    callback row-context-menu-opened(/* conversation-id */ string, /* kind */ ConversationKind);
    callback set-conversation-muted(/* conversation-id */ string, /* kind */ ConversationKind, /* muted */ bool);
    callback mark-conversation-read(/* conversation-id */ string, /* kind */ ConversationKind);
    callback mark-conversation-unread(/* conversation-id */ string, /* kind */ ConversationKind);
    callback archive-view-changed();
    callback delete-conversation(/* conversation-id */ string, /* kind */ ConversationKind);
    callback leave-conversation(/* conversation-id */ string, /* kind */ ConversationKind);
    callback move-section(/* section-id */ string, /* delta */ int);
    callback set-section-sort-mode(/* section-id */ string, /* mode */ string);
}
