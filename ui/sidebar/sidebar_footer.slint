import { DesktopChrome } from "../theme/desktop_chrome.slint";
import { JarvisGlobal } from "../jarvis/jarvis_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { HeaderButton } from "../components/header_button.slint";
import { KeyFocus } from "../components/key_focus.slint";
import { ActivityUi } from "../activity/activity_bell.slint";
import { ActivityGlobal } from "../activity/activity_global.slint";
import { GlassSurface } from "../components/glass_surface.slint";
import { Appearance } from "../theme/appearance.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { Avatar } from "../components/avatar.slint";
import { AnonMode, TorStatus } from "../anon_mode/anon_mode_global.slint";

// Shield works without Tor. Only the network status dot needs onion support.
export component SidebarShieldToggle inherits HeaderButton {
    plain: true;
    control-radius: Spacing.radius-control;
    control-fill: AnonMode.enabled ? Colors.accent-purple.with-alpha(0.16) : transparent;
    icon-color: AnonMode.enabled ? Colors.accent-purple : Colors.text-secondary;
    icon: Icons.onion;
    label: AnonMode.enabled ? @tr("Shield on - tap to turn off") : @tr("Shield off - tap to turn on");

    Rectangle {
        visible: AnonMode.enabled && AnonMode.onion-built;
        width: 8px;
        height: self.width;
        border-radius: self.width / 2;
        x: (parent.width + root.glyph) / 2 - self.width * 0.75;
        y: (parent.height - root.glyph) / 2 - self.height * 0.25;
        border-width: 1px;
        border-color: Colors.surface;
        background: TorStatus.state == 2 ? Colors.success
            : TorStatus.state >= 3 ? Colors.error
            : TorStatus.state == 1 ? Colors.warning
            : Colors.text-muted;
    }
}

export component SidebarFooter inherits GlassSurface {
    in property <length> panel-width;
    in property <length> panel-height;
    in property <bool> collapsed;
    in property <bool> touch;
    in property <bool> mesh-available;
    in property <string> active-tab;
    in property <int> rail-button-count;
    in property <length> rail-gap;
    in property <length> rail-divider-height;
    in property <length> rail-footer-height;
    in property <length> rail-icon-size;
    in property <length> rail-slot-size;
    in property <length> rail-slot-radius;
    in property <brush> rail-slot-bg;
    in property <length> footer-icon-size;
    in property <image> user-avatar-source;
    in property <string> user-initials;
    in property <string> user-presence-status;
    in property <string> user-display-name;
    in property <bool> server-unreachable;
    in property <int> missed-call-count;
    private property <bool> ai-available: JarvisGlobal.enabled && JarvisGlobal.opted-in;
    private property <int> expanded-slot-count: 6 + (root.touch ? 1 : 0)
        + (root.mesh-available ? 1 : 0) + (root.ai-available ? 1 : 0);
    private property <length> expanded-gap: 6px;
    private property <length> expanded-slot-width: clamp(
        (root.panel-width - 2 * Spacing.sm - root.expanded-slot-count * root.expanded-gap)
            / root.expanded-slot-count, 0px, root.touch ? root.footer-icon-size : 32px);
    callback profile-clicked();
    callback friends-clicked();
    callback calls-clicked();
    callback settings-clicked();
    callback toggle-collapsed();
    callback anon-mode-clicked();
    callback channel-selected(string);
    callback tab-selected(string);

            // Bound backdrop and shadow painting to this chrome silhouette.
            clip: true;
            x: 0;
            width: root.panel-width;
            // Expanded: one gutter up, level with the composer island that
            // sits one gutter inside the chat container.
            y: root.panel-height - self.height - (root.collapsed ? 0px : Spacing.panel-gutter);
            material-level: 2;
            material-tint: root.collapsed || Appearance.glass-effects ? Materials.regular : Colors.surface-card;
            material-enabled: !DesktopChrome.macos;
            background: !root.collapsed && DesktopChrome.macos ? Colors.surface-card : transparent;
            border-radius: root.collapsed ? Spacing.radius-chrome : 12px;
            show-edge: !DesktopChrome.macos;
            elevation: DesktopChrome.macos ? 0 : 3;

            // The list reservation and footer use the same stack height.
            height: root.collapsed
                ? !root.touch || DesktopChrome.macos ? root.rail-footer-height
                    : root.rail-button-count * root.rail-icon-size
                        + (root.rail-button-count - 1) * 8px + 16px + Spacing.md + 8px
                : Spacing.composer-bar-height;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: root.expanded-gap;

                Rectangle {
                    width: root.expanded-slot-width;
                    accessible-role: button;
                    accessible-label: @tr("Profile");
                    accessible-action-default => { root.profile-clicked(); }
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                size: min(root.expanded-slot-width, root.touch ? 30px : 24px);
                                source: root.user-avatar-source;
                                fallback-text: root.user-initials;
                                alt-name: root.user-display-name;
                                show-presence: true;
                                presence-color: root.user-presence-status == "online" ? Colors.online
                                    : root.user-presence-status == "away" ? Colors.away
                                    : root.user-presence-status == "dnd" ? Colors.dnd : Colors.offline;
                            }
                        }
                    }
                    KeyFocus { border-radius: Spacing.sm; activate => { root.profile-clicked(); } }
                    TouchArea { mouse-cursor: pointer; clicked => { root.profile-clicked(); } }
                }
                Rectangle { horizontal-stretch: 1; }
                HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: AnonMode.enabled ? Icons.user-plus : Icons.users;
                    label: AnonMode.enabled ? @tr("Add contact") : @tr("Friends");
                    clicked => { root.friends-clicked(); }
                }
                HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: Icons.phone;
                    label: root.missed-call-count > 0 ? @tr("Calls, {} missed", root.missed-call-count) : @tr("Calls");
                    clicked => { root.calls-clicked(); }

                    if root.missed-call-count > 0: Rectangle {
                        x: parent.width - self.width;
                        height: Spacing.badge-sm;
                        width: self.height + (root.missed-call-count > 9 ? Spacing.xs : 0px);
                        border-radius: self.height / 2;
                        background: Colors.error-hover;
                        Text {
                            text: root.missed-call-count > 9 ? "9+" : root.missed-call-count;
                            color: Colors.on-error;
                            font-size: Typography.xs2;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.mesh-available: HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: root.active-tab == "mesh" ? Icons.message-circle : Icons.radio;
                    label: root.active-tab == "mesh" ? @tr("Chats") : @tr("Mesh");
                    clicked => { root.tab-selected(root.active-tab == "mesh" ? "chats" : "mesh"); }
                }
                if root.ai-available: HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: Icons.jarvis;
                    label: @tr("AI");
                    // The virtual assistant channel uses the nil UUID.
                    clicked => { root.channel-selected("00000000-0000-0000-0000-000000000000"); }
                }
                HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: Icons.bell;
                    label: ActivityGlobal.unread-count > 0 ? @tr("Activity, {} unread", ActivityGlobal.unread-count) : @tr("Activity");
                    clicked => { ActivityUi.open(); }

                    if root.server-unreachable || ActivityGlobal.unread-count > 0: Rectangle {
                        x: parent.width - self.width - 1px;
                        y: 1px;
                        width: 7px;
                        height: self.width;
                        border-radius: self.width / 2;
                        border-width: 1px;
                        border-color: Colors.surface;
                        background: root.server-unreachable ? Colors.error : Colors.primary;
                        accessible-role: text;
                        accessible-label: root.server-unreachable ? @tr("Server unreachable") : @tr("New activity");
                    }
                }
                SidebarShieldToggle {
                    width: root.expanded-slot-width;
                    glyph: 16px;
                    clicked => { root.anon-mode-clicked(); }
                }
                HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: Icons.settings;
                    label: @tr("Settings");
                    clicked => { root.settings-clicked(); }
                }
                if root.touch: HeaderButton {
                    width: root.expanded-slot-width;
                    plain: true;
                    glyph: 16px;
                    icon: Icons.chevron-left;
                    label: @tr("Collapse sidebar");
                    clicked => { root.toggle-collapsed(); }
                }
            }

            // Collapsed view: Vertical stack of icons
            if root.collapsed: VerticalLayout {
                alignment: end; spacing: root.rail-gap; padding-bottom: Spacing.sm;
                // Keep the legacy touch rail shortcut.
                if root.touch: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: AnonMode.enabled ? @tr("Anon mode (active) - tap to disable") : @tr("Anon mode");
                    tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size;
                        accessible-role: button; accessible-label: @tr("Anon mode");
                        accessible-action-default => { root.anon-mode-clicked(); }
                        border-width: rail-anon-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                        rail-anon-keys := FocusScope { width: 0px; height: 0px;
                            key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.anon-mode-clicked(); return accept; } return reject; }
                        }
                        height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                        background: AnonMode.enabled ? Colors.row-selected : root.rail-slot-bg;
                        Image { source: Icons.onion; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: AnonMode.enabled ? Colors.selected-indicator : Colors.text-secondary; }
                        // Tor status dot: green=connected, amber=CONNECTING ONLY,
                        // red=error, muted=off. As in the expanded footer.
                        Rectangle {
                            visible: AnonMode.enabled && AnonMode.onion-built;
                            width: 10px; height: 10px; border-radius: 5px;
                            x: parent.width - self.width - 2px; y: 2px;
                            border-width: 1px; border-color: Colors.surface;
                            background: TorStatus.state == 2 ? Colors.success
                                : TorStatus.state >= 3 ? Colors.error
                                : TorStatus.state == 1 ? Colors.warning
                                : Colors.text-muted;
                        }
                        TouchArea { clicked => { root.anon-mode-clicked(); } }
                    } }
                }
                // Bottom cluster, in order: AI, Chats, Mesh, Activity, then
                // profile, Settings, expand.
                if root.touch && root.ai-available: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: @tr("AI"); tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size;
                        accessible-role: button; accessible-label: "AI";
                        accessible-action-default => { root.channel-selected("00000000-0000-0000-0000-000000000000"); }
                        border-width: rail-ai-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                        rail-ai-keys := FocusScope { width: 0px; height: 0px;
                            key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.channel-selected("00000000-0000-0000-0000-000000000000"); return accept; } return reject; }
                        }
                        height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: Icons.jarvis; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        // The virtual assistant channel's fixed id is the nil UUID
                        // (chatter-core client/jarvis.rs jarvis_channel_id).
                        TouchArea { clicked => { root.channel-selected("00000000-0000-0000-0000-000000000000"); } }
                    } }
                }

                if root.touch && root.mesh-available: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: @tr("Mesh"); tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size;
                        accessible-role: button; accessible-label: @tr("Mesh");
                        accessible-action-default => { root.tab-selected("mesh"); }
                        border-width: rail-mesh-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                        rail-mesh-keys := FocusScope { width: 0px; height: 0px;
                            key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.tab-selected("mesh"); return accept; } return reject; }
                        }
                        height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.active-tab == "mesh" ? Colors.row-selected : root.rail-slot-bg;
                        Image { source: Icons.radio; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: !MeshGlobal.radio-running ? Colors.warning
                                : MeshGlobal.peer-count > 0 ? Colors.primary
                                : Colors.text-secondary; }
                        TouchArea { clicked => { root.tab-selected("mesh"); } }
                    } }
                }

                // Activity, as in the expanded footer: the rail had no way in.
                if root.touch: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: @tr("Activity"); tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size;
                        accessible-role: button;
                        accessible-label: ActivityGlobal.unread-count > 0 ? @tr("Activity, {} unread", ActivityGlobal.unread-count) : @tr("Activity");
                        accessible-action-default => { ActivityUi.open(); }
                        border-width: rail-bell-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                        rail-bell-keys := FocusScope { width: 0px; height: 0px;
                            key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { ActivityUi.open(); return accept; } return reject; }
                        }
                        height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: Icons.bell; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        if ActivityGlobal.unread-count > 0: Rectangle {
                            x: parent.width - self.width - 4px; y: 4px;
                            width: 8px; height: 8px; border-radius: 4px;
                            border-width: 1px; border-color: Colors.surface;
                            background: Colors.primary;
                        }
                        TouchArea { clicked => { ActivityUi.open(); } }
                    } }
                }

                // A visible seam between list destinations and the panel
                // controls below. Several identical unlabeled slots
                // in one unbroken stack read as one big undifferentiated
                // block; a hairline plus extra breathing room lets the eye
                // parse two small groups instead, without hiding anything.
                if root.touch: Rectangle {
                    height: root.rail-divider-height;
                    Rectangle {
                        y: parent.height / 2;
                        width: root.rail-slot-size * 0.6;
                        x: (parent.width - self.width) / 2;
                        height: 1px;
                        background: Colors.divider;
                    }
                }

                // Same order as the expanded footer (profile … settings,
                // collapse): the chevron is last in both, so it does not jump
                // to the middle of the cluster when the panel collapses.
                if root.touch: Rectangle {
                    height: root.rail-icon-size;
                    accessible-role: button; accessible-label: @tr("Profile");
                    accessible-action-default => { root.profile-clicked(); }
                    border-width: rail-profile-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                    rail-profile-keys := FocusScope { width: 0px; height: 0px;
                        key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.profile-clicked(); return accept; } return reject; }
                    }
                    TouchArea { clicked => { root.profile-clicked(); } }
                    HorizontalLayout { alignment: center;
                        Avatar { size: DesktopChrome.macos ? 32px : 40px; source: root.user-avatar-source; fallback-text: root.user-initials; alt-name: root.user-display-name; show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online : root.user-presence-status == "away" ? Colors.away : root.user-presence-status == "dnd" ? Colors.dnd : Colors.offline;
                        }
                    }
                }
                if root.touch: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2; tooltip-text: @tr("Settings"); tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size;
                        accessible-role: button; accessible-label: @tr("Settings");
                        accessible-action-default => { root.settings-clicked(); }
                        KeyFocus { border-radius: parent.border-radius; activate => { root.settings-clicked(); } }
                        border-width: rail-settings-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                        rail-settings-keys := FocusScope { width: 0px; height: 0px;
                            key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.settings-clicked(); return accept; } return reject; }
                        }
                        height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: Icons.settings; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        if root.server-unreachable: Rectangle {
                            x: parent.width - self.width - 1px; y: 1px;
                            width: 7px; height: 7px; border-radius: 3.5px;
                            border-width: 1px; border-color: Colors.surface;
                            background: Colors.error;
                            accessible-role: text;
                            accessible-label: @tr("Server unreachable");
                        }
                        TouchArea { clicked => { root.settings-clicked(); } }
                    } }
                }
                TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: root.collapsed ? @tr("Expand sidebar") : @tr("Collapse sidebar"); tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size;
                        accessible-role: button; accessible-label: @tr("Expand sidebar");
                        accessible-action-default => { root.toggle-collapsed(); }
                        KeyFocus { border-radius: parent.border-radius; activate => { root.toggle-collapsed(); } }
                        border-width: rail-expand-keys.has-focus ? 2px : 0px; border-color: Colors.focus-ring;
                        rail-expand-keys := FocusScope { width: 0px; height: 0px; enabled: root.touch;
                            key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.toggle-collapsed(); return accept; } return reject; }
                        }
                        height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: root.collapsed ? Icons.chevron-right : Icons.chevron-left; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                        TouchArea { clicked => { root.toggle-collapsed(); } }
                    } }
                }

            }
}
