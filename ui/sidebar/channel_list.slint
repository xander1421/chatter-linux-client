// Channel list component
//
// Displays a scrollable list of channels with section header.
// Supports collapsed mode with simplified header.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { ChannelListItem } from "channel_list_item.slint";

// Data struct for channel items (mirrors Rust ChannelListItemData)
export struct ChannelListItemData {
    channel-id: string,
    name: string,
    channel-type: string,
    unread-count: int,
}

export component ChannelList inherits Rectangle {
    // Properties
    in property <[ChannelListItemData]> channels: [];
    in property <string> selected-channel-id: "";
    in property <bool> collapsed: false;

    // Callbacks
    callback channel-selected(string);
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback show-tooltip(string, length); // text, local-y within this component
    callback hide-tooltip();

    // Layout
    background: Colors.surface;

    VerticalLayout {
        // Section header - simplified when collapsed
        header := Rectangle {
            height: 32px;
            background: Colors.surface;

            // Expanded header
            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;

                Text {
                    text: "CHANNELS";
                    color: Colors.text-muted;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Join/Search channel button (20px icons - 2px bigger)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: join-touch.has-hover ? Colors.surface-hover : transparent;

                    Image {
                        source: Icons.search;
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: join-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }

                    join-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.join-channel-clicked();
                        }
                    }
                }

                // Create channel button (20px icons - 2px bigger)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: create-touch.has-hover ? Colors.surface-hover : transparent;

                    Image {
                        source: Icons.plus;
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: create-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }

                    create-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.create-channel-clicked();
                        }
                    }
                }
            }

            // Collapsed header - just + button centered
            if root.collapsed: HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: collapsed-create-touch.has-hover ? Colors.surface-hover : transparent;

                    Image {
                        source: Icons.plus;
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: collapsed-create-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }

                    collapsed-create-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.create-channel-clicked();
                        }
                    }
                }
            }
        }

        // Scrollable channel list
        flickable := Flickable {
            viewport-height: channel-layout.preferred-height;

            channel-layout := VerticalLayout {
                padding-left: Spacing.xs;
                padding-right: Spacing.xs;
                spacing: 2px;

                for item in root.channels: ChannelListItem {
                    name: item.name;
                    channel-type: item.channel-type;
                    unread-count: item.unread-count;
                    selected: item.channel-id == root.selected-channel-id;
                    collapsed: root.collapsed;

                    clicked => {
                        root.channel-selected(item.channel-id);
                    }
                    show-tooltip(text, item-y) => {
                        // Adjust y position: header height + flickable offset + item position
                        root.show-tooltip(text, header.height + item-y - flickable.viewport-y);
                    }
                    hide-tooltip => {
                        root.hide-tooltip();
                    }
                }
            }
        }
    }
}
