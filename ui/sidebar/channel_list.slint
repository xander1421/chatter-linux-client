// Channel list component
//
// Displays a scrollable list of channels with section header.
// Supports collapsed mode with simplified header.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { ChannelListItem } from "channel_list_item.slint";
import { EmptyState } from "../components/empty_state.slint";

// Data struct for channel items (mirrors Rust ChannelListItemData)
export struct ChannelListItemData {
    channel-id: string,
    name: string,
    channel-type: string,
    unread-count: int,
    last-message: string,   // core-composed preview of the latest activity
    timestamp: string,
    is-typing: bool,
    avatar-source: image,
    has-avatar: bool,
    is-pinned: bool,         // local-only pin; core sorts pinned rows first
    can-leave: bool,         // core's `can_leave_channel`: offer "Leave channel"
    is-selected: bool,       // Rust-computed selection flag; drives highlight
}

export component ChannelList inherits Rectangle {
    // Properties
    in property <[ChannelListItemData]> channels: [];
    in property <bool> collapsed: false;
    // "Touch input", same meaning as the sidebar's — sizes the rows.
    in property <bool> mobile-mode: false;
    in property <bool> show-header: true;
    // True when sibling lists in the same Channels section (e.g. private
    // groups) have items. Suppresses the "no channels yet" empty state so
    // it doesn't stack on top of the group list and confuse the user.
    in property <bool> has-sibling-content: false;

    // Callbacks
    callback channel-selected(string);
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback channel-context-menu-requested(/* channel-id */ string, /* is-pinned */ bool, /* can-leave */ bool, /* x */ length, /* y */ length);
    // Tooltip callbacks removed — ChannelListItem now uses self-contained TooltipArea

    // Transparent: the list only lives inside the Sidebar, which paints the
    // page colour — and the Shield tint, which an opaque list painted over.
    background: transparent;

    VerticalLayout {
        // Section header - simplified when collapsed (hidden when show-header is false)
        if root.show-header: Rectangle {
            height: 32px;

            // Expanded header
            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;

                Text {
                    text: "Channels";
                    color: Colors.text-muted;
                    font-size: Typography.xs2;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Join/Search channel button (visual 24px, touch target 44px)
                Rectangle {
                    width: Spacing.touch-target-min;
                    height: Spacing.touch-target-min;

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: Spacing.radius-sm;
                        background: join-touch.has-hover ? Colors.surface-hover : transparent;

                        Image {
                            source: Icons.search;
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: join-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                        }
                    }

                    join-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.join-channel-clicked();
                        }
                    }
                }

                // Create channel button (visual 24px, touch target 44px)
                Rectangle {
                    width: Spacing.touch-target-min;
                    height: Spacing.touch-target-min;

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: Spacing.radius-sm;
                        background: create-touch.has-hover ? Colors.surface-hover : transparent;

                        Image {
                            source: Icons.plus;
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: create-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                        }
                    }

                    create-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.create-channel-clicked();
                        }
                    }
                }
            }

            // Collapsed header - just + button centered (visual 28px, touch target 44px)
            if root.collapsed: HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: Spacing.touch-target-min;
                    height: Spacing.touch-target-min;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: Spacing.radius-sm;
                        background: collapsed-create-touch.has-hover ? Colors.surface-hover : transparent;

                        Image {
                            source: Icons.plus;
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: collapsed-create-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                        }
                    }

                    collapsed-create-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.create-channel-clicked();
                        }
                    }
                }
            }
        }

        // Empty state when no channels AND no sibling content (private
        // groups render in the same section; their presence means the
        // section is not empty even if classical channels are zero).
        if !root.collapsed && root.channels.length == 0 && !root.has-sibling-content: EmptyState {
            icon: Icons.hash;
            message: "No channels yet";
            cta-text: "Browse channels";
            cta-clicked => { root.join-channel-clicked(); }
        }

        // Scrollable channel list
        flickable := Flickable {
            viewport-height: channel-layout.preferred-height;

            channel-layout := VerticalLayout {
                padding-left: Spacing.xs;
                padding-right: Spacing.xs;
                spacing: 2px;

                for item in root.channels: ChannelListItem {
                    mobile-mode: root.mobile-mode;
                    name: item.name;
                    channel-type: item.channel-type;
                    unread-count: item.unread-count;
                    last-message: item.last-message;
                    timestamp: item.timestamp;
                    is-typing: item.is-typing;
                    selected: item.is-selected;
                    collapsed: root.collapsed;
                    avatar-source: item.avatar-source;
                    has-avatar: item.has-avatar;
                    is-pinned: item.is-pinned;

                    clicked => {
                        root.channel-selected(item.channel-id);
                    }
                    context-menu-requested(x, y) => {
                        root.channel-context-menu-requested(item.channel-id, item.is-pinned, item.can-leave, x, y);
                    }
                }
            }
        }
    }
}
