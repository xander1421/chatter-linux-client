// DM list item component
//
// Displays a direct message conversation with avatar, presence, name, preview, and unread badge.
// Supports collapsed mode showing avatar + presence + badge only.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Avatar } from "../components/avatar.slint";

export component DMListItem inherits Rectangle {
    // Properties
    in property <string> user-id: "";
    in property <string> display-name: "User";
    in property <image> avatar-source;
    in property <string> initials: "";
    in property <string> presence-status: "offline"; // "online", "away", "dnd", "offline"
    in property <string> last-message: "";
    in property <string> timestamp: "";
    in property <int> unread-count: 0;
    in property <bool> is-typing: false;
    in property <bool> selected: false;
    in property <bool> collapsed: false;

    // Callbacks
    callback clicked();
    callback show-tooltip(string, length); // text, local-y
    callback hide-tooltip();

    // Typing animation (0.0 to 1.0 cycling)
    property <float> typing-animation-progress: 0.0;

    // Animation states
    states [
        typing when is-typing: {
            typing-animation-progress: 1.0;
            in {
                animate typing-animation-progress {
                    duration: 600ms;
                    iteration-count: -1;
                }
            }
        }
    ]

    // Calculate dot opacity with staggered timing
    pure function dot-opacity(dot-index: int) -> float {
        if dot-index == 0 {
            0.3 + 0.7 * Math.max(0.0, Math.cos(typing-animation-progress * 360deg))
        } else if dot-index == 1 {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.33) * 360deg))
        } else {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.66) * 360deg))
        }
    }

    // Layout
    height: root.collapsed ? 44px : 52px;
    border-radius: Spacing.radius-sm;

    // Background states: default, hover, selected
    background: root.selected ? Colors.primary.with-alpha(0.2)
              : touch.has-hover ? Colors.surface-hover
              : Colors.surface;

    // Expanded content layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Avatar with presence indicator
        VerticalLayout {
            alignment: center;

            Avatar {
                size: 32px;
                source: root.avatar-source;
                fallback-text: root.initials;
                show-presence: true;
                presence-color: root.presence-status == "online" ? Colors.online
                             : root.presence-status == "away" ? Colors.away
                             : root.presence-status == "dnd" ? Colors.dnd
                             : Colors.offline;
            }
        }

        // Name and last message
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            // Display name
            Text {
                text: root.display-name;
                color: root.selected ? Colors.text-primary : Colors.text-secondary;
                font-size: 14px;
                font-weight: root.unread-count > 0 ? 600 : 400;
                overflow: elide;
            }

            // Typing indicator or last message preview
            if root.is-typing: HorizontalLayout {
                spacing: 3px;
                alignment: start;

                // Animated dots with staggered opacity
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary;
                    opacity: root.dot-opacity(0);
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary;
                    opacity: root.dot-opacity(1);
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary;
                    opacity: root.dot-opacity(2);
                }

                Text {
                    text: "typing";
                    color: Colors.primary;
                    font-size: 12px;
                }
            }

            if !root.is-typing: Text {
                text: root.last-message;
                color: Colors.text-muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        // Right side: timestamp and unread badge
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            // Timestamp
            Text {
                text: root.timestamp;
                color: Colors.text-muted;
                font-size: 11px;
                horizontal-alignment: right;
            }

            // Unread count badge
            if root.unread-count > 0: HorizontalLayout {
                alignment: end;

                Rectangle {
                    width: max(20px, badge-text.preferred-width + 12px);
                    height: 20px;
                    border-radius: Spacing.radius-full;
                    background: Colors.primary;

                    badge-text := Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // Collapsed content layout - centered avatar with badge overlay
    if root.collapsed: Rectangle {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                alignment: center;

                Avatar {
                    size: 32px;
                    source: root.avatar-source;
                    fallback-text: root.initials;
                    show-presence: true;
                    presence-color: root.presence-status == "online" ? Colors.online
                                 : root.presence-status == "away" ? Colors.away
                                 : root.presence-status == "dnd" ? Colors.dnd
                                 : Colors.offline;
                }
            }
        }

        // Badge overlay (top-right of avatar)
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 8px;
            y: parent.height / 2 - 20px;
            width: max(16px, collapsed-badge-text.preferred-width + 8px);
            height: 16px;
            border-radius: Spacing.radius-full;
            background: Colors.primary;

            collapsed-badge-text := Text {
                text: root.unread-count > 99 ? "99+" : root.unread-count;
                color: Colors.text-primary;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // Internal state for tracking if tooltip is currently shown
    property <bool> tooltip-shown: false;

    // Touch area for click handling
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    // Show tooltip when hovering in collapsed mode (transition from not-shown to shown)
    if root.collapsed && touch.has-hover && !root.tooltip-shown: Rectangle {
        width: 0;
        height: 0;
        init => {
            root.tooltip-shown = true;
            root.show-tooltip(root.display-name, root.y + root.height / 2 - 14px);
        }
    }

    // Hide tooltip when hover ends (transition from shown to not-shown)
    if root.tooltip-shown && !touch.has-hover: Rectangle {
        width: 0;
        height: 0;
        init => {
            root.tooltip-shown = false;
            root.hide-tooltip();
        }
    }
}
