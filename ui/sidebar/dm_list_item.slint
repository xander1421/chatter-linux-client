// DM list item component — Neo 2.0
//
// Displays a direct message conversation with avatar, presence, name, preview, and unread badge.
// Neo states: flat default, highlight hover, inset active (selected).

import { Colors } from "../theme/colors.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component DMListItem inherits Rectangle {
    // Properties
    in property <string> user-id: "";
    in property <string> display-name: "User";
    in property <image> avatar-source;
    in property <string> initials: "";
    in property <string> presence-status: "offline"; // "online", "away", "dnd", "offline"
    in property <string> last-message: "";
    in property <string> timestamp: "";
    in property <int> unread-count: 0;
    in property <bool> is-typing: false;
    in property <bool> is-pinned: false;
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    // Callbacks
    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // Typing animation (0.0 to 1.0 cycling)
    // The dots fade through their background's alpha, not `opacity`: Slint
    // wraps an element with `opacity` in an Opacity item that is rendered even
    // when clipped away, which read this animated value, and so kept the
    // animation (and a frame every vsync) running for a row scrolled out of
    // the sidebar. A background is read only when the dot is drawn, so the
    // animation ticks only while a dot is on screen.
    property <float> typing-animation-progress: 0.0;

    // Animation states
    states [
        typing when is-typing: {
            typing-animation-progress: 1.0;
            in {
                animate typing-animation-progress {
                    duration: 600ms;
                    iteration-count: -1;
                }
            }
        }
    ]

    // Calculate dot opacity with staggered timing
    pure function dot-opacity(dot-index: int) -> float {
        if dot-index == 0 {
            0.3 + 0.7 * Math.max(0.0, Math.cos(typing-animation-progress * 360deg))
        } else if dot-index == 1 {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.33) * 360deg))
        } else {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.66) * 360deg))
        }
    }

    // The collapsed rail's slot: one shape and one size for every rail item
    // (see `rail-slot-*` in sidebar.slint — kept in step by hand because the
    // list components between here and there don't forward sizing).
    property <length> slot-size: 44px;

    // Row geometry, both densities from Spacing — the channel and private-group
    // rows this sits between read the same two tokens, so a list that is one
    // flat run of conversations cannot render in two heights again.
    //
    // Touch is not just "the same row, bigger": the eye needs somewhere to land
    // when scanning at arm's length, so the avatar is large enough to identify
    // at a glance and the name steps up a full size over the preview. Mouse
    // density keeps the tighter pair — but the *hierarchy* is the same on both,
    // which is what the colours below say.
    property <length> row-height: root.mobile-mode ? Spacing.row-height-touch : Spacing.row-height-desktop;
    property <length> avatar-size: root.mobile-mode ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop;
    // The selected-state ring sits 2px outside the avatar on every density.
    property <length> avatar-ring: root.avatar-size + 4px;
    property <length> name-size: root.mobile-mode ? Typography.base : Typography.sm;
    property <length> preview-size: root.mobile-mode ? Typography.sm : Typography.xs;
    property <length> badge-size: root.mobile-mode ? 22px : 20px;

    // Layout. Collapsed rows are 48px so the 44px slot has breathing room
    // above and below.
    height: root.collapsed ? 48px : root.row-height;
    border-radius: Spacing.radius-sm;

    // Neo 2.0 states: flat → highlight hover → inset selected.
    // Collapsed, the state fill belongs to the slot below, not to a
    // full-width plate across the rail.
    background: root.collapsed ? transparent
              : root.selected ? Colors.neo-inset-bg
              : touch.has-hover ? Colors.surface-hover
              : transparent;

    // Expanded content layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Avatar with presence indicator
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: root.avatar-ring;
                height: root.avatar-ring;
                border-radius: root.avatar-ring / 2;

                Avatar {
                    size: root.avatar-size;
                    source: root.avatar-source;
                    fallback-text: root.initials;
                    show-presence: true;
                    presence-color: root.presence-status == "online" ? Colors.online
                                 : root.presence-status == "away" ? Colors.away
                                 : root.presence-status == "dnd" ? Colors.dnd
                                 : Colors.offline;
                }
            }
        }

        // Name and last message
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: root.mobile-mode ? Spacing.xs : Spacing.xxs;

            // Display name with encryption indicator
            HorizontalLayout {
                spacing: Spacing.xs;

                Text {
                    text: root.display-name;
                    // The name is the anchor of the row on every density, so it
                    // carries full-strength text at all times. Desktop used to
                    // hold it in grey until selected, one step above a grey
                    // preview — two greys 2px apart is not a hierarchy, it is
                    // the flatness the phone list was just fixed for.
                    color: Colors.text-primary;
                    font-size: root.name-size;
                    font-weight: root.unread-count > 0 ? 600 : 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Pin marker — explains why this row sits above the rest.
                if root.is-pinned: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.pin;
                        width: 11px;
                        height: 11px;
                        colorize: Colors.text-muted;
                        accessible-role: text;
                        accessible-label: "Pinned";
                    }
                }
            }

            // Typing indicator or last message preview
            if root.is-typing: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: start;

                // Animated dots with staggered opacity
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary.with-alpha(root.dot-opacity(0));
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary.with-alpha(root.dot-opacity(1));
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary.with-alpha(root.dot-opacity(2));
                }

                Text {
                    text: "typing";
                    color: Colors.primary;
                    font-size: Typography.xs;
                }
            }

            if !root.is-typing: Text {
                text: root.last-message;
                color: Colors.text-muted;
                font-size: root.preview-size;
                overflow: elide;
            }
        }

        // Right side: timestamp and unread badge
        VerticalLayout {
            alignment: center;
            spacing: Spacing.xs;

            // Timestamp
            Text {
                text: root.timestamp;
                color: Colors.text-muted;
                font-size: Typography.xs2;
                horizontal-alignment: right;
            }

            // Unread count badge
            if root.unread-count > 0: HorizontalLayout {
                alignment: end;

                Rectangle {
                    width: max(root.badge-size, badge-text.preferred-width + 12px);
                    height: root.badge-size;
                    border-radius: Spacing.radius-full;
                    background: Colors.primary;

                    badge-text := Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.text-primary;
                        font-size: Typography.xs2;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // Collapsed content layout — one rail slot, self-contained tooltip
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.display-name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        // Selected indicator — accent pill on the rail's left edge.
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 20px;
            border-radius: Spacing.radius-full;
            background: Colors.primary;
        }

        Rectangle {
            width: root.slot-size;
            height: root.slot-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-lg;
            // Same three states as every other rail slot; on a selected DM the
            // accent fill shows as a ring around the avatar.
            background: root.selected ? Colors.primary
                      : touch.has-hover ? Colors.neo-highlight-strong
                      : Colors.surface-hover;

            Avatar {
                size: 40px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.avatar-source;
                fallback-text: root.initials;
                show-presence: true;
                presence-color: root.presence-status == "online" ? Colors.online
                             : root.presence-status == "away" ? Colors.away
                             : root.presence-status == "dnd" ? Colors.dnd
                             : Colors.offline;
            }

            // Badge overlay — top-right of the slot, ringed in the sidebar
            // surface so it reads on a filled (selected) slot too.
            if root.unread-count > 0: Rectangle {
                x: parent.width - self.width + 4px;
                y: -4px;
                width: max(self.height, collapsed-badge-text.preferred-width + 10px);
                height: Spacing.badge-sm;
                border-radius: Spacing.radius-full;
                border-width: 2px;
                border-color: Colors.surface;
                background: Colors.primary;

                collapsed-badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: Typography.xxs;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    // Touch area for click + right-click handling
    touch := HoldArea {
        clicked => {
            // A hold already acted; swallow its release so it is not also a tap.
            if (!self.hold-fired) { root.clicked(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }
}
