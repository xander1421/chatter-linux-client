// DM list component
//
// Displays a scrollable list of direct message conversations with section header.
// Supports collapsed mode with hidden header.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { DMListItem } from "dm_list_item.slint";
import { EmptyState } from "../components/empty_state.slint";
import { Icons } from "../theme/icons.slint";

// Data struct for DM items (mirrors Rust DMListItemData)
export struct DMListItemData {
    channel-id: string,      // Raw DM channel ID (uuid, no prefix)
    user-id: string,         // The other user's ID
    display-name: string,
    avatar-source: image,    // For avatar bytes converted to image
    has-avatar: bool,        // Whether avatar-source is valid
    initials: string,
    presence-status: string,
    last-message: string,
    timestamp: string,
    unread-count: int,
    is-typing: bool,
    is-anon: bool,           // True for anon (ephemeral) DMs, false for regular
    is-pinned: bool,         // local-only pin; core sorts pinned rows first
    is-selected: bool,       // Rust-computed selection flag; drives highlight
}

export component DMList inherits Rectangle {
    // Properties
    in property <[DMListItemData]> conversations: [];
    in property <bool> collapsed: false;
    // "Touch input", same meaning as Sidebar's. Rows get the taller, larger-type
    // treatment a thumb needs; on desktop the dense mouse sizing is unchanged.
    in property <bool> mobile-mode: false;
    in property <bool> show-header: true;
    // True when anything else in the chat list has rows; suppresses the
    // "No conversations" empty state (see Sidebar's chat-list-empty).
    in property <bool> has-sibling-content: false;

    // Callbacks
    callback conversation-selected(string);
    callback add-friend-clicked();
    callback dm-context-menu-requested(/* channel-id */ string, /* is-anon */ bool, /* is-pinned */ bool, /* x */ length, /* y */ length);
    // Tooltip callbacks removed — DMListItem now uses self-contained TooltipArea

    // Transparent: the list only lives inside the Sidebar, which paints the
    // page colour — and the Shield tint, which an opaque list painted over.
    background: transparent;

    VerticalLayout {
        // Section header - hidden when collapsed (hidden when show-header is false)
        if root.show-header: Rectangle {
            height: root.collapsed ? 0px : 32px;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                alignment: start;

                Text {
                    text: "Direct Messages";
                    color: Colors.text-muted;
                    font-size: Typography.xs2;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
            }
        }

        // Empty state when no DMs
        if !root.collapsed && root.conversations.length == 0 && !root.has-sibling-content: EmptyState {
            icon: Icons.message-circle;
            message: "No conversations";
            cta-text: "Add a friend";
            cta-clicked => { root.add-friend-clicked(); }
        }

        // Scrollable DM list
        flickable := Flickable {
            viewport-height: dm-layout.preferred-height;
            viewport-width: self.width;

            dm-layout := VerticalLayout {
                width: 100%;
                padding-left: Spacing.xs;
                padding-right: Spacing.xs;
                spacing: 2px;

                for item in root.conversations: DMListItem {
                    user-id: item.user-id;
                    display-name: item.display-name;
                    avatar-source: item.avatar-source;
                    initials: item.initials;
                    presence-status: item.presence-status;
                    is-pinned: item.is-pinned;
                    last-message: item.last-message;
                    timestamp: item.timestamp;
                    unread-count: item.unread-count;
                    is-typing: item.is-typing;
                    selected: item.is-selected;
                    collapsed: root.collapsed;
                    mobile-mode: root.mobile-mode;

                    clicked => {
                        root.conversation-selected(item.channel-id);
                    }
                    context-menu-requested(x, y) => {
                        root.dm-context-menu-requested(item.channel-id, item.is-anon, item.is-pinned, x, y);
                    }
                }
            }
        }
    }
}
