// DM list component
//
// Displays a scrollable list of direct message conversations with section header.
// Supports collapsed mode with hidden header.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { DMListItem } from "dm_list_item.slint";

// Data struct for DM items (mirrors Rust DMListItemData)
export struct DMListItemData {
    user-id: string,
    display-name: string,
    avatar-url: string,
    initials: string,
    presence-status: string,
    last-message: string,
    timestamp: string,
    unread-count: int,
}

export component DMList inherits Rectangle {
    // Properties
    in property <[DMListItemData]> conversations: [];
    in property <string> selected-conversation-id: "";
    in property <bool> collapsed: false;

    // Callbacks
    callback conversation-selected(string);
    callback show-tooltip(string, length); // text, local-y within this component
    callback hide-tooltip();

    // Layout
    background: Colors.surface;

    VerticalLayout {
        // Section header - hidden when collapsed
        header := Rectangle {
            height: root.collapsed ? 0px : 32px;
            background: Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                alignment: start;

                Text {
                    text: "DIRECT MESSAGES";
                    color: Colors.text-muted;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
            }
        }

        // Scrollable DM list
        flickable := Flickable {
            viewport-height: dm-layout.preferred-height;

            dm-layout := VerticalLayout {
                padding-left: Spacing.xs;
                padding-right: Spacing.xs;
                spacing: 2px;

                for item in root.conversations: DMListItem {
                    user-id: item.user-id;
                    display-name: item.display-name;
                    initials: item.initials;
                    presence-status: item.presence-status;
                    last-message: item.last-message;
                    timestamp: item.timestamp;
                    unread-count: item.unread-count;
                    selected: item.user-id == root.selected-conversation-id;
                    collapsed: root.collapsed;

                    clicked => {
                        root.conversation-selected(item.user-id);
                    }
                    show-tooltip(text, item-y) => {
                        // Adjust y position: header height + flickable offset + item position
                        root.show-tooltip(text, header.height + item-y - flickable.viewport-y);
                    }
                    hide-tooltip => {
                        root.hide-tooltip();
                    }
                }
            }
        }
    }
}
