// Private group list item component — Neo 2.0
//
// Displays a single private group in the sidebar list.
// Neo states: flat default, highlight hover, inset active with purple glow.

import { Colors } from "../theme/colors.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component PrivateGroupListItem inherits Rectangle {
    in property <string> group-id;
    in property <string> name;
    in property <int> member-count: 0;
    in property <int> unread-count: 0;
    // Core-composed preview of the latest activity: text, "🖼️ Photo",
    // "📎 report.pdf", "📌 …" for a pinned one. Never assembled here.
    in property <string> last-message: "";
    in property <string> timestamp: "";
    in property <bool> is-typing: false;
    in property <bool> selected: false;
    in property <bool> collapsed: false;

    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // Typing animation (0.0 to 1.0 cycling)
    property <float> typing-animation-progress: 0.0;

    // Animation states
    states [
        typing when is-typing: {
            typing-animation-progress: 1.0;
            in {
                animate typing-animation-progress {
                    duration: 600ms;
                    iteration-count: -1;
                }
            }
        }
    ]

    // Calculate dot opacity with staggered timing
    pure function dot-opacity(dot-index: int) -> float {
        if dot-index == 0 {
            0.3 + 0.7 * Math.max(0.0, Math.cos(typing-animation-progress * 360deg))
        } else if dot-index == 1 {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.33) * 360deg))
        } else {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.66) * 360deg))
        }
    }

    // The collapsed rail's slot: one shape and one size for every rail item
    // (see `rail-slot-*` in sidebar.slint — kept in step by hand because the
    // list components between here and there don't forward sizing).
    property <length> slot-size: 44px;
    property <length> slot-glyph: 20px;

    // Touch sizing, shared with the DM and channel rows this sits between —
    // a flat mobile list where one row kind is 44px and its neighbours are 72px
    // reads as three lists spliced together.
    in property <bool> mobile-mode: false;
    property <length> name-size: root.mobile-mode ? Typography.base : Typography.sm;
    property <length> preview-size: root.mobile-mode ? Typography.sm : Typography.xs;

    // Collapsed rows are 48px so the 44px slot has breathing room above and
    // below. Expanded takes the shared row height at both densities — see the
    // DM row for why one number, not one per row kind.
    height: root.collapsed ? 48px : (root.mobile-mode ? Spacing.row-height-touch : Spacing.row-height-desktop);
    border-radius: Spacing.radius-sm;

    // Use purple accent for private groups
    property <color> accent-color: Colors.group-accent;

    // Neo 2.0 states: flat → highlight hover → inset selected with purple glow.
    // Collapsed, the state fill belongs to the slot below, not to a
    // full-width plate across the rail.
    background: root.collapsed ? transparent
              : root.selected ? Colors.neo-inset-bg
              : touch.has-hover ? Colors.surface-hover
              : transparent;

    // Expanded layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        // `stretch`, not `start`: the text column claims the slack so the
        // timestamp and badge sit on the right edge like every DM row's do.
        alignment: stretch;

        // Shield icon with purple background
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Spacing.radius-sm;
            background: accent-color.with-alpha(0.15);

            Image {
                source: Icons.shield;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: accent-color;
            }
        }

        // Text content
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: Spacing.xs;

                Text {
                    // Same rule as the DM and channel rows: name full-strength
                    // at all times, preview muted below it.
                    text: root.name;
                    color: Colors.text-primary;
                    font-size: root.name-size;
                    font-weight: root.selected ? Typography.semibold : 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Member count badge
                if root.member-count > 0: Rectangle {
                    width: member-text.preferred-width + 8px;
                    height: Spacing.badge-sm;
                    border-radius: self.height / 2;
                    background: Colors.text-muted.with-alpha(0.2);

                    member-text := Text {
                        text: root.member-count;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Typing indicator or last message preview
            if root.is-typing: HorizontalLayout {
                spacing: 3px;
                alignment: start;

                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: accent-color;
                    opacity: root.dot-opacity(0);
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: accent-color;
                    opacity: root.dot-opacity(1);
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: accent-color;
                    opacity: root.dot-opacity(2);
                }

                Text {
                    text: "typing";
                    color: accent-color;
                    font-size: Typography.xs;
                }
            }

            if !root.is-typing && root.last-message != "": Text {
                text: root.last-message;
                color: Colors.text-muted;
                font-size: root.preview-size;
                overflow: elide;
            }
        }

        // Right side: timestamp above the unread badge, as on DM rows. The
        // timestamp reached this component but was never rendered.
        if root.timestamp != "" || root.unread-count > 0: VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 0;

            Text {
                text: root.timestamp;
                color: Colors.text-muted;
                font-size: Typography.xs2;
                horizontal-alignment: right;
            }

            if root.unread-count > 0: HorizontalLayout {
                alignment: end;

                Rectangle {
                    width: max(self.height, unread-text.preferred-width + 8px);
                    height: Spacing.badge-md;
                    border-radius: self.height / 2;
                    background: accent-color;

                    unread-text := Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.text-primary;
                        font-size: Typography.xs;
                        font-weight: Typography.semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Encryption indicator on the far-right — purple shield marks a
        // private (anonymous) group. Sits after the unread badge so the
        // presence of a badge doesn't push it out of sight.
        VerticalLayout {
            alignment: center;
            Image {
                source: Icons.shield;
                width: 12px;
                height: 12px;
                colorize: accent-color;
            }
        }
    }

    // Collapsed layout — one rail slot, self-contained tooltip. The purple
    // identity lives in the glyph, not in a tile shape unique to this item:
    // the container matches every other slot in the rail.
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        // Selected indicator — accent pill on the rail's left edge.
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 20px;
            border-radius: Spacing.radius-full;
            background: accent-color;
        }

        Rectangle {
            width: root.slot-size;
            height: root.slot-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-lg;
            background: root.selected ? accent-color
                      : touch.has-hover ? Colors.neo-highlight-strong
                      : Colors.surface-hover;

            Image {
                source: Icons.shield;
                width: root.slot-glyph;
                height: root.slot-glyph;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.text-primary : accent-color;
            }

            // Unread badge overlay — ringed in the sidebar surface so it reads
            // on a filled (selected) slot too.
            if root.unread-count > 0: Rectangle {
                x: parent.width - self.width + 4px;
                y: -4px;
                width: max(self.height, collapsed-unread-text.preferred-width + 10px);
                height: Spacing.badge-sm;
                border-radius: self.height / 2;
                border-width: 2px;
                border-color: Colors.surface;
                background: accent-color;

                collapsed-unread-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: Typography.xxs;
                    font-weight: Typography.semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    touch := HoldArea {
        clicked => {
            // A hold already acted; swallow its release so it is not also a tap.
            if (!self.hold-fired) { root.clicked(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }
}
