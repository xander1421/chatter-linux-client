// Private group list item component — Neo 2.0
//
// Displays a single private group in the sidebar list.
// Neo states: flat default, highlight hover, inset active with purple glow.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component PrivateGroupListItem inherits Rectangle {
    in property <string> group-id;
    in property <string> name;
    in property <int> member-count: 0;
    in property <int> unread-count: 0;
    in property <string> last-message: "";
    in property <string> timestamp: "";
    in property <bool> is-typing: false;
    in property <bool> selected: false;
    in property <bool> collapsed: false;

    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // Typing animation (0.0 to 1.0 cycling)
    property <float> typing-animation-progress: 0.0;

    // Animation states
    states [
        typing when is-typing: {
            typing-animation-progress: 1.0;
            in {
                animate typing-animation-progress {
                    duration: 600ms;
                    iteration-count: -1;
                }
            }
        }
    ]

    // Calculate dot opacity with staggered timing
    pure function dot-opacity(dot-index: int) -> float {
        if dot-index == 0 {
            0.3 + 0.7 * Math.max(0.0, Math.cos(typing-animation-progress * 360deg))
        } else if dot-index == 1 {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.33) * 360deg))
        } else {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.66) * 360deg))
        }
    }

    height: 44px;
    border-radius: Spacing.radius-sm;

    // Use purple accent for private groups
    property <color> accent-color: Colors.group-accent;

    // Neo 2.0 states: flat → highlight hover → inset selected with purple glow
    background: root.selected ? Colors.neo-inset-bg
              : touch.has-hover ? Colors.surface-hover
              : transparent;
    border-width: root.selected || touch.has-hover ? 1px : 0px;
    border-color: root.selected ? accent-color.with-alpha(0.2) : Colors.neo-highlight;

    // Expanded layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: start;

        // Shield icon with purple background
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Spacing.radius-sm;
            background: accent-color.with-alpha(0.15);

            Image {
                source: Icons.shield;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: accent-color;
            }
        }

        // Text content
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: Spacing.xs;

                Text {
                    text: root.name;
                    color: root.selected ? Colors.text-primary : Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: root.selected ? Typography.semibold : Typography.normal;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Encryption lock indicator
                Image {
                    source: Icons.lock;
                    width: 10px;
                    height: 10px;
                    colorize: Colors.success;
                    y: (parent.height - self.height) / 2;
                }

                // Member count badge
                if root.member-count > 0: Rectangle {
                    width: member-text.preferred-width + 8px;
                    height: 16px;
                    border-radius: 8px;
                    background: Colors.text-muted.with-alpha(0.2);

                    member-text := Text {
                        text: root.member-count;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Typing indicator or last message preview
            if root.is-typing: HorizontalLayout {
                spacing: 3px;
                alignment: start;

                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: accent-color;
                    opacity: root.dot-opacity(0);
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: accent-color;
                    opacity: root.dot-opacity(1);
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: accent-color;
                    opacity: root.dot-opacity(2);
                }

                Text {
                    text: "typing";
                    color: accent-color;
                    font-size: Typography.xs;
                }
            }

            if !root.is-typing && root.last-message != "": Text {
                text: root.last-message;
                color: Colors.text-muted;
                font-size: Typography.xs;
                overflow: elide;
            }
        }

        // Unread badge
        if root.unread-count > 0: Rectangle {
            width: max(18px, unread-text.preferred-width + 8px);
            height: 18px;
            border-radius: 9px;
            background: accent-color;

            unread-text := Text {
                text: root.unread-count > 99 ? "99+" : root.unread-count;
                color: Colors.text-primary;
                font-size: Typography.xs;
                font-weight: Typography.semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Collapsed layout with self-contained tooltip
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Spacing.radius-sm;
                background: accent-color.with-alpha(0.15);

                Image {
                    source: Icons.shield;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: accent-color;
                }
            }
        }

        // Unread badge overlay
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 8px;
            y: parent.height / 2 - 16px;
            width: max(16px, collapsed-unread-text.preferred-width + 8px);
            height: 16px;
            border-radius: 8px;
            background: accent-color;

            collapsed-unread-text := Text {
                text: root.unread-count > 99 ? "99+" : root.unread-count;
                color: Colors.text-primary;
                font-size: 10px;
                font-weight: Typography.semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}
