// Private group list item component — Neo 2.0
//
// Displays a single private group in the sidebar list.
// Neo states: flat default, highlight hover, inset active with purple glow.

import { Avatar } from "../components/avatar.slint";
import { Appearance } from "../theme/appearance.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { Icons } from "../theme/icons.slint";

export component PrivateGroupListItem inherits Rectangle {
    in property <image> avatar-source;
    in property <string> group-id;
    in property <string> name;
    in property <int> member-count: 0;
    in property <int> unread-count: 0;
    in property <int> mention-count: 0;
    // Core-composed preview of the latest activity: text, "🖼️ Photo",
    // "📎 report.pdf", "📌 …" for a pinned one. Never assembled here.
    in property <string> last-message: "";
    in property <string> draft-preview: "";
    in property <string> timestamp: "";
    in property <bool> is-typing: false;
    in property <string> typing-text;
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <bool> is-muted: false;

    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);
    callback swipe-down(length, length);
    callback swipe-moved(length, length);
    callback swipe-ended(bool);

    // Typing animation (0.0 to 1.0 cycling)
    // The dots fade through their background's alpha, not `opacity`: Slint
    // wraps an element with `opacity` in an Opacity item that is rendered even
    // when clipped away, which read this animated value, and so kept the
    // animation (and a frame every vsync) running for a row scrolled out of
    // the sidebar. A background is read only when the dot is drawn, so the
    // animation ticks only while a dot is on screen.
    property <float> typing-animation-progress: 0.0;

    // Animation states
    states [
        typing when is-typing: {
            typing-animation-progress: 1.0;
            in {
                animate typing-animation-progress {
                    // Reduce animations: the dots hold one static mark.
                    duration: Appearance.reduce-motion ? 0ms : 600ms / Appearance.animation-speed;
                    iteration-count: Appearance.reduce-motion ? 1 : -1;
                }
            }
        }
    ]

    // Calculate dot opacity with staggered timing
    pure function dot-opacity(dot-index: int) -> float {
        if dot-index == 0 {
            0.3 + 0.7 * Math.max(0.0, Math.cos(typing-animation-progress * 360deg))
        } else if dot-index == 1 {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.33) * 360deg))
        } else {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.66) * 360deg))
        }
    }

    // The collapsed rail's slot: one shape and one size for every rail item
    // (see `rail-slot-*` in sidebar.slint — kept in step by hand because the
    // list components between here and there don't forward sizing).
    property <length> slot-size: 44px;
    property <length> slot-glyph: 20px;

    // Touch sizing, shared with the DM and channel rows this sits between —
    // a flat mobile list where one row kind is 44px and its neighbours are 72px
    // reads as three lists spliced together.
    in property <bool> mobile-mode: false;
    property <length> name-size: root.mobile-mode ? Typography.base : Typography.sm;
    property <length> preview-size: root.mobile-mode ? Typography.sm : Typography.xs;

    // Collapsed rows are 48px so the 44px slot has breathing room above and
    // below. Expanded takes the shared row height at both densities — see the
    // DM row for why one number, not one per row kind.
    height: root.collapsed ? 48px : (root.mobile-mode ? Spacing.row-height-touch : Spacing.row-height-desktop);
    border-radius: Spacing.radius-md;
    clip: true;

    // Use purple accent for private groups
    property <color> accent-color: Colors.group-accent;

    // A Flickable cancels the pointer grab when scrolling begins. Release the
    // visual press as soon as the finger moves past the shared gesture slop.
    property <bool> press-active: false;
    property <length> press-x: 0px;
    property <length> press-y: 0px;
    function press-down(x: length, y: length) {
        root.press-x = x;
        root.press-y = y;
        root.press-active = true;
    }
    function press-moved(x: length, y: length) {
        if (abs(x - root.press-x) > Spacing.sm || abs(y - root.press-y) > Spacing.sm) {
            root.press-active = false;
        }
    }
    // The whole row compresses under the finger, then springs back from its
    // own center. This keeps the avatar, text and badge moving as one surface.
    transform-scale-x: root.press-active ? 98% : 100%;
    transform-scale-y: root.press-active ? 96% : 100%;
    animate transform-scale-x { duration: root.press-active ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
    animate transform-scale-y { duration: root.press-active ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
    animate background { duration: Materials.motion-standard; easing: Materials.glide; }

    // Neo 2.0 states: flat → highlight hover → inset selected with purple glow.
    // Collapsed, the state fill belongs to the slot below, not to a
    // full-width plate across the rail.
    background: root.collapsed ? transparent
              : root.selected ? Colors.row-selected
              : root.press-active ? Colors.surface-control-hover
              : (!root.mobile-mode && touch.has-hover) ? Colors.row-hover
              : transparent;

    Rectangle {
        opacity: root.selected && !root.collapsed ? 1 : 0;
        animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
        x: 0px;
        width: 3px;
        height: parent.height;
        border-radius: self.width / 2;
        background: Colors.selected-indicator;
    }

    // Expanded layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        // `stretch`, not `start`: the text column claims the slack so the
        // timestamp and badge sit on the right edge like every DM row's do.
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Avatar {
                size: root.mobile-mode ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop;
                source: root.avatar-source;
                name: root.name;
                anonymous: true;
            }
        }

        // Text content
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Spacing.xxs;

            HorizontalLayout {
                spacing: Spacing.xs;

                Text {
                    // Same rule as the DM and channel rows: name full-strength
                    // at all times, preview muted below it.
                    text: root.name;
                    wrap: no-wrap;
                    color: Colors.text-primary;
                    font-size: root.name-size;
                    font-weight: root.selected ? Typography.semibold : 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.is-muted: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.bell-off;
                        width: 12px;
                        height: 12px;
                        colorize: Colors.text-muted;
                        accessible-role: text;
                        accessible-label: "Muted";
                    }
                }

            }

            // Typing indicator or last message preview
            if root.is-typing: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Spacing.xs;
                        Rectangle { width: 4px; height: 4px; border-radius: 2px; background: accent-color.with-alpha(root.dot-opacity(0)); }
                        Rectangle { width: 4px; height: 4px; border-radius: 2px; background: accent-color.with-alpha(root.dot-opacity(1)); }
                        Rectangle { width: 4px; height: 4px; border-radius: 2px; background: accent-color.with-alpha(root.dot-opacity(2)); }
                    }
                }

                Text {
                    text: root.typing-text != "" ? root.typing-text : "typing";
                    color: accent-color;
                    font-size: Typography.xs;
                    min-width: 0px;
                    overflow: elide;
                }
            }

            if !root.is-typing && root.last-message != "": Rectangle {
                horizontal-stretch: 1;
                height: root.preview-size * 1.4;
                clip: true;
                if root.draft-preview != "": HorizontalLayout {
                    width: parent.width;
                    spacing: 3px;
                    Text { text: "Draft:"; color: Colors.danger; font-size: root.preview-size; }
                    Text { text: root.draft-preview; color: Colors.text-muted; font-size: root.preview-size; overflow: elide; horizontal-stretch: 1; }
                }
                if root.draft-preview == "": Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.last-message;
                    wrap: no-wrap;
                    color: Colors.text-muted;
                    font-size: root.preview-size;
                    overflow: elide;
                }
            }
        }

        // Right side: timestamp above the unread badge, as on DM rows. The
        // timestamp reached this component but was never rendered.
        if root.timestamp != "" || root.unread-count > 0: VerticalLayout {
            alignment: center;
            spacing: Spacing.xs;
            horizontal-stretch: 0;

            Text {
                text: root.timestamp;
                wrap: no-wrap;
                color: Colors.text-muted;
                font-size: Typography.xs2;
                horizontal-alignment: right;
            }

            HorizontalLayout {
                visible: root.unread-count > 0 || self.opacity > 0;
                opacity: root.unread-count > 0 ? 1 : 0;
                transform-scale-x: root.unread-count > 0 ? 100% : 55%;
                transform-scale-y: root.unread-count > 0 ? 100% : 55%;
                animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
                animate transform-scale-x { duration: Materials.motion-standard; easing: Materials.spring; }
                animate transform-scale-y { duration: Materials.motion-standard; easing: Materials.spring; }
                alignment: end;
                spacing: Spacing.xs;

                if root.mention-count > 0: Text {
                    text: root.mention-count > 99 ? "@99+" : "@" + root.mention-count;
                    min-width: self.preferred-width;
                    color: Colors.primary;
                    font-size: Typography.xs2;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: max(self.height, unread-text.preferred-width + 8px);
                    height: Spacing.badge-md;
                    border-radius: self.height / 2;
                    background: root.is-muted ? Colors.text-muted : accent-color;

                    unread-text := Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.on-action;
                        font-size: Typography.xs;
                        font-weight: Typography.semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }


    }

    // Collapsed layout — one rail slot, self-contained tooltip. The purple
    // identity lives in the glyph, not in a tile shape unique to this item:
    // the container matches every other slot in the rail.
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        // Selected indicator — accent pill on the rail's left edge.
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 20px;
            border-radius: Spacing.radius-full;
            background: accent-color;
        }

        Rectangle {
            width: root.slot-size;
            height: root.slot-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-lg;
            background: root.selected ? accent-color
                      : (!root.mobile-mode && touch.has-hover) ? Colors.fill-secondary
                      : Colors.surface-hover;

            Avatar {
                size: 40px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.avatar-source;
                name: root.name;
                anonymous: true;
            }

            // Unread badge overlay — ringed in the sidebar surface so it reads
            // on a filled (selected) slot too.
            if root.unread-count > 0: Rectangle {
                x: parent.width - self.width + 4px;
                y: -4px;
                width: max(self.height, collapsed-unread-text.preferred-width + 10px);
                height: Spacing.badge-sm;
                border-radius: self.height / 2;
                border-width: 2px;
                border-color: Colors.surface;
                background: root.is-muted ? Colors.text-muted : accent-color;

                collapsed-unread-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.on-action;
                    font-size: Typography.xxs;
                    font-weight: Typography.semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    touch := HoldArea {
        clicked => {
            // A hold already acted; swallow its release so it is not also a tap.
            if (!self.hold-fired) { root.clicked(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
        gesture-down(x, y) => { root.press-down(x, y); root.swipe-down(x, y); }
        gesture-moved(x, y) => { root.press-moved(x, y); root.swipe-moved(x, y); }
        gesture-ended(cancelled) => { root.press-active = false; root.swipe-ended(cancelled); }
    }
}
