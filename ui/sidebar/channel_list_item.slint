// Channel list item component — Neo 2.0
//
// Displays a single channel with icon, name, and unread count badge.
// Neo states: flat default, highlight hover, inset active (selected).

import { Colors } from "../theme/colors.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component ChannelListItem inherits Rectangle {
    // Properties
    in property <string> name: "channel";
    in property <string> channel-type: "public"; // "public", "private", "dm"
    in property <int> unread-count: 0;
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <image> avatar-source;
    in property <bool> has-avatar: false;

    // Callbacks
    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // The collapsed rail's slot: one shape and one size for every rail item
    // (see `rail-slot-*` in sidebar.slint — kept in step by hand because the
    // list components between here and there don't forward sizing).
    property <length> slot-size: 44px;
    property <length> slot-glyph: 20px;

    // Layout. Collapsed rows are 48px so the 44px slot has breathing room
    // above and below; expanded rows keep the 44px text row.
    height: root.collapsed ? 48px : 44px;
    border-radius: Spacing.radius-sm;

    // Neo 2.0 states: flat → highlight hover → inset selected.
    // Collapsed, the state fill belongs to the slot below, not to a
    // full-width plate across the rail.
    background: root.collapsed ? transparent
              : root.selected ? Colors.neo-inset-bg
              : touch.has-hover ? Colors.surface-hover
              : transparent;
    border-width: !root.collapsed && (root.selected || touch.has-hover) ? 1px : 0px;
    border-color: root.selected ? Colors.glow-primary : Colors.neo-highlight;

    // Expanded content layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Channel icon container (24px wide for alignment; uploaded avatar when present, else type glyph)
        Rectangle {
            width: 24px;
            height: parent.height;

            if root.has-avatar: Rectangle {
                width: 20px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                clip: true;
                Image {
                    source: root.avatar-source;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }

            // Private channels render as a purple dot instead of an icon —
            // visual encryption marker without taking up icon space.
            if !root.has-avatar && root.channel-type == "private": Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Colors.primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if !root.has-avatar && root.channel-type != "private": Image {
                source: root.channel-type == "public" ? Icons.hash : Icons.users;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.primary : Colors.text-secondary;
            }
        }

        // Channel name with encryption indicator
        HorizontalLayout {
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: root.selected ? Colors.text-primary : Colors.text-secondary;
                font-size: Typography.sm;
                font-weight: root.unread-count > 0 ? 600 : 400;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // Unread count badge
        if root.unread-count > 0: VerticalLayout {
            alignment: center;

            Rectangle {
                width: max(20px, badge-text.preferred-width + 12px);
                height: 20px;
                border-radius: Spacing.radius-full;
                background: Colors.primary;

                badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: Typography.xs2;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Invite-only indicator on the far-right — green lock marks a
        // private (gated) channel. Placed after the unread badge so it's
        // visible regardless of unread state.
        if root.channel-type == "private": VerticalLayout {
            alignment: center;
            Image {
                source: Icons.lock;
                width: 12px;
                height: 12px;
                colorize: Colors.success;
            }
        }
    }

    // Collapsed content layout — one rail slot, self-contained tooltip
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        // Selected indicator — accent pill on the rail's left edge. Reads at
        // a glance where a fill alone can be missed on a small screen.
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 20px;
            border-radius: Spacing.radius-full;
            background: Colors.primary;
        }

        Rectangle {
            width: root.slot-size;
            height: root.slot-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-lg;
            background: root.selected ? Colors.primary
                      : touch.has-hover ? Colors.neo-highlight-strong
                      : Colors.surface-hover;

            if root.has-avatar: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Spacing.radius-lg;
                clip: true;
                Image {
                    source: root.avatar-source;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }

            // Collapsed view: private → purple dot, others → type icon.
            if !root.has-avatar && root.channel-type == "private": Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.selected ? Colors.text-primary : Colors.primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if !root.has-avatar && root.channel-type != "private": Image {
                source: root.channel-type == "public" ? Icons.hash : Icons.users;
                width: root.slot-glyph;
                height: root.slot-glyph;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.text-primary : Colors.text-secondary;
            }

            // Badge overlay — top-right of the slot, ringed in the sidebar
            // surface so it reads on a filled (selected) slot too.
            if root.unread-count > 0: Rectangle {
                x: parent.width - self.width + 4px;
                y: -4px;
                width: max(16px, collapsed-badge-text.preferred-width + 10px);
                height: 16px;
                border-radius: Spacing.radius-full;
                border-width: 2px;
                border-color: Colors.surface;
                background: Colors.primary;

                collapsed-badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: Typography.xxs;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    // Touch area for click + right-click handling
    touch := HoldArea {
        clicked => {
            // A hold already acted; swallow its release so it is not also a tap.
            if (!self.hold-fired) { root.clicked(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }
}
