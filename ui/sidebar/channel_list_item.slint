// Channel list item component — Neo 2.0
//
// Displays a single channel with icon, name, latest-activity preview,
// timestamp and unread count badge — the same two-line shape as DMListItem,
// because a channel and a DM sit in the same scan of the same sidebar.
// Neo states: flat default, highlight hover, inset active (selected).

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component ChannelListItem inherits Rectangle {
    // Properties
    in property <string> name: "channel";
    in property <string> channel-type: "public"; // "public", "private", "dm"
    in property <int> unread-count: 0;
    // Core-composed preview of the latest activity: text, "🖼️ Photo",
    // "📎 report.pdf", "📌 …" for a pinned one. Never assembled here.
    in property <string> last-message: "";
    in property <string> timestamp: "";
    in property <bool> is-typing: false;
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <image> avatar-source;
    in property <bool> has-avatar: false;
    in property <bool> is-pinned: false;
    in property <bool> mobile-mode: false;

    // Callbacks
    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // Typing animation (0.0 to 1.0 cycling), same as the DM row above it.
    // The dots fade through their background's alpha, not `opacity`: Slint
    // wraps an element with `opacity` in an Opacity item that is rendered even
    // when clipped away, which read this animated value, and so kept the
    // animation (and a frame every vsync) running for a row scrolled out of
    // the sidebar. A background is read only when the dot is drawn, so the
    // animation ticks only while a dot is on screen.
    property <float> typing-animation-progress: 0.0;

    states [
        typing when is-typing: {
            typing-animation-progress: 1.0;
            in {
                animate typing-animation-progress {
                    // Reduce animations: the dots hold one static mark.
                    duration: Appearance.reduce-motion ? 0ms : 600ms;
                    iteration-count: Appearance.reduce-motion ? 1 : -1;
                }
            }
        }
    ]

    // Calculate dot opacity with staggered timing
    pure function dot-opacity(dot-index: int) -> float {
        if dot-index == 0 {
            0.3 + 0.7 * Math.max(0.0, Math.cos(typing-animation-progress * 360deg))
        } else if dot-index == 1 {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.33) * 360deg))
        } else {
            0.3 + 0.7 * Math.max(0.0, Math.cos((typing-animation-progress - 0.66) * 360deg))
        }
    }

    // The collapsed rail's slot: one shape and one size for every rail item
    // (see `rail-slot-*` in sidebar.slint — kept in step by hand because the
    // list components between here and there don't forward sizing).
    property <length> slot-size: 44px;
    property <length> slot-glyph: 20px;

    // Sizing, shared with the DM rows above it at BOTH densities — a channel
    // and a DM sit in the same flat list, so a 44px row with 14px grey text
    // next to a 52px row with white text reads as two lists spliced together.
    // That was fixed for touch first; the same argument was always true of the
    // mouse-density list, it was just quieter about it.
    property <length> name-size: root.mobile-mode ? Typography.base : Typography.sm;
    property <length> preview-size: root.mobile-mode ? Typography.sm : Typography.xs;
    property <length> glyph-size: root.mobile-mode ? 24px : 16px;
    property <length> icon-box: root.mobile-mode ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop;

    // Layout. Collapsed rows are 48px so the 44px slot has breathing room
    // above and below.
    height: root.collapsed ? 48px : (root.mobile-mode ? Spacing.row-height-touch : Spacing.row-height-desktop);
    border-radius: Spacing.radius-sm;

    // Neo 2.0 states: flat → highlight hover → inset selected.
    // Collapsed, the state fill belongs to the slot below, not to a
    // full-width plate across the rail.
    background: root.collapsed ? transparent
              : root.selected ? Colors.inset
              : touch.has-hover ? Colors.surface-hover
              : transparent;

    // Expanded content layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Channel icon container (uploaded avatar when present, else type glyph).
        // On touch it takes the DM avatar's column width so both row kinds put
        // their text on the same left edge.
        Rectangle {
            width: root.icon-box;
            height: parent.height;

            if root.has-avatar: Rectangle {
                width: root.icon-box;
                height: root.icon-box;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                clip: true;
                Image {
                    source: root.avatar-source;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }

            // Type glyph. A private (invite-only) channel is sender-key
            // encrypted — core refuses to send it in cleartext
            // (message/core.rs, F14a) — so its glyph is the lock; a public
            // channel is plaintext by design and gets '#'. It used to be an
            // 8px dot, which read as presence/unread, plus a second green
            // lock at the row's far right.
            if !root.has-avatar: Image {
                source: root.channel-type == "public" ? Icons.hash
                      : root.channel-type == "private" ? Icons.lock : Icons.users;
                width: root.glyph-size;
                height: root.glyph-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.primary : Colors.text-secondary;
            }
        }

        // Name and latest-activity preview — the DM row's two-line block.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: root.mobile-mode ? Spacing.xs : Spacing.xxs;

            HorizontalLayout {
                spacing: Spacing.xs;

                Text {
                    // Same rule as the DM row: the name is the anchor and is
                    // always full-strength, the preview below is the muted one.
                    text: root.name;
                    color: Colors.text-primary;
                    font-size: root.name-size;
                    font-weight: root.unread-count > 0 ? 600 : 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Pin marker — explains why this row sits above the rest.
                if root.is-pinned: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.pin;
                        width: 12px;
                        height: 12px;
                        colorize: Colors.text-muted;
                        accessible-role: text;
                        accessible-label: "Pinned";
                    }
                }
            }

            // Typing indicator or last-message preview. A channel nobody has
            // posted in yet keeps its old one-line look instead of reserving a
            // blank second line.
            if root.is-typing: HorizontalLayout {
                spacing: Spacing.xs;
                alignment: start;

                // Animated dots with staggered opacity
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary.with-alpha(root.dot-opacity(0));
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary.with-alpha(root.dot-opacity(1));
                }
                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Colors.primary.with-alpha(root.dot-opacity(2));
                }

                Text {
                    text: "typing";
                    color: Colors.primary;
                    font-size: Typography.xs;
                }
            }

            if !root.is-typing && root.last-message != "": Text {
                text: root.last-message;
                color: Colors.text-muted;
                font-size: root.preview-size;
                overflow: elide;
            }
        }

        // Right side: timestamp above the unread badge, as on DM rows.
        if root.timestamp != "" || root.unread-count > 0: VerticalLayout {
            alignment: center;
            spacing: Spacing.xs;
            horizontal-stretch: 0;

            Text {
                text: root.timestamp;
                color: Colors.text-muted;
                font-size: Typography.xs2;
                horizontal-alignment: right;
            }

            if root.unread-count > 0: HorizontalLayout {
                alignment: end;

                Rectangle {
                    width: max(20px, badge-text.preferred-width + 12px);
                    height: 20px;
                    border-radius: Spacing.radius-full;
                    background: Colors.action-fill;

                    badge-text := Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.on-action;
                        font-size: Typography.xs2;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

    }

    // Collapsed content layout — one rail slot, self-contained tooltip
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        // Selected indicator — accent pill on the rail's left edge. Reads at
        // a glance where a fill alone can be missed on a small screen.
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 20px;
            border-radius: Spacing.radius-full;
            background: Colors.primary;
        }

        Rectangle {
            width: root.slot-size;
            height: root.slot-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-lg;
            background: root.selected ? Colors.primary
                      : touch.has-hover ? Colors.fill-secondary
                      : Colors.surface-hover;

            if root.has-avatar: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Spacing.radius-lg;
                clip: true;
                Image {
                    source: root.avatar-source;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }

            // Collapsed view: the same type glyph as the expanded row.
            if !root.has-avatar: Image {
                source: root.channel-type == "public" ? Icons.hash
                      : root.channel-type == "private" ? Icons.lock : Icons.users;
                width: root.slot-glyph;
                height: root.slot-glyph;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.text-primary : Colors.text-secondary;
            }

            // Badge overlay — top-right of the slot, ringed in the sidebar
            // surface so it reads on a filled (selected) slot too.
            if root.unread-count > 0: Rectangle {
                x: parent.width - self.width + 4px;
                y: -4px;
                width: max(self.height, collapsed-badge-text.preferred-width + 10px);
                height: Spacing.badge-sm;
                border-radius: Spacing.radius-full;
                border-width: 2px;
                border-color: Colors.surface;
                background: Colors.action-fill;

                collapsed-badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.on-action;
                    font-size: Typography.xxs;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    // Touch area for click + right-click handling
    touch := HoldArea {
        clicked => {
            // A hold already acted; swallow its release so it is not also a tap.
            if (!self.hold-fired) { root.clicked(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }
}
