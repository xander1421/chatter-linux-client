// Channel list item component
//
// Displays a single channel with icon, name, and unread count badge.
// Supports collapsed mode showing icon + badge only.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";

export component ChannelListItem inherits Rectangle {
    // Properties
    in property <string> name: "channel";
    in property <string> channel-type: "public"; // "public", "private", "dm"
    in property <int> unread-count: 0;
    in property <bool> selected: false;
    in property <bool> collapsed: false;

    // Callbacks
    callback clicked();
    callback show-tooltip(string, length); // text, local-y
    callback hide-tooltip();

    // Layout
    height: 44px;
    border-radius: Spacing.radius-sm;

    // Background states: default, hover, selected
    background: root.selected ? Colors.primary.with-alpha(0.2)
              : touch.has-hover ? Colors.surface-hover
              : Colors.surface;

    // Expanded content layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Channel icon (# for public, lock for private, @ for DM)
        Text {
            width: 20px;
            text: root.channel-type == "public" ? "\u{1F4AC}\u{FE0F}"
                : root.channel-type == "private" ? "\u{1F512}\u{FE0F}"
                : "\u{1F464}\u{FE0F}";
            color: root.selected ? Colors.primary : Colors.text-secondary;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        // Channel name
        Text {
            text: root.name;
            color: root.selected ? Colors.text-primary : Colors.text-secondary;
            font-size: 14px;
            font-weight: root.unread-count > 0 ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Unread count badge
        if root.unread-count > 0: VerticalLayout {
            alignment: center;

            Rectangle {
                width: max(20px, badge-text.preferred-width + 12px);
                height: 20px;
                border-radius: Spacing.radius-full;
                background: Colors.primary;

                badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    // Collapsed content layout - centered icon with badge overlay
    if root.collapsed: Rectangle {
        width: 100%;
        height: 100%;

        // Centered channel icon
        Text {
            text: root.channel-type == "public" ? "\u{1F4AC}\u{FE0F}"
                : root.channel-type == "private" ? "\u{1F512}\u{FE0F}"
                : "\u{1F464}\u{FE0F}";
            color: root.selected ? Colors.primary : Colors.text-secondary;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }

        // Badge overlay (top-right of icon)
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 4px;
            y: parent.height / 2 - 16px;
            width: max(16px, collapsed-badge-text.preferred-width + 8px);
            height: 16px;
            border-radius: Spacing.radius-full;
            background: Colors.primary;

            collapsed-badge-text := Text {
                text: root.unread-count > 99 ? "99+" : root.unread-count;
                color: Colors.text-primary;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // Internal state for tracking if tooltip is currently shown
    property <bool> tooltip-shown: false;

    // Touch area for click handling
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    // Show tooltip when hovering in collapsed mode (transition from not-shown to shown)
    if root.collapsed && touch.has-hover && !root.tooltip-shown: Rectangle {
        width: 0;
        height: 0;
        init => {
            root.tooltip-shown = true;
            root.show-tooltip(root.name, root.y + root.height / 2 - 14px);
        }
    }

    // Hide tooltip when hover ends (transition from shown to not-shown)
    if root.tooltip-shown && !touch.has-hover: Rectangle {
        width: 0;
        height: 0;
        init => {
            root.tooltip-shown = false;
            root.hide-tooltip();
        }
    }
}
