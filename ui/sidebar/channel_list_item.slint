// Channel list item component — Neo 2.0
//
// Displays a single channel with icon, name, and unread count badge.
// Neo states: flat default, highlight hover, inset active (selected).

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component ChannelListItem inherits Rectangle {
    // Properties
    in property <string> name: "channel";
    in property <string> channel-type: "public"; // "public", "private", "dm"
    in property <int> unread-count: 0;
    in property <bool> selected: false;
    in property <bool> collapsed: false;

    // Callbacks
    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // Layout
    height: 44px;
    border-radius: Spacing.radius-sm;

    // Neo 2.0 states: flat → highlight hover → inset selected
    background: root.selected ? Colors.neo-inset-bg
              : touch.has-hover ? Colors.surface-hover
              : transparent;
    border-width: root.selected || touch.has-hover ? 1px : 0px;
    border-color: root.selected ? Colors.glow-primary : Colors.neo-highlight;

    // Expanded content layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Channel icon container (20px wide for alignment)
        Rectangle {
            width: 20px;
            height: parent.height;

            // Public: hash, Private: lock, DM: user
            Image {
                source: root.channel-type == "public" ? Icons.hash
                      : root.channel-type == "private" ? Icons.lock
                      : Icons.users;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.primary : Colors.text-secondary;
            }
        }

        // Channel name with encryption indicator
        HorizontalLayout {
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: root.selected ? Colors.text-primary : Colors.text-secondary;
                font-size: 14px;
                font-weight: root.unread-count > 0 ? 600 : 400;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Encryption lock indicator
            Image {
                source: Icons.lock;
                width: 10px;
                height: 10px;
                colorize: Colors.success;
                y: (parent.height - self.height) / 2;
            }
        }

        // Unread count badge
        if root.unread-count > 0: VerticalLayout {
            alignment: center;

            Rectangle {
                width: max(20px, badge-text.preferred-width + 12px);
                height: 20px;
                border-radius: Spacing.radius-full;
                background: Colors.primary;

                badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    // Collapsed content layout - centered icon with badge overlay and self-contained tooltip
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        // Centered channel icon
        Image {
            source: root.channel-type == "public" ? Icons.hash
                  : root.channel-type == "private" ? Icons.lock
                  : Icons.users;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Colors.primary : Colors.text-secondary;
        }

        // Badge overlay (top-right of icon)
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 4px;
            y: parent.height / 2 - 16px;
            width: max(16px, collapsed-badge-text.preferred-width + 8px);
            height: 16px;
            border-radius: Spacing.radius-full;
            background: Colors.primary;

            collapsed-badge-text := Text {
                text: root.unread-count > 99 ? "99+" : root.unread-count;
                color: Colors.text-primary;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    // Touch area for click + right-click handling
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}
