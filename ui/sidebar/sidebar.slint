// Main sidebar component
//
// Container with user profile bar, saved messages, channel list, and DM list.
// Supports collapsing to icon-only mode (60px).
// Tooltip handling is self-contained via TooltipArea — no signal bubbling.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { ChannelList, ChannelListItemData } from "channel_list.slint";
import { DMList, DMListItemData } from "dm_list.slint";
import { PrivateGroupList, PrivateGroupListItemData } from "private_group_list.slint";
import { OrgSwitcher, OrgListItemData } from "org_switcher.slint";
import { UserProfileBar } from "user_profile_bar.slint";
import { TooltipArea } from "../components/tooltip.slint";

// Re-export types for parent components
export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, OrgListItemData }

export component Sidebar inherits Rectangle {
    // Properties - Channel list
    in property <[ChannelListItemData]> channels: [];
    in property <string> selected-channel-id: "";

    // Properties - DM list
    in property <[DMListItemData]> dm-conversations: [];
    in property <string> selected-dm-id: "";

    // Properties - Private groups
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <string> selected-private-group-id: "";

    // Properties - User profile
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    in property <string> user-custom-status: "";

    // Properties - Organization
    in property <string> current-org-name: "";
    in property <[OrgListItemData]> organizations: [];
    in property <bool> org-loading: false;

    // Properties - Collapsed state
    in-out property <bool> collapsed: false;
    // Fully hidden on mobile (0px width, no content rendered)
    in-out property <bool> hidden: false;

    // Callbacks - Navigation
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();

    // Callbacks - Profile
    callback friends-clicked();
    callback profile-clicked();

    // Callbacks - Organization
    callback org-selected(/* org_id */ string);
    callback manage-org-clicked();

    // Properties - Friend requests badge
    in property <int> pending-friend-requests: 0;

    // Properties - Message requests badge
    in property <int> pending-message-requests: 0;

    // Properties - Group invites badge
    in property <int> pending-group-invites: 0;

    // Callbacks - Message requests
    callback message-requests-clicked();

    // Callbacks - Group invites
    callback group-invites-clicked();

    // Callback - Toggle collapsed
    callback toggle-collapsed();

    // Layout - animated width transition
    // Mobile: fully hidden (0px). Tablet: collapsed icon bar (60px). Desktop: full (240px).
    width: root.hidden ? Spacing.sidebar-width-hidden : (root.collapsed ? Spacing.sidebar-width-collapsed : Spacing.sidebar-width);
    visible: !root.hidden;
    background: Colors.surface;

    animate width {
        duration: 200ms;
        easing: ease-out;
    }

    VerticalLayout {
        // User profile bar at top
        user-profile := UserProfileBar {
            display-name: root.user-display-name;
            avatar-source: root.user-avatar-source;
            initials: root.user-initials;
            presence-status: root.user-presence-status;
            custom-status: root.user-custom-status;
            collapsed: root.collapsed;
            pending-friend-requests: root.pending-friend-requests;

            friends-clicked => { root.friends-clicked(); }
            profile-clicked => { root.profile-clicked(); }
        }

        // Organization switcher (below profile, above friends)
        org-switcher := OrgSwitcher {
            current-org-name: root.current-org-name;
            organizations: root.organizations;
            collapsed: root.collapsed;
            is-loading: root.org-loading;

            org-selected(org-id) => { root.org-selected(org-id); }
            manage-org-clicked => { root.manage-org-clicked(); }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Friends entry — self-contained tooltip in collapsed mode
        friends-entry := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: friends-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;

                // Friends icon container
                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.users;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: friends-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                    }
                }

                // Text with badge
                HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;

                    Text {
                        text: "Friends";
                        color: Colors.text-secondary;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    // Badge showing count
                    if root.pending-friend-requests > 0: Rectangle {
                        width: root.pending-friend-requests > 9 ? 24px : 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Colors.error;

                        Text {
                            text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                            color: Colors.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            if root.collapsed: TooltipArea {
                width: 100%;
                height: 100%;
                tooltip-text: "Friends";
                tooltip-enabled: root.collapsed;
                placement: "right";

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 20px;
                        height: parent.height;

                        Image {
                            source: Icons.users;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: friends-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                        }

                        // Badge for pending requests (collapsed mode)
                        if root.pending-friend-requests > 0: Rectangle {
                            x: parent.width - 8px;
                            y: 8px;
                            width: root.pending-friend-requests > 9 ? 18px : 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: Colors.error;

                            Text {
                                text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                                color: Colors.text-primary;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                }
            }

            friends-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.friends-clicked(); }
            }
        }

        // Saved messages entry
        saved-messages := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: saved-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;

                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.star;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }
                }

                Text {
                    text: "Saved Messages";
                    color: Colors.text-secondary;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            if root.collapsed: TooltipArea {
                width: 100%;
                height: 100%;
                tooltip-text: "Saved Messages";
                tooltip-enabled: root.collapsed;
                placement: "right";

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 20px;
                        height: parent.height;

                        Image {
                            source: Icons.star;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: Colors.text-secondary;
                        }
                    }
                }
            }

            saved-touch := TouchArea {
                clicked => { root.saved-messages-clicked(); }
            }
        }

        // Message requests entry (only shown when there are pending requests)
        if root.pending-message-requests > 0: message-requests := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: msg-req-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;

                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.message-circle;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;

                    Text {
                        text: "Message Requests";
                        color: Colors.primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: root.pending-message-requests > 9 ? 24px : 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Colors.error;

                        Text {
                            text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                            color: Colors.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            if root.collapsed: TooltipArea {
                width: 100%;
                height: 100%;
                tooltip-text: "Message Requests (" + root.pending-message-requests + ")";
                tooltip-enabled: root.collapsed;
                placement: "right";

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 20px;
                        height: parent.height;

                        Image {
                            source: Icons.message-circle;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: Colors.primary;
                        }

                        // Badge showing count (in collapsed mode)
                        Rectangle {
                            x: parent.width - 8px;
                            y: 8px;
                            width: root.pending-message-requests > 9 ? 18px : 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: Colors.error;

                            Text {
                                text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                                color: Colors.text-primary;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                }
            }

            msg-req-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.message-requests-clicked(); }
            }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Channel list (flexible height)
        channel-list := ChannelList {
            vertical-stretch: 1;
            channels: root.channels;
            selected-channel-id: root.selected-channel-id;
            collapsed: root.collapsed;

            channel-selected(id) => {
                root.channel-selected(id);
            }
            create-channel-clicked => {
                root.create-channel-clicked();
            }
            join-channel-clicked => {
                root.join-channel-clicked();
            }
        }

        // Private groups list
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Group invites entry (only shown when there are pending invites)
        if root.pending-group-invites > 0: group-invites := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: grp-inv-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;

                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.shield;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #9333ea;
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;

                    Text {
                        text: "Group Invites";
                        color: #9333ea;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: root.pending-group-invites > 9 ? 24px : 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Colors.error;

                        Text {
                            text: root.pending-group-invites > 9 ? "9+" : root.pending-group-invites;
                            color: Colors.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            if root.collapsed: TooltipArea {
                width: 100%;
                height: 100%;
                tooltip-text: "Group Invites (" + root.pending-group-invites + ")";
                tooltip-enabled: root.collapsed;
                placement: "right";

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 20px;
                        height: parent.height;

                        Image {
                            source: Icons.shield;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: #9333ea;
                        }

                        // Badge showing count (in collapsed mode)
                        Rectangle {
                            x: parent.width - 8px;
                            y: 8px;
                            width: root.pending-group-invites > 9 ? 18px : 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: Colors.error;

                            Text {
                                text: root.pending-group-invites > 9 ? "9+" : root.pending-group-invites;
                                color: Colors.text-primary;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                }
            }

            grp-inv-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.group-invites-clicked(); }
            }
        }

        private-group-list := PrivateGroupList {
            vertical-stretch: 0;
            max-height: 150px;
            groups: root.private-groups;
            selected-group-id: root.selected-private-group-id;
            collapsed: root.collapsed;

            group-selected(id) => {
                root.private-group-selected(id);
            }
            create-group-clicked => {
                root.create-channel-clicked();
            }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // DM list (flexible height, min 200px)
        dm-list := DMList {
            vertical-stretch: 1;
            min-height: 200px;
            conversations: root.dm-conversations;
            selected-conversation-id: root.selected-dm-id;
            collapsed: root.collapsed;

            conversation-selected(id) => {
                root.dm-selected(id);
            }
            add-friend-clicked => {
                root.friends-clicked();
            }
        }

        // Separator before toggle
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Toggle button at bottom
        Rectangle {
            height: 36px;
            background: toggle-touch.has-hover ? Colors.surface-hover : Colors.surface;

            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                alignment: root.collapsed ? center : end;

                // Chevron icon
                Image {
                    source: root.collapsed ? Icons.chevron-right : Icons.chevron-left;
                    width: 16px;
                    height: 16px;
                    colorize: Colors.text-muted;
                }
            }

            toggle-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.collapsed = !root.collapsed;
                    root.toggle-collapsed();
                }
            }
        }
    }
}
