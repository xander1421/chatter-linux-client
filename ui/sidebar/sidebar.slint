// Main sidebar component
//
// Container with user profile bar, saved messages, channel list, and DM list.
// Supports collapsing to icon-only mode (60px).

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { ChannelList, ChannelListItemData } from "channel_list.slint";
import { DMList, DMListItemData } from "dm_list.slint";
import { PrivateGroupList, PrivateGroupListItemData } from "private_group_list.slint";
import { UserProfileBar } from "user_profile_bar.slint";

// Re-export types for parent components
export { ChannelListItemData, DMListItemData, PrivateGroupListItemData }

export component Sidebar inherits Rectangle {
    // Properties - Channel list
    in property <[ChannelListItemData]> channels: [];
    in property <string> selected-channel-id: "";

    // Properties - DM list
    in property <[DMListItemData]> dm-conversations: [];
    in property <string> selected-dm-id: "";

    // Properties - Private groups
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <string> selected-private-group-id: "";

    // Properties - User profile
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    in property <string> user-custom-status: "";

    // Properties - Collapsed state
    in-out property <bool> collapsed: false;

    // Callbacks - Navigation
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();

    // Callbacks - Profile
    callback friends-clicked();
    callback profile-clicked();

    // Properties - Friend requests badge
    in property <int> pending-friend-requests: 0;

    // Properties - Message requests badge
    in property <int> pending-message-requests: 0;

    // Callbacks - Message requests
    callback message-requests-clicked();

    // Callback - Toggle collapsed
    callback toggle-collapsed();


    // Callbacks - Tooltip (bubble up to App for global rendering)
    callback show-tooltip(string, length, length);
    callback hide-tooltip();

    // Layout - animated width transition
    width: root.collapsed ? Spacing.sidebar-width-collapsed : Spacing.sidebar-width;
    background: Colors.surface;

    animate width {
        duration: 200ms;
        easing: ease-out;
    }

    VerticalLayout {
        // User profile bar at top
        user-profile := UserProfileBar {
            display-name: root.user-display-name;
            avatar-source: root.user-avatar-source;
            initials: root.user-initials;
            presence-status: root.user-presence-status;
            custom-status: root.user-custom-status;
            collapsed: root.collapsed;
            pending-friend-requests: root.pending-friend-requests;

            friends-clicked => { root.friends-clicked(); }
            profile-clicked => { root.profile-clicked(); }
            show-tooltip(text) => {
                root.show-tooltip(text, root.width + 8px, user-profile.y + user-profile.height / 2 - 14px);
            }
            hide-tooltip => { root.hide-tooltip(); }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Friends entry
        friends-entry := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: friends-touch.has-hover ? Colors.surface-hover : Colors.surface;

            // Internal state for tracking if tooltip is currently shown
            property <bool> tooltip-shown: false;

            HorizontalLayout {
                padding-left: root.collapsed ? 0px : Spacing.sm;
                padding-right: root.collapsed ? 0px : Spacing.sm;
                spacing: root.collapsed ? 0px : Spacing.sm;
                alignment: root.collapsed ? center : start;

                // Friends icon container (20px wide to match other icons)
                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.users;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: friends-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                    }

                    // Badge for pending requests (collapsed mode)
                    if root.collapsed && root.pending-friend-requests > 0: Rectangle {
                        x: parent.width - 8px;
                        y: 8px;
                        width: root.pending-friend-requests > 9 ? 18px : 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Colors.error;

                        Text {
                            text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                            color: Colors.text-primary;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                // Text with badge (hidden when collapsed)
                if !root.collapsed: HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;

                    Text {
                        text: "Friends";
                        color: Colors.text-secondary;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    // Badge showing count
                    if root.pending-friend-requests > 0: Rectangle {
                        width: root.pending-friend-requests > 9 ? 24px : 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Colors.error;

                        Text {
                            text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                            color: Colors.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            friends-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.friends-clicked(); }
            }

            // Show tooltip when hovering in collapsed mode
            if root.collapsed && friends-touch.has-hover && !tooltip-shown: Rectangle {
                width: 0;
                height: 0;
                init => {
                    friends-entry.tooltip-shown = true;
                    root.show-tooltip("Friends", root.width + 8px, friends-entry.y + friends-entry.height / 2 - 14px);
                }
            }

            if tooltip-shown && !friends-touch.has-hover: Rectangle {
                width: 0;
                height: 0;
                init => {
                    friends-entry.tooltip-shown = false;
                    root.hide-tooltip();
                }
            }
        }

        // Saved messages entry
        saved-messages := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: saved-touch.has-hover ? Colors.surface-hover : Colors.surface;

            // Internal state for tracking if tooltip is currently shown
            property <bool> tooltip-shown: false;

            HorizontalLayout {
                padding-left: root.collapsed ? 0px : Spacing.sm;
                padding-right: root.collapsed ? 0px : Spacing.sm;
                spacing: root.collapsed ? 0px : Spacing.sm;
                alignment: root.collapsed ? center : start;

                // Saved messages icon - aligned with channel icons (20px wide container)
                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.star;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }
                }

                // Text (hidden when collapsed)
                if !root.collapsed: Text {
                    text: "Saved Messages";
                    color: Colors.text-secondary;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            saved-touch := TouchArea {
                clicked => { root.saved-messages-clicked(); }
            }

            // Show tooltip when hovering in collapsed mode (transition from not-shown to shown)
            if root.collapsed && saved-touch.has-hover && !tooltip-shown: Rectangle {
                width: 0;
                height: 0;
                init => {
                    saved-messages.tooltip-shown = true;
                    root.show-tooltip("Saved Messages", root.width + 8px, saved-messages.y + saved-messages.height / 2 - 14px);
                }
            }

            // Hide tooltip when hover ends (transition from shown to not-shown)
            if tooltip-shown && !saved-touch.has-hover: Rectangle {
                width: 0;
                height: 0;
                init => {
                    saved-messages.tooltip-shown = false;
                    root.hide-tooltip();
                }
            }
        }

        // Message requests entry (only shown when there are pending requests)
        if root.pending-message-requests > 0: message-requests := Rectangle {
            height: 44px;
            border-radius: Spacing.radius-sm;
            background: msg-req-touch.has-hover ? Colors.surface-hover : Colors.surface;

            // Internal state for tracking if tooltip is currently shown
            property <bool> tooltip-shown: false;

            HorizontalLayout {
                padding-left: root.collapsed ? 0px : Spacing.sm;
                padding-right: root.collapsed ? 0px : Spacing.sm;
                spacing: root.collapsed ? 0px : Spacing.sm;
                alignment: root.collapsed ? center : start;

                // Message icon - aligned with channel icons (20px wide container)
                Rectangle {
                    width: 20px;
                    height: parent.height;

                    Image {
                        source: Icons.message-circle;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }

                    // Badge showing count (in collapsed mode)
                    if root.collapsed: Rectangle {
                        x: parent.width - 8px;
                        y: 8px;
                        width: root.pending-message-requests > 9 ? 18px : 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Colors.error;

                        Text {
                            text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                            color: Colors.text-primary;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                // Text with badge (hidden when collapsed)
                if !root.collapsed: HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;

                    Text {
                        text: "Message Requests";
                        color: Colors.primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    // Badge showing count
                    Rectangle {
                        width: root.pending-message-requests > 9 ? 24px : 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Colors.error;

                        Text {
                            text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                            color: Colors.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            msg-req-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.message-requests-clicked(); }
            }

            // Show tooltip when hovering in collapsed mode (transition from not-shown to shown)
            if root.collapsed && msg-req-touch.has-hover && !tooltip-shown: Rectangle {
                width: 0;
                height: 0;
                init => {
                    message-requests.tooltip-shown = true;
                    root.show-tooltip("Message Requests (" + root.pending-message-requests + ")", root.width + 8px, message-requests.y + message-requests.height / 2 - 14px);
                }
            }

            // Hide tooltip when hover ends (transition from shown to not-shown)
            if tooltip-shown && !msg-req-touch.has-hover: Rectangle {
                width: 0;
                height: 0;
                init => {
                    message-requests.tooltip-shown = false;
                    root.hide-tooltip();
                }
            }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Channel list (flexible height)
        channel-list := ChannelList {
            vertical-stretch: 1;
            channels: root.channels;
            selected-channel-id: root.selected-channel-id;
            collapsed: root.collapsed;

            channel-selected(id) => {
                root.channel-selected(id);
            }
            create-channel-clicked => {
                root.create-channel-clicked();
            }
            join-channel-clicked => {
                root.join-channel-clicked();
            }
            show-tooltip(text, local-y) => {
                root.show-tooltip(text, root.width + 8px, channel-list.y + local-y);
            }
            hide-tooltip => { root.hide-tooltip(); }
        }

        // Private groups list (only show if has groups)
        if root.private-groups.length > 0: Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        if root.private-groups.length > 0: private-group-list := PrivateGroupList {
            vertical-stretch: 0;
            max-height: 150px;
            groups: root.private-groups;
            selected-group-id: root.selected-private-group-id;
            collapsed: root.collapsed;

            group-selected(id) => {
                root.private-group-selected(id);
            }
            show-tooltip(text, local-y) => {
                root.show-tooltip(text, root.width + 8px, self.y + local-y);
            }
            hide-tooltip => { root.hide-tooltip(); }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // DM list (flexible height, min 200px)
        dm-list := DMList {
            vertical-stretch: 1;
            min-height: 200px;
            conversations: root.dm-conversations;
            selected-conversation-id: root.selected-dm-id;
            collapsed: root.collapsed;

            conversation-selected(id) => {
                root.dm-selected(id);
            }
            show-tooltip(text, local-y) => {
                root.show-tooltip(text, root.width + 8px, dm-list.y + local-y);
            }
            hide-tooltip => { root.hide-tooltip(); }
        }

        // Separator before toggle
        Rectangle {
            height: 1px;
            background: Colors.surface-hover;
        }

        // Toggle button at bottom
        Rectangle {
            height: 36px;
            background: toggle-touch.has-hover ? Colors.surface-hover : Colors.surface;

            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                alignment: root.collapsed ? center : end;

                // Chevron icon
                Image {
                    source: root.collapsed ? Icons.chevron-right : Icons.chevron-left;
                    width: 16px;
                    height: 16px;
                    colorize: Colors.text-muted;
                }
            }

            toggle-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.collapsed = !root.collapsed;
                    root.toggle-collapsed();
                }
            }
        }
    }
}
