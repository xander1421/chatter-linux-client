// Sidebar — Neo 2.0
//
// Layout (top to bottom):
//   1. Org switcher — neo button row
//   2. Search bar — inset surface
//   3. Scrollable content with flat/inset list items
//   4. Bottom bar — glass surface
//
// Neo depth separation: sidebar surface is raised from background,
// with right-edge highlight border. Internal elements use
// inset (search, selected items) and glass (bottom bar) surfaces.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { ChannelList, ChannelListItemData } from "channel_list.slint";
import { DMList, DMListItemData } from "dm_list.slint";
import { PrivateGroupList, PrivateGroupListItemData } from "private_group_list.slint";
import { OrgSwitcher, OrgListItemData } from "org_switcher.slint";
import { CustomSectionList, CustomSectionData, SectionConversationData } from "custom_section_list.slint";
import { SectionContextMenu } from "section_context_menu.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";

export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, OrgListItemData, CustomSectionData, SectionConversationData }

export component Sidebar inherits Rectangle {
    // ── Properties: Data ──
    in property <[ChannelListItemData]> channels: [];
    in property <string> selected-channel-id: "";
    in property <[DMListItemData]> dm-conversations: [];
    in property <string> selected-dm-id: "";
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <string> selected-private-group-id: "";
    in property <[CustomSectionData]> custom-sections: [];
    in property <[SectionConversationData]> section-conversations: [];

    // ── Properties: User profile ──
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    in property <string> user-custom-status: "";

    // ── Properties: Organization ──
    in property <string> current-org-name: "";
    in property <string> current-org-initial: "";
    in property <[OrgListItemData]> organizations: [];
    in property <bool> org-loading: false;

    // ── Properties: State ──
    in-out property <bool> collapsed: false;
    in-out property <bool> hidden: false;
    in property <bool> mobile-mode: false;
    in property <length> mobile-width: 360px;

    // ── Properties: Badges ──
    in property <int> pending-friend-requests: 0;
    in property <int> pending-message-requests: 0;
    in property <int> pending-group-invites: 0;

    // ── Callbacks ──
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback friends-clicked();
    callback profile-clicked();
    callback org-selected(/* org_id */ string);
    callback manage-org-clicked();
    callback message-requests-clicked();
    callback group-invites-clicked();
    callback toggle-collapsed();
    callback search-clicked();
    callback jarvis-clicked();
    callback settings-clicked();
    callback create-section-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ string);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ string, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);

    // ── Internal state ──
    property <bool> channels-expanded: true;
    property <bool> messages-expanded: true;

    // Context menu state
    property <bool> ctx-menu-show: false;
    property <length> ctx-menu-x: 0;
    property <length> ctx-menu-y: 0;
    property <string> ctx-menu-conv-id: "";
    property <string> ctx-menu-conv-type: "";
    property <string> ctx-menu-current-section-id: "";

    // ── Sizing ──
    width: root.mobile-mode ? root.mobile-width
         : root.hidden ? Spacing.sidebar-width-hidden
         : root.collapsed ? Spacing.sidebar-width-collapsed
         : Spacing.sidebar-width;
    visible: root.mobile-mode ? true : !root.hidden;
    // Neo 2.0: sidebar is a raised surface with right-edge highlight
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-x: Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    animate width { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        // ════════════════════════════════════════
        // 1. ORG SWITCHER (button row at top)
        // ════════════════════════════════════════
        OrgSwitcher {
            current-org-name: root.current-org-name;
            current-org-initial: root.current-org-initial;
            organizations: root.organizations;
            collapsed: root.collapsed;
            is-loading: root.org-loading;
            org-selected(id) => { root.org-selected(id); }
            manage-org-clicked => { root.manage-org-clicked(); }
        }

        // ════════════════════════════════════════
        // 2. SEARCH BAR — Neo 2.0 inset surface
        // ════════════════════════════════════════
        if !root.collapsed: Rectangle {
            height: 40px;
            Rectangle {
                x: Spacing.sm;
                y: 4px;
                width: parent.width - 2 * Spacing.sm;
                height: 32px;
                border-radius: Spacing.radius-sm;
                // Neo inset: pressed-in search field
                background: search-touch.has-hover ? Colors.surface-hover : Colors.neo-inset-bg;
                border-width: 1px;
                border-color: search-touch.has-hover ? Colors.neo-highlight-strong : Colors.neo-inset-shadow;

                HorizontalLayout {
                    padding-left: Spacing.sm;
                    spacing: Spacing.sm;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Image {
                            source: Icons.search;
                            width: 14px;
                            height: 14px;
                            colorize: Colors.text-muted;
                        }
                    }
                    Text {
                        text: "Search...";
                        color: Colors.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                search-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.search-clicked(); }
                }
            }
        }

        // Collapsed: search icon
        if root.collapsed: TooltipArea {
            height: 36px;
            width: 44px;
            x: (parent.width - self.width) / 2;
            tooltip-text: "Search";
            tooltip-enabled: root.collapsed;
            placement: "right";
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: csearch-touch.has-hover ? Colors.surface-hover : transparent;
                    Image {
                        source: Icons.search;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.text-muted;
                    }
                }
            }
            csearch-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.search-clicked(); }
            }
        }

        // ════════════════════════════════════════
        // SCROLLABLE CENTRAL CONTENT
        // ════════════════════════════════════════
        Flickable {
            vertical-stretch: 1;
            viewport-height: central-layout.preferred-height;

            central-layout := VerticalLayout {
                padding-bottom: Spacing.md;

                // QUICK LINKS (top navigation)
                Rectangle {
                    height: 34px;
                    background: saved-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Saved Messages";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: Icons.bookmark; width: 14px; height: 14px; colorize: Colors.text-secondary; }
                        }
                        Text { text: "Saved Messages"; color: Colors.text-secondary; font-size: 13px; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Saved Messages"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Image { source: Icons.bookmark; width: 16px; height: 16px; colorize: Colors.text-secondary; } }
                    }
                    saved-touch := TouchArea { clicked => { root.saved-messages-clicked(); } }
                }

                Rectangle {
                    height: 34px;
                    background: friends-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Friends";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: Icons.users; width: 14px; height: 14px; colorize: Colors.text-secondary; }
                        }
                        Text { text: "Friends"; color: Colors.text-secondary; font-size: 13px; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Friends"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Image { source: Icons.users; width: 16px; height: 16px; colorize: Colors.text-secondary; } }
                    }
                    friends-touch := TouchArea { clicked => { root.friends-clicked(); } }
                }

                // INVITE BANNERS (conditional)
                if root.pending-message-requests > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: root.pending-message-requests == 1 ? "1 message request" : root.pending-message-requests + " message requests";
                    height: 38px;
                    border-radius: Spacing.radius-sm;
                    background: mreq-touch.has-hover ? Colors.surface-hover : Colors.surface;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.message-circle;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.primary;
                            }
                        }
                        Text {
                            text: "Message Requests";
                            color: Colors.primary;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: root.pending-message-requests > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                                color: Colors.text-primary;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            Image {
                                source: Icons.message-circle;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.primary;
                            }
                            Rectangle {
                                x: parent.width - 6px;
                                y: 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Colors.error;
                            }
                        }
                    }

                    mreq-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.message-requests-clicked(); }
                    }
                }

                if root.pending-group-invites > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: root.pending-group-invites == 1 ? "1 group invite" : root.pending-group-invites + " group invites";
                    height: 38px;
                    border-radius: Spacing.radius-sm;
                    background: ginv-touch.has-hover ? Colors.surface-hover : Colors.surface;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.shield;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.group-accent;
                            }
                        }
                        Text {
                            text: "Group Invites";
                            color: Colors.group-accent;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: root.pending-group-invites > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.pending-group-invites > 9 ? "9+" : root.pending-group-invites;
                                color: Colors.text-primary;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            Image {
                                source: Icons.shield;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.group-accent;
                            }
                            Rectangle {
                                x: parent.width - 6px;
                                y: 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Colors.error;
                            }
                        }
                    }

                    ginv-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.group-invites-clicked(); }
                    }
                }

                // 5. CHANNELS SECTION
                Rectangle {
                    height: 32px;
                    if !root.collapsed: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.channels-expanded = !root.channels-expanded; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 4px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: Icons.chevron-right;
                                        width: 10px;
                                        height: 10px;
                                        colorize: Colors.text-muted;
                                        transform-rotation: root.channels-expanded ? 90deg : 0deg;
                                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: "Channels";
                                    color: Colors.text-muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            width: Spacing.touch-target-min;
                            height: Spacing.touch-target-min;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: join-ch-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    source: Icons.search;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: join-ch-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            join-ch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.join-channel-clicked(); }
                            }
                        }
                        Rectangle {
                            width: Spacing.touch-target-min;
                            height: Spacing.touch-target-min;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: create-ch-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    source: Icons.plus;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: create-ch-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            create-ch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.create-channel-clicked(); }
                            }
                        }
                    }
                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            Image { source: Icons.plus; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                            TouchArea { clicked => { root.create-channel-clicked(); } }
                        }
                    }
                }

                if root.channels-expanded: ChannelList {
                    vertical-stretch: 0;
                    channels: root.channels;
                    selected-channel-id: root.selected-channel-id;
                    collapsed: root.collapsed;
                    show-header: false;
                    channel-selected(id) => { root.channel-selected(id); }
                    channel-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "channel";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                if root.channels-expanded && root.private-groups.length > 0: PrivateGroupList {
                    vertical-stretch: 0;
                    groups: root.private-groups;
                    selected-group-id: root.selected-private-group-id;
                    collapsed: root.collapsed;
                    show-header: false;
                    group-selected(id) => { root.private-group-selected(id); }
                    group-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "private_group";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                // 4. MESSAGES SECTION
                Rectangle {
                    height: 32px;
                    if !root.collapsed: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.messages-expanded = !root.messages-expanded; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 4px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: Icons.chevron-right;
                                        width: 10px;
                                        height: 10px;
                                        colorize: Colors.text-muted;
                                        transform-rotation: root.messages-expanded ? 90deg : 0deg;
                                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: "Messages";
                                    color: Colors.text-muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            width: Spacing.touch-target-min;
                            height: Spacing.touch-target-min;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: add-dm-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    // Use user-plus instead of plus to distinguish from create channel/section
                                    source: Icons.user-plus;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: add-dm-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            add-dm-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.friends-clicked(); }
                            }
                        }
                    }
                }

                if root.messages-expanded: DMList {
                    vertical-stretch: 0;
                    conversations: root.dm-conversations;
                    selected-conversation-id: root.selected-dm-id;
                    collapsed: root.collapsed;
                    show-header: false;
                    conversation-selected(id) => { root.dm-selected(id); }
                    dm-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "dm";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                // 4b. CUSTOM SECTIONS (user-created, between Messages and Channels)
                CustomSectionList {
                    vertical-stretch: 0;
                    sections: root.custom-sections;
                    section-conversations: root.section-conversations;
                    selected-conversation-id: root.selected-dm-id;
                    collapsed: root.collapsed;
                    create-section-clicked => { root.create-section-clicked(); }
                    section-toggle-expanded(id) => { root.section-toggle-expanded(id); }
                    section-conversation-selected(conv-id, conv-type) => { root.section-conversation-selected(conv-id, conv-type); }
                    delete-section-clicked(id) => { root.delete-section-clicked(id); }
                    rename-section-clicked(id) => { root.rename-section-clicked(id); }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // 7. BOTTOM UTILITY BAR — Neo 2.0 glass surface
        Rectangle {
            height: root.collapsed ? 140px : 44px;
            background: Colors.surface.with-alpha(0.85);
            border-width: 1px;
            border-color: Colors.neo-highlight;
            drop-shadow-blur: Spacing.neo-blur-sm;
            drop-shadow-offset-y: -2px;
            drop-shadow-color: Colors.neo-shadow;

            // Expanded view: Profile + Jarvis + Settings on same row
            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm; padding-right: Spacing.sm; alignment: center; spacing: Spacing.sm;
                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(); }
                    HorizontalLayout {
                        spacing: Spacing.sm; alignment: start;
                        Avatar { size: 24px; source: root.user-avatar-source; fallback-text: root.user-initials; show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online : Colors.offline;
                        }
                        Text { text: root.user-display-name; color: Colors.text-secondary; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 4px;
                    background: jarvis-touch.has-hover ? Colors.surface-hover : transparent;
                    Image { source: Icons.jarvis; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.primary; }
                    jarvis-touch := TouchArea { clicked => { root.jarvis-clicked(); } }
                }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 4px;
                    background: sett-touch.has-hover ? Colors.surface-hover : transparent;
                    Image { source: Icons.settings; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                    sett-touch := TouchArea { clicked => { root.settings-clicked(); } }
                }
                Rectangle {
                    width: 24px; height: 24px;
                    Image { source: Icons.chevron-left; width: 14px; height: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                    TouchArea { clicked => { root.collapsed = !root.collapsed; root.toggle-collapsed(); } }
                }
            }

            // Collapsed view: Vertical stack of icons
            if root.collapsed: VerticalLayout {
                alignment: end; spacing: 8px; padding-bottom: 8px;
                TooltipArea {
                    height: 32px; width: 44px; x: (parent.width - self.width) / 2; tooltip-text: "Jarvis AI"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: 32px; height: 32px; border-radius: 16px; background: Colors.surface;
                        Image { source: Icons.jarvis; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        TouchArea { clicked => { root.jarvis-clicked(); } }
                    } }
                }
                TooltipArea {
                    height: 32px; width: 44px; x: (parent.width - self.width) / 2; tooltip-text: "Settings"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: 32px; height: 32px; border-radius: 16px; background: Colors.surface;
                        Image { source: Icons.settings; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        TouchArea { clicked => { root.settings-clicked(); } }
                    } }
                }
                TouchArea {
                    height: 32px; clicked => { root.profile-clicked(); }
                    HorizontalLayout { alignment: center;
                        Avatar { size: 28px; source: root.user-avatar-source; fallback-text: root.user-initials; show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online : Colors.offline;
                        }
                    }
                }
                TouchArea {
                    height: 24px; clicked => { root.collapsed = !root.collapsed; root.toggle-collapsed(); }
                    HorizontalLayout { alignment: center; Image { source: Icons.chevron-right; width: 14px; height: 14px; colorize: Colors.text-muted; } }
                }
            }
        }
    }

    // Section context menu overlay (renders on top of all sidebar content)
    SectionContextMenu {
        show: root.ctx-menu-show;
        position-x: root.ctx-menu-x;
        position-y: root.ctx-menu-y;
        conversation-id: root.ctx-menu-conv-id;
        conversation-type: root.ctx-menu-conv-type;
        current-section-id: root.ctx-menu-current-section-id;
        sections: root.custom-sections;

        close => {
            root.ctx-menu-show = false;
        }
        move-to-section(conv-id, conv-type, section-id) => {
            root.move-to-section(conv-id, conv-type, section-id);
        }
        remove-from-section(conv-id) => {
            root.remove-from-section(conv-id);
        }
        create-section-clicked => {
            root.create-section-clicked();
        }
    }
}
