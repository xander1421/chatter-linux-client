import { GlassSurface } from "../components/glass_surface.slint";
import { DesktopChrome } from "../theme/desktop_chrome.slint";
import { JarvisGlobal } from "../jarvis/jarvis_global.slint";
import { Materials } from "../theme/materials.slint";
import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { SidebarCardRow as PhonePinnedRow } from "card_types.slint";
import { PinnedStrip } from "pinned_strip.slint";
import { ChatRow, ChatRowData } from "chat_list.slint";
import { SectionHeader, CustomSectionData, SidebarRowData, SectionCard } from "section_card.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ChatListSkeleton } from "../components/skeleton.slint";
import { SidebarPane } from "../app_sidebar_pane.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { MeshList } from "../mesh/mesh_list.slint";
import { ConversationKind } from "../chat/conversation_kind.slint";
import { SidebarFooter, SidebarShieldToggle } from "sidebar_footer.slint";
import { SidebarRail } from "sidebar_rail.slint";
import { SidebarHeader } from "sidebar_header.slint";
import { ActivityBell } from "../activity/activity_bell.slint";
import { KeyFocus } from "../components/key_focus.slint";
import { SidebarCard, SidebarCardRow, SidebarCards } from "card_types.slint";
import { ChatsCard } from "chats_card.slint";
import { SavedCard } from "saved_card.slint";
import { SidebarCardDropTarget, SidebarNewSectionDropZone } from "card_drag.slint";

export { ChatRowData, CustomSectionData, SidebarRowData }


// Bare Flickable named ListView so the compiler virtualizes its `for`, as in
// chat/message_list.slint.
component ListView inherits Flickable {
    out property <length> visible-height: self.height;
    out property <length> visible-width: self.width;
    @children
}

component SidebarUtilityLink inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <int> count;
    in property <length> text-size;
    callback opened();

    border-radius: Spacing.radius-control;
    background: link-touch.has-hover ? Colors.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.count > 0 ? root.label + " · " + root.count : root.label;
    accessible-action-default => { root.opened(); }
    HorizontalLayout {
        padding-left: Spacing.panel-gutter;
        padding-right: Spacing.panel-gutter;
        spacing: Spacing.sm;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: Spacing.lg;
                height: self.width;
                colorize: Colors.text-secondary;
            }
        }
        Text {
            text: root.label;
            font-size: root.text-size;
            color: Colors.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.count > 0: Text {
            text: root.count;
            color: Colors.text-muted;
            font-size: Typography.xs;
            vertical-alignment: center;
        }
    }
    KeyFocus {
        border-radius: root.border-radius;
        activate => { root.opened(); }
    }
    link-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(); }
    }
}

export component Sidebar inherits Rectangle {
    // ── Properties: Data ──
    // The chat list, ordered by core (`ChatterClient::sidebar_rows`).
    in property <[ChatRowData]> chat-rows: [];
    in property <[ChatRowData]> archived-rows: [];
    in property <[PhonePinnedRow]> phone-pinned;
    in property <bool> archive-open: false;
    // Saved messages is the open conversation: its quick link is the
    // selected row, as a chat row is.
    in property <bool> saved-open: false;
    in property <string> saved-preview: "";
    in property <string> saved-time: "";
    property <bool> show-saved-preview: !root.collapsed && root.saved-preview != "";
    property <string> saved-label: root.show-saved-preview
        ? @tr("Saved messages: {}", root.saved-preview) : @tr("Saved messages");
    in property <bool> chat-rows-loading: false;
    in property <[CustomSectionData]> custom-sections: [];
    in property <[SidebarRowData]> flat-rows: [];
    // Screen-reader labels for the legacy phone and archive lists.
    pure function row-label(row: SidebarRowData) -> string {
        if row.kind == "chat" || row.kind == "section-chat" || row.kind == "archived-chat" {
            return row.chat.display-name;
        }
        if row.kind == "section-header" { return row.section.name; }
        if row.kind == "saved" { return root.saved-label; }
        if row.kind == "requests" { return @tr("Requests"); }
        if row.kind == "search" { return @tr("Search"); }
        if row.kind == "channel-actions" { return @tr("Create"); }
        if row.kind == "archive-entry" { return @tr("Archived chats"); }
        if row.kind == "archive-back" { return @tr("Back to chats"); }
        return row.kind;
    }
    in-out property <int> focus-index: 0;

    // ── Properties: User profile ──
    in property <string> user-display-name: @tr("User");
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";

    // ── Properties: State ──
    in-out property <bool> collapsed: false;
    private property <bool> card-rail: root.collapsed && !root.mobile-mode;
    property <bool> desktop-rail: root.collapsed && !root.touch;
    private property <bool> expanded-cards: !root.mobile-mode && !root.collapsed;
    private property <length> card-top-clearance: root.top-row-height
        + (DesktopChrome.macos ? Spacing.panel-gutter : 2 * Spacing.panel-gutter);
    private property <length> expanded-frame-inset: max(0px, Spacing.panel-gutter - DesktopChrome.frame-inset);
    private property <bool> framed-archive: root.expanded-cards && root.archive-open;
    private property <bool> show-card-list: root.expanded-cards && !root.archive-open && root.active-tab != "mesh";
    private property <int> focused-card-index: 0;
    // The Saved action and every other card header use the -1 slot.
    private property <int> focused-card-row: -1;
    private property <SidebarCard> focused-card: SidebarCards.cards[root.focused-card-index];
    private property <SidebarCardRow> focused-card-item: root.focused-card-row < 0
        ? { } : root.focused-card-row < root.focused-card.pinned.length
            ? root.focused-card.pinned[root.focused-card-row]
            : root.focused-card.rows[root.focused-card-row - root.focused-card.pinned.length];
    private property <length> card-viewport-y: 0px;
    private property <int> last-card-index: SidebarCards.cards.length - 1;
    private property <int> focused-card-last-row: root.last-card-row(root.focused-card);
    changed focused-card-last-row => {
        root.focused-card-row = min(root.focused-card-row, root.focused-card-last-row);
    }
    changed last-card-index => {
        if root.focused-card-index > root.last-card-index { root.reset-card-focus(); }
    }
    pure function last-card-row(card: SidebarCard) -> int {
        return card.collapsed || card.kind == "saved" ? -1
            : card.pinned.length + card.rows.length - 1;
    }
    function reset-card-focus() {
        root.focused-card-index = 0;
        root.focused-card-row = -1;
        root.card-viewport-y = 0px;
    }
    function reveal-card-focus(card-top: length, list-height: length, viewport-height: length) {
        let card = root.focused-card;
        let line-height = Spacing.row-height-desktop + Spacing.xxs;
        let header-height = Spacing.xxl + Spacing.xs + Spacing.xxs;
        let pinned-height = card.pinned.length > 0
            ? 34px + Spacing.md + Typography.xs * 1.4 + Spacing.xxs : 0px;
        let pinned = root.focused-card-row < card.pinned.length;
        let row-offset = root.focused-card-row < 0 ? 0px
            : pinned ? header-height
            : header-height + pinned-height + (root.focused-card-row - card.pinned.length) * line-height;
        let focus-height = root.focused-card-row < 0 && card.kind != "saved" ? header-height
            : pinned && root.focused-card-row >= 0 ? pinned-height : line-height;
        let top = card-top + row-offset + root.card-viewport-y;
        if top < 0px {
            root.card-viewport-y = min(0px, root.card-viewport-y - top);
        } else if top + focus-height > list-height {
            root.card-viewport-y = max(list-height - viewport-height,
                root.card-viewport-y - (top + focus-height - list-height));
        }
    }
    function step-card-focus(step: int) {
        if root.last-card-index < 0 { return; }
        if step == -2 {
            root.reset-card-focus();
        } else if step == 2 {
            root.focused-card-index = root.last-card-index;
            root.focused-card-row = root.last-card-row(root.focused-card);
        } else if step == 1 {
            if root.focused-card-row < root.last-card-row(root.focused-card) {
                root.focused-card-row += 1;
            } else if root.focused-card-index < root.last-card-index {
                root.focused-card-index += 1;
                root.focused-card-row = -1;
            }
        } else if root.focused-card-row >= 0 {
            root.focused-card-row -= 1;
        } else if root.focused-card-index > 0 {
            root.focused-card-index -= 1;
            root.focused-card-row = root.last-card-row(root.focused-card);
        }
    }
    function activate-card-focus() {
        if root.last-card-index < 0 { return; }
        if root.focused-card.kind == "saved" {
            root.saved-messages-clicked();
        } else if root.focused-card-row < 0 || root.focused-card.collapsed {
            SidebarCards.toggle-collapsed(root.focused-card.id);
        } else if !root.focused-card.collapsed && root.focused-card-item.conversation-id != "" {
            SidebarCards.open-row(root.focused-card-item.conversation-id);
        }
    }
    pure function section-sort-mode(index: int, section-id: string) -> string {
        let offset = SidebarCards.cards[0].kind == "saved" ? 2 : 1;
        let section = root.custom-sections[index - offset];
        return section.section-id == section-id ? section.sort-mode : "recent";
    }
    function card-row-menu(row: ChatRowData, card-id: string, x: length, y: length, row-y: length) {
        SidebarPane.anchor-card-row-menu(row, card-id, x, y, row-y - root.absolute-position.y);
        root.row-context-menu-opened(row.conversation-id, row.conversation-type);
        SidebarPane.row-context-menu-open = true;
    }
    function open-card-focus-menu() {
        let x = root.absolute-position.x + root.width / 2;
        let y = root.absolute-position.y + root.height / 2;
        if root.focused-card-row >= 0 && !root.focused-card.collapsed && root.focused-card-item.conversation-id != "" {
            root.card-row-menu(root.focused-card-item.chat-row, root.focused-card.id, x, y, y);
        } else if root.focused-card.kind == "section" && root.focused-card-row < 0 {
            SidebarPane.open-card-section-menu(root.focused-card.id,
                root.section-sort-mode(root.focused-card-index, root.focused-card.id), x, y);
        }
    }
    changed desktop-rail => {
        if (sidebar-keys.has-focus) { root.focus-step(-2); }
    }
    in-out property <bool> hidden: false;
    // The overlay animates from this row; the row stays in layout but its
    // glass and label recede while the one native search input takes over.
    in property <bool> search-overlay-open: false;
    in property <string> active-tab: "chats";
    // Compact (phone-width) layout: the panel IS the screen and the bottom tab
    // bar carries Contacts, Calls and Profile. Not "is a phone": a tablet
    // shows this panel beside the chat, with its own footer, like desktop.
    in property <bool> mobile-mode: false;
    // Touch input: sizes the targets. Independent of `mobile-mode`, so a
    // two-pane tablet keeps finger-sized rows.
    in property <bool> touch: false;
    // The server reachability fact drives the Activity bell and the compact
    // rail settings dot, where the sidebar header is hidden.
    in property <bool> server-unreachable: false;
    in property <string> connection-status: "connected";
    in property <length> mobile-width: 360px;
    // macOS unified titlebar: the traffic lights are drawn over this panel's
    // top-left corner (app.slint stopped reserving a row for them). Both are
    // 0 everywhere else, which turns every use below into a no-op.
    in property <length> traffic-lights-width: 0px;
    in property <length> titlebar-height: 0px;

    // ── Properties: Badges ──
    in property <int> pending-friend-requests: 0;
    in property <int> pending-message-requests: 0;
    in property <int> pending-group-invites: 0;
    in property <int> pending-channel-invites: 0;
    // Badge on the Calls quick-link; same count the phone tab bar shows.
    in property <int> missed-call-count: 0;
    property <int> total-pending-requests: root.pending-friend-requests
        + root.pending-message-requests + root.pending-group-invites + root.pending-channel-invites;
    property <bool> requests-row-was-visible: false;
    changed total-pending-requests => {
        let now-visible = root.total-pending-requests > 0;
        if (now-visible != root.requests-row-was-visible) {
            // A row inserted above the visible conversations must not move
            // the content already under the user's finger.
            if (!root.show-card-list && root.active-tab == "chats" && central-scroll.viewport-y < -((root.collapsed
                    ? (DesktopChrome.macos ? max(0px, root.titlebar-height - 2 * Spacing.sm) : root.traffic-lights-width > Spacing.none ? root.titlebar-height : Spacing.none)
                    : root.top-row-height) + (root.mobile-mode ? Spacing.none : Spacing.sm))) {
                central-scroll.viewport-y += now-visible ? -root.quick-link-height : root.quick-link-height;
            }
            root.requests-row-was-visible = now-visible;
        }
    }

    // ── Callbacks ──
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback search-clicked();
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback friends-clicked();
    callback add-friend-clicked();
    callback calls-clicked();
    callback profile-clicked();
    callback friend-requests-clicked();
    callback message-requests-clicked();
    callback group-invites-clicked();
    callback channel-invites-clicked();
    callback toggle-collapsed();
    callback settings-clicked();
    callback tab-selected(string);
    callback anon-mode-clicked();
    callback create-section-clicked();
    // The two-pane '+' in the header row: opens New Chat / New Channel /
    // New Section. On a phone the Chats tab's floating button does (app.slint).
    callback create-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ ConversationKind);
    callback focus-composer();
    callback focus-target(int, int, bool, bool, bool, bool) -> int;
    function focus-step(move-by: int) {
        root.focus-index = root.focus-target(root.focus-index, move-by,
            root.mobile-mode || (root.collapsed && root.touch), AnonMode.enabled,
            root.total-pending-requests > 0, root.desktop-rail);
        if (move-by == -2) {
            central-scroll.viewport-y = 0px;
        } else if (move-by == 2) {
            central-scroll.viewport-y = min(0px, central-scroll.height - central-scroll.viewport-height);
        } else {
            central-scroll.viewport-y = max(central-scroll.height - central-scroll.viewport-height,
                min(0px, -(root.focus-index * Spacing.row-height-desktop)));
        }
    }
    function open-focused() {
        if (root.focus-index < 0 || root.focus-index >= root.flat-rows.length) { return; }
        let entry = root.flat-rows[root.focus-index];
        if (root.desktop-rail) {
            if (entry.kind == "search") { root.search-clicked(); return; }
            if (entry.kind == "channel-actions") { root.create-clicked(); return; }
            if (entry.kind != "chat" && entry.kind != "section-chat" && entry.kind != "archived-chat") { return; }
        }
        if (entry.kind == "saved") { root.saved-messages-clicked(); }
        else if (entry.kind == "requests") {
            root.message-requests-clicked(); root.group-invites-clicked();
            root.channel-invites-clicked(); root.friend-requests-clicked();
        }
        else if (entry.kind == "archive-entry" || entry.kind == "archive-back") {
            root.archive-view-changed(entry.kind == "archive-entry");
        }
        else if (entry.kind == "section-header") { root.section-toggle-expanded(entry.section.section-id); }
        else if (entry.kind == "section-chat") {
            root.section-conversation-selected(entry.chat.conversation-id, entry.chat.conversation-type);
        }
        else if (entry.kind == "chat" || entry.kind == "archived-chat") {
            if (entry.chat.conversation-type == ConversationKind.channel || entry.chat.conversation-type == ConversationKind.saved-messages) {
                root.channel-selected(entry.chat.conversation-id);
            } else if (entry.chat.conversation-type == ConversationKind.anon-group) {
                root.private-group-selected(entry.chat.conversation-id);
            } else { root.dm-selected(entry.chat.conversation-id); }
        }
    }
    function open-focused-menu() {
        if (root.focus-index < 0 || root.focus-index >= root.flat-rows.length) { return; }
        let entry = root.flat-rows[root.focus-index];
        if (entry.kind == "section-header") {
            SidebarPane.section-header-ctx-menu-section-id = entry.section.section-id;
            SidebarPane.section-header-ctx-menu-sort-mode = entry.section.sort-mode;
            SidebarPane.section-header-ctx-menu-x = root.width / 2;
            SidebarPane.section-header-ctx-menu-y = root.height / 2;
            SidebarPane.row-context-menu-open = false;
            SidebarPane.section-context-menu-open = true;
        }
    }
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ ConversationKind, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);
    callback set-conversation-pinned(/* conversation-id */ string, /* pinned */ bool);
    callback set-conversation-archived(/* conversation-id */ string, /* archived */ bool);
    callback row-context-menu-opened(/* conversation-id */ string, /* kind */ ConversationKind);
    function open-loose-row-menu(row: ChatRowData, x: length, y: length, row-y: length, archived: bool) {
        SidebarPane.ctx-menu-row = row;
        SidebarPane.ctx-menu-row-y = row-y - root.absolute-position.y;
        SidebarPane.ctx-menu-conv-id = row.conversation-id;
        SidebarPane.ctx-menu-conv-type = row.conversation-type;
        SidebarPane.ctx-menu-is-pinned = row.is-pinned;
        SidebarPane.ctx-menu-is-archived = archived;
        SidebarPane.ctx-menu-can-leave = row.can-leave;
        SidebarPane.ctx-menu-can-delete = row.can-delete;
        SidebarPane.ctx-menu-x = x;
        SidebarPane.ctx-menu-y = y;
        SidebarPane.ctx-menu-current-section-id = "";
        SidebarPane.section-context-menu-open = false;
        root.row-context-menu-opened(row.conversation-id, row.conversation-type);
        SidebarPane.row-context-menu-open = true;
    }
    callback set-conversation-muted(/* conversation-id */ string, /* kind */ ConversationKind, /* muted */ bool);
    callback archive-view-changed(bool);
    // Unarchiving the last chat leaves nothing to show: go back to the list.
    private property <int> archived-count: root.archived-rows.length;
    changed archived-count => {
        if root.archive-open && root.archived-count == 0 { root.archive-view-changed(false); }
    }
    callback delete-conversation(/* conversation-id */ string, /* kind */ ConversationKind);
    callback leave-conversation(/* conversation-id */ string, /* kind */ ConversationKind);
    callback move-section(/* section-id */ string, /* delta */ int);
    callback set-section-sort-mode(/* section-id */ string, /* mode */ string);

    // ── Internal state ──
    // Search and empty Saved messages use the compact one-line geometry.
    // With a preview, expanded Saved messages uses the conversation row height.
    // Collapsed links use the rail geometry.
    property <length> quick-link-height: root.collapsed && DesktopChrome.macos ? 36px
        : (root.touch ? 56px : root.collapsed ? 48px : 34px) * Appearance.text-grow;
    // The panel's first row, pinned above the scroll. On desktop it takes the
    // shared header height so it and the conversation header beside it read as
    // one row across the seam — and on macOS that is the row the traffic
    // lights are in. Mobile takes the quick-link height: there the panel IS
    // the screen, and Search and Saved Messages read as two rows of one list
    // (Signal: search bar, then Note to Self). At the conversation-row height
    // plus the scroll's top padding they sat ~80dp apart (owner, 2026-09-26).
    // A two-pane tablet sits beside a touch-height conversation header.
    property <length> top-row-height: root.mobile-mode ? root.quick-link-height
        : root.touch ? Spacing.header-height-touch : DesktopChrome.macos ? 72px : Spacing.header-height;
    property <length> quick-link-text-size: root.touch ? Typography.base : Typography.sm2;
    property <brush> quick-link-text-color: Colors.text-primary;
    property <length> quick-link-icon-size: root.touch ? 24px : 14px;
    // Quick-link icons sit in the conversation rows' avatar column: the same
    // leading inset (ChatList's xs + the row's sm) and a slot as wide as a
    // row's avatar ring, icon centred in it — so the lens, bookmark and the
    // rest line up with the avatars and channel icons below, and the labels
    // with the names.
    property <length> quick-link-inset: Spacing.xs + Spacing.sm;
    property <length> quick-link-slot: (root.touch ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop) + 4px;
    // The expanded panel's footer row. 36px on touch, not the full 48px
    // minimum: the panel is capped at 45% of a phone's width, and three 48px
    // buttons plus the avatar and name overflowed it — which silently pushed
    // the LAST button (collapse) off the right edge, stranding the user in the
    // expanded state. 36px is the largest that fits with the collapse control
    // still on screen; the rail's buttons, which have the whole width to
    // themselves, keep the full 48px.
    property <length> footer-icon-size: root.touch ? 36px : 24px;
    // One size for every button in the collapsed rail's bottom cluster, so the
    // container height below stays in step with them.
    property <length> rail-icon-size: root.touch ? Spacing.touch-target-min : DesktopChrome.macos ? 36px : 44px;
    // The visual plate inside a rail row. Smaller than the row so adjacent slots
    // do not touch; the row stays the touch target, the slot is what you see.
    // 44px everywhere: the conversation rows' collapsed slot
    // (channel_list_item.slint `slot-size`), so the rail reads as one column.
    property <length> rail-slot-size: DesktopChrome.macos ? 36px : 44px;
    property <length> rail-gap: DesktopChrome.macos ? DesktopChrome.rail-gap : Spacing.sm;
    property <length> rail-divider-height: DesktopChrome.macos ? 8px : Spacing.md;
    property <length> rail-footer-height: root.desktop-rail ? root.rail-icon-size + Spacing.sm
        : DesktopChrome.macos
        ? root.rail-button-count * root.rail-icon-size + root.rail-button-count * root.rail-gap
            + root.rail-divider-height + Spacing.sm
        : root.rail-button-count * root.rail-icon-size + (root.rail-button-count - 1) * Spacing.sm
            + Spacing.lg + Spacing.md + Spacing.sm;
    property <length> rail-slot-radius: Spacing.radius-lg;
    property <brush> rail-slot-bg: DesktopChrome.macos ? transparent : Colors.surface-control;
    // The desktop rail has a single footer control. Touch retains its cluster.
    property <int> rail-button-count: root.touch ? 5 + (MeshGlobal.enabled ? 1 : 0)
        + (JarvisGlobal.enabled && JarvisGlobal.opted-in ? 1 : 0) : 1;

    // ── Sizing ──
    // Always a side panel, on every platform: collapsed to the icon rail or
    // expanded to the list, never a full-screen view that swaps the chat out.
    // `touch` sizes the targets; `mobile-mode` (compact width) is what makes
    // the expanded panel full-screen.
    // Expanded on touch, the panel takes the WHOLE screen. 240px is 58% of a
    // 411dp phone and 45% is not much better: at either width the panel is too
    // cramped to browse folders in and the chat behind it is too narrow to read,
    // so the split served neither. Expanded is now a full-screen list you go to,
    // browse, and leave by collapsing back to the rail — the rail is what keeps
    // navigation always-available, which is why the panel does not have to.
    // `mobile-width` is fed the window width by app.slint.
    width: root.hidden ? Spacing.sidebar-width-hidden
         : root.collapsed ? (root.touch ? 68px : DesktopChrome.macos ? DesktopChrome.rail-width : Spacing.sidebar-width-collapsed)
         : root.mobile-mode ? root.mobile-width
         : DesktopChrome.macos ? DesktopChrome.sidebar-width : Spacing.sidebar-width;
    visible: !root.hidden;
    background: root.expanded-cards || root.card-rail || root.touch || root.mobile-mode ? transparent
              : AnonMode.enabled ? Colors.primary.with-alpha(0.08)
              : Colors.surface;
    border-radius: root.expanded-cards || root.mobile-mode ? Spacing.none
        : DesktopChrome.frame-inset > 0px ? DesktopChrome.panel-radius : Spacing.radius-chrome;

    // No animation on a phone: the list is full width there, and animating
    // from the pre-resize width drew a half-width first frame at launch.
    animate width { duration: root.mobile-mode ? 0ms : Materials.menu-duration; easing: ease-out; }

    in property <length> bottom-inset: 0px;

    Rectangle {
        visible: !root.card-rail;
        // Clip the list and glass chrome together. Child/backdrop painting must
        // not fill the square corners outside the tablet panel silhouette.
        border-radius: root.border-radius;
        clip: true;
        // ════════════════════════════════════════
        // FIXED TOP ROW — the app's title row
        // ════════════════════════════════════════
        // Search sits here rather than at the head of the scroll below for two
        // reasons: it is the row Telegram (and every native list app) keeps
        // pinned, and on macOS the traffic lights are painted over this corner,
        // so a row that scrolls would slide conversations under them.

        // ════════════════════════════════════════
        // SCROLLABLE CENTRAL CONTENT
        // ════════════════════════════════════════
        if root.framed-archive: Rectangle {
            x: root.expanded-frame-inset;
            y: root.card-top-clearance;
            width: root.width - self.x - Spacing.panel-gutter;
            height: max(0px, root.height - self.y - Spacing.panel-gutter);
            border-radius: Spacing.radius-panel;
            border-width: Spacing.stroke;
            border-color: Colors.border;
            background: Colors.background;
        }
        central-scroll := ListView {
            visible: !root.show-card-list && (root.active-tab != "mesh" || root.desktop-rail);
            x: root.framed-archive ? root.expanded-frame-inset + Spacing.panel-gutter : 0px;
            y: root.framed-archive ? root.card-top-clearance + Spacing.panel-gutter : 0px;
            width: root.framed-archive ? root.width - self.x - 2 * Spacing.panel-gutter : root.width;
            height: root.framed-archive ? max(0px, root.height - self.y - 2 * Spacing.panel-gutter) : root.height;
            immediate-child-press: true;
            // Leave predominantly horizontal swipes to the nested pinned strip.
            drag-axis-lock: root.mobile-mode;

            for entry[idx] in root.flat-rows: VerticalLayout {
                property <bool> roving-highlight: sidebar-keys.has-focus && Appearance.keyboard-focus-visible && root.focus-index == idx;
                changed roving-highlight => {
                    if (self.roving-highlight) {
                        let top = self.absolute-position.y - central-scroll.absolute-position.y;
                        let obscured = root.framed-archive ? 0px : root.top-row-height;
                        if (top < obscured) {
                            central-scroll.viewport-y = min(0px, central-scroll.viewport-y + obscured - top);
                        } else if (top + self.height > central-scroll.height) {
                            central-scroll.viewport-y = max(central-scroll.height - central-scroll.viewport-height,
                                central-scroll.viewport-y - (top + self.height - central-scroll.height));
                        }
                    }
                }
                width: central-scroll.width;
                height: self.preferred-height;
                spacing: Spacing.none;
                // The pinned title and the floating footer stay outside the
                // virtualized content; only their scroll clearance is a row.
                padding-top: idx == 0 && !root.framed-archive
                    ? (root.collapsed ? (DesktopChrome.macos ? max(0px, root.titlebar-height - 2 * Spacing.sm) : root.traffic-lights-width > Spacing.none ? root.titlebar-height : Spacing.none) : root.top-row-height)
                        + (root.mobile-mode ? Spacing.none : Spacing.sm)
                    : Spacing.none;
                padding-bottom: root.framed-archive && (entry.kind == "archive-back" || entry.kind == "archived-chat")
                    ? Spacing.panel-gutter
                    : entry.kind == "bottom" && !root.framed-archive
                    ? (root.mobile-mode
                        ? root.bottom-inset + Spacing.fab-size + Spacing.xl + Spacing.md
                        : (root.collapsed ? root.rail-footer-height : Spacing.button-height)
                            + Spacing.md)
                    : Spacing.none;
                if !root.desktop-rail && (entry.kind == "archive-entry" || entry.kind == "archive-back"): GlassSurface {
                    height: root.quick-link-height;
                    border-radius: root.framed-archive ? Spacing.radius-panel : 0px;
                    material-enabled: root.framed-archive;
                    show-edge: root.framed-archive;
                    elevation: 0;
                    accessible-role: button;
                    accessible-label: entry.kind == "archive-back" ? @tr("Back to chats") : @tr("Archived chats");
                    accessible-action-default => { root.archive-view-changed(entry.kind == "archive-entry"); }
                    border-width: archive-keys.has-focus || parent.roving-highlight ? 2px : 0px;
                    border-color: Colors.focus-ring;
                    archive-keys := FocusScope {
                        width: 0px; height: 0px;
                        focus-on-tab-navigation: false;
                        key-pressed(event) => {
                            if event.text == Key.Space || event.text == Key.Return {
                                root.archive-view-changed(entry.kind == "archive-entry");
                                return accept;
                            }
                            return reject;
                        }
                    }
                    HorizontalLayout {
                        padding-left: root.quick-link-inset;
                        padding-right: Spacing.md;
                        spacing: Spacing.sm;
                        // Same centred icon slot as the Saved Messages row.
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image {
                                source: entry.kind == "archive-back" ? Icons.chevron-left : Icons.folder;
                                width: root.quick-link-icon-size;
                                height: root.quick-link-icon-size;
                                colorize: Colors.text-secondary;
                            } }
                        }
                        Text {
                            // Inside, the row titles the list it heads, as Telegram's
                            // "Archived Chats" bar; its chevron is the way back.
                            text: entry.kind == "archive-back" ? @tr("Archived chats") : @tr("Archived");
                            font-weight: entry.kind == "archive-back" ? Typography.semibold : Typography.normal;
                            color: Colors.text-primary;
                            font-size: root.framed-archive ? 14px * Appearance.text-scale : root.quick-link-text-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if entry.kind == "archive-entry": Text {
                            text: root.archived-rows.length;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.archive-view-changed(entry.kind == "archive-entry"); }
                    }
                }
                if entry.kind == "archive-empty" && !root.desktop-rail: Text {
                    text: @tr("No archived chats");
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    height: root.quick-link-height;
                }
                if entry.kind == "search" && root.collapsed && (!SidebarPane.archive-open || root.desktop-rail): Rectangle {
                    height: root.quick-link-height;
                    border-width: parent.roving-highlight ? 2px : 0px;
                    border-color: Colors.focus-ring;
                    opacity: root.search-overlay-open ? 0 : 1;
                    animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
                    accessible-role: button;
                    accessible-label: @tr("Search");
                    accessible-action-default => { root.search-clicked(); }
                    TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: @tr("Search"); tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: Icons.search; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    TouchArea { enabled: !root.search-overlay-open; mouse-cursor: pointer; clicked => { root.search-clicked(); } }
                }


                if entry.kind == "saved" && !root.desktop-rail && !AnonMode.enabled: Rectangle {
                    height: root.show-saved-preview
                        ? (root.touch ? Spacing.row-height-touch : Spacing.row-height-desktop) + Spacing.xxs
                        : root.quick-link-height;
                    property <bool> press-active: false;
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;
                    // Match the chat rows’ inset and radius.
                    Rectangle {
                        x: root.collapsed ? 0px : Spacing.xs;
                        width: parent.width - 2 * self.x;
                        height: parent.height;
                        border-radius: root.collapsed ? 0px : Spacing.radius-md;
                        background: root.saved-open && !root.collapsed ? Colors.row-selected
                            : parent.press-active ? Colors.surface-control-hover
                            : (!root.mobile-mode && saved-touch.has-hover) ? Colors.surface-hover : transparent;
                        animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    }
                    accessible-role: list-item;
                    accessible-label: root.saved-label;
                    accessible-action-default => { root.saved-messages-clicked(); }
                    border-width: parent.roving-highlight ? 2px : 0px;
                    border-color: Colors.focus-ring;
                    Rectangle {
                        opacity: root.saved-open && !root.collapsed ? 1 : 0;
                        animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
                        x: Spacing.xs;
                        width: 2px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: Colors.selected-indicator;
                    }
                    if !root.collapsed && !root.show-saved-preview: HorizontalLayout {
                        padding-left: root.quick-link-inset; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image { source: Icons.bookmark; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; } }
                        }
                        Text { text: @tr("Saved messages"); color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    if root.show-saved-preview: HorizontalLayout {
                        x: Spacing.xs;
                        width: parent.width - 2 * self.x;
                        height: parent.height - Spacing.xxs;
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;

                        Rectangle {
                            width: (root.touch ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop) + 4px;
                            Image {
                                source: Icons.bookmark;
                                width: root.touch ? 24px : 16px;
                                height: self.width;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.text-secondary;
                            }
                        }
                        VerticalLayout {
                            min-width: 0px;
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: root.touch ? Spacing.xs : Spacing.xxs;
                            Text {
                                text: @tr("Saved messages");
                                min-width: 0px;
                                color: Colors.text-primary;
                                font-size: root.touch ? Typography.base : Typography.sm;
                                font-weight: 500;
                                overflow: elide;
                            }
                            Rectangle {
                                property <length> preview-size: root.touch ? Typography.sm : Typography.xs;
                                height: self.preview-size * 1.4;
                                clip: true;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.saved-preview;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    color: Colors.text-muted;
                                    font-size: parent.preview-size;
                                }
                            }
                        }
                        Text {
                            text: root.saved-time;
                            horizontal-stretch: 0;
                            wrap: no-wrap;
                            color: Colors.text-muted;
                            font-size: Typography.xs2;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: @tr("Saved messages"); tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.saved-open ? Colors.row-selected : root.rail-slot-bg; Image { source: Icons.bookmark; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: root.saved-open ? Colors.text-primary : Colors.text-secondary; } } } }
                    }
                    // Open in the rail: the same accent pill and filled slot a
                    // selected conversation gets (channel_list_item.slint).
                    if root.collapsed && root.saved-open: Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 3px;
                        height: 20px;
                        border-radius: Spacing.radius-full;
                        background: Colors.primary;
                    }
                    saved-touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                parent.press-x = self.mouse-x;
                                parent.press-y = self.mouse-y;
                                parent.press-active = true;
                            } else if (event.kind == PointerEventKind.move
                                && (abs(self.mouse-x - parent.press-x) > Spacing.sm
                                    || abs(self.mouse-y - parent.press-y) > Spacing.sm)) {
                                parent.press-active = false;
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                parent.press-active = false;
                            }
                        }
                        clicked => { root.saved-messages-clicked(); }
                    }
                }

                // REQUESTS entry point — one calm row, not four competing
                // alert banners. Friend requests, message requests, group
                // invites, and channel invites used to each render their own
                // full-width colored banner (bold text, its own accent color)
                // any time their count was nonzero, so a user with several
                // kinds of pending item at once saw a wall of near-identical
                // "look at me" rows before reaching a single conversation —
                // everything shouting is the same as nothing being
                // prioritized. This is one row in the same quiet style as
                // Search/Saved Messages/Friends above it, with the combined
                // count as its badge; the four kinds live one level deeper,
                // as tabs already built into the Friends modal's Requests
                // tab (requests-sub-tab: received/sent/private/groups/
                // channels) — nothing lost, just not all surfaced at once.

                if entry.kind == "requests" && !root.desktop-rail && root.total-pending-requests > 0: Rectangle {
                    height: root.quick-link-height;
                    accessible-role: list-item;
                    accessible-label: root.total-pending-requests == 1 ? "1 request" : root.total-pending-requests + " requests";
                    accessible-action-default => {
                        root.message-requests-clicked();
                        root.group-invites-clicked();
                        root.channel-invites-clicked();
                        root.friend-requests-clicked();
                    }
                    border-width: parent.roving-highlight ? 2px : 0px;
                    border-color: Colors.focus-ring;
                    background: requests-touch.pressed ? Colors.surface-control-hover
                        : requests-touch.has-hover ? Colors.surface-hover : transparent;
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }

                    if !root.collapsed: HorizontalLayout {
                        padding-left: root.quick-link-inset; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image { source: Icons.user-plus; width: 14px; height: 14px; colorize: Colors.text-secondary; } }
                        }
                        Text { text: @tr("Requests"); color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; horizontal-stretch: 1; }
                        // Centred on the label's line; a fixed-height child of a
                        // HorizontalLayout otherwise sits at the row's top.
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            if root.total-pending-requests > 0: Rectangle {
                                width: self.height + (root.total-pending-requests > 9 ? 4px : 0px);
                                height: Spacing.badge-md;
                                border-radius: self.height / 2;
                                background: Colors.error-hover;
                                Text {
                                    text: root.total-pending-requests > 9 ? "9+" : root.total-pending-requests;
                                    color: Colors.on-error;
                                    font-size: Typography.xs2;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: @tr("Requests"); tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                            Image { source: Icons.user-plus; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 20px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                            if root.total-pending-requests > 0: Rectangle {
                                x: parent.width - 8px; y: -2px;
                                width: 12px; height: 12px; border-radius: 6px;
                                border-width: 1px; border-color: Colors.surface;
                                background: Colors.error;
                            }
                        } } }
                    }

                    requests-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // Refresh every request kind's list and badge,
                            // then open Contacts › Requests. Only
                            // friend-requests-clicked opens it (app.slint
                            // picks the first non-empty sub-tab), so it must
                            // fire on every tap — skipping it when only a
                            // channel invite was pending made the row dead.
                            root.message-requests-clicked();
                            root.group-invites-clicked();
                            root.channel-invites-clicked();
                            root.friend-requests-clicked();
                        }
                    }
                }

                if entry.kind == "saved" && root.mobile-mode && root.phone-pinned.length > 0: PinnedStrip {
                    rows: root.phone-pinned;
                    touch: root.touch;
                    immediate-child-press: root.touch;
                    drag-axis-lock: root.touch;
                    row-context-menu-requested(row, x, y, row-y) => {
                        root.open-loose-row-menu(row, x, y, row-y, false);
                    }
                }

                // 4. CHATS — one list of every loose conversation, newest
                // activity first, pinned first (Signal/Telegram). It used to be
                // a "Messages" block above a "Channels" block, so a channel with
                // newer activity never rose above a DM; creating a chat or a
                // channel lives in the top row's Create menu (and the phone's
                // floating button), not in per-block headers.
                // The collapsed rail keeps the create action within reach.

                if entry.kind == "channel-actions" && root.collapsed
                    && (root.desktop-rail || (!SidebarPane.archive-open && !AnonMode.enabled)): VerticalLayout {
                    spacing: Spacing.xs;
                    padding-top: DesktopChrome.macos ? 0px : Spacing.xs;
                    padding-bottom: DesktopChrome.macos ? 0px : Spacing.xs;

                    TooltipArea {
                        height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: root.desktop-rail ? @tr("Create") : @tr("New channel"); tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                            background: c-new-touch.has-hover ? Colors.surface-hover.brighter(0.6) : root.rail-slot-bg;
                            border-width: root.desktop-rail && sidebar-keys.has-focus && Appearance.keyboard-focus-visible && root.focus-index == idx ? 2px : 0px;
                            border-color: Colors.focus-ring;
                            accessible-role: button;
                            accessible-label: root.desktop-rail ? @tr("Create") : @tr("New channel");
                            accessible-action-default => { if root.desktop-rail { root.create-clicked(); } else { root.create-channel-clicked(); } }
                            Image { source: Icons.plus; width: DesktopChrome.macos ? DesktopChrome.rail-glyph : 16px; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-new-touch.has-hover ? Colors.text-primary : DesktopChrome.macos ? Colors.text-secondary : Colors.text-muted; }
                            c-new-touch := TouchArea { mouse-cursor: pointer; clicked => { if root.desktop-rail { root.create-clicked(); } else { root.create-channel-clicked(); } } }
                        } }
                    }


                }


                if entry.kind == "empty" && !root.collapsed && !root.chat-rows-loading: VerticalLayout {
                    padding-top: Spacing.md;
                    padding-bottom: Spacing.md;
                    spacing: Spacing.xs;
                    EmptyState {
                        icon: Icons.message-circle;
                        message: @tr("No conversations");
                        cta-text: @tr("Add a friend");
                        cta-clicked => { root.add-friend-clicked(); }
                    }
                    if !AnonMode.enabled: HorizontalLayout {
                        height: Spacing.touch-target-min;
                        alignment: center;
                        Text {
                            text: @tr("Browse channels");
                            accessible-role: button;
                            accessible-label: @tr("Browse channels");
                            accessible-action-default => { root.join-channel-clicked(); }
                            color: browse-touch.has-hover ? Colors.primary-hover : Colors.primary;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.join-channel-clicked(); }
                            }
                        }
                    }
                }
                if entry.kind == "loading" && root.chat-rows-loading && root.chat-rows.length == 0 && !root.collapsed: VerticalLayout {
                    spacing: Spacing.xxs;
                    for placeholder in [0, 1, 2, 3, 4]: ChatListSkeleton { mobile-mode: root.touch; }
                }
                if entry.kind == "archived-chat" || (entry.kind == "chat"
                    && !(root.mobile-mode && root.phone-pinned.length > 0 && entry.chat.is-pinned)): Rectangle {
                    height: (root.collapsed ? 48px : root.touch ? Spacing.row-height-touch : Spacing.row-height-desktop)
                        + (root.framed-archive ? 2 * Spacing.sm : Spacing.xxs);
                    border-radius: root.framed-archive ? Spacing.radius-panel : 0px;
                    background: root.framed-archive ? Colors.surface-card : transparent;
                    chat-row := ChatRow {
                        x: root.framed-archive ? Spacing.sm : Spacing.xs;
                        width: parent.width - 2 * self.x;
                        card-mode: root.framed-archive;
                        data: entry.chat;
                        collapsed: root.collapsed;
                        mobile-mode: root.touch;
                        keyboard-highlight: sidebar-keys.has-focus && Appearance.keyboard-focus-visible && root.focus-index == idx;
                        clicked => {
                            if entry.chat.conversation-type == ConversationKind.channel || entry.chat.conversation-type == ConversationKind.saved-messages {
                                root.channel-selected(entry.chat.conversation-id);
                            } else if entry.chat.conversation-type == ConversationKind.anon-group {
                                root.private-group-selected(entry.chat.conversation-id);
                            } else {
                                root.dm-selected(entry.chat.conversation-id);
                            }
                        }
                        pin-requested(pinned) => { root.set-conversation-pinned(entry.chat.conversation-id, pinned); }
                        context-menu-requested(x, y) => {
                            root.open-loose-row-menu(entry.chat, x, y, chat-row.absolute-position.y,
                                entry.kind == "archived-chat");
                        }
                    }
                }
                if entry.kind == "section-header" && !root.desktop-rail: SectionHeader {
                    keyboard-highlight: parent.roving-highlight;
                    section-id: entry.section.section-id;
                    name: entry.section.name;
                    icon-emoji: entry.section.icon-emoji;
                    is-expanded: entry.section.is-expanded;
                    unread-count: entry.section.unread-count;
                    collapsed: root.collapsed;
                    mobile-mode: root.touch;
                    toggle-expanded => { root.section-toggle-expanded(entry.section.section-id); }
                    context-menu-requested(x, y) => {
                        SidebarPane.section-header-ctx-menu-section-id = entry.section.section-id;
                        SidebarPane.section-header-ctx-menu-x = x;
                        SidebarPane.section-header-ctx-menu-y = y;
                        SidebarPane.section-header-ctx-menu-sort-mode = entry.section.sort-mode;
                        SidebarPane.row-context-menu-open = false;
                        SidebarPane.section-context-menu-open = true;
                    }
                }
                if entry.kind == "section-chat": Rectangle {
                    height: (root.collapsed ? 48px : root.touch ? Spacing.row-height-touch : Spacing.row-height-desktop) + Spacing.xxs;
                    section-chat-row := ChatRow {
                        x: Spacing.xs;
                        width: parent.width - 2 * Spacing.xs;
                        data: entry.chat;
                        collapsed: root.collapsed;
                        mobile-mode: root.touch;
                        keyboard-highlight: sidebar-keys.has-focus && Appearance.keyboard-focus-visible && root.focus-index == idx;
                        clicked => { root.section-conversation-selected(entry.chat.conversation-id, entry.chat.conversation-type); }
                        pin-requested(pinned) => { root.set-conversation-pinned(entry.chat.conversation-id, pinned); }
                        context-menu-requested(x, y) => {
                            SidebarPane.ctx-menu-row = entry.chat;
                            SidebarPane.ctx-menu-row-y = section-chat-row.absolute-position.y - root.absolute-position.y;
                            SidebarPane.ctx-menu-conv-id = entry.chat.conversation-id;
                            SidebarPane.ctx-menu-can-leave = entry.chat.can-leave;
                            SidebarPane.ctx-menu-can-delete = entry.chat.can-delete;
                            SidebarPane.ctx-menu-conv-type = entry.chat.conversation-type;
                            SidebarPane.ctx-menu-x = x;
                            SidebarPane.ctx-menu-y = y;
                            SidebarPane.ctx-menu-current-section-id = entry.section.section-id;
                            SidebarPane.ctx-menu-is-pinned = entry.chat.is-pinned;
                            SidebarPane.ctx-menu-is-archived = false;
                            SidebarPane.section-context-menu-open = false;
                            root.row-context-menu-opened(entry.chat.conversation-id, entry.chat.conversation-type);
                            SidebarPane.row-context-menu-open = true;
                        }
                    }
                }
            }
        }
        if root.show-card-list: card-scroll := Flickable {
            x: root.expanded-frame-inset;
            y: root.card-top-clearance;
            width: max(0px, root.width - self.x - Spacing.panel-gutter);
            height: max(0px, root.height - self.y - Spacing.xxxl - root.expanded-frame-inset - Spacing.panel-gutter);
            viewport-height: max(self.height, card-column.preferred-height);
            viewport-y <=> root.card-viewport-y;
            immediate-child-press: true;
            drag-axis-lock: root.touch;

            card-column := VerticalLayout {
                width: parent.width;
                spacing: Spacing.panel-gutter;

                for card[index] in SidebarCards.cards: card-slot := Rectangle {
                    height: card-content.preferred-height;
                    property <bool> current: root.focused-card-index == index;
                    property <bool> highlighted: self.current && sidebar-keys.has-focus && Appearance.keyboard-focus-visible;
                    property <int> reveal-row: self.current ? root.focused-card-row : -2;
                    changed reveal-row => {
                        if self.current && sidebar-keys.has-focus {
                            let top = self.absolute-position.y - card-scroll.absolute-position.y - root.card-viewport-y;
                            root.reveal-card-focus(top, card-scroll.height, card-scroll.viewport-height);
                        }
                    }
                    card-content := VerticalLayout {
                        if card.kind == "saved": SavedCard {
                            preview: card.rows[0].preview;
                            time-label: card.rows[0].time-label;
                            selected: root.saved-open;
                            roving: true;
                            roving-highlight: card-slot.highlighted;
                            border-radius: Spacing.radius-panel;
                            opened => { root.saved-messages-clicked(); }
                        }
                        if card.kind == "chats": ChatsCard {
                            card: card;
                            touch: root.touch;
                            empty-text: root.chat-rows-loading || !card.show-empty-hint ? "" : @tr("Friends you add appear here.");
                            header-highlight: card-slot.highlighted && (root.focused-card-row < 0 || card.collapsed);
                            highlighted-row: card-slot.highlighted ? root.focused-card-row : -1;
                            pin-requested(id, pinned) => { root.set-conversation-pinned(id, pinned); }
                            row-context-menu-requested(row, x, y, row-y) => {
                                root.card-row-menu(row, card.id, x, y, row-y);
                            }
                        }
                        if card.kind == "section": SectionCard {
                            card: card;
                            touch: root.touch;
                            header-highlight: card-slot.highlighted && (root.focused-card-row < 0 || card.collapsed);
                            highlighted-row: card-slot.highlighted ? root.focused-card-row : -1;
                            pin-requested(id, pinned) => { root.set-conversation-pinned(id, pinned); }
                            header-context-menu-requested(x, y) => {
                                SidebarPane.open-card-section-menu(card.id, root.section-sort-mode(index, card.id), x, y);
                            }
                            row-context-menu-requested(row, x, y, row-y) => {
                                root.card-row-menu(row, card.id, x, y, row-y);
                            }
                        }
                    }
                    if card.kind != "saved": SidebarCardDropTarget {
                        card-id: card.id;
                        width: parent.width;
                        height: parent.height;
                    }
                }

                if root.archived-rows.length > 0: SidebarUtilityLink {
                    height: root.quick-link-height;
                    label: @tr("Archived chats");
                    icon: Icons.folder;
                    count: root.archived-rows.length;
                    text-size: root.quick-link-text-size;
                    opened => { root.archive-view-changed(true); }
                }
                if root.total-pending-requests > 0: SidebarUtilityLink {
                    height: root.quick-link-height;
                    label: @tr("Requests");
                    icon: Icons.user-plus;
                    count: root.total-pending-requests;
                    text-size: root.quick-link-text-size;
                    opened => {
                        root.message-requests-clicked();
                        root.group-invites-clicked();
                        root.channel-invites-clicked();
                        root.friend-requests-clicked();
                    }
                }
                if SidebarCards.dragging: SidebarNewSectionDropZone {}
            }
        }
        if root.active-tab == "mesh" && MeshGlobal.enabled && !root.desktop-rail: Flickable {
            width: root.width;
            height: root.height;
            viewport-height: mesh-content.preferred-height;
            mesh-content := VerticalLayout {
                padding-top: (root.collapsed ? (DesktopChrome.macos ? max(0px, root.titlebar-height - 2 * Spacing.sm) : root.traffic-lights-width > Spacing.none ? root.titlebar-height : Spacing.none) : root.top-row-height)
                    + (root.mobile-mode ? Spacing.none : Spacing.sm);
                padding-bottom: root.bottom-inset + Spacing.md;
                MeshList {
                    collapsed: root.collapsed;
                    touch: root.touch;
                }
            }
        }
        if !root.collapsed && root.active-tab != "mesh": SidebarHeader {
            x: root.expanded-cards ? root.expanded-frame-inset
                : root.mobile-mode ? Spacing.sm : 0px;
            y: root.expanded-cards && !DesktopChrome.macos ? Spacing.panel-gutter : 0px;
            width: root.expanded-cards ? root.width - self.x - Spacing.panel-gutter
                : root.width - 2 * self.x;
            top-row-height: root.top-row-height;
            quick-link-inset: root.quick-link-inset;
            quick-link-slot: root.quick-link-slot;
            quick-link-icon-size: root.quick-link-icon-size;
            quick-link-text-color: root.quick-link-text-color;
            quick-link-text-size: root.quick-link-text-size;
            search-overlay-open: root.search-overlay-open;
            server-unreachable: root.server-unreachable;
            connection-status: root.connection-status;
            mobile-mode: root.mobile-mode;
            touch: root.touch;
            search-clicked => { root.search-clicked(); }
            create-clicked => { root.create-clicked(); }
        }
        // Phones use bottom tabs in place of the two-pane footer.
        if root.mobile-mode && !root.collapsed && root.active-tab != "mesh" && !root.search-overlay-open: SidebarShieldToggle {
            touch: root.touch;
            shell: 36px;
            glyph: 20px;
            height: root.top-row-height;
            x: parent.width - self.width - 2 * Spacing.sm;
            y: 0px;
            clicked => { root.anon-mode-clicked(); }
        }

        // Keep the list after the header and before the footer in Slint's
        // source-order tab chain. Give it nonzero geometry for Slint's
        // visibility check during Tab navigation; it only owns keys.
        sidebar-keys := FocusScope {
            x: 0px;
            y: root.top-row-height;
            width: 1px;
            height: 1px;
            focus-on-click: false;
            enabled: !root.card-rail && !root.touch && (root.active-tab == "chats" || root.desktop-rail) && !root.hidden;
            changed has-focus => {
                if self.has-focus {
                    if root.show-card-list { root.reset-card-focus(); }
                    else { root.focus-step(-2); }
                }
            }
            accessible-role: list;
            accessible-label: root.show-card-list && root.last-card-index >= 0
                ? root.focused-card-row < 0 || root.focused-card.collapsed
                    ? (root.focused-card.kind == "saved" ? root.saved-label : root.focused-card.title)
                    : root.focused-card-item.chat-row.accessible-label-text
                : root.flat-rows.length > root.focus-index && root.focus-index >= 0
                ? root.row-label(root.flat-rows[root.focus-index])
                : @tr("Conversations");
            key-pressed(event) => {
                if root.show-card-list {
                    if event.text == Key.UpArrow { root.step-card-focus(-1); return accept; }
                    if event.text == Key.DownArrow { root.step-card-focus(1); return accept; }
                    if event.text == Key.Home { root.step-card-focus(-2); return accept; }
                    if event.text == Key.End { root.step-card-focus(2); return accept; }
                    if event.text == Key.Return || event.text == Key.Space { root.activate-card-focus(); return accept; }
                    if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                        root.open-card-focus-menu(); return accept;
                    }
                }
                if (event.text == Key.UpArrow) { root.focus-step(-1); return accept; }
                if (event.text == Key.DownArrow) { root.focus-step(1); return accept; }
                if (event.text == Key.Home) { root.focus-step(-2); return accept; }
                if (event.text == Key.End) { root.focus-step(2); return accept; }
                if (event.text == Key.Return || event.text == Key.Space) { root.open-focused(); return accept; }
                if (event.text == Key.Escape) { root.focus-composer(); return accept; }
                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                    root.open-focused-menu(); return accept;
                }
                return reject;
            }
        }

        // Pinned like SidebarHeader; without x/y a child of this Rectangle is centred.
        if !root.collapsed && root.active-tab == "mesh": Rectangle {
            property <length> action-box: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.top-row-height;
            background: root.touch ? transparent : Colors.surface;
            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                // Centre the action buttons in the row: a bare HorizontalLayout
                // top-aligns a fixed-height child, which clipped the bell's
                // -4px activity badge against the panel's clip bound. The chats
                // header avoids this by centring its bell; match that here.
                padding-top: (root.top-row-height - parent.action-box) / 2;
                padding-bottom: (root.top-row-height - parent.action-box) / 2;
                spacing: Spacing.sm;
                // iOS large-title bar: actions only, the title is MeshList's.
                Rectangle { horizontal-stretch: 1; }
                ActivityBell { touch: root.touch; server-unreachable: root.server-unreachable;
                    connection-status: root.connection-status; }
                Rectangle {
                    width: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    height: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    border-radius: Spacing.radius-full;
                    background: compose-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                    Image {
                        source: Icons.plus; width: Spacing.header-glyph; height: Spacing.header-glyph;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }
                    compose-touch := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: @tr("New mesh conversation");
                        clicked => { MeshGlobal.open-sheet("mesh-compose"); }
                    }
                }
                Rectangle {
                    width: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    height: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    border-radius: Spacing.radius-full;
                    background: setup-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                    Image {
                        source: Icons.settings; width: Spacing.header-glyph; height: Spacing.header-glyph;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }
                    setup-touch := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: @tr("Mesh settings");
                        clicked => { MeshGlobal.open-setup(); }
                    }
                }
            }
        }

        if !root.mobile-mode: SidebarFooter {
            x: root.expanded-cards ? root.expanded-frame-inset : 0px;
            panel-width: root.expanded-cards ? root.width - self.x - Spacing.panel-gutter : root.width;
            panel-height: root.height - (root.expanded-cards ? root.expanded-frame-inset : 0px);
            border-radius: root.expanded-cards ? Spacing.radius-panel : Spacing.radius-chrome;
            collapsed: root.collapsed;
            touch: root.touch;
            mesh-available: MeshGlobal.enabled;
            active-tab: root.active-tab;
            rail-button-count: root.rail-button-count;
            rail-gap: root.rail-gap;
            rail-divider-height: root.rail-divider-height;
            rail-footer-height: root.rail-footer-height;
            rail-icon-size: root.rail-icon-size;
            rail-slot-size: root.rail-slot-size;
            rail-slot-radius: root.rail-slot-radius;
            rail-slot-bg: root.rail-slot-bg;
            footer-icon-size: root.footer-icon-size;
            user-avatar-source: root.user-avatar-source;
            user-initials: root.user-initials;
            user-presence-status: root.user-presence-status;
            user-display-name: root.user-display-name;
            server-unreachable: root.server-unreachable;
            missed-call-count: root.missed-call-count;
            friends-clicked => { root.friends-clicked(); }
            calls-clicked => { root.calls-clicked(); }
            profile-clicked => { root.profile-clicked(); }
            settings-clicked => { root.settings-clicked(); }
            // The host owns the state (SidebarPane.sidebar-collapsed); flipping
            // `collapsed` here broke its binding and the chat never moved.
            toggle-collapsed => { root.toggle-collapsed(); }
            anon-mode-clicked => { root.anon-mode-clicked(); }
            channel-selected(id) => { root.channel-selected(id); }
            tab-selected(tab) => { root.tab-selected(tab); }
        }

    }
    if root.card-rail: SidebarRail {
        width: root.width;
        height: root.height;
        touch: root.touch;
        saved-open: root.saved-open;
        search-overlay-open: root.search-overlay-open;
        top-inset: root.titlebar-height;
        bottom-inset: root.bottom-inset;
        search => { root.search-clicked(); }
        create => { root.create-clicked(); }
        expand => { root.toggle-collapsed(); }
        focus-composer => { root.focus-composer(); }
        row-context-menu-opened(row) => { root.row-context-menu-opened(row.conversation-id, row.conversation-type); }
    }

}
