import { Materials } from "../theme/materials.slint";
// Sidebar — plain conversation content with shared chrome materials.
//
// Layout (top to bottom):
//   1. Search bar — inset surface
//   2. Scrollable content with flat/inset list items
//   3. Bottom bar — glass surface
//
// Neo depth separation: sidebar surface is raised from background,
// with an explicit right-edge highlight. Internal elements use
// inset (search, selected items) and glass (bottom bar) surfaces.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { ChatRow, ChatRowData } from "chat_list.slint";
import { CustomSectionHeader, CustomSectionData } from "custom_section_list.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ChatListSkeleton } from "../components/skeleton.slint";
import { SectionContextMenu, SectionHeaderContextMenu } from "section_context_menu.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { MeshList } from "../mesh/mesh_list.slint";
import { ConversationKind } from "../chat/conversation_kind.slint";
import { UpdateGlobal } from "../update/update_global.slint";
import { UpdateBanner } from "update_banner.slint";
import { SidebarFooter } from "sidebar_footer.slint";
import { SidebarHeader } from "sidebar_header.slint";
import { ActivityBell } from "../activity/activity_bell.slint";

export { ChatRowData, CustomSectionData }

export struct SidebarRowData {
    key: string,
    kind: string,
    chat: ChatRowData,
    section: CustomSectionData,
}

// Bare Flickable named ListView so the compiler virtualizes its `for`, as in
// chat/message_list.slint.
component ListView inherits Flickable {
    out property <length> visible-height: self.height;
    out property <length> visible-width: self.width;
    @children
}

export component Sidebar inherits Rectangle {
    // ── Properties: Data ──
    // The chat list, ordered by core (`ChatterClient::sidebar_rows`).
    in property <[ChatRowData]> chat-rows: [];
    in property <[ChatRowData]> archived-rows: [];
    in property <bool> archive-open: false;
    in property <bool> chat-rows-loading: false;
    in property <[CustomSectionData]> custom-sections: [];
    in property <[SidebarRowData]> flat-rows: [];

    // ── Properties: User profile ──
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";

    // ── Properties: State ──
    in-out property <bool> collapsed: false;
    in-out property <bool> hidden: false;
    // The overlay animates from this row; the row stays in layout but its
    // glass and label recede while the one native search input takes over.
    in property <bool> search-overlay-open: false;
    in property <string> active-tab: "chats";
    // Compact (phone-width) layout: the panel IS the screen and the bottom tab
    // bar carries Contacts, Calls and Profile. Not "is a phone": a tablet
    // shows this panel beside the chat, with its own footer, like desktop.
    in property <bool> mobile-mode: false;
    // Touch input: sizes the targets. Independent of `mobile-mode`, so a
    // two-pane tablet keeps finger-sized rows.
    in property <bool> touch: false;
    // The server reachability fact drives the Activity bell and the compact
    // rail settings dot, where the sidebar header is hidden.
    in property <bool> server-unreachable: false;
    in property <string> connection-status: "connected";
    in property <length> mobile-width: 360px;
    // macOS unified titlebar: the traffic lights are drawn over this panel's
    // top-left corner (app.slint stopped reserving a row for them). Both are
    // 0 everywhere else, which turns every use below into a no-op.
    in property <length> traffic-lights-width: 0px;
    in property <length> titlebar-height: 0px;

    // ── Properties: Badges ──
    in property <int> pending-friend-requests: 0;
    in property <int> pending-message-requests: 0;
    in property <int> pending-group-invites: 0;
    in property <int> pending-channel-invites: 0;
    // Badge on the Calls quick-link; same count the phone tab bar shows.
    in property <int> missed-call-count: 0;
    property <int> total-pending-requests: root.pending-friend-requests
        + root.pending-message-requests + root.pending-group-invites + root.pending-channel-invites;
    property <bool> requests-row-was-visible: false;
    changed total-pending-requests => {
        let now-visible = root.total-pending-requests > 0;
        if (now-visible != root.requests-row-was-visible) {
            // A row inserted above the visible conversations must not move
            // the content already under the user's finger.
            if (root.active-tab == "chats" && central-scroll.viewport-y < -((root.collapsed
                    ? (root.traffic-lights-width > Spacing.none ? root.titlebar-height : Spacing.none)
                    : root.top-row-height) + (root.mobile-mode ? Spacing.none : Spacing.sm))) {
                central-scroll.viewport-y += now-visible ? -root.quick-link-height : root.quick-link-height;
            }
            root.requests-row-was-visible = now-visible;
        }
    }

    // ── Callbacks ──
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback search-clicked();
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback friends-clicked();
    callback calls-clicked();
    callback profile-clicked();
    callback friend-requests-clicked();
    callback message-requests-clicked();
    callback group-invites-clicked();
    callback channel-invites-clicked();
    callback toggle-collapsed();
    callback settings-clicked();
    callback mesh-setup-clicked();
    callback tab-selected(string);
    callback anon-mode-clicked();
    callback create-section-clicked();
    // The two-pane '+' in the header row: opens New Chat / New Channel /
    // New Section. On a phone the Chats tab's floating button does (app.slint).
    callback create-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ ConversationKind);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ ConversationKind, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);
    callback set-conversation-pinned(/* conversation-id */ string, /* pinned */ bool);
    callback set-conversation-archived(/* conversation-id */ string, /* archived */ bool);
    callback archive-view-changed(bool);
    callback delete-conversation(/* conversation-id */ string, /* kind */ ConversationKind);
    callback leave-conversation(/* conversation-id */ string, /* kind */ ConversationKind);
    callback move-section(/* section-id */ string, /* delta */ int);
    callback set-section-sort-mode(/* section-id */ string, /* mode */ string);

    // ── Internal state ──
    // Quick-link rows are 34px for mouse density; on a touch screen that is
    // under a finger's width, so touch gets the 48px minimum instead.
    // Quick-links (Search, Saved Messages) sit in the same column as the
    // conversation rows, so on touch they take the same geometry and the same
    // type. They were 48px tall with 14px grey labels next to 72px rows with
    // 16px white names — close enough to look like a mistake rather than a
    // distinction, which is what "the text is different sizes" is.
    // NOT the conversation-row height. A conversation row is 72px because it
    // carries a 52px avatar and two lines of text; a quick link carries one
    // icon and one word. At the same 72px the two read as different sizes —
    // the conversation rows look dense and the quick links look like they have
    // a hole punched between them, which is the "huge space from Search to
    // Saved" complaint. 56px is the standard list row: same type, same tap
    // target, no cavern.
    property <length> quick-link-height: (root.touch ? 56px : 34px) * Appearance.text-grow;
    // The panel's first row, pinned above the scroll. On desktop it takes the
    // shared header height so it and the conversation header beside it read as
    // one row across the seam — and on macOS that is the row the traffic
    // lights are in. Mobile takes the quick-link height: there the panel IS
    // the screen, and Search and Saved Messages read as two rows of one list
    // (Signal: search bar, then Note to Self). At the conversation-row height
    // plus the scroll's top padding they sat ~80dp apart (owner, 2026-09-26).
    // A two-pane tablet sits beside a touch-height conversation header.
    property <length> top-row-height: root.mobile-mode ? root.quick-link-height
        : root.touch ? Spacing.header-height-touch : Spacing.header-height;
    property <length> quick-link-text-size: root.touch ? Typography.base : Typography.sm2;
    property <brush> quick-link-text-color: Colors.text-primary;
    property <length> quick-link-icon-size: root.touch ? 24px : 14px;
    // The header row's '+' and Shield on a touch two-pane: HeaderButton's
    // 48px shell and 26px glyph were the biggest things in a panel whose own
    // glyphs are 24px (quick links) and 18px (rail). Draw them at the
    // footer's 36px with a 20px glyph; the 48px touch box is unchanged.
    property <length> header-control-shell: root.touch ? (root.mobile-mode ? 36px : 28px) : Spacing.header-action-box;
    property <length> header-control-glyph: root.touch ? (root.mobile-mode ? 20px : 16px) : Spacing.header-glyph;
    // Quick-link icons sit in the conversation rows' avatar column: the same
    // leading inset (ChatList's xs + the row's sm) and a slot as wide as a
    // row's avatar ring, icon centred in it — so the lens, bookmark and the
    // rest line up with the avatars and channel icons below, and the labels
    // with the names.
    property <length> quick-link-inset: Spacing.xs + Spacing.sm;
    property <length> quick-link-slot: (root.touch ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop) + 4px;
    // The expanded panel's footer row. 36px on touch, not the full 48px
    // minimum: the panel is capped at 45% of a phone's width, and three 48px
    // buttons plus the avatar and name overflowed it — which silently pushed
    // the LAST button (collapse) off the right edge, stranding the user in the
    // expanded state. 36px is the largest that fits with the collapse control
    // still on screen; the rail's buttons, which have the whole width to
    // themselves, keep the full 48px.
    property <length> footer-icon-size: root.touch ? 36px : 24px;
    // One size for every button in the collapsed rail's bottom cluster, so the
    // container height below stays in step with them.
    property <length> rail-icon-size: root.touch ? Spacing.touch-target-min : 32px;
    // The visual plate inside a rail row. Smaller than the row so adjacent slots
    // do not touch; the row stays the touch target, the slot is what you see.
    property <length> rail-slot-size: root.touch ? 44px : 32px;
    property <length> rail-slot-radius: 12px;
    property <brush> rail-slot-bg: Colors.surface-control;
    // Shield, AI, Chats, Mesh (when compiled), expand, Settings, profile.
    property <int> rail-button-count: MeshGlobal.enabled ? 7 : 6;

    // Context menu state
    property <bool> ctx-menu-show: false;
    property <length> ctx-menu-x: 0;
    property <length> ctx-menu-y: 0;
    property <string> ctx-menu-conv-id: "";
    property <ConversationKind> ctx-menu-conv-type;
    property <string> ctx-menu-current-section-id: "";
    property <bool> ctx-menu-is-pinned: false;
    property <bool> ctx-menu-is-archived: false;
    // Channel and group rows, as core decided it for the row.
    property <bool> ctx-menu-can-leave: false;
    property <bool> ctx-menu-can-delete-channel: false;

    // Section header context menu state
    property <bool> section-header-ctx-menu-show: false;
    property <length> section-header-ctx-menu-x: 0;
    property <length> section-header-ctx-menu-y: 0;
    property <string> section-header-ctx-menu-section-id: "";
    property <string> section-header-ctx-menu-sort-mode: "recent";

    // ── Sizing ──
    // Always a side panel, on every platform: collapsed to the icon rail or
    // expanded to the list, never a full-screen view that swaps the chat out.
    // `touch` sizes the targets; `mobile-mode` (compact width) is what makes
    // the expanded panel full-screen.
    // Expanded on touch, the panel takes the WHOLE screen. 240px is 58% of a
    // 411dp phone and 45% is not much better: at either width the panel is too
    // cramped to browse folders in and the chat behind it is too narrow to read,
    // so the split served neither. Expanded is now a full-screen list you go to,
    // browse, and leave by collapsing back to the rail — the rail is what keeps
    // navigation always-available, which is why the panel does not have to.
    // `mobile-width` is fed the window width by app.slint.
    width: root.hidden ? Spacing.sidebar-width-hidden
         : root.collapsed ? (root.touch ? 68px : Spacing.sidebar-width-collapsed)
         : root.mobile-mode ? root.mobile-width
         : Spacing.sidebar-width;
    visible: !root.hidden;
    // Neo 2.0: sidebar is a raised surface with right-edge highlight.
    // In Anon Mode, slightly shift the surface tint toward primary so the
    // user has a constant visual cue the mode is active.
    // Same reasoning as the lists inside it: a phone shows this panel full
    // screen, so it is the page: transparent, so the window's ambient wash
    // (Materials.ambient) shows through. Desktop keeps the raised-panel tone
    // that separates it from the chat column beside it.
    // On touch layouts, let the page show through the rounded glass chrome.
    // An opaque full-height backing fills the header/footer corner cutouts.
    background: root.touch ? transparent
              : AnonMode.enabled ? Colors.primary.with-alpha(0.08)
              : root.mobile-mode ? transparent
              : Colors.surface;
    // The pinned header and footer are chrome-radius glass flush with the
    // panel's edges, so the panel's own corners must curve with them: square,
    // the opaque surface filled the notch outside each rounded corner. Not
    // on a phone, where the panel is the (transparent) page.
    border-radius: root.mobile-mode ? Spacing.none : Spacing.radius-chrome;
    // No `border-width` here: this is a right-EDGE highlight in intent and
    // Slint's border draws all four sides. On a phone that traced a hairline
    // rectangle around the whole display; on desktop it now also ran a line
    // across the top of the title row, right under the traffic lights. The
    // edge is drawn explicitly below instead, on the one side that means
    // something. The shadow has nothing to cast onto on a phone either.

    // No animation on a phone: the list is full width there, and animating
    // from the pre-resize width drew a half-width first frame at launch.
    animate width { duration: root.mobile-mode ? 0ms : Materials.menu-duration; easing: ease-out; }

    in property <length> bottom-inset: 0px;
    property <bool> update-banner-visible: UpdateGlobal.state == "available" || UpdateGlobal.state == "confirm-cellular" || UpdateGlobal.state == "downloading" || UpdateGlobal.state == "ready" || UpdateGlobal.state == "installing" || UpdateGlobal.state == "error";
    property <length> update-banner-height: Spacing.button-height + Spacing.md;

    Rectangle {
        // Clip the list and glass chrome together. Child/backdrop painting must
        // not fill the square corners outside the tablet panel silhouette.
        border-radius: root.border-radius;
        clip: true;
        // ════════════════════════════════════════
        // FIXED TOP ROW — the app's title row
        // ════════════════════════════════════════
        // Search sits here rather than at the head of the scroll below for two
        // reasons: it is the row Telegram (and every native list app) keeps
        // pinned, and on macOS the traffic lights are painted over this corner,
        // so a row that scrolls would slide conversations under them.

        // ════════════════════════════════════════
        // SCROLLABLE CENTRAL CONTENT
        // ════════════════════════════════════════
        central-scroll := ListView {
            visible: root.active-tab != "mesh";
            width: root.width;
            height: root.height;
            immediate-child-press: true;

            for entry[idx] in root.flat-rows: VerticalLayout {
                width: central-scroll.width;
                height: self.preferred-height;
                spacing: 0px;
                // The pinned title and the floating footer stay outside the
                // virtualized content; only their scroll clearance is a row.
                padding-top: idx == 0
                    ? (root.collapsed ? (root.traffic-lights-width > Spacing.none ? root.titlebar-height : Spacing.none) : root.top-row-height)
                        + (root.mobile-mode ? Spacing.none : Spacing.sm)
                    : Spacing.none;
                padding-bottom: entry.kind == "bottom"
                    ? (root.mobile-mode
                        ? root.bottom-inset + Spacing.fab-size + Spacing.xl + Spacing.md
                            + (root.update-banner-visible ? root.update-banner-height + Spacing.md : Spacing.none)
                        : (root.collapsed ? root.rail-button-count * root.rail-icon-size + (root.rail-button-count - 1) * Spacing.sm + Spacing.lg : Spacing.button-height)
                            + (root.update-banner-visible && !root.collapsed ? root.update-banner-height + Spacing.md : Spacing.none) + Spacing.md)
                    : Spacing.none;
                if entry.kind == "archive-entry" || entry.kind == "archive-back": Rectangle {
                    height: root.quick-link-height;
                    accessible-role: button;
                    accessible-label: entry.kind == "archive-back" ? "Back to chats" : "Archived chats";
                    accessible-action-default => { root.archive-view-changed(entry.kind == "archive-entry"); }
                    border-width: archive-keys.has-focus ? 2px : 0px;
                    border-color: Colors.focus-ring;
                    archive-keys := FocusScope {
                        width: 0px; height: 0px;
                        key-pressed(event) => {
                            if event.text == Key.Space || event.text == Key.Return {
                                root.archive-view-changed(entry.kind == "archive-entry");
                                return accept;
                            }
                            return reject;
                        }
                    }
                    HorizontalLayout {
                        padding-left: root.quick-link-inset;
                        padding-right: Spacing.md;
                        spacing: Spacing.sm;
                        Image {
                            source: entry.kind == "archive-back" ? Icons.chevron-left : Icons.folder;
                            width: root.quick-link-icon-size;
                            height: root.quick-link-icon-size;
                            colorize: Colors.text-secondary;
                        }
                        Text {
                            text: entry.kind == "archive-back" ? "Chats" : "Archived";
                            color: Colors.text-primary;
                            font-size: root.quick-link-text-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if entry.kind == "archive-entry": Text {
                            text: root.archived-rows.length;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.archive-view-changed(entry.kind == "archive-entry"); }
                    }
                }
                if entry.kind == "archive-empty": Text {
                    text: "No archived chats";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    height: root.quick-link-height;
                }
                if entry.kind == "search" && root.collapsed: Rectangle {
                    height: root.quick-link-height;
                    opacity: root.search-overlay-open ? 0 : 1;
                    animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
                    accessible-role: button;
                    accessible-label: "Search";
                    TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Search"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: Icons.search; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    TouchArea { enabled: !root.search-overlay-open; mouse-cursor: pointer; clicked => { root.search-clicked(); } }
                }


                if entry.kind == "saved" && !AnonMode.enabled: Rectangle {
                    height: root.quick-link-height;
                    property <bool> press-active: false;
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;
                    background: self.press-active ? Colors.surface-control-hover
                        : (!root.mobile-mode && saved-touch.has-hover) ? Colors.surface-hover : transparent;
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    accessible-role: button;
                    accessible-label: "Saved Messages";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: root.quick-link-inset; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image { source: Icons.bookmark; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; } }
                        }
                        Text { text: "Saved Messages"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Saved Messages"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: Icons.bookmark; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    saved-touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                parent.press-x = self.mouse-x;
                                parent.press-y = self.mouse-y;
                                parent.press-active = true;
                            } else if (event.kind == PointerEventKind.move
                                && (abs(self.mouse-x - parent.press-x) > Spacing.sm
                                    || abs(self.mouse-y - parent.press-y) > Spacing.sm)) {
                                parent.press-active = false;
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                parent.press-active = false;
                            }
                        }
                        clicked => { root.saved-messages-clicked(); }
                    }
                }

                // Visible in BOTH modes. In shield mode it's the entry to add an
                // ANON contact via private code (the modal is private-only there);
                // labelled "Add Contact" to avoid implying the server friend list.
                //
                // Hidden on mobile: the bottom tab bar's Contacts tab opens the
                // very same modal, and two permanent entry points to one screen
                // is the duplication that made the phone layout read as two
                // navigation systems at once.

                if entry.kind == "friends" && !root.mobile-mode: Rectangle {
                    height: root.quick-link-height;
                    background: friends-touch.pressed ? Colors.surface-control-hover
                        : friends-touch.has-hover ? Colors.surface-hover : transparent;
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    accessible-role: button;
                    accessible-label: AnonMode.enabled ? "Add Contact" : "Friends";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: root.quick-link-inset; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image { source: AnonMode.enabled ? Icons.user-plus : Icons.users; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; } }
                        }
                        Text { text: AnonMode.enabled ? "Add Contact" : "Friends"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: AnonMode.enabled ? "Add Contact" : "Friends"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: AnonMode.enabled ? Icons.user-plus : Icons.users; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    friends-touch := TouchArea { clicked => { root.friends-clicked(); } }
                }

                // Calls — the call history screen. On a phone the tab bar's
                // Calls tab is the entry (hidden here for the same reason as
                // Friends); on a two-pane tablet or desktop there is no tab
                // bar, and this row is the only way in.

                if entry.kind == "calls" && !root.mobile-mode: Rectangle {
                    height: root.quick-link-height;
                    background: calls-touch.pressed ? Colors.surface-control-hover
                        : calls-touch.has-hover ? Colors.surface-hover : transparent;
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    accessible-role: button;
                    accessible-label: root.missed-call-count > 0 ? "Calls, " + root.missed-call-count + " missed" : "Calls";
                    accessible-action-default => { root.calls-clicked(); }
                    if !root.collapsed: HorizontalLayout {
                        padding-left: root.quick-link-inset; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image { source: Icons.phone; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; } }
                        }
                        Text { text: "Calls"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; horizontal-stretch: 1; }
                        if root.missed-call-count > 0: VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: self.height + (root.missed-call-count > 9 ? 4px : 0px);
                                height: Spacing.badge-md;
                                border-radius: self.height / 2;
                                background: Colors.error-hover;
                                Text {
                                    text: root.missed-call-count > 9 ? "9+" : root.missed-call-count;
                                    color: Colors.on-error;
                                    font-size: Typography.xs2;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Calls"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                            Image { source: Icons.phone; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                            if root.missed-call-count > 0: Rectangle {
                                x: parent.width - 8px; y: -2px;
                                width: 12px; height: 12px; border-radius: 6px;
                                border-width: 1px; border-color: Colors.surface;
                                background: Colors.error;
                            }
                        } } }
                    }
                    calls-touch := TouchArea { mouse-cursor: pointer; clicked => { root.calls-clicked(); } }
                }

                // REQUESTS entry point — one calm row, not four competing
                // alert banners. Friend requests, message requests, group
                // invites, and channel invites used to each render their own
                // full-width colored banner (bold text, its own accent color)
                // any time their count was nonzero, so a user with several
                // kinds of pending item at once saw a wall of near-identical
                // "look at me" rows before reaching a single conversation —
                // everything shouting is the same as nothing being
                // prioritized. This is one row in the same quiet style as
                // Search/Saved Messages/Friends above it, with the combined
                // count as its badge; the four kinds live one level deeper,
                // as tabs already built into the Friends modal's Requests
                // tab (requests-sub-tab: received/sent/private/groups/
                // channels) — nothing lost, just not all surfaced at once.

                if entry.kind == "requests" && root.total-pending-requests > 0: Rectangle {
                    height: root.quick-link-height;
                    accessible-role: button;
                    accessible-label: root.total-pending-requests == 1 ? "1 request" : root.total-pending-requests + " requests";
                    background: requests-touch.pressed ? Colors.surface-control-hover
                        : requests-touch.has-hover ? Colors.surface-hover : transparent;
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }

                    if !root.collapsed: HorizontalLayout {
                        padding-left: root.quick-link-inset; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0; width: root.quick-link-slot;
                            HorizontalLayout { alignment: center; Image { source: Icons.user-plus; width: 14px; height: 14px; colorize: Colors.text-secondary; } }
                        }
                        Text { text: "Requests"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; horizontal-stretch: 1; }
                        // Centred on the label's line; a fixed-height child of a
                        // HorizontalLayout otherwise sits at the row's top.
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            if root.total-pending-requests > 0: Rectangle {
                                width: self.height + (root.total-pending-requests > 9 ? 4px : 0px);
                                height: Spacing.badge-md;
                                border-radius: self.height / 2;
                                background: Colors.error-hover;
                                Text {
                                    text: root.total-pending-requests > 9 ? "9+" : root.total-pending-requests;
                                    color: Colors.on-error;
                                    font-size: Typography.xs2;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Requests"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                            Image { source: Icons.user-plus; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                            if root.total-pending-requests > 0: Rectangle {
                                x: parent.width - 8px; y: -2px;
                                width: 12px; height: 12px; border-radius: 6px;
                                border-width: 1px; border-color: Colors.surface;
                                background: Colors.error;
                            }
                        } } }
                    }

                    requests-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // Refresh every request kind's list and badge,
                            // then open Contacts › Requests. Only
                            // friend-requests-clicked opens it (app.slint
                            // picks the first non-empty sub-tab), so it must
                            // fire on every tap — skipping it when only a
                            // channel invite was pending made the row dead.
                            root.message-requests-clicked();
                            root.group-invites-clicked();
                            root.channel-invites-clicked();
                            root.friend-requests-clicked();
                        }
                    }
                }

                // 4. CHATS — one list of every loose conversation, newest
                // activity first, pinned first (Signal/Telegram). It used to be
                // a "Messages" block above a "Channels" block, so a channel with
                // newer activity never rose above a DM; creating a chat or a
                // channel lives in the top row's Create menu (and the phone's
                // floating button), not in per-block headers.
                // Collapsed channel-action rail: new-channel / new-section.

                if entry.kind == "channel-actions" && root.collapsed && !AnonMode.enabled: VerticalLayout {
                    spacing: Spacing.xs;
                    padding-top: Spacing.xs;
                    padding-bottom: Spacing.xs;

                    TooltipArea {
                        height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: "New Channel"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                            background: c-new-touch.has-hover ? Colors.surface-hover.brighter(0.6) : root.rail-slot-bg;
                            Image { source: Icons.plus; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-new-touch.has-hover ? Colors.text-primary : Colors.text-muted; }
                            c-new-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-channel-clicked(); } }
                        } }
                    }

                    TooltipArea {
                        height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: "New Section"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                            background: c-sec-touch.has-hover ? Colors.surface-hover.brighter(0.6) : root.rail-slot-bg;
                            Image { source: Icons.folder; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-sec-touch.has-hover ? Colors.text-primary : Colors.text-muted; }
                            c-sec-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-section-clicked(); } }
                        } }
                    }
                }


                if entry.kind == "empty" && !root.collapsed && !root.chat-rows-loading: VerticalLayout {
                    padding-top: Spacing.md;
                    padding-bottom: Spacing.md;
                    spacing: Spacing.xs;
                    EmptyState {
                        icon: Icons.message-circle;
                        message: "No conversations";
                        cta-text: "Add a friend";
                        cta-clicked => { root.friends-clicked(); }
                    }
                    if !AnonMode.enabled: HorizontalLayout {
                        height: Spacing.touch-target-min;
                        alignment: center;
                        Text {
                            text: "Browse channels";
                            color: browse-touch.has-hover ? Colors.primary-hover : Colors.primary;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                            browse-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.join-channel-clicked(); }
                            }
                        }
                    }
                }
                if entry.kind == "loading" && root.chat-rows-loading && root.chat-rows.length == 0 && !root.collapsed: VerticalLayout {
                    spacing: Spacing.xxs;
                    for placeholder in [0, 1, 2, 3, 4]: ChatListSkeleton { mobile-mode: root.touch; }
                }
                if entry.kind == "chat" || entry.kind == "archived-chat": Rectangle {
                    height: (root.collapsed ? 48px : root.touch ? Spacing.row-height-touch : Spacing.row-height-desktop) + Spacing.xxs;
                    chat-row := ChatRow {
                        x: Spacing.xs;
                        width: parent.width - 2 * Spacing.xs;
                        data: entry.chat;
                        collapsed: root.collapsed;
                        mobile-mode: root.touch;
                        clicked => {
                            if entry.chat.conversation-type == ConversationKind.channel || entry.chat.conversation-type == ConversationKind.saved-messages {
                                root.channel-selected(entry.chat.conversation-id);
                            } else if entry.chat.conversation-type == ConversationKind.anon-group {
                                root.private-group-selected(entry.chat.conversation-id);
                            } else {
                                root.dm-selected(entry.chat.conversation-id);
                            }
                        }
                        pin-requested(pinned) => { root.set-conversation-pinned(entry.chat.conversation-id, pinned); }
                        context-menu-requested(x, y) => {
                            root.ctx-menu-conv-id = entry.chat.conversation-id;
                            root.ctx-menu-conv-type = entry.chat.conversation-type;
                            root.ctx-menu-is-pinned = entry.chat.is-pinned;
                            root.ctx-menu-is-archived = entry.kind == "archived-chat";
                            root.ctx-menu-can-leave = entry.chat.can-leave;
                            root.ctx-menu-can-delete-channel = entry.chat.can-delete;
                            root.ctx-menu-x = x;
                            root.ctx-menu-y = y;
                            root.ctx-menu-current-section-id = "";
                            root.ctx-menu-show = true;
                        }
                    }
                }
                if entry.kind == "section-header": CustomSectionHeader {
                    section-id: entry.section.section-id;
                    name: entry.section.name;
                    icon-emoji: entry.section.icon-emoji;
                    is-expanded: entry.section.is-expanded;
                    unread-count: entry.section.unread-count;
                    collapsed: root.collapsed;
                    mobile-mode: root.touch;
                    toggle-expanded => { root.section-toggle-expanded(entry.section.section-id); }
                    rename-clicked => { root.rename-section-clicked(entry.section.section-id); }
                    delete-clicked => { root.delete-section-clicked(entry.section.section-id); }
                    context-menu-requested(x, y) => {
                        root.section-header-ctx-menu-section-id = entry.section.section-id;
                        root.section-header-ctx-menu-x = x;
                        root.section-header-ctx-menu-y = y;
                        root.section-header-ctx-menu-sort-mode = entry.section.sort-mode;
                        root.section-header-ctx-menu-show = true;
                    }
                }
                if entry.kind == "section-chat": Rectangle {
                    height: (root.collapsed ? 48px : root.touch ? Spacing.row-height-touch : Spacing.row-height-desktop) + Spacing.xxs;
                    ChatRow {
                        x: Spacing.xs;
                        width: parent.width - 2 * Spacing.xs;
                        data: entry.chat;
                        collapsed: root.collapsed;
                        mobile-mode: root.touch;
                        clicked => { root.section-conversation-selected(entry.chat.conversation-id, entry.chat.conversation-type); }
                        pin-requested(pinned) => { root.set-conversation-pinned(entry.chat.conversation-id, pinned); }
                        context-menu-requested(x, y) => {
                            root.ctx-menu-conv-id = entry.chat.conversation-id;
                            root.ctx-menu-can-leave = entry.chat.can-leave;
                            root.ctx-menu-can-delete-channel = entry.chat.can-delete;
                            root.ctx-menu-conv-type = entry.chat.conversation-type;
                            root.ctx-menu-x = x;
                            root.ctx-menu-y = y;
                            root.ctx-menu-current-section-id = entry.section.section-id;
                            root.ctx-menu-is-pinned = entry.chat.is-pinned;
                            root.ctx-menu-is-archived = false;
                            root.ctx-menu-show = true;
                        }
                    }
                }
            }
        }
        if root.active-tab == "mesh" && MeshGlobal.enabled: Flickable {
            width: root.width;
            height: root.height;
            viewport-height: mesh-content.preferred-height;
            mesh-content := VerticalLayout {
                padding-top: (root.collapsed ? (root.traffic-lights-width > Spacing.none ? root.titlebar-height : Spacing.none) : root.top-row-height)
                    + (root.mobile-mode ? Spacing.none : Spacing.sm);
                padding-bottom: root.bottom-inset + Spacing.md;
                MeshList {
                    collapsed: root.collapsed;
                    touch: root.touch;
                    setup-requested => { root.mesh-setup-clicked(); }
                }
            }
        }
        if !root.collapsed && root.active-tab != "mesh": SidebarHeader {
            panel-width: root.width;
            top-row-height: root.top-row-height;
            quick-link-inset: root.quick-link-inset;
            quick-link-slot: root.quick-link-slot;
            quick-link-icon-size: root.quick-link-icon-size;
            quick-link-text-color: root.quick-link-text-color;
            quick-link-text-size: root.quick-link-text-size;
            traffic-lights-width: root.traffic-lights-width;
            header-control-shell: root.header-control-shell;
            header-control-glyph: root.header-control-glyph;
            search-overlay-open: root.search-overlay-open;
            server-unreachable: root.server-unreachable;
            connection-status: root.connection-status;
            mobile-mode: root.mobile-mode;
            touch: root.touch;
            search-clicked => { root.search-clicked(); }
            create-clicked => { root.create-clicked(); }
            anon-mode-clicked => { root.anon-mode-clicked(); }
        }

        // Pinned like SidebarHeader; without x/y a child of this Rectangle is centred.
        if !root.collapsed && root.active-tab == "mesh": Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.top-row-height;
            background: root.touch ? transparent : Colors.surface;
            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.sm;
                // iOS large-title bar: actions only, the title is MeshList's.
                Rectangle { horizontal-stretch: 1; }
                ActivityBell { touch: root.touch; server-unreachable: root.server-unreachable;
                    connection-status: root.connection-status; }
                Rectangle {
                    width: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    height: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    border-radius: Spacing.radius-full;
                    background: compose-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                    Image {
                        source: Icons.plus; width: Spacing.header-glyph; height: Spacing.header-glyph;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }
                    compose-touch := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: "New mesh conversation";
                        clicked => { MeshGlobal.open-sheet("mesh-compose"); }
                    }
                }
                Rectangle {
                    width: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    height: root.touch ? Spacing.header-action-box-touch : Spacing.header-action-box;
                    border-radius: Spacing.radius-full;
                    background: setup-touch.has-hover ? Colors.surface-control-hover : Colors.surface-control;
                    Image {
                        source: Icons.settings; width: Spacing.header-glyph; height: Spacing.header-glyph;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        colorize: Colors.text-secondary;
                    }
                    setup-touch := TouchArea {
                        mouse-cursor: pointer; accessible-role: button; accessible-label: "Mesh settings";
                        clicked => { MeshGlobal.open-setup(); }
                    }
                }
            }
        }

        if !root.mobile-mode: SidebarFooter {
            panel-width: root.width;
            panel-height: root.height;
            collapsed: root.collapsed;
            touch: root.touch;
            mesh-available: MeshGlobal.enabled;
            active-tab: root.active-tab;
            rail-button-count: root.rail-button-count;
            rail-icon-size: root.rail-icon-size;
            rail-slot-size: root.rail-slot-size;
            rail-slot-radius: root.rail-slot-radius;
            rail-slot-bg: root.rail-slot-bg;
            footer-icon-size: root.footer-icon-size;
            user-avatar-source: root.user-avatar-source;
            user-initials: root.user-initials;
            user-presence-status: root.user-presence-status;
            user-display-name: root.user-display-name;
            server-unreachable: root.server-unreachable;
            profile-clicked => { root.profile-clicked(); }
            settings-clicked => { root.settings-clicked(); }
            toggle-collapsed => { root.collapsed = !root.collapsed; root.toggle-collapsed(); }
            anon-mode-clicked => { root.anon-mode-clicked(); }
            channel-selected(id) => { root.channel-selected(id); }
            tab-selected(tab) => { root.tab-selected(tab); }
        }

        // 7. BOTTOM UTILITY BAR — shared chrome material.
        // Desktop only. On mobile its last occupant (the shield) moved up onto
        // the search row, and what remained was a translucent grey strip across
        // the foot of the list holding nothing — visible as a lighter rectangle
        // above the floating dock.

    }

    // Right edge — the seam against the chat column. Desktop only: on a phone
    // this panel is the whole screen and has no column beside it.

    if !root.mobile-mode && !root.collapsed && root.update-banner-visible: UpdateBanner {
        x: Spacing.sm;
        y: root.height - self.height - Spacing.button-height - Spacing.md;
        width: root.width - Spacing.sm * 2;
        height: root.update-banner-height;
    }

    // Keep an update notice above the phone's floating action area. Adding it
    // to the scroll layout moved every conversation when update state arrived.
    if root.mobile-mode && root.update-banner-visible: UpdateBanner {
        x: Spacing.sm;
        y: root.height - root.bottom-inset - Spacing.fab-size - Spacing.md * 2 - self.height;
        width: root.width - Spacing.sm * 2;
        height: root.update-banner-height;
    }


    // Section context menu overlay (renders on top of all sidebar content)
    SectionContextMenu {
        show: root.ctx-menu-show;
        position-x: root.ctx-menu-x;
        position-y: root.ctx-menu-y;
        conversation-id: root.ctx-menu-conv-id;
        conversation-type: root.ctx-menu-conv-type;
        current-section-id: root.ctx-menu-current-section-id;
        is-pinned: root.ctx-menu-is-pinned;
        is-archived: root.ctx-menu-is-archived;
        can-leave: root.ctx-menu-can-leave;
        can-delete-channel: root.ctx-menu-can-delete-channel;
        mobile-mode: root.touch;
        sections: root.custom-sections;

        close => {
            root.ctx-menu-show = false;
        }
        move-to-section(conv-id, conv-type, section-id) => {
            root.move-to-section(conv-id, conv-type, section-id);
        }
        remove-from-section(conv-id) => {
            root.remove-from-section(conv-id);
        }
        create-section-clicked => {
            root.create-section-clicked();
        }
        set-pinned(conv-id, pinned) => {
            root.set-conversation-pinned(conv-id, pinned);
        }
        set-archived(conv-id, archived) => {
            root.set-conversation-archived(conv-id, archived);
        }
        delete-chat(conv-id, conv-type) => {
            root.delete-conversation(conv-id, conv-type);
        }
        leave-conversation(conv-id, kind) => {
            root.leave-conversation(conv-id, kind);
        }
    }

    // Section header context menu overlay (right-click on section header)
    SectionHeaderContextMenu {
        show: root.section-header-ctx-menu-show;
        bottom-inset: root.bottom-inset;
        position-x: root.section-header-ctx-menu-x;
        position-y: root.section-header-ctx-menu-y;
        section-id: root.section-header-ctx-menu-section-id;
        section-sort-mode: root.section-header-ctx-menu-sort-mode;
        mobile-mode: root.touch;

        close => {
            root.section-header-ctx-menu-show = false;
        }
        remove-section(section-id) => {
            root.delete-section-clicked(section-id);
        }
        rename-section(section-id) => {
            root.rename-section-clicked(section-id);
        }
        move-section(section-id, delta) => {
            root.move-section(section-id, delta);
        }
        set-sort-mode(section-id, mode) => {
            root.set-section-sort-mode(section-id, mode);
        }
    }
}
