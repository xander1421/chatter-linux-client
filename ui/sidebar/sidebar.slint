// Sidebar — Neo 2.0
//
// Layout (top to bottom):
//   1. Search bar — inset surface
//   2. Scrollable content with flat/inset list items
//   3. Bottom bar — glass surface
//
// Neo depth separation: sidebar surface is raised from background,
// with right-edge highlight border. Internal elements use
// inset (search, selected items) and glass (bottom bar) surfaces.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { ChannelList, ChannelListItemData } from "channel_list.slint";
import { DMList, DMListItemData } from "dm_list.slint";
import { PrivateGroupList, PrivateGroupListItemData } from "private_group_list.slint";
import { CustomSectionList, CustomSectionData, SectionConversationData } from "custom_section_list.slint";
import { SectionContextMenu, SectionHeaderContextMenu } from "section_context_menu.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { AnonMode, TorStatus } from "../anon_mode/anon_mode_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { MeshList } from "../mesh/mesh_list.slint";

export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, CustomSectionData, SectionConversationData }

export component Sidebar inherits Rectangle {
    // ── Properties: Data ──
    in property <[ChannelListItemData]> channels: [];
    in property <[DMListItemData]> dm-conversations: [];
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <[CustomSectionData]> custom-sections: [];
    in property <[SectionConversationData]> section-conversations: [];

    // ── Properties: User profile ──
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";

    // ── Properties: State ──
    in-out property <bool> collapsed: false;
    in-out property <bool> hidden: false;
    in property <bool> mobile-mode: false;
    // The server is settled-unreachable. Shown as a dot on the settings button,
    // mirroring how the anon-mode button carries its Tor dot, so the connection
    // banner can be dismissed without the outage becoming invisible.
    in property <bool> server-unreachable: false;
    in property <length> mobile-width: 360px;

    // ── Properties: Badges ──
    in property <int> pending-friend-requests: 0;
    in property <int> pending-message-requests: 0;
    in property <int> pending-group-invites: 0;
    in property <int> pending-channel-invites: 0;

    // ── Callbacks ──
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback search-clicked();
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback friends-clicked();
    callback profile-clicked();
    callback friend-requests-clicked();
    callback message-requests-clicked();
    callback group-invites-clicked();
    callback channel-invites-clicked();
    callback toggle-collapsed();
    callback settings-clicked();
    callback anon-mode-clicked();
    callback create-section-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ string);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ string, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);

    // ── Internal state ──
    // Quick-link rows are 34px on desktop for density; on a touch screen that is
    // under a finger's width, so mobile gets the 48px minimum instead.
    property <length> quick-link-height: root.mobile-mode ? Spacing.touch-target-min : 34px;
    // Same for the footer icon buttons, which were 24px square.
    property <length> footer-icon-size: root.mobile-mode ? Spacing.touch-target-min : 24px;
    property <bool> channels-expanded: true;
    property <bool> messages-expanded: true;

    // Context menu state
    property <bool> ctx-menu-show: false;
    property <length> ctx-menu-x: 0;
    property <length> ctx-menu-y: 0;
    property <string> ctx-menu-conv-id: "";
    property <string> ctx-menu-conv-type: "";
    property <string> ctx-menu-current-section-id: "";

    // Section header context menu state
    property <bool> section-header-ctx-menu-show: false;
    property <length> section-header-ctx-menu-x: 0;
    property <length> section-header-ctx-menu-y: 0;
    property <string> section-header-ctx-menu-section-id: "";

    // ── Sizing ──
    // Mobile is a two-view swap, not a split: the list takes the whole width,
    // and opening a conversation sets `hidden` so the chat gets the whole width
    // instead. Keeping the sidebar unconditionally visible in mobile-mode (as
    // this did) left it covering the screen with no way to reach the chat.
    width: root.mobile-mode ? (root.hidden ? 0px : root.mobile-width)
         : root.hidden ? Spacing.sidebar-width-hidden
         : root.collapsed ? Spacing.sidebar-width-collapsed
         : Spacing.sidebar-width;
    visible: !root.hidden;
    // Neo 2.0: sidebar is a raised surface with right-edge highlight.
    // In Anon Mode, slightly shift the surface tint toward primary so the
    // user has a constant visual cue the mode is active.
    background: AnonMode.enabled ? Colors.primary.with-alpha(0.08) : Colors.surface;
    border-width: 1px;
    border-color: AnonMode.enabled ? Colors.primary.with-alpha(0.4) : Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-x: Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    animate width { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        padding-top: Spacing.sm;
        // ════════════════════════════════════════
        // SCROLLABLE CENTRAL CONTENT
        // ════════════════════════════════════════
        Flickable {
            vertical-stretch: 1;
            viewport-height: central-layout.preferred-height;

            central-layout := VerticalLayout {
                padding-bottom: Spacing.md;

                // QUICK LINKS (top navigation)

                // Unified search trigger — opens the search palette overlay.
                Rectangle {
                    height: root.quick-link-height;
                    background: search-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Search";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: Icons.search; width: 14px; height: 14px; colorize: Colors.text-secondary; }
                        }
                        Text { text: "Search"; color: Colors.text-secondary; font-size: Typography.sm2; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Search"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Image { source: Icons.search; width: 16px; height: 16px; colorize: Colors.text-secondary; } }
                    }
                    search-touch := TouchArea { clicked => { root.search-clicked(); } }
                }

                if !AnonMode.enabled : Rectangle {
                    height: root.quick-link-height;
                    background: saved-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Saved Messages";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: Icons.bookmark; width: 14px; height: 14px; colorize: Colors.text-secondary; }
                        }
                        Text { text: "Saved Messages"; color: Colors.text-secondary; font-size: Typography.sm2; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Saved Messages"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Image { source: Icons.bookmark; width: 16px; height: 16px; colorize: Colors.text-secondary; } }
                    }
                    saved-touch := TouchArea { clicked => { root.saved-messages-clicked(); } }
                }

                // Visible in BOTH modes. In shield mode it's the entry to add an
                // ANON contact via private code (the modal is private-only there);
                // labelled "Add Contact" to avoid implying the server friend list.
                Rectangle {
                    height: root.quick-link-height;
                    background: friends-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: AnonMode.enabled ? "Add Contact" : "Friends";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: AnonMode.enabled ? Icons.user-plus : Icons.users; width: 14px; height: 14px; colorize: Colors.text-secondary; }
                        }
                        Text { text: AnonMode.enabled ? "Add Contact" : "Friends"; color: Colors.text-secondary; font-size: Typography.sm2; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: AnonMode.enabled ? "Add Contact" : "Friends"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Image { source: AnonMode.enabled ? Icons.user-plus : Icons.users; width: 16px; height: 16px; colorize: Colors.text-secondary; } }
                    }
                    friends-touch := TouchArea { clicked => { root.friends-clicked(); } }
                }

                // INVITE BANNERS (conditional)
                if root.pending-friend-requests > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: root.pending-friend-requests == 1 ? "1 friend request" : root.pending-friend-requests + " friend requests";
                    height: 38px;
                    border-radius: Spacing.radius-sm;
                    background: freq-touch.has-hover ? Colors.surface-hover : Colors.surface;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.user-plus;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.primary;
                            }
                        }
                        Text {
                            text: "Friend Requests";
                            color: Colors.primary;
                            font-size: Typography.sm2;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: root.pending-friend-requests > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                                color: Colors.text-primary;
                                font-size: Typography.xs2;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            Image {
                                source: Icons.user-plus;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.primary;
                            }
                            Rectangle {
                                x: parent.width - 6px;
                                y: 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Colors.error;
                            }
                        }
                    }

                    freq-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.friend-requests-clicked(); }
                    }
                }

                if root.pending-message-requests > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: root.pending-message-requests == 1 ? "1 message request" : root.pending-message-requests + " message requests";
                    height: 38px;
                    border-radius: Spacing.radius-sm;
                    background: mreq-touch.has-hover ? Colors.surface-hover : Colors.surface;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.message-circle;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.primary;
                            }
                        }
                        Text {
                            text: "Message Requests";
                            color: Colors.primary;
                            font-size: Typography.sm2;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: root.pending-message-requests > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                                color: Colors.text-primary;
                                font-size: Typography.xs2;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            Image {
                                source: Icons.message-circle;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.primary;
                            }
                            Rectangle {
                                x: parent.width - 6px;
                                y: 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Colors.error;
                            }
                        }
                    }

                    mreq-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.message-requests-clicked(); }
                    }
                }

                if root.pending-group-invites > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: root.pending-group-invites == 1 ? "1 group invite" : root.pending-group-invites + " group invites";
                    height: 38px;
                    border-radius: Spacing.radius-sm;
                    background: ginv-touch.has-hover ? Colors.surface-hover : Colors.surface;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.shield;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.group-accent;
                            }
                        }
                        Text {
                            text: "Group Invites";
                            color: Colors.group-accent;
                            font-size: Typography.sm2;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: root.pending-group-invites > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.pending-group-invites > 9 ? "9+" : root.pending-group-invites;
                                color: Colors.text-primary;
                                font-size: Typography.xs2;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            Image {
                                source: Icons.shield;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.group-accent;
                            }
                            Rectangle {
                                x: parent.width - 6px;
                                y: 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Colors.error;
                            }
                        }
                    }

                    ginv-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.group-invites-clicked(); }
                    }
                }

                if root.pending-channel-invites > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: root.pending-channel-invites == 1 ? "1 channel invite" : root.pending-channel-invites + " channel invites";
                    height: 38px;
                    border-radius: Spacing.radius-sm;
                    background: cinv-touch.has-hover ? Colors.surface-hover : Colors.surface;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Image {
                                source: Icons.hash;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.primary;
                            }
                        }
                        Text {
                            text: "Channel Invites";
                            color: Colors.primary;
                            font-size: Typography.sm2;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: root.pending-channel-invites > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.pending-channel-invites > 9 ? "9+" : root.pending-channel-invites;
                                color: Colors.text-primary;
                                font-size: Typography.xs2;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    if root.collapsed: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: parent.height;
                            Image {
                                source: Icons.hash;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Colors.primary;
                            }
                            Rectangle {
                                x: parent.width - 6px;
                                y: 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Colors.error;
                            }
                        }
                    }

                    cinv-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.channel-invites-clicked(); }
                    }
                }

                // 4. MESSAGES SECTION — header label/expander only meaningful when expanded.
                // In collapsed mode the row would render as 32px of empty space, so zero it.
                Rectangle {
                    height: root.collapsed ? 0px : 32px;
                    if !root.collapsed: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.messages-expanded = !root.messages-expanded; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 4px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: Icons.chevron-right;
                                        width: 10px;
                                        height: 10px;
                                        colorize: Colors.text-muted;
                                        transform-rotation: root.messages-expanded ? 90deg : 0deg;
                                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: "Messages";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs2;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            horizontal-stretch: 0;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: add-dm-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    source: Icons.user-plus;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: add-dm-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            add-dm-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.friends-clicked(); }
                            }
                        }
                    }
                }

                if root.messages-expanded: DMList {
                    vertical-stretch: 0;
                    conversations: root.dm-conversations;
                    collapsed: root.collapsed;
                    show-header: false;
                    conversation-selected(id) => { root.dm-selected(id); }
                    add-friend-clicked => { root.friends-clicked(); }
                    dm-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "dm";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                // 5. CHANNELS SECTION — header zeroed in collapsed mode (collapsed action rail
                // below at line 593+ provides the find/new/section buttons).
                // Hidden entirely in Anon Mode — anon groups live below in a
                // separate model so this filter only kills server channels.
                if !AnonMode.enabled : Rectangle {
                    height: root.collapsed ? 0px : 32px;
                    if !root.collapsed: HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.channels-expanded = !root.channels-expanded; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 4px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: Icons.chevron-right;
                                        width: 10px;
                                        height: 10px;
                                        colorize: Colors.text-muted;
                                        transform-rotation: root.channels-expanded ? 90deg : 0deg;
                                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: "Channels";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs2;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // "+" opens the Create-Channel modal (Create | Join tabs).
                        Rectangle {
                            width: 28px;
                            horizontal-stretch: 0;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: create-ch-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    source: Icons.plus;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: create-ch-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            create-ch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.create-channel-clicked(); }
                            }
                        }
                    }
                }

                // Collapsed channel-action rail: find / new-channel / new-section
                if root.collapsed && !AnonMode.enabled : VerticalLayout {
                    spacing: 4px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    TooltipArea {
                        height: 32px; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: "New channel"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: 28px; height: 28px; border-radius: Spacing.radius-sm;
                            background: c-new-touch.has-hover ? Colors.surface-hover : transparent;
                            Image { source: Icons.plus; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-new-touch.has-hover ? Colors.text-primary : Colors.text-muted; }
                            c-new-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-channel-clicked(); } }
                        } }
                    }

                    TooltipArea {
                        height: 32px; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: "New section"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: 28px; height: 28px; border-radius: Spacing.radius-sm;
                            background: c-sec-touch.has-hover ? Colors.surface-hover : transparent;
                            Image { source: Icons.folder; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-sec-touch.has-hover ? Colors.text-primary : Colors.text-muted; }
                            c-sec-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-section-clicked(); } }
                        } }
                    }
                }

                if root.channels-expanded && !AnonMode.enabled : ChannelList {
                    vertical-stretch: 0;
                    channels: root.channels;
                    collapsed: root.collapsed;
                    show-header: false;
                    has-sibling-content: root.private-groups.length > 0;
                    channel-selected(id) => { root.channel-selected(id); }
                    channel-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "channel";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                if root.channels-expanded && root.private-groups.length > 0: PrivateGroupList {
                    vertical-stretch: 0;
                    groups: root.private-groups;
                    collapsed: root.collapsed;
                    show-header: false;
                    group-selected(id) => { root.private-group-selected(id); }
                    group-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "private_group";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                // 6. MESH — the public room, every joined geohash cell, and mesh
                // DMs. A peer of the sections above, not a mode: same list, same
                // item shape, distinguished by `ConversationType` on the Rust
                // side exactly as anon DMs are. Present in both normal and anon
                // mode — the mesh needs no server either way.
                if MeshGlobal.enabled: MeshList {
                    vertical-stretch: 0;
                    collapsed: root.collapsed;
                }

                // 4b. CUSTOM SECTIONS (user-created, between Messages and Channels)
                CustomSectionList {
                    vertical-stretch: 0;
                    sections: root.custom-sections;
                    section-conversations: root.section-conversations;
                    collapsed: root.collapsed;
                    create-section-clicked => { root.create-section-clicked(); }
                    section-toggle-expanded(id) => { root.section-toggle-expanded(id); }
                    section-conversation-selected(conv-id, conv-type) => { root.section-conversation-selected(conv-id, conv-type); }
                    delete-section-clicked(id) => { root.delete-section-clicked(id); }
                    rename-section-clicked(id) => { root.rename-section-clicked(id); }
                    section-conversation-context-menu-requested(conv-id, conv-type, section-id, x, y) => {
                        root.ctx-menu-conv-id = conv-id;
                        root.ctx-menu-conv-type = conv-type;
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = section-id;
                        root.ctx-menu-show = true;
                    }
                    section-header-context-menu-requested(section-id, x, y) => {
                        root.section-header-ctx-menu-section-id = section-id;
                        root.section-header-ctx-menu-x = x;
                        root.section-header-ctx-menu-y = y;
                        root.section-header-ctx-menu-show = true;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // 7. BOTTOM UTILITY BAR — Neo 2.0 glass surface
        Rectangle {
            height: root.collapsed ? 140px : 44px;
            background: Colors.surface.with-alpha(0.85);
            border-width: 1px;
            border-color: Colors.neo-highlight;
            drop-shadow-blur: Spacing.neo-blur-sm;
            drop-shadow-offset-y: -2px;
            drop-shadow-color: Colors.neo-shadow;

            // Expanded view: Profile + Jarvis + Settings on same row
            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm; padding-right: Spacing.sm; alignment: center; spacing: Spacing.sm;
                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(); }
                    HorizontalLayout {
                        spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Avatar { size: 24px; source: root.user-avatar-source; fallback-text: root.user-initials; show-presence: true;
                                presence-color: root.user-presence-status == "online" ? Colors.online : Colors.offline;
                            }
                        }
                        Text { text: root.user-display-name; color: Colors.text-secondary; font-size: Typography.xs; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                }
                // Anon mode toggle — shield icon, glows when active
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: root.footer-icon-size; height: root.footer-icon-size; border-radius: 4px;
                        background: anon-touch.has-hover ? Colors.surface-hover : (AnonMode.enabled ? Colors.primary.with-alpha(0.15) : transparent);
                        Image { source: Icons.shield; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: AnonMode.enabled ? Colors.primary : Colors.text-muted; }
                        // Tor status dot: green=connected, amber=connecting, red=error. Shield mode only.
                        Rectangle {
                            visible: AnonMode.enabled;
                            width: 8px; height: 8px; border-radius: 4px;
                            x: parent.width - self.width; y: 0;
                            border-width: 1px; border-color: Colors.surface;
                            background: TorStatus.state == 2 ? Colors.success
                                : TorStatus.state == 3 ? Colors.error
                                : Colors.warning;
                        }
                        anon-touch := TouchArea { clicked => { root.anon-mode-clicked(); } }
                    }
                }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: root.footer-icon-size; height: root.footer-icon-size; border-radius: 4px;
                        background: sett-touch.has-hover ? Colors.surface-hover : transparent;
                        Image { source: Icons.settings; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                        if root.server-unreachable: Rectangle {
                            x: parent.width - self.width - 1px; y: 1px;
                            width: 7px; height: 7px; border-radius: 3.5px;
                            border-width: 1px; border-color: Colors.surface;
                            background: Colors.error;
                            accessible-role: text;
                            accessible-label: "Server unreachable";
                        }
                        sett-touch := TouchArea { clicked => { root.settings-clicked(); } }
                    }
                }
                // Collapse toggle — desktop only. Mobile has no collapsed rail
                // (see `collapsed` in app.slint), so the control would do nothing
                // while still occupying a footer slot.
                if !root.mobile-mode: VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: root.footer-icon-size; height: root.footer-icon-size;
                        Image { source: Icons.chevron-left; width: 14px; height: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                        TouchArea { clicked => { root.collapsed = !root.collapsed; root.toggle-collapsed(); } }
                    }
                }
            }

            // Collapsed view: Vertical stack of icons
            if root.collapsed: VerticalLayout {
                alignment: end; spacing: 8px; padding-bottom: 8px;
                TooltipArea {
                    height: 32px; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: AnonMode.enabled ? "Anon Mode (active) - tap to disable" : "Anon Mode";
                    tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: 32px; height: 32px; border-radius: 16px;
                        background: AnonMode.enabled ? Colors.primary.with-alpha(0.2) : Colors.surface;
                        Image { source: Icons.shield; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: AnonMode.enabled ? Colors.primary : Colors.text-secondary; }
                        // Tor status dot: green=connected, amber=connecting, red=error. Shield mode only.
                        Rectangle {
                            visible: AnonMode.enabled;
                            width: 10px; height: 10px; border-radius: 5px;
                            x: parent.width - self.width - 2px; y: 2px;
                            border-width: 1px; border-color: Colors.surface;
                            background: TorStatus.state == 2 ? Colors.success
                                : TorStatus.state == 3 ? Colors.error
                                : Colors.warning;
                        }
                        TouchArea { clicked => { root.anon-mode-clicked(); } }
                    } }
                }
                TooltipArea {
                    height: 32px; width: 44px; x: (parent.width - self.width) / 2; tooltip-text: "Settings"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: 32px; height: 32px; border-radius: 16px; background: Colors.surface;
                        Image { source: Icons.settings; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        if root.server-unreachable: Rectangle {
                            x: parent.width - self.width - 1px; y: 1px;
                            width: 7px; height: 7px; border-radius: 3.5px;
                            border-width: 1px; border-color: Colors.surface;
                            background: Colors.error;
                            accessible-role: text;
                            accessible-label: "Server unreachable";
                        }
                        TouchArea { clicked => { root.settings-clicked(); } }
                    } }
                }
                TouchArea {
                    height: 32px; clicked => { root.profile-clicked(); }
                    HorizontalLayout { alignment: center;
                        Avatar { size: 28px; source: root.user-avatar-source; fallback-text: root.user-initials; show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online : Colors.offline;
                        }
                    }
                }
                TouchArea {
                    height: 24px; clicked => { root.collapsed = !root.collapsed; root.toggle-collapsed(); }
                    HorizontalLayout { alignment: center; Image { source: Icons.chevron-right; width: 14px; height: 14px; colorize: Colors.text-muted; } }
                }
            }
        }
    }

    // Section context menu overlay (renders on top of all sidebar content)
    SectionContextMenu {
        show: root.ctx-menu-show;
        position-x: root.ctx-menu-x;
        position-y: root.ctx-menu-y;
        conversation-id: root.ctx-menu-conv-id;
        conversation-type: root.ctx-menu-conv-type;
        current-section-id: root.ctx-menu-current-section-id;
        sections: root.custom-sections;

        close => {
            root.ctx-menu-show = false;
        }
        move-to-section(conv-id, conv-type, section-id) => {
            root.move-to-section(conv-id, conv-type, section-id);
        }
        remove-from-section(conv-id) => {
            root.remove-from-section(conv-id);
        }
        create-section-clicked => {
            root.create-section-clicked();
        }
    }

    // Section header context menu overlay (right-click on section header)
    SectionHeaderContextMenu {
        show: root.section-header-ctx-menu-show;
        position-x: root.section-header-ctx-menu-x;
        position-y: root.section-header-ctx-menu-y;
        section-id: root.section-header-ctx-menu-section-id;

        close => {
            root.section-header-ctx-menu-show = false;
        }
        remove-section(section-id) => {
            root.delete-section-clicked(section-id);
        }
    }
}
