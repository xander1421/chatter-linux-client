// Slack-style sidebar
//
// Layout (top to bottom):
//   1. Org switcher — horizontal button row
//   2. Search bar
//   3. Invite banners (message requests, group invites) — conditional
//   4. Channels section (merged: public + private + anonymous) — collapsible
//   5. Messages section (merged: DMs + anonymous DMs) — collapsible
//   6. Quick links (Saved Messages, Friends)
//   7. User profile bar + collapse toggle
//
// Supports collapsed mode (60px icon-only) and mobile full-width.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { ChannelList, ChannelListItemData } from "channel_list.slint";
import { DMList, DMListItemData } from "dm_list.slint";
import { PrivateGroupList, PrivateGroupListItemData } from "private_group_list.slint";
import { OrgSwitcher, OrgListItemData } from "org_switcher.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";

export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, OrgListItemData }

export component Sidebar inherits Rectangle {
    // ── Properties: Data ──
    in property <[ChannelListItemData]> channels: [];
    in property <string> selected-channel-id: "";
    in property <[DMListItemData]> dm-conversations: [];
    in property <string> selected-dm-id: "";
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <string> selected-private-group-id: "";

    // ── Properties: User profile ──
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    in property <string> user-custom-status: "";

    // ── Properties: Organization ──
    in property <string> current-org-name: "";
    in property <[OrgListItemData]> organizations: [];
    in property <bool> org-loading: false;

    // ── Properties: State ──
    in-out property <bool> collapsed: false;
    in-out property <bool> hidden: false;
    in property <bool> mobile-mode: false;
    in property <length> mobile-width: 360px;

    // ── Properties: Badges ──
    in property <int> pending-friend-requests: 0;
    in property <int> pending-message-requests: 0;
    in property <int> pending-group-invites: 0;

    // ── Callbacks ──
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback friends-clicked();
    callback profile-clicked();
    callback org-selected(/* org_id */ string);
    callback manage-org-clicked();
    callback message-requests-clicked();
    callback group-invites-clicked();
    callback toggle-collapsed();
    callback search-clicked();

    // ── Internal state ──
    property <bool> channels-expanded: true;
    property <bool> messages-expanded: true;

    // ── Sizing ──
    width: root.mobile-mode ? root.mobile-width
         : root.hidden ? Spacing.sidebar-width-hidden
         : root.collapsed ? Spacing.sidebar-width-collapsed
         : Spacing.sidebar-width;
    visible: root.mobile-mode ? true : !root.hidden;
    background: Colors.surface;

    animate width { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        // ════════════════════════════════════════
        // 1. ORG SWITCHER (button row at top)
        // ════════════════════════════════════════
        OrgSwitcher {
            current-org-name: root.current-org-name;
            organizations: root.organizations;
            collapsed: root.collapsed;
            is-loading: root.org-loading;
            org-selected(id) => { root.org-selected(id); }
            manage-org-clicked => { root.manage-org-clicked(); }
        }

        // ════════════════════════════════════════
        // 2. SEARCH BAR
        // ════════════════════════════════════════
        if !root.collapsed: Rectangle {
            height: 40px;
            Rectangle {
                x: Spacing.sm;
                y: 4px;
                width: parent.width - 2 * Spacing.sm;
                height: 32px;
                border-radius: Spacing.radius-sm;
                background: search-touch.has-hover ? Colors.surface-hover : Colors.background;

                HorizontalLayout {
                    padding-left: Spacing.sm;
                    spacing: Spacing.sm;
                    alignment: start;
                    Image {
                        source: Icons.search;
                        width: 14px;
                        height: 14px;
                        colorize: Colors.text-muted;
                    }
                    Text {
                        text: "Search...";
                        color: Colors.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                search-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.search-clicked(); }
                }
            }
        }

        // Collapsed: search icon
        if root.collapsed: TooltipArea {
            height: 36px;
            tooltip-text: "Search";
            tooltip-enabled: root.collapsed;
            placement: "right";
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: csearch-touch.has-hover ? Colors.surface-hover : transparent;
                    Image {
                        source: Icons.search;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.text-muted;
                    }
                }
            }
            csearch-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.search-clicked(); }
            }
        }

        // ════════════════════════════════════════
        // 3. INVITE BANNERS (conditional)
        // ════════════════════════════════════════

        // Message requests banner
        if root.pending-message-requests > 0: Rectangle {
            height: 38px;
            border-radius: Spacing.radius-sm;
            background: mreq-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;
                Image {
                    source: Icons.message-circle;
                    width: 16px;
                    height: 16px;
                    colorize: Colors.primary;
                }
                Text {
                    text: "Message Requests";
                    color: Colors.primary;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: root.pending-message-requests > 9 ? 22px : 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Colors.error;
                    Text {
                        text: root.pending-message-requests > 9 ? "9+" : root.pending-message-requests;
                        color: Colors.text-primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            if root.collapsed: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: parent.height;
                    Image {
                        source: Icons.message-circle;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.primary;
                    }
                    Rectangle {
                        x: parent.width - 6px;
                        y: 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Colors.error;
                    }
                }
            }

            mreq-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.message-requests-clicked(); }
            }
        }

        // Group invites banner
        if root.pending-group-invites > 0: Rectangle {
            height: 38px;
            border-radius: Spacing.radius-sm;
            background: ginv-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;
                Image {
                    source: Icons.shield;
                    width: 16px;
                    height: 16px;
                    colorize: #9333ea;
                }
                Text {
                    text: "Group Invites";
                    color: #9333ea;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: root.pending-group-invites > 9 ? 22px : 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Colors.error;
                    Text {
                        text: root.pending-group-invites > 9 ? "9+" : root.pending-group-invites;
                        color: Colors.text-primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            if root.collapsed: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: parent.height;
                    Image {
                        source: Icons.shield;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #9333ea;
                    }
                    Rectangle {
                        x: parent.width - 6px;
                        y: 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Colors.error;
                    }
                }
            }

            ginv-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.group-invites-clicked(); }
            }
        }

        // Separator
        Rectangle { height: 1px; background: Colors.surface-hover; }

        // ════════════════════════════════════════
        // 4. CHANNELS SECTION (merged: channels + private groups)
        // ════════════════════════════════════════

        // Section header with collapse toggle + action buttons
        Rectangle {
            height: 32px;

            if !root.collapsed: HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;

                // Collapse toggle (chevron + label)
                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: pointer;
                    clicked => { root.channels-expanded = !root.channels-expanded; }

                    HorizontalLayout {
                        padding-left: 2px;
                        spacing: 4px;
                        alignment: start;
                        Image {
                            source: Icons.chevron-right;
                            width: 10px;
                            height: 10px;
                            colorize: Colors.text-muted;
                            transform-rotation: root.channels-expanded ? 90deg : 0deg;
                        }
                        Text {
                            text: "Channels";
                            color: Colors.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Browse/join channels button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: join-ch-touch.has-hover ? Colors.surface-hover : transparent;
                    Image {
                        source: Icons.search;
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: join-ch-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }
                    join-ch-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.join-channel-clicked(); }
                    }
                }

                // Create channel button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: create-ch-touch.has-hover ? Colors.surface-hover : transparent;
                    Image {
                        source: Icons.plus;
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: create-ch-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }
                    create-ch-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.create-channel-clicked(); }
                    }
                }
            }

            // Collapsed: centered + button
            if root.collapsed: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: ccreate-touch.has-hover ? Colors.surface-hover : transparent;
                    Image {
                        source: Icons.plus;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: ccreate-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }
                    ccreate-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.create-channel-clicked(); }
                    }
                }
            }
        }

        // Channel items (uses existing ChannelList, header hidden)
        if root.channels-expanded: ChannelList {
            vertical-stretch: 1;
            channels: root.channels;
            selected-channel-id: root.selected-channel-id;
            collapsed: root.collapsed;
            show-header: false;
            channel-selected(id) => { root.channel-selected(id); }
            create-channel-clicked => { root.create-channel-clicked(); }
            join-channel-clicked => { root.join-channel-clicked(); }
        }

        // Private groups (merged into Channels section, header hidden)
        if root.channels-expanded && root.private-groups.length > 0: PrivateGroupList {
            vertical-stretch: 0;
            max-height: 200px;
            groups: root.private-groups;
            selected-group-id: root.selected-private-group-id;
            collapsed: root.collapsed;
            show-header: false;
            group-selected(id) => { root.private-group-selected(id); }
            create-group-clicked => { root.create-channel-clicked(); }
        }

        // Separator
        Rectangle { height: 1px; background: Colors.surface-hover; }

        // ════════════════════════════════════════
        // 5. MESSAGES SECTION (DMs + anonymous DMs merged)
        // ════════════════════════════════════════

        // Section header
        Rectangle {
            height: 32px;

            if !root.collapsed: HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;

                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: pointer;
                    clicked => { root.messages-expanded = !root.messages-expanded; }

                    HorizontalLayout {
                        padding-left: 2px;
                        spacing: 4px;
                        alignment: start;
                        Image {
                            source: Icons.chevron-right;
                            width: 10px;
                            height: 10px;
                            colorize: Colors.text-muted;
                            transform-rotation: root.messages-expanded ? 90deg : 0deg;
                        }
                        Text {
                            text: "Messages";
                            color: Colors.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Add message / new DM button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: add-dm-touch.has-hover ? Colors.surface-hover : transparent;
                    Image {
                        source: Icons.plus;
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: add-dm-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                    }
                    add-dm-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.friends-clicked(); }
                    }
                }
            }

            // Collapsed: no header needed (DM items show avatars)
            if root.collapsed: Rectangle {}
        }

        // DM list items (header hidden)
        if root.messages-expanded: DMList {
            vertical-stretch: 1;
            min-height: 100px;
            conversations: root.dm-conversations;
            selected-conversation-id: root.selected-dm-id;
            collapsed: root.collapsed;
            show-header: false;
            conversation-selected(id) => { root.dm-selected(id); }
            add-friend-clicked => { root.friends-clicked(); }
        }

        // Separator
        Rectangle { height: 1px; background: Colors.surface-hover; }

        // ════════════════════════════════════════
        // 6. QUICK LINKS (Saved Messages, Friends)
        // ════════════════════════════════════════

        // Saved Messages
        Rectangle {
            height: 34px;
            background: saved-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;
                Image {
                    source: Icons.bookmark;
                    width: 14px;
                    height: 14px;
                    colorize: Colors.text-secondary;
                }
                Text {
                    text: "Saved Messages";
                    color: Colors.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            if root.collapsed: TooltipArea {
                width: 100%;
                height: 100%;
                tooltip-text: "Saved Messages";
                tooltip-enabled: root.collapsed;
                placement: "right";
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: Icons.bookmark;
                        width: 16px;
                        height: 16px;
                        colorize: Colors.text-secondary;
                    }
                }
            }

            saved-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.saved-messages-clicked(); }
            }
        }

        // Friends
        Rectangle {
            height: 34px;
            background: friends-touch.has-hover ? Colors.surface-hover : Colors.surface;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;
                Image {
                    source: Icons.users;
                    width: 14px;
                    height: 14px;
                    colorize: friends-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                }
                Text {
                    text: "Friends";
                    color: Colors.text-secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.pending-friend-requests > 0: Rectangle {
                    width: root.pending-friend-requests > 9 ? 22px : 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Colors.error;
                    Text {
                        text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                        color: Colors.text-primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            if root.collapsed: TooltipArea {
                width: 100%;
                height: 100%;
                tooltip-text: "Friends";
                tooltip-enabled: root.collapsed;
                placement: "right";
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: parent.height;
                        Image {
                            source: Icons.users;
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            colorize: Colors.text-secondary;
                        }
                        if root.pending-friend-requests > 0: Rectangle {
                            x: parent.width - 6px;
                            y: 6px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: Colors.error;
                        }
                    }
                }
            }

            friends-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.friends-clicked(); }
            }
        }

        // Separator
        Rectangle { height: 1px; background: Colors.surface-hover; }

        // ════════════════════════════════════════
        // 7. BOTTOM BAR (user profile + collapse toggle)
        // ════════════════════════════════════════
        Rectangle {
            height: 44px;
            background: Colors.background;

            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: start;

                // Mini avatar (clickable for profile)
                TouchArea {
                    width: 28px;
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(); }

                    HorizontalLayout {
                        alignment: center;
                        Avatar {
                            size: 28px;
                            source: root.user-avatar-source;
                            fallback-text: root.user-initials;
                            show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online
                                         : root.user-presence-status == "away" ? Colors.away
                                         : root.user-presence-status == "dnd" ? Colors.dnd
                                         : Colors.offline;
                        }
                    }
                }

                // Name + status
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.user-display-name;
                        color: Colors.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.user-presence-status == "online" ? "Online"
                            : root.user-presence-status == "away" ? "Away"
                            : root.user-presence-status == "dnd" ? "Do Not Disturb"
                            : "Offline";
                        color: Colors.text-muted;
                        font-size: 10px;
                        overflow: elide;
                    }
                }

                // Collapse toggle
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: collapse-touch.has-hover ? Colors.surface-hover : transparent;

                    Image {
                        source: Icons.chevron-left;
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Colors.text-muted;
                    }
                    collapse-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.collapsed = !root.collapsed;
                            root.toggle-collapsed();
                        }
                    }
                }
            }

            // Collapsed: centered avatar + expand chevron
            if root.collapsed: VerticalLayout {
                alignment: center;
                spacing: 4px;

                TouchArea {
                    height: 28px;
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(); }
                    HorizontalLayout {
                        alignment: center;
                        Avatar {
                            size: 28px;
                            source: root.user-avatar-source;
                            fallback-text: root.user-initials;
                            show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online
                                         : root.user-presence-status == "away" ? Colors.away
                                         : root.user-presence-status == "dnd" ? Colors.dnd
                                         : Colors.offline;
                        }
                    }
                }

                TouchArea {
                    height: 14px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.collapsed = !root.collapsed;
                        root.toggle-collapsed();
                    }
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: Icons.chevron-right;
                            width: 14px;
                            height: 14px;
                            colorize: Colors.text-muted;
                        }
                    }
                }
            }
        }
    }
}
