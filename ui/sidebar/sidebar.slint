// Sidebar — Neo 2.0
//
// Layout (top to bottom):
//   1. Search bar — inset surface
//   2. Scrollable content with flat/inset list items
//   3. Bottom bar — glass surface
//
// Neo depth separation: sidebar surface is raised from background,
// with right-edge highlight border. Internal elements use
// inset (search, selected items) and glass (bottom bar) surfaces.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { ChannelList, ChannelListItemData } from "channel_list.slint";
import { DMList, DMListItemData } from "dm_list.slint";
import { PrivateGroupList, PrivateGroupListItemData } from "private_group_list.slint";
import { CustomSectionList, CustomSectionData, SectionConversationData } from "custom_section_list.slint";
import { SectionContextMenu, SectionHeaderContextMenu } from "section_context_menu.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { AnonMode, TorStatus } from "../anon_mode/anon_mode_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";
import { MeshList } from "../mesh/mesh_list.slint";

export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, CustomSectionData, SectionConversationData }

export component Sidebar inherits Rectangle {
    // ── Properties: Data ──
    in property <[ChannelListItemData]> channels: [];
    in property <[DMListItemData]> dm-conversations: [];
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <[CustomSectionData]> custom-sections: [];

    // ── Properties: User profile ──
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";

    // ── Properties: State ──
    in-out property <bool> collapsed: false;
    in-out property <bool> hidden: false;
    in property <bool> mobile-mode: false;
    // The server is settled-unreachable. Shown as a dot on the settings button,
    // mirroring how the anon-mode button carries its Tor dot, so the connection
    // banner can be dismissed without the outage becoming invisible.
    in property <bool> server-unreachable: false;
    in property <length> mobile-width: 360px;
    // macOS unified titlebar: the traffic lights are drawn over this panel's
    // top-left corner (app.slint stopped reserving a row for them). Both are
    // 0 everywhere else, which turns every use below into a no-op.
    in property <length> traffic-lights-width: 0px;
    in property <length> titlebar-height: 0px;

    // ── Properties: Badges ──
    in property <int> pending-friend-requests: 0;
    in property <int> pending-message-requests: 0;
    in property <int> pending-group-invites: 0;
    in property <int> pending-channel-invites: 0;
    property <int> total-pending-requests: root.pending-friend-requests
        + root.pending-message-requests + root.pending-group-invites + root.pending-channel-invites;

    // ── Callbacks ──
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback search-clicked();
    callback saved-messages-clicked();
    callback create-channel-clicked();
    callback join-channel-clicked();
    callback friends-clicked();
    callback profile-clicked();
    callback friend-requests-clicked();
    callback message-requests-clicked();
    callback group-invites-clicked();
    callback channel-invites-clicked();
    callback toggle-collapsed();
    callback settings-clicked();
    callback anon-mode-clicked();
    callback create-section-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ string);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ string, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);
    callback set-conversation-pinned(/* conversation-id */ string, /* pinned */ bool);
    callback move-section(/* section-id */ string, /* delta */ int);
    callback set-section-sort-mode(/* section-id */ string, /* mode */ string);

    // ── Internal state ──
    // Quick-link rows are 34px for mouse density; on a touch screen that is
    // under a finger's width, so touch gets the 48px minimum instead.
    // Quick-links (Search, Saved Messages) sit in the same column as the
    // conversation rows, so on touch they take the same geometry and the same
    // type. They were 48px tall with 14px grey labels next to 72px rows with
    // 16px white names — close enough to look like a mistake rather than a
    // distinction, which is what "the text is different sizes" is.
    // NOT the conversation-row height. A conversation row is 72px because it
    // carries a 52px avatar and two lines of text; a quick link carries one
    // icon and one word. At the same 72px the two read as different sizes —
    // the conversation rows look dense and the quick links look like they have
    // a hole punched between them, which is the "huge space from Search to
    // Saved" complaint. 56px is the standard list row: same type, same tap
    // target, no cavern.
    property <length> quick-link-height: root.mobile-mode ? 56px : 34px;
    // The panel's first row, pinned above the scroll. On desktop it takes the
    // shared header height so it and the conversation header beside it read as
    // one row across the seam — and on macOS that is the row the traffic
    // lights are in. Mobile keeps the conversation-row geometry: there the
    // panel IS the screen, so its first row belongs to the list.
    property <length> top-row-height: root.mobile-mode ? Spacing.row-height-touch : Spacing.header-height;
    property <length> quick-link-text-size: root.mobile-mode ? Typography.base : Typography.sm2;
    property <brush> quick-link-text-color: root.mobile-mode ? Colors.text-primary : Colors.text-secondary;
    property <length> quick-link-icon-size: root.mobile-mode ? 24px : 14px;
    // The expanded panel's footer row. 36px on touch, not the full 48px
    // minimum: the panel is capped at 45% of a phone's width, and three 48px
    // buttons plus the avatar and name overflowed it — which silently pushed
    // the LAST button (collapse) off the right edge, stranding the user in the
    // expanded state. 36px is the largest that fits with the collapse control
    // still on screen; the rail's buttons, which have the whole width to
    // themselves, keep the full 48px.
    property <length> footer-icon-size: root.mobile-mode ? 36px : 24px;
    // One size for every button in the collapsed rail's bottom cluster, so the
    // container height below stays in step with them.
    property <length> rail-icon-size: root.mobile-mode ? Spacing.touch-target-min : 32px;
    // The visual plate inside a rail row. Smaller than the row so adjacent slots
    // do not touch; the row stays the touch target, the slot is what you see.
    property <length> rail-slot-size: root.mobile-mode ? 44px : 32px;
    property <length> rail-slot-radius: 12px;
    property <brush> rail-slot-bg: Colors.surface-hover;
    property <bool> rail-has-mesh: MeshGlobal.enabled && MeshGlobal.conversations.length > 0;
    // AI, Mesh (conditional), expand, Settings, anon shield, profile.
    property <int> rail-button-count: root.rail-has-mesh ? 6 : 5;
    property <bool> channels-expanded: true;
    property <bool> messages-expanded: true;

    // Context menu state
    property <bool> ctx-menu-show: false;
    property <length> ctx-menu-x: 0;
    property <length> ctx-menu-y: 0;
    property <string> ctx-menu-conv-id: "";
    property <string> ctx-menu-conv-type: "";
    property <string> ctx-menu-current-section-id: "";
    property <bool> ctx-menu-is-pinned: false;
    // Private groups are the one list core does not order, so a pin there
    // would set a flag nothing reads. Hide the entry rather than lie.
    property <bool> ctx-menu-can-pin: true;

    // Section header context menu state
    property <bool> section-header-ctx-menu-show: false;
    property <length> section-header-ctx-menu-x: 0;
    property <length> section-header-ctx-menu-y: 0;
    property <string> section-header-ctx-menu-section-id: "";
    property <string> section-header-ctx-menu-sort-mode: "recent";

    // ── Sizing ──
    // Always a side panel, on every platform: collapsed to the icon rail or
    // expanded to the list, never a full-screen view that swaps the chat out.
    // `mobile-mode` here means "touch input", and sizes the targets below; it
    // does NOT change the layout.
    // Expanded on touch, the panel takes the WHOLE screen. 240px is 58% of a
    // 411dp phone and 45% is not much better: at either width the panel is too
    // cramped to browse folders in and the chat behind it is too narrow to read,
    // so the split served neither. Expanded is now a full-screen list you go to,
    // browse, and leave by collapsing back to the rail — the rail is what keeps
    // navigation always-available, which is why the panel does not have to.
    // `mobile-width` is fed the window width by app.slint.
    width: root.hidden ? Spacing.sidebar-width-hidden
         : root.collapsed ? (root.mobile-mode ? 68px : Spacing.sidebar-width-collapsed)
         : root.mobile-mode ? root.mobile-width
         : Spacing.sidebar-width;
    visible: !root.hidden;
    // Neo 2.0: sidebar is a raised surface with right-edge highlight.
    // In Anon Mode, slightly shift the surface tint toward primary so the
    // user has a constant visual cue the mode is active.
    // Same reasoning as the lists inside it: a phone shows this panel full
    // screen, so it is the page and takes the page colour. Desktop keeps the
    // raised-panel tone that separates it from the chat column beside it.
    background: AnonMode.enabled ? Colors.primary.with-alpha(0.08)
              : root.mobile-mode ? Colors.background
              : Colors.surface;
    // No `border-width` here: this is a right-EDGE highlight in intent and
    // Slint's border draws all four sides. On a phone that traced a hairline
    // rectangle around the whole display; on desktop it now also ran a line
    // across the top of the title row, right under the traffic lights. The
    // edge is drawn explicitly below instead, on the one side that means
    // something. The shadow has nothing to cast onto on a phone either.
    drop-shadow-blur: root.mobile-mode ? 0px : Spacing.neo-blur-md;
    drop-shadow-offset-x: root.mobile-mode ? 0px : Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    animate width { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        // ════════════════════════════════════════
        // FIXED TOP ROW — the app's title row
        // ════════════════════════════════════════
        // Search sits here rather than at the head of the scroll below for two
        // reasons: it is the row Telegram (and every native list app) keeps
        // pinned, and on macOS the traffic lights are painted over this corner,
        // so a row that scrolls would slide conversations under them.
        if !root.collapsed: Rectangle {
            horizontal-stretch: 1;
            height: root.top-row-height;
            background: search-touch.has-hover ? Colors.surface-hover : transparent;
            accessible-role: button;
            accessible-label: "Search";
            HorizontalLayout {
                // The traffic lights own the leading edge of this row on macOS
                // (0px elsewhere), so the search entry starts after them.
                padding-left: Spacing.sm + root.traffic-lights-width;
                padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Image { source: Icons.search; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; }
                }
                Text { text: "Search"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; }
            }
            search-touch := TouchArea { mouse-cursor: pointer; clicked => { root.search-clicked(); } }
        }
        // Collapsed to the rail, the panel is narrower than the traffic lights
        // are wide, so nothing can share their row — the rail's slots start
        // below them instead. Zero height off macOS.
        if root.collapsed && root.traffic-lights-width > 0px: Rectangle {
            height: root.titlebar-height;
        }

        // ════════════════════════════════════════
        // SCROLLABLE CENTRAL CONTENT
        // ════════════════════════════════════════
        Flickable {
            vertical-stretch: 1;
            viewport-height: central-layout.preferred-height;

            central-layout := VerticalLayout {
                padding-top: Spacing.sm;
                padding-bottom: Spacing.md;

                // QUICK LINKS (top navigation)

                // Search's rail slot. The expanded row is pinned above the
                // scroll; the rail has no room to pin anything, so here it is
                // an ordinary slot at the head of the stack.
                if root.collapsed: Rectangle {
                    height: root.quick-link-height;
                    accessible-role: button;
                    accessible-label: "Search";
                    TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Search"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: Icons.search; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.search-clicked(); } }
                }

                if !AnonMode.enabled : Rectangle {
                    height: root.quick-link-height;
                    background: saved-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Saved Messages";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: Icons.bookmark; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; }
                        }
                        Text { text: "Saved Messages"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Saved Messages"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: Icons.bookmark; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    saved-touch := TouchArea { clicked => { root.saved-messages-clicked(); } }
                }

                // Visible in BOTH modes. In shield mode it's the entry to add an
                // ANON contact via private code (the modal is private-only there);
                // labelled "Add Contact" to avoid implying the server friend list.
                //
                // Hidden on mobile: the bottom tab bar's Contacts tab opens the
                // very same modal, and two permanent entry points to one screen
                // is the duplication that made the phone layout read as two
                // navigation systems running at once.
                if !root.mobile-mode: Rectangle {
                    height: root.quick-link-height;
                    background: friends-touch.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: AnonMode.enabled ? "Add Contact" : "Friends";
                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: AnonMode.enabled ? Icons.user-plus : Icons.users; width: root.quick-link-icon-size; height: root.quick-link-icon-size; colorize: Colors.text-secondary; }
                        }
                        Text { text: AnonMode.enabled ? "Add Contact" : "Friends"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: AnonMode.enabled ? "Add Contact" : "Friends"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg; Image { source: AnonMode.enabled ? Icons.user-plus : Icons.users; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; } } } }
                    }
                    friends-touch := TouchArea { clicked => { root.friends-clicked(); } }
                }

                // REQUESTS entry point — one calm row, not four competing
                // alert banners. Friend requests, message requests, group
                // invites, and channel invites used to each render their own
                // full-width colored banner (bold text, its own accent color)
                // any time their count was nonzero, so a user with several
                // kinds of pending item at once saw a wall of near-identical
                // "look at me" rows before reaching a single conversation —
                // everything shouting is the same as nothing being
                // prioritized. This is one row in the same quiet style as
                // Search/Saved Messages/Friends above it, with the combined
                // count as its badge; the four kinds live one level deeper,
                // as tabs already built into the Friends modal's Requests
                // tab (requests-sub-tab: received/sent/private/groups/
                // channels) — nothing lost, just not all surfaced at once.
                if root.total-pending-requests > 0: Rectangle {
                    height: root.quick-link-height;
                    accessible-role: button;
                    accessible-label: root.total-pending-requests == 1 ? "1 request" : root.total-pending-requests + " requests";
                    background: requests-touch.has-hover ? Colors.surface-hover : transparent;

                    if !root.collapsed: HorizontalLayout {
                        padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Image { source: Icons.user-plus; width: 14px; height: 14px; colorize: Colors.text-secondary; }
                        }
                        Text { text: "Requests"; color: root.quick-link-text-color; font-size: root.quick-link-text-size; vertical-alignment: center; horizontal-stretch: 1; }
                        Rectangle {
                            width: root.total-pending-requests > 9 ? 22px : 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Colors.error;
                            Text {
                                text: root.total-pending-requests > 9 ? "9+" : root.total-pending-requests;
                                color: Colors.text-primary;
                                font-size: Typography.xs2;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                    if root.collapsed: TooltipArea {
                        width: 44px; x: (parent.width - self.width) / 2; height: 100%;
                        tooltip-text: "Requests"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                            Image { source: Icons.user-plus; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                            Rectangle {
                                x: parent.width - 8px; y: -2px;
                                width: 12px; height: 12px; border-radius: 6px;
                                border-width: 1px; border-color: Colors.surface;
                                background: Colors.error;
                            }
                        } } }
                    }

                    requests-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // Fire every original callback so each request
                            // type's own data refresh (its list, its badge
                            // count) still happens exactly as before — this
                            // consolidates the SIDEBAR ROW, not the
                            // underlying refresh logic. See navigation.rs.
                            root.friend-requests-clicked();
                            root.message-requests-clicked();
                            root.group-invites-clicked();
                            root.channel-invites-clicked();
                        }
                    }
                }

                // 4. MESSAGES SECTION — header label/expander only meaningful when expanded.
                // In collapsed mode the row would render as 32px of empty space, so zero it.
                Rectangle {
                    // 42px, not 32, with the label pushed to the bottom of it.
                    // A section header centred in its own box sits the same
                    // distance from the group above as from the group it names,
                    // so it binds to neither and the list reads as one long run
                    // of rows. The extra space goes above the label only.
                    // Telegram has no section headers — one flat run of
                    // conversations, newest first. Grouping DMs apart from
                    // channels is a desktop convenience that on a phone just
                    // spends a row telling you what the next rows obviously
                    // are, and the collapse chevrons hide conversations behind
                    // a tap for no gain. Desktop keeps them.
                    height: root.collapsed || root.mobile-mode ? 0px : 42px;
                    if !root.collapsed && !root.mobile-mode: HorizontalLayout {
                        padding-top: 10px;
                        padding-left: 6px;
                        padding-right: 4px;
                        TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.messages-expanded = !root.messages-expanded; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 4px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: Icons.chevron-right;
                                        width: 10px;
                                        height: 10px;
                                        colorize: Colors.text-muted;
                                        transform-rotation: root.messages-expanded ? 90deg : 0deg;
                                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: "Messages";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs2;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            horizontal-stretch: 0;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: add-dm-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    source: Icons.user-plus;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: add-dm-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            add-dm-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.friends-clicked(); }
                            }
                        }
                    }
                }

                if root.messages-expanded: DMList {
                    vertical-stretch: 0;
                    conversations: root.dm-conversations;
                    collapsed: root.collapsed;
                    mobile-mode: root.mobile-mode;
                    show-header: false;
                    conversation-selected(id) => { root.dm-selected(id); }
                    add-friend-clicked => { root.friends-clicked(); }
                    dm-context-menu-requested(id, pinned, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-is-pinned = pinned;
                        root.ctx-menu-can-pin = true;
                        // Core's vocabulary, not the UI's: ConversationType
                        // (domain/message.rs) has never accepted "dm", so this
                        // menu silently no-oped on every DM.
                        root.ctx-menu-conv-type = AnonMode.enabled ? "anon_dm" : "server_dm";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                // 5. CHANNELS SECTION — header zeroed in collapsed mode (collapsed action rail
                // below at line 593+ provides the find/new/section buttons).
                // Hidden entirely in Anon Mode — anon groups live below in a
                // separate model so this filter only kills server channels.
                if !AnonMode.enabled : Rectangle {
                    // 42px, not 32, with the label pushed to the bottom of it.
                    // A section header centred in its own box sits the same
                    // distance from the group above as from the group it names,
                    // so it binds to neither and the list reads as one long run
                    // of rows. The extra space goes above the label only.
                    // Telegram has no section headers — one flat run of
                    // conversations, newest first. Grouping DMs apart from
                    // channels is a desktop convenience that on a phone just
                    // spends a row telling you what the next rows obviously
                    // are, and the collapse chevrons hide conversations behind
                    // a tap for no gain. Desktop keeps them.
                    height: root.collapsed || root.mobile-mode ? 0px : 42px;
                    if !root.collapsed && !root.mobile-mode: HorizontalLayout {
                        padding-top: 10px;
                        padding-left: 6px;
                        padding-right: 4px;
                        TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.channels-expanded = !root.channels-expanded; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 4px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: Icons.chevron-right;
                                        width: 10px;
                                        height: 10px;
                                        colorize: Colors.text-muted;
                                        transform-rotation: root.channels-expanded ? 90deg : 0deg;
                                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    text: "Channels";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs2;
                                    font-weight: 600;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // "+" opens the Create-Channel modal (Create | Join tabs).
                        Rectangle {
                            width: 28px;
                            horizontal-stretch: 0;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: Spacing.radius-sm;
                                background: create-ch-touch.has-hover ? Colors.surface-hover : transparent;

                                Image {
                                    source: Icons.plus;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: create-ch-touch.has-hover ? Colors.text-primary : Colors.text-muted;
                                }
                            }

                            create-ch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.create-channel-clicked(); }
                            }
                        }
                    }
                }

                // Collapsed channel-action rail: find / new-channel / new-section
                if root.collapsed && !AnonMode.enabled : VerticalLayout {
                    spacing: 4px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    TooltipArea {
                        height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: "New channel"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                            background: c-new-touch.has-hover ? Colors.surface-hover.brighter(0.6) : root.rail-slot-bg;
                            Image { source: Icons.plus; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-new-touch.has-hover ? Colors.text-primary : Colors.text-muted; }
                            c-new-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-channel-clicked(); } }
                        } }
                    }

                    TooltipArea {
                        height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                        tooltip-text: "New section"; tooltip-enabled: true; placement: "right";
                        HorizontalLayout { alignment: center; Rectangle {
                            width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                            background: c-sec-touch.has-hover ? Colors.surface-hover.brighter(0.6) : root.rail-slot-bg;
                            Image { source: Icons.folder; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: c-sec-touch.has-hover ? Colors.text-primary : Colors.text-muted; }
                            c-sec-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-section-clicked(); } }
                        } }
                    }
                }

                if root.channels-expanded && !AnonMode.enabled : ChannelList {
                    vertical-stretch: 0;
                    channels: root.channels;
                    collapsed: root.collapsed;
                    mobile-mode: root.mobile-mode;
                    show-header: false;
                    has-sibling-content: root.private-groups.length > 0;
                    channel-selected(id) => { root.channel-selected(id); }
                    // FEAT-8: ChannelList emits this from its header search
                    // button AND from the empty-state CTA, which is the FIRST
                    // control a brand-new account ever sees (the empty state
                    // renders exactly when channels.length == 0). This binding
                    // was missing, so that button did nothing at all. app.slint
                    // turns it into the join tab of CreateChannelModal.
                    join-channel-clicked() => { root.join-channel-clicked(); }
                    channel-context-menu-requested(id, pinned, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-conv-type = "channel";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-is-pinned = pinned;
                        root.ctx-menu-can-pin = true;
                        root.ctx-menu-show = true;
                    }
                }

                if root.channels-expanded && root.private-groups.length > 0: PrivateGroupList {
                    vertical-stretch: 0;
                    mobile-mode: root.mobile-mode;
                    groups: root.private-groups;
                    collapsed: root.collapsed;
                    show-header: false;
                    group-selected(id) => { root.private-group-selected(id); }
                    group-context-menu-requested(id, x, y) => {
                        root.ctx-menu-conv-id = id;
                        root.ctx-menu-is-pinned = false;
                        root.ctx-menu-can-pin = false;
                        // A private group is an anon_group in core. "private_group" is not
                        // a ConversationType and silently no-oped.
                        root.ctx-menu-conv-type = "anon_group";
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = "";
                        root.ctx-menu-show = true;
                    }
                }

                // 6. MESH — the public room, every joined geohash cell, and mesh
                // DMs. A peer of the sections above, not a mode: same list, same
                // item shape, distinguished by `ConversationType` on the Rust
                // side exactly as anon DMs are. Present in both normal and anon
                // mode — the mesh needs no server either way.
                if MeshGlobal.enabled: MeshList {
                    vertical-stretch: 0;
                    collapsed: root.collapsed;
                }

                // 4b. CUSTOM SECTIONS (user-created, between Messages and Channels)
                CustomSectionList {
                    vertical-stretch: 0;
                    sections: root.custom-sections;
                    collapsed: root.collapsed;
                    mobile-mode: root.mobile-mode;
                    create-section-clicked => { root.create-section-clicked(); }
                    section-toggle-expanded(id) => { root.section-toggle-expanded(id); }
                    section-conversation-selected(conv-id, conv-type) => { root.section-conversation-selected(conv-id, conv-type); }
                    delete-section-clicked(id) => { root.delete-section-clicked(id); }
                    rename-section-clicked(id) => { root.rename-section-clicked(id); }
                    section-conversation-context-menu-requested(conv-id, conv-type, section-id, pinned, x, y) => {
                        root.ctx-menu-conv-id = conv-id;
                        root.ctx-menu-conv-type = conv-type;
                        root.ctx-menu-x = x;
                        root.ctx-menu-y = y;
                        root.ctx-menu-current-section-id = section-id;
                        root.ctx-menu-is-pinned = pinned;
                        root.ctx-menu-can-pin = conv-type != "anon_group";
                        root.ctx-menu-show = true;
                    }
                    section-header-context-menu-requested(section-id, sort-mode, x, y) => {
                        root.section-header-ctx-menu-section-id = section-id;
                        root.section-header-ctx-menu-x = x;
                        root.section-header-ctx-menu-y = y;
                        // Carried up from the row rather than looked up: Slint
                        // has no way to search a model from a callback body.
                        root.section-header-ctx-menu-sort-mode = sort-mode;
                        root.section-header-ctx-menu-show = true;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // 7. BOTTOM UTILITY BAR — Neo 2.0 glass surface.
        // Desktop only. On mobile its last occupant (the shield) moved up onto
        // the search row, and what remained was a translucent grey strip across
        // the foot of the list holding nothing — visible as a lighter rectangle
        // above the floating dock.
        if !root.mobile-mode: Rectangle {
            // Derived, not a magic number: this was hardcoded at 140px, which
            // fit the three 32px buttons the rail used to have and silently
            // clipped everything past them off the bottom of the screen once
            // the cluster grew. 8px inter-item spacing + 8px padding-bottom,
            // matching the layout below.
            height: root.collapsed
                ? root.rail-button-count * root.rail-icon-size
                    + (root.rail-button-count - 1) * 8px + 16px
                : 44px;
            background: Colors.surface.with-alpha(0.85);
            drop-shadow-blur: Spacing.neo-blur-sm;
            drop-shadow-offset-y: -2px;
            drop-shadow-color: Colors.neo-shadow;

            // Top edge only — the one side that separates this strip from the
            // list. The four-sided border it replaces doubled up against the
            // panel's own left/right edges and closed a box around the footer.
            Rectangle {
                y: 0;
                width: 100%;
                height: 1px;
                background: Colors.neo-highlight;
            }

            // Expanded view: Profile + Jarvis + Settings on same row
            // No `alignment` — under any alignment other than stretch, Slint
            // sizes every child to its PREFERRED width and ignores
            // horizontal-stretch, so the display name pushed the icons past the
            // right edge and the last one (collapse) was clipped away entirely.
            // Stretching lets the name elide and keeps the buttons on screen.
            if !root.collapsed: HorizontalLayout {
                padding-left: Spacing.sm; padding-right: Spacing.sm; spacing: Spacing.sm;
                // Profile moved to the bottom tab bar's rightmost tab on mobile,
                // where it carries the user's avatar — a name-and-avatar strip
                // wedged between the last conversation and the tab bar was
                // neither a list row nor navigation, and read as leftover.
                if !root.mobile-mode: TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: pointer;
                    clicked => { root.profile-clicked(); }
                    HorizontalLayout {
                        spacing: Spacing.sm; alignment: start;
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Avatar { size: 24px; source: root.user-avatar-source; fallback-text: root.user-initials; show-presence: true;
                                presence-color: root.user-presence-status == "online" ? Colors.online : Colors.offline;
                            }
                        }
                        Text { text: root.user-display-name; color: Colors.text-secondary; font-size: Typography.xs; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                }
                // Keeps the shield on the right edge now that nothing precedes it.
                if root.mobile-mode: Rectangle { horizontal-stretch: 1; }
                // Anon mode toggle — shield icon, glows when active.
                //
                // STUB-1: gated on the `onion` Cargo feature (mirrored into
                // AnonMode.onion-built from lib.rs). A build without it cannot
                // put traffic on the onion, so it must not offer a control that
                // says it will.
                if AnonMode.onion-built: VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: root.footer-icon-size; height: root.footer-icon-size; border-radius: 4px;
                        background: anon-touch.has-hover ? Colors.surface-hover : (AnonMode.enabled ? Colors.primary.with-alpha(0.15) : transparent);
                        Image { source: Icons.shield; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: AnonMode.enabled ? Colors.primary : Colors.text-muted; }
                        // Tor status dot: green=connected, amber=CONNECTING ONLY,
                        // red=error, muted=off. State 0 is Off — traffic is going
                        // direct — and it used to fall through to amber, i.e. the
                        // dot claimed "connecting" forever on a build with no Tor
                        // in it. Shield mode only.
                        Rectangle {
                            visible: AnonMode.enabled;
                            width: 8px; height: 8px; border-radius: 4px;
                            x: parent.width - self.width; y: 0;
                            border-width: 1px; border-color: Colors.surface;
                            background: TorStatus.state == 2 ? Colors.success
                                : TorStatus.state == 3 ? Colors.error
                                : TorStatus.state == 1 ? Colors.warning
                                : Colors.text-muted;
                        }
                        anon-touch := TouchArea { clicked => { root.anon-mode-clicked(); } }
                    }
                }
                // Settings lives in the bottom tab bar on mobile — this is the
                // same destination, so keeping both is the duplication again.
                if !root.mobile-mode: VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: root.footer-icon-size; height: root.footer-icon-size; border-radius: 4px;
                        background: sett-touch.has-hover ? Colors.surface-hover : transparent;
                        Image { source: Icons.settings; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                        if root.server-unreachable: Rectangle {
                            x: parent.width - self.width - 1px; y: 1px;
                            width: 7px; height: 7px; border-radius: 3.5px;
                            border-width: 1px; border-color: Colors.surface;
                            background: Colors.error;
                            accessible-role: text;
                            accessible-label: "Server unreachable";
                        }
                        sett-touch := TouchArea { clicked => { root.settings-clicked(); } }
                    }
                }
                // Collapse back to the rail. The expanded panel needs its own
                // copy: the rail's cluster only exists while collapsed, so
                // without this, expanding was a one-way trip.
                //
                // There is no rail on mobile to collapse into — the list either
                // is the screen or the conversation is — so the control has
                // nothing to do there.
                if !root.mobile-mode: VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: root.footer-icon-size; height: root.footer-icon-size; border-radius: 4px;
                        background: collapse-touch.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Collapse sidebar";
                        Image { source: Icons.chevron-left; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                        collapse-touch := TouchArea { clicked => { root.collapsed = !root.collapsed; root.toggle-collapsed(); } }
                    }
                }
            }

            // Collapsed view: Vertical stack of icons
            if root.collapsed: VerticalLayout {
                alignment: end; spacing: 8px; padding-bottom: 8px;
                // STUB-1: same gate as the expanded footer shield.
                if AnonMode.onion-built: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: AnonMode.enabled ? "Anon Mode (active) - tap to disable" : "Anon Mode";
                    tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius;
                        background: AnonMode.enabled ? Colors.primary.with-alpha(0.2) : root.rail-slot-bg;
                        Image { source: Icons.shield; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: AnonMode.enabled ? Colors.primary : Colors.text-secondary; }
                        // Tor status dot: green=connected, amber=CONNECTING ONLY,
                        // red=error, muted=off. See the expanded shield above.
                        Rectangle {
                            visible: AnonMode.enabled;
                            width: 10px; height: 10px; border-radius: 5px;
                            x: parent.width - self.width - 2px; y: 2px;
                            border-width: 1px; border-color: Colors.surface;
                            background: TorStatus.state == 2 ? Colors.success
                                : TorStatus.state == 3 ? Colors.error
                                : TorStatus.state == 1 ? Colors.warning
                                : Colors.text-muted;
                        }
                        TouchArea { clicked => { root.anon-mode-clicked(); } }
                    } }
                }
                // Bottom cluster, in order: AI, Mesh, expand, Settings.
                // The expand chevron lives here rather than in the panel header
                // so the three things reached most often on a phone — the AI
                // channel, the mesh room, and the full conversation list — sit
                // together under the thumb.
                TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: "AI"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: Icons.jarvis; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        // The local AI channel's fixed id is the nil UUID
                        // (chatter-core client/jarvis.rs jarvis_channel_id).
                        TouchArea { clicked => { root.channel-selected("00000000-0000-0000-0000-000000000000"); } }
                    } }
                }

                if root.rail-has-mesh: TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: "Mesh"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: Icons.radio; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            colorize: !MeshGlobal.radio-running ? Colors.warning
                                : MeshGlobal.peer-count > 0 ? Colors.glow-cyan
                                : Colors.text-secondary; }
                        // First entry is the public room — the mesh list is
                        // built with it at the head.
                        TouchArea { clicked => { MeshGlobal.conversation-selected(MeshGlobal.conversations[0].id); } }
                    } }
                }

                // A visible seam between "situational shortcuts" (Anon Mode,
                // AI, Mesh — above) and "always there" navigation (expand,
                // Settings, Profile — below). Six identical unlabeled slots
                // in one unbroken stack read as one big undifferentiated
                // block; a hairline plus extra breathing room lets the eye
                // parse two small groups instead, without hiding anything.
                Rectangle {
                    height: 13px;
                    Rectangle {
                        y: parent.height / 2;
                        width: root.rail-slot-size * 0.6;
                        x: (parent.width - self.width) / 2;
                        height: 1px;
                        background: Colors.border;
                    }
                }

                TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2;
                    tooltip-text: root.collapsed ? "Expand sidebar" : "Collapse sidebar"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: root.collapsed ? Icons.chevron-right : Icons.chevron-left; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-muted; }
                        TouchArea { clicked => { root.collapsed = !root.collapsed; root.toggle-collapsed(); } }
                    } }
                }

                TooltipArea {
                    height: root.rail-icon-size; width: 44px; x: (parent.width - self.width) / 2; tooltip-text: "Settings"; tooltip-enabled: true; placement: "right";
                    HorizontalLayout { alignment: center; Rectangle { width: root.rail-slot-size; height: root.rail-slot-size; border-radius: root.rail-slot-radius; background: root.rail-slot-bg;
                        Image { source: Icons.settings; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Colors.text-secondary; }
                        if root.server-unreachable: Rectangle {
                            x: parent.width - self.width - 1px; y: 1px;
                            width: 7px; height: 7px; border-radius: 3.5px;
                            border-width: 1px; border-color: Colors.surface;
                            background: Colors.error;
                            accessible-role: text;
                            accessible-label: "Server unreachable";
                        }
                        TouchArea { clicked => { root.settings-clicked(); } }
                    } }
                }
                TouchArea {
                    height: root.rail-icon-size; clicked => { root.profile-clicked(); }
                    HorizontalLayout { alignment: center;
                        Avatar { size: 28px; source: root.user-avatar-source; fallback-text: root.user-initials; show-presence: true;
                            presence-color: root.user-presence-status == "online" ? Colors.online : Colors.offline;
                        }
                    }
                }

            }
        }
    }

    // Right edge — the seam against the chat column. Desktop only: on a phone
    // this panel is the whole screen and has no column beside it.
    if !root.mobile-mode: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: AnonMode.enabled ? Colors.primary.with-alpha(0.4) : Colors.neo-highlight;
    }

    // Section context menu overlay (renders on top of all sidebar content)
    SectionContextMenu {
        show: root.ctx-menu-show;
        position-x: root.ctx-menu-x;
        position-y: root.ctx-menu-y;
        conversation-id: root.ctx-menu-conv-id;
        conversation-type: root.ctx-menu-conv-type;
        current-section-id: root.ctx-menu-current-section-id;
        is-pinned: root.ctx-menu-is-pinned;
        can-pin: root.ctx-menu-can-pin;
        mobile-mode: root.mobile-mode;
        sections: root.custom-sections;

        close => {
            root.ctx-menu-show = false;
        }
        move-to-section(conv-id, conv-type, section-id) => {
            root.move-to-section(conv-id, conv-type, section-id);
        }
        remove-from-section(conv-id) => {
            root.remove-from-section(conv-id);
        }
        create-section-clicked => {
            root.create-section-clicked();
        }
        set-pinned(conv-id, pinned) => {
            root.set-conversation-pinned(conv-id, pinned);
        }
    }

    // Section header context menu overlay (right-click on section header)
    SectionHeaderContextMenu {
        show: root.section-header-ctx-menu-show;
        position-x: root.section-header-ctx-menu-x;
        position-y: root.section-header-ctx-menu-y;
        section-id: root.section-header-ctx-menu-section-id;
        section-sort-mode: root.section-header-ctx-menu-sort-mode;
        mobile-mode: root.mobile-mode;

        close => {
            root.section-header-ctx-menu-show = false;
        }
        remove-section(section-id) => {
            root.delete-section-clicked(section-id);
        }
        rename-section(section-id) => {
            root.rename-section-clicked(section-id);
        }
        move-section(section-id, delta) => {
            root.move-section(section-id, delta);
        }
        set-sort-mode(section-id, mode) => {
            root.set-section-sort-mode(section-id, mode);
        }
    }
}
