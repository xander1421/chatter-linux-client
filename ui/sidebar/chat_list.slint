// The chat list, and its one row.
//
// Every loose conversation — friend DMs, anon DMs and requests, channels
// (current and former), private groups — is ONE list ordered by activity,
// pinned first (Signal/Telegram). Core builds and orders the rows
// (`ChatterClient::sidebar_rows`); this only draws them. A folder's rows are
// the same rows, so both render through ChatRow, which picks the DM, channel
// or private-group visual from the row's kind.

import { ConversationKind } from "../chat/conversation_kind.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { EmptyState } from "../components/empty_state.slint";
import { DMListItem } from "dm_list_item.slint";
import { ChannelListItem } from "channel_list_item.slint";
import { PrivateGroupListItem } from "private_group_list_item.slint";

export struct ChatRowData {
    conversation-id: string,
    conversation-type: ConversationKind,
    user-id: string,             // DM rows: the peer
    display-name: string,
    avatar-source: image,
    has-avatar: bool,
    initials: string,
    last-message: string,
    timestamp: string,
    presence-status: string,     // DM rows
    private-channel: bool,       // channel rows: invite-only (lock glyph)
    member-count: int,           // private-group rows
    unread-count: int,
    is-typing: bool,
    is-pinned: bool,             // local-only pin; core sorts these first
    can-leave: bool,             // channel rows: core's `can_leave_channel`
    can-delete: bool,            // channel rows: core's `is_former_channel`
    is-selected: bool,           // Rust-computed selection flag; drives highlight
}

export component ChatRow inherits VerticalLayout {
    in property <ChatRowData> data;
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    if root.data.conversation-type == ConversationKind.server-dm || root.data.conversation-type == ConversationKind.anon-dm: DMListItem {
        display-name: root.data.display-name;
        avatar-source: root.data.avatar-source;
        initials: root.data.initials;
        presence-status: root.data.presence-status;
        is-pinned: root.data.is-pinned;
        last-message: root.data.last-message;
        timestamp: root.data.timestamp;
        unread-count: root.data.unread-count;
        is-typing: root.data.is-typing;
        selected: root.data.is-selected;
        collapsed: root.collapsed;
        mobile-mode: root.mobile-mode;
        clicked => { root.clicked(); }
        context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
    }
    if root.data.conversation-type == ConversationKind.channel || root.data.conversation-type == ConversationKind.saved-messages: ChannelListItem {
        name: root.data.display-name;
        channel-type: root.data.private-channel ? "private" : "public";
        unread-count: root.data.unread-count;
        last-message: root.data.last-message;
        timestamp: root.data.timestamp;
        is-typing: root.data.is-typing;
        selected: root.data.is-selected;
        collapsed: root.collapsed;
        avatar-source: root.data.avatar-source;
        has-avatar: root.data.has-avatar;
        is-pinned: root.data.is-pinned;
        mobile-mode: root.mobile-mode;
        clicked => { root.clicked(); }
        context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
    }
    if root.data.conversation-type == ConversationKind.anon-group: PrivateGroupListItem {
        name: root.data.display-name;
        member-count: root.data.member-count;
        unread-count: root.data.unread-count;
        last-message: root.data.last-message;
        timestamp: root.data.timestamp;
        is-typing: root.data.is-typing;
        selected: root.data.is-selected;
        collapsed: root.collapsed;
        mobile-mode: root.mobile-mode;
        clicked => { root.clicked(); }
        context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
    }
}

export component ChatList inherits VerticalLayout {
    in property <[ChatRowData]> rows: [];
    in property <bool> collapsed: false;
    // "Touch input", same meaning as the sidebar's — sizes the rows.
    in property <bool> mobile-mode: false;
    // True when anything else in the sidebar lists conversations (folders);
    // suppresses the empty state.
    in property <bool> has-sibling-content: false;

    callback row-selected(/* conversation-id */ string, /* kind */ ConversationKind);
    callback row-context-menu-requested(/* row */ ChatRowData, /* x */ length, /* y */ length);
    callback add-friend-clicked();
    callback join-channel-clicked();

    if !root.collapsed && root.rows.length == 0 && !root.has-sibling-content: VerticalLayout {
        EmptyState {
            icon: Icons.message-circle;
            message: "No conversations";
            cta-text: "Add a friend";
            cta-clicked => { root.add-friend-clicked(); }
        }
        // FEAT-8: the first controls a brand-new account sees. Joining a
        // channel is the other way in, so the empty list offers it too.
        HorizontalLayout {
            alignment: center;
            Text {
                text: "Browse channels";
                color: browse-touch.has-hover ? Colors.primary-hover : Colors.primary;
                font-size: Typography.sm;
                browse-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.join-channel-clicked(); }
                }
            }
        }
    }

    VerticalLayout {
        padding-left: Spacing.xs;
        padding-right: Spacing.xs;
        spacing: Spacing.xxs;

        for row in root.rows: ChatRow {
            data: row;
            collapsed: root.collapsed;
            mobile-mode: root.mobile-mode;
            clicked => { root.row-selected(row.conversation-id, row.conversation-type); }
            context-menu-requested(x, y) => { root.row-context-menu-requested(row, x, y); }
        }
    }
}
