// Custom section list component
//
// Renders user-created sidebar sections (e.g. "Work", "Gaming") with collapsible
// conversation lists. A folder's rows are the chat list's own rows (ChatRow).

import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { ConversationKind } from "../chat/conversation_kind.slint";
import { ChatRow, ChatRowData } from "chat_list.slint";

// ── Data structs ────────────────────────────────────────────────

export struct CustomSectionData {
    section-id: string,
    name: string,
    icon-emoji: string,
    is-expanded: bool,
    unread-count: int,
    sort-mode: string,           // "recent" | "unread" | "alphabetical"
    // This section's OWN rows, pre-grouped in Rust. Previously every section
    // looped the whole flat list and hid non-matches with `visible` +
    // `height: 0px`, which instantiated sections × conversations elements
    // (ten folders over two hundred conversations = two thousand rows).
    conversations: [ChatRowData],
}

// ── Section header ──────────────────────────────────────────────

component CustomSectionHeader inherits Rectangle {
    in property <string> section-id;
    in property <string> name;
    in property <string> icon-emoji;
    in property <bool> is-expanded: true;
    in property <int> unread-count: 0;
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    callback toggle-expanded();
    callback rename-clicked();
    callback delete-clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    height: root.mobile-mode ? Spacing.touch-target-min : Spacing.button-height;
    accessible-role: button;
    accessible-label: root.name;
    accessible-description: root.is-expanded ? "Expanded section. Press M for section options." : "Collapsed section. Press M for section options.";
    accessible-action-default => { root.toggle-expanded(); }
    border-width: header-keys.has-focus ? 2px : 0px;
    border-color: Colors.focus-ring;

    header-keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle-expanded();
                return accept;
            }
            if event.text == "m" || event.text == "M" || event.text == "Menu" || (event.text == "F10" && event.modifiers.shift) {
                root.context-menu-requested(root.width / 2, root.height);
                return accept;
            }
            return reject;
        }
    }

    // The header's ONE pointer surface: tap toggles, hold (or right-click)
    // opens the menu. There used to be a second TouchArea over the name inside
    // the layout below, and being declared later it won the pointer grab — a
    // press-and-hold on a folder header just collapsed the folder and the menu
    // was unreachable on touch. Same "two stacked TouchAreas fight over the
    // grab" trap HoldArea exists to avoid.
    //
    // Declared FIRST so the hover buttons below stay on top and keep their own
    // clicks; the Texts and Images between are not interactive, so this still
    // receives everything else.
    header-hover := HoldArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if (!self.hold-fired) { root.toggle-expanded(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }

    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.xs;

        Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                padding-left: Spacing.xxs;
                spacing: Spacing.xs;
                alignment: start;

                // Collapse chevron
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.chevron-right;
                        width: root.mobile-mode ? 14px : 10px;
                        height: root.mobile-mode ? 14px : 10px;
                        colorize: Colors.text-muted;
                        transform-rotation: root.is-expanded ? 90deg : 0deg;
                        animate transform-rotation { duration: Materials.motion-standard; easing: Materials.spring; }
                    }
                }

                // Emoji icon
                Text {
                    text: root.icon-emoji;
                    font-family: Typography.font-family-emoji;
                    font-size: root.mobile-mode ? Typography.sm : Typography.xs;
                    vertical-alignment: center;
                }

                // Section name
                Text {
                    text: root.name;
                    color: Colors.text-muted;
                    font-size: root.mobile-mode ? Typography.sm2 : Typography.xs2;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Aggregate unread badge (hidden when the desktop action buttons show)
                if root.unread-count > 0 && (root.mobile-mode || !header-hover.has-hover): Rectangle {
                    width: max(self.height, header-badge-text.preferred-width + 8px);
                    height: Spacing.badge-md;
                    border-radius: self.height / 2;
                    background: Colors.action-fill;
                    header-badge-text := Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.on-action;
                        font-size: Typography.xxs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // Section actions stay visible on desktop so keyboard focus can reach
        // them. There is no hover on a
        // touch screen, and press-and-hold already opens a menu carrying
        // Rename and Remove; a 24px button here would be an unhittable
        // duplicate of a control the user already has.
        if !root.mobile-mode: HorizontalLayout {
            spacing: Spacing.xxs;
            alignment: end;

            // Rename button
            Rectangle {
                width: Spacing.button-height;
                height: Spacing.button-height;
                border-radius: Spacing.radius-sm;
                background: rename-touch.has-hover ? Colors.surface-hover : transparent;
                accessible-role: button;
                accessible-label: "Rename " + root.name;
                accessible-action-default => { root.rename-clicked(); }
                border-width: rename-keys.has-focus ? 2px : 0px;
                border-color: Colors.focus-ring;
                rename-keys := FocusScope {
                    width: 0px; height: 0px;
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return { root.rename-clicked(); return accept; }
                        return reject;
                    }
                }

                Image {
                    source: Icons.edit;
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-muted;
                }

                rename-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.rename-clicked(); }
                }
            }

            // Delete button
            Rectangle {
                width: Spacing.button-height;
                height: Spacing.button-height;
                border-radius: Spacing.radius-sm;
                background: delete-touch.has-hover ? Colors.surface-hover : transparent;
                accessible-role: button;
                accessible-label: "Remove " + root.name;
                accessible-action-default => { root.delete-clicked(); }
                border-width: delete-keys.has-focus ? 2px : 0px;
                border-color: Colors.focus-ring;
                delete-keys := FocusScope {
                    width: 0px; height: 0px;
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return { root.delete-clicked(); return accept; }
                        return reject;
                    }
                }

                Image {
                    source: Icons.trash;
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: delete-touch.has-hover ? Colors.error : Colors.text-muted;
                }

                delete-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.delete-clicked(); }
                }
            }
        }
    }

    // Collapsed: show emoji icon only with tooltip
    if root.collapsed: TooltipArea {
        width: 44px;
        height: 100%;
        x: (parent.width - self.width) / 2;
        tooltip-text: root.name;
        tooltip-enabled: true;
        placement: "right";

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.icon-emoji;
                font-family: Typography.font-family-emoji;
                font-size: Typography.sm;
                vertical-alignment: center;
            }
        }

        // Collapsed unread dot
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 6px;
            y: 4px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Colors.primary;
        }
    }
}

// ── Main component: renders all custom sections ────────────────

export component CustomSectionList inherits Rectangle {
    in property <[CustomSectionData]> sections: [];
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ ConversationKind);
    callback section-conversation-pin-requested(/* conversation-id */ string, /* pinned */ bool);
    callback section-conversation-context-menu-requested(/* conversation-id */ string, /* conversation-type */ ConversationKind, /* section-id */ string, /* is-pinned */ bool, /* can-leave */ bool, /* can-delete */ bool, /* x */ length, /* y */ length);
    callback section-header-context-menu-requested(/* section-id */ string, /* sort-mode */ string, /* x */ length, /* y */ length);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);

    VerticalLayout {
        spacing: Spacing.none;

        // Render each section
        for section in root.sections: VerticalLayout {
            spacing: Spacing.none;

            CustomSectionHeader {
                section-id: section.section-id;
                name: section.name;
                icon-emoji: section.icon-emoji;
                is-expanded: section.is-expanded;
                unread-count: section.unread-count;
                collapsed: root.collapsed;
                mobile-mode: root.mobile-mode;

                toggle-expanded => { root.section-toggle-expanded(section.section-id); }
                rename-clicked => { root.rename-section-clicked(section.section-id); }
                delete-clicked => { root.delete-section-clicked(section.section-id); }
                context-menu-requested(x, y) => {
                    root.section-header-context-menu-requested(section.section-id, section.sort-mode, x, y);
                }
            }

            // Section conversations (only when expanded). The model is this
            // section's own rows, already ordered by core.
            Rectangle {
                height: section.is-expanded ? section-rows.preferred-height : 0px;
                clip: true;
                animate height { duration: Materials.motion-standard; easing: Materials.spring; }

                section-rows := VerticalLayout {
                    width: parent.width;
                    padding-left: Spacing.xs;
                    padding-right: Spacing.xs;
                    spacing: Spacing.xxs;

                // A folder row is the main list's own row, so a chat looks
                // the same filed or not; filing one used to shrink it to a
                // one-line row with no photo, preview, time or presence.
                    for conv in section.conversations: ChatRow {
                        data: conv;
                        collapsed: root.collapsed;
                        mobile-mode: root.mobile-mode;
                        clicked => { root.section-conversation-selected(conv.conversation-id, conv.conversation-type); }
                        pin-requested(pinned) => { root.section-conversation-pin-requested(conv.conversation-id, pinned); }
                        context-menu-requested(x, y) => {
                            root.section-conversation-context-menu-requested(conv.conversation-id, conv.conversation-type, section.section-id, conv.is-pinned, conv.can-leave, conv.can-delete, x, y);
                        }
                    }
                }
            }
        }
    }
}
