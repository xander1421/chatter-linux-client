// Custom section list component
//
// Renders user-created sidebar sections (e.g. "Work", "Gaming") with collapsible
// conversation lists. Conversations inside sections reuse existing list-item
// components (channels, DMs, private groups) based on conversation_type.

import { Colors } from "../theme/colors.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { ConversationKind } from "../chat/conversation_kind.slint";

// ── Data structs ────────────────────────────────────────────────

export struct SectionConversationData {
    conversation-id: string,
    conversation-type: ConversationKind,
    display-name: string,
    avatar-source: image,
    has-avatar: bool,
    initials: string,
    last-message: string,
    timestamp: string,
    unread-count: int,
    is-pinned: bool,             // local-only pin; core sorts these first
    is-selected: bool,           // Rust-computed selection flag; drives highlight
}

export struct CustomSectionData {
    section-id: string,
    name: string,
    icon-emoji: string,
    is-expanded: bool,
    unread-count: int,
    sort-mode: string,           // "recent" | "unread" | "alphabetical"
    // This section's OWN rows, pre-grouped in Rust. Previously every section
    // looped the whole flat list and hid non-matches with `visible` +
    // `height: 0px`, which instantiated sections × conversations elements
    // (ten folders over two hundred conversations = two thousand rows).
    conversations: [SectionConversationData],
}

// ── Single conversation item inside a section ───────────────────

component SectionConversationItem inherits Rectangle {
    in property <string> conversation-id;
    in property <ConversationKind> conversation-type;
    in property <string> display-name;
    in property <image> avatar-source;
    in property <bool> has-avatar: false;
    in property <string> initials;
    in property <int> unread-count: 0;
    in property <bool> is-pinned: false;
    in property <bool> selected: false;
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    callback clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    // A finger needs the 48px minimum; a mouse does not, and 36px keeps the
    // desktop sidebar dense.
    height: root.mobile-mode ? Spacing.touch-target-min : 36px;
    border-radius: Spacing.radius-sm;
    background: root.selected ? Colors.primary.with-alpha(0.2)
              : touch.has-hover ? Colors.surface-hover
              : transparent;

    // Three glyph families: channels (#), DMs (avatar), anon groups (shield).
    property <bool> is-dm: root.conversation-type == ConversationKind.server-dm
                        || root.conversation-type == ConversationKind.anon-dm;
    property <bool> is-group: root.conversation-type == ConversationKind.anon-group;
    property <bool> is-channel: root.conversation-type == ConversationKind.channel
                             || root.conversation-type == ConversationKind.saved-messages;

    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: stretch;

        // Icon or avatar based on type
        Rectangle {
            width: 20px;
            height: parent.height;

            if root.is-channel && root.has-avatar: Image {
                source: root.avatar-source;
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.is-channel && !root.has-avatar: Image {
                source: Icons.hash;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.primary : Colors.text-secondary;
            }
            if root.is-dm: Avatar {
                size: 20px;
                source: root.avatar-source;
                fallback-text: root.initials;
                show-presence: false;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.is-group: Image {
                source: Icons.shield;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: root.selected ? Colors.group-accent : Colors.group-accent.with-alpha(0.7);
            }
        }

        // Name
        Text {
            text: root.display-name;
            color: root.selected ? Colors.text-primary : Colors.text-secondary;
            font-size: Typography.sm2;
            font-weight: root.unread-count > 0 ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Pin marker — why this row is above the others.
        if root.is-pinned: VerticalLayout {
            alignment: center;
            Image {
                source: Icons.pin;
                width: 11px;
                height: 11px;
                colorize: Colors.text-muted;
                accessible-role: text;
                accessible-label: "Pinned";
            }
        }

        // Unread badge
        if root.unread-count > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(18px, sec-badge-text.preferred-width + 10px);
                height: 18px;
                border-radius: Spacing.radius-full;
                background: Colors.primary;
                sec-badge-text := Text {
                    text: root.unread-count > 99 ? "99+" : root.unread-count;
                    color: Colors.text-primary;
                    font-size: Typography.xxs;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.display-name;
        tooltip-enabled: true;
        placement: "right";

        if root.is-channel && root.has-avatar: Image {
            source: root.avatar-source;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if root.is-channel && !root.has-avatar: Image {
            source: Icons.hash;
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Colors.primary : Colors.text-secondary;
        }
        if root.is-dm: Avatar {
            size: 22px;
            source: root.avatar-source;
            fallback-text: root.initials;
            show-presence: false;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if root.is-group: Image {
            source: Icons.shield;
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.group-accent;
        }
    }

    touch := HoldArea {
        mouse-cursor: pointer;
        clicked => {
            if (!self.hold-fired) { root.clicked(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }
}

// ── Section header ──────────────────────────────────────────────

component CustomSectionHeader inherits Rectangle {
    in property <string> section-id;
    in property <string> name;
    in property <string> icon-emoji;
    in property <bool> is-expanded: true;
    in property <int> unread-count: 0;
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    callback toggle-expanded();
    callback rename-clicked();
    callback delete-clicked();
    callback context-menu-requested(/* x */ length, /* y */ length);

    height: root.mobile-mode ? Spacing.touch-target-min : 32px;

    // The header's ONE pointer surface: tap toggles, hold (or right-click)
    // opens the menu. There used to be a second TouchArea over the name inside
    // the layout below, and being declared later it won the pointer grab — a
    // press-and-hold on a folder header just collapsed the folder and the menu
    // was unreachable on touch. Same "two stacked TouchAreas fight over the
    // grab" trap HoldArea exists to avoid.
    //
    // Declared FIRST so the hover buttons below stay on top and keep their own
    // clicks; the Texts and Images between are not interactive, so this still
    // receives everything else.
    header-hover := HoldArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if (!self.hold-fired) { root.toggle-expanded(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }

    if !root.collapsed: HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;

        Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                padding-left: 2px;
                spacing: 4px;
                alignment: start;

                // Collapse chevron
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.chevron-right;
                        width: root.mobile-mode ? 14px : 10px;
                        height: root.mobile-mode ? 14px : 10px;
                        colorize: Colors.text-muted;
                        transform-rotation: root.is-expanded ? 90deg : 0deg;
                        animate transform-rotation { duration: 150ms; easing: ease-out; }
                    }
                }

                // Emoji icon
                Text {
                    text: root.icon-emoji;
                    font-family: Typography.font-family-emoji;
                    font-size: root.mobile-mode ? Typography.sm : Typography.xs;
                    vertical-alignment: center;
                }

                // Section name
                Text {
                    text: root.name;
                    color: Colors.text-muted;
                    font-size: root.mobile-mode ? Typography.sm2 : Typography.xs2;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Aggregate unread badge (hidden when the desktop action buttons show)
                if root.unread-count > 0 && (root.mobile-mode || !header-hover.has-hover): Rectangle {
                    width: root.unread-count > 9 ? 22px : 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Colors.primary;
                    Text {
                        text: root.unread-count > 99 ? "99+" : root.unread-count;
                        color: Colors.text-primary;
                        font-size: Typography.xxs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }

        // Hover-reveal action buttons — DESKTOP ONLY. There is no hover on a
        // touch screen, and press-and-hold already opens a menu carrying
        // Rename and Remove; a 24px button here would be an unhittable
        // duplicate of a control the user already has.
        if !root.mobile-mode && header-hover.has-hover: HorizontalLayout {
            spacing: 2px;
            alignment: end;

            // Rename button
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: Spacing.radius-sm;
                background: rename-touch.has-hover ? Colors.surface-hover : transparent;

                Image {
                    source: Icons.edit;
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.text-muted;
                }

                rename-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.rename-clicked(); }
                }
            }

            // Delete button
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: Spacing.radius-sm;
                background: delete-touch.has-hover ? Colors.surface-hover : transparent;

                Image {
                    source: Icons.trash;
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: delete-touch.has-hover ? Colors.error : Colors.text-muted;
                }

                delete-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.delete-clicked(); }
                }
            }
        }
    }

    // Collapsed: show emoji icon only with tooltip
    if root.collapsed: TooltipArea {
        width: 44px;
        height: 100%;
        x: (parent.width - self.width) / 2;
        tooltip-text: root.name;
        tooltip-enabled: true;
        placement: "right";

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.icon-emoji;
                font-family: Typography.font-family-emoji;
                font-size: Typography.sm;
                vertical-alignment: center;
            }
        }

        // Collapsed unread dot
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 6px;
            y: 4px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Colors.primary;
        }
    }
}

// ── Main component: renders all custom sections ────────────────

export component CustomSectionList inherits Rectangle {
    in property <[CustomSectionData]> sections: [];
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    callback create-section-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ ConversationKind);
    callback section-conversation-context-menu-requested(/* conversation-id */ string, /* conversation-type */ ConversationKind, /* section-id */ string, /* is-pinned */ bool, /* x */ length, /* y */ length);
    callback section-header-context-menu-requested(/* section-id */ string, /* sort-mode */ string, /* x */ length, /* y */ length);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);

    VerticalLayout {
        spacing: 0px;

        // "+ New Section" button — hidden in collapsed mode to avoid duplicate + icons
        if !root.collapsed: Rectangle {
            height: root.mobile-mode ? Spacing.touch-target-min : 28px;
            background: new-sec-touch.has-hover ? Colors.surface-hover : transparent;
            border-radius: Spacing.radius-sm;
            // Ghost-button affordance — a bare text row reads as a list item,
            // not an action; the border on hover marks it clickable.
            border-width: 1px;
            border-color: new-sec-touch.has-hover ? Colors.border : transparent;
            accessible-role: button;
            accessible-label: "New Section";

            HorizontalLayout {
                padding-left: Spacing.sm;
                spacing: 6px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.plus;
                        width: root.mobile-mode ? 16px : 12px;
                        height: root.mobile-mode ? 16px : 12px;
                        colorize: new-sec-touch.has-hover ? Colors.primary : Colors.text-muted;
                    }
                }
                Text {
                    text: "New Section";
                    color: new-sec-touch.has-hover ? Colors.text-secondary : Colors.text-muted;
                    font-size: root.mobile-mode ? Typography.sm2 : Typography.xs2;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }

            new-sec-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.create-section-clicked(); }
            }
        }

        // Render each section
        for section in root.sections: VerticalLayout {
            spacing: 0px;

            CustomSectionHeader {
                section-id: section.section-id;
                name: section.name;
                icon-emoji: section.icon-emoji;
                is-expanded: section.is-expanded;
                unread-count: section.unread-count;
                collapsed: root.collapsed;
                mobile-mode: root.mobile-mode;

                toggle-expanded => { root.section-toggle-expanded(section.section-id); }
                rename-clicked => { root.rename-section-clicked(section.section-id); }
                delete-clicked => { root.delete-section-clicked(section.section-id); }
                context-menu-requested(x, y) => {
                    root.section-header-context-menu-requested(section.section-id, section.sort-mode, x, y);
                }
            }

            // Section conversations (only when expanded). The model is this
            // section's own rows, already ordered by core.
            if section.is-expanded: VerticalLayout {
                padding-left: Spacing.xs;
                padding-right: Spacing.xs;
                spacing: 2px;

                for conv in section.conversations: SectionConversationItem {
                    conversation-id: conv.conversation-id;
                    conversation-type: conv.conversation-type;
                    display-name: conv.display-name;
                    avatar-source: conv.avatar-source;
                    has-avatar: conv.has-avatar;
                    initials: conv.initials;
                    unread-count: conv.unread-count;
                    is-pinned: conv.is-pinned;
                    selected: conv.is-selected;
                    collapsed: root.collapsed;
                    mobile-mode: root.mobile-mode;

                    clicked => { root.section-conversation-selected(conv.conversation-id, conv.conversation-type); }
                    context-menu-requested(x, y) => {
                        root.section-conversation-context-menu-requested(conv.conversation-id, conv.conversation-type, section.section-id, conv.is-pinned, x, y);
                    }
                }
            }
        }
    }
}
