// Folder data and header for the virtualized sidebar list.

import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { HoldArea } from "../components/hold_area.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { Typography } from "../theme/typography.slint";
import { TooltipArea } from "../components/tooltip.slint";
import { ChatRowData } from "chat_list.slint";

// ── Data structs ────────────────────────────────────────────────

export struct CustomSectionData {
    section-id: string,
    name: string,
    icon-emoji: string,
    is-expanded: bool,
    unread-count: int,
    sort-mode: string,           // "recent" | "unread" | "alphabetical"
    // This section's own rows, pre-grouped in Rust. The sidebar adapter
    // flattens expanded sections into the one virtualized row model.
    conversations: [ChatRowData],
}

// One entry of the flattened sidebar list.
export struct SidebarRowData {
    key: string,
    kind: string,
    chat: ChatRowData,
    section: CustomSectionData,
}

// ── Section header ──────────────────────────────────────────────

export component CustomSectionHeader inherits Rectangle {
    in property <string> section-id;
    in property <string> name;
    in property <string> icon-emoji;
    in property <bool> is-expanded: true;
    in property <int> unread-count: 0;
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;
    in property <bool> keyboard-highlight: false;

    callback toggle-expanded();
    callback context-menu-requested(/* x */ length, /* y */ length);

    height: root.collapsed ? 48px : root.mobile-mode ? Spacing.touch-target-min : Spacing.button-height;
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-description: root.is-expanded ? @tr("Expanded section. Press Shift+F10 or Menu for section options.") : @tr("Collapsed section. Press Shift+F10 or Menu for section options.");
    accessible-action-default => { root.toggle-expanded(); }
    // TalkBack's double tap and hold: the section menu, as a long press.
    accessible-action-expand => {
        root.context-menu-requested(root.absolute-position.x + root.width / 2,
            root.absolute-position.y + root.height);
    }
    border-width: header-keys.has-focus || root.keyboard-highlight ? 2px : 0px;
    border-color: Colors.focus-ring;

    header-keys := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle-expanded();
                return accept;
            }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-menu-requested(root.absolute-position.x + root.width / 2,
                    root.absolute-position.y + root.height);
                return accept;
            }
            return reject;
        }
    }

    // The header's ONE pointer surface: tap toggles, hold (or right-click)
    // opens the menu. There used to be a second TouchArea over the name inside
    // the layout below, and being declared later it won the pointer grab — a
    // press-and-hold on a folder header just collapsed the folder and the menu
    // was unreachable on touch. Same "two stacked TouchAreas fight over the
    // grab" trap HoldArea exists to avoid.
    //
    // Declared FIRST so the hover buttons below stay on top and keep their own
    // clicks; the Texts and Images between are not interactive, so this still
    // receives everything else.
    header-hover := HoldArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if (!self.hold-fired) { root.toggle-expanded(); }
        }
        held => { root.context-menu-requested(self.anchor-x, self.anchor-y); }
    }

    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.xs;

        Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                padding-left: Spacing.xxs;
                spacing: Spacing.xs;
                alignment: start;

                // Collapse chevron
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: Icons.chevron-right;
                        width: root.mobile-mode ? 14px : 10px;
                        height: root.mobile-mode ? 14px : 10px;
                        colorize: Colors.text-muted;
                        transform-rotation: root.is-expanded ? 90deg : 0deg;
                        animate transform-rotation { duration: Materials.motion-standard; easing: Materials.spring; }
                    }
                }

                // Emoji icon
                Text {
                    text: root.icon-emoji;
                    font-family: Typography.font-family-emoji;
                    font-size: root.mobile-mode ? Typography.sm : Typography.xs;
                    vertical-alignment: center;
                }

                // Section name
                Text {
                    text: root.name;
                    color: Colors.text-muted;
                    font-size: root.mobile-mode ? Typography.sm2 : Typography.xs2;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Aggregate unread badge
                if root.unread-count > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: max(self.height, header-badge-text.preferred-width + 8px);
                        height: Spacing.badge-md;
                        border-radius: self.height / 2;
                        background: Colors.action-fill;
                        header-badge-text := Text {
                            text: root.unread-count > 99 ? "99+" : root.unread-count;
                            color: Colors.on-action;
                            font-size: Typography.xxs;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }
        }

        // Rename and Remove live in the section menu only (right click,
        // press-and-hold, Shift+F10 / Menu); the two hover buttons that
        // duplicated it here were removed.
    }

    // Collapsed: show emoji icon only with tooltip
    if root.collapsed: TooltipArea {
        width: 44px;
        height: 100%;
        x: (parent.width - self.width) / 2;
        tooltip-text: root.name;
        tooltip-enabled: true;
        placement: "right";

        // The same 44px slot as every other rail entry.
        Rectangle {
            width: 44px;
            height: 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-lg;
            background: Colors.surface-control;
            Text {
                width: 100%;
                height: 100%;
                text: root.icon-emoji;
                font-family: Typography.font-family-emoji;
                font-size: Typography.lg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Collapsed unread dot
        if root.unread-count > 0: Rectangle {
            x: parent.width / 2 + 6px;
            y: 4px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Colors.primary;
        }
    }
}

