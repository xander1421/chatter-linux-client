// Organization switcher — button row style.
//
// Shows org initial badges in a horizontal row. Active org is highlighted.
// Plus button at end for managing/adding orgs. Space-efficient alternative
// to a dropdown.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { TooltipArea } from "../components/tooltip.slint";

// Organization summary for the switcher list.
export struct OrgListItemData {
    id: string,
    name: string,
    slug: string,
    initial: string,
    member-count: int,
    is-current: bool,
}

export component OrgSwitcher inherits Rectangle {
    in property <string> current-org-name: "";
    in property <string> current-org-initial: "";
    in property <bool> has-org: current-org-name != "";
    in property <[OrgListItemData]> organizations: [];
    in property <bool> collapsed: false;
    in property <bool> is-loading: false;

    callback org-selected(/* org_id */ string);
    callback manage-org-clicked();

    visible: root.has-org || root.organizations.length > 0;
    height: self.visible ? 44px : 0px;

    // Expanded: horizontal row of org initial buttons
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;
        alignment: start;

        for org in root.organizations: Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: org.is-current ? Colors.primary
                      : org-btn-touch.has-hover ? Colors.surface-hover
                      : Colors.background;

            Text {
                text: org.initial != "" ? org.initial : org.name;
                color: org.is-current ? Colors.text-primary : Colors.text-secondary;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                overflow: elide;
            }

            org-btn-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if !org.is-current {
                        root.org-selected(org.id);
                    }
                }
            }
        }

        // + button to manage/add orgs
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: manage-touch.has-hover ? Colors.surface-hover : transparent;
            border-width: 1px;
            border-color: manage-touch.has-hover ? Colors.border : transparent;

            Image {
                source: Icons.plus;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-muted;
            }

            manage-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.manage-org-clicked(); }
            }
        }
    }

    // Collapsed: just show current org icon centered with tooltip
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.current-org-name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Spacing.radius-sm;
            background: collapsed-touch.has-hover ? Colors.surface-hover : Colors.surface;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: Colors.primary;

                    Text {
                        text: root.current-org-initial != "" ? root.current-org-initial : root.current-org-name;
                        color: Colors.text-primary;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                        overflow: elide;
                    }
                }
            }

            collapsed-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.manage-org-clicked();
                }
            }
        }
    }
}
