// Private group list component
//
// Displays a scrollable list of private groups.
// These are NDSS'21 style anonymous groups - server has no knowledge.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { PrivateGroupListItem } from "private_group_list_item.slint";

// Data struct for private group items
export struct PrivateGroupListItemData {
    group-id: string,
    name: string,
    member-count: int,
    unread-count: int,
    last-message: string,
    timestamp: string,
    is-typing: bool,
    is-selected: bool,       // Rust-computed selection flag; drives highlight
}

export component PrivateGroupList inherits Rectangle {
    // Properties
    in property <[PrivateGroupListItemData]> groups: [];
    in property <bool> collapsed: false;
    in property <bool> mobile-mode: false;

    // Callbacks
    callback group-selected(string);
    callback group-context-menu-requested(/* group-id */ string, /* x */ length, /* y */ length);
    // Tooltip callbacks removed — PrivateGroupListItem now uses self-contained TooltipArea

    // Layout
    background: root.mobile-mode ? Colors.background : Colors.surface;

    VerticalLayout {
        // Scrollable group list
        flickable := Flickable {
            viewport-height: group-layout.preferred-height;

            group-layout := VerticalLayout {
                padding-left: Spacing.xs;
                padding-right: Spacing.xs;
                spacing: 2px;

                for item in root.groups: PrivateGroupListItem {
                    mobile-mode: root.mobile-mode;
                    group-id: item.group-id;
                    name: item.name;
                    member-count: item.member-count;
                    unread-count: item.unread-count;
                    last-message: item.last-message;
                    timestamp: item.timestamp;
                    is-typing: item.is-typing;
                    selected: item.is-selected;
                    collapsed: root.collapsed;

                    clicked => {
                        root.group-selected(item.group-id);
                    }
                    context-menu-requested(x, y) => {
                        root.group-context-menu-requested(item.group-id, x, y);
                    }
                }
            }
        }
    }
}
