// User profile bar component
//
// Displays current user's profile with avatar, name, status, and friends button.
// Supports collapsed mode showing only centered avatar.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "../components/avatar.slint";

export component UserProfileBar inherits Rectangle {
    // Properties
    in property <string> display-name: "User";
    in property <image> avatar-source;
    in property <string> initials: "";
    in property <string> presence-status: "online"; // "online", "away", "dnd", "offline"
    in property <string> custom-status: "";
    in property <bool> collapsed: false;

    // Callbacks
    callback friends-clicked();
    callback profile-clicked();
    callback show-tooltip(string);
    callback hide-tooltip();

    // Friend request badge count
    in property <int> pending-friend-requests: 0;

    // Layout
    height: 72px;
    background: Colors.background;

    // Expanded layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: Spacing.sm;
        spacing: Spacing.md;
        alignment: stretch;

        // Clickable profile area (avatar + text)
        profile-touch := TouchArea {
            horizontal-stretch: 1;

            clicked => {
                root.profile-clicked();
            }

            HorizontalLayout {
                spacing: Spacing.md;

                // Avatar with presence
                VerticalLayout {
                    alignment: center;

                    Avatar {
                        size: 40px;
                        source: root.avatar-source;
                        fallback-text: root.initials;
                        show-presence: true;
                        presence-color: root.presence-status == "online" ? Colors.online
                                     : root.presence-status == "away" ? Colors.away
                                     : root.presence-status == "dnd" ? Colors.dnd
                                     : Colors.offline;
                    }
                }

                // Name and status text
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    // Display name
                    Text {
                        text: root.display-name;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        font-weight: Typography.semibold;
                        overflow: elide;
                    }

                    // Status text (custom or presence)
                    Text {
                        text: root.custom-status != "" ? root.custom-status
                            : root.presence-status == "online" ? "Online"
                            : root.presence-status == "away" ? "Away"
                            : root.presence-status == "dnd" ? "Do Not Disturb"
                            : "Offline";
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        overflow: elide;
                    }
                }
            }
        }

    }

    // Collapsed layout - centered avatar
    if root.collapsed: VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 4px;

        // Internal state for tracking if tooltip is currently shown
        property <bool> tooltip-shown: false;

        // Avatar
        collapsed-profile-touch := TouchArea {
            height: 40px;
            clicked => {
                root.profile-clicked();
            }

            HorizontalLayout {
                alignment: center;

                Avatar {
                    size: 36px;
                    source: root.avatar-source;
                    fallback-text: root.initials;
                    show-presence: true;
                    presence-color: root.presence-status == "online" ? Colors.online
                                 : root.presence-status == "away" ? Colors.away
                                 : root.presence-status == "dnd" ? Colors.dnd
                                 : Colors.offline;
                }
            }
        }

        // Show tooltip when hovering profile (transition from not-shown to shown)
        if collapsed-profile-touch.has-hover && !tooltip-shown: Rectangle {
            width: 0;
            height: 0;
            init => {
                parent.tooltip-shown = true;
                root.show-tooltip(root.display-name);
            }
        }

        // Hide tooltip when hover ends (transition from shown to not-shown)
        if tooltip-shown && !collapsed-profile-touch.has-hover: Rectangle {
            width: 0;
            height: 0;
            init => {
                parent.tooltip-shown = false;
                root.hide-tooltip();
            }
        }
    }
}
