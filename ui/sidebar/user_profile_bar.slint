// User profile bar component — Neo 2.0
//
// Extruded profile card with neo surface depth.
// Supports collapsed mode showing only centered avatar with self-contained tooltip.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "../components/avatar.slint";
import { TooltipArea } from "../components/tooltip.slint";

export component UserProfileBar inherits Rectangle {
    // Properties
    in property <string> display-name: "User";
    in property <image> avatar-source;
    in property <string> initials: "";
    in property <string> presence-status: "online"; // "online", "away", "dnd", "offline"
    in property <string> custom-status: "";
    in property <bool> collapsed: false;

    // Callbacks
    callback friends-clicked();
    callback profile-clicked();

    // Friend request badge count
    in property <int> pending-friend-requests: 0;

    // Layout — Neo 2.0 extruded profile card
    height: 72px;
    background: Colors.surface;
    border-radius: Spacing.radius-md;
    border-width: 1px;
    border-color: Colors.neo-highlight;
    drop-shadow-blur: Spacing.neo-blur-md;
    drop-shadow-offset-x: Spacing.neo-offset-md;
    drop-shadow-offset-y: Spacing.neo-offset-md;
    drop-shadow-color: Colors.neo-shadow;

    // Expanded layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: Spacing.sm;
        spacing: Spacing.md;
        alignment: stretch;

        // Clickable profile area (avatar + text)
        profile-touch := TouchArea {
            horizontal-stretch: 1;

            clicked => {
                root.profile-clicked();
            }

            HorizontalLayout {
                spacing: Spacing.md;

                // Avatar with presence
                VerticalLayout {
                    alignment: center;

                    Avatar {
                        size: 40px;
                        source: root.avatar-source;
                        fallback-text: root.initials;
                        show-presence: true;
                        presence-color: root.presence-status == "online" ? Colors.online
                                     : root.presence-status == "away" ? Colors.away
                                     : root.presence-status == "dnd" ? Colors.dnd
                                     : Colors.offline;
                    }
                }

                // Name and status text
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    // Display name
                    Text {
                        text: root.display-name;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        font-weight: Typography.semibold;
                        overflow: elide;
                    }

                    // Status text (custom or presence)
                    Text {
                        text: root.custom-status != "" ? root.custom-status
                            : root.presence-status == "online" ? "Online"
                            : root.presence-status == "away" ? "Away"
                            : root.presence-status == "dnd" ? "Do Not Disturb"
                            : "Offline";
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        overflow: elide;
                    }
                }
            }
        }

    }

    // Collapsed layout - self-contained tooltip via TooltipArea
    if root.collapsed: TooltipArea {
        width: 100%;
        height: 100%;
        tooltip-text: root.display-name;
        tooltip-enabled: root.collapsed;
        placement: "right";

        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;
            spacing: 4px;

            TouchArea {
                height: 40px;
                clicked => {
                    root.profile-clicked();
                }

                HorizontalLayout {
                    alignment: center;

                    Avatar {
                        size: 36px;
                        source: root.avatar-source;
                        fallback-text: root.initials;
                        show-presence: true;
                        presence-color: root.presence-status == "online" ? Colors.online
                                     : root.presence-status == "away" ? Colors.away
                                     : root.presence-status == "dnd" ? Colors.dnd
                                     : Colors.offline;
                    }
                }
            }
        }
    }
}
