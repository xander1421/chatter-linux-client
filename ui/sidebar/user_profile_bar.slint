// User profile bar component
//
// Displays current user's profile with avatar, name, status, and friends button.
// Supports collapsed mode showing only centered avatar.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "../components/avatar.slint";

export component UserProfileBar inherits Rectangle {
    // Properties
    in property <string> display-name: "User";
    in property <image> avatar-source;
    in property <string> initials: "";
    in property <string> presence-status: "online"; // "online", "away", "dnd", "offline"
    in property <string> custom-status: "";
    in property <bool> collapsed: false;

    // Callbacks
    callback friends-clicked();
    callback profile-clicked();
    callback show-tooltip(string);
    callback hide-tooltip();

    // Friend request badge count
    in property <int> pending-friend-requests: 0;

    // Layout
    height: 64px;
    background: Colors.background;

    // Expanded layout
    if !root.collapsed: HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.md;
        alignment: stretch;

        // Clickable profile area (avatar + text)
        profile-touch := TouchArea {
            horizontal-stretch: 1;

            clicked => {
                root.profile-clicked();
            }

            HorizontalLayout {
                spacing: Spacing.md;

                // Avatar with presence
                VerticalLayout {
                    alignment: center;

                    Avatar {
                        size: 40px;
                        source: root.avatar-source;
                        fallback-text: root.initials;
                        show-presence: true;
                        presence-color: root.presence-status == "online" ? Colors.online
                                     : root.presence-status == "away" ? Colors.away
                                     : root.presence-status == "dnd" ? Colors.dnd
                                     : Colors.offline;
                    }
                }

                // Name and status text
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    // Display name
                    Text {
                        text: root.display-name;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        font-weight: Typography.semibold;
                        overflow: elide;
                    }

                    // Status text (custom or presence)
                    Text {
                        text: root.custom-status != "" ? root.custom-status
                            : root.presence-status == "online" ? "Online"
                            : root.presence-status == "away" ? "Away"
                            : root.presence-status == "dnd" ? "Do Not Disturb"
                            : "Offline";
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        overflow: elide;
                    }
                }
            }
        }

        // Friends icon with badge
        VerticalLayout {
            alignment: center;

            friends-button := Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Spacing.radius-sm;
                background: friends-touch.has-hover ? Colors.surface-hover : transparent;

                Image {
                    source: Icons.users;
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: friends-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                }

                // Notification badge for pending requests
                if root.pending-friend-requests > 0: Rectangle {
                    x: parent.width - 12px;
                    y: 2px;
                    width: root.pending-friend-requests > 9 ? 18px : 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Colors.error;

                    Text {
                        text: root.pending-friend-requests > 9 ? "9+" : root.pending-friend-requests;
                        color: Colors.text-primary;
                        font-size: 10px;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                friends-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.friends-clicked();
                    }
                }
            }
        }
    }

    // Collapsed layout - avatar with icons below
    if root.collapsed: VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 4px;

        // Internal state for tracking if tooltip is currently shown
        property <bool> tooltip-shown: false;

        // Avatar
        collapsed-profile-touch := TouchArea {
            height: 40px;
            clicked => {
                root.profile-clicked();
            }

            HorizontalLayout {
                alignment: center;

                Avatar {
                    size: 36px;
                    source: root.avatar-source;
                    fallback-text: root.initials;
                    show-presence: true;
                    presence-color: root.presence-status == "online" ? Colors.online
                                 : root.presence-status == "away" ? Colors.away
                                 : root.presence-status == "dnd" ? Colors.dnd
                                 : Colors.offline;
                }
            }
        }

        // Icon row: Friends
        HorizontalLayout {
            height: 20px;
            alignment: center;
            spacing: 2px;

            // Friends icon
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: collapsed-friends-touch.has-hover ? Colors.surface-hover : transparent;

                Image {
                    source: Icons.users;
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: collapsed-friends-touch.has-hover ? Colors.text-primary : Colors.text-secondary;
                }

                // Badge for pending requests
                if root.pending-friend-requests > 0: Rectangle {
                    x: parent.width - 8px;
                    y: -2px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: Colors.error;

                    Text {
                        text: root.pending-friend-requests > 9 ? "+" : root.pending-friend-requests;
                        color: Colors.text-primary;
                        font-size: 8px;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                collapsed-friends-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.friends-clicked(); }
                }
            }
        }

        // Show tooltip when hovering profile (transition from not-shown to shown)
        if collapsed-profile-touch.has-hover && !tooltip-shown: Rectangle {
            width: 0;
            height: 0;
            init => {
                parent.tooltip-shown = true;
                root.show-tooltip(root.display-name);
            }
        }

        // Hide tooltip when hover ends (transition from shown to not-shown)
        if tooltip-shown && !collapsed-profile-touch.has-hover: Rectangle {
            width: 0;
            height: 0;
            init => {
                parent.tooltip-shown = false;
                root.hide-tooltip();
            }
        }
    }
}
