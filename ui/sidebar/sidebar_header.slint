import { Appearance } from "../theme/appearance.slint";
import { DesktopChrome } from "../theme/desktop_chrome.slint";
import { KeyFocus } from "../components/key_focus.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Colors } from "../theme/colors.slint";
import { Icons } from "../theme/icons.slint";
import { HeaderButton } from "../components/header_button.slint";
import { ActivityBell } from "../activity/activity_bell.slint";
import { GlassSurface } from "../components/glass_surface.slint";

export component SidebarHeader inherits Rectangle {
    private property <bool> native-desktop: DesktopChrome.macos && !root.touch;
    in property <length> top-row-height;
    in property <length> quick-link-inset;
    in property <length> quick-link-slot;
    in property <length> quick-link-icon-size;
    in property <brush> quick-link-text-color;
    in property <length> quick-link-text-size;
    in property <bool> search-overlay-open;
    in property <bool> mobile-mode;
    in property <bool> touch;
    in property <bool> server-unreachable;
    in property <string> connection-status;
    callback search-clicked();
    callback create-clicked();

    height: root.top-row-height;
    opacity: root.search-overlay-open ? 0 : 1;
    animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }

    HorizontalLayout {
        y: root.native-desktop ? 32px : 0px;
        height: root.native-desktop ? parent.height - self.y : parent.height;
        spacing: Spacing.panel-gutter;

        GlassSurface {
            horizontal-stretch: 1;
            height: root.mobile-mode ? root.top-row-height : 40px;
            y: (parent.height - self.height) / 2;
            clip: true;
            border-radius: root.mobile-mode ? Spacing.radius-lg : Spacing.radius-panel;
            // Same glass as the sidebar cards (SavedCard): material on, card tint.
            elevation: 0;
            material-tint: Appearance.glass-effects ? Materials.regular : Colors.surface-card;
            accessible-role: button;
            accessible-label: @tr("Search");
            accessible-enabled: !root.search-overlay-open;
            accessible-action-default => { if !root.search-overlay-open { root.search-clicked(); } }
            KeyFocus {
                enabled: !root.search-overlay-open;
                border-radius: parent.border-radius;
                activate => { root.search-clicked(); }
            }
            HorizontalLayout {
                padding-left: root.mobile-mode ? root.quick-link-inset - root.x : Spacing.md;
                padding-right: root.mobile-mode
                    ? Spacing.sm + 2 * Spacing.header-action-box-touch + Spacing.header-action-gap
                    : Spacing.md;
                spacing: Spacing.sm;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    width: root.mobile-mode ? root.quick-link-slot : root.quick-link-icon-size;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: Icons.search;
                            width: root.quick-link-icon-size;
                            height: self.width;
                            colorize: Colors.text-secondary;
                        }
                    }
                }
                Text {
                    text: @tr("Search");
                    color: root.quick-link-text-color;
                    font-size: root.quick-link-text-size;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            TouchArea {
                enabled: !root.search-overlay-open;
                mouse-cursor: pointer;
                clicked => { root.search-clicked(); }
            }
        }

        // Keep the accent inside the glass tile's single hairline rim.
        if !root.mobile-mode: GlassSurface {
            width: 40px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: Spacing.radius-panel;
            elevation: 0;
            material-tint: Appearance.glass-effects ? Materials.regular : Colors.surface-card;
            show-edge: false;
            popup-rim: true;
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: parent.border-radius - 1px;
                background: Colors.tint-strong;
            }
            HeaderButton {
                width: parent.width;
                height: parent.height;
                plain: true;
                enabled: !root.search-overlay-open;
                control-radius: Spacing.radius-panel;
                icon-color: Colors.primary;
                glyph: 16px;
                icon: Icons.plus;
                label: @tr("Create");
                clicked => { root.create-clicked(); }
            }
        }
    }

    // The compact phone layout uses the floating Create button and keeps
    // Activity at the top of the chat list.
    if root.mobile-mode: ActivityBell {
        touch: root.touch;
        server-unreachable: root.server-unreachable;
        connection-status: root.connection-status;
        x: parent.width - self.width * 2 - Spacing.sm - Spacing.header-action-gap;
        y: (parent.height - self.height) / 2;
    }
}
