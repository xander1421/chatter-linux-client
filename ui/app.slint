    // ========== Modal state ==========
    // Screens and dialogs pushed over the current tab, top last. Changed only
    // through nav-push / nav-close / nav-pop (Rust: features/back.rs), so
    // closing one reveals the one it was pushed over.
    in-out property <[string]> modal-stack: [];
    // The top of the stack, or "none". Each modal's `if` reads this.
    out property <string> active-modal: root.modal-stack.length > 0
        ? root.modal-stack[root.modal-stack.length - 1] : "none";
    // Presentation lags logic by one exit. The identity that just left the
    // top of the stack (pop, close-at-top, replace) keeps its surface with
    // `show-modal: false` — it fades, accepts no input and holds no focus —
    // until the sheet duration has passed, then unmounts. The destination
    // (the dialog under it, or nothing) is presented at once, so a pop never
    // waits and a push never waits. One exit is retained at a time: a second
    // close during the fade replaces it. Reduced motion unmounts at once.
    // Each dialog's `if` reads `is-presented`.
    private property <string> presented-modal: "none";
    private property <string> exiting-modal: "none";
    private property <int> presented-depth: 0;
    function is-presented(name: string) -> bool {
        return root.presented-modal == name || root.exiting-modal == name;
    }
    function present-active-modal() {
        // Grew: the old top is still on the stack under the new one, nothing
        // left. Otherwise the old top is gone and gets its exit.
        if root.presented-modal != "none" && root.presented-modal != root.active-modal
            && root.modal-stack.length <= root.presented-depth && !Appearance.reduce-motion {
            root.exiting-modal = root.presented-modal;
            modal-exit.running = true;
            modal-exit.restart();
        }
        root.presented-modal = root.active-modal;
        root.presented-depth = root.modal-stack.length;
    }
    modal-exit := Timer {
        interval: Materials.sheet-duration + 40ms;
        running: false;
        triggered => {
            self.running = false;
            root.exiting-modal = "none";
        }
    }
    // The same contract for the incoming-call card.
    private property <bool> incoming-shown: root.incoming-call-visible && !root.incoming-call-minimized;
    private property <bool> incoming-presented: false;
    changed incoming-shown => {
        if root.incoming-shown {
            root.incoming-presented = true;
            incoming-exit.running = false;
        } else if Appearance.reduce-motion {
            root.incoming-presented = false;
        } else {
            incoming-exit.running = true;
        }
    }
    incoming-exit := Timer {
        interval: Materials.motion-standard + 40ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.incoming-shown { root.incoming-presented = false; }
        }
    }
    // And for the device picker, which is not on the modal stack.
    private property <bool> device-picker-presented: false;
    changed device-picker-visible => {
        if root.device-picker-visible {
            root.device-picker-presented = true;
            device-picker-exit.running = false;
        } else if Appearance.reduce-motion {
            root.device-picker-presented = false;
        } else {
            device-picker-exit.running = true;
        }
    }
    device-picker-exit := Timer {
        interval: Materials.motion-standard + 40ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.device-picker-visible { root.device-picker-presented = false; }
        }
    }
    // "settings" is anywhere on the stack. Settings stays mounted under what
    // it opens (Sessions, Link device, ...), so it cannot key off
    // `active-modal`; written by back.rs alongside the stack.
    in-out property <bool> settings-open: false;
    callback nav-push(string);

    // Shared by every entry to Create Channel / New Section (sidebar, the
    // create menu, the account menu), so they cannot open it differently.
    function start-create-channel() {
        root.create-channel-initial-tab = 0;
        root.nav-push("create-channel");
        root.open-create-channel();
    }
    function start-create-section() {
        root.create-section-rename-mode = false;
        root.create-section-name = "";
        root.create-section-emoji = "📁";
        root.create-section-id = "";
        root.nav-push("create-section");
    }
    // Close that screen and everything pushed above it.
    callback nav-close(string);
    callback nav-pop();

