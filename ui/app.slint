                viewer-origin-y <=> root.viewer-origin-y;
                window-height: root.height;
                keyboard-inset: root.virtual-keyboard-size.height;
                attachment-clicked() => { root.attachment-clicked(); }
                audio-seek(arg0, arg1) => { root.audio-seek(arg0, arg1); }
                call-end() => { root.call-end(); }
                call-peer-audio-mute-toggle(arg0) => { root.call-peer-audio-mute-toggle(arg0); }
