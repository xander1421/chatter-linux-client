    callback screen-source-selected(string);  // source_id


    // ========== Anon mode (PIN modal + toggle) ==========
    in-out property <string> anon-mode-pin: "";
    in property <string> anon-mode-pin-error: "";
    in property <bool> anon-mode-verifying: false;
    callback toggle-anon-mode();              // sidebar button → Rust handler
    callback submit-anon-mode-pin(string);    // PIN modal submit → Rust verify

    // Tablet panes share one page canvas behind their rounded chrome.
    // A tinted window behind the sidebar and an opaque chat beside it expose
    // a rectangular patch in the search/footer corner cutouts.
    background: root.is-mobile-platform && !root.compact-layout
        ? Colors.background : Materials.ambient;

    // ========== Responsive sidebar auto-collapse ==========
    // Auto-collapse sidebar on smaller screens (< 800px width)
    property <bool> is-small-screen: root.width < 800px;
    // Mobile layout: only on actual mobile devices (Android) with narrow screens.
    // Desktop narrow windows keep the collapsed sidebar instead of going fullscreen.
    // is-small-screen drives the collapse-by-default + full-width side-panels.
    // No separate "mobile-screen" mode — Android renders identically to a
    // narrow desktop window, per the user's "1-to-1 with desktop" preference.
    // Track whether the user manually toggled collapse (vs auto-collapse on resize)
    property <bool> sidebar-user-collapsed: false;

    // Update sidebar collapsed/hidden state when screen size changes
    changed is-small-screen => {
        if (root.is-small-screen && !root.sidebar-collapsed) {
            // Auto-collapse on small screen — don't mark as user choice
            root.sidebar-collapsed = true;
        }
        if (!root.is-small-screen && root.sidebar-collapsed && !root.sidebar-user-collapsed) {
            // Auto-expand when screen grows, unless user explicitly collapsed
            root.sidebar-collapsed = false;
        }
    }
    changed compact-layout => { root.refresh-screen-protection(); }

    // ========== Android back key ==========
    // Android's Activity calls this directly for hardware/gesture Back, even
    // when Slint has no focused item. The scope below also routes desktop
    // Back/Escape here. Navigation decisions live in features/back.rs.
    callback back-pressed();
    // Android asks core to recompute capture protection at navigation boundaries.
    callback refresh-screen-protection();
    // The phone's chat pane closed (Back, header back, a bottom tab): nothing
    // is on screen any more, so no conversation may stay "active".
    callback chat-pane-closed();

    // Give Slint keyboard shortcuts an initial focus target. Key input reaches
    // only the focused item and its ancestors; Android system Back is also
    // routed directly from MainActivity when no Slint item has focus.
    forward-focus: back-scope;

    changed channel-id => {
        root.calls-more-menu-visible = false;
        root.cancel-composer-keyboard-handover();
        VoiceRecording.cancel();
        root.composer-emoji-picker-visible = false;
        root.composer-gif-picker-visible = false;
    }
    private property <string> inserted-emoji;
    private property <int> insert-serial;
    public function insert-composer-emoji(emoji: string) { root.inserted-emoji = emoji; root.insert-serial += 1; }
    changed conversation-kind => { root.calls-more-menu-visible = false; VoiceRecording.cancel(); }
    changed selection-mode => { if root.selection-mode { VoiceRecording.cancel(); } }
    changed composer-is-editing => { if root.composer-is-editing { VoiceRecording.cancel(); } }
    changed composer-text => { root.composer-draft-changed(); }
    changed thread-composer-text => { root.thread-draft-changed(); }
    changed thread-panel-visible => { VoiceRecording.cancel(); }
    changed active-tab => { root.calls-more-menu-visible = false; root.call-history-selecting = false; root.cancel-composer-keyboard-handover(); VoiceRecording.cancel(); root.refresh-screen-protection(); }
    changed current-view => {
        root.refresh-screen-protection();
        root.calls-more-menu-visible = false;
        root.call-history-selecting = false;
        root.cancel-composer-keyboard-handover();
        VoiceRecording.cancel();
        back-scope.focus();
        root.exiting-view = Appearance.reduce-motion ? "" : root.previous-view;
        root.previous-view = root.current-view;
        root.view-appearing = false;
        root.view-progress = 0;
        view-arrive.start();
        view-leave.start();
    }
    // Drop whatever text field holds focus (hiding the soft keyboard with it)
    // without leaving the window focus-less: Back keeps arriving at
    // back-scope. Called from Rust when Android's Back hid the keyboard
    // behind Slint's back (platform/android/activity.rs).
    in-out property <bool> composer-attachment-picker-open: false;
    private property <int> attachment-prepare-serial;
    private property <int> attachment-restore-serial;
    public function prepare-attachment-picker() {
        root.composer-attachment-picker-open = true;
        root.attachment-prepare-serial += 1;
    }
    public function finish-attachment-picker(restore: bool) {
        root.composer-attachment-picker-open = false;
        if restore && root.current-view == "main" && root.active-modal == "none"
            && (!root.compact-layout || root.mobile-show-chat) {
            root.attachment-restore-serial += 1;
        }
    }
    public function release-text-focus() {
        root.cancel-composer-keyboard-handover();
        back-scope.focus();
    }

    // The composer's in-flight IME composition, mirrored from the live
    // ChatLayout. `TextInput.text` excludes it, so without this a conversation
    // switch parked the draft without the composing word, and the input method
    // later committed that word into the NEXT conversation's text. Destroying
    // the composer (leaving the chat) drops it too: Slint sends no FocusOut to
    // a TextInput that dies with its component.
    property <bool> composer-composing: false;
    property <string> composer-composed-text;
    public function composer-has-preedit() -> bool {
        return root.composer-composing;
    }
    // Fold the composition into `composer-text` and end it. The text is
    // computed BEFORE focus moves and assigned after, as the composer's
    // suspend-input does: a FocusOut that commits the preedit itself (core's
    // Android path) yields the same string, one that drops it (desktop) is
    // restored, and nothing is inserted twice. Called by Rust before it parks
    // the draft on a conversation switch, and by a remounted ChatLayout for a
    // composition its predecessor died with.
    public function settle-composer() {
        if !root.composer-composing { return; }
        root.composer-composing = false;
        root.composer-settled-text = root.composer-composed-text;
        back-scope.focus();
        root.composer-text = root.composer-settled-text;
    }
    private property <string> composer-settled-text;

    // Same hole for the composer's pickers. On a phone the composer drops its
    // focus when one opens so the panel replaces the keyboard
    // (message_composer.slint, emoji-touch) — which left NOTHING focused, so
    // the Back meant to close the picker was dropped on the floor. Hand focus
    // to back-scope instead: the keyboard still goes away, and Back arrives.
    // The drawer suspends text input on every platform. Give Back/Escape a
    // focus owner until search or the keyboard toggle takes focus.
    private property <bool> composer-drawer-visible:
        root.composer-emoji-picker-visible || root.composer-gif-picker-visible;
    changed composer-drawer-visible => {
        if root.composer-drawer-visible {
            root.cancel-composer-keyboard-handover();
            back-scope.focus();
        }
    }
    callback composer-gif-closed();
    in-out property <int> composer-gif-generation;
    changed composer-gif-picker-visible => {
        if !root.composer-gif-picker-visible {
            root.composer-gif-generation += 1;
            root.composer-gif-closed();
        }
    }
    // Same hole for the search palette: its field holds focus, and picking a
    // result closes the palette, so Back from the chat it opened did nothing
    // (RC20, 3/3). Back from that chat returns to the list, like the header ←.
    changed unified-search-open => {
        if (!root.unified-search-open) {
            root.unified-search-closed();
            back-scope.focus();
        }
    }
    changed active-modal => {
        root.refresh-screen-protection();
        root.modal-generation += 1;
        root.sessions-generation += 1;
        if root.active-modal == "sessions" { root.settings-view-sessions(); }
        root.present-active-modal();
        root.calls-more-menu-visible = false;
        root.cancel-composer-keyboard-handover();
        if root.active-modal != "" { VoiceRecording.cancel(); }
        // On open too: taking focus off the composer is what hides the soft
        // keyboard (a TextInput's FocusOut sends InputMethodRequest::Disable),
        // which otherwise stays up over the modal (F78). On close it is also
        // what takes focus out of the dialog that is still fading out.
        back-scope.focus();
    }
    // Modals scroll their card clear of the keyboard only while it is up
    // (modal_container.slint, §112i), and only the Window can see it.
    changed virtual-keyboard-size => {
        VirtualKeyboard.height = root.virtual-keyboard-size.height;
        if root.virtual-keyboard-size.height > 0px {
            root.zero-inset-keyboard = false;
            keyboard-zero-inset-timeout.stop();
            if !root.composer-drawer-visible {
                keyboard-height-settle.start();
                keyboard-height-settle.restart();
            }
        } else {
            keyboard-height-settle.stop();
        }
        if root.composer-keyboard-reserve > 0px && root.virtual-keyboard-size.height > 0px {
            keyboard-handover-settle.start();
            keyboard-handover-settle.restart();
        } else if root.virtual-keyboard-size.height <= 0px {
            // An interrupted arrival is not a settled keyboard. Keep the
            // reservation until positive insets settle or refusal times out.
            keyboard-handover-settle.stop();
        }
    }

    // Catches Back/Escape delivered to Slint (including desktop keyboard
    // input). Android's Activity handles system Back before it reaches Slint.
    //
    // focus-on-click / focus-on-tab-navigation are both off on purpose: this
    // scope must never take focus AWAY from the composer or a text field. It
    // receives focus from `forward-focus` above and from the two `changed`
    // handlers, and otherwise works purely by event bubbling.
    back-scope := FocusScope {
        // Remember the consumed Escape until key-up, after menu dismissal.
        property <bool> calls-menu-escape-consumed: false;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        key-pressed(event) => {
            if (event.text == Key.Back || (event.text == Key.Escape
                && root.active-modal == "none"
                && (root.delete-confirm-count > 0 || root.calls-more-menu-visible || root.call-history-selecting || root.composer-emoji-picker-visible || root.composer-gif-picker-visible))) {
                if (event.text == Key.Escape && (root.calls-more-menu-visible || root.call-history-selecting || root.delete-confirm-count > 0)) {
                    self.calls-menu-escape-consumed = true;
                }
                root.back-pressed();
                // Always consume. The android backend turns EventAccepted into
                // InputStatus::Handled, which is what stops the framework's
                // default Back (finish the Activity) from also running.
                return accept;
            }
            return reject;
        }

        // Swallow the matching key-up too, WITHOUT re-firing back-pressed.
        // Android's default Back acts on ACTION_UP, so consuming only the press
        // would leave the release for the framework to act on — one physical
        // press then both pops a layer here and runs the default handler.
        key-released(event) => {
            if (event.text == Key.Escape && self.calls-menu-escape-consumed) {
                self.calls-menu-escape-consumed = false;
                return accept;
            }
            return event.text == Key.Back || (event.text == Key.Escape
                && root.active-modal == "none"
                && (root.composer-emoji-picker-visible || root.composer-gif-picker-visible)) ? accept : reject;
        }

        AppShortcuts {
            current-view: root.current-view;
            search-shortcut-pref: root.search-shortcut-pref;
            unified-search-selected-index <=> root.unified-search-selected-index;
            unified-search-open <=> root.unified-search-open;
            active-modal: root.active-modal;
            active-tab <=> root.active-tab;
            calls-more-menu-visible: root.calls-more-menu-visible;
            call-history-selecting: root.call-history-selecting;
            delete-confirm-count: root.delete-confirm-count;
            channel-selected(id) => { root.channel-selected(id); }
            unified-search-opened() => { root.unified-search-opened(); }
            nav-push(page) => { root.nav-push(page); }
            nav-close(page) => { root.nav-close(page); }
            nav-pop() => { root.nav-pop(); }
            settings-clicked() => { root.settings-clicked(); }
            back-pressed() => { root.back-pressed(); }
        }

        // ========== Main content layer ==========
        // Apply ALL insets (system bars + IME) in ONE place — here. Inner layouts
        // use `parent.height` directly, no further inset subtraction. Splitting
        // top vs bottom across outer+inner caused keyboard-open to shift content
        // down instead of shrink it. Per Slint mobile layout guidance
        // (https://docs.slint.dev/latest/docs/slint/guide/platforms/mobile/general/):
        // one rectangle, all insets.
        Rectangle {
            width: root.width;
            height: root.height - root.safe-area-top - root.safe-area-bottom;
            y: root.safe-area-top;

            AuthPages {
                width: parent.width;
                height: parent.height;
                account-free-surfaces : root.account-free-surfaces;
                avatar-options : root.avatar-options;
                configured-server-url : root.configured-server-url;
                current-view : root.current-view;
                exiting-view: root.exiting-view;
                is-mobile-platform : root.is-mobile-platform;
                link-device-active : root.link-device-active;
                link-device-error : root.link-device-error;
                link-device-has-local-identity : root.link-device-has-local-identity;
                link-device-qr : root.link-device-qr;
                link-device-status : root.link-device-status;
                link-device-url : root.link-device-url;
                loading-message : root.loading-message;
                loading-secondary-message : root.loading-secondary-message;
                login-error : root.login-error;
                login-identity-reset-available : root.login-identity-reset-available;
                login-loading : root.login-loading;
                login-password <=> root.login-password;
                login-pin <=> root.login-pin;
                login-server-url <=> root.login-server-url;
                login-username <=> root.login-username;
                login-verifying : root.login-verifying;
                recovery-code <=> root.recovery-code;
                recovery-confirm-password <=> root.recovery-confirm-password;
                recovery-error : root.recovery-error;
                recovery-loading : root.recovery-loading;
                recovery-new-password <=> root.recovery-new-password;
                recovery-new-pin <=> root.recovery-new-pin;
                recovery-success : root.recovery-success;
                recovery-username <=> root.recovery-username;
                register-avatar-color <=> root.register-avatar-color;
                register-avatar-source : root.register-avatar-source;
                register-confirm-password <=> root.register-confirm-password;
                register-display-name <=> root.register-display-name;
                register-error : root.register-error;
                register-has-avatar : root.register-has-avatar;
                register-loading : root.register-loading;
                register-password <=> root.register-password;
                register-password-strength : root.register-password-strength;
                register-pin <=> root.register-pin;
                register-pin-strength : root.register-pin-strength;
                register-selected-default-idx <=> root.register-selected-default-idx;
                register-server-url <=> root.register-server-url;
                register-username <=> root.register-username;
                server-unreachable : root.server-unreachable;
                user-display-name : root.user-display-name;
                view-progress : root.view-progress;
                accept-new-identity() => { root.accept-new-identity(); }
                continue-without-account() => { root.continue-without-account(); }
                go-to-link-device() => { root.go-to-link-device(); }
                go-to-login() => { root.go-to-login(); }
                go-to-recovery() => { root.go-to-recovery(); }
                go-to-register() => { root.go-to-register(); }
                link-device-cancel() => { root.link-device-cancel(); }
                link-device-copy() => { root.link-device-copy(); }
                link-device-start() => { root.link-device-start(); }
                login(arg0, arg1, arg2, arg3) => { root.login(arg0, arg1, arg2, arg3); }
                recover-account(arg0, arg1, arg2, arg3) => { root.recover-account(arg0, arg1, arg2, arg3); }
                register(arg0, arg1, arg2, arg3, arg4) => { root.register(arg0, arg1, arg2, arg3, arg4); }
                register-clear-error() => { root.register-clear-error(); }
                register-password-changed(arg0) => { root.register-password-changed(arg0); }
                register-pin-changed(arg0) => { root.register-pin-changed(arg0); }
                register-pin-validation(arg0) => { return root.register-pin-validation(arg0); }
                register-remove-avatar() => { root.register-remove-avatar(); }
                register-select-avatar() => { root.register-select-avatar(); }
                register-select-default-avatar(arg0) => { root.register-select-default-avatar(arg0); }
                register-username-validation(arg0) => { return root.register-username-validation(arg0); }
                welcome-add-friends() => { root.welcome-add-friends(); }
                welcome-browse-channels() => { root.welcome-browse-channels(); }
                welcome-get-started() => { root.welcome-get-started(); }
            }

            // During the brief visual handoff, neither page accepts a stray tap.
            if root.exiting-view != "": TouchArea {
                z: 3;
                width: parent.width;
                height: parent.height;
                clicked => {}
            }

            // Main chat layout — parent Rectangle already accounts for all insets.
            if current-view == "main": MainChatShell {
                z: -2;
                width: 100%;
                height: parent.height;
                active-call-data : root.active-call-data;
                active-call-fullscreen <=> root.active-call-fullscreen;
                active-call-visible : root.active-call-visible;
                active-channel-call-id : root.active-channel-call-id;
                active-channel-call-participants : root.active-channel-call-participants;
                active-channel-call-video : root.active-channel-call-video;
                active-tab <=> root.active-tab;
                attachment-prepare-serial : root.attachment-prepare-serial;
                attachment-restore-serial : root.attachment-restore-serial;
                audio-elapsed : root.audio-elapsed;
                audio-progress : root.audio-progress;
                bottom-nav-visible : root.bottom-nav-visible;
                call-is-muted : root.call-is-muted;
                call-is-screen-sharing : root.call-is-screen-sharing;
                call-is-video-enabled : root.call-is-video-enabled;
                call-local-video-frame : root.call-local-video-frame;
                call-remote-video-frames : root.call-remote-video-frames;
                call-speaker-on : root.call-speaker-on;
                call-speaker-toggle : root.call-speaker-toggle;
                channel-avatar-source : root.channel-avatar-source;
                channel-has-avatar : root.channel-has-avatar;
                channel-id : root.channel-id;
                channel-name : root.channel-name;
                chat-can-forward : root.chat-can-forward;
                chat-edge-start <=> root.chat-edge-start;
                chat-edge-swiping <=> root.chat-edge-swiping;
                chat-list-scrolling <=> root.chat-list-scrolling;
                chat-menu-secret-chat <=> root.chat-menu-secret-chat;
                chat-menu-settings <=> root.chat-menu-settings;
                chat-menu-video <=> root.chat-menu-video;
                chat-push-progress <=> root.chat-push-progress;
                chat-rows : root.chat-rows;
                chat-rows-loading : root.chat-rows-loading;
                chat-traffic-lights-lead : root.chat-traffic-lights-lead;
                compact-layout : root.compact-layout;
                composer-composed-text <=> root.composer-composed-text;
                composer-composing <=> root.composer-composing;
                composer-edit-message-id <=> root.composer-edit-message-id;
                composer-emoji-category <=> root.composer-emoji-category;
                composer-emoji-list : root.composer-emoji-list;
                composer-emoji-picker-visible <=> root.composer-emoji-picker-visible;
                composer-emoji-search <=> root.composer-emoji-search;
                composer-emoji-skin-tone <=> root.composer-emoji-skin-tone;
                composer-gif-picker-failed : root.composer-gif-picker-failed;
                composer-gif-picker-loading : root.composer-gif-picker-loading;
                composer-gif-picker-recent : root.composer-gif-picker-recent;
                composer-gif-picker-results : root.composer-gif-picker-results;
                composer-gif-picker-search <=> root.composer-gif-picker-search;
                composer-gif-picker-visible <=> root.composer-gif-picker-visible;
                composer-gifs-available : root.composer-gifs-available;
                composer-is-editing <=> root.composer-is-editing;
                composer-is-replying : root.composer-is-replying;
                composer-notice : root.composer-notice;
                composer-placeholder : root.composer-placeholder;
                composer-reply-has-thumbnail : root.composer-reply-has-thumbnail;
                composer-reply-preview : root.composer-reply-preview;
                composer-reply-thumbnail : root.composer-reply-thumbnail;
                composer-reply-to-sender-name : root.composer-reply-to-sender-name;
                composer-text <=> root.composer-text;
                connection-banner-dismissed <=> root.connection-banner-dismissed;
                connection-reconnect-attempt : root.connection-reconnect-attempt;
                connection-status : root.connection-status;
                context-menu-anchor-bottom <=> root.context-menu-anchor-bottom;
                context-menu-anchor-left <=> root.context-menu-anchor-left;
                context-menu-anchor-right <=> root.context-menu-anchor-right;
                context-menu-anchor-top <=> root.context-menu-anchor-top;
                context-menu-content-top <=> root.context-menu-content-top;
                context-menu-preview-from-thread <=> root.context-menu-preview-from-thread;
                context-menu-preview-message <=> root.context-menu-preview-message;
                context-menu-preview-mobile <=> root.context-menu-preview-mobile;
                context-menu-preview-row-width <=> root.context-menu-preview-row-width;
                context-menu-preview-row-x <=> root.context-menu-preview-row-x;
                context-menu-preview-row-y <=> root.context-menu-preview-row-y;
                context-menu-visible <=> root.context-menu-visible;
                conversation-kind : root.conversation-kind;
                conversation-read-only : root.conversation-read-only;
                create-channel-initial-tab <=> root.create-channel-initial-tab;
                create-section-id <=> root.create-section-id;
                create-section-rename-mode <=> root.create-section-rename-mode;
                current-playing-attachment-id : root.current-playing-attachment-id;
