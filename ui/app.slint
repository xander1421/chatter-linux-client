import { GlassSurface } from "components/glass_surface.slint";
import { MeshPeerSheet } from "mesh/mesh_peer_sheet.slint";
import { MeshSetupSheet } from "mesh/mesh_setup_sheet.slint";
import { Materials } from "theme/materials.slint";
import { UpdateGlobal } from "update/update_global.slint";
import { Appearance } from "theme/appearance.slint";
import { MessageInfo, MessageInfoModal } from "modals/message_info.slint";
import { ServerRecordsScreen, ServerRecordsGlobal } from "server_records/screen.slint";
// Chatter window: the root component Rust binds as `MainWindow`.
// View routing, the modal overlay system, and Android Back handling.

import { Colors } from "theme/colors.slint";
import { Spacing } from "theme/spacing.slint";
import { Typography } from "theme/typography.slint";
import { VoiceRecording } from "chat/voice_recording.slint";
import { VirtualKeyboard } from "components/modal_container.slint";
import { Icons } from "theme/icons.slint";
import { DismissButton } from "components/dismiss_button.slint";

// Import auth screens
import { LoginPage } from "pages/login.slint";
import { RegisterPage } from "pages/register.slint";
import { AccountRecoveryPage } from "pages/account_recovery.slint";
import { LinkDevicePage } from "pages/link_device.slint";
import { LoadingPage } from "pages/loading.slint";
import { WelcomePage } from "pages/welcome.slint";

// Import main layout components
import { Sidebar, ChatRowData, CustomSectionData } from "sidebar/sidebar.slint";
import { ChatLayout, MessageItemData, MessageAttachmentData, PendingAttachmentData, ReactionEntry } from "chat/chat_layout.slint";
import { SecretTimerModal } from "chat/secret_timer_modal.slint";
import { ThreadPanel } from "chat/thread_panel.slint";
import { ConversationKind } from "chat/conversation_kind.slint";
import { ReactionPicker } from "chat/reaction_picker.slint";
import { MessageContextMenu, MessageMenuActions } from "chat/message_context_menu.slint";
import { SelectionBar, SelectionChrome } from "chat/selection_bar.slint";
import { DeleteConfirm } from "chat/delete_confirm.slint";
import { EmojiData } from "components/emoji_picker.slint";
import { GifData } from "components/gif_picker.slint";
import { MentionAutocomplete, MentionSuggestion } from "components/mention_autocomplete.slint";

// Import modals
import { CreateChannelModal, AIProviderOption, AIModelOption, CreateChannelConfig, PrivateGroupFriend } from "modals/create_channel.slint";
import { UserProfileModal, SharedContentItem, SharedTab, EditProfileModal, RecoveryCodesModal, SealedSenderIntroModal, LinkDeviceApproveModal } from "modals/mod.slint";
import { FriendsModal, FriendData, FriendRequestData, BlockedUserData } from "modals/friends.slint";
import { ForwardMessageModal, ForwardTarget } from "modals/forward_message.slint";
import { SessionsModal, SessionInfo, PendingLinkInfo } from "modals/sessions.slint";
import { SearchResultChannel } from "modals/join_channel.slint";
import { ChannelSettingsModal, ChannelMemberData, BannedMemberData } from "modals/channel_settings.slint";
import { InvitePrivateGroupModal } from "modals/invite_private_group.slint";
import { InviteMemberModal, InviteUser } from "modals/invite_member.slint";
import { CreateSectionModal } from "modals/create_section.slint";
import { UnifiedSearch, QuickSwitcherItem, SearchResult, CalendarDay } from "components/unified_search.slint";

// Import settings
import { SettingsScreen, LocalAIProviderData, CatalogModelData } from "settings/settings_screen.slint";
import { AccountMenu } from "settings/account_menu.slint";
import { CreateMenu, NewChatPicker } from "sidebar/create_menu.slint";
import { ChatHeaderMenu } from "chat/chat_header_menu.slint";
import { PinnedMessagesModal, PinnedItem } from "modals/pinned_messages.slint";
export { PinnedItem }
import { JarvisMemoryModal, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData } from "modals/jarvis_memory.slint";

// Import components
import { ImageViewer, EmojiData } from "components/mod.slint";
import { Toast } from "components/mod.slint";
import { ConnectionBanner, MeshOnlyBar } from "components/mod.slint";
import { CodePreviewPanel } from "components/mod.slint";
import { PdfPreviewPanel } from "components/mod.slint";
import { VideoPlayer } from "components/mod.slint";
import { MobileBottomNav } from "components/mobile_bottom_nav.slint";

// Import call UI
import { IncomingCallModal, ActiveCallView, ReturnToCallBar, DevicePicker, CallHistoryScreen, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, CallHistoryRow } from "calls/mod.slint";

// Jarvis AI: feature-gate global (the AI channel is the Jarvis surface)
import { JarvisGlobal } from "jarvis/jarvis_global.slint";

// Import anon mode global + PIN modal
import { AnonModePinModal } from "modals/anon_mode_pin.slint";
import { ShieldNetworkBanner } from "anon_mode/shield_network_banner.slint";
import { AnonMode } from "anon_mode/anon_mode_global.slint";

// Re-export types for Rust binding
export { ChatRowData, CustomSectionData, MessageItemData, MessageAttachmentData, ForwardTarget, SessionInfo, PendingLinkInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, CallHistoryRow, AudioDeviceData, ScreenSourceData, ChannelMemberData, BannedMemberData, PrivateGroupFriend, LocalAIProviderData, CatalogModelData, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData, InviteUser, ReactionEntry, QuickSwitcherItem, SharedContentItem, SharedTab }

export component MainWindow inherits Window {
    title: "Chatter";
    icon: @image-url("../assets/icon-256.png");
    // Responsive: allow narrow widths for phones (360dp minimum)
    min-width: 360px;
    min-height: 480px;
    preferred-width: 800px;
    preferred-height: 600px;
    default-font-family: Typography.font-family;
    default-font-size: Typography.sm;

    // ========== Safe area insets (Android status bar / nav bar / IME) ==========
    // Slint 1.15 splits two separate out-props on the Window:
    //   * `safe-area-insets`  — system bars only (status bar / nav bar).
    //   * `virtual-keyboard-size.height` — IME height when the keyboard is up.
    // The Android backend feeds them from `WindowInsets.Type.systemBars()` and
    // `WindowInsets.Type.ime()` respectively, so they must both be subtracted
    // from the content area to lift the composer above the keyboard.
    property <length> safe-area-top: root.safe-area-insets.top;
    property <length> safe-area-bottom: root.safe-area-insets.bottom
        + max(root.virtual-keyboard-size.height, root.composer-keyboard-reserve);
    private property <length> composer-keyboard-reserve: 0px;
    in-out property <float> remembered-keyboard-height-px: 0;
    in-out property <float> remembered-keyboard-width-px: 0;
    private property <bool> zero-inset-keyboard: false;
    property <length> drawer-keyboard-height: !root.zero-inset-keyboard
        && root.remembered-keyboard-height-px > 0
        && root.width > (root.remembered-keyboard-width-px - 32) * 1px
        && root.width < (root.remembered-keyboard-width-px + 32) * 1px
        ? root.remembered-keyboard-height-px * 1px : 0px;
    callback composer-keyboard-height-learned(float, float);
    public function cancel-composer-keyboard-handover() {
        root.composer-keyboard-reserve = 0px;
        keyboard-handover-timeout.stop();
        keyboard-handover-settle.stop();
    }
    function request-composer-keyboard(space: length) {
        if root.is-mobile-platform {
            root.composer-keyboard-reserve = space;
            keyboard-handover-timeout.start();
            keyboard-handover-timeout.restart();
        }
    }
    function watch-composer-keyboard() {
        if root.is-mobile-platform && root.virtual-keyboard-size.height <= 0px {
            keyboard-zero-inset-timeout.start();
            keyboard-zero-inset-timeout.restart();
        }
    }
    keyboard-zero-inset-timeout := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            if root.virtual-keyboard-size.height <= 0px && !root.composer-drawer-visible {
                root.zero-inset-keyboard = true;
            }
        }
    }
    keyboard-height-settle := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            if root.is-mobile-platform && !root.composer-drawer-visible
                && root.virtual-keyboard-size.height > 0px {
                root.remembered-keyboard-height-px = root.virtual-keyboard-size.height / 1px;
                root.remembered-keyboard-width-px = root.width / 1px;
                root.composer-keyboard-height-learned(
                    root.remembered-keyboard-height-px, root.remembered-keyboard-width-px);
            }
        }
    }
    // Keep the drawer's occupied space while the native keyboard is requested.
    // Its inset animation may end below drawer height; release after it settles.
    keyboard-handover-settle := Timer {
        interval: 120ms;
        running: false;
        triggered => { root.cancel-composer-keyboard-handover(); }
    }
    // A refused keyboard request must not leave an invisible permanent panel.
    keyboard-handover-timeout := Timer {
        interval: 1500ms;
        running: false;
        triggered => { root.cancel-composer-keyboard-handover(); }
    }

    // True on Android/iOS — set by Rust at startup. Means TOUCH INPUT: target
    // sizes, press-and-hold, no keyboard shortcuts. It does not pick the
    // layout; `compact-layout` does.
    in property <bool> is-mobile-platform: false;
    // Single pane + bottom tab bar + back button. Decided by logical width,
    // not by platform: a 1000dp+ tablet gets the two-pane desktop structure
    // (with touch-sized targets), a phone the stacked one. Material's compact
    // breakpoint is 600dp; 600-839dp is two-pane on the icon rail
    // (`is-small-screen`). Re-evaluated on every resize, so rotation and
    // split-screen switch live; `mobile-show-chat` and the open conversation
    // survive the switch. Out so Rust's Back handler can ask it.
    out property <bool> compact-layout: root.is-mobile-platform && root.width < 600px;
    // macOS only, both set by Rust once the native titlebar is made
    // transparent/unified (platform::macos::apply_unified_titlebar). 0 on
    // every other platform, which is what makes the bindings below no-ops
    // there.
    //
    // The app does NOT reserve a row for the titlebar: the whole point of the
    // unified look is that the traffic lights sit *inside* the app's own top
    // row, level with the sidebar's first row and the conversation header —
    // one row, the way every native macOS chat app does it. So content runs
    // to y=0 and the only thing that moves is whatever would otherwise be
    // drawn beneath the lights themselves.
    in property <length> macos-titlebar-height: 0px;
    in property <length> macos-traffic-lights-width: 0px;
    // Leading clearance the conversation header has to add for itself: the
    // sidebar absorbs the traffic lights when it is wide enough, and the rail
    // (60px) is not. Zero whenever the panel already covers them.
    property <length> chat-traffic-lights-lead: max(0px, root.macos-traffic-lights-width
        - (root.sidebar-is-rail ? Spacing.sidebar-width-collapsed : Spacing.sidebar-width));
    // Keyboard is considered open when bottom inset exceeds the nav bar threshold
    property <bool> keyboard-open: safe-area-bottom > 80px;
    // Whether the mobile tab bar is on screen. The full-screen pages that leave
    // a strip for it (bottom-inset) must use this same condition: they used to
    // omit `mobile-show-chat`, so over an open chat the strip showed the chat
    // composer through the page instead of the (hidden) tab bar.
    // Settings is a pushed full-screen page, not a tab, so it covers the bar
    // the same way a pushed conversation does.
    property <bool> bottom-nav-visible: root.compact-layout && root.current-view == "main"
        && !root.keyboard-open && !root.mobile-show-chat && !root.settings-open;
    // The Chats tab's floating create button: only on the list itself, never
    // over a pushed screen, a dialog, the search palette or selection mode.
    property <bool> fab-visible: root.bottom-nav-visible && root.active-tab == "chats"
        && root.active-modal == "none" && !root.unified-search-open && !root.selection-mode;
    // Its top edge: above the dock and, during a call, the return-to-call
    // bar stacked on it — the same strip the main column reserves for them.
    // In the main content layer's coordinates (it and the dock both live
    // there, below the status bar), not the window's: measuring from
    // root.height put it a status bar's height low, over the dock.
    property <length> fab-y: root.height - root.safe-area-top - root.safe-area-bottom
        - Spacing.fab-size - Spacing.xl
        - (Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom)
        - (root.active-call-visible ? 44px + Spacing.sm : 0px);

    // ========== View routing ==========
    // Views: "loading", "login", "register", "recovery", "main"
    in-out property <string> current-view: "loading";
    private property <string> previous-view: "loading";
    private property <string> exiting-view: "";
    private property <bool> view-appearing: true;
    private property <float> view-progress: 1;
    animate view-progress {
        duration: root.view-appearing ? Materials.motion-standard : 0ms;
        easing: Materials.glide;
    }
    function view-shift(name: string) -> length {
        return root.current-view == name ? (1 - root.view-progress) * 24px
            : -root.view-progress * 12px;
    }
    function view-opacity(name: string) -> float {
        return root.current-view == name ? root.view-progress : 1 - root.view-progress;
    }
    view-arrive := Timer {
        interval: 1ms;
        running: false;
        triggered => { self.running = false; root.view-appearing = true; root.view-progress = 1; }
    }
    view-leave := Timer {
        interval: Materials.motion-standard + 40ms;
        running: false;
        triggered => { self.running = false; root.exiting-view = ""; }
    }

    // ========== Unified search (top bar) ==========
    in property <[QuickSwitcherItem]> unified-search-conversations: [];
    in property <[SearchResult]> unified-search-messages: [];
    in property <bool> unified-search-searching: false;
    in-out property <string> unified-search-query: "";
    in-out property <bool> unified-search-open: false;
    in-out property <int> unified-search-selected-index: 0;
    in-out property <string> unified-search-category: "all";
    in-out property <string> unified-search-sort: "relevance";
    in-out property <string> unified-search-date: "any";
    in-out property <string> unified-search-from: "";
    in-out property <string> unified-search-in: "";
    in-out property <string> unified-search-from-label: "";
    in-out property <string> unified-search-in-label: "";
    in property <[QuickSwitcherItem]> unified-search-picker-options: [];
    in property <[string]> unified-search-recents: [];
    in property <string> unified-search-calendar-month: "";
    in property <[CalendarDay]> unified-search-calendar-days: [];
    in property <[int]> unified-search-counts: [0, 0, 0, 0, 0, 0, 0];
    in property <[int]> unified-search-page-limits: [50, 50, 50, 50, 50, 50, 50];
    in property <[image]> unified-search-thumbnails: [];
    in property <[bool]> unified-search-has-thumbnails: [];
    in property <[string]> unified-search-message-kinds: [];
    // Loaded from SettingsRepository at startup: "k" | "f" | "both".
    in-out property <string> search-shortcut-pref: "both";
    callback unified-search-opened();
    callback unified-search-closed();
    callback unified-search-changed(string);
    callback unified-search-filters-changed(string, string, string, string, string);
    callback unified-search-recent-selected(string);
    callback unified-search-recent-clear();
    callback unified-search-recent-remove(string);
    callback unified-search-calendar-shift(int);
    callback unified-search-picker-request(string, string);
    callback unified-search-show-more(string);
    callback unified-search-conversation-selected(string, string);
    callback unified-search-message-selected(string);
    // People (exact-handle resolve-on-Enter)
    in property <bool> unified-search-query-is-handle: false;
    in property <string> unified-search-person-status: "";
    in property <string> unified-search-person-error: "";
    in property <string> unified-search-person-id: "";
    in property <string> unified-search-person-name: "";
    in property <string> unified-search-person-handle: "";
    callback unified-search-resolve(string);
    callback unified-search-person-selected(string);

    // ========== Connection status ==========
    // "connected", "connecting", "reconnecting", "disconnected", "failed".
    // Pushed from `bin_ui::features::connection`, which reads chatter-core's
    // `OfflineState` — kept honest by the reachability monitor in
    // `chatter-core/src/network/server_monitor.rs`, which is the only thing that
    // revises it after boot.
    in property <string> connection-status: "connected";
    in property <int> connection-reconnect-attempt: 0;

    // Whether chatter-core considers the server settled-unreachable
    // (`ConnectionState::is_unreachable`) — as opposed to a connect still being
    // in flight, where nothing should be claimed either way. One definition,
    // computed in core, so the auth screens and the banner cannot disagree.
    in property <bool> server-unreachable: false;

    // The user closed the connection banner. Purely presentational — the red dot
    // on the sidebar's settings button keeps reporting the outage — and cleared
    // again on reconnect below, so dismissing one outage never hides the next.
    property <bool> connection-banner-dismissed: false;
    changed connection-status => {
        if (root.connection-status == "connected") {
            root.connection-banner-dismissed = false;
        }
    }

    // ========== Working without an account ==========
    // Whether chatter-core says there is anything usable with no account
    // (`ChatterClient::has_account_free_surfaces` — in practice, a running
    // mesh). Gates the way past the sign-in screens; never guessed here.
    in property <bool> account-free-surfaces: false;
    // Whether there is a chatter session. False is a supported state of the main
    // view, not a transient one: a user who came in over the mesh has no account
    // and may never get one.
    in property <bool> is-signed-in: false;
    callback continue-without-account();

    // ========== Loading page properties ==========
    in property <string> loading-message: "Loading...";
    in property <string> loading-secondary-message: "";

    // ========== Auth page properties ==========
    in-out property <string> login-username: "";
    in-out property <string> login-password: "";
    in-out property <string> login-pin: "";
    in property <bool> login-loading: false;
    in property <string> login-error: "";
    // The login is solving the server's proof of work (chatter-core
    // AuthStateData::login_verifying). Set from Rust.
    in property <bool> login-verifying: false;
    in property <bool> login-identity-reset-available: false;
    callback accept-new-identity();

    in-out property <string> register-display-name: "";
    in-out property <string> register-username: "";
    in-out property <string> register-password: "";
    in-out property <string> register-confirm-password: "";
    in-out property <string> register-pin: "";
    in-out property <string> register-server-url: "";
    in-out property <string> login-server-url: "";
    in-out property <string> configured-server-url: "";
    in property <bool> register-loading: false;
    in property <string> register-error: "";
    in property <image> register-avatar-source;
    in property <bool> register-has-avatar: false;
    in-out property <int> register-selected-default-idx: 0;
    in-out property <color> register-avatar-color: Colors.avatar-teal;
    in property <int> register-password-strength: 0;
    in property <int> register-pin-strength: 0;
    callback register-select-avatar();
    callback register-select-default-avatar(int);
    callback register-remove-avatar();
    pure callback register-username-validation(string) -> string;
    callback register-password-changed(string);
    callback register-pin-changed(string);

    // ========== Link Device page properties (new device side) ==========
    in property <image> link-device-qr;
    in property <string> link-device-url: "";
    in property <string> link-device-status: "Generate a QR to begin.";
    in property <string> link-device-error: "";
    in property <bool> link-device-active: false;
    in property <bool> link-device-has-local-identity: false;
    callback link-device-start();
    callback link-device-cancel();
    callback link-device-copy();

    // ========== Link Device Approve modal (primary side) ==========
    in-out property <string> link-approve-url: "";
    in-out property <string> link-approve-password: "";
    in property <string> link-approve-preview-name: "";
    in property <string> link-approve-preview-server: "";
    // 6-char code derived from the new device's ephemeral pubkey. Must
    // match the value displayed on the new device — this is the user's
    // gate against MITM substitution of the QR ephemeral key.
    in property <string> link-approve-verification-code: "";
    in property <bool> link-approve-preview-ready: false;
    in property <string> link-approve-status: "";
    in property <string> link-approve-error: "";
    in property <bool> link-approve-busy: false;
    callback link-approve-paste-changed(string);
    callback link-approve-submit(string);  // password (pending link is
                                            // already stashed on paste)
    callback link-approve-open();
    callback link-approve-close();
    callback link-approve-scan();

    // ========== Recovery codes modal properties ==========
    in property <[string]> recovery-codes: [];
    // Set when the codes came from Settings › Regenerate: Continue returns to
    // Settings instead of carrying on into registration's onboarding.
    in-out property <bool> recovery-codes-regenerated: false;
    callback recovery-codes-confirmed() -> bool;
    callback recovery-codes-copy-all();

    // Sealed sender onboarding explainer (shown after recovery codes).
    // Fired when the user confirms; carries their initial "allow from anyone"
    // choice so the caller can persist it to the server.
    callback sealed-sender-intro-confirmed(bool);

    // ========== Account recovery page properties ==========
    in-out property <string> recovery-username: "";
    in-out property <string> recovery-code: "";
    in-out property <string> recovery-new-password: "";
    in-out property <string> recovery-confirm-password: "";
    in-out property <string> recovery-new-pin: "";
    in property <bool> recovery-loading: false;
    in property <string> recovery-error: "";
    in property <string> recovery-success: "";
    callback recover-account(string, string, string, string);  // username, recovery_code, new_password, new_pin

    // ========== Sidebar properties ==========
    in property <[ChatRowData]> chat-rows: [];
    in-out property <bool> chat-rows-loading: true;
    in property <[CustomSectionData]> custom-sections: [];
    in property <int> total-unread-count: 0;
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    // Manual presence mode chosen in the status picker ("auto" default).
    in-out property <string> user-presence-mode: "auto";
    in-out property <bool> sidebar-collapsed: false;
    // The ONE definition of "the panel is a rail right now". The Sidebar
    // collapses on either signal, so anything else deciding based on collapse
    // state has to read the same expression — checking `sidebar-collapsed`
    // alone reports "expanded" on a phone that is showing a rail, which removed
    // the entire chat column and left a blank screen.
    property <bool> sidebar-is-rail: root.is-small-screen || root.sidebar-collapsed;
    in-out property <bool> sidebar-hidden: false;
    // The current top-level destination: "chats", "calls", "contacts" or
    // "profile" (the account menu). Separate from `modal-stack` below — a
    // screen pushed over a tab (someone's profile, Settings, Sessions) never
    // changes which tab you are on, so the bar's highlight and Back both stay
    // truthful. On a two-pane layout the sidebar's Calls / Contacts / avatar
    // select it.
    // Navigation rules: crates/chatter-ui/src/bin_ui/features/back.rs.
    in-out property <string> active-tab: "chats";
    // Single-pane routing on mobile: false = conversation list, true = the
    // conversation itself. The two are mutually exclusive and each takes the
    // whole width — there is no rail beside them, because the bottom tab bar
    // is what keeps navigation always-available now. Desktop ignores this
    // entirely and keeps the side-by-side panel it has always had.
    in-out property <bool> mobile-show-chat: false;
    // Both phone panes stay mounted until the push settles. The message list
    // therefore keeps its scroll position while the header and composer travel
    // with the conversation, and Back reverses the same movement.
    property <float> chat-push-progress: 0;
    // Keep capture protection through the pane's reverse slide.
    out property <bool> chat-content-visible:
        !root.compact-layout || root.mobile-show-chat || root.chat-push-progress > 0;
    changed chat-content-visible => { root.refresh-screen-protection(); }
    property <bool> chat-edge-swiping: false;
    property <length> chat-edge-start: 0px;
    animate chat-push-progress {
        duration: root.chat-edge-swiping ? 0ms : Materials.motion-standard;
        easing: Materials.glide;
    }

    // ========== Chat properties ==========
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <ConversationKind> conversation-kind;
    in property <bool> chat-can-forward: false;
    in property <bool> private-channel: false;
    in property <string> privacy-line-override: "";
    in property <bool> privacy-line-exposed: false;
    in-out property <bool> is-dm: false;  // True for DM conversations (hides avatars/names in messages)
    in property <int> member-count: 0;
    in property <string> topic: "";
    in property <string> typing-indicator: "";
    in property <string> header-presence-status: "offline";
    in property <image> channel-avatar-source;
    in property <bool> channel-has-avatar: false;
    in property <[MessageItemData]> messages: [];
    in property <bool> loading-messages: false;
    in property <int> scroll-to-message-index: -1;  // Set to scroll to a specific message
    in property <string> highlighted-message-id: "";  // Message id to briefly flash (quote jump)
