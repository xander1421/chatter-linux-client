// Chatter Application Component
// Main application layout with view routing and modal overlay system

import { Colors } from "theme/colors.slint";
import { Spacing } from "theme/spacing.slint";
import { Typography } from "theme/typography.slint";
import { Icons } from "theme/icons.slint";

// Import auth screens
import { LoginPage } from "pages/login.slint";
import { RegisterPage } from "pages/register.slint";
import { AccountRecoveryPage } from "pages/account_recovery.slint";
import { LoadingPage } from "pages/loading.slint";
import { WelcomePage } from "pages/welcome.slint";

// Import main layout components
import { Sidebar, ChannelListItemData, DMListItemData, PrivateGroupListItemData, OrgListItemData, CustomSectionData, SectionConversationData } from "sidebar/sidebar.slint";
import { ChatLayout, MessageItemData, MessageAttachmentData, PendingAttachmentData, ReactionEntry } from "chat/chat_layout.slint";
import { ThreadPanel } from "chat/thread_panel.slint";
import { MembersPanel } from "chat/members_panel.slint";
import { ReactionPicker } from "chat/reaction_picker.slint";
import { MessageContextMenu } from "chat/message_context_menu.slint";
import { EmojiPicker, EmojiData } from "components/emoji_picker.slint";
import { GifPicker, GifData } from "components/gif_picker.slint";
import { MentionAutocomplete, MentionSuggestion } from "components/mention_autocomplete.slint";

// Import modals
import { CreateChannelModal, AIProviderOption, AIModelOption, CreateChannelConfig, PrivateGroupFriend } from "modals/create_channel.slint";
import { UserProfileModal, EditProfileModal, RecoveryCodesModal } from "modals/mod.slint";
import { FriendRequestsModal, FriendRequest } from "modals/friend_requests.slint";
import { FriendsModal, FriendData, UserSearchResult, FriendRequestData, BlockedUserData } from "modals/friends.slint";
import { ForwardMessageModal, ForwardTarget } from "modals/forward_message.slint";
import { SessionsModal, SessionInfo } from "modals/sessions.slint";
import { JoinChannelModal, SearchResultChannel } from "modals/join_channel.slint";
import { SearchModal, SearchResult } from "modals/search_modal.slint";
import { ChannelSettingsModal, ChannelMemberData } from "modals/channel_settings.slint";
import { InvitePrivateGroupModal } from "modals/invite_private_group.slint";
import { InviteMemberModal, InviteUser } from "modals/invite_member.slint";
import { CreateSectionModal } from "modals/create_section.slint";
import { QuickSwitcher, QuickSwitcherItem } from "modals/quick_switcher.slint";

// Import settings
import { SettingsScreen } from "settings/settings_screen.slint";

// Import org management
import { OrgManagementScreen, OrgMemberData, OrgDashboardData } from "org/org_management.slint";

// Import components
import { ImageViewer, EmojiData } from "components/mod.slint";
import { Toast } from "components/mod.slint";
import { ConnectionBanner } from "components/mod.slint";
import { CodePreviewPanel } from "components/mod.slint";
import { PdfPreviewPanel } from "components/mod.slint";
import { VideoPlayer } from "components/mod.slint";
import { MobileBottomNav } from "components/mobile_bottom_nav.slint";

// Import call UI
import { IncomingCallModal, ActiveCallView, DevicePicker, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData } from "calls/mod.slint";

// Import Jarvis AI assistant
import { JarvisPanel, JarvisMessageData } from "jarvis/mod.slint";

// Re-export types for Rust binding
export { ChannelListItemData, DMListItemData, PrivateGroupListItemData, OrgListItemData, CustomSectionData, SectionConversationData, MessageItemData, MessageAttachmentData, FriendRequest, ForwardTarget, SessionInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, UserSearchResult, FriendRequestData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, ChannelMemberData, PrivateGroupFriend, JarvisMessageData, InviteUser, ReactionEntry, OrgMemberData, OrgDashboardData, QuickSwitcherItem }

export component App inherits Rectangle {
    // ========== Safe area insets (set by Rust on Android) ==========
    in property <length> safe-area-top: 0px;     // Android status bar (~24dp)
    in property <length> safe-area-bottom: 0px;  // Android nav bar / gesture area

    // ========== Mobile navigation ==========
    // True only on actual mobile devices (Android) — set by Rust at startup.
    // Desktop narrow windows should NOT trigger mobile mode.
    in property <bool> is-mobile-platform: false;
    // Active bottom nav tab on mobile: "chats", "calls", "contacts", "settings"
    in-out property <string> mobile-active-tab: "chats";
    // True when a conversation is open (channel/DM/group selected)
    property <bool> has-active-conversation: channel-id != "";
    // Callback when mobile back button is pressed (returns to chat list)
    callback mobile-back();
    // Keyboard is considered open when bottom inset exceeds the nav bar threshold
    property <bool> keyboard-open: safe-area-bottom > 80px;

    // ========== View routing ==========
    // Views: "loading", "login", "register", "recovery", "main"
    in-out property <string> current-view: "loading";

    // ========== Quick switcher (Ctrl+K) ==========
    in property <[QuickSwitcherItem]> quick-switcher-items: [];
    in-out property <string> quick-switcher-query: "";
    in-out property <int> quick-switcher-selected-index: 0;
    callback quick-switcher-search(string);
    callback quick-switcher-select(string, string);
    callback quick-switcher-opened();

    // ========== Connection status ==========
    // "connected", "connecting", "reconnecting", "disconnected", "failed"
    in property <string> connection-status: "connected";
    in property <int> connection-reconnect-attempt: 0;
    in property <int> connection-queue-count: 0;

    // ========== Loading page properties ==========
    in property <string> loading-message: "Loading...";
    in property <string> loading-secondary-message: "";

    // ========== Auth page properties ==========
    in-out property <string> login-username: "";
    in-out property <string> login-password: "";
    in-out property <string> login-pin: "";
    in property <bool> login-loading: false;
    in property <string> login-error: "";

    in-out property <string> register-display-name: "";
    in-out property <string> register-username: "";
    in-out property <string> register-password: "";
    in-out property <string> register-confirm-password: "";
    in-out property <string> register-pin: "";
    in-out property <string> register-server-url: "";
    in property <bool> register-loading: false;
    in property <string> register-error: "";
    in property <image> register-avatar-source;
    in property <bool> register-has-avatar: false;
    in-out property <int> register-selected-default-idx: -1;
    in property <string> register-username-status: "none";
    in property <int> register-password-strength: 0;
    in property <int> register-pin-strength: 0;
    callback register-select-avatar();
    callback register-select-default-avatar(int);
    callback register-check-username(string);
    callback register-password-changed(string);
    callback register-pin-changed(string);

    // ========== Recovery codes modal properties ==========
    in property <[string]> recovery-codes: [];
    callback recovery-codes-confirmed();
    callback recovery-codes-copy-all();

    // ========== Account recovery page properties ==========
    in-out property <string> recovery-username: "";
    in-out property <string> recovery-code: "";
    in-out property <string> recovery-new-password: "";
    in-out property <string> recovery-confirm-password: "";
    in-out property <string> recovery-new-pin: "";
    in property <bool> recovery-loading: false;
    in property <string> recovery-error: "";
    in property <string> recovery-success: "";
    callback recover-account(string, string, string, string);  // username, recovery_code, new_password, new_pin

    // ========== Sidebar properties ==========
    in property <[ChannelListItemData]> channels: [];
    in property <[DMListItemData]> dm-conversations: [];
    in property <[PrivateGroupListItemData]> private-groups: [];
    in property <[CustomSectionData]> custom-sections: [];
    in property <[SectionConversationData]> section-conversations: [];
    in property <int> total-unread-count: 0;
    in property <string> user-display-name: "User";
    in property <image> user-avatar-source;
    in property <string> user-initials: "";
    in property <string> user-presence-status: "online";
    in property <string> user-custom-status: "";
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> sidebar-hidden: false;

    // Organization properties
    in property <string> current-org-id: "";
    in property <string> current-org-name: "";
    in property <string> current-org-initial: "";
    in property <string> current-org-slug: "";
    in property <string> current-org-viewer-role: "member";
    in property <[OrgListItemData]> organizations: [];
    in property <bool> org-loading: false;

    // ========== Chat properties ==========
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <string> channel-type: "public";
    in-out property <bool> is-dm: false;  // True for DM conversations (hides avatars/names in messages)
    in property <int> member-count: 0;
    in property <string> topic: "";
    in property <bool> is-archived: false;
    in property <string> typing-indicator: "";
    in property <string> header-presence-status: "offline";
    in property <[MessageItemData]> messages: [];
    in property <bool> loading-messages: false;
    in property <int> scroll-to-message-index: -1;  // Set to scroll to a specific message
    in-out property <length> message-scroll-position: 0px;  // Scroll position for message list
    in-out property <bool> is-at-bottom: true;  // True when message list is scrolled to bottom
    in property <bool> should-auto-scroll: true;  // Enable/disable auto-scroll on new messages
    in-out property <string> composer-text: "";
    in property <string> composer-placeholder: "Type a message...";
    in property <bool> composer-disabled: false;
    in property <[PendingAttachmentData]> pending-attachments: [];
    in-out property <bool> composer-is-editing: false;
    in-out property <string> composer-edit-message-id: "";

    // ========== Reply-to state (Signal-style: sender_id + timestamp) ==========
    in-out property <bool> composer-is-replying: false;
    in-out property <string> composer-reply-to-sender: "";       // Sender UUID (for protocol)
    in-out property <string> composer-reply-to-sender-name: ""; // Sender display name (for UI)
    in-out property <string> composer-reply-to-timestamp: "";
    in-out property <string> composer-reply-preview: "";
    in-out property <bool> composer-reply-has-thumbnail: false;
    in-out property <image> composer-reply-thumbnail;

    // ========== Audio playback state ==========
    in-out property <string> current-playing-attachment-id: "";
    in-out property <bool> is-media-playing: false;  // True when audio is actively playing (not paused)
    in-out property <float> audio-progress: 0.0;  // Playback progress 0.0-1.0
    in-out property <string> audio-elapsed: "0:00";  // Elapsed time display

    // ========== Image viewer state ==========
    in-out property <bool> image-viewer-visible: false;
    in property <image> image-viewer-source;
    in property <string> image-viewer-filename: "";
    in property <string> image-viewer-size: "";
    callback close-image-viewer();

    // ========== Code preview state ==========
    in-out property <bool> code-preview-visible: false;
    in property <string> code-preview-filename: "";
    in property <string> code-preview-language: "";
    in property <int> code-preview-line-count: 0;
    in property <image> code-preview-image;
    in property <string> code-preview-plain-text: "";
    in property <bool> code-preview-has-selection: false;
    in property <string> code-preview-selected-text: "";
    callback close-code-preview();
    callback copy-code();
    callback copy-code-selection();
    callback open-code-external();
    callback code-preview-pointer-down(/* x */ length, /* y */ length, /* shift */ bool, /* ctrl */ bool);
    callback code-preview-pointer-move(/* x */ length, /* y */ length);
    callback code-preview-pointer-up(/* x */ length, /* y */ length);

    // ========== PDF preview state ==========
    in-out property <bool> pdf-preview-visible: false;
    in property <string> pdf-preview-filename: "";
    in property <int> pdf-preview-page-count: 0;
    in property <int> pdf-preview-current-page: 1;
    in property <string> pdf-preview-error: "";
    in property <image> pdf-preview-image;
    callback close-pdf-preview();
    callback open-pdf-external();
    callback pdf-page-prev();
    callback pdf-page-next();

    // ========== Video player state ==========
    in-out property <bool> video-player-visible: false;
    in property <image> video-player-frame;
    in property <string> video-player-filename: "";
    in property <float> video-player-progress: 0.0;
    in property <string> video-player-elapsed: "0:00";
    in property <string> video-player-duration: "0:00";
    in property <bool> video-player-is-playing: false;
    in-out property <float> video-player-volume: 1.0;
    callback close-video-player();
    callback video-player-toggle-play-pause();
    callback video-player-seek(float);
    callback video-player-set-volume(float);

    // ========== Reaction picker state ==========
    in-out property <bool> reaction-picker-visible: false;
    in-out property <string> reaction-picker-message-id: "";
    in-out property <string> reaction-picker-sender-id: "";
    in-out property <string> reaction-picker-timestamp-ns: "";
    in property <[EmojiData]> reaction-picker-emojis: [];
    in-out property <int> reaction-picker-selected-category: 0;
    in-out property <string> reaction-picker-search-query: "";
    callback reaction-selected(string, string, string, string);  // (sender_id, timestamp_ns, message_id, emoji)
    callback reaction-picker-category-changed(int);
    callback reaction-picker-search-changed(string);

    // ========== Composer emoji picker state ==========
    in-out property <bool> composer-emoji-picker-visible: false;
    in property <[EmojiData]> composer-emoji-list: [];
    in-out property <int> composer-emoji-category: 0;
    in-out property <string> composer-emoji-search: "";
    in-out property <int> composer-emoji-skin-tone: 0;  // 0=default, 1-5=Fitzpatrick
    callback composer-emoji-selected(string);      // emoji to insert
    callback composer-emoji-category-changed(int); // category index
    callback composer-emoji-search-changed(string); // search query
    callback composer-emoji-skin-tone-changed(int); // skin tone index

    // ========== Composer GIF picker state ==========
    in-out property <bool> composer-gif-picker-visible: false;
    in property <bool> composer-gif-picker-loading: false;
    in property <[GifData]> composer-gif-picker-results: [];
    in-out property <string> composer-gif-picker-search: "";
    callback composer-gif-selected(string, string);
    callback composer-gif-search-changed(string);

    // ========== Mention autocomplete state ==========
    in-out property <bool> mention-autocomplete-visible: false;
    in property <[MentionSuggestion]> mention-suggestions: [];
    in-out property <int> mention-selected-index: 0;
    callback mention-suggestion-selected(string, string);  // (id, display_text)

    // ========== Message context menu state ==========
    in-out property <bool> context-menu-visible: false;
    in-out property <string> context-menu-sender-id: "";
    in-out property <string> context-menu-timestamp-ns: "";
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in property <bool> context-menu-is-own-message: false;
    in property <bool> context-menu-can-delete-for-everyone: false;
    in property <bool> context-menu-is-pinned: false;
    in property <bool> context-menu-has-attachments: false;
    // All callbacks use (sender_id, timestamp_ns) for Signal-style lookups
    callback reply-message(string, string);
    callback edit-message(string, string);
    callback delete-message(string, string);         // (delete for me)
    callback delete-everyone-message(string, string); // (delete for everyone)
    callback pin-message(string, string);
    callback forward-message-action(string, string);
    callback copy-message(string, string);
    callback download-message(string, string);       // Download attachments

    // ========== Pinned bar state ==========
    in property <bool> has-pinned-messages: false;
    in property <string> pinned-message-preview: "";
    in property <int> pinned-current-index: 1;
    in property <int> pinned-total-count: 1;
    callback pinned-prev-clicked();
    callback pinned-next-clicked();
    callback pinned-dismiss-clicked();
    callback pinned-show-clicked();
    callback pinned-go-to-message();

    // ========== Members panel state ==========
    in-out property <bool> members-panel-visible: false;
    in property <[ChannelMemberData]> members-panel-members: [];

    // ========== Thread panel state ==========
    in property <bool> thread-panel-visible: false;
    in property <string> thread-root-message-id: "";
    in property <string> thread-root-sender-name: "";
    in property <string> thread-root-content-preview: "";
    in property <int> thread-reply-count: 0;
    in property <string> thread-channel-name: "";
    in property <[MessageItemData]> thread-replies: [];
    in property <bool> thread-loading: false;
    in-out property <string> thread-composer-text: "";
    callback close-thread-clicked();
    callback send-thread-reply(string);
    callback load-more-thread-replies();

    // ========== Modal state ==========
    // Modals: "none", "settings", "create-channel", "join-channel", "user-profile", "friend-requests", "friends", "forward-message", "sessions", "search", "create-section"
    in-out property <string> active-modal: "none";

    // Create channel modal properties
    in-out property <string> create-channel-name: "";
    in-out property <string> create-channel-description: "";
    in-out property <string> create-channel-template: "";
    in property <string> create-channel-error: "";
    in property <bool> create-channel-loading: false;

    // Create channel AI config properties
    in-out property <string> create-channel-ai-provider: "";
    in-out property <string> create-channel-ai-model: "";
    in property <[AIModelOption]> create-channel-ai-models: [];
    in property <bool> create-channel-ai-models-loading: false;
    in property <string> create-channel-ai-models-error: "";

    // Create channel private group properties
    in-out property <[PrivateGroupFriend]> create-channel-available-friends: [];
    in-out property <int> create-channel-selected-friend-count: 0;

    // Create channel icon upload properties
    in-out property <string> create-channel-icon-url: "";
    in-out property <image> create-channel-icon-preview;
    in-out property <bool> create-channel-has-icon-preview: false;
    callback create-channel-pick-icon();

    // Invite to private group modal properties
    in-out property <string> invite-private-group-id: "";
    in-out property <[PrivateGroupFriend]> invite-private-group-friends: [];
    in-out property <int> invite-private-group-selected-count: 0;
    in property <bool> invite-private-group-loading: false;

    // Invite member to channel modal properties
    in-out property <string> invite-member-channel-id: "";
    in-out property <string> invite-member-channel-name: "";
    in-out property <[InviteUser]> invite-member-users: [];
    in-out property <int> invite-member-selected-count: 0;
    in property <bool> invite-member-loading: false;

    // Create/rename section modal properties
    in-out property <bool> create-section-rename-mode: false;
    in-out property <string> create-section-name: "";
    in-out property <string> create-section-emoji: "📁";
    in-out property <string> create-section-id: "";  // set for rename
    in property <bool> create-section-loading: false;

    // Join channel modal properties
    in-out property <string> join-channel-search-query: "";
    in property <[SearchResultChannel]> join-channel-results: [];
    in property <bool> join-channel-searching: false;
    in property <string> join-channel-error: "";
    in-out property <string> join-channel-selected-id: "";
    in property <bool> join-channel-joining: false;

    // User profile modal properties
    in property <string> profile-user-id: "";
    in property <string> profile-display-name: "";
    in property <string> profile-username: "";
    in property <image> profile-avatar-source;
    in property <string> profile-initials: "";
    in property <string> profile-status-text: "";
    in property <string> profile-presence: "offline";
    in property <string> profile-bio: "";
    in property <bool> profile-is-friend: false;
    in property <bool> profile-is-blocked: false;
    in property <bool> profile-is-self: false;
    in property <bool> profile-loading: false;
    in property <bool> profile-is-verified: false;
    in property <string> profile-safety-number: "";
    in-out property <bool> profile-show-safety-number: false;

    // Edit Profile data
    in-out property <string> edit-profile-display-name: "";
    in-out property <string> edit-profile-bio: "";
    in property <image> edit-profile-avatar;
    in property <bool> edit-profile-loading: false;
    in property <string> edit-profile-error: "";

    // Friend requests modal properties (legacy)
    in property <string> friend-requests-tab: "received";
    in property <[FriendRequest]> received-friend-requests: [];
    in property <[FriendRequest]> sent-friend-requests: [];
    in property <bool> friend-requests-loading: false;

    // Friends modal properties (comprehensive)
    in-out property <string> friends-modal-tab: "find";  // "find", "friends", "requests", "blocked"
    in property <[FriendData]> friends-list: [];
    in-out property <string> friends-search-query: "";
    in property <[UserSearchResult]> friends-search-results: [];
    in property <bool> friends-search-loading: false;
    in-out property <string> friends-requests-sub-tab: "received";
    in property <[FriendRequestData]> friends-received-requests: [];
    in property <[FriendRequestData]> friends-sent-requests: [];
    in property <[FriendRequestData]> friends-private-requests: [];
    in property <[FriendRequestData]> friends-group-invites: [];
    in property <[BlockedUserData]> friends-blocked-users: [];
    in property <bool> friends-loading: false;
    // Pending message requests count (for sidebar badge)
    in property <int> pending-message-requests: 0;
    // Pending group invites count (for sidebar badge)
    in property <int> pending-group-invites: 0;
    // Friend code (privacy-first discovery)
    in-out property <string> friends-my-code: "";
    in-out property <string> friends-code-input: "";
    in-out property <string> friends-code-status: "";
    in-out property <image> friends-qr-code-image;
    in-out property <bool> friends-show-qr: false;

    // Forward message modal properties
    in property <string> forward-message-preview: "";
    in-out property <string> forward-search-text: "";
    in property <[ForwardTarget]> forward-targets: [];
    in property <bool> forward-loading: false;

    // Sessions modal properties
    in property <[SessionInfo]> sessions: [];
    in property <bool> sessions-loading: false;
    in property <bool> sessions-revoking: false;

    // Search modal properties
    in-out property <string> search-query: "";
    in property <[SearchResult]> search-results: [];
    in property <bool> search-searching: false;
    in property <int> search-result-count: 0;
    in-out property <bool> search-all-channels: false;

    // Channel settings modal properties
    in property <string> channel-settings-id: "";
    in property <string> channel-settings-name: "";
    in property <string> channel-settings-description: "";
    in property <string> channel-settings-type: "public";
    in property <bool> channel-settings-archived: false;
    in property <string> channel-settings-created-at: "";
    in property <int> channel-settings-member-count: 0;
    in property <bool> channel-settings-can-edit: false;
    in property <bool> channel-settings-can-manage-members: false;
    in property <bool> channel-settings-can-archive: false;
    in property <bool> channel-settings-can-delete: false;
    in property <bool> channel-settings-is-owner: false;
    in-out property <bool> channel-settings-allow-reactions: true;
    in-out property <bool> channel-settings-allow-threads: true;
    in-out property <bool> channel-settings-allow-attachments: true;
    in-out property <string> channel-settings-notification-pref: "all";
    in-out property <bool> channel-settings-muted: false;
    in property <[ChannelMemberData]> channel-settings-members: [];
    in property <bool> channel-settings-loading: false;
    in property <string> channel-settings-error: "";

    // Settings properties
    in property <string> settings-display-name: "";
    in property <string> settings-username: "";
    in property <image> settings-avatar;
    in property <int> settings-session-count: 0;
    in-out property <string> settings-current-password: "";
    in-out property <string> settings-new-password: "";
    in-out property <string> settings-confirm-password: "";
    in property <bool> settings-password-changing: false;
    in property <string> settings-password-error: "";
    in-out property <bool> settings-read-receipts: true;
    in-out property <bool> settings-typing-indicators: true;
    in property <string> settings-identity-fingerprint: "";
    in-out property <bool> settings-sealed-sender-unrestricted: false;
    in property <int> settings-prekey-count: 0;

    // Settings security (Change PIN / Key Backup)
    in-out property <string> settings-change-pin-current: "";
    in-out property <string> settings-change-pin-new: "";
    in-out property <string> settings-change-pin-confirm: "";
    in property <bool> settings-change-pin-loading: false;
    in property <string> settings-change-pin-error: "";
    in property <string> settings-change-pin-success: "";
    in property <string> settings-backup-status: "unknown";
    in-out property <string> settings-backup-retry-pin: "";
    in property <bool> settings-backup-retry-loading: false;
    in property <string> settings-backup-retry-error: "";

    // AI settings properties
    in-out property <bool> settings-local-ai-enabled: false;
    in-out property <string> settings-local-ai-model-id: "";
    in property <bool> settings-local-ai-loading: false;
    in property <string> settings-local-ai-status: "";
    in property <string> settings-local-ai-error: "";

    // ========== Call properties ==========
    in-out property <bool> incoming-call-visible: false;
    in property <IncomingCallData> incoming-call-data;
    /// True when a newly arrived incoming call will replace the active call
    /// if accepted — driven by the call orchestrator.
    in-out property <bool> incoming-call-replaces-active: false;
    in-out property <bool> active-call-visible: false;
    in property <ActiveCallData> active-call-data;
    in-out property <bool> call-is-muted: false;
    in-out property <bool> call-is-video-enabled: true;
    in-out property <bool> call-is-screen-sharing: false;
    in property <image> call-local-video-frame;
    in property <[image]> call-remote-video-frames;

    // Device picker properties
    in-out property <bool> device-picker-visible: false;
    in-out property <string> device-picker-type: "audio"; // "audio", "audio_output", or "screen"
    in property <[AudioDeviceData]> audio-devices: [];
    in-out property <string> selected-audio-device-id: "";
    in property <[AudioDeviceData]> audio-output-devices: [];
    in-out property <string> selected-audio-output-id: "";
    in property <[ScreenSourceData]> screen-sources: [];
    in-out property <string> selected-screen-source-id: "";

    // ========== Jarvis AI Assistant properties ==========
    in-out property <bool> jarvis-panel-visible: false;
    in-out property <bool> jarvis-thinking: false;
    in property <string> jarvis-response: "";
    in property <[JarvisMessageData]> jarvis-messages: [];

    // ========== Auth callbacks ==========
    callback login(string, string, string, string);  // username, password, server_url, pin
    callback register(string, string, string, string, string);  // username, password, display_name, pin, server_url
    callback go-to-register();
    callback go-to-login();
    callback go-to-recovery();
    callback sso-login(string, string, string);

    // Welcome page callbacks
    callback welcome-add-friends();
    callback welcome-browse-channels();
    callback welcome-get-started();

    // ========== Sidebar callbacks ==========
    callback channel-selected(string);
    callback dm-selected(string);
    callback private-group-selected(string);
    callback saved-messages-clicked();
    callback settings-clicked();
    callback profile-clicked();
    callback change-user-status(string /* status */);
    pure callback get-user-status() -> string;
    callback open-create-channel();
    callback open-join-channel();
    callback toggle-sidebar();
    callback org-selected(/* org_id */ string);
    callback manage-org-clicked();
    callback create-section-clicked();
    callback section-toggle-expanded(/* section-id */ string);
    callback section-conversation-selected(/* conversation-id */ string, /* conversation-type */ string);
    callback delete-section-clicked(/* section-id */ string);
    callback rename-section-clicked(/* section-id */ string);
    callback move-to-section(/* conversation-id */ string, /* conversation-type */ string, /* section-id */ string);
    callback remove-from-section(/* conversation-id */ string);

    // ========== Org management properties ==========
    in property <[OrgMemberData]> org-members: [];
    in property <bool> org-members-loading: false;
    in property <int> org-max-members: 0;
    in property <int> org-retention-days: 0;
    in property <bool> org-require-2fa: false;
    in property <bool> org-allow-guest-access: false;
    in property <[string]> org-allowed-email-domains: [];
    in property <OrgDashboardData> org-dashboard: {
        total-members: 0, active-members-30d: 0, total-channels: 0,
        total-messages-30d: 0, storage-used-mb: 0, storage-limit-mb: 0,
    };
    in-out property <string> org-invite-email: "";
    in property <bool> org-invite-loading: false;
    in property <string> org-invite-error: "";
    in property <string> org-invite-success: "";

    // ========== Toast notification properties ==========
    in-out property <bool> toast-visible: false;
    in property <string> toast-message: "";
    in property <string> toast-variant: "info";  // "success", "error", "warning", "info"

    // Org management callbacks
    callback org-load-members();
    callback org-load-settings();
    callback org-load-dashboard();
    callback org-invite-member(string, string);
    callback org-remove-member(string);
    callback org-update-member-role(string, string);

    // ========== Chat callbacks ==========
    callback search-clicked();
    callback chat-settings-clicked();
    callback invite-member();
    callback members-panel-toggle();
    callback member-clicked(string);  // user-id
    callback message-clicked(string);
    callback reply-clicked(string, string);  // (sender_id, timestamp_ns)
    callback react-clicked(string, string);  // (sender_id, timestamp_ns)
    callback thread-clicked(string);
    callback more-clicked(string, string, length, length);  // (sender_id, timestamp_ns, x, y)
    callback view-attachment(string);  // attachment ID - for viewing/opening attachments
    callback audio-seek(string, float);  // attachment ID, position 0.0-1.0
    callback load-more();
    callback send(string);
    callback send-edit(string, string);  // (message_id, new_text)
    callback cancel-edit();
    callback cancel-reply();
    callback attachment-clicked();
    callback emoji-clicked();
    callback gif-clicked();
    callback mention-triggered(string);
    callback remove-attachment(string);
    callback typing-changed(bool);  // true when started typing, false when stopped
    callback process-text(string) -> string;  // Insert word breaks for text wrapping
    callback format-text(string);  // Apply formatting: "bold", "italic", "code", "strikethrough"
    callback scroll-to-bottom-clicked();  // Emitted when scroll-to-bottom button is clicked
    callback start-voice-call();  // Start voice call in current channel
    callback start-video-call();  // Start video call in current channel

    // ========== Modal callbacks ==========
    // Create channel (name, description, template, ai_provider, ai_model)
    callback create-channel(string, string, string, CreateChannelConfig, string, string);
    callback create-channel-provider-selected(string);
    // Private group creation
    callback create-private-group(string, [PrivateGroupFriend]);
    callback toggle-friend-selection(int);
    callback toggle-friend-role(int);  // toggle role between member/admin
    callback create-channel-template-selected(string);
    // Invite to private group
    callback invite-to-private-group([PrivateGroupFriend]);
    callback toggle-invite-friend-selection(int);
    callback toggle-invite-friend-role(int);  // toggle role for invite modal

    // Create/rename section
    callback create-section(/* name */ string, /* emoji */ string);
    callback rename-section(/* section-id */ string, /* name */ string, /* emoji */ string);

    // Join channel
    callback search-channels(string);
    callback join-channel(string);

    // User profile
    callback profile-send-message();
    callback profile-add-friend();
    callback profile-remove-friend();
    callback profile-block-user();
    callback profile-unblock-user();
    callback profile-edit-profile();
    callback profile-view-safety-number();
    callback profile-toggle-verified();
    callback edit-profile-save(string, string);
    callback edit-profile-change-avatar();

    // Friend requests (legacy)
    callback friend-requests-switch-tab(string);
    callback friend-request-accept(string);
    callback friend-request-decline(string);
    callback friend-request-cancel(string);

    // Friends modal (comprehensive)
    callback friends-modal-switch-tab(string);
    callback friends-modal-switch-requests-sub-tab(string);
    callback friends-view-profile(string);
    callback friends-start-dm(string);
    callback friends-remove-friend(string);
    callback friends-search-users(string);
    callback friends-send-request(string);
    callback friends-accept-request(string);
    callback friends-decline-request(string);
    callback friends-cancel-request(string);
    callback friends-unblock-user(string);
    // Friend code callbacks (privacy-first discovery)
    callback friends-generate-code(bool);   // bool = private mode
    callback friends-generate-qr(bool);     // bool = private mode
    callback friends-copy-code();
    callback friends-connect-via-code(string);
    callback friends-connect-private(string);  // Private anon DM (no server)
    callback friends-accept-private-request(string);   // Accept anon DM request
    callback friends-decline-private-request(string);  // Decline anon DM request
    callback friends-block-private-request(string);    // Block anon DM request
    callback friends-accept-group-invite(string);      // Accept anon group invite
    callback friends-decline-group-invite(string);     // Decline anon group invite
    // Message requests (anon DM)
    callback message-requests-clicked();
    // Group invites (anon groups)
    callback group-invites-clicked();

    // Forward message
    callback forward-message(string);

    // Sessions
    callback revoke-session(int);
    callback revoke-all-sessions();

    // Search
    callback search-messages(string);
    callback search-result-clicked(string);
    callback search-toggle-scope();

    // Settings
    callback settings-edit-profile();
    callback settings-change-password(string, string);
    callback settings-view-sessions();
    callback settings-logout();
    callback settings-delete-account();
    callback settings-read-receipts-changed(bool);
    callback settings-typing-indicators-changed(bool);
    callback settings-copy-fingerprint();
    callback settings-sealed-sender-changed(bool);
    callback settings-refresh-keys();
    callback settings-change-pin(string, string);  // current_pin, new_pin
    callback settings-retry-backup(string);  // pin

    // AI settings callbacks
    callback settings-local-ai-enabled-changed(bool);
    callback settings-local-ai-load-model(string);
    callback settings-local-ai-unload-model();

    // ========== Channel settings callbacks ==========
    callback channel-settings-save(string, string);  // name, description
    callback channel-settings-toggle-setting(string, bool);  // setting-name, value
    callback channel-settings-change-notification(string);   // preference
    callback channel-settings-toggle-mute(bool);
    callback channel-settings-change-member-role(string, string);  // user-id, new-role
    callback channel-settings-remove-member(string);  // user-id
    callback channel-settings-invite-members();  // opens invite modal for private groups
    callback channel-settings-invite-channel-members();  // opens invite modal for regular channels
    callback invite-member-toggle-user(int);  // index - toggles selection
    callback invite-member-confirm();  // confirms invite for all selected users
    callback invite-member-search-changed(string);  // fired on every search keystroke
    callback channel-settings-archive();
    callback channel-settings-leave();
    callback channel-settings-delete();

    // ========== Call callbacks ==========
    callback calls-tab-clicked();  // mobile nav "Calls" tab — show call history
    callback accept-incoming-call(string);  // call_id
    callback decline-incoming-call(string); // call_id
    callback call-toggle-mute();
    callback call-toggle-video();
    callback call-toggle-screen-share();
    callback call-end();
    callback show-audio-device-picker();
    callback show-audio-output-picker();
    callback show-screen-source-picker();
    callback audio-device-selected(string);   // device_id
    callback audio-output-selected(string);   // device_id
    callback screen-source-selected(string);  // source_id

    // ========== Jarvis callbacks ==========
    callback jarvis-panel-close();
    callback jarvis-send(string);
    callback jarvis-clear();
    callback toggle-jarvis-panel();

    background: Colors.background;

    // ========== Responsive sidebar auto-collapse ==========
    // Auto-collapse sidebar on smaller screens (< 800px width)
    property <bool> is-small-screen: root.width < 800px;
    // Mobile layout: only on actual mobile devices (Android) with narrow screens.
    // Desktop narrow windows keep the collapsed sidebar instead of going fullscreen.
    property <bool> is-mobile-screen: root.is-mobile-platform && root.width < 480px;
    // Track whether the user manually toggled collapse (vs auto-collapse on resize)
    property <bool> sidebar-user-collapsed: false;

    // Update sidebar collapsed/hidden state when screen size changes
    changed is-small-screen => {
        if (root.is-small-screen && !root.sidebar-collapsed) {
            // Auto-collapse on small screen — don't mark as user choice
            root.sidebar-collapsed = true;
        }
        if (!root.is-small-screen && root.sidebar-collapsed && !root.sidebar-user-collapsed) {
            // Auto-expand when screen grows, unless user explicitly collapsed
            root.sidebar-collapsed = false;
        }
    }
    changed is-mobile-screen => {
        if (root.is-mobile-screen) {
            // On mobile, sidebar visibility is controlled by mobile-active-tab
            // and has-active-conversation, not by sidebar-hidden
            root.sidebar-hidden = true;
            root.mobile-active-tab = "chats";
        } else {
            root.sidebar-hidden = false;
        }
    }

    // ========== Global keyboard shortcuts ==========
    FocusScope {
        width: 0;
        height: 0;
        enabled: root.current-view == "main";

        key-pressed(event) => {
            // Ctrl+J: Toggle Jarvis panel
            if (event.modifiers.control && event.text == "j") {
                root.jarvis-panel-visible = !root.jarvis-panel-visible;
                return accept;
            }
            // Ctrl+K: Open quick switcher
            if (event.modifiers.control && event.text == "k") {
                root.quick-switcher-query = "";
                root.quick-switcher-selected-index = 0;
                root.active-modal = "quick-switcher";
                root.quick-switcher-opened();
                return accept;
            }
            // Ctrl+F: Open search
            if (event.modifiers.control && event.text == "f") {
                root.active-modal = "search";
                return accept;
            }
            // Ctrl+,: Open settings
            if (event.modifiers.control && event.text == ",") {
                root.active-modal = "settings";
                return accept;
            }
            // Ctrl+/: Toggle keyboard shortcuts help
            if (event.modifiers.control && event.text == "/") {
                root.active-modal = root.active-modal == "keyboard-shortcuts" ? "none" : "keyboard-shortcuts";
                return accept;
            }
            // Escape: Close active modal or overlay
            if (event.text == Key.Escape) {
                if (root.active-modal != "none") {
                    root.active-modal = "none";
                    return accept;
                }
            }
            reject
        }
    }

    // ========== Main content layer ==========
    // Explicit sizing ensures width flows to all child components for text wrapping.
    // Safe area: content inset below status bar; bottom nav extends into gesture area.
    Rectangle {
        width: root.width;
        height: root.height - root.safe-area-top;
        y: root.safe-area-top;

        // Loading page
        if current-view == "loading": LoadingPage {
            message: root.loading-message;
            secondary-message: root.loading-secondary-message;
        }

        // Login page
        if current-view == "login": LoginPage {
        sso-login(server-url, issuer-url, client-id) => { root.sso-login(server-url, issuer-url, client-id); }
            username <=> root.login-username;
            password <=> root.login-password;
            pin <=> root.login-pin;
            loading: root.login-loading;
            error: root.login-error;

            login(u, p, s, pin) => {
                root.login(u, p, s, pin);
            }
            register => {
                root.go-to-register();
            }
            go-to-recovery => {
                root.go-to-recovery();
            }
        }

        // Register page
        if current-view == "register": RegisterPage {
            display-name <=> root.register-display-name;
            username <=> root.register-username;
            password <=> root.register-password;
            confirm-password <=> root.register-confirm-password;
            pin <=> root.register-pin;
            server-url <=> root.register-server-url;
            loading: root.register-loading;
            error: root.register-error;
            avatar-source: root.register-avatar-source;
            has-avatar: root.register-has-avatar;
            selected-default-idx <=> root.register-selected-default-idx;
            username-status: root.register-username-status;
            password-strength: root.register-password-strength;
            pin-strength: root.register-pin-strength;

            register(u, p, d, pin, s) => {
                root.register(u, p, d, pin, s);
            }
            check-username(u) => {
                root.register-check-username(u);
            }
            password-changed(p) => {
                root.register-password-changed(p);
            }
            pin-changed(p) => {
                root.register-pin-changed(p);
            }
            select-avatar => {
                root.register-select-avatar();
            }
            select-default-avatar(idx) => {
                root.register-select-default-avatar(idx);
            }
            go-to-login => {
                root.go-to-login();
            }
        }

        // Account recovery page
        if current-view == "recovery": AccountRecoveryPage {
            username <=> root.recovery-username;
            recovery-code <=> root.recovery-code;
            new-password <=> root.recovery-new-password;
            confirm-password <=> root.recovery-confirm-password;
            new-pin <=> root.recovery-new-pin;
            loading: root.recovery-loading;
            error: root.recovery-error;
            success: root.recovery-success;

            recover(u, code, pw, pin) => {
                root.recover-account(u, code, pw, pin);
            }
            go-to-login => {
                root.go-to-login();
            }
        }

        // Welcome page (shown after first registration)
        if current-view == "welcome": WelcomePage {
            display-name: root.user-display-name;
            add-friends => { root.welcome-add-friends(); }
            browse-channels => { root.welcome-browse-channels(); }
            get-started => { root.welcome-get-started(); }
        }

        // Main chat layout
        // On mobile, leave room for the bottom nav + safe area; on desktop, subtract safe-area-bottom
        if current-view == "main": VerticalLayout {
            width: 100%;
            height: root.is-mobile-screen && !root.keyboard-open
                ? parent.height - Spacing.bottom-nav-height - root.safe-area-bottom
                : parent.height - root.safe-area-bottom;

            // Connection status banner (auto-hides when connected)
            ConnectionBanner {
                connection-state: root.connection-status;
                reconnect-attempt: root.connection-reconnect-attempt;
                queue-count: root.connection-queue-count;
            }

            HorizontalLayout {
                vertical-stretch: 1;

            // Sidebar (width controlled by collapsed state; mobile-mode for full-width)
            Sidebar {
                // On mobile: show full-width chat list when Chats tab is active and no conversation open
                mobile-mode: root.is-mobile-screen && root.mobile-active-tab == "chats" && !root.has-active-conversation;
                mobile-width: root.width;
                channels: root.channels;
                dm-conversations: root.dm-conversations;
                private-groups: root.private-groups;
                custom-sections: root.custom-sections;
                section-conversations: root.section-conversations;
                user-display-name: root.user-display-name;
                user-avatar-source: root.user-avatar-source;
                user-initials: root.user-initials;
                user-presence-status: root.user-presence-status;
                user-custom-status: root.user-custom-status;
                collapsed: root.is-mobile-screen ? false : (root.is-small-screen || root.sidebar-collapsed);
                hidden: root.is-mobile-screen ? (root.mobile-active-tab != "chats" || root.has-active-conversation) : root.sidebar-hidden;
                pending-friend-requests: root.friends-received-requests.length;
                pending-message-requests: root.pending-message-requests;
                pending-group-invites: root.pending-group-invites;
                current-org-name: root.current-org-name;
                current-org-initial: root.current-org-initial;
                organizations: root.organizations;
                org-loading: root.org-loading;

                channel-selected(id) => {
                    root.channel-selected(id);
                }
                dm-selected(id) => {
                    root.dm-selected(id);
                }
                private-group-selected(id) => {
                    root.private-group-selected(id);
                }
                saved-messages-clicked => {
                    root.saved-messages-clicked();
                }
                friends-clicked => {
                    root.active-modal = "friends";
                }
                message-requests-clicked => {
                    // Open friends modal with requests tab and private sub-tab selected
                    root.friends-modal-tab = "requests";
                    root.friends-requests-sub-tab = "private";
                    root.active-modal = "friends";
                    root.message-requests-clicked();
                }
                group-invites-clicked => {
                    // Open friends modal with requests tab and groups sub-tab selected
                    root.friends-modal-tab = "requests";
                    root.friends-requests-sub-tab = "groups";
                    root.active-modal = "friends";
                    root.group-invites-clicked();
                }
                profile-clicked => {
                    root.profile-clicked();
                }
                create-channel-clicked => {
                    root.active-modal = "create-channel";
                    root.open-create-channel();
                }
                join-channel-clicked => {
                    root.active-modal = "join-channel";
                    root.open-join-channel();
                }
                toggle-collapsed => {
                    // Track user's explicit collapse choice for smart auto-expand
                    root.sidebar-user-collapsed = !root.sidebar-collapsed;
                    root.toggle-sidebar();
                }
                org-selected(org-id) => {
                    root.org-selected(org-id);
                }
                manage-org-clicked => {
                    root.manage-org-clicked();
                }
                create-section-clicked => {
                    root.create-section-rename-mode = false;
                    root.create-section-name = "";
                    root.create-section-emoji = "📁";
                    root.create-section-id = "";
                    root.active-modal = "create-section";
                }
                section-toggle-expanded(id) => {
                    root.section-toggle-expanded(id);
                }
                section-conversation-selected(conv-id, conv-type) => {
                    root.section-conversation-selected(conv-id, conv-type);
                }
                delete-section-clicked(id) => {
                    root.delete-section-clicked(id);
                }
                rename-section-clicked(id) => {
                    root.create-section-rename-mode = true;
                    root.create-section-id = id;
                    // Rust side should set name/emoji before opening
                    root.rename-section-clicked(id);
                    root.active-modal = "create-section";
                }
                move-to-section(conv-id, conv-type, section-id) => {
                    root.move-to-section(conv-id, conv-type, section-id);
                }
                remove-from-section(conv-id) => {
                    root.remove-from-section(conv-id);
                }
                search-clicked => {
                    root.search-clicked();
                }
                jarvis-clicked => {
                    root.jarvis-panel-visible = !root.jarvis-panel-visible;
                    if !root.jarvis-panel-visible {
                        root.jarvis-panel-close();
                    }
                }
                settings-clicked => {
                    root.active-modal = "settings";
                    root.settings-clicked();
                }
            }

            // Right side area (Chat + Panels)
            // On mobile: hidden when sidebar is showing full-width (chat list view)
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                visible: root.is-mobile-screen ? root.has-active-conversation : true;
                // Clip this area to prevent inner panels from overflowing the whole app
                clip: true;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    // Chat column: call dock (when active) on top of ChatLayout.
                    // The dock collapses to 0px when no call is active so the chat
                    // layout fills the full space. On mobile, hide the whole column
                    // when a side panel (members/thread) is open.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        visible: !(root.is-mobile-screen && (root.members-panel-visible || root.thread-panel-visible));

                        ActiveCallView {
                            vertical-stretch: 0;
                            show: root.active-call-visible;
                            call-data: root.active-call-data;
                            is-muted: root.call-is-muted;
                            is-video-enabled: root.call-is-video-enabled;
                            is-screen-sharing: root.call-is-screen-sharing;
                            local-video-frame: root.call-local-video-frame;
                            remote-video-frames: root.call-remote-video-frames;

                            toggle-mute => { root.call-toggle-mute(); }
                            toggle-video => { root.call-toggle-video(); }
                            toggle-screen-share => {
                                if root.call-is-screen-sharing {
                                    root.call-toggle-screen-share();
                                } else {
                                    root.show-screen-source-picker();
                                }
                            }
                            end-call => { root.call-end(); }
                            show-audio-settings => { root.show-audio-device-picker(); }
                        }

                    ChatLayout {
                    vertical-stretch: 1;
                    visible: !(root.is-mobile-screen && (root.members-panel-visible || root.thread-panel-visible));
                    hide-header: root.active-call-visible;
                    show-back-button: root.is-mobile-screen;
                    back-clicked => { root.mobile-back(); }
                    channel-id: root.channel-id;
                    channel-name: root.channel-name;
                    channel-type: root.channel-type;
                    is-dm: root.is-dm;
                    member-count: root.member-count;
                    topic: root.topic;
                    is-archived: root.is-archived;
                    typing-indicator: root.typing-indicator;
                    presence-status: root.header-presence-status;
                    jarvis-thinking: root.jarvis-thinking;
                    messages: root.messages;
                    loading-messages: root.loading-messages;
                    scroll-to-message-index: root.scroll-to-message-index;
                    message-scroll-position <=> root.message-scroll-position;
                    should-auto-scroll: root.should-auto-scroll;
                    current-playing-attachment-id: root.current-playing-attachment-id;
                    is-media-playing: root.is-media-playing;
                    audio-progress: root.audio-progress;
                    audio-elapsed: root.audio-elapsed;
                    composer-text <=> root.composer-text;
                    composer-placeholder: root.composer-placeholder;
                    composer-disabled: root.composer-disabled;
                    pending-attachments: root.pending-attachments;
                    composer-is-editing <=> root.composer-is-editing;
                    composer-edit-message-id <=> root.composer-edit-message-id;
                    composer-is-replying: root.composer-is-replying;
                    composer-reply-to-sender-name: root.composer-reply-to-sender-name;
                    composer-reply-preview: root.composer-reply-preview;
                    composer-reply-has-thumbnail: root.composer-reply-has-thumbnail;
                    composer-reply-thumbnail: root.composer-reply-thumbnail;

                    // Picker state
                    emoji-picker-visible <=> root.composer-emoji-picker-visible;
                    gif-picker-visible <=> root.composer-gif-picker-visible;
                    emoji-list: root.composer-emoji-list;
                    emoji-category: root.composer-emoji-category;
                    emoji-search: root.composer-emoji-search;
                    gif-loading: root.composer-gif-picker-loading;
                    gif-results: root.composer-gif-picker-results;
                    gif-search-query: root.composer-gif-picker-search;

                    search-clicked => { root.search-clicked(); }
                    settings-clicked => { root.chat-settings-clicked(); }
                    voice-call-clicked => { root.start-voice-call(); }
                    video-call-clicked => { root.start-video-call(); }
                    invite-clicked => { root.invite-member(); }
                    members-clicked => {
                        root.members-panel-visible = !root.members-panel-visible;
                        if root.members-panel-visible {
                            root.members-panel-toggle();
                        }
                    }

                    // Pinned bar (Telegram-style)
                    has-pinned-messages: root.has-pinned-messages;
                    pinned-message-preview: root.pinned-message-preview;
                    pinned-current-index: root.pinned-current-index;
                    pinned-total-count: root.pinned-total-count;
                    pinned-prev-clicked => { root.pinned-prev-clicked(); }
                    pinned-next-clicked => { root.pinned-next-clicked(); }
                    pinned-go-to-message => { root.pinned-go-to-message(); }
                    pinned-dismiss-clicked => { root.pinned-dismiss-clicked(); }
                    pinned-show-clicked => { root.pinned-show-clicked(); }
                    message-clicked(id) => { root.message-clicked(id); }
                    reply-clicked(sender-id, timestamp-ns) => { root.reply-clicked(sender-id, timestamp-ns); }
                    react-clicked(sender-id, timestamp-ns) => {
                        root.reaction-picker-sender-id = sender-id;
                        root.reaction-picker-timestamp-ns = timestamp-ns;
                        root.reaction-picker-visible = true;
                        root.react-clicked(sender-id, timestamp-ns);
                    }
                    thread-clicked(id) => { root.thread-clicked(id); }
                    more-clicked(sender-id, timestamp-ns, x, y) => { root.more-clicked(sender-id, timestamp-ns, x, y); }
                    view-attachment(id) => { root.view-attachment(id); }
                    audio-seek(id, pos) => { root.audio-seek(id, pos); }
                    load-more => { root.load-more(); }
                    send(text) => { root.send(text); }
                    send-edit(msg-id, text) => { root.send-edit(msg-id, text); }
                    cancel-edit => { root.cancel-edit(); }
                    cancel-reply => { root.cancel-reply(); }
                    attachment-clicked => { root.attachment-clicked(); }
                    emoji-clicked => { root.emoji-clicked(); }
                    gif-clicked => { root.gif-clicked(); }
                    
                    // Picker callbacks
                    emoji-selected(emoji) => { root.composer-emoji-selected(emoji); }
                    emoji-category-changed(cat) => { 
                        root.composer-emoji-category = cat;
                        root.composer-emoji-category-changed(cat); 
                    }
                    emoji-search-changed(q) => { 
                        root.composer-emoji-search = q;
                        root.composer-emoji-search-changed(q); 
                    }
                    gif-selected(id, url) => { root.composer-gif-selected(id, url); }
                    gif-search(q) => {
                        root.composer-gif-picker-search = q;
                        root.composer-gif-search-changed(q);
                    }

                    mention-triggered(query) => { root.mention-triggered(query); }
                    remove-attachment(id) => { root.remove-attachment(id); }
                    typing-changed(is-typing) => { root.typing-changed(is-typing); }
                    process-text(text) => { return root.process-text(text); }
                    format-text(fmt) => { root.format-text(fmt); }
                    scroll-to-bottom-clicked => { root.scroll-to-bottom-clicked(); }
                }
                    } // end VerticalLayout (call dock + ChatLayout)

                // Members panel (side panel on desktop, full-screen overlay on mobile)
                if root.members-panel-visible: MembersPanel {
                    width: root.is-mobile-screen ? root.width : 280px;
                    height: 100%;
                    members: root.members-panel-members;
                    channel-name: root.channel-name;

                    close-clicked => {
                        root.members-panel-visible = false;
                    }
                    member-clicked(uid) => {
                        root.member-clicked(uid);
                    }
                }

                // Thread panel (side panel on desktop, full-screen overlay on mobile)
                if root.thread-panel-visible: ThreadPanel {
                    width: root.is-mobile-screen ? root.width : 320px;
                    height: 100%;
                    root-message-id: root.thread-root-message-id;
                    root-sender-name: root.thread-root-sender-name;
                    root-content-preview: root.thread-root-content-preview;
                    reply-count: root.thread-reply-count;
                    channel-name: root.thread-channel-name;
                    replies: root.thread-replies;
                    loading: root.thread-loading;
                    composer-text <=> root.thread-composer-text;

                    close-clicked => { root.close-thread-clicked(); }
                    send-reply(text) => { root.send-thread-reply(text); }
                    load-more-replies => { root.load-more-thread-replies(); }
                    message-clicked(id) => { root.message-clicked(id); }
                    react-clicked(sender-id, timestamp-ns) => {
                        root.reaction-picker-sender-id = sender-id;
                        root.reaction-picker-timestamp-ns = timestamp-ns;
                        root.reaction-picker-visible = true;
                        root.react-clicked(sender-id, timestamp-ns);
                    }
                }

            }
        }
        } // end inner HorizontalLayout (sidebar + chat)
        } // end VerticalLayout (banner + chat area)

    // Mobile bottom navigation bar (absolute positioned, pinned to bottom, extends into gesture area)
    if root.current-view == "main" && root.is-mobile-screen && !root.keyboard-open: MobileBottomNav {
        y: parent.height - self.height;
        width: 100%;
        active-tab: root.mobile-active-tab;
        chats-badge: root.total-unread-count;
        contacts-badge: root.friends-received-requests.length;
        safe-area-bottom: root.safe-area-bottom;

        tab-selected(tab) => {
            root.mobile-active-tab = tab;
            if (tab == "calls") {
                root.calls-tab-clicked();
            }
            if (tab == "contacts") {
                root.active-modal = "friends";
            }
            if (tab == "settings") {
                root.active-modal = "settings";
                root.settings-clicked();
            }
        }
    }

    // ========== Jarvis AI floating panel ==========
    // Floating panel that appears on top of chat when toggled
    if root.jarvis-panel-visible: Rectangle {
        x: parent.width - min(380px, parent.width - 16px);
        y: 60px;
        width: min(360px, parent.width - 32px);
        height: parent.height - 120px;
        background: Colors.surface;
        border-radius: Spacing.radius-lg;
        drop-shadow-blur: 20px;
        drop-shadow-color: Colors.background.with-alpha(0.5);
        drop-shadow-offset-x: -4px;
        drop-shadow-offset-y: 4px;

        JarvisPanel {
            width: 100%;
            height: 100%;
            panel-visible: root.jarvis-panel-visible;
            thinking: root.jarvis-thinking;
            messages: root.jarvis-messages;
            current-response: root.jarvis-response;

            close => {
                root.jarvis-panel-visible = false;
                root.jarvis-panel-close();
            }
            send(text) => { root.jarvis-send(text); }
            clear => { root.jarvis-clear(); }
        }
    }

    // ========== Modal overlay layer ==========
    // Semi-transparent backdrop when any modal is active
    if active-modal != "none" && active-modal != "settings": Rectangle {
        background: Colors.background.with-alpha(0.5);

        // Block clicks from reaching content below
        TouchArea {
            clicked => {
                // Close modal when clicking backdrop
                root.active-modal = "none";
            }
        }
    }

    // Create Channel Modal
    CreateChannelModal {
        show-modal: root.active-modal == "create-channel";
        channel-name <=> root.create-channel-name;
        channel-description <=> root.create-channel-description;
        selected-template <=> root.create-channel-template;
        error-message: root.create-channel-error;
        loading: root.create-channel-loading;
        ai-provider <=> root.create-channel-ai-provider;
        ai-model <=> root.create-channel-ai-model;
        ai-models: root.create-channel-ai-models;
        ai-models-loading: root.create-channel-ai-models-loading;
        ai-models-error: root.create-channel-ai-models-error;
        available-friends <=> root.create-channel-available-friends;
        selected-friend-count <=> root.create-channel-selected-friend-count;
        icon-url <=> root.create-channel-icon-url;
        icon-preview <=> root.create-channel-icon-preview;
        has-icon-preview <=> root.create-channel-has-icon-preview;

        close => {
            root.active-modal = "none";
        }
        create(name, desc, template, config, ai-provider, ai-model) => {
            root.create-channel(name, desc, template, config, ai-provider, ai-model);
        }
        provider-selected(provider) => {
            root.create-channel-provider-selected(provider);
        }
        pick-channel-icon => {
            root.create-channel-pick-icon();
        }
        create-private-group(name, friends) => {
            root.create-private-group(name, friends);
        }
        toggle-friend-selection(idx) => {
            root.toggle-friend-selection(idx);
        }
        toggle-friend-role(idx) => {
            root.toggle-friend-role(idx);
        }
        template-selected(template) => {
            root.create-channel-template-selected(template);
        }
    }

