                highlighted-message-id : root.highlighted-message-id;
                history-load-failed <=> root.history-load-failed;
                identity-change-attributed : root.identity-change-attributed;
                identity-change-detail : root.identity-change-detail;
                identity-change-title : root.identity-change-title;
                identity-change-visible : root.identity-change-visible;
                insert-serial : root.insert-serial;
                inserted-emoji : root.inserted-emoji;
