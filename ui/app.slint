    // Keyboard shortcuts help dialog
    if active-modal == "keyboard-shortcuts": Rectangle {
        width: root.width;
        height: root.height;
        background: Colors.overlay;

        TouchArea {
            clicked => { root.active-modal = "none"; }
        }

        Rectangle {
            width: min(420px, parent.width - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: min(shortcuts-layout.preferred-height, parent.height - 48px);
            background: Colors.surface;
            border-radius: Spacing.radius-lg;
            accessible-role: groupbox;
            accessible-description: "Keyboard shortcuts";

            TouchArea {} // block click-through

            shortcuts-layout := VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;

                // Header
                HorizontalLayout {
                    Text {
                        text: "Keyboard Shortcuts";
                        color: Colors.text-primary;
                        font-size: Typography.lg;
                        font-weight: Typography.semibold;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Spacing.radius-sm;
                        background: shortcut-close.has-hover ? Colors.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Close";

                        Text {
                            text: "\u{2715}";
                            color: Colors.text-secondary;
                            font-size: Typography.base;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%; height: 100%;
                        }

                        shortcut-close := TouchArea {
                            clicked => { root.active-modal = "none"; }
                        }
                    }
                }

                Rectangle { height: 1px; background: Colors.surface-hover; }

                // Navigation section
                Text {
                    text: "Navigation";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    font-weight: Typography.semibold;
                }

                for shortcut in [
                    { key: "Ctrl + F", action: "Search messages" },
                    { key: "Ctrl + ,", action: "Open settings" },
                    { key: "Ctrl + J", action: "Toggle AI assistant" },
                    { key: "Ctrl + /", action: "Show this dialog" },
                    { key: "Escape", action: "Close modal or panel" },
                ]: HorizontalLayout {
                    height: 28px;
                    spacing: Spacing.md;

                    Text {
                        text: shortcut.action;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: key-text.preferred-width + Spacing.md;
                        height: 24px;
                        border-radius: Spacing.radius-sm;
                        background: Colors.surface-hover;
                        border-width: 1px;
                        border-color: Colors.text-muted.with-alpha(0.2);

                        key-text := Text {
                            text: shortcut.key;
                            color: Colors.text-secondary;
                            font-size: Typography.xs;
                            font-weight: Typography.medium;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: Spacing.xs; }
            }
        }
    }

    // Settings screen (full screen overlay)
    if active-modal == "settings": SettingsScreen {
        display-name: root.settings-display-name;
        username: root.settings-username;
        avatar: root.settings-avatar;
        session-count: root.settings-session-count;
        current-password <=> root.settings-current-password;
        new-password <=> root.settings-new-password;
        confirm-password <=> root.settings-confirm-password;
        password-changing: root.settings-password-changing;
        password-error: root.settings-password-error;
        read-receipts-enabled <=> root.settings-read-receipts;
        typing-indicators-enabled <=> root.settings-typing-indicators;
        identity-fingerprint: root.settings-identity-fingerprint;
        sealed-sender-unrestricted <=> root.settings-sealed-sender-unrestricted;
        prekey-count: root.settings-prekey-count;
        // Security (PIN / Backup)
        change-pin-current <=> root.settings-change-pin-current;
        change-pin-new <=> root.settings-change-pin-new;
        change-pin-confirm <=> root.settings-change-pin-confirm;
        change-pin-loading: root.settings-change-pin-loading;
        change-pin-error: root.settings-change-pin-error;
        change-pin-success: root.settings-change-pin-success;
        backup-status: root.settings-backup-status;
        backup-retry-pin <=> root.settings-backup-retry-pin;
        backup-retry-loading: root.settings-backup-retry-loading;
        backup-retry-error: root.settings-backup-retry-error;
        // AI settings
        local-ai-enabled <=> root.settings-local-ai-enabled;
        local-ai-model-id <=> root.settings-local-ai-model-id;
        local-ai-loading: root.settings-local-ai-loading;
        local-ai-status: root.settings-local-ai-status;
        local-ai-error: root.settings-local-ai-error;

        edit-profile-clicked => {
            root.settings-edit-profile();
        }
        change-password(current, new) => {
            root.settings-change-password(current, new);
        }
        view-sessions-clicked => {
            root.active-modal = "sessions";
            root.settings-view-sessions();
        }
        logout-clicked => {
            root.settings-logout();
        }
        delete-account-clicked => {
            root.settings-delete-account();
        }
        close-settings => {
            root.active-modal = "none";
        }
        read-receipts-changed(value) => {
            root.settings-read-receipts-changed(value);
        }
        typing-indicators-changed(value) => {
            root.settings-typing-indicators-changed(value);
        }
        copy-fingerprint-clicked => {
            root.settings-copy-fingerprint();
        }
        sealed-sender-changed(value) => {
            root.settings-sealed-sender-changed(value);
        }
        refresh-keys-clicked => {
            root.settings-refresh-keys();
        }
        change-pin(current, new) => {
            root.settings-change-pin(current, new);
        }
        retry-backup(pin) => {
            root.settings-retry-backup(pin);
        }
        // AI callbacks
        local-ai-enabled-changed(value) => {
            root.settings-local-ai-enabled-changed(value);
        }
        local-ai-load-model(model-id) => {
            root.settings-local-ai-load-model(model-id);
        }
        local-ai-unload-model => {
            root.settings-local-ai-unload-model();
        }
    }

    // Org management screen (full screen overlay)
    if active-modal == "org-management": OrgManagementScreen {
        org-id: root.current-org-id;
        org-name: root.current-org-name;
        org-slug: root.current-org-slug;
        viewer-role: root.current-org-viewer-role;
        members: root.org-members;
        members-loading: root.org-members-loading;
        max-members: root.org-max-members;
        retention-days: root.org-retention-days;
        require-2fa: root.org-require-2fa;
        allow-guest-access: root.org-allow-guest-access;
        allowed-email-domains: root.org-allowed-email-domains;
        dashboard: root.org-dashboard;
        invite-email <=> root.org-invite-email;
        invite-loading: root.org-invite-loading;
        invite-error: root.org-invite-error;
        invite-success: root.org-invite-success;

        close => { root.active-modal = "none"; }
        load-members => { root.org-load-members(); }
        load-settings => { root.org-load-settings(); }
        load-dashboard => { root.org-load-dashboard(); }
        invite-member(email, role) => { root.org-invite-member(email, role); }
        remove-member(uid) => { root.org-remove-member(uid); }
        update-member-role(uid, role) => { root.org-update-member-role(uid, role); }
    }

    // ========== Call overlays (rendered above modals) ==========
    // Incoming call modal
    IncomingCallModal {
        show: root.incoming-call-visible;
        call-data: root.incoming-call-data;
        replaces-active: root.incoming-call-replaces-active;

        accept-call => {
            root.accept-incoming-call(root.incoming-call-data.call-id);
        }
        decline-call => {
            root.decline-incoming-call(root.incoming-call-data.call-id);
        }
    }

    // (Active call view is now docked above ChatLayout — see chat column block.)

    // Device picker modal (for audio devices and screen sources)
    DevicePicker {
        show: root.device-picker-visible;
        title: root.device-picker-type == "audio" ? "Select Microphone" :
               root.device-picker-type == "audio_output" ? "Select Speaker" : "Select Screen to Share";
        picker-type: root.device-picker-type;
        audio-devices: root.audio-devices;
        selected-audio-id: root.selected-audio-device-id;
        audio-output-devices: root.audio-output-devices;
        selected-audio-output-id: root.selected-audio-output-id;
        screen-sources: root.screen-sources;
        selected-screen-id: root.selected-screen-source-id;

        audio-selected(id) => {
            root.selected-audio-device-id = id;
            root.device-picker-visible = false;
            root.audio-device-selected(id);
        }
        audio-output-selected(id) => {
            root.selected-audio-output-id = id;
            root.device-picker-visible = false;
            root.audio-output-selected(id);
        }
        screen-selected(id) => {
            root.selected-screen-source-id = id;
            root.device-picker-visible = false;
            root.screen-source-selected(id);
        }
        closed => {
            root.device-picker-visible = false;
        }
    }

    // Image viewer overlay (rendered above modals)
    ImageViewer {
        show: root.image-viewer-visible;
        source: root.image-viewer-source;
        filename: root.image-viewer-filename;
        size-display: root.image-viewer-size;

        close => {
            root.image-viewer-visible = false;
            root.close-image-viewer();
        }
    }

    // Video player overlay (rendered above modals)
    VideoPlayer {
        show: root.video-player-visible;
        frame: root.video-player-frame;
        filename: root.video-player-filename;
        progress: root.video-player-progress;
        elapsed: root.video-player-elapsed;
        duration: root.video-player-duration;
        is-playing: root.video-player-is-playing;
        volume: root.video-player-volume;

        close => {
            root.video-player-visible = false;
            root.close-video-player();
        }
        toggle-play-pause => {
            root.video-player-toggle-play-pause();
        }
        seek(pos) => {
            root.video-player-seek(pos);
        }
        set-volume(vol) => {
            root.video-player-volume = vol;
            root.video-player-set-volume(vol);
        }
    }

    // Code preview overlay
    if root.code-preview-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: Colors.overlay-heavy;

        // Click backdrop to close
        TouchArea {
            clicked => {
                root.code-preview-visible = false;
                root.close-code-preview();
            }
        }

        // Centered code panel
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 80px, 900px);
            height: min(parent.height - 80px, 700px);

            // Block backdrop clicks
            TouchArea { }

            CodePreviewPanel {
                width: 100%;
                height: 100%;
                file-name: root.code-preview-filename;
                language: root.code-preview-language;
                line-count: root.code-preview-line-count;
                code-image: root.code-preview-image;
                plain-text: root.code-preview-plain-text;
                has-selection: root.code-preview-has-selection;
                selected-text: root.code-preview-selected-text;

                close-clicked => {
                    root.code-preview-visible = false;
                    root.close-code-preview();
                }

                copy-clicked => {
                    root.copy-code();
                }

                copy-selection-clicked => {
                    root.copy-code-selection();
                }

                open-external-clicked => {
                    root.code-preview-visible = false;
                    root.open-code-external();
                }

                pointer-down(x, y, shift, ctrl) => {
                    root.code-preview-pointer-down(x, y, shift, ctrl);
                }

                pointer-move(x, y) => {
                    root.code-preview-pointer-move(x, y);
                }

                pointer-up(x, y) => {
                    root.code-preview-pointer-up(x, y);
                }
            }
        }
    }

    // PDF preview overlay
    if root.pdf-preview-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: Colors.overlay-heavy;

        // Click backdrop to close
        TouchArea {
            clicked => {
                root.pdf-preview-visible = false;
                root.close-pdf-preview();
            }
        }

        // Centered PDF panel
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 900px);
            height: min(parent.height - 40px, 800px);

            // Block backdrop clicks
            TouchArea { }

            PdfPreviewPanel {
                width: 100%;
                height: 100%;
                file-name: root.pdf-preview-filename;
                page-count: root.pdf-preview-page-count;
                current-page: root.pdf-preview-current-page;
                error-message: root.pdf-preview-error;
                page-image: root.pdf-preview-image;

                close-clicked => {
                    root.pdf-preview-visible = false;
                    root.close-pdf-preview();
                }

                open-external-clicked => {
                    root.pdf-preview-visible = false;
                    root.open-pdf-external();
                }

                page-prev-clicked => {
                    root.pdf-page-prev();
                }

                page-next-clicked => {
                    root.pdf-page-next();
                }
            }
        }
    }

    // Reaction picker overlay
    ReactionPicker {
        show: root.reaction-picker-visible;
        message-id: root.reaction-picker-message-id;
        sender-id: root.reaction-picker-sender-id;
        timestamp-ns: root.reaction-picker-timestamp-ns;
        emoji-list: root.reaction-picker-emojis;
        selected-category <=> root.reaction-picker-selected-category;
        search-query <=> root.reaction-picker-search-query;
        position-x: root.width / 2 - 140px;  // Center horizontally
        position-y: root.height / 2 - 176px;  // Center vertically

        reaction-selected(sender-id, timestamp-ns, msg-id, emoji) => {
            root.reaction-picker-visible = false;
            root.reaction-selected(sender-id, timestamp-ns, msg-id, emoji);
        }

        category-changed(category) => {
            root.reaction-picker-category-changed(category);
        }

        search-changed(query) => {
            root.reaction-picker-search-changed(query);
        }

        close => {
            root.reaction-picker-visible = false;
        }
    }

    // Mention autocomplete overlay (positioned above composer cursor)
    MentionAutocomplete {
        show: root.mention-autocomplete-visible;
        suggestions: root.mention-suggestions;
        selected-index: root.mention-selected-index;
        max-popup-width: min(240px, root.width - 32px);
        // Position above the composer
        x: root.sidebar-hidden ? 16px : (root.sidebar-collapsed ? 80px : 280px);
        y: root.height - 80px - (Math.min(root.mention-suggestions.length, 8) * 40px + 16px);

        suggestion-selected(id, display) => {
            root.mention-autocomplete-visible = false;
            root.mention-suggestion-selected(id, display);
        }

        close => {
            root.mention-autocomplete-visible = false;
        }
    }

    // Message context menu overlay
    MessageContextMenu {
        show: root.context-menu-visible;
        sender-id: root.context-menu-sender-id;
        timestamp-ns: root.context-menu-timestamp-ns;
        position-x: root.context-menu-x;
        position-y: root.context-menu-y;
        is-own-message: root.context-menu-is-own-message;
        can-delete-for-everyone: root.context-menu-can-delete-for-everyone;
        is-pinned: root.context-menu-is-pinned;
        has-attachments: root.context-menu-has-attachments;

        close => {
            root.context-menu-visible = false;
        }
        reply-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.reply-message(sender-id, timestamp-ns);
        }
        edit-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.edit-message(sender-id, timestamp-ns);
        }
        delete-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.delete-message(sender-id, timestamp-ns);
        }
        delete-everyone-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.delete-everyone-message(sender-id, timestamp-ns);
        }
        pin-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.pin-message(sender-id, timestamp-ns);
        }
        forward-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.forward-message-action(sender-id, timestamp-ns);
        }
        copy-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.copy-message(sender-id, timestamp-ns);
        }
        download-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.download-message(sender-id, timestamp-ns);
        }
    }

    // Composer emoji picker overlay (positioned above composer)
    EmojiPicker {
        show: root.composer-emoji-picker-visible;
        emoji-list: root.composer-emoji-list;
        selected-category <=> root.composer-emoji-category;
        search-query <=> root.composer-emoji-search;
        selected-skin-tone <=> root.composer-emoji-skin-tone;
        max-picker-width: min(280px, root.width - 32px);
        max-picker-height: min(320px, root.height - 128px);

        // Position above the composer buttons (right side)
        x: root.width - self.width - Spacing.md;
        y: root.height - self.height - 80px;

        emoji-selected(emoji) => {
            root.composer-emoji-picker-visible = false;
            root.composer-emoji-selected(emoji);
        }
        category-changed(cat) => {
            root.composer-emoji-category-changed(cat);
        }
        search-changed(q) => {
            root.composer-emoji-search-changed(q);
        }
        skin-tone-changed(tone) => {
            root.composer-emoji-skin-tone-changed(tone);
        }
        close => {
            root.composer-emoji-picker-visible = false;
        }
        gif-mode-requested => {
            root.composer-emoji-picker-visible = false;
            root.composer-gif-picker-visible = true;
            root.gif-clicked();
        }
    }

    // Composer GIF picker overlay (positioned above composer)
    GifPicker {
        show: root.composer-gif-picker-visible;
        loading: root.composer-gif-picker-loading;
        results: root.composer-gif-picker-results;
        search-query <=> root.composer-gif-picker-search;
        max-picker-width: min(320px, root.width - 32px);
        max-picker-height: min(400px, root.height - 128px);

        // Position above the composer buttons (right side)
        x: root.width - self.width - Spacing.md;
        y: root.height - self.height - 80px;

        gif-selected(id, url) => {
            root.composer-gif-picker-visible = false;
            root.composer-gif-selected(id, url);
        }
        search(q) => {
            root.composer-gif-search-changed(q);
        }
        close => {
            root.composer-gif-picker-visible = false;
        }
        emoji-mode-requested => {
            root.composer-gif-picker-visible = false;
            root.composer-emoji-picker-visible = true;
            root.emoji-clicked();
        }
    }

    // ========== Toast notification overlay (top-right) ==========
    Toast {
        show-toast: root.toast-visible;
        message: root.toast-message;
        variant: root.toast-variant;
        max-toast-width: min(360px, root.width - 32px);

        x: root.width - self.width - Spacing.md;
        y: Spacing.lg + root.safe-area-top;

        dismissed => {
            root.toast-visible = false;
        }
    }

    // Auto-dismiss timer for toasts
    toast-timer := Timer {
        interval: 5s;
        running: root.toast-visible;
        triggered => {
            root.toast-visible = false;
        }
    }
    }

}
