    // ========== Call properties ==========
    in-out property <bool> incoming-call-visible: false;
    // Back while ringing hides the full-screen ring (Signal): the call keeps
    // ringing and the notification keeps Accept / Decline. Separate from
    // `incoming-call-visible`, which is "a call is ringing" to the call code.
    in-out property <bool> incoming-call-minimized: false;
    in property <IncomingCallData> incoming-call-data;
    /// True when a newly arrived incoming call will replace the active call
    /// if accepted — driven by the call orchestrator.
    in-out property <bool> incoming-call-replaces-active: false;
    in-out property <bool> active-call-visible: false;
    in-out property <string> active-channel-call-id: "";
    in-out property <bool> active-channel-call-video: false;
    in-out property <int> active-channel-call-participants: 0;
    // True when the call dock has been expanded to fill the chat column.
    // Bound to ActiveCallView.fullscreen. Hides the ChatLayout sibling.
    in-out property <bool> active-call-fullscreen: false;
    in property <ActiveCallData> active-call-data;
    in-out property <bool> call-is-muted: false;
    in-out property <bool> call-is-video-enabled: true;
    in-out property <bool> call-is-screen-sharing: false;
    // Android call audio route (platform/android/audio_route.rs). Desktop never
    // sets `call-speaker-toggle`, so its speaker button stays the output picker.
    in property <bool> call-speaker-toggle: false;
    in property <bool> call-speaker-on: false;
    callback call-toggle-speaker();
    // A call screen opened (true) or closed (false), and whether the local
    // camera is on at that moment; then camera changes mid-call.
    callback call-audio-session(bool, bool);
    callback call-audio-video(bool);
    changed active-call-visible => {
        if root.active-call-visible { VoiceRecording.cancel(); }
        root.call-audio-session(root.active-call-visible, root.call-is-video-enabled);
        // Fullscreen hides the sidebar and chat; left set after the call it
        // would hide them with nothing in their place.
        if !root.active-call-visible {
            root.active-call-fullscreen = false;
            // Back to where the user was before the call (Signal): if answering
            // raised the phone pane (`open_call_screen`), drop it again —
            // whatever chat was left behind it is stale, not where they were.
            // Every end path lands here.
            if root.call-raised-pane {
                root.call-raised-pane = false;
                root.mobile-show-chat = false;
            }
        }
    }
    // Set by `open_call_screen` (calls/incoming.rs) when answering raised the
    // phone pane over the list; the call's end lowers it again.
    in-out property <bool> call-raised-pane: false;
    // Leaving the pane (Back on a phone) leaves the call screen too; the
    // return-to-call bar then stands in for it. The user has navigated for
    // themselves, so the call's end no longer owes them a trip to the list.
    changed mobile-show-chat => {
        root.refresh-screen-protection();
        root.chat-push-progress = root.mobile-show-chat ? 1 : 0;
        if !root.mobile-show-chat {
            root.cancel-composer-keyboard-handover();
            root.active-call-fullscreen = false;
            root.call-raised-pane = false;
            // Once a TextInput has had focus, popping the screen it lived on leaves
            // NOTHING focused — and `WindowInner::process_key_input` delivers only to
            // the focus item and its ancestors, so Back is dropped on the floor. The
            // symptom was reproduced from a clean launch every time: open a
            // conversation, type ONE character, Back out to the list, and from then on
            // Back does nothing anywhere — it neither pops a layer nor backgrounds the
            // app, and only a force-stop recovers it (§112y). Re-take focus whenever
            // the conversation pane or a modal closes, which is when the focused text
            // field goes away.
            back-scope.focus();
            // The pickers belong to the conversation's composer; they are
            // app-level overlays, so leaving the chat has to close them or
            // they float over whatever screen comes next.
            root.composer-gif-picker-visible = false;
            root.composer-emoji-picker-visible = false;
            VoiceRecording.cancel();
            root.chat-pane-closed();
        }
    }
    changed call-is-video-enabled => {
        if root.active-call-visible {
            root.call-audio-video(root.call-is-video-enabled);
        }
    }
    in property <image> call-local-video-frame;
    in property <[image]> call-remote-video-frames;

