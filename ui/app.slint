                emoji-clicked() => { root.emoji-clicked(); }
                forward-message-action(arg0, arg1) => { root.forward-message-action(arg0, arg1); }
                gif-clicked() => { root.gif-clicked(); }
                go-to-login() => { root.go-to-login(); }
                group-invites-clicked() => { root.group-invites-clicked(); }
                identity-change-accept-clicked() => { root.identity-change-accept-clicked(); }
                invite-member() => { root.invite-member(); }
                leave-conversation(arg0, arg1) => { root.leave-conversation(arg0, arg1); }
                list-geometry(arg0, arg1, arg2) => { root.list-geometry(arg0, arg1, arg2); }
