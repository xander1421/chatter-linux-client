import { AppViewTransition } from "app_view_transition.slint";
import { AppCallLifecycle } from "app_call_lifecycle.slint";
import { AppModalTransitions } from "app_modal_transitions.slint";
import { JarvisPane } from "app_jarvis_pane.slint";
import { CallView } from "app_call_view.slint";
import { ModalHostState } from "app_modal_host_state.slint";
import { ChatPane } from "app_chat_pane.slint";
import { SidebarPane } from "app_sidebar_pane.slint";
import { SearchPane } from "app_search_pane.slint";
import { SettingsPane } from "app_settings_pane.slint";
import { AuthFlow } from "app_auth_flow.slint";
import { AppBottomChrome } from "app_bottom_chrome.slint";
import { AppShortcuts } from "app_shortcuts.slint";
import { AppTopOverlays } from "app_top_overlays.slint";
import { AppSettingsHost } from "app_settings_host.slint";
import { AppSecondaryModals } from "app_secondary_modals.slint";
import { AppTabScreens } from "app_tab_screens.slint";
import { AppModalHost } from "app_modal_host.slint";
import { ActivityUi } from "activity/activity_bell.slint";
import { ActivityGlobal, ActivityItemData } from "activity/activity_global.slint";
export { ActivityGlobal, ActivityItemData }
import { Materials } from "theme/materials.slint";
import { Appearance } from "theme/appearance.slint";
// Chatter window: the root component Rust binds as `MainWindow`.
// View routing, the modal overlay system, and Android Back handling.

import { Colors } from "theme/colors.slint";
import { Spacing } from "theme/spacing.slint";
import { Typography } from "theme/typography.slint";
import { VoiceRecording } from "chat/voice_recording.slint";
import { VirtualKeyboard } from "components/modal_container.slint";

// Import auth screens
import { AuthPages } from "auth_pages.slint";
import { MainChatShell } from "main_chat_shell.slint";
import { AvatarOption } from "components/avatar_picker.slint";

// Import main layout components
import { Sidebar, ChatRowData, CustomSectionData, SidebarRowData } from "sidebar/sidebar.slint";
import { ChatLayout, MessageItemData, MessageAttachmentData, PendingAttachmentData, ReactionEntry } from "chat/chat_layout.slint";
import { ConversationKind } from "chat/conversation_kind.slint";
import { SelectionBar } from "chat/selection_bar.slint";
import { EmojiData } from "components/emoji_picker.slint";
import { GifData } from "components/gif_picker.slint";
import { MentionSuggestion } from "components/mention_autocomplete.slint";

// Import modals
import { AIProviderOption, AIModelOption, CreateChannelConfig, PrivateGroupFriend } from "modals/create_channel.slint";
import { SharedContentItem, SharedTab } from "modals/mod.slint";
import { FriendData, FriendRequestData, ChannelInviteData, BlockedUserData } from "modals/friends.slint";
import { ForwardTarget } from "modals/forward_message.slint";
import { SessionInfo, PendingLinkInfo } from "modals/sessions.slint";
import { SearchResultChannel } from "modals/join_channel.slint";
import { ChannelMemberData, BannedMemberData } from "modals/channel_member_types.slint";
import { InviteUser } from "modals/invite_member.slint";
import { QuickSwitcherItem, SearchResult, CalendarDay } from "components/unified_search.slint";

// Import settings
import { LocalAIProviderData, CatalogModelData } from "settings/settings_screen.slint";
import { PinnedItem } from "modals/pinned_messages.slint";
export { PinnedItem }
import { MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData } from "modals/jarvis_memory.slint";

// Import components
import { EmojiData } from "components/mod.slint";
import { ToastOverlay } from "components/toast_overlay.slint";

// Import call UI
import { ActiveCallView, IncomingCallData, ActiveCallData, CallParticipantData, AudioDeviceData, ScreenSourceData, CallHistoryRow } from "calls/mod.slint";

// Import anon mode global + PIN modal
import { ShieldWash } from "anon_mode/shield_wash.slint";

// Re-export types for Rust binding
export { ChatRowData, CustomSectionData, SidebarRowData, MessageItemData, MessageAttachmentData, ForwardTarget, SessionInfo, PendingLinkInfo, SearchResultChannel, SearchResult, AIProviderOption, AIModelOption, CreateChannelConfig, PendingAttachmentData, EmojiData, GifData, MentionSuggestion, FriendData, FriendRequestData, ChannelInviteData, BlockedUserData, IncomingCallData, ActiveCallData, CallParticipantData, CallHistoryRow, AudioDeviceData, ScreenSourceData, ChannelMemberData, BannedMemberData, PrivateGroupFriend, LocalAIProviderData, CatalogModelData, MemoryFactData, MemoryEntityData, MemoryGraphNodeData, MemoryGraphEdgeData, InviteUser, ReactionEntry, QuickSwitcherItem, SharedContentItem, SharedTab }

export component MainWindow inherits Window {
    title: "Chatter";
    icon: @image-url("../assets/icon-256.png");
    // Responsive: allow narrow widths for phones (360dp minimum)
    min-width: 360px;
    min-height: 480px;
    preferred-width: 800px;
    preferred-height: 600px;
    default-font-family: Typography.font-family;
    default-font-size: Typography.sm;

    modal-transitions := AppModalTransitions { active-modal: root.active-modal; }
    AppCallLifecycle {}
    view-transition := AppViewTransition { current-view: root.current-view; }

    // ========== Safe area insets (Android status bar / nav bar / IME) ==========
    // Slint 1.15 splits two separate out-props on the Window:
    //   * `safe-area-insets`  — system bars only (status bar / nav bar).
    //   * `virtual-keyboard-size.height` — IME height when the keyboard is up.
    // The Android backend feeds them from `WindowInsets.Type.systemBars()` and
    // `WindowInsets.Type.ime()` respectively, so they must both be subtracted
    // from the content area to lift the composer above the keyboard.
    property <length> safe-area-top: root.safe-area-insets.top;
    property <length> safe-area-bottom: root.safe-area-insets.bottom
        + max(root.virtual-keyboard-size.height, root.composer-keyboard-reserve);
    private property <length> composer-keyboard-reserve: 0px;
    in-out property <float> remembered-keyboard-height-px: 0;
    in-out property <float> remembered-keyboard-width-px: 0;
    private property <bool> zero-inset-keyboard: false;
    property <length> drawer-keyboard-height: !root.zero-inset-keyboard
        && root.remembered-keyboard-height-px > 0
        && root.width > (root.remembered-keyboard-width-px - 32) * 1px
        && root.width < (root.remembered-keyboard-width-px + 32) * 1px
        ? root.remembered-keyboard-height-px * 1px : 0px;
    callback composer-keyboard-height-learned(float, float);
    public function cancel-composer-keyboard-handover() {
        root.composer-keyboard-reserve = 0px;
        keyboard-handover-timeout.stop();
        keyboard-handover-settle.stop();
    }
    function request-composer-keyboard(space: length) {
        if root.is-mobile-platform {
            root.composer-keyboard-reserve = space;
            keyboard-handover-timeout.start();
            keyboard-handover-timeout.restart();
        }
    }
    function watch-composer-keyboard() {
        if root.is-mobile-platform && root.virtual-keyboard-size.height <= 0px {
            keyboard-zero-inset-timeout.start();
            keyboard-zero-inset-timeout.restart();
        }
    }
    keyboard-zero-inset-timeout := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            if root.virtual-keyboard-size.height <= 0px && !root.composer-drawer-visible {
                root.zero-inset-keyboard = true;
            }
        }
    }
    keyboard-height-settle := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            if root.is-mobile-platform && !root.composer-drawer-visible
                && root.virtual-keyboard-size.height > 0px {
                root.remembered-keyboard-height-px = root.virtual-keyboard-size.height / 1px;
                root.remembered-keyboard-width-px = root.width / 1px;
                root.composer-keyboard-height-learned(
                    root.remembered-keyboard-height-px, root.remembered-keyboard-width-px);
            }
        }
    }
    // Keep the drawer's occupied space while the native keyboard is requested.
    // Its inset animation may end below drawer height; release after it settles.
    keyboard-handover-settle := Timer {
        interval: 120ms;
        running: false;
        triggered => { root.cancel-composer-keyboard-handover(); }
    }
    // A refused keyboard request must not leave an invisible permanent panel.
    keyboard-handover-timeout := Timer {
        interval: 1500ms;
        running: false;
        triggered => { root.cancel-composer-keyboard-handover(); }
    }

    // True on Android/iOS — set by Rust at startup. Means TOUCH INPUT: target
    // sizes, press-and-hold, no keyboard shortcuts. It does not pick the
    // layout; `compact-layout` does.
    in property <bool> is-mobile-platform: false;
    // Single pane + bottom tab bar + back button. Decided by logical width,
    // not by platform: a 1000dp+ tablet gets the two-pane desktop structure
    // (with touch-sized targets), a phone the stacked one. Material's compact
    // breakpoint is 600dp; 600-839dp is two-pane on the icon rail
    // (`is-small-screen`). Re-evaluated on every resize, so rotation and
    // split-screen switch live; `mobile-show-chat` and the open conversation
    // survive the switch. Out so Rust's Back handler can ask it.
    out property <bool> compact-layout: root.is-mobile-platform && root.width < 600px;
    // macOS only, both set by Rust once the native titlebar is made
    // transparent/unified (platform::macos::apply_unified_titlebar). 0 on
    // every other platform, which is what makes the bindings below no-ops
    // there.
    // The app does NOT reserve a row for the titlebar: the whole point of the
    // unified look is that the traffic lights sit *inside* the app's own top
    // row, level with the sidebar's first row and the conversation header —
    // one row, the way every native macOS chat app does it. So content runs
    // to y=0 and the only thing that moves is whatever would otherwise be
    // drawn beneath the lights themselves.
    in property <length> macos-titlebar-height: 0px;
    in property <length> macos-traffic-lights-width: 0px;
    // Leading clearance the conversation header has to add for itself: the
    // sidebar absorbs the traffic lights when it is wide enough, and the rail
    // (60px) is not. Zero whenever the panel already covers them.
    property <length> chat-traffic-lights-lead: max(0px, root.macos-traffic-lights-width
        - (root.sidebar-is-rail ? Spacing.sidebar-width-collapsed : Spacing.sidebar-width));
    // Keyboard is considered open when bottom inset exceeds the nav bar threshold
    property <bool> keyboard-open: safe-area-bottom > 80px;
    // Whether the mobile tab bar is on screen. The full-screen pages that leave
    // a strip for it (bottom-inset) must use this same condition: they used to
    // omit `mobile-show-chat` for Chats, so over an open chat the strip showed
    // the composer through the page. Other root tabs keep their bar even when
    // entered from a chat whose `mobile-show-chat` state is still set.
    // Settings is a pushed full-screen page, not a tab, so it covers the bar
    // the same way a pushed conversation does.
    property <bool> bottom-nav-visible: root.compact-layout && root.current-view == "main"
        // A mesh conversation is pushed over the Mesh tab the same way a
        // chat is over Chats (the tab click clears the flag), so it hides
        // the bar too; otherwise the bar covered its composer.
        && !root.keyboard-open
        && ((SidebarPane.active-tab != "chats" && SidebarPane.active-tab != "mesh") || !SidebarPane.mobile-show-chat)
        && !ModalHostState.settings-open;
    // The Chats tab's floating create button: only on the list itself, never
    // over a pushed screen, a dialog, the search palette or selection mode.
    property <bool> fab-visible: root.bottom-nav-visible && SidebarPane.active-tab == "chats"
        && root.active-modal == "none" && !SearchPane.unified-search-open && !ChatPane.selection-mode;
    // Its top edge: above the dock and, during a call, the return-to-call
    // bar stacked on it — the same strip the main column reserves for them.
    // In the main content layer's coordinates (it and the dock both live
    // there, below the status bar), not the window's: measuring from
    // root.height put it a status bar's height low, over the dock.
    property <length> return-to-call-height: 116px;
    property <length> fab-y: root.height - root.safe-area-top - root.safe-area-bottom
        - Spacing.fab-size - Spacing.xl
        - (Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom)
        - (CallView.active-call-visible ? root.return-to-call-height + Spacing.sm : 0px);

    // ========== View routing ==========
    // Views: "loading", "login", "register", "recovery", "main"
    in-out property <string> current-view: "loading";
    // ========== Connection status ==========
    // "connected", "connecting", "reconnecting", "disconnected", "failed".
    // Pushed from `bin_ui::features::connection`, which reads chatter-core's
    // `OfflineState` — kept honest by the reachability monitor in
    // `chatter-core/src/network/server_monitor.rs`, which is the only thing that
    // revises it after boot.
    in property <string> connection-status: "connected";
    in property <int> connection-reconnect-attempt: 0;

    // Whether chatter-core considers the server settled-unreachable
    // (`ConnectionState::is_unreachable`) — as opposed to a connect still being
    // in flight, where nothing should be claimed either way. One definition,
    // computed in core, so the auth screens and the banner cannot disagree.
    in property <bool> server-unreachable: false;

    private property <int> observed-activity-open-request: ActivityUi.open-request;
    changed observed-activity-open-request => {
        ModalHostState.nav-push("activity");
        ActivityGlobal.opened();
    }

    // ========== Working without an account ==========
    // Whether chatter-core says there is anything usable with no account
    // (`ChatterClient::has_account_free_surfaces` — in practice, a running
    // mesh). Gates the way past the sign-in screens; never guessed here.
    in property <bool> account-free-surfaces: false;
    // Whether there is a chatter session. False is a supported state of the main
    // view, not a transient one: a user who came in over the mesh has no account
    // and may never get one.
    // The ONE definition of "the panel is a rail right now". The Sidebar
    // collapses on either signal, so anything else deciding based on collapse
    // state has to read the same expression — checking `sidebar-collapsed`
    // alone reports "expanded" on a phone that is showing a rail, which removed
    // the entire chat column and left a blank screen.
    property <bool> sidebar-is-rail: root.is-small-screen || SidebarPane.sidebar-collapsed;
    // Both phone panes stay mounted until the push settles. The message list
    // therefore keeps its scroll position while the header and composer travel
    // with the conversation, and Back reverses the same movement.
    // Keep capture protection through the pane's reverse slide.
    out property <bool> chat-content-visible:
        !root.compact-layout || SidebarPane.mobile-show-chat || root.chat-push-progress > 0;
    changed chat-content-visible => { root.refresh-screen-protection(); }
    property <float> chat-push-progress: 0;
    animate chat-push-progress {
        duration: SidebarPane.chat-edge-swiping ? 0ms : Materials.motion-standard;
        easing: Materials.glide;
    }

    private property <int> reply-focus-serial: 0;

    private property <length> viewer-origin-x: 0px;
    private property <length> viewer-origin-y: 0px;
    private property <length> viewer-origin-width: 0px;
    private property <length> viewer-origin-height: 0px;

    private property <bool> observed-composer-gifs-available: ChatPane.composer-gifs-available;
    changed observed-composer-gifs-available => {
        if !ChatPane.composer-gifs-available { ChatPane.composer-gif-picker-visible = false; }
    }


    private property <length> context-menu-anchor-top: 0px;
    private property <length> context-menu-anchor-bottom: 0px;
    private property <length> context-menu-anchor-left: 0px;
    private property <length> context-menu-anchor-right: 0px;
    private property <MessageItemData> context-menu-preview-message;
    private property <length> context-menu-preview-row-x: 0px;
    private property <length> context-menu-preview-row-y: 0px;
    private property <length> context-menu-preview-row-width: 0px;
    private property <bool> context-menu-preview-mobile: false;
    private property <bool> context-menu-preview-from-thread: false;

    // The top of the stack, or "none". Each modal's `if` reads this.
    out property <string> active-modal: ModalHostState.modal-stack.length > 0
        ? ModalHostState.modal-stack[ModalHostState.modal-stack.length - 1] : "none";
    // Leaving the pane (Back on a phone) leaves the call screen too; the
    // return-to-call bar then stands in for it. The user has navigated for
    // themselves, so the call's end no longer owes them a trip to the list.
    private property <bool> observed-mobile-show-chat: SidebarPane.mobile-show-chat;
    changed observed-mobile-show-chat => {
        root.refresh-screen-protection();
        root.chat-push-progress = SidebarPane.mobile-show-chat ? 1 : 0;
        if !SidebarPane.mobile-show-chat {
            root.cancel-composer-keyboard-handover();
            CallView.active-call-fullscreen = false;
            CallView.call-raised-pane = false;
            // Back or an explicit tab switch chose a new route; ending the
            // call must not restore the route saved before Accept.
            CallView.call-route-saved = false;
            // Once a TextInput has had focus, popping the screen it lived on leaves
            // NOTHING focused — and `WindowInner::process_key_input` delivers only to
            // the focus item and its ancestors, so Back is dropped on the floor. The
            // symptom was reproduced from a clean launch every time: open a
            // conversation, type ONE character, Back out to the list, and from then on
            // Back does nothing anywhere — it neither pops a layer nor backgrounds the
            // app, and only a force-stop recovers it (§112y). Re-take focus whenever
            // the conversation pane or a modal closes, which is when the focused text
            // field goes away.
            back-scope.focus();
            // The pickers belong to the conversation's composer; they are
            // app-level overlays, so leaving the chat has to close them or
            // they float over whatever screen comes next.
            ChatPane.composer-gif-picker-visible = false;
            ChatPane.composer-emoji-picker-visible = false;
            VoiceRecording.cancel();
            root.chat-pane-closed();
        }
    }
    // ========== Toast notification properties ==========
    in-out property <bool> toast-visible: false;
    in-out property <int> secret-chat-starts-pending: 0;
    in property <string> toast-message: "";
    in property <string> toast-variant: "info";  // "success", "error", "warning", "info"

    // ========== Anon mode (PIN modal + toggle) ==========
    in-out property <string> anon-mode-pin: "";
    in property <string> anon-mode-pin-error: "";
    in property <bool> anon-mode-verifying: false;
    callback toggle-anon-mode();              // sidebar button → Rust handler
    callback submit-anon-mode-pin(string);    // PIN modal submit → Rust verify

    // Tablet panes share one page canvas behind their rounded chrome.
    // A tinted window behind the sidebar and an opaque chat beside it expose
    // a rectangular patch in the search/footer corner cutouts.
    background: root.is-mobile-platform && !root.compact-layout
        ? Colors.background : Materials.ambient;

    // ========== Responsive sidebar auto-collapse ==========
    // Auto-collapse sidebar on smaller screens (< 800px width)
    property <bool> is-small-screen: root.width < 800px;
    // Mobile layout: only on actual mobile devices (Android) with narrow screens.
    // Desktop narrow windows keep the collapsed sidebar instead of going fullscreen.
    // is-small-screen drives the collapse-by-default + full-width side-panels.
    // No separate "mobile-screen" mode — Android renders identically to a
    // narrow desktop window, per the user's "1-to-1 with desktop" preference.
    // Track whether the user manually toggled collapse (vs auto-collapse on resize)
    property <bool> sidebar-user-collapsed: false;

    // Update sidebar collapsed/hidden state when screen size changes
    changed is-small-screen => {
        if (root.is-small-screen && !SidebarPane.sidebar-collapsed) {
            // Auto-collapse on small screen — don't mark as user choice
            SidebarPane.sidebar-collapsed = true;
        }
        if (!root.is-small-screen && SidebarPane.sidebar-collapsed && !root.sidebar-user-collapsed) {
            // Auto-expand when screen grows, unless user explicitly collapsed
            SidebarPane.sidebar-collapsed = false;
        }
    }
    changed compact-layout => { root.refresh-screen-protection(); }

    // ========== Android back key ==========
    // Android's Activity calls this directly for hardware/gesture Back, even
    // when Slint has no focused item. The scope below also routes desktop
    // Back/Escape here. Navigation decisions live in features/back.rs.
    callback back-pressed();
    // Android asks core to recompute capture protection at navigation boundaries.
    callback refresh-screen-protection();
    // The phone's chat pane closed (Back, header back, a bottom tab): nothing
    // is on screen any more, so no conversation may stay "active".
    callback chat-pane-closed();

    // Give Slint keyboard shortcuts an initial focus target. Key input reaches
    // only the focused item and its ancestors; Android system Back is also
    // routed directly from MainActivity when no Slint item has focus.
    forward-focus: back-scope;

    private property <string> observed-channel-id: ChatPane.channel-id;
    changed observed-channel-id => {
        CallView.calls-more-menu-visible = false;
        root.cancel-composer-keyboard-handover();
        VoiceRecording.cancel();
        ChatPane.composer-emoji-picker-visible = false;
        ChatPane.composer-gif-picker-visible = false;
    }
    private property <string> inserted-emoji;
    private property <int> insert-serial;
    public function insert-composer-emoji(emoji: string) { root.inserted-emoji = emoji; root.insert-serial += 1; }
    private property <ConversationKind> observed-conversation-kind: ChatPane.conversation-kind;
    changed observed-conversation-kind => { CallView.calls-more-menu-visible = false; VoiceRecording.cancel(); }
    private property <bool> observed-selection-mode: ChatPane.selection-mode;
    changed observed-selection-mode => { if ChatPane.selection-mode { VoiceRecording.cancel(); } }
    private property <bool> observed-composer-is-editing: ChatPane.composer-is-editing;
    changed observed-composer-is-editing => { if ChatPane.composer-is-editing { VoiceRecording.cancel(); } }
    private property <string> observed-composer-text: ChatPane.composer-text;
    changed observed-composer-text => { ChatPane.composer-draft-changed(); }
    private property <string> observed-thread-composer-text: ChatPane.thread-composer-text;
    changed observed-thread-composer-text => { ChatPane.thread-draft-changed(); }
    private property <bool> observed-thread-panel-visible: ChatPane.thread-panel-visible;
    changed observed-thread-panel-visible => { VoiceRecording.cancel(); }
    private property <string> observed-thread-root: ChatPane.thread-root-message-id;
    changed observed-thread-root => { VoiceRecording.cancel(); }
    private property <string> observed-active-tab: SidebarPane.active-tab;
    changed observed-active-tab => { CallView.calls-more-menu-visible = false; CallView.call-history-selecting = false; root.cancel-composer-keyboard-handover(); VoiceRecording.cancel(); root.refresh-screen-protection(); }
    changed current-view => {
        root.refresh-screen-protection();
        CallView.calls-more-menu-visible = false;
        CallView.call-history-selecting = false;
        root.cancel-composer-keyboard-handover();
        VoiceRecording.cancel();
        back-scope.focus();
    }
    // Drop whatever text field holds focus (hiding the soft keyboard with it)
    // without leaving the window focus-less: Back keeps arriving at
    // back-scope. Called from Rust when Android's Back hid the keyboard
    // behind Slint's back (platform/android/activity.rs).
    in-out property <bool> composer-attachment-picker-open: false;
    private property <int> attachment-prepare-serial;
    private property <int> attachment-restore-serial;
    public function prepare-attachment-picker() {
        root.composer-attachment-picker-open = true;
        root.attachment-prepare-serial += 1;
    }
    public function finish-attachment-picker(restore: bool) {
        root.composer-attachment-picker-open = false;
        if restore && root.current-view == "main" && root.active-modal == "none"
            && (!root.compact-layout || SidebarPane.mobile-show-chat) {
            root.attachment-restore-serial += 1;
        }
    }
    public function release-text-focus() {
        root.cancel-composer-keyboard-handover();
        back-scope.focus();
    }

    // The composer's in-flight IME composition, mirrored from the live
    // ChatLayout. `TextInput.text` excludes it, so without this a conversation
    // switch parked the draft without the composing word, and the input method
    // later committed that word into the NEXT conversation's text. Destroying
    // the composer (leaving the chat) drops it too: Slint sends no FocusOut to
    // a TextInput that dies with its component.
    property <bool> composer-composing: false;
    property <string> composer-composed-text;
    public function composer-has-preedit() -> bool {
        return root.composer-composing;
    }
    // Fold the composition into `composer-text` and end it. The text is
    // computed BEFORE focus moves and assigned after, as the composer's
    // suspend-input does: a FocusOut that commits the preedit itself (core's
    // Android path) yields the same string, one that drops it (desktop) is
    // restored, and nothing is inserted twice. Called by Rust before it parks
    // the draft on a conversation switch, and by a remounted ChatLayout for a
    // composition its predecessor died with.
    public function settle-composer() {
        if !root.composer-composing { return; }
        root.composer-composing = false;
        root.composer-settled-text = root.composer-composed-text;
        back-scope.focus();
        ChatPane.composer-text = root.composer-settled-text;
    }
    private property <string> composer-settled-text;

    // Same hole for the composer's pickers. On a phone the composer drops its
    // focus when one opens so the panel replaces the keyboard
    // (message_composer.slint, emoji-touch) — which left NOTHING focused, so
    // the Back meant to close the picker was dropped on the floor. Hand focus
    // to back-scope instead: the keyboard still goes away, and Back arrives.
    // The drawer suspends text input on every platform. Give Back/Escape a
    // focus owner until search or the keyboard toggle takes focus.
    private property <bool> composer-drawer-visible:
        ChatPane.composer-emoji-picker-visible || ChatPane.composer-gif-picker-visible;
    changed composer-drawer-visible => {
        if root.composer-drawer-visible {
            root.cancel-composer-keyboard-handover();
            back-scope.focus();
        }
    }
    callback composer-gif-closed();
    in-out property <int> composer-gif-generation;
    private property <bool> observed-composer-gif-picker-visible: ChatPane.composer-gif-picker-visible;
    changed observed-composer-gif-picker-visible => {
        if !ChatPane.composer-gif-picker-visible {
            root.composer-gif-generation += 1;
            root.composer-gif-closed();
        }
    }
    // Same hole for the search palette: its field holds focus, and picking a
    // result closes the palette, so Back from the chat it opened did nothing
    // (RC20, 3/3). Back from that chat returns to the list, like the header ←.
    private property <bool> observed-unified-search-open: SearchPane.unified-search-open;
    changed observed-unified-search-open => {
        if (!SearchPane.unified-search-open) {
            SearchPane.unified-search-closed();
            back-scope.focus();
        }
    }
    changed active-modal => {
        if root.active-modal != "none" {
            SidebarPane.row-context-menu-open = false;
            SidebarPane.section-context-menu-open = false;
        }
        root.refresh-screen-protection();
        ModalHostState.modal-generation += 1;
        ModalHostState.sessions-generation += 1;
        // Modal changes invalidate the loader even when Settings stays mounted.
        // Reissue it so an approval dialog closing cannot strand loading=true.
        if root.active-modal == "sessions" || ModalHostState.settings-open {
            SettingsPane.settings-view-sessions();
        }
        modal-transitions.present-active-modal();
        CallView.calls-more-menu-visible = false;
        root.cancel-composer-keyboard-handover();
        if root.active-modal != "" { VoiceRecording.cancel(); }
        // On open too: taking focus off the composer is what hides the soft
        // keyboard (a TextInput's FocusOut sends InputMethodRequest::Disable),
        // which otherwise stays up over the modal (F78). On close it is also
        // what takes focus out of the dialog that is still fading out.
        back-scope.focus();
    }
    private property <bool> other-menu-open: SearchPane.unified-search-open
        || ChatPane.context-menu-visible || ChatPane.reaction-picker-visible
        || ChatPane.composer-emoji-picker-visible || ChatPane.composer-gif-picker-visible
        || CallView.calls-more-menu-visible;
    changed other-menu-open => {
        if root.other-menu-open {
            SidebarPane.row-context-menu-open = false;
            SidebarPane.section-context-menu-open = false;
        }
    }
    // Modals scroll their card clear of the keyboard only while it is up
    // (modal_container.slint, §112i), and only the Window can see it.
    changed virtual-keyboard-size => {
        VirtualKeyboard.height = root.virtual-keyboard-size.height;
        if root.virtual-keyboard-size.height > 0px {
            root.zero-inset-keyboard = false;
            keyboard-zero-inset-timeout.stop();
            if !root.composer-drawer-visible {
                keyboard-height-settle.start();
                keyboard-height-settle.restart();
            }
        } else {
            keyboard-height-settle.stop();
        }
        if root.composer-keyboard-reserve > 0px && root.virtual-keyboard-size.height > 0px {
            keyboard-handover-settle.start();
            keyboard-handover-settle.restart();
        } else if root.virtual-keyboard-size.height <= 0px {
            // An interrupted arrival is not a settled keyboard. Keep the
            // reservation until positive insets settle or refusal times out.
            keyboard-handover-settle.stop();
        }
    }

    // Catches Back/Escape delivered to Slint (including desktop keyboard
    // input). Android's Activity handles system Back before it reaches Slint.
    // focus-on-click / focus-on-tab-navigation are both off on purpose: this
    // scope must never take focus AWAY from the composer or a text field. It
    // receives focus from `forward-focus` above and from the two `changed`
    // handlers, and otherwise works purely by event bubbling.
    back-scope := FocusScope {
        // Remember the consumed Escape until key-up, after menu dismissal.
        property <bool> calls-menu-escape-consumed: false;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        capture-key-pressed(event) => {
            if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                Appearance.keyboard-focus-visible = true;
            }
            // Alt+↑/↓ switch chats. Caught before the focused field: a
            // TextInput accepts arrow keys, so from the composer they never
            // bubbled up to key-pressed below.
            if (event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow)
                && shortcuts.handle-command(event)) {
                return accept;
            }
            return reject;
        }

        key-pressed(event) => {
            if (shortcuts.handle-command(event)) { return accept; }
            if (event.text == Key.Back || (event.text == Key.Escape && ChatPane.link-confirm-url != "") || (event.text == Key.Escape
                && root.active-modal == "none"
                && (ChatPane.delete-confirm-count > 0 || CallView.calls-more-menu-visible || CallView.call-history-selecting || ChatPane.composer-emoji-picker-visible || ChatPane.composer-gif-picker-visible
                    || SidebarPane.active-tab == "contacts" || SidebarPane.active-tab == "calls"))) {
                if (event.text == Key.Escape && (ChatPane.link-confirm-url != "" || CallView.calls-more-menu-visible || CallView.call-history-selecting || ChatPane.delete-confirm-count > 0)) {
                    self.calls-menu-escape-consumed = true;
                }
                root.back-pressed();
                // Always consume. The android backend turns EventAccepted into
                // InputStatus::Handled, which is what stops the framework's
                // default Back (finish the Activity) from also running.
                return accept;
            }
            if (event.text == Key.Escape && shortcuts.handle-escape()) { return accept; }
            return reject;
        }

        // Swallow the matching key-up too, WITHOUT re-firing back-pressed.
        // Android's default Back acts on ACTION_UP, so consuming only the press
        // would leave the release for the framework to act on — one physical
        // press then both pops a layer here and runs the default handler.
        key-released(event) => {
            if (event.text == Key.Escape && self.calls-menu-escape-consumed) {
                self.calls-menu-escape-consumed = false;
                return accept;
            }
            return event.text == Key.Back || (event.text == Key.Escape
                && root.active-modal == "none"
                && (ChatPane.composer-emoji-picker-visible || ChatPane.composer-gif-picker-visible)) ? accept : reject;
        }

        shortcuts := AppShortcuts {
            current-view: root.current-view;
            active-modal: root.active-modal;
            back-pressed() => { root.back-pressed(); }
        }

        // ========== Main content layer ==========
        // Apply ALL insets (system bars + IME) in ONE place — here. Inner layouts
        // use `parent.height` directly, no further inset subtraction. Splitting
        // top vs bottom across outer+inner caused keyboard-open to shift content
        // down instead of shrink it. Per Slint mobile layout guidance
        // (https://docs.slint.dev/latest/docs/slint/guide/platforms/mobile/general/):
        // one rectangle, all insets.
        TouchArea {
            width: root.width;
            height: root.height;
            // Parent hit testing observes pointer movement before child controls handle it.
            changed mouse-x => { Appearance.keyboard-focus-visible = false; }
            changed mouse-y => { Appearance.keyboard-focus-visible = false; }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    Appearance.keyboard-focus-visible = false;
                }
            }

        Rectangle {
            width: root.width;
            height: root.height - root.safe-area-top - root.safe-area-bottom;
            y: root.safe-area-top;

            AuthPages {
                width: parent.width;
                height: parent.height;
                account-free-surfaces : root.account-free-surfaces;
                current-view : root.current-view;
                exiting-view: view-transition.exiting-view;
                is-mobile-platform : root.is-mobile-platform;
                server-unreachable : root.server-unreachable;
                view-progress : view-transition.view-progress;
            }

            // During the brief visual handoff, neither page accepts a stray tap.
            if view-transition.exiting-view != "": TouchArea {
                z: 3;
                width: parent.width;
                height: parent.height;
                clicked => {}
            }

            // Main chat layout — parent Rectangle already accounts for all insets.
            if current-view == "main": MainChatShell {
                z: -2;
                chat-push-progress <=> root.chat-push-progress;
                width: 100%;
                height: parent.height;
                attachment-prepare-serial : root.attachment-prepare-serial;
                attachment-restore-serial : root.attachment-restore-serial;
                bottom-nav-visible : root.bottom-nav-visible;
                chat-traffic-lights-lead : root.chat-traffic-lights-lead;
                compact-layout : root.compact-layout;
                composer-composed-text <=> root.composer-composed-text;
                composer-composing <=> root.composer-composing;
                connection-status : root.connection-status;
                connection-reconnect-attempt: root.connection-reconnect-attempt;
                context-menu-anchor-bottom <=> root.context-menu-anchor-bottom;
                context-menu-anchor-left <=> root.context-menu-anchor-left;
                context-menu-anchor-right <=> root.context-menu-anchor-right;
                context-menu-anchor-top <=> root.context-menu-anchor-top;
                context-menu-preview-from-thread <=> root.context-menu-preview-from-thread;
                context-menu-preview-message <=> root.context-menu-preview-message;
                context-menu-preview-mobile <=> root.context-menu-preview-mobile;
                context-menu-preview-row-width <=> root.context-menu-preview-row-width;
                context-menu-preview-row-x <=> root.context-menu-preview-row-x;
                context-menu-preview-row-y <=> root.context-menu-preview-row-y;
                drawer-keyboard-height : root.drawer-keyboard-height;
                insert-serial : root.insert-serial;
                inserted-emoji : root.inserted-emoji;
                is-mobile-platform : root.is-mobile-platform;
                is-small-screen : root.is-small-screen;
                keyboard-open : root.keyboard-open;
                macos-titlebar-height : root.macos-titlebar-height;
                macos-traffic-lights-width : root.macos-traffic-lights-width;
                reply-focus-serial <=> root.reply-focus-serial;
                return-to-call-height : root.return-to-call-height;
                safe-area-bottom : root.safe-area-bottom;
                server-unreachable : root.server-unreachable;
                sidebar-is-rail : root.sidebar-is-rail;
                sidebar-user-collapsed <=> root.sidebar-user-collapsed;
                viewer-origin-height <=> root.viewer-origin-height;
                viewer-origin-width <=> root.viewer-origin-width;
                viewer-origin-x <=> root.viewer-origin-x;
                viewer-origin-y <=> root.viewer-origin-y;
                window-height: root.height;
                keyboard-inset: root.virtual-keyboard-size.height;
                release-text-focus() => { root.release-text-focus(); }
                request-composer-keyboard(arg0) => { root.request-composer-keyboard(arg0); }
                settle-composer() => { root.settle-composer(); }
                toggle-anon-mode() => { root.toggle-anon-mode(); }
                watch-composer-keyboard() => { root.watch-composer-keyboard(); }
            }

        AppModalHost {
            connection-status: root.connection-status;
            server-unreachable: root.server-unreachable;
            connection-reconnect-attempt: root.connection-reconnect-attempt;
            z: 0;
            width: parent.width;
            height: parent.height;
            active-modal : root.active-modal;
            compact-layout : root.compact-layout;
            exiting-modal : modal-transitions.exiting-modal;
            is-mobile-platform : root.is-mobile-platform;
            presented-modal : modal-transitions.presented-modal;
        }

        AppTabScreens {
            z: -1;
            width: parent.width;
            height: parent.height;
            bottom-nav-visible : root.bottom-nav-visible;
            compact-layout : root.compact-layout;
            is-mobile-platform : root.is-mobile-platform;
            return-to-call-height : root.return-to-call-height;
            safe-area-bottom : root.safe-area-bottom;
        }

        AppSecondaryModals {
            z: 0;
            width: parent.width;
            height: parent.height;
            active-modal : root.active-modal;
            anon-mode-pin <=> root.anon-mode-pin;
            anon-mode-pin-error : root.anon-mode-pin-error;
            anon-mode-verifying : root.anon-mode-verifying;
            compact-layout : root.compact-layout;
            exiting-modal : modal-transitions.exiting-modal;
            fab-y : root.fab-y;
            is-mobile-platform : root.is-mobile-platform;
            macos-titlebar-height : root.macos-titlebar-height;
            presented-modal : modal-transitions.presented-modal;
            safe-area-top : root.safe-area-top;
            sidebar-is-rail : root.sidebar-is-rail;
            window-height: root.height;
            submit-anon-mode-pin(arg0) => { root.submit-anon-mode-pin(arg0); }
        }

        AppSettingsHost {
            z: -1;
            width: parent.width;
            height: parent.height;
            compact-layout : root.compact-layout;
            is-mobile-platform : root.is-mobile-platform;
            safe-area-bottom : root.safe-area-bottom;
            toggle-anon-mode() => { root.toggle-anon-mode(); }
        }

        AppTopOverlays {
            width: parent.width;
            height: parent.height;
            active-modal: root.active-modal;
            context-menu-anchor-bottom: root.context-menu-anchor-bottom;
            context-menu-anchor-left: root.context-menu-anchor-left;
            context-menu-anchor-right: root.context-menu-anchor-right;
            context-menu-anchor-top: root.context-menu-anchor-top;
            context-menu-preview-from-thread: root.context-menu-preview-from-thread;
            context-menu-preview-message: root.context-menu-preview-message;
            context-menu-preview-mobile: root.context-menu-preview-mobile;
            context-menu-preview-row-width: root.context-menu-preview-row-width;
            context-menu-preview-row-x: root.context-menu-preview-row-x;
            context-menu-preview-row-y: root.context-menu-preview-row-y;
            device-picker-presented: modal-transitions.device-picker-presented;
            exiting-modal: modal-transitions.exiting-modal;
            incoming-presented: modal-transitions.incoming-presented;
            incoming-shown: modal-transitions.incoming-shown;
            is-mobile-platform: root.is-mobile-platform;
            presented-modal: modal-transitions.presented-modal;
            reply-focus-serial <=> root.reply-focus-serial;
            safe-area-top: root.safe-area-top;
            sidebar-menu-collapsed: !root.compact-layout && root.sidebar-is-rail;
            sidebar-menu-width: root.compact-layout ? root.width
                : root.sidebar-is-rail ? (root.is-mobile-platform ? 68px : Spacing.sidebar-width-collapsed)
                : Spacing.sidebar-width;
            sidebar-menu-bottom-inset: root.bottom-nav-visible
                ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom
                    + (CallView.active-call-visible ? root.return-to-call-height + Spacing.sm : 0px)
                : 0px;
            viewer-origin-height: root.viewer-origin-height;
            viewer-origin-width: root.viewer-origin-width;
            viewer-origin-x: root.viewer-origin-x;
            viewer-origin-y: root.viewer-origin-y;
            focus-back-scope => { back-scope.focus(); }
        }

        AppBottomChrome {
            z: -1;
            width: parent.width;
            height: parent.height;
            active-modal: root.active-modal;
            bottom-nav-visible: root.bottom-nav-visible;
            compact-layout: root.compact-layout;
            contacts-badge: ModalHostState.friends-received-requests.length;
            fab-y: root.fab-y;
            fab-visible: root.fab-visible;
            return-to-call-height: root.return-to-call-height;
            safe-area-bottom: root.safe-area-bottom;
            sidebar-user-collapsed <=> root.sidebar-user-collapsed;
            create-clicked => { ModalHostState.nav-push("create-menu"); }
        }

        // ========== Toast notification overlay (top-right) ==========
        ToastOverlay {
            width: parent.width;
            height: parent.height;
            show-toast <=> root.toast-visible;
            message: root.toast-message;
            variant: root.toast-variant;
            secret-chat-starts-pending: root.secret-chat-starts-pending;
        }

        }
        }
    }

    ShieldWash {
        z: 10;
        width: root.width;
        height: root.height;
    }
}
