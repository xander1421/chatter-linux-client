                call-toggle-mute() => { root.call-toggle-mute(); }
                call-toggle-screen-share() => { root.call-toggle-screen-share(); }
                call-toggle-speaker() => { root.call-toggle-speaker(); }
                call-toggle-video() => { root.call-toggle-video(); }
                calls-tab-clicked() => { root.calls-tab-clicked(); }
                cancel-edit() => { root.cancel-edit(); }
                cancel-reply() => { root.cancel-reply(); }
                channel-invites-clicked() => { root.channel-invites-clicked(); }
                channel-selected(arg0) => { root.channel-selected(arg0); }
                chat-menu-can-start-secret-chat() => { return root.chat-menu-can-start-secret-chat(); }
                chat-settings-clicked() => { root.chat-settings-clicked(); }
                close-thread-clicked() => { root.close-thread-clicked(); }
                composer-emoji-category-changed(arg0) => { root.composer-emoji-category-changed(arg0); }
                composer-emoji-search-changed(arg0) => { root.composer-emoji-search-changed(arg0); }
                composer-emoji-selected(arg0) => { root.composer-emoji-selected(arg0); }
                composer-emoji-skin-tone-changed(arg0) => { root.composer-emoji-skin-tone-changed(arg0); }
