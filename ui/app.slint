    // ========== Anon mode (PIN modal + toggle) ==========
    in-out property <string> anon-mode-pin: "";
    in property <string> anon-mode-pin-error: "";
    in property <bool> anon-mode-verifying: false;
    callback toggle-anon-mode();              // sidebar button → Rust handler
    callback submit-anon-mode-pin(string);    // PIN modal submit → Rust verify

    // Tablet panes share one page canvas behind their rounded chrome.
    // A tinted window behind the sidebar and an opaque chat beside it expose
    // a rectangular patch in the search/footer corner cutouts.
    background: root.is-mobile-platform && !root.compact-layout
        ? Colors.background : Materials.ambient;

    // ========== Responsive sidebar auto-collapse ==========
    // Auto-collapse sidebar on smaller screens (< 800px width)
    property <bool> is-small-screen: root.width < 800px;
    // Mobile layout: only on actual mobile devices (Android) with narrow screens.
    // Desktop narrow windows keep the collapsed sidebar instead of going fullscreen.
    // is-small-screen drives the collapse-by-default + full-width side-panels.
    // No separate "mobile-screen" mode — Android renders identically to a
    // narrow desktop window, per the user's "1-to-1 with desktop" preference.
    // Track whether the user manually toggled collapse (vs auto-collapse on resize)
    property <bool> sidebar-user-collapsed: false;

    // Update sidebar collapsed/hidden state when screen size changes
    changed is-small-screen => {
        if (root.is-small-screen && !root.sidebar-collapsed) {
            // Auto-collapse on small screen — don't mark as user choice
            root.sidebar-collapsed = true;
        }
        if (!root.is-small-screen && root.sidebar-collapsed && !root.sidebar-user-collapsed) {
            // Auto-expand when screen grows, unless user explicitly collapsed
            root.sidebar-collapsed = false;
        }
    }
    changed compact-layout => { root.refresh-screen-protection(); }

    // ========== Android back key ==========
    // Android's Activity calls this directly for hardware/gesture Back, even
    // when Slint has no focused item. The scope below also routes desktop
    // Back/Escape here. Navigation decisions live in features/back.rs.
    callback back-pressed();
    // Android asks core to recompute capture protection at navigation boundaries.
    callback refresh-screen-protection();
    // The phone's chat pane closed (Back, header back, a bottom tab): nothing
    // is on screen any more, so no conversation may stay "active".
    callback chat-pane-closed();

    // Give Slint keyboard shortcuts an initial focus target. Key input reaches
    // only the focused item and its ancestors; Android system Back is also
    // routed directly from MainActivity when no Slint item has focus.
    forward-focus: back-scope;

    changed channel-id => {
        root.calls-more-menu-visible = false;
        root.cancel-composer-keyboard-handover();
        VoiceRecording.cancel();
        root.composer-emoji-picker-visible = false;
        root.composer-gif-picker-visible = false;
    }
    private property <string> inserted-emoji;
    private property <int> insert-serial;
    public function insert-composer-emoji(emoji: string) { root.inserted-emoji = emoji; root.insert-serial += 1; }
    changed conversation-kind => { root.calls-more-menu-visible = false; VoiceRecording.cancel(); }
    changed selection-mode => { if root.selection-mode { VoiceRecording.cancel(); } }
    changed composer-is-editing => { if root.composer-is-editing { VoiceRecording.cancel(); } }
    changed composer-text => { root.composer-draft-changed(); }
    changed thread-composer-text => { root.thread-draft-changed(); }
    changed thread-panel-visible => { VoiceRecording.cancel(); }
    changed active-tab => { root.calls-more-menu-visible = false; root.call-history-selecting = false; root.cancel-composer-keyboard-handover(); VoiceRecording.cancel(); root.refresh-screen-protection(); }
    changed current-view => {
        root.refresh-screen-protection();
        root.calls-more-menu-visible = false;
        root.call-history-selecting = false;
        root.cancel-composer-keyboard-handover();
        VoiceRecording.cancel();
        back-scope.focus();
        root.exiting-view = Appearance.reduce-motion ? "" : root.previous-view;
        root.previous-view = root.current-view;
        root.view-appearing = false;
        root.view-progress = 0;
        view-arrive.start();
        view-leave.start();
    }
    // Drop whatever text field holds focus (hiding the soft keyboard with it)
    // without leaving the window focus-less: Back keeps arriving at
    // back-scope. Called from Rust when Android's Back hid the keyboard
    // behind Slint's back (platform/android/activity.rs).
    in-out property <bool> composer-attachment-picker-open: false;
    private property <int> attachment-prepare-serial;
    private property <int> attachment-restore-serial;
    public function prepare-attachment-picker() {
        root.composer-attachment-picker-open = true;
        root.attachment-prepare-serial += 1;
    }
    public function finish-attachment-picker(restore: bool) {
        root.composer-attachment-picker-open = false;
        if restore && root.current-view == "main" && root.active-modal == "none"
            && (!root.compact-layout || root.mobile-show-chat) {
            root.attachment-restore-serial += 1;
        }
    }
    public function release-text-focus() {
        root.cancel-composer-keyboard-handover();
        back-scope.focus();
    }

    // The composer's in-flight IME composition, mirrored from the live
    // ChatLayout. `TextInput.text` excludes it, so without this a conversation
    // switch parked the draft without the composing word, and the input method
    // later committed that word into the NEXT conversation's text. Destroying
    // the composer (leaving the chat) drops it too: Slint sends no FocusOut to
    // a TextInput that dies with its component.
    property <bool> composer-composing: false;
    property <string> composer-composed-text;
    public function composer-has-preedit() -> bool {
        return root.composer-composing;
    }
    // Fold the composition into `composer-text` and end it. The text is
    // computed BEFORE focus moves and assigned after, as the composer's
    // suspend-input does: a FocusOut that commits the preedit itself (core's
    // Android path) yields the same string, one that drops it (desktop) is
    // restored, and nothing is inserted twice. Called by Rust before it parks
    // the draft on a conversation switch, and by a remounted ChatLayout for a
    // composition its predecessor died with.
    public function settle-composer() {
        if !root.composer-composing { return; }
        root.composer-composing = false;
        root.composer-settled-text = root.composer-composed-text;
        back-scope.focus();
        root.composer-text = root.composer-settled-text;
    }
    private property <string> composer-settled-text;

    // Same hole for the composer's pickers. On a phone the composer drops its
    // focus when one opens so the panel replaces the keyboard
    // (message_composer.slint, emoji-touch) — which left NOTHING focused, so
    // the Back meant to close the picker was dropped on the floor. Hand focus
    // to back-scope instead: the keyboard still goes away, and Back arrives.
    // The drawer suspends text input on every platform. Give Back/Escape a
    // focus owner until search or the keyboard toggle takes focus.
    private property <bool> composer-drawer-visible:
        root.composer-emoji-picker-visible || root.composer-gif-picker-visible;
    changed composer-drawer-visible => {
        if root.composer-drawer-visible {
            root.cancel-composer-keyboard-handover();
            back-scope.focus();
        }
    }
    callback composer-gif-closed();
    in-out property <int> composer-gif-generation;
    changed composer-gif-picker-visible => {
        if !root.composer-gif-picker-visible {
            root.composer-gif-generation += 1;
            root.composer-gif-closed();
        }
    }
    // Same hole for the search palette: its field holds focus, and picking a
    // result closes the palette, so Back from the chat it opened did nothing
    // (RC20, 3/3). Back from that chat returns to the list, like the header ←.
    changed unified-search-open => {
        if (!root.unified-search-open) {
            root.unified-search-closed();
            back-scope.focus();
        }
    }
    changed active-modal => {
        root.refresh-screen-protection();
        root.modal-generation += 1;
        root.sessions-generation += 1;
        if root.active-modal == "sessions" { root.settings-view-sessions(); }
        root.present-active-modal();
        root.calls-more-menu-visible = false;
        root.cancel-composer-keyboard-handover();
        if root.active-modal != "" { VoiceRecording.cancel(); }
        // On open too: taking focus off the composer is what hides the soft
        // keyboard (a TextInput's FocusOut sends InputMethodRequest::Disable),
        // which otherwise stays up over the modal (F78). On close it is also
        // what takes focus out of the dialog that is still fading out.
        back-scope.focus();
    }
    // Modals scroll their card clear of the keyboard only while it is up
    // (modal_container.slint, §112i), and only the Window can see it.
    changed virtual-keyboard-size => {
        VirtualKeyboard.height = root.virtual-keyboard-size.height;
        if root.virtual-keyboard-size.height > 0px {
            root.zero-inset-keyboard = false;
            keyboard-zero-inset-timeout.stop();
            if !root.composer-drawer-visible {
                keyboard-height-settle.start();
                keyboard-height-settle.restart();
            }
        } else {
            keyboard-height-settle.stop();
        }
        if root.composer-keyboard-reserve > 0px && root.virtual-keyboard-size.height > 0px {
            keyboard-handover-settle.start();
            keyboard-handover-settle.restart();
        } else if root.virtual-keyboard-size.height <= 0px {
            // An interrupted arrival is not a settled keyboard. Keep the
            // reservation until positive insets settle or refusal times out.
            keyboard-handover-settle.stop();
        }
    }

    // Catches Back/Escape delivered to Slint (including desktop keyboard
    // input). Android's Activity handles system Back before it reaches Slint.
    //
    // focus-on-click / focus-on-tab-navigation are both off on purpose: this
    // scope must never take focus AWAY from the composer or a text field. It
    // receives focus from `forward-focus` above and from the two `changed`
    // handlers, and otherwise works purely by event bubbling.
    back-scope := FocusScope {
        // Remember the consumed Escape until key-up, after menu dismissal.
        property <bool> calls-menu-escape-consumed: false;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        key-pressed(event) => {
            if (event.text == Key.Back || (event.text == Key.Escape
                && root.active-modal == "none"
                && (root.delete-confirm-count > 0 || root.calls-more-menu-visible || root.call-history-selecting || root.composer-emoji-picker-visible || root.composer-gif-picker-visible))) {
                if (event.text == Key.Escape && (root.calls-more-menu-visible || root.call-history-selecting || root.delete-confirm-count > 0)) {
                    self.calls-menu-escape-consumed = true;
                }
                root.back-pressed();
                // Always consume. The android backend turns EventAccepted into
                // InputStatus::Handled, which is what stops the framework's
                // default Back (finish the Activity) from also running.
                return accept;
            }
            return reject;
        }

        // Swallow the matching key-up too, WITHOUT re-firing back-pressed.
        // Android's default Back acts on ACTION_UP, so consuming only the press
        // would leave the release for the framework to act on — one physical
        // press then both pops a layer here and runs the default handler.
        key-released(event) => {
            if (event.text == Key.Escape && self.calls-menu-escape-consumed) {
                self.calls-menu-escape-consumed = false;
                return accept;
            }
            return event.text == Key.Back || (event.text == Key.Escape
                && root.active-modal == "none"
                && (root.composer-emoji-picker-visible || root.composer-gif-picker-visible)) ? accept : reject;
        }

        // ========== Global keyboard shortcuts ==========
        FocusScope {
            width: 0;
            height: 0;
            enabled: root.current-view == "main";

            key-pressed(event) => {
                // Ctrl+J: open the local AI channel
                if (JarvisGlobal.enabled && event.modifiers.control && event.text == "j") {
                    root.channel-selected("00000000-0000-0000-0000-000000000000");
                    return accept;
                }
                // Ctrl+K / Ctrl+F: open unified search (which combo depends on pref)
                if (event.modifiers.control
                    && ((event.text == "k" && root.search-shortcut-pref != "f")
                     || (event.text == "f" && root.search-shortcut-pref != "k"))) {
                    root.unified-search-selected-index = 0;
                    root.unified-search-open = true;
                    root.unified-search-opened();
                    return accept;
                }
                // Ctrl+,: Open settings
                if (event.modifiers.control && event.text == ",") {
                    root.nav-push("settings");
                    root.settings-clicked();
                    return accept;
                }
                // Ctrl+/: Toggle keyboard shortcuts help
                if (event.modifiers.control && event.text == "/") {
                    if (root.active-modal == "keyboard-shortcuts") {
                        root.nav-close("keyboard-shortcuts");
                    } else {
                        root.nav-push("keyboard-shortcuts");
                    }
                    return accept;
                }
                // Escape: close the top modal, else leave a non-Chats tab
                if (event.text == Key.Escape) {
                    if (root.calls-more-menu-visible || root.call-history-selecting || root.delete-confirm-count > 0) {
                        root.back-pressed();
                        return accept;
                    }
                    if (root.active-modal != "none") {
                        root.nav-pop();
                        return accept;
                    }
                    if (root.active-tab != "chats") {
                        root.active-tab = "chats";
                        return accept;
                    }
                }
                reject
            }
        }

        // ========== Main content layer ==========
        // Apply ALL insets (system bars + IME) in ONE place — here. Inner layouts
        // use `parent.height` directly, no further inset subtraction. Splitting
        // top vs bottom across outer+inner caused keyboard-open to shift content
        // down instead of shrink it. Per Slint mobile layout guidance
        // (https://docs.slint.dev/latest/docs/slint/guide/platforms/mobile/general/):
        // one rectangle, all insets.
        Rectangle {
            width: root.width;
            height: root.height - root.safe-area-top - root.safe-area-bottom;
            y: root.safe-area-top;

            // Loading page
            if current-view == "loading": LoadingPage {
                z: 2;
                x: root.view-shift("loading");
                opacity: root.view-opacity("loading");
                message: root.loading-message;
                secondary-message: root.loading-secondary-message;
            }

            // Login page
            if current-view == "login" || root.exiting-view == "login": LoginPage {
                z: 2;
                x: root.view-shift("login");
                opacity: root.view-opacity("login");
                touch: root.is-mobile-platform;
                server-url <=> root.login-server-url;
                configured-server-url: root.configured-server-url;
                username <=> root.login-username;
                password <=> root.login-password;
                pin <=> root.login-pin;
                loading: root.login-loading;
                error: root.login-error;
                verifying: root.login-verifying;
                identity-reset-available: root.login-identity-reset-available;
                accept-new-identity => { root.accept-new-identity(); }

                server-unreachable: root.server-unreachable;
                account-free-surfaces: root.account-free-surfaces;
                continue-without-account => { root.continue-without-account(); }

                login(u, p, s, pin) => {
                    root.login(u, p, s, pin);
                }
                register => {
                    root.go-to-register();
                }
                go-to-recovery => {
                    root.go-to-recovery();
                }
                go-to-link-device => {
                    root.go-to-link-device();
                }
            }

            // Register page
            if current-view == "register" || root.exiting-view == "register": RegisterPage {
                z: 2;
                x: root.view-shift("register");
                opacity: root.view-opacity("register");
                touch: root.is-mobile-platform;
                display-name <=> root.register-display-name;
                username <=> root.register-username;
                password <=> root.register-password;
                confirm-password <=> root.register-confirm-password;
                pin <=> root.register-pin;
                server-url <=> root.register-server-url;
                loading: root.register-loading;
                error: root.register-error;
                avatar-source: root.register-avatar-source;
                has-avatar: root.register-has-avatar;
                selected-default-idx <=> root.register-selected-default-idx;
                avatar-color <=> root.register-avatar-color;
                password-strength: root.register-password-strength;
                pin-strength: root.register-pin-strength;
                server-unreachable: root.server-unreachable;
                account-free-surfaces: root.account-free-surfaces;

                continue-without-account => { root.continue-without-account(); }

                register(u, p, d, pin, s) => {
                    root.register(u, p, d, pin, s);
                }
                username-validation(u) => { root.register-username-validation(u) }
                password-changed(p) => {
                    root.register-password-changed(p);
                }
                pin-changed(p) => {
                    root.register-pin-changed(p);
                }
                select-avatar => {
                    root.register-select-avatar();
                }
                select-default-avatar(idx) => {
                    root.register-select-default-avatar(idx);
                }
                remove-avatar => { root.register-remove-avatar(); }
                go-to-login => {
                    root.go-to-login();
                }
            }

            // Link new device (new-device side QR display)
            if current-view == "link-device" || root.exiting-view == "link-device": LinkDevicePage {
                z: 2;
                x: root.view-shift("link-device");
                opacity: root.view-opacity("link-device");
                touch: root.is-mobile-platform;
                qr-image: root.link-device-qr;
                link-url: root.link-device-url;
                status-text: root.link-device-status;
                error: root.link-device-error;
                linking: root.link-device-active;
                has-local-identity: root.link-device-has-local-identity;

                start => { root.link-device-start(); }
                cancel => { root.link-device-cancel(); }
                copy-link => { root.link-device-copy(); }
                go-to-login => { root.go-to-login(); }
            }

            // Account recovery page
            if current-view == "recovery" || root.exiting-view == "recovery": AccountRecoveryPage {
                z: 2;
                x: root.view-shift("recovery");
                opacity: root.view-opacity("recovery");
                username <=> root.recovery-username;
                recovery-code <=> root.recovery-code;
                new-password <=> root.recovery-new-password;
                confirm-password <=> root.recovery-confirm-password;
                new-pin <=> root.recovery-new-pin;
                loading: root.recovery-loading;
                error: root.recovery-error;
                success: root.recovery-success;

                recover(u, code, pw, pin) => {
                    root.recover-account(u, code, pw, pin);
                }
                go-to-login => {
                    root.go-to-login();
                }
            }

            // Welcome page (shown after first registration)
            if current-view == "welcome" || root.exiting-view == "welcome": WelcomePage {
                z: 2;
                x: root.view-shift("welcome");
                opacity: root.view-opacity("welcome");
                display-name: root.user-display-name;
                add-friends => { root.welcome-add-friends(); }
                browse-channels => { root.welcome-browse-channels(); }
                get-started => { root.welcome-get-started(); }
            }

            // During the brief visual handoff, neither page accepts a stray tap.
            if root.exiting-view != "": TouchArea {
                z: 3;
                width: parent.width;
                height: parent.height;
                clicked => {}
            }

            // Main chat layout — parent Rectangle already accounts for all insets.
            if current-view == "main": Rectangle {
                // Keep the sidebar and chat at a fixed origin while notices change.
                // Layer order: chat column (-2), floating notices (-1), then
                // the pushed modal layer (0).
                z: -2;
                width: 100%;
                height: parent.height;
                background: transparent;

                VerticalLayout {
                    width: 100%;
                    height: parent.height;

                Rectangle {
                    vertical-stretch: 1;
                    width: 100%;
                    clip: true;

                // Sidebar (width controlled by collapsed state; mobile-mode for full-width).
                // Hidden entirely in call-fullscreen so the call view fills the whole
                // window width — a landscape viewport for a landscape screen share.
                if !root.active-call-fullscreen: Sidebar {
                    x: root.compact-layout ? -self.width * 0.28 * root.chat-push-progress : 0px;
                    // Keep the list mounted for the reverse push, but do not
                    // paint its rows after the chat fully covers it. Show it
                    // immediately when an edge swipe starts, before progress
                    // has moved off 1 in the first gesture frame.
                    visible: !root.compact-layout || root.chat-push-progress < 1 || root.chat-edge-swiping;
                    y: 0px;
                    height: parent.height;
                    bottom-inset: root.bottom-nav-visible ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom
                        + (root.active-call-visible ? 44px + Spacing.sm : 0px) : 0px;
                    // Survives dismissing the connection banner: the dot on the
                    // settings button is what keeps saying the server is down.
                    server-unreachable: root.server-unreachable;
                    // `mobile-mode` means "touch input" — it sizes the panel's
                    // targets. On desktop the panel also keeps its Discord-style
                    // layout role: an icon rail by default, expanded to the full
                    // list by the toggle in its footer.
                    //
                    // On mobile it no longer does. The rail was kept because it was
                    // the only always-available navigation, and swapping the whole
                    // screen "costs a tap for every glance at the conversation
                    // list" — but the bottom tab bar now pays that cost instead
                    // (Chats is one tap from anywhere), and the rail was spending
                    // 16% of the width of every conversation to avoid it. So on a
                    // phone this is a full-width list that the chat replaces, never
                    // a rail beside it. A tablet is wide enough for the desktop
                    // two-pane role, so only its target sizes follow touch.
                    mobile-mode: root.compact-layout;
                    touch: root.is-mobile-platform;
                    mobile-width: root.width;
                    // The panel is the top-left thing on screen, so it is the one
                    // that has to keep the macOS traffic lights clear.
                    traffic-lights-width: root.macos-traffic-lights-width;
                    titlebar-height: root.macos-titlebar-height;
                    search-overlay-open: root.unified-search-open;
                    chat-rows: root.chat-rows;
                    chat-rows-loading: root.is-signed-in && root.chat-rows-loading;
                    custom-sections: root.custom-sections;
                    user-display-name: root.user-display-name;
                    user-avatar-source: root.user-avatar-source;
                    user-initials: root.user-initials;
                    user-presence-status: root.user-presence-status;
                    // Narrow screens start on the rail and expand on demand. The
                    // user drives this — `sidebar-user-collapsed` keeps their choice
                    // from being undone by a resize.
                    // Never a rail on mobile — when this panel is on screen at all
                    // it is the whole screen.
                    collapsed: root.compact-layout ? false : root.sidebar-is-rail;
                    hidden: root.compact-layout ? false : root.sidebar-hidden;
                    pending-friend-requests: root.friends-received-requests.length;
                    pending-message-requests: root.pending-message-requests;
                    pending-group-invites: root.pending-group-invites;
                    pending-channel-invites: root.pending-channel-invites;
                    missed-call-count: root.missed-call-count;

                    channel-selected(id) => {
                        root.mobile-show-chat = true;
                        root.channel-selected(id);
                    }
                    dm-selected(id) => {
                        root.mobile-show-chat = true;
                        root.dm-selected(id);
                    }
                    private-group-selected(id) => {
                        root.mobile-show-chat = true;
                        root.private-group-selected(id);
                    }
                    search-clicked => {
                        root.unified-search-selected-index = 0;
                        root.unified-search-open = true;
                        root.unified-search-opened();
                    }
                    saved-messages-clicked => {
                        // Saved Messages IS a conversation, so it routes like one —
                        // without this the chat loads behind the list and the tap
                        // reads as doing nothing.
                        root.mobile-show-chat = true;
                        root.saved-messages-clicked();
                    }
                    friends-clicked => {
                        root.active-tab = "contacts";
                    }
                    // Wide-layout entry to the Calls screen — the same modal and
                    // the same load the phone tab bar's Calls tab raises.
                    calls-clicked => {
                        root.active-tab = "calls";
                        root.calls-tab-clicked();
                    }
                    // The sidebar's one Requests row fires all four below on every
                    // tap: the other three refresh their lists, and this one opens
                    // Contacts › Requests on the first sub-tab that has something
                    // in it (Received when none).
                    friend-requests-clicked => {
                        root.friends-modal-tab = "requests";
                        root.friends-requests-sub-tab =
                            root.friends-received-requests.length > 0 ? "received"
                            : root.pending-message-requests > 0 ? "private"
                            : root.pending-group-invites > 0 ? "groups"
                            : root.pending-channel-invites > 0 ? "channels"
                            : "received";
                        root.active-tab = "contacts";
                    }
                    message-requests-clicked => {
                        root.message-requests-clicked();
                    }
                    group-invites-clicked => {
                        root.group-invites-clicked();
                    }
                    channel-invites-clicked => {
                        root.channel-invites-clicked();
                    }
                    // The avatar and the gear both open the account menu, which
                    // is where Settings lives now.
                    profile-clicked => {
                        root.active-tab = "profile";
                    }
                    create-channel-clicked => {
                        root.start-create-channel();
                    }
                    create-clicked => {
                        root.nav-push("create-menu");
                    }
                    join-channel-clicked => {
                        root.create-channel-initial-tab = 1;
                        root.nav-push("create-channel");
                        root.open-join-channel();
                    }
                    toggle-collapsed => {
                        // Track user's explicit collapse choice for smart auto-expand
                        root.sidebar-user-collapsed = !root.sidebar-collapsed;
                        root.toggle-sidebar();
                    }
                    create-section-clicked => {
                        root.start-create-section();
                    }
                    section-toggle-expanded(id) => {
                        root.section-toggle-expanded(id);
                    }
                    section-conversation-selected(conv-id, conv-type) => {
                        root.mobile-show-chat = true;
                        root.section-conversation-selected(conv-id, conv-type);
                    }
                    delete-section-clicked(id) => {
                        root.delete-section-clicked(id);
                    }
                    rename-section-clicked(id) => {
                        root.create-section-rename-mode = true;
                        root.create-section-id = id;
                        // Rust side should set name/emoji before opening
                        root.rename-section-clicked(id);
                        root.nav-push("create-section");
                    }
                    move-to-section(conv-id, conv-type, section-id) => {
                        root.move-to-section(conv-id, conv-type, section-id);
                    }
                    set-conversation-pinned(conv-id, pinned) => {
                        root.set-conversation-pinned(conv-id, pinned);
                    }
                    delete-conversation(conv-id, kind) => {
                        root.delete-conversation(conv-id, kind);
                    }
                    leave-conversation(conv-id, kind) => {
                        root.leave-conversation(conv-id, kind);
                    }
                    move-section(section-id, delta) => {
                        root.move-section(section-id, delta);
                    }
                    set-section-sort-mode(section-id, mode) => {
                        root.set-section-sort-mode(section-id, mode);
                    }
                    remove-from-section(conv-id) => {
                        root.remove-from-section(conv-id);
                    }
                    settings-clicked => {
                        root.active-tab = "profile";
                    }
                    mesh-setup-clicked => {
                        root.nav-push("mesh-setup");
                    }
                    anon-mode-clicked => {
                        root.toggle-anon-mode();
                    }
                }

                // The list recedes under the travelling conversation. It is
                // retained through the whole push and can receive the reverse
                // motion even after the logical chat route has closed.
                if root.compact-layout && root.chat-push-progress > 0: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Materials.scrim;
                    opacity: root.chat-push-progress * 0.32;
                    TouchArea {}
                }

                // Right side area (Chat + Panels).
                //
                // On phones the pane is added for the push and retained through
                // its reverse travel; offscreen content never takes layout width.
                if !root.compact-layout || root.mobile-show-chat || root.chat-push-progress > 0: chat-panel-area := Rectangle {
                    x: root.compact-layout ? parent.width * (1 - root.chat-push-progress)
                        : root.sidebar-hidden || root.active-call-fullscreen ? 0px
                        : root.sidebar-is-rail ? (root.is-mobile-platform ? 68px : Spacing.sidebar-width-collapsed)
                        : Spacing.sidebar-width;
                    y: 0px;
                    width: root.compact-layout ? parent.width : parent.width - self.x;
                    height: parent.height;
                    visible: true;
                    // Clip this area to prevent inner panels from overflowing the whole app
                    clip: true;
                    // Space the thread panel occupies. Both row children are sized
                    // from this ONE expression so chat column + panel always sum to
                    // exactly the row width — the layout solver never gets to give
                    // the chat column 100% and push the panel past the clipped edge
                    // (the "thread opens but never appears" bug, 2026-07-19).
                    property <length> thread-panel-w: !root.thread-panel-visible ? 0px
                        : root.is-small-screen ? self.width
                        : 320px;

                        // Chat column: call dock (when active) on top of ChatLayout.
                        // The dock collapses to 0px when no call is active so the chat
                        // layout fills the full space. On mobile, hide the whole column
                        // when a side panel (members/thread) is open.
                        // Manually placed (not a HorizontalLayout child): explicit
                        // geometry doesn't feed the constraint solver, which both
                        // avoids a binding loop and guarantees column + panel tile
                        // the row exactly.
                        VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width - chat-panel-area.thread-panel-w;
                            height: 100%;
                            visible: !(root.is-small-screen && root.thread-panel-visible);

                            ActiveCallView {
                                // Take the chat column's full vertical slot when
                                // fullscreen, otherwise stay as a fixed dock (the
                                // child component caps its own height to 280px).
                                vertical-stretch: root.active-call-fullscreen ? 1 : 0;
                                show: root.active-call-visible;
                                fullscreen: root.active-call-fullscreen;
                                viewport-height: root.height;
                                call-data: root.active-call-data;
                                is-muted: root.call-is-muted;
                                is-video-enabled: root.call-is-video-enabled;
                                is-screen-sharing: root.call-is-screen-sharing;
                                speaker-toggle: root.call-speaker-toggle;
                                speaker-on: root.call-speaker-on;
                                toggle-speaker => { root.call-toggle-speaker(); }
                                local-video-frame: root.call-local-video-frame;
                                remote-video-frames: root.call-remote-video-frames;

                                toggle-mute => { root.call-toggle-mute(); }
                                toggle-video => { root.call-toggle-video(); }
                                toggle-screen-share => {
                                    if root.call-is-screen-sharing {
                                        root.call-toggle-screen-share();
                                    } else {
                                        root.show-screen-source-picker();
                                    }
                                }
                                end-call => { root.call-end(); root.active-call-fullscreen = false; }
                                show-audio-settings => { root.show-audio-device-picker(); }
                                show-audio-output-settings => { root.show-audio-output-picker(); }
                                peer-audio-mute-toggle(uid) => { root.call-peer-audio-mute-toggle(uid); }
                                peer-video-pause-toggle(uid) => { root.call-peer-video-pause-toggle(uid); }
                                fullscreen-toggle => {
                                    root.active-call-fullscreen = !root.active-call-fullscreen;
                                }
                            }

                        // `if` (not `visible`): a Slint element hidden via `visible:false`
                        // still occupies its layout slot, so in fullscreen the hidden
                        // ChatLayout reserved black space below the call dock. `if`
                        // removes it from the layout tree entirely.
                        // Selection mode takes over the channel's own header rather
                        // than floating above everything: as a root-level overlay it
                        // covered the sidebar and the header at once, so the count sat
                        // on top of the nav it was not part of. Sitting here it lines
                        // up with the header it replaces, which is also why it does not
                        // apply safe-area-top — ChatHeader does not either, and an
                        // inset on one of the two would misalign them.
                        if root.selection-mode
                            && !root.active-call-fullscreen
                            && !(root.is-small-screen && root.thread-panel-visible): SelectionBar {
                            show: true;
                            backdrop-paused: root.chat-list-scrolling;
                            touch: root.is-mobile-platform;
                            count: root.selected-message-count;
                            cleared => {
                                root.selection-mode = false;
                                root.selection-cleared();
                            }
                            delete-clicked => {
                                root.delete-choosing = true;
                                root.delete-choice-everyone = SelectionChrome.can-delete-everyone;
                                root.delete-choice-me = true;
                                root.delete-confirm-sender = "";
                                root.delete-confirm-everyone = false;
                                root.delete-confirm-count = root.selected-message-count;
                            }
                            copy-clicked => { root.selection-copy-clicked(); }
                            forward-clicked => { root.selection-forward-clicked(); }
                        }

                        if !root.active-call-fullscreen
                            && !(root.is-small-screen && root.thread-panel-visible)
                            && (root.channel-name != "" || root.loading-messages): conversation-layout := ChatLayout {
                        vertical-stretch: 1;
                        hide-header: root.selection-mode;
                        // No back button: the conversation list is always on
                        // screen beside this, so there is nothing to go back to —
                        // and the header is tight enough already.
                        // The only way back to the list on a phone, so it is not
                        // optional there. Desktop still shows both panes at once
                        // and has nothing to go back to.
                        show-back-button: root.compact-layout;
                        header-leading-inset: root.chat-traffic-lights-lead;
                        back-clicked => { root.mobile-show-chat = false; }
                        selection-mode: root.selection-mode;
                        // Press-and-hold on a bubble is a touch gesture only.
                        mobile: root.is-mobile-platform;
                        rounded-page-top: root.is-mobile-platform && !root.compact-layout;
                        menu-open: root.context-menu-visible || root.reaction-picker-visible;
                        // Tier 2 of the hold escalates out of tier 1: close the menu
                        // as selection engages, so the two are never on screen at
                        // once. The menu fades (see MessageContextMenu) while the
                        // row tint animates in, so it reads as an escalation the
                        // user caused rather than a menu that glitched away.
                        selection-toggled(id) => {
                            root.context-menu-visible = false;
                            root.message-selection-toggled(id);
                        }
                        channel-id: root.channel-id;
                        channel-name: root.channel-name;
                        conversation-kind: root.conversation-kind;
                        private-channel: root.private-channel;
                        privacy-line-override: root.privacy-line-override;
                        privacy-line-exposed: root.privacy-line-exposed;
                        is-dm: root.is-dm;
                        can-forward: root.chat-can-forward;
                        is-anonymous: root.conversation-kind == ConversationKind.anon-dm || root.conversation-kind == ConversationKind.anon-group;
                        member-count: root.member-count;
                        topic: root.topic;
                        typing-indicator: root.typing-indicator;
                        presence-status: root.header-presence-status;
                        channel-avatar-source: root.channel-avatar-source;
                        channel-has-avatar: root.channel-has-avatar;
                        jarvis-thinking: root.jarvis-thinking;
                        messages: root.messages;
                        loading-messages: root.loading-messages;
                        scroll-to-message-index: root.scroll-to-message-index;
                        highlighted-message-id: root.highlighted-message-id;
                        message-scroll-position <=> root.message-scroll-position;
                        message-first-visible-row <=> root.message-first-visible-row;
                        message-last-visible-row <=> root.message-last-visible-row;
                        // A new layout's list starts at rest; `changed` does not
                        // fire for that first value.
                        init => { root.chat-list-scrolling = false; root.settle-composer(); }
                        changed composer-composing => { root.composer-composing = self.composer-composing; }
                        changed composer-composed-text => { root.composer-composed-text = self.composer-composed-text; }
                        changed list-scrolling => { root.chat-list-scrolling = self.list-scrolling; }
                        is-at-bottom <=> root.is-at-bottom;
                        history-load-failed <=> root.history-load-failed;
                        unread-index <=> root.unread-index;
                        unread-count <=> root.unread-count;
                        should-auto-scroll: root.should-auto-scroll;
                        current-playing-attachment-id: root.current-playing-attachment-id;
                        is-media-playing: root.is-media-playing;
                        audio-progress: root.audio-progress;
                        audio-elapsed: root.audio-elapsed;
                        attachment-prepare-serial: root.attachment-prepare-serial;
                        attachment-restore-serial: root.attachment-restore-serial;
                        composer-text <=> root.composer-text;
                        composer-placeholder: root.composer-placeholder;
                        composer-notice: root.composer-notice;
                        conversation-read-only: root.conversation-read-only;
                        header-can-call: root.header-can-call;
                        header-can-invite: root.header-can-invite;
                        header-can-open-settings: root.header-can-open-settings;
                        header-can-open-pinned-list: root.header-can-open-pinned-list;
                        secret-request-actions: root.secret-request-actions;
                        secret-request-busy: root.private-request-decision != "";
                        secret-request-accept-clicked => { root.secret-request-accept-clicked(); }
                        secret-request-decline-clicked => { root.secret-request-decline-clicked(); }
                        pending-attachments: root.pending-attachments;
                        composer-is-editing <=> root.composer-is-editing;
                        composer-edit-message-id <=> root.composer-edit-message-id;
                        composer-is-replying: root.composer-is-replying;
                        reply-focus-serial: root.reply-focus-serial;
                        keyboard-open: root.keyboard-open;
                        composer-reply-to-sender-name: root.composer-reply-to-sender-name;
                        composer-reply-preview: root.composer-reply-preview;
                        composer-reply-has-thumbnail: root.composer-reply-has-thumbnail;
                        composer-reply-thumbnail: root.composer-reply-thumbnail;

                        // Picker state
                        keyboard-inset: root.virtual-keyboard-size.height;
                        remembered-keyboard-height: root.drawer-keyboard-height;
                        composer-keyboard-requested(space) => { root.request-composer-keyboard(space); }
                        composer-input-focused => { root.watch-composer-keyboard(); }
                        composer-focus-released => { root.release-text-focus(); }
                        inserted-emoji: root.inserted-emoji;
                        insert-serial: root.insert-serial;
                        emoji-list: root.composer-emoji-list;
                        emoji-category <=> root.composer-emoji-category;
                        emoji-skin-tone <=> root.composer-emoji-skin-tone;
                        emoji-search <=> root.composer-emoji-search;
                        gif-search <=> root.composer-gif-picker-search;
                        gif-results: root.composer-gif-picker-results;
                        gif-recent: root.composer-gif-picker-recent;
                        gif-loading: root.composer-gif-picker-loading;
                        gif-failed: root.composer-gif-picker-failed;
                        emoji-selected(emoji) => { root.composer-emoji-selected(emoji); }
                        emoji-category-changed(category) => { root.composer-emoji-category-changed(category); }
                        emoji-search-changed(query) => { root.composer-emoji-search-changed(query); }
                        emoji-skin-tone-changed(tone) => { root.composer-emoji-skin-tone-changed(tone); }
                        gif-selected(id, url) => { root.composer-gif-selected(id, url); }
                        gif-search-changed(query) => { root.composer-gif-search-changed(query); }
                        emoji-picker-visible <=> root.composer-emoji-picker-visible;
                        gif-picker-visible <=> root.composer-gif-picker-visible;
                        gifs-available: root.composer-gifs-available;

                        settings-clicked => { root.chat-settings-clicked(); }
                        voice-call-clicked => { root.start-voice-call(); }
                        header-more-clicked(video, settings) => {
                            root.chat-menu-video = video;
                            root.chat-menu-settings = settings;
                            root.chat-menu-secret-chat = root.chat-menu-can-start-secret-chat();
                            root.nav-push("chat-menu");
                        }
                        invite-clicked => { root.invite-member(); }
                        // Peer identity change prompt
                        identity-change-visible: root.identity-change-visible;
                        identity-change-title: root.identity-change-title;
                        identity-change-detail: root.identity-change-detail;
                        identity-change-attributed: root.identity-change-attributed;
                        identity-change-accept-clicked => { root.identity-change-accept-clicked(); }
                        // Pinned bar (Telegram-style)
                        has-pinned-messages: root.has-pinned-messages;
                        pinned-message-preview: root.pinned-message-preview;
                        pinned-current-index: root.pinned-current-index;
                        pinned-total-count: root.pinned-total-count;
                        pinned-prev-clicked => { root.pinned-prev-clicked(); }
                        pinned-next-clicked => { root.pinned-next-clicked(); }
                        pinned-go-to-message => { root.pinned-go-to-message(); }
                        pinned-dismiss-clicked => { root.pinned-dismiss-clicked(); }
                        pinned-show-clicked => { root.pinned-show-clicked(); }
                        pinned-thumbnail: root.pinned-thumbnail;
                        sender-profile-requested(user-id) => { root.sender-profile-requested(user-id); }
                        open-message-link(url) => { root.open-message-link(url); }
                        message-clicked(id) => { root.message-clicked(id); }
                        reply-clicked(sender-id, timestamp-ns) => {
                            root.reply-clicked(sender-id, timestamp-ns);
                            root.reply-focus-serial += 1;
                        }
                        forward-clicked(sender-id, timestamp-ns) => { root.forward-message-action(sender-id, timestamp-ns); }
                        react-clicked(sender-id, timestamp-ns, x, y) => {
                            root.reaction-picker-sender-id = sender-id;
                            root.reaction-picker-timestamp-ns = timestamp-ns;
                            root.reaction-picker-anchor-x = x;
                            root.reaction-picker-anchor-y = y;
                            root.reaction-picker-visible = true;
                            root.react-clicked(sender-id, timestamp-ns, x, y);
                        }
                        // Tapping an existing reaction toggles it, the way every
                        // messenger does; the picker stays on long-press (§112w).
                        reaction-toggled(sender-id, timestamp-ns, emoji) => {
                            root.reaction-selected(sender-id, timestamp-ns, "", emoji);
                        }
                        thread-clicked(id) => { root.thread-clicked(id); }
                        more-clicked(sender-id, timestamp-ns, x, y) => {
                            root.context-menu-content-top = self.content-top;
                            root.context-menu-anchor-top = 0px;
                            root.context-menu-anchor-bottom = 0px;
                            root.more-clicked(sender-id, timestamp-ns, x, y);
                        }
                        quote-clicked(id) => { root.quote-clicked(id); }
                        view-attachment(id) => {
                            root.viewer-origin-x = self.viewer-origin-x;
                            root.viewer-origin-y = self.viewer-origin-y;
                            root.viewer-origin-width = self.viewer-origin-width;
                            root.viewer-origin-height = self.viewer-origin-height;
                            root.view-attachment(id);
                        }
                        audio-seek(id, pos) => { root.audio-seek(id, pos); }
                        load-more => { root.load-more(); }
                        send(text) => { return root.send(text); }
                        send-edit(msg-id, text) => { root.send-edit(msg-id, text); }
                        cancel-edit => { root.cancel-edit(); }
                        cancel-reply => { root.cancel-reply(); }
                        attachment-clicked => { root.attachment-clicked(); }
                        paste-image => { root.paste-image(); }
                        emoji-clicked => { root.emoji-clicked(); }
                        gif-clicked => { root.gif-clicked(); }

                        mention-triggered(query) => { root.mention-triggered(query); }
                        remove-attachment(id) => { root.remove-attachment(id); }
                        typing-changed(is-typing) => { root.typing-changed(is-typing); }
                        scroll-to-bottom-clicked => { root.scroll-to-bottom-clicked(); }
                    }

                        // Nothing open (the tablet/desktop pane before the first
                        // pick, or after the open chat was deleted or left). Every
                        // open path names the conversation, so an empty name means
                        // none: without this the pane read "No messages yet / Be
                        // the first to say something! / Public channel".
                        // An open in flight is not "nothing open": the name arrives
                        // with the messages, and showing this for those ~300 ms
                        // flashed the two-pane placeholder on every phone open.
                        if !root.active-call-fullscreen && root.channel-name == "" && !root.loading-messages: Rectangle {
                            vertical-stretch: 1;
                            background: Colors.background;
                            Text {
                                text: "Select a conversation";
                                color: Colors.text-muted;
                                font-size: Typography.lg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        } // end VerticalLayout (call dock + ChatLayout)

                    // Thread panel (side panel on desktop, full-screen overlay on mobile).
                    // Always in the layout, width-driven — NOT an `if` conditional, and
                    // sized from the same `thread-panel-w` expression as the chat column
                    // (see chat-panel-area) so the two always sum to the row width.
                    ThreadPanel {
                        visible: root.thread-panel-visible;
                        x: parent.width - self.width;
                        y: 0;
                        width: chat-panel-area.thread-panel-w;
                        height: 100%;
                        // Same expression `thread-panel-w` uses to give the panel
                        // the whole row: at that width it is a pushed page, so it
                        // dismisses with a back chevron rather than an X.
                        mobile: root.is-small-screen;
                        root-message-id: root.thread-root-message-id;
                        root-sender-name: root.thread-root-sender-name;
                        root-content-preview: root.thread-root-content-preview;
                        reply-count: root.thread-reply-count;
                        channel-name: root.channel-name;  // threads open on the active conversation
                        conversation-kind: root.conversation-kind;
                        replies: root.thread-replies;
                        loading: root.thread-loading;
                        composer-text <=> root.thread-composer-text;

                        close-clicked => { root.close-thread-clicked(); }
                        send-reply(text) => { root.send-thread-reply(text); }
                        load-more-replies => { root.load-more-thread-replies(); }
                        open-message-link(url) => { root.open-message-link(url); }
                        message-clicked(id) => { root.message-clicked(id); }
                        menu-open: root.context-menu-visible || root.reaction-picker-visible;
                        reply-clicked(sender-id, timestamp-ns) => {
                            root.reply-clicked(sender-id, timestamp-ns);
                            root.reply-focus-serial += 1;
                        }
                        quote-clicked(id) => { root.quote-clicked(id); }
                        sender-profile-requested(user-id) => { root.sender-profile-requested(user-id); }
                        current-playing-attachment-id: root.current-playing-attachment-id;
                        is-media-playing: root.is-media-playing;
                        audio-progress: root.audio-progress;
                        audio-elapsed: root.audio-elapsed;
                        view-attachment(id) => {
                            root.viewer-origin-width = 0px;
                            root.view-attachment(id);
                        }
                        audio-seek(id, pos) => { root.audio-seek(id, pos); }
                        more-clicked(sender-id, timestamp-ns, x, y) => {
                            // The panel's own header is the menu's ceiling.
                            root.context-menu-content-top = self.absolute-position.y;
                            root.context-menu-anchor-top = 0px;
                            root.context-menu-anchor-bottom = 0px;
                            root.more-clicked(sender-id, timestamp-ns, x, y);
                        }
                        react-clicked(sender-id, timestamp-ns, x, y) => {
                            root.reaction-picker-sender-id = sender-id;
                            root.reaction-picker-timestamp-ns = timestamp-ns;
                            root.reaction-picker-anchor-x = x;
                            root.reaction-picker-anchor-y = y;
                            root.reaction-picker-visible = true;
                            root.react-clicked(sender-id, timestamp-ns, x, y);
                        }
                        reaction-toggled(sender-id, timestamp-ns, emoji) => {
                            root.reaction-selected(sender-id, timestamp-ns, "", emoji);
                        }
                    }

                } // end chat-panel-area Rectangle
                // Only the leading edge handles the gesture, so message
                // scrolling and text selection remain under the chat pane.
                if root.compact-layout && root.mobile-show-chat: TouchArea {
                    x: 0px;
                    y: Spacing.header-height-touch;
                    width: 24px;
                    height: max(0px, parent.height - self.y - 96px);
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.chat-edge-swiping = true;
                            root.chat-edge-start = self.absolute-position.x + self.mouse-x;
                        }
                        if event.kind == PointerEventKind.move && root.chat-edge-swiping {
                            root.chat-push-progress = 1 - min(1, max(0,
                                (self.absolute-position.x + self.mouse-x - root.chat-edge-start) / root.width));
                        }
                        // The system Back gesture can take this touch away;
                        // only a completed in-app swipe may close the chat.
                        if event.kind == PointerEventKind.cancel {
                            root.chat-edge-swiping = false;
                            root.chat-push-progress = 1;
                        } else if event.kind == PointerEventKind.up {
                            root.chat-edge-swiping = false;
                            if root.chat-push-progress < 0.7 { root.mobile-show-chat = false; }
                            else { root.chat-push-progress = 1; }
                        }
                    }
                }
            } // end inner page stack (sidebar + chat)

                } // end VerticalLayout (chat area)

                // Status notices float over the header. Their animated height
                // changes only this overlay's stack, never the list or chat pane.
                connection-toast := ConnectionBanner {
                    z: 1;
                    x: (parent.width - self.width) / 2;
                    y: self.height > 0px ? Spacing.sm : -self.height - Spacing.sm;
                    width: min(parent.width - Spacing.sm * 2, 620px);
                    suppressed: root.connection-banner-dismissed;
                    connection-state: root.connection-status;
                    server-unreachable: root.server-unreachable;
                    reconnect-attempt: root.connection-reconnect-attempt;
                    dismissed => { root.connection-banner-dismissed = true; }
                    animate y { duration: Materials.motion-standard; easing: Materials.spring; }
                }

                // Shield failure is persistent, but uses the same overlay stack.
                shield-toast := ShieldNetworkBanner {
                    z: 1;
                    x: (parent.width - self.width) / 2;
                    y: connection-toast.height > 0px ? connection-toast.y + connection-toast.height + Spacing.xs : Spacing.sm;
                    width: min(parent.width - Spacing.sm * 2, 620px);
                    animate y { duration: Materials.motion-standard; easing: Materials.spring; }
                }

                // Mesh-only entry stays reachable without occupying list space.
                MeshOnlyBar {
                    z: 1;
                    x: (parent.width - self.width) / 2;
                    y: shield-toast.height > 0px ? shield-toast.y + shield-toast.height + Spacing.xs
                        : connection-toast.height > 0px ? connection-toast.y + connection-toast.height + Spacing.xs : Spacing.sm;
                    width: min(parent.width - Spacing.sm * 2, 620px);
                    signed-in: root.is-signed-in;
                    sign-in => { root.go-to-login(); }
                    animate y { duration: Materials.motion-standard; easing: Materials.spring; }
                }
            } // end main view overlay

        // ========== Modal overlay layer ==========
        // Semi-transparent backdrop when any modal is active. Not under Settings:
        // it is a full-screen page drawn at z -1 (see SettingsScreen below), so a
        // backdrop here would sit over it and turn every tap into a close.
        // One scrim per dialog: each modal draws Materials.scrim itself
        // (ModalContainer, the menus, the intro/recovery sheets), so this
        // layer only blocks and routes the outside tap. A tint here stacked
        // a second dim under every card.
        if active-modal != "none" && active-modal != "settings": Rectangle {
            background: transparent;

            // Block clicks from reaching content below
            TouchArea {
                clicked => {
                    // Close modal when clicking backdrop
                    root.nav-pop();
                }
            }
        }

        if root.is-presented("mesh-setup"): MeshSetupSheet {
            show-modal: root.active-modal == "mesh-setup";
            touch: root.is-mobile-platform;
            close => { root.nav-close("mesh-setup"); }
        }

        // Mesh peer details
        if root.is-presented("mesh-peer"): MeshPeerSheet {
            show-modal: root.active-modal == "mesh-peer";
            close => { root.nav-close("mesh-peer"); }
        }

        // Create Channel Modal
        if root.is-presented("create-channel"): CreateChannelModal {
            show-modal: root.active-modal == "create-channel";
            channel-name <=> root.create-channel-name;
            channel-description <=> root.create-channel-description;
            selected-template <=> root.create-channel-template;
            error-message: root.create-channel-error;
            loading: root.create-channel-loading;
            ai-provider <=> root.create-channel-ai-provider;
            ai-model <=> root.create-channel-ai-model;
            ai-models: root.create-channel-ai-models;
            ai-models-loading: root.create-channel-ai-models-loading;
            ai-models-error: root.create-channel-ai-models-error;
            available-friends <=> root.create-channel-available-friends;
            selected-friend-count <=> root.create-channel-selected-friend-count;
            icon-url <=> root.create-channel-icon-url;
            icon-preview <=> root.create-channel-icon-preview;
            has-icon-preview <=> root.create-channel-has-icon-preview;

            // Join tab state
            active-tab: root.create-channel-initial-tab;
            join-search-query <=> root.join-channel-search-query;
            join-results: root.join-channel-results;
            join-searching: root.join-channel-searching;
            join-error: root.join-channel-error;
            join-selected-id <=> root.join-channel-selected-id;
            join-joining: root.join-channel-joining;

            close => {
                root.nav-close("create-channel");
            }
            join-search(q) => {
                root.search-channels(q);
            }
            join-channel(id) => {
                root.join-channel(id);
            }
            create(name, desc, template, config, ai-provider, ai-model) => {
                root.create-channel(name, desc, template, config, ai-provider, ai-model);
            }
            provider-selected(provider) => {
                root.create-channel-provider-selected(provider);
            }
            pick-channel-icon => {
                root.create-channel-pick-icon();
            }
            create-private-group(name, friends) => {
                root.create-private-group(name, friends);
            }
            toggle-friend-selection(idx) => {
                root.toggle-friend-selection(idx);
            }
            toggle-friend-role(idx) => {
                root.toggle-friend-role(idx);
            }
            template-selected(template) => {
                root.create-channel-template-selected(template);
            }
        }

        // Invite to Private Group Modal
        if root.is-presented("invite-private-group"): InvitePrivateGroupModal {
            show-modal: root.active-modal == "invite-private-group";
            available-friends <=> root.invite-private-group-friends;
            selected-count <=> root.invite-private-group-selected-count;
            loading: root.invite-private-group-loading;

            close => {
                root.nav-close("invite-private-group");
            }
            invite(friends) => {
                root.invite-to-private-group(friends);
            }
            toggle-selection(idx) => {
                root.toggle-invite-friend-selection(idx);
            }
            toggle-role(idx) => {
                root.toggle-invite-friend-role(idx);
            }
        }

        // Invite Member to Channel Modal
        if root.is-presented("invite-member"): InviteMemberModal {
            show-modal: root.active-modal == "invite-member";
            channel-name: root.invite-member-channel-name;
            users <=> root.invite-member-users;
            selected-count <=> root.invite-member-selected-count;
            loading: root.invite-member-loading;

            close => {
                root.nav-close("invite-member");
            }
            toggle-user(idx) => {
                root.invite-member-toggle-user(idx);
            }
            invite => {
                root.invite-member-confirm();
            }
            search-changed(q) => {
                root.invite-member-search-changed(q);
            }
        }

        // User Profile — a pushed screen (anyone's profile, or your own from the
        // account menu's My Profile), over whatever tab it was opened from; Back
        // returns there. Stays mounted under Edit Profile — the only way into
        // that modal is this page's Edit button — so its backdrop dims the
        // profile it edits (§112u).
        if root.is-presented("user-profile") || root.is-presented("edit-profile"): UserProfileModal {
            // Fill the window: left to its preferred height the modal ended
            // where its content was measured to, and on a phone the lower
            // controls painted past that edge received no input.
            width: 100%;
            height: 100%;
            show-modal: root.active-modal == "user-profile" || root.active-modal == "edit-profile";
            user-id: root.profile-user-id;
            is-anonymous: root.profile-is-anonymous;
            scoped-member: root.profile-scoped-member;
            display-name: root.profile-display-name;
            username: root.profile-username;
            avatar-source: root.profile-avatar-source;
            initials: root.profile-initials;
            status-text: root.profile-status-text;
            presence: root.profile-presence;
            bio: root.profile-bio;
            is-friend: root.profile-is-friend;
            is-blocked: root.profile-is-blocked;
            can-start-secret-chat: root.profile-can-start-secret-chat;
            is-self: root.profile-is-self;
            status-mode: root.user-presence-mode;
            loading: root.profile-loading;
            is-verified: root.profile-is-verified;
            safety-number: root.profile-safety-number;
            show-safety-number <=> root.profile-show-safety-number;
            share-link: root.profile-share-link;
            share-qr: root.profile-share-qr;
            share-status: root.profile-share-status;
            last-seen: root.profile-last-seen;
            is-muted: root.profile-is-muted;
            shared-tabs: root.profile-shared-tabs;
            shared-tab <=> root.profile-shared-tab;
            shared-items: root.profile-shared-items;
            shared-loading: root.profile-shared-loading;
            mobile-mode: root.compact-layout;

            close => {
                root.nav-close("user-profile");
                root.profile-show-safety-number = false;
            }
            toggle-mute => {
                root.profile-toggle-mute();
            }
            start-call(is-video) => {
                root.profile-start-call(is-video);
            }
            shared-tab-selected(category) => {
                root.profile-shared-tab = category;
                root.profile-shared-tab-selected(category);
            }
            shared-load-more => {
                root.profile-shared-load-more();
            }
            open-shared-item(message-id, attachment-id, category, selected-url) => {
                root.profile-open-shared-item(message-id, attachment-id, category, selected-url);
            }
            change-status(mode) => {
                root.user-presence-mode = mode;
                root.change-user-status(mode);
            }
            generate-share-link => {
                root.profile-generate-share-link();
            }
            copy-share-link => {
                root.profile-copy-share-link();
            }
            reset-share-link => {
                root.profile-reset-share-link();
            }
            send-message => {
                root.profile-send-message();
            }
            start-secret-chat => {
                root.profile-start-secret-chat();
            }
            add-friend => {
                root.profile-add-friend();
            }
            remove-friend => {
                root.profile-remove-friend();
            }
            block-user => {
                root.profile-block-user();
            }
            // Unblocking lives only in Friends › Blocked.
            manage-blocked => {
                root.friends-modal-tab = "blocked";
                root.nav-close("user-profile");
                root.active-tab = "contacts";
                root.friends-modal-switch-tab("blocked");
            }
            edit-profile => {
                root.profile-edit-profile();
            }
            view-safety-number => {
                root.profile-view-safety-number();
            }
            toggle-verified => {
                root.profile-toggle-verified();
            }
        }

        // Edit Profile Modal
        if root.is-presented("edit-profile"): EditProfileModal {
            show-modal: root.active-modal == "edit-profile";
            display-name <=> root.edit-profile-display-name;
            bio <=> root.edit-profile-bio;
            avatar: root.edit-profile-avatar;
            loading: root.edit-profile-loading;
            error-message: root.edit-profile-error;

            close => {
                root.nav-close("edit-profile");
            }
            save(display-name, bio) => {
                root.edit-profile-save(display-name, bio);
            }
            change-avatar => {
                root.edit-profile-change-avatar();
            }
        }

        // Recovery Codes Modal
        if root.is-presented("recovery-codes"): RecoveryCodesModal {
            show-modal: root.active-modal == "recovery-codes";
            codes: root.recovery-codes;

            confirmed => {
                if root.recovery-codes-confirmed() {
                    if root.recovery-codes-regenerated {
                        root.recovery-codes-regenerated = false;
                        root.nav-close("recovery-codes");
                    } else {
                        // After recovery codes, show the sealed-sender explainer.
                        root.nav-close("recovery-codes");
                        root.nav-push("sealed-sender-intro");
                    }
                }
            }
            copy-all => {
                root.recovery-codes-copy-all();
            }
        }

        // Sealed Sender onboarding explainer (shown right after recovery codes)
        if root.is-presented("sealed-sender-intro"): SealedSenderIntroModal {
            show-modal: root.active-modal == "sealed-sender-intro";
            allow-from-anyone <=> root.settings-sealed-sender-unrestricted;

            confirmed => {
                root.nav-close("sealed-sender-intro");
                root.sealed-sender-intro-confirmed(root.settings-sealed-sender-unrestricted);
            }
        }

        // Link Device Approve Modal (primary side)
        if root.is-presented("link-device-approve"): LinkDeviceApproveModal {
            show-modal: root.active-modal == "link-device-approve";
            link-url <=> root.link-approve-url;
            password <=> root.link-approve-password;
            preview-device-name: root.link-approve-preview-name;
            preview-server-url: root.link-approve-preview-server;
            verification-code: root.link-approve-verification-code;
            preview-ready: root.link-approve-preview-ready;
            status: root.link-approve-status;
            error: root.link-approve-error;
            approving: root.link-approve-busy;

            close => {
                root.nav-close("link-device-approve");
                root.link-approve-close();
            }
            can-scan: root.is-mobile-platform;
            scan => { root.link-approve-scan(); }
            paste-changed(t) => { root.link-approve-paste-changed(t); }
            approve(p) => { root.link-approve-submit(p); }
        }

        if root.is-presented("server-records"): ServerRecordsScreen {
            show: root.active-modal == "server-records";
            mobile-mode: root.compact-layout;
            close => { root.nav-pop(); }
            open-notification(id, kind, target, status) => {
                if id != "" { ServerRecordsGlobal.act(id, "Mark read"); }
                if kind == "friend-request" && status == "Accepted" && target != "" {
                    root.nav-pop();
                    root.active-tab = "chats";
                    root.mobile-show-chat = true;
                    root.friends-start-dm(target);
                } else if kind == "friend-request" && (status == "Declined" || status == "Blocked" || status == "No longer pending") && target != "" {
                    root.nav-pop();
                    root.friends-view-profile(target);
                } else if kind == "friend-request" {
                    root.nav-pop();
                    root.active-tab = "contacts";
                    root.friends-modal-tab = "requests";
                    root.friends-requests-sub-tab = "received";
                } else if kind == "channel-invite" && status == "Joined" && target != "" {
                    root.nav-pop();
                    root.active-tab = "chats";
                    root.mobile-show-chat = true;
                    root.channel-selected(target);
                } else if kind == "channel-invite" {
                    root.nav-pop();
                    root.active-tab = "contacts";
                    root.friends-modal-tab = "requests";
                    root.friends-requests-sub-tab = "channels";
                } else if kind == "friend-accepted" && target != "" {
                    root.nav-pop();
                    root.active-tab = "chats";
                    root.mobile-show-chat = true;
                    root.friends-start-dm(target);
                } else if (kind == "message" || kind == "mention" || kind == "reply" || kind == "reaction") && target != "" {
                    root.nav-pop();
                    root.active-tab = "chats";
                    root.mobile-show-chat = true;
                    root.channel-selected(target);
                }
            }
        }

        // Account menu — the "Profile" tab. A tab screen like Calls and Contacts:
        // z -1, under anything pushed over it and under the bottom bar. Settings
        // and My Profile are pushed from here, so Back returns to it.
        if root.active-tab == "profile": AccountMenu {
            z: -1;
            show-modal: true;
            mobile-mode: root.compact-layout;
            root-screen: true;
            bottom-inset: root.bottom-nav-visible ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom : 0px;
            display-name: root.user-display-name;
            username: root.settings-username;
            avatar: root.user-avatar-source;
            initials: root.user-initials;

            close => {
                root.active-tab = "chats";
            }
            notifications => {
                root.nav-push("server-records");
                ServerRecordsGlobal.open("notifications", "");
            }
            my-profile => {
                root.nav-push("user-profile");
                root.profile-clicked();
            }
            saved-messages => {
                root.active-tab = "chats";
                root.mobile-show-chat = true;
                root.saved-messages-clicked();
            }
            new-channel => {
                root.start-create-channel();
            }
            settings => {
                root.nav-push("settings");
                root.settings-clicked();
            }
        }

        // Calls screen — the "Calls" tab. Like Contacts it is a tab
        // screen, not a modal: z -1 keeps it under anything pushed over it and
        // under the bottom bar, whose strip it leaves free.
        if root.active-tab == "calls": CallHistoryScreen {
            z: -1;
            mobile-mode: root.compact-layout;
            // A tab's root screen: the tab bar navigates, no back chevron.
            root-screen: true;
            // During a call the return bar occupies the strip above the dock.
            // Reserve it for fixed confirmation controls as well as list rows.
            bottom-inset: (root.bottom-nav-visible ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom : 0px)
                + (root.compact-layout && root.active-call-visible ? 44px + Spacing.sm : 0px);
            show-modal: true;
            rows: root.call-history-rows;
            loading: root.call-history-loading;
            paging-paused: root.call-history-paging-paused;
            error-message: root.call-history-error;
            active-filter: root.call-history-filter;
            show-more-menu <=> root.calls-more-menu-visible;
            selecting: root.call-history-selecting;
            selected-count: root.call-history-selected-count;
            retry => { root.call-history-retry(); }
            load-more => { root.call-history-load-more(); }
            toggle-select(id) => { root.call-history-toggle-select(id); }
            select-all(all) => { root.call-history-select-all(all); }
            end-selection => { root.call-history-end-selection(); }
            delete-selected => { root.call-history-delete-selected(); }

            close => {
                root.active-tab = "chats";
            }
            filter-changed(f) => {
                root.call-history-filter = f;
                root.call-history-filter-changed(f);
            }
            open-conversation(id, kind) => {
                root.active-tab = "chats";
                root.mobile-show-chat = true;
                root.call-history-open(id, kind);
            }
            call-back(id, kind, video) => {
                root.active-tab = "chats";
                root.mobile-show-chat = true;
                root.call-history-redial(id, kind, video);
            }
            clear-history => {
                root.call-history-clear();
            }
        }

        // Friends Modal
        if root.active-tab == "contacts": FriendsModal {
            z: -1;
            mobile-mode: root.compact-layout;
            // A tab's root screen: the tab bar navigates, no back chevron.
            root-screen: true;
            // Keep the tab bar visible under the Contacts screen — unless the
            // keyboard has replaced it, in which case there is nothing to leave
            // room for.
            bottom-inset: root.bottom-nav-visible ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom : 0px;
            show-modal: true;
            active-tab <=> root.friends-modal-tab;
            friends: root.friends-list;
            requests-sub-tab <=> root.friends-requests-sub-tab;
            received-requests: root.friends-received-requests;
            sent-requests: root.friends-sent-requests;
            private-requests: root.friends-private-requests;
            private-request-decision: root.private-request-decision;
            group-invites: root.friends-group-invites;
            channel-invites: root.friends-channel-invites;
            blocked-users: root.friends-blocked-users;
            loading: root.friends-loading;
            // Friend code (privacy-first discovery)
            my-code <=> root.friends-my-code;
            code-input <=> root.friends-code-input;
            code-status <=> root.friends-code-status;
            request-note <=> root.friends-request-note;
            qr-code-image <=> root.friends-qr-code-image;
            show-qr <=> root.friends-show-qr;

            close => {
                root.active-tab = "chats";
            }
            switch-tab(tab) => {
                root.friends-modal-switch-tab(tab);
            }
            view-profile(user-id) => {
                root.friends-view-profile(user-id);
            }
            start-dm(user-id) => {
                root.friends-start-dm(user-id);
            }
            accept-request(user-id) => {
                root.friends-accept-request(user-id);
            }
            decline-request(user-id) => {
                root.friends-decline-request(user-id);
            }
            cancel-request(user-id) => {
                root.friends-cancel-request(user-id);
            }
            unblock-user(user-id) => {
                root.friends-unblock-user(user-id);
            }
            remove-blocked-user(user-id) => {
                root.friends-remove-blocked-user(user-id);
            }
            generate-code(private-mode) => {
                root.friends-generate-code(private-mode);
            }
            generate-qr(private-mode) => {
                root.friends-generate-qr(private-mode);
            }
            copy-code => {
                root.friends-copy-code();
            }
            can-scan: root.is-mobile-platform;
            paste-code => {
                root.friends-paste-code();
            }
            scan-code => {
                root.friends-scan-code();
            }
            connect-via-code(code) => {
                root.friends-connect-via-code(code);
            }
            connect-private(code) => {
                root.friends-connect-private(code);
            }
            accept-private-request(conversation-id) => {
                root.friends-accept-private-request(conversation-id);
            }
            decline-private-request(conversation-id) => {
                root.friends-decline-private-request(conversation-id);
            }
            block-private-request(conversation-id) => {
                root.friends-block-private-request(conversation-id);
            }
            accept-group-invite(group-id) => {
                root.friends-accept-group-invite(group-id);
            }
            decline-group-invite(group-id) => {
                root.friends-decline-group-invite(group-id);
            }
            accept-channel-invite(channel-id) => {
                root.friends-accept-channel-invite(channel-id);
            }
            decline-channel-invite(channel-id) => {
                root.friends-decline-channel-invite(channel-id);
            }
        }

        // Forward Message Modal
        if root.is-presented("forward-message"): ForwardMessageModal {
            show-modal: root.active-modal == "forward-message";
            message-preview: root.forward-message-preview;
            search-text <=> root.forward-search-text;
            targets: root.forward-targets;
            loading: root.forward-loading;

            close => {
                root.nav-close("forward-message");
            }
            forward(target-id) => {
                root.forward-message(target-id);
            }
            search-changed(query) => {
                root.forward-search-changed(query);
            }
        }

        // Sessions Modal
        if root.is-presented("sessions"): SessionsModal {
            show-modal: root.active-modal == "sessions";
            sessions: root.sessions;
            error: root.sessions-error;
            loaded: root.sessions-loaded;
            loading: root.sessions-loading;
            revoking: root.sessions-revoking;
            pending-links: root.sessions-pending-links;

            close => {
                root.nav-close("sessions");
            }
            cancel-pending-link(uuid) => {
                root.cancel-pending-link(uuid);
            }
            revoke-session(device-id) => {
                root.revoke-session(device-id);
            }
            revoke-all-others => {
                root.revoke-all-sessions();
            }
            link-new-device => {
                root.link-approve-open();
            }
        }

        // Channel Settings Modal
        // Unified search overlay (opened by the bar or the Ctrl+K / Ctrl+F shortcut).
        UnifiedSearch {
            width: parent.width;
            height: parent.height;
            show: root.unified-search-open;
            source-x: root.compact-layout ? Spacing.sm : 0px;
            source-y: root.macos-titlebar-height;
            source-width: root.compact-layout ? root.width - 2 * Spacing.sm : root.sidebar-is-rail ? Spacing.sidebar-width-collapsed : Spacing.sidebar-width;
            conversations: root.unified-search-conversations;
            messages: root.unified-search-messages;
            searching: root.unified-search-searching;
            query <=> root.unified-search-query;
            selected-index <=> root.unified-search-selected-index;
            category <=> root.unified-search-category;
            sort-order <=> root.unified-search-sort;
            date-filter <=> root.unified-search-date;
            from-filter <=> root.unified-search-from;
            in-filter <=> root.unified-search-in;
            from-label <=> root.unified-search-from-label;
            in-label <=> root.unified-search-in-label;
            picker-options: root.unified-search-picker-options;
            recent-searches: root.unified-search-recents;
            calendar-month: root.unified-search-calendar-month;
            calendar-days: root.unified-search-calendar-days;
            category-counts: root.unified-search-counts;
            page-limits: root.unified-search-page-limits;
            thumbnails: root.unified-search-thumbnails;
            has-thumbnails: root.unified-search-has-thumbnails;
            message-kinds: root.unified-search-message-kinds;
            query-is-handle: root.unified-search-query-is-handle;
            person-status: root.unified-search-person-status;
            person-error: root.unified-search-person-error;
            person-id: root.unified-search-person-id;
            person-name: root.unified-search-person-name;
            person-handle: root.unified-search-person-handle;
            query-changed(q) => { root.unified-search-changed(q); }
            filters-changed(c, s, d, f, i) => { root.unified-search-filters-changed(c, s, d, f, i); }
            recent-selected(q) => { root.unified-search-recent-selected(q); }
            recent-clear => { root.unified-search-recent-clear(); }
            recent-remove(q) => { root.unified-search-recent-remove(q); }
            calendar-shift(delta) => { root.unified-search-calendar-shift(delta); }
            picker-request(kind, query) => { root.unified-search-picker-request(kind, query); }
            show-more(section) => { root.unified-search-show-more(section); }
            resolve(q) => { root.unified-search-resolve(q); }
            person-selected(uid) => {
                root.unified-search-person-selected(uid);
                root.unified-search-open = false;
                root.unified-search-closed();
            }
            conversation-selected(id, t) => {
                root.unified-search-conversation-selected(id, t);
                root.unified-search-open = false;
                root.unified-search-closed();
            }
            message-selected(id) => {
                root.unified-search-message-selected(id);
                root.unified-search-open = false;
                root.unified-search-closed();
            }
            close => {
                root.unified-search-open = false;
                root.unified-search-closed();
            }
            cancel => {
                root.unified-search-query = "";
                root.unified-search-open = false;
                root.unified-search-closed();
            }
        }

        if root.is-presented("channel-settings"): ChannelSettingsModal {
            show-modal: root.active-modal == "channel-settings";
            channel-id: root.channel-settings-id;
            integrations => {
                root.nav-push("server-records");
                ServerRecordsGlobal.open("integrations", root.channel-settings-id);
            }
            server-calls => {
                root.nav-push("server-records");
                ServerRecordsGlobal.open("calls", root.channel-settings-id);
            }
            channel-name: root.channel-settings-name;
            channel-description: root.channel-settings-description;
            channel-name-draft <=> root.channel-settings-name-draft;
            channel-description-draft <=> root.channel-settings-description-draft;
            channel-icon-preview <=> root.channel-settings-icon-preview;
            channel-has-icon-preview <=> root.channel-settings-has-icon-preview;
            channel-avatar-source: root.channel-avatar-source;
            channel-has-avatar: root.channel-settings-id == root.channel-id && root.channel-has-avatar;
            pick-channel-icon => { root.channel-settings-pick-icon(); }
            channel-type: root.channel-settings-type;
            is-archived: root.channel-settings-archived;
            created-at: root.channel-settings-created-at;
            member-count: root.channel-settings-member-count;
            can-edit: root.channel-settings-can-edit;
            can-manage-members: root.channel-settings-can-manage-members;
            can-archive: root.channel-settings-can-archive;
            can-delete: root.channel-settings-can-delete;
            is-owner: root.channel-settings-is-owner;
            can-leave: root.channel-settings-can-leave;
            group-blocked: root.channel-settings-group-blocked;
            notification-preference <=> root.channel-settings-notification-pref;
            is-muted <=> root.channel-settings-muted;
            ai-enabled <=> root.channel-settings-ai-enabled;
            toggle-ai(value) => { root.channel-settings-toggle-ai(value); }
            members: root.channel-settings-members;
            banned-members: root.channel-settings-banned-members;
            can-view-bans: root.channel-settings-can-view-bans;
            loading: root.channel-settings-loading;
            saving: root.channel-settings-saving;
            error-message: root.channel-settings-error;

            close => {
                root.nav-close("channel-settings");
            }
            save-settings(name, description) => {
                root.channel-settings-save(name, description);
            }
            change-notification(level) => {
                root.channel-settings-change-notification(level);
            }
            toggle-mute(muted) => {
                root.channel-settings-toggle-mute(muted);
            }
            change-member-role(user-id, role) => {
                root.channel-settings-change-member-role(user-id, role);
            }
            ban-member(user-id) => {
                root.channel-settings-ban-member(user-id);
            }
            set-member-muted(user-id, muted, minutes) => {
                root.channel-settings-set-member-muted(user-id, muted, minutes);
            }
            unban-member(user-id) => {
                root.channel-settings-unban-member(user-id);
            }
            transfer-ownership(user-id) => {
                root.channel-settings-transfer-ownership(user-id);
            }
            block-member(user-id, block) => {
                root.channel-settings-block-member(user-id, block);
            }
            block-group(block) => {
                root.channel-settings-block-group(block);
            }
            remove-member(user-id) => {
                root.channel-settings-remove-member(user-id);
            }
            invite-members => {
                root.channel-settings-invite-members();
            }
            invite-channel-members => {
                root.channel-settings-invite-channel-members();
            }
            archive-channel => {
                root.channel-settings-archive();
            }
            leave-channel => {
                root.channel-settings-leave();
            }
            delete-channel => {
                root.channel-settings-delete();
            }
        }

        // Anon Mode PIN gate
        if root.is-presented("anon-mode-pin"): AnonModePinModal {
            show-modal: root.active-modal == "anon-mode-pin";
            pin <=> root.anon-mode-pin;
            error: root.anon-mode-pin-error;
            verifying: root.anon-mode-verifying;

            close => {
                root.nav-close("anon-mode-pin");
            }
            submit(pin) => {
                root.submit-anon-mode-pin(pin);
            }
        }

        // Create/Rename Section Modal
        // The '+' create menu: from the Chats tab's floating button on a phone,
        // from the sidebar header's '+' on two-pane. Replaces the in-list
        // "+ New Channel" / "+ New Section" rows (owner decision 2026-09-26).
        if root.is-presented("create-menu"): CreateMenu {
            show: root.active-modal == "create-menu";
            // Two-pane: right-aligned under the sidebar header's '+', but never
            // past the window's left edge. The card is as wide as the panel, so
            // "panel width minus card minus inset" came out at -8px and the
            // menu opened clipped off the left of every tablet and desktop.
            card-x: root.compact-layout
                ? root.width - self.card-width - Spacing.xl
                : max(Spacing.sm, min(root.width - self.card-width - Spacing.sm,
                    Spacing.sidebar-width - self.card-width - Spacing.sm));
            // This layer is in window coordinates; the sidebar header it drops
            // from starts below the status bar (the content layer's
            // safe-area-top), so the inset is added here or the card covers
            // the row that opened it.
            card-y: root.compact-layout
                ? root.fab-y - self.card-height - Spacing.sm
                : root.safe-area-top + Spacing.xs
                    + (root.is-mobile-platform ? Spacing.header-height-touch : Spacing.header-height);
            close => { root.nav-close("create-menu"); }
            new-chat => {
                root.nav-close("create-menu");
                root.nav-push("new-chat");
            }
            new-channel => {
                root.nav-close("create-menu");
                root.start-create-channel();
            }
            new-section => {
                root.nav-close("create-menu");
                root.start-create-section();
            }
        }

        // The chat header's ⋯ menu, dropped from the top-right of the chat
        // pane (the header's trailing edge on a phone and on two-pane).
        if root.is-presented("pinned-messages"): PinnedMessagesModal {
            show-modal: root.active-modal == "pinned-messages";
            items: root.pinned-items;
            close => { root.nav-close("pinned-messages"); }
            selected(message-id) => { root.pinned-item-selected(message-id); }
        }

        if root.is-presented("chat-menu"): ChatHeaderMenu {
            show: root.active-modal == "chat-menu";
            show-video-call: root.chat-menu-video;
            show-settings: root.chat-menu-settings;
            show-secret-chat: root.chat-menu-secret-chat;
            show-disappearing: root.conversation-kind == ConversationKind.anon-dm;
            show-pinned: root.pinned-total-count > 0
                || root.conversation-kind == ConversationKind.saved-messages;
            pinned => { root.nav-close("chat-menu"); root.pinned-show-clicked(); }
            card-x: root.width - self.card-width - Spacing.sm;
            card-y: (root.is-mobile-platform ? Spacing.xs + Spacing.header-height-touch : Spacing.header-height) + Spacing.xs;
            close => { root.nav-close("chat-menu"); }
            video-call => {
                root.nav-close("chat-menu");
                root.start-video-call();
            }
            settings => {
                root.nav-close("chat-menu");
                root.chat-settings-clicked();
            }
            secret-chat => {
                root.nav-close("chat-menu");
                root.chat-menu-start-secret-chat();
            }
            disappearing => { root.nav-close("chat-menu"); root.nav-push("secret-timer"); }
        }

        if root.is-presented("secret-timer"): SecretTimerModal {
            show-modal: root.active-modal == "secret-timer";
            close => { root.nav-close("secret-timer"); }
            choose(seconds) => { root.secret-timer-set(seconds); root.nav-close("secret-timer"); }
        }

        if root.is-presented("new-chat"): NewChatPicker {
            show: root.active-modal == "new-chat";
            mobile-mode: root.compact-layout;
            friends: root.friends-list;
            close => { root.nav-close("new-chat"); }
            // Same path as Contacts' Message button: core opens the DM and
            // returns to Chats with the conversation showing.
            pick(user-id) => { root.friends-start-dm(user-id); }
        }

        if root.is-presented("create-section"): CreateSectionModal {
            show-modal: root.active-modal == "create-section";
            rename-mode: root.create-section-rename-mode;
            section-name <=> root.create-section-name;
            selected-emoji <=> root.create-section-emoji;
            section-id: root.create-section-id;
            loading: root.create-section-loading;

            close => {
                root.nav-close("create-section");
            }
            create-section(name, emoji) => {
                root.create-section(name, emoji);
            }
            rename-section(id, name, emoji) => {
                root.rename-section(id, name, emoji);
            }
        }

        // Keyboard shortcuts help dialog
        if root.is-presented("keyboard-shortcuts"): shortcuts-host := Rectangle {
            property <bool> shown: root.active-modal == "keyboard-shortcuts";
            width: root.width;
            height: root.height;
            background: Materials.scrim;
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Materials.menu-duration; easing: ease-out; }
            visible: self.shown || self.opacity > 0;

            TouchArea {
                enabled: parent.shown;
                clicked => { root.nav-close("keyboard-shortcuts"); }
            }

            GlassSurface {
                material-level: 3;
                elevation: 5;

                width: min(420px, parent.width - 32px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                height: min(shortcuts-layout.preferred-height, parent.height - 48px);
                border-radius: Spacing.radius-sheet;
                accessible-role: groupbox;
                accessible-description: "Keyboard shortcuts";

                TouchArea {} // block click-through

                // Hidden the moment the dialog is logically closed: nothing in
                // an invisible subtree is a pointer, key, Tab or accessible
                // target while the shell and scrim finish their fade.
                Rectangle {
                    visible: shortcuts-host.shown;
                    shortcuts-layout := VerticalLayout {
                        padding: Spacing.lg;
                        spacing: Spacing.md;

                        // Header
                        HorizontalLayout {
                            height: Spacing.header-action-box;
                            Text {
                                text: "Keyboard Shortcuts";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            DismissButton {
                                enabled: shortcuts-host.shown;
                                clicked => { root.nav-close("keyboard-shortcuts"); }
                            }
                        }

                        Rectangle { height: 1px; background: Colors.surface-hover; }

                        // Navigation section
                        Text {
                            text: "Navigation";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            font-weight: Typography.semibold;
                        }

                        for shortcut in [
                            { key: "Ctrl + K / Ctrl + F", action: "Search" },
                            { key: "Ctrl + ,", action: "Open settings" },
                            { key: "Ctrl + J", action: "Toggle AI assistant" },
                            { key: "Ctrl + /", action: "Show this dialog" },
                            { key: "Escape", action: "Close modal or panel" },
                        ]: HorizontalLayout {
                            height: 28px;
                            spacing: Spacing.md;

                            Text {
                                text: shortcut.action;
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: key-text.preferred-width + Spacing.md;
                                height: 24px;
                                border-radius: Spacing.radius-sm;
                                background: Colors.surface-hover;

                                key-text := Text {
                                    text: shortcut.key;
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    font-weight: Typography.medium;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: Spacing.xs; }
                    }
                }
            }
        }

        // Jarvis memory browser (centered modal over the backdrop)
        if root.is-presented("jarvis-memory"): Rectangle {
            property <bool> shown: root.active-modal == "jarvis-memory";
            width: root.width;
            height: root.height;
            background: Materials.scrim;
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Materials.sheet-duration; easing: ease-out; }
            visible: self.shown || self.opacity > 0;
            TouchArea { enabled: parent.shown; clicked => { root.nav-close("jarvis-memory"); } }
        }
        if root.is-presented("jarvis-memory"): JarvisMemoryModal {
            show: root.active-modal == "jarvis-memory";
            width: min(860px, parent.width - 32px);
            height: min(560px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            facts: root.jarvis-memory-facts;
            entities: root.jarvis-memory-entities;
            graph-nodes: root.jarvis-memory-graph-nodes;
            graph-edges: root.jarvis-memory-graph-edges;
            stats-label: root.jarvis-memory-stats;
            close => { root.nav-close("jarvis-memory"); }
            select-entity(id) => { root.jarvis-memory-select-entity(id); }
            refresh => { root.jarvis-memory-refresh(); }
        }

        // Settings screen — pushed from the account menu (full-screen page, the
        // tab bar hidden under it). z -1 rather than 0 because what Settings
        // opens (Sessions, Link device, Recovery codes, ...) is declared above
        // and has to draw over it.
        if root.settings-open: SettingsScreen {
            z: -1;
            width: parent.width;
            height: parent.height;
            bottom-inset: root.compact-layout ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom : 0px;
            mobile-platform: root.is-mobile-platform;
            shield-toggled => { root.toggle-anon-mode(); }
            display-name: root.settings-display-name;
            username: root.settings-username;
            session-count: root.settings-session-count;
            sessions: root.sessions;
            pending-links: root.sessions-pending-links;
            sessions-loaded: root.sessions-loaded;
            sessions-loading: root.sessions-loading;
            sessions-revoking: root.sessions-revoking;
            sessions-error: root.sessions-error;
            avatar: root.user-avatar-source;
            current-password <=> root.settings-current-password;
            new-password <=> root.settings-new-password;
            confirm-password <=> root.settings-confirm-password;
            password-changing: root.settings-password-changing;
            password-error: root.settings-password-error;
            read-receipts-enabled <=> root.settings-read-receipts;
            typing-indicators-enabled <=> root.settings-typing-indicators;
            notification-detail <=> root.settings-notification-detail;
            profile-visibility: root.settings-profile-visibility;
            profile-visibility-pending: root.settings-profile-visibility-pending;
            profile-visibility-busy: root.settings-profile-visibility-busy;
            profile-visibility-error: root.settings-profile-visibility-error;
            profile-visibility-pin <=> root.settings-profile-visibility-pin;
            search-shortcut <=> root.search-shortcut-pref;
            identity-fingerprint: root.settings-identity-fingerprint;
            sealed-sender-unrestricted <=> root.settings-sealed-sender-unrestricted;
            username-discoverable <=> root.settings-username-discoverable;
            // Security (PIN / Backup)
            change-pin-current <=> root.settings-change-pin-current;
            change-pin-new <=> root.settings-change-pin-new;
            change-pin-confirm <=> root.settings-change-pin-confirm;
            change-pin-loading: root.settings-change-pin-loading;
            change-pin-error: root.settings-change-pin-error;
            change-pin-success: root.settings-change-pin-success;
            backup-status: root.settings-backup-status;
            backup-retry-pin <=> root.settings-backup-retry-pin;
            backup-retry-loading: root.settings-backup-retry-loading;
            backup-retry-error: root.settings-backup-retry-error;
            // AI settings
            local-ai-enabled <=> root.settings-local-ai-enabled;
            ai-prefer-cloud <=> root.settings-ai-prefer-cloud;
            cloud-ai-mode <=> root.settings-cloud-ai-mode;
            cloud-ai-api-key <=> root.settings-cloud-ai-api-key;
            cloud-ai-configured: root.settings-cloud-ai-configured;
            cloud-ai-status: root.settings-cloud-ai-status;
            cloud-ai-balance: root.settings-cloud-ai-balance;
            local-ai-model-id <=> root.settings-local-ai-model-id;
            local-ai-loading: root.settings-local-ai-loading;
            local-ai-status: root.settings-local-ai-status;
            local-ai-error: root.settings-local-ai-error;
            local-ai-hardware-summary: root.settings-local-ai-hardware-summary;
            local-ai-detecting: root.settings-local-ai-detecting;
            local-ai-providers: root.settings-local-ai-providers;
            local-ai-active-provider: root.settings-local-ai-active-provider;
            local-ai-models: root.settings-local-ai-models;
            local-ai-active-model: root.settings-local-ai-active-model;
            local-ai-catalog: root.settings-local-ai-catalog;
            // Delete-account confirmation
            delete-password <=> root.settings-delete-password;
            delete-loading: root.settings-delete-loading;
            delete-error: root.settings-delete-error;
            recovery-regen-password <=> root.settings-recovery-regen-password;
            recovery-regen-loading: root.settings-recovery-regen-loading;
            recovery-regen-error: root.settings-recovery-regen-error;
            regenerate-recovery-codes(password) => {
                root.settings-regenerate-recovery-codes(password);
            }

            edit-profile-clicked => {
                root.settings-edit-profile();
            }
            change-password(current, new) => {
                root.settings-change-password(current, new);
            }
            view-sessions-clicked => {
                root.nav-push("sessions");
            }
            refresh-sessions => { root.settings-view-sessions(); }
            revoke-session(device-id) => { root.revoke-session(device-id); }
            cancel-pending-link(uuid) => { root.cancel-pending-link(uuid); }
            link-new-device => { root.link-approve-open(); }
            logout-clicked => {
                root.settings-logout();
            }
            delete-account-clicked => {
                root.settings-delete-account();
            }
            delete-account-confirmed(password) => {
                root.settings-delete-account-confirmed(password);
            }
            close-settings => {
                root.nav-close("settings");
            }
            open-licenses => {
                root.open-message-link("https://github.com/xander1421/chatter-linux-client/tree/master/vendor");
            }
            read-receipts-changed(value) => {
                root.settings-read-receipts-changed(value);
            }
            typing-indicators-changed(value) => {
                root.settings-typing-indicators-changed(value);
            }
            notification-detail-changed(value) => {
                root.settings-notification-detail-changed(value);
            }
            profile-visibility-selected(key) => {
                root.settings-profile-visibility-selected(key);
            }
            profile-visibility-confirmed(key, pin) => {
                root.settings-profile-visibility-confirmed(key, pin);
            }
            profile-visibility-cancelled => {
                root.settings-profile-visibility-cancelled();
            }
            search-shortcut-changed(value) => {
                root.settings-search-shortcut-changed(value);
            }
            copy-fingerprint-clicked => {
                root.settings-copy-fingerprint();
            }
            sealed-sender-changed(value) => {
                root.settings-sealed-sender-changed(value);
            }
            username-discoverable-changed(value) => {
                root.settings-username-discoverable-changed(value);
            }
            change-pin(current, new) => {
                root.settings-change-pin(current, new);
            }
            retry-backup(pin) => {
                root.settings-retry-backup(pin);
            }
            message-backup-status: root.settings-message-backup-status;
            export-message-backup(passphrase) => {
                root.settings-export-message-backup(passphrase);
            }
            import-message-backup(passphrase) => {
                root.settings-import-message-backup(passphrase);
            }
            server-message-backup(pin) => {
                root.settings-server-message-backup(pin);
            }
            restore-message-backup(pin) => {
                root.settings-restore-message-backup(pin);
            }
            // AI callbacks
            local-ai-enabled-changed(value) => {
                root.settings-local-ai-enabled-changed(value);
            }
            ai-prefer-cloud-changed(value) => {
                root.settings-ai-prefer-cloud-changed(value);
            }
            cloud-ai-mode-changed(mode) => {
                root.settings-cloud-ai-mode-changed(mode);
            }
            cloud-ai-api-key-changed(key) => {
                root.settings-cloud-ai-api-key-changed(key);
            }
            cloud-ai-refresh-quota => {
                root.settings-cloud-ai-refresh-quota();
            }
            local-ai-load-model(model-id) => {
                root.settings-local-ai-load-model(model-id);
            }
            local-ai-unload-model => {
                root.settings-local-ai-unload-model();
            }
            local-ai-refresh => {
                root.settings-local-ai-refresh();
            }
            local-ai-open-memory => {
                root.nav-push("jarvis-memory");
                root.jarvis-memory-refresh();
            }
            local-ai-select-provider(kind) => {
                root.settings-local-ai-select-provider(kind);
            }
            local-ai-select-model(model) => {
                root.settings-local-ai-select-model(model);
            }
            local-ai-download(tag) => {
                root.settings-local-ai-download(tag);
            }
        }

        // ========== Call overlays (rendered above modals) ==========
        // Incoming call modal
        if root.incoming-presented: IncomingCallModal {
            show: root.incoming-shown;
            call-data: root.incoming-call-data;
            replaces-active: root.incoming-call-replaces-active;

            accept-call => {
                root.accept-incoming-call(root.incoming-call-data.call-id);
            }
            decline-call => {
                root.decline-incoming-call(root.incoming-call-data.call-id);
            }
        }

        // (Active call view is now docked above ChatLayout — see chat column block.)

        // Device picker modal (for audio devices and screen sources)
        if root.device-picker-presented: DevicePicker {
            show: root.device-picker-visible;
            title: root.device-picker-type == "audio" ? "Select Microphone" :
                   root.device-picker-type == "audio_output" ? "Select Speaker" : "Select Screen to Share";
            picker-type: root.device-picker-type;
            audio-devices: root.audio-devices;
            selected-audio-id: root.selected-audio-device-id;
            audio-output-devices: root.audio-output-devices;
            selected-audio-output-id: root.selected-audio-output-id;
            screen-sources: root.screen-sources;
            selected-screen-id: root.selected-screen-source-id;

            audio-selected(id) => {
                root.selected-audio-device-id = id;
                root.device-picker-visible = false;
                root.audio-device-selected(id);
            }
            audio-output-selected(id) => {
                root.selected-audio-output-id = id;
                root.device-picker-visible = false;
                root.audio-output-selected(id);
            }
            screen-selected(id) => {
                root.selected-screen-source-id = id;
                root.device-picker-visible = false;
                root.screen-source-selected(id);
            }
            closed => {
                root.device-picker-visible = false;
            }
        }

        // Image viewer overlay (rendered above modals)
        if root.image-viewer-visible: ImageViewer {
            show: true;
            touch: root.is-mobile-platform;
            source: root.image-viewer-source;
            filename: root.image-viewer-filename;
            size-display: root.image-viewer-size;
            thumbnail-x: root.viewer-origin-x;
            thumbnail-y: root.viewer-origin-y;
            thumbnail-width: root.viewer-origin-width;
            thumbnail-height: root.viewer-origin-height;
            position-label: root.media-viewer-position;
            has-previous: root.media-viewer-has-previous;
            has-next: root.media-viewer-has-next;
            previous-thumbnail: root.media-viewer-previous-thumbnail;
            next-thumbnail: root.media-viewer-next-thumbnail;
            previous => { root.media-viewer-navigate(-1); }
            next => { root.media-viewer-navigate(1); }
            download => { root.media-viewer-export(false); }
            copy-image => { root.media-viewer-export(true); }
            open-downloads => { root.media-viewer-open-downloads(); }


            close => {
                root.image-viewer-visible = false;
                root.close-image-viewer();
                back-scope.focus();
            }
        }

        // Video player overlay (rendered above modals)
        if root.video-player-visible: VideoPlayer {
            show: true;
            frame: root.video-player-frame;
            filename: root.video-player-filename;
            position-label: root.media-viewer-position;
            has-previous: root.media-viewer-has-previous;
            has-next: root.media-viewer-has-next;
            previous => { root.media-viewer-navigate(-1); }
            next => { root.media-viewer-navigate(1); }
            download => { root.media-viewer-export(false); }
            open-downloads => { root.media-viewer-open-downloads(); }

            progress: root.video-player-progress;
            elapsed: root.video-player-elapsed;
            duration: root.video-player-duration;
            is-playing: root.video-player-is-playing;
            volume: root.video-player-volume;

            close => {
                root.video-player-visible = false;
                root.close-video-player();
            }
            toggle-play-pause => {
                root.video-player-toggle-play-pause();
            }
            seek(pos) => {
                root.video-player-seek(pos);
            }
            set-volume(vol) => {
                root.video-player-volume = vol;
                root.video-player-set-volume(vol);
            }
        }

        // Code preview overlay
        if root.code-preview-visible: Rectangle {
            width: 100%;
            height: 100%;
            background: Materials.scrim;

            // Click backdrop to close
            TouchArea {
                clicked => {
                    root.code-preview-visible = false;
                    root.close-code-preview();
                }
            }

            // Centered code panel
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 80px, 900px);
                height: min(parent.height - 80px, 700px);

                // Block backdrop clicks
                TouchArea { }

                CodePreviewPanel {
                    width: 100%;
                    height: 100%;
                    file-name: root.code-preview-filename;
                    language: root.code-preview-language;
                    line-count: root.code-preview-line-count;
                    plain-text: root.code-preview-plain-text;

                    close-clicked => {
                        root.code-preview-visible = false;
                        root.close-code-preview();
                    }

                    copy-clicked => {
                        root.copy-code();
                    }

                    open-external-clicked => {
                        root.open-code-external();
                    }
                }
            }
        }

        // PDF preview overlay
        if root.pdf-preview-visible: Rectangle {
            width: 100%;
            height: 100%;
            background: Materials.scrim;

            // Click backdrop to close
            TouchArea {
                clicked => {
                    root.pdf-preview-visible = false;
                    root.close-pdf-preview();
                }
            }

            // Centered PDF panel
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 40px, 900px);
                height: min(parent.height - 40px, 800px);

                // Block backdrop clicks
                TouchArea { }

                PdfPreviewPanel {
                    width: 100%;
                    height: 100%;
                    file-name: root.pdf-preview-filename;
                    page-count: root.pdf-preview-page-count;
                    current-page: root.pdf-preview-current-page;
                    error-message: root.pdf-preview-error;
                    external-only: root.pdf-preview-external-only;
                    page-image: root.pdf-preview-image;

                    close-clicked => {
                        root.pdf-preview-visible = false;
                        root.close-pdf-preview();
                    }

                    open-external-clicked => {
                        root.open-pdf-external();
                    }

                    page-prev-clicked => {
                        root.pdf-page-prev();
                    }

                    page-next-clicked => {
                        root.pdf-page-next();
                    }
                }
            }
        }

        // Reaction picker overlay
        ReactionPicker {
            show: root.reaction-picker-visible;
            touch: root.is-mobile-platform;
            message-id: root.reaction-picker-message-id;
            sender-id: root.reaction-picker-sender-id;
            timestamp-ns: root.reaction-picker-timestamp-ns;
            emoji-list: root.reaction-picker-emojis;
            selected-category <=> root.reaction-picker-selected-category;
            search-query <=> root.reaction-picker-search-query;
            // Anchor near button. Flip above if no space below. Clamp horizontally.
            position-x: max(8px, min(root.reaction-picker-anchor-x, root.width - 288px));
            position-y: root.reaction-picker-anchor-y + 360px > root.height
                ? max(8px, root.reaction-picker-anchor-y - 360px)
                : root.reaction-picker-anchor-y + 4px;

            reaction-selected(sender-id, timestamp-ns, msg-id, emoji) => {
                root.reaction-picker-visible = false;
                root.reaction-selected(sender-id, timestamp-ns, msg-id, emoji);
            }

            category-changed(category) => {
                root.reaction-picker-category-changed(category);
            }

            search-changed(query) => {
                root.reaction-picker-search-changed(query);
            }

            close => {
                root.reaction-picker-visible = false;
            }
        }

        // Mention autocomplete overlay (positioned above composer cursor)
        MentionAutocomplete {
            show: root.mention-autocomplete-visible;
            suggestions: root.mention-suggestions;
            selected-index: root.mention-selected-index;
            max-popup-width: min(240px, root.width - 32px);
            // Position above the composer
            x: root.sidebar-hidden ? 16px : (root.sidebar-collapsed ? 80px : 280px);
            y: root.height - 80px - (Math.min(root.mention-suggestions.length, 8) * 40px + 16px);

            suggestion-selected(id, display) => {
                root.mention-autocomplete-visible = false;
                root.mention-suggestion-selected(id, display);
            }

            close => {
                root.mention-autocomplete-visible = false;
            }
        }

        if root.is-presented("message-info"): MessageInfoModal {
            show: root.active-modal == "message-info";
            close => { root.nav-close("message-info"); }
        }

        MessageContextMenu {
            show: root.context-menu-visible;
            sender-id: root.context-menu-sender-id;
            timestamp-ns: root.context-menu-timestamp-ns;
            message-id: root.context-menu-message-id;
            position-x: root.context-menu-x;
            // This overlay lives in the same inset content rectangle as the
            // composer. Its height already excludes the IME and system bars.
            position-y: root.context-menu-y - root.safe-area-top;
            content-top: root.context-menu-content-top - root.safe-area-top;
            anchor-top: root.context-menu-anchor-top > 0px
                ? root.context-menu-anchor-top - root.safe-area-top : 0px;
            anchor-bottom: root.context-menu-anchor-bottom > 0px
                ? root.context-menu-anchor-bottom - root.safe-area-top : 0px;
            retry-clicked(id) => { root.message-clicked(id); }
            info-clicked(id) => { MessageInfo.open(id); }
            can-thread: root.conversation-kind == ConversationKind.channel;

            close => {
                root.context-menu-visible = false;
            }
            quick-react(sender-id, timestamp-ns, emoji) => {
                root.context-menu-visible = false;
                root.reaction-selected(sender-id, timestamp-ns, root.context-menu-message-id, emoji);
            }
            more-reactions-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.reaction-picker-sender-id = sender-id;
                root.reaction-picker-timestamp-ns = timestamp-ns;
                root.reaction-picker-message-id = root.context-menu-message-id;
                root.reaction-picker-anchor-x = root.context-menu-x;
                root.reaction-picker-anchor-y = root.context-menu-y;
                root.reaction-picker-visible = true;
                root.react-clicked(sender-id, timestamp-ns, root.context-menu-x, root.context-menu-y);
            }
            thread-clicked(id) => {
                root.context-menu-visible = false;
                root.thread-clicked(id);
            }
            select-clicked(id) => {
                root.context-menu-visible = false;
                root.selection-mode = true;
                root.message-selection-toggled(id);
            }
            reply-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.reply-message(sender-id, timestamp-ns);
                root.reply-focus-serial += 1;
            }
            edit-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.edit-message(sender-id, timestamp-ns);
            }
            delete-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.delete-choosing = true;
                root.delete-choice-everyone = MessageMenuActions.delete-for-everyone;
                root.delete-choice-me = MessageMenuActions.delete-for-me;
                root.delete-confirm-sender = sender-id;
                root.delete-confirm-timestamp = timestamp-ns;
                root.delete-confirm-everyone = false;
                root.delete-confirm-count = 1;
            }
            pin-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.pin-message(sender-id, timestamp-ns);
            }
            forward-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.forward-message-action(sender-id, timestamp-ns);
            }
            copy-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.copy-message(sender-id, timestamp-ns);
            }
            download-clicked(sender-id, timestamp-ns) => {
                root.context-menu-visible = false;
                root.download-message(sender-id, timestamp-ns);
            }
        }

        // A single delete names its message; a multi-select leaves the sender
        // empty and deletes the selection with its confirmed scope.
        if root.delete-confirm-count > 0: DeleteConfirm {
            count: root.delete-confirm-count;
            is-dm: root.conversation-kind == ConversationKind.server-dm || root.conversation-kind == ConversationKind.anon-dm;
            for-everyone: root.delete-confirm-everyone;
            choosing: root.delete-choosing;
            can-delete-everyone: root.delete-choice-everyone;
            can-delete-me: root.delete-choice-me;
            scope-chosen(everyone) => {
                root.delete-confirm-everyone = everyone;
                root.delete-choosing = false;
            }
            cancelled => { root.delete-confirm-count = 0; }
            confirmed => {
                root.delete-confirm-count = 0;
                if root.delete-confirm-everyone {
                    if root.delete-confirm-sender == "" {
                        SelectionChrome.delete-everyone();
                    } else {
                        root.delete-everyone-message(root.delete-confirm-sender, root.delete-confirm-timestamp);
                    }
                } else if root.delete-confirm-sender != "" {
                    root.delete-message(root.delete-confirm-sender, root.delete-confirm-timestamp);
                } else {
                    root.selection-delete-clicked();
                }
            }
        }

        // ========== Return-to-call bar ==========
        // The call view is docked in the conversation pane, so anywhere else — the
        // chat list, Contacts, any modal — nothing said a call was running. Declared
        // after the modals so it sits above them; sits just above the bottom tab
        // bar, whose spacer in the main column also reserves this bar's height.
        // Positioned against `parent` (the inset content layer), like the tab bar:
        // `root.height` counted both system insets a second time and dropped the
        // bar under the tabs.
        // Layered with the tab bar (z -1), under every pushed modal: a dialog's
        // backdrop dims it and takes its taps, so it is live only when no dialog
        // is open — the same rule Signal's in-call bar follows.
        if root.active-call-visible && (root.active-tab != "chats" || root.active-modal != "none"
            || (root.compact-layout && !root.mobile-show-chat)): ReturnToCallBar {
            z: -1;
            call-data: root.active-call-data;
            width: min(420px, parent.width - 2 * Spacing.lg);
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - Spacing.sm - (root.bottom-nav-visible
                ? Spacing.bottom-nav-height + Spacing.sm + root.safe-area-bottom
                : Spacing.lg);
            clicked => {
                root.active-tab = "chats";
                root.mobile-show-chat = true;
                if root.compact-layout {
                    root.active-call-fullscreen = true;
                }
            }
        }

        // ========== Toast notification overlay (top-right) ==========
        Toast {
            show-toast: root.toast-visible;
            message: root.toast-message;
            variant: root.toast-variant;
            max-toast-width: min(360px, root.width - 32px);

            // Top-right is a desktop position. At 411dp the toast is 379px wide —
            // effectively full-bleed — so "top-right" put it squarely over the
            // conversation header, hiding the name of the place the user is in at
            // the exact moment something went wrong there.
            //
            // Narrow screens get the bottom instead, above the composer, which is
            // where Android puts transient messages and where the thumb already is.
            // A width test rather than a platform test, matching the rest of the
            // app's breakpoints (see ui/components/connection_banner.slint).
            property <bool> bottom-anchored: root.width < 520px;

            x: bottom-anchored
                ? (root.width - self.width) / 2
                : root.width - self.width - Spacing.md;
            // Clear of the composer. `parent` is the inset content layer (like the
            // return-to-call bar above), so the system insets are already excluded.
            y: bottom-anchored
                ? parent.height - self.height - 80px
                : Spacing.lg;

            dismissed => {
                root.toast-visible = false;
            }
        }

        // Auto-dismiss timer for toasts
        toast-timer := Timer {
            interval: 5s;
            running: root.toast-visible && (root.secret-chat-starts-pending == 0
                || root.toast-message != "Secret chat is getting ready — will start automatically");
            triggered => {
                root.toast-visible = false;
            }
        }
        // Mobile bottom navigation. Restored as the full multi-tab bar it was
        // designed to be — the previous removal was of a one-tab remnant,
        // which is a different thing: a single tab is decoration, four tabs
        // are navigation, and the destinations (Calls, Contacts, Settings)
        // all existed already, just buried in the rail's bottom cluster
        // where they cost an expand-collapse round trip to reach.
        //
        // Layered at z -1: above the chat column and the tab screens (Contacts,
        // Settings, Calls — which carve a strip out of themselves for it), below
        // every pushed modal, so a dialog's backdrop dims the bar and takes its
        // taps instead of letting the user switch tabs out from under the dialog.
        // A matching spacer up in the main column reserves its height.
        // Hidden while the IME is up, where it would otherwise sit on the keyboard.
        // Not inside a conversation: a chat is a pushed screen, and the tab bar
        // belongs to the level you pushed FROM. Keeping it there costs a row of
        // the message view and offers navigation that the back arrow already
        // covers — Telegram drops it on the same transition.
        // Only in the app proper: on login / register / recovery it offered
        // Chats, Settings and Profile to someone who is not signed in.
        // Compose FAB (Signal / Telegram): bottom-right of the Chats tab, inset
        // from the dock's edge and clear above it. Above the list (-2) and the
        // dock (-1), under every modal and overlay (0) — the incoming-call screen
        // and toasts are not covered by fab-visible, so they must stay on top.
        if root.fab-visible: GlassSurface {
            z: -0.5;
            width: Spacing.fab-size;
            height: Spacing.fab-size;
            x: parent.width - self.width - Spacing.xl;
            y: root.fab-y;
            border-radius: self.width / 2;
            clip: true;
            material-level: 2;
            material-tint: Appearance.glass-effects ? Materials.fab-base : Colors.action-fill;
            background: transparent;
            transform-scale-x: fab-touch.pressed ? 0.92 : 1;
            transform-scale-y: fab-touch.pressed ? 0.88 : 1;
            animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
            animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
            // Keep the teal tint inside the lit rim and the white glyph clear.
            Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: self.height / 2;
                background: Appearance.glass-effects
                    ? (fab-touch.pressed ? Colors.action-active.with-alpha(0.68)
                        : fab-touch.has-hover ? Colors.action-hover.with-alpha(0.58)
                        : Materials.fab-accent)
                    : (fab-touch.pressed ? Colors.action-active
                        : fab-touch.has-hover ? Colors.action-hover : transparent);
            }
            accessible-role: button;
            accessible-label: "Create";
            accessible-action-default => { root.nav-push("create-menu"); }
            Image {
                source: Icons.plus;
                width: 24px;
                height: 24px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.on-action;
            }
            fab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.nav-push("create-menu"); } }
        }

        if root.bottom-nav-visible: MobileBottomNav {
            z: -1;
            width: parent.width;
            y: parent.height - self.height;
            active-tab: root.active-tab;
            user-avatar: root.user-avatar-source;
            chats-badge: root.total-unread-count;
            calls-badge: root.missed-call-count;
            contacts-badge: root.friends-received-requests.length;
            safe-area-bottom: root.safe-area-bottom;
            tab-selected(tab) => {
                if (tab == "chats") {
                    // Back to the list from wherever you are — this tab is
                    // what replaced the rail as always-available navigation.
                    root.active-tab = "chats";
                    root.mobile-show-chat = false;
                    root.sidebar-user-collapsed = false;
                    root.sidebar-collapsed = false;
                } else if (tab == "calls") {
                    root.active-tab = "calls";
                    root.calls-tab-clicked();
                } else if (tab == "contacts") {
                    // Land on the contacts list. The default tab is the
                    // add-by-code form, which is the right landing spot for
                    // a "Friends" dialog opened deliberately, and the wrong
                    // one for a Contacts tab you press to see your contacts.
                    root.friends-modal-tab = "friends";
                    root.active-tab = "contacts";
                } else if (tab == "profile") {
                    root.active-tab = "profile";
                }
            }
        }
        }
    }

    // A single transparent wash crosses the chrome as Shield changes state.
    // No pointer item is placed here, so controls underneath keep their hit
    // targets and the signed-in/onboarding Tor behavior remains independent.
    Rectangle {
        z: 10;
        width: root.width;
        height: root.height;
        background: Appearance.dark
            ? @linear-gradient(145deg, #36d9ba18 0%, #238cdb0c 100%)
            : @linear-gradient(145deg, #14ab8d14 0%, #547fd20a 100%);
        opacity: AnonMode.enabled ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Materials.motion-emphasized; easing: Materials.glide; }
    }
}
