                sidebar-hidden : root.sidebar-hidden;
                sidebar-is-rail : root.sidebar-is-rail;
                sidebar-user-collapsed <=> root.sidebar-user-collapsed;
                thread-composer-text <=> root.thread-composer-text;
                thread-loading : root.thread-loading;
                thread-panel-visible : root.thread-panel-visible;
                thread-replies : root.thread-replies;
