// Skeleton loading placeholder component

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Materials } from "../theme/materials.slint";

export component Skeleton inherits Rectangle {
    // Default dimensions (can be overridden by parent)
    width: 100px;
    height: 20px;
    border-radius: Spacing.radius-sm;

    // Base color
    background: Colors.surface-control;
    clip: true;

    // Shimmer overlay that animates across
    Rectangle {
        property <length> shimmer-offset;

        // Start position off-screen left, animate to off-screen right
        x: shimmer-offset - self.width;
        y: 0;
        width: parent.width * 0.5;
        height: parent.height;

        // Gradient-like shimmer using lighter surface color
        background: @linear-gradient(90deg, transparent 0%, Colors.surface-hover 50%, transparent 100%);

        // Continuous shimmer animation
        shimmer-offset: 0px;
        animate shimmer-offset {
            // Reduce animations: a still placeholder.
            duration: Appearance.reduce-motion ? 0ms : Materials.motion-emphasized * 3;
            iteration-count: Appearance.reduce-motion ? 1 : -1;
            easing: Materials.glide;
        }

        // Trigger animation by setting final value
        init => {
            self.shimmer-offset = parent.width * 2;
        }
    }
}

// Matches ChatRow's occupied height and avatar/text geometry, so replacing
// these placeholders with cached or synced rows does not shift the list.
export component ChatListSkeleton inherits Rectangle {
    in property <bool> mobile-mode: false;
    height: root.mobile-mode ? Spacing.row-height-touch : Spacing.row-height-desktop;
    background: transparent;

    HorizontalLayout {
        padding-left: Spacing.sm;
        padding-right: Spacing.sm;
        spacing: Spacing.sm;
        alignment: center;

        Skeleton {
            width: root.mobile-mode ? Spacing.row-avatar-touch : Spacing.row-avatar-desktop;
            height: self.width;
            border-radius: self.height / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: Spacing.xs;
            Skeleton { width: 112px; height: 13px; }
            Skeleton { width: 168px; height: 10px; }
        }
    }
}
