import { GlassSurface } from "glass_surface.slint";
// Mobile bottom navigation bar
//
// Shows tab bar with Chats, Mesh, Calls, Contacts, Profile on mobile screens.
// Hidden when keyboard is open (safe-area-bottom > nav bar threshold).

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";

component NavTab inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    // Profile shows the user's own avatar rather than a glyph — it is the one
    // tab that means "you", and an outlined person icon says that far less
    // directly than the face already on the account.
    in property <image> avatar;
    in property <bool> use-avatar: false;
    callback clicked();

    height: Spacing.bottom-nav-height;
    horizontal-stretch: 1;
    background: transparent;
    transform-scale-x: touch.pressed ? 0.92 : 1;
    transform-scale-y: touch.pressed ? 0.88 : 1;
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: touch.pressed ? 9px : 5px;
        y: touch.pressed ? 9px : 5px;
        width: parent.width - (touch.pressed ? 18px : 10px);
        height: parent.height - (touch.pressed ? 18px : 10px);
        border-radius: self.height / 2;
        background: touch.pressed ? Materials.pressed : transparent;
        animate x { duration: Materials.feedback-duration; easing: Materials.spring; }
        animate y { duration: Materials.feedback-duration; easing: Materials.spring; }
        animate width { duration: Materials.feedback-duration; easing: Materials.spring; }
        animate height { duration: Materials.feedback-duration; easing: Materials.spring; }
    }

    VerticalLayout {
        alignment: center;
        spacing: Spacing.xxs;
        padding-top: Spacing.sm;
        padding-bottom: Spacing.sm;

        // Icon with optional badge
        Rectangle {
            width: 24px;
            height: 24px;
            x: (parent.width - self.width) / 2;

            if !root.use-avatar: Image {
                source: root.icon;
                width: 24px;
                height: 24px;
                colorize: Colors.text-primary;
            }

            if root.use-avatar: Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                clip: true;
                // Ringed when active, so it reads as selected the same way a
                // colorized glyph does.
                border-width: root.active ? Spacing.stroke : 0px;
                border-color: Colors.primary;
                Image {
                    source: root.avatar;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }

            // Badge dot
            if root.badge-count > 0: Rectangle {
                x: 16px;
                y: -2px;
                width: max(self.height, nav-badge-text.preferred-width + 6px);
                height: Spacing.badge-sm;
                border-radius: self.height / 2;
                background: Colors.error-hover;

                nav-badge-text := Text {
                    text: root.badge-count > 99 ? "99+" : root.badge-count;
                    font-size: Typography.xxs;
                    font-weight: 700;
                    color: Colors.on-error;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Label
        Text {
            text: root.label;
            width: parent.width;
            overflow: elide;
            font-size: Typography.xs2;
            font-weight: root.active ? 600 : 400;
            color: Colors.text-primary;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MobileBottomNav inherits Rectangle {
    in property <string> active-tab: "chats";
    in property <image> user-avatar;
    in property <int> chats-badge: 0;
    in property <bool> mesh-available: false;
    in property <int> mesh-badge: 0;
    in property <int> calls-badge: 0;
    in property <int> contacts-badge: 0;
    // Extra padding at the bottom to extend behind the system gesture area
    in property <length> safe-area-bottom: 0px;
    callback tab-selected(/* tab */ string);

    // Floating dock, not a bar welded to the bottom edge. The tabs live on a
    // rounded translucent slab inset from all three edges, so the conversation
    // list scrolls visibly beneath it — same Neo glassmorphism the chat header
    // already uses (chat_header.slint: translucent surface + edge highlight),
    // not a new visual language.
    //
    // The dock shares the chrome material; GlassSurface owns backdrop blur.
    in property <length> side-inset: Spacing.md;
    in property <length> bottom-gap: Spacing.sm;
    // What the dock occupies in total, for whoever reserves space for it.
    out property <length> occupied-height:
        Spacing.bottom-nav-height + root.bottom-gap + root.safe-area-bottom;

    height: root.occupied-height;
    background: transparent;

    dock := GlassSurface {
        clip: true;
        material-level: 2;
        background: transparent;

        x: root.side-inset;
        y: 0;
        width: parent.width - root.side-inset * 2;
        height: Spacing.bottom-nav-height;
        border-radius: self.height / 2;
    }

    // Equal columns, positioned explicitly rather than by a
    // HorizontalLayout. `horizontal-stretch` on the tabs does not spread them
    // here — with or without an explicit width on the layout they stay packed
    // against the left edge — so the widths are computed directly.
    // No Shield tab: Shield is a mode of the chat list, toggled from its
    // header (sidebar.slint), not a destination. No Settings tab: it is
    // pushed from the Profile tab's account menu (owner decisions 2026-09-26).
    property <length> tab-width: (root.width - root.side-inset * 2) / (root.mesh-available ? 5 : 4);
    property <int> selected-index: root.active-tab == "mesh" && root.mesh-available ? 1
        : root.active-tab == "calls" ? (root.mesh-available ? 2 : 1)
        : root.active-tab == "contacts" ? (root.mesh-available ? 3 : 2)
        : root.active-tab == "profile" ? (root.mesh-available ? 4 : 3) : 0;
    property <length> selected-x: root.side-inset + root.tab-width * root.selected-index
        + 5px;
    property <length> head-x: root.selected-x;
    property <length> tail-x: root.selected-x;
    animate head-x { duration: Materials.motion-standard; easing: Materials.spring; }
    animate tail-x { duration: Materials.motion-emphasized; easing: Materials.glide; }

    // Two edges travel at different speeds. Their joined capsule stretches
    // between tabs and gathers back into a single selected drop at rest.
    selection-drop := Rectangle {
        x: min(root.head-x, root.tail-x);
        y: 5px;
        width: root.tab-width - 10px + abs(root.head-x - root.tail-x);
        height: Spacing.bottom-nav-height - 10px;
        border-radius: self.height / 2;
        background: Colors.text-primary.with-alpha(Appearance.dark ? 0.17 : 0.11);
    }

    NavTab {
        x: root.side-inset;
        y: 0;
        width: root.tab-width;
        icon: Icons.message-circle;
        label: "Chats";
        active: root.active-tab == "chats";
        badge-count: root.chats-badge;
        clicked => { root.tab-selected("chats"); }
    }

    if root.mesh-available: NavTab {
        x: root.side-inset + root.tab-width;
        y: 0;
        width: root.tab-width;
        icon: Icons.radio;
        label: "Mesh";
        active: root.active-tab == "mesh";
        badge-count: root.mesh-badge;
        clicked => { root.tab-selected("mesh"); }
    }

    NavTab {
        x: root.side-inset + root.tab-width * (root.mesh-available ? 2 : 1);
        y: 0;
        width: root.tab-width;
        icon: Icons.phone;
        label: "Calls";
        active: root.active-tab == "calls";
        badge-count: root.calls-badge;
        clicked => { root.tab-selected("calls"); }
    }

    NavTab {
        x: root.side-inset + root.tab-width * (root.mesh-available ? 3 : 2);
        y: 0;
        width: root.tab-width;
        icon: Icons.users;
        label: "Contacts";
        active: root.active-tab == "contacts";
        badge-count: root.contacts-badge;
        clicked => { root.tab-selected("contacts"); }
    }

    NavTab {
        x: root.side-inset + root.tab-width * (root.mesh-available ? 4 : 3);
        y: 0;
        width: root.tab-width;
        label: "Profile";
        avatar: root.user-avatar;
        // No photo (none set, or not loaded yet): the person glyph, not an
        // empty ring (REVIEW-R4 P1-4).
        use-avatar: root.user-avatar.width > 0;
        icon: Icons.user;
        active: root.active-tab == "profile";
        clicked => { root.tab-selected("profile"); }
    }
}
