import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "glass_surface.slint";
// Unified search — full-window overlay palette.
// Replaces QuickSwitcher (Ctrl+K) and SearchModal (Ctrl+F).
//
// Opened from the sidebar "Search" row (top, above Saved Messages) or the
// Ctrl+K / Ctrl+F shortcut. The overlay remains mounted so its native input
// keeps its identity while the palette grows and recedes.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export struct QuickSwitcherItem {
    id: string,
    name: string,
    // "channel", "dm", "private_group", "anon_dm"
    conv-type: string,
    presence-status: string,
    unread-count: int,
    avatar: image,
    has-avatar: bool,
}

export struct SearchResult {
    message-id: string,
    channel-id: string,
    channel-name: string,
    sender-name: string,
    content-preview: string,
    timestamp: string,
    highlight-start: int,
    highlight-end: int,
    preview-before: string,
    preview-match: string,
    preview-after: string,
}

export struct CalendarDay {
    date: string,
    label: string,
    in-month: bool,
}

// One "Jump to" conversation row.
component ConvRow inherits Rectangle {
    in property <bool> interactive: true;
    in property <string> item-id;
    in property <string> name;
    in property <string> conv-type;
    in property <int> unread-count;
    in property <bool> selected: false;
    callback clicked(string, string);

    // 48px, matching every other tappable row in the app. Search is opened by
    // someone who already knows where they are going, so mis-tapping here costs
    // them the whole trip — and at 40px this was the shortest target on screen.
    height: Spacing.touch-target-min * Appearance.text-grow;
    border-radius: Spacing.radius-sm;
    background: touch.pressed ? Materials.pressed : root.selected ? Colors.selected : touch.has-hover ? Colors.surface-hover : transparent;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: touch.pressed ? 98% : 100%;
    transform-scale-y: touch.pressed ? 96% : 100%;
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.item-id, root.conv-type); }
    }

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.sm;
        // The sidebar's line glyphs, not emoji: a colour 🔖 beside grey
        // text read as a different app, and emoji need a colour font Android
        // 10 may not have.
        if root.conv-type != "mesh": VerticalLayout {
            alignment: center;
            width: 20px;
            Image {
                source: root.conv-type == "saved_messages" ? Icons.bookmark
                      : root.conv-type == "channel" ? Icons.hash
                      : root.conv-type == "private_group" ? Icons.users
                      : Icons.user;
                width: 16px;
                height: 16px;
                colorize: root.selected ? Colors.primary : Colors.text-muted;
            }
        }
        // "))" is the mesh mark: radio waves, matching the sidebar glyph —
        // a jump target that reaches no server looks different from one
        // that does.
        if root.conv-type == "mesh": Text {
            text: "))";
            color: root.selected ? Colors.primary : Colors.text-muted;
            font-size: Typography.sm;
            font-weight: Typography.semibold;
            width: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.name;
            color: root.selected ? Colors.text-primary : Colors.text-secondary;
            font-size: Typography.sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.unread-count > 0: Rectangle {
            width: 20px; height: 20px; border-radius: 10px;
            background: Colors.action-fill; y: (parent.height - self.height) / 2;
            Text {
                text: root.unread-count > 99 ? "99+" : root.unread-count;
                color: Colors.on-action; font-size: Typography.xs;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
    }
}

// One "Messages" content row.
component MsgRow inherits Rectangle {
    in property <bool> interactive: true;
    in property <string> message-id;
    in property <string> channel-name;
    in property <string> sender-name;
    in property <string> content-preview;
    in property <string> preview-before;
    in property <string> preview-match;
    in property <string> preview-after;
    in property <string> timestamp;
    in property <string> match-term;
    in property <int> highlight-start: 0;
    in property <int> highlight-end: 0;
    in property <bool> selected: false;
    callback clicked(string);

    height: 56px * Appearance.text-grow;
    border-radius: Spacing.radius-sm;
    background: touch.pressed ? Materials.pressed : root.selected ? Colors.selected : touch.has-hover ? Colors.surface-hover : transparent;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: touch.pressed ? 98% : 100%;
    transform-scale-y: touch.pressed ? 96% : 100%;
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.message-id); }
    }

    VerticalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        padding-top: Spacing.xs;
        padding-bottom: Spacing.xs;
        spacing: Spacing.xxs;
        HorizontalLayout {
            spacing: Spacing.sm;
            Text {
                text: root.sender-name;
                color: Colors.text-primary;
                font-size: Typography.xs;
                font-weight: Typography.semibold;
            }
            Text {
                text: root.channel-name;
                color: Colors.text-muted;
                font-size: Typography.xs;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.timestamp;
                color: Colors.text-muted;
                font-size: Typography.xs;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Text { text: root.preview-before; color: Colors.text-secondary; font-size: Typography.sm; }
            Text { text: root.preview-match; color: Colors.primary; font-size: Typography.sm; font-weight: Typography.semibold; }
            Text { text: root.preview-after; color: Colors.text-secondary; font-size: Typography.sm; horizontal-stretch: 1; overflow: elide; }
        }
    }
}

// One resolved "People" row (exact-handle lookup result).
component PersonRow inherits Rectangle {
    in property <bool> interactive: true;
    in property <string> name;
    in property <string> handle;
    callback clicked();

    height: Spacing.touch-target-min * Appearance.text-grow;
    border-radius: Spacing.radius-sm;
    background: touch.pressed ? Materials.pressed : touch.has-hover ? Colors.surface-hover : transparent;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: touch.pressed ? 98% : 100%;
    transform-scale-y: touch.pressed ? 96% : 100%;
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.sm;
        Text {
            text: "👤";
            color: Colors.primary;
            font-size: Typography.sm;
            width: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        VerticalLayout {
            padding-top: Spacing.xs;
            padding-bottom: Spacing.xs;
            Text {
                text: root.name;
                color: Colors.text-primary;
                font-size: Typography.sm;
            }
            Text {
                text: "@" + root.handle;
                color: Colors.text-muted;
                font-size: Typography.xs;
            }
        }
    }
}

// Full-window overlay palette (rendered at the window root via `if open`).
export component UnifiedSearch inherits Rectangle {
    in property <bool> show: false;
    in property <[QuickSwitcherItem]> conversations: [];
    in property <[SearchResult]> messages: [];
    in property <bool> searching: false;
    in property <length> source-x: 12px;
    in property <length> source-y: 12px;
    in property <length> source-width: 240px;
    in-out property <string> query: "";
    in-out property <int> selected-index: 0;
    in-out property <string> category: "all";
    in-out property <string> sort-order: "relevance";
    in-out property <string> date-filter: "any";
    in-out property <string> from-filter: "";
    in-out property <string> in-filter: "";
    in-out property <string> from-label: "";
    in-out property <string> in-label: "";
    in property <[QuickSwitcherItem]> picker-options: [];
    property <string> picker-mode: "";
    property <string> picker-query: "";
    callback picker-request(string, string);
    in property <[string]> recent-searches: [];
    in property <[int]> category-counts: [0, 0, 0, 0, 0, 0, 0];
    in property <[int]> page-limits: [50, 50, 50, 50, 50, 50, 50];
    callback show-more(string);
    in property <[image]> thumbnails: [];
    in property <[bool]> has-thumbnails: [];
    in property <[string]> message-kinds: [];
    callback filters-changed(string, string, string, string, string);
    callback recent-selected(string);
    callback recent-clear();
    callback recent-remove(string);
    in-out property <bool> date-sheet-open: false;
    in property <string> calendar-month: "";
    in property <[CalendarDay]> calendar-days: [];
    callback calendar-shift(int);
    property <string> custom-start: "";
    property <string> custom-end: "";
    property <length> calendar-swipe-start: 0px;
    property <bool> calendar-swiped: false;

    callback query-changed(string);
    callback conversation-selected(string, string);
    callback message-selected(string);
    callback close();
    callback cancel();

    // People (exact-handle resolve-on-Enter). `query-is-handle` is set by the
    // glue when the query looks like `nickname.discriminator`. `person-status`:
    // "" idle | "searching" | "found" | "notfound" | "error" (core's
    // user-facing reason in `person-error`).
    in property <bool> query-is-handle: false;
    in property <string> person-status: "";
    in property <string> person-error: "";
    in property <string> person-id: "";
    in property <string> person-name: "";
    in property <string> person-handle: "";
    callback resolve(string);
    callback person-selected(string);

    property <int> total-count: root.conversations.length + root.messages.length;
    property <float> open-progress: root.show ? 1 : 0;
    animate open-progress { duration: Materials.motion-standard; easing: Materials.glide; }
    property <float> shape-progress: root.show ? 1 : 0;
    animate shape-progress { duration: Materials.motion-standard; easing: Materials.spring; }
    property <length> panel-width: min(940px, root.width - 24px);
    changed show => { if root.show { search-input.focus(); } }

    visible: root.show || root.open-progress > 0 || root.shape-progress > 0;

    function activate-selected() {
        if root.selected-index < root.conversations.length {
            root.conversation-selected(
                root.conversations[root.selected-index].id,
                root.conversations[root.selected-index].conv-type);
        } else if root.selected-index < root.total-count {
            root.message-selected(
                root.messages[root.selected-index - root.conversations.length].message-id);
        }
    }

    // Dim backdrop — clicking outside the panel closes.
    GlassSurface {
        width: 100%; height: 100%;
        material-level: 0; material-tint: transparent; elevation: 0;
        opacity: root.open-progress;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: Materials.scrim;
        opacity: root.open-progress;
        TouchArea { enabled: root.show; clicked => { root.close(); } }
    }

    // Palette panel — near top, centered.
    palette := GlassSurface {
        material-level: 3;
        elevation: 4;

        x: root.source-x + ((root.width - root.panel-width) / 2 - root.source-x) * root.open-progress;
        y: root.source-y + (min(42px, parent.height * 0.04) - root.source-y) * root.open-progress;
        width: min(root.source-width, root.panel-width) + (root.panel-width - min(root.source-width, root.panel-width)) * root.shape-progress;
        height: Spacing.touch-target-min + (parent.height - 2 * self.y - Spacing.touch-target-min) * root.shape-progress;
        border-radius: Spacing.radius-xl;
        clip: true;

        // Swallow clicks so they don't reach the backdrop.
        TouchArea { enabled: root.show; }

        content := VerticalLayout {
            opacity: root.show ? 1 : 0;
            animate opacity { duration: Materials.motion-quick; easing: Materials.glide; }
            padding: Spacing.md;
            spacing: Spacing.sm;

            // Search input — focused when the overlay appears.
            Rectangle {
                // The one field on this overlay, and it was 40px: shorter than
                // the rows beneath it and under the touch minimum. Auto-focus
                // hides that on first open and not at all afterwards, when the
                // user taps it to correct a query.
                height: Spacing.touch-target-min;
                // Concentric with the panel: its radius minus the padding.
                border-radius: Spacing.radius-xl - Spacing.md;
                background: Colors.inset;
                border-width: Spacing.stroke;
                border-color: search-input.has-focus ? Colors.primary : Colors.border;

                HorizontalLayout {
                    padding-left: Spacing.md;
                    padding-right: Spacing.md;
                    spacing: Spacing.sm;
                    Image {
                        source: Icons.search;
                        width: 16px; height: 16px;
                        colorize: Colors.text-muted;
                        y: (parent.height - self.height) / 2;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        // The placeholder overlays the field at its text origin,
                        // rather than taking a trailing HorizontalLayout slot.
                        search-input := TextInput {
                            text <=> root.query;
                            font-size: Typography.sm;
                            color: Colors.text-primary;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            single-line: true;
                            edited => {
                                root.selected-index = 0;
                                root.query-changed(root.query);
                            }
                            accepted => {
                                if (root.person-status == "found") {
                                    root.person-selected(root.person-id);
                                } else if (root.query-is-handle) {
                                    root.resolve(root.query);
                                } else {
                                    root.activate-selected();
                                }
                            }
                            key-pressed(event) => {
                                if (event.text == Key.UpArrow) {
                                    if (root.selected-index > 0) { root.selected-index -= 1; }
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.selected-index < root.total-count - 1) { root.selected-index += 1; }
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.close();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        // Shown whenever the field is empty: on a phone it has
                        // focus the whole time, so hiding it on focus meant never.
                        if root.query == "" && search-input.preedit-text == "": search-placeholder := Text {
                            width: 100%;
                            height: 100%;
                            text: "Search…";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }
                    if root.query != "": Rectangle {
                        width: Spacing.touch-target-min; height: Spacing.touch-target-min;
                        border-radius: self.width / 2;
                        background: clear-touch.pressed ? Materials.pressed : clear-touch.has-hover ? Materials.hover : transparent;
                        clear-touch := TouchArea { mouse-cursor: pointer; clicked => { root.query = ""; root.query-changed(""); search-input.focus(); } }
                        Text { text: "×"; color: Colors.text-secondary; font-size: Typography.lg; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 72px; height: Spacing.touch-target-min;
                        border-radius: Spacing.radius-lg;
                        background: cancel-touch.pressed ? Materials.pressed : cancel-touch.has-hover ? Materials.hover : transparent;
                        cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
                        Text { text: "Cancel"; color: Colors.primary; font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // A single persistent input sits above these controls; changing a
            // tab or filter never reparents it, preserving keyboard and IME.
            Flickable {
                height: Spacing.touch-target-min + Spacing.xs;
                viewport-width: tab-row.preferred-width;
                viewport-height: self.height;
                tab-row := HorizontalLayout {
                    spacing: Spacing.xs;
                    for tab[i] in ["All", "Chats", "Messages", "Media", "Files", "Links", "Voice"]: Rectangle {
                        width: max(Spacing.touch-target-min, tab-label.preferred-width + 24px);
                        height: Spacing.touch-target-min;
                        border-radius: Spacing.radius-xl;
                        background: root.category == tab.to-lowercase() ? Colors.selected : tab-touch.pressed ? Materials.pressed : tab-touch.has-hover ? Materials.hover : transparent;
                        animate background { duration: Materials.motion-quick; easing: Materials.spring; }
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale-x: tab-touch.pressed ? 94% : 100%;
                        transform-scale-y: tab-touch.pressed ? 94% : 100%;
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.category = tab.to-lowercase(); root.selected-index = 0; root.filters-changed(root.category, root.sort-order, root.date-filter, root.from-filter, root.in-filter); }
                        }
                        tab-label := Text { text: tab + (root.category-counts[i] > 0 ? " " + (root.category-counts[i] > root.page-limits[i] ? root.page-limits[i] + "+" : root.category-counts[i]) : ""); color: root.category == tab.to-lowercase() ? Colors.primary : Colors.text-secondary; font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            HorizontalLayout {
                spacing: Spacing.xs;
                Rectangle {
                    width: 154px; height: Spacing.touch-target-min; border-radius: Spacing.radius-lg;
                    background: sort-touch.pressed ? Materials.pressed : Colors.inset;
                    sort-touch := TouchArea { mouse-cursor: pointer; clicked => {
                        root.sort-order = root.sort-order == "relevance" ? "newest" : root.sort-order == "newest" ? "oldest" : root.sort-order == "oldest" ? "largest" : "relevance";
                        root.filters-changed(root.category, root.sort-order, root.date-filter, root.from-filter, root.in-filter);
                    } }
                    Text { text: root.sort-order == "relevance" ? "Relevance" : root.sort-order == "newest" ? "Newest first" : root.sort-order == "oldest" ? "Oldest first" : "Largest first"; color: Colors.text-secondary; font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 146px; height: Spacing.touch-target-min; border-radius: Spacing.radius-lg;
                    background: date-touch.pressed ? Materials.pressed : Colors.inset;
                    date-touch := TouchArea { mouse-cursor: pointer; clicked => { root.date-sheet-open = true; root.calendar-shift(0); } }
                    Text { text: root.date-filter == "any" ? "Any time" : root.date-filter == "today" ? "Today" : root.date-filter == "week" ? "Last 7 days" : root.date-filter == "month" ? "Last 30 days" : root.date-filter == "year" ? "This year" : "Date range"; color: Colors.text-secondary; font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                height: Spacing.touch-target-min;
                spacing: Spacing.xs;
                for kind in ["from", "in"]: Rectangle {
                    width: min(190px, max(92px, picker-chip-label.preferred-width + 24px));
                    height: Spacing.touch-target-min; border-radius: Spacing.radius-lg;
                    background: chip-touch.pressed ? Materials.pressed : Colors.inset;
                    chip-touch := TouchArea { mouse-cursor: pointer; clicked => {
                        root.picker-mode = kind; root.picker-query = ""; root.picker-request(kind, "");
                    } }
                    picker-chip-label := Text { text: kind == "from" ? (root.from-label == "" ? "From" : "From: " + root.from-label) : (root.in-label == "" ? "In" : "In: " + root.in-label);
                        width: parent.width - (((kind == "from" && root.from-filter != "") || (kind == "in" && root.in-filter != "")) ? Spacing.touch-target-min : 0px);
                        color: Colors.text-secondary; font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    if (kind == "from" && root.from-filter != "") || (kind == "in" && root.in-filter != ""): Rectangle {
                        x: parent.width - self.width; width: Spacing.touch-target-min; height: Spacing.touch-target-min; border-radius: self.width / 2;
                        background: unselect-touch.pressed ? Materials.pressed : unselect-touch.has-hover ? Materials.hover : transparent;
                        unselect-touch := TouchArea { mouse-cursor: pointer; clicked => {
                            if (kind == "from") { root.from-filter = ""; root.from-label = ""; }
                            else { root.in-filter = ""; root.in-label = ""; }
                            root.filters-changed(root.category, root.sort-order, root.date-filter, root.from-filter, root.in-filter);
                        } }
                        Text { text: "×"; width: 100%; height: 100%; color: Colors.text-muted; font-size: Typography.lg; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            if root.query == "" && root.recent-searches.length > 0: VerticalLayout {
                height: 24px + root.recent-searches.length * (Spacing.touch-target-min + Spacing.xs);
                vertical-stretch: 0;
                spacing: Spacing.xs;
                HorizontalLayout {
                    height: 24px;
                    vertical-stretch: 0;
                    Text { text: "Recent searches"; color: Colors.text-muted; font-size: Typography.xs; horizontal-stretch: 1; }
                    Text { text: "Clear"; color: Colors.primary; font-size: Typography.sm;
                        TouchArea { mouse-cursor: pointer; clicked => { root.recent-clear(); } }
                    }
                }
                for recent in root.recent-searches: Rectangle {
                    height: Spacing.touch-target-min; border-radius: Spacing.radius-sm;
                    background: recent-touch.pressed ? Materials.pressed : recent-touch.has-hover ? Materials.hover : transparent;
                    recent-touch := TouchArea { mouse-cursor: pointer; clicked => { root.recent-selected(recent); search-input.focus(); } }
                    Text { text: recent; color: Colors.text-secondary; font-size: Typography.sm; x: Spacing.md; width: parent.width - Spacing.touch-target-min - Spacing.md; vertical-alignment: center; height: 100%; overflow: elide; }
                    Rectangle {
                        x: parent.width - self.width; width: Spacing.touch-target-min; height: Spacing.touch-target-min;
                        border-radius: self.width / 2;
                        background: remove-touch.pressed ? Materials.pressed : remove-touch.has-hover ? Materials.hover : transparent;
                        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.recent-remove(recent); } }
                        Text { text: "×"; width: 100%; height: 100%; color: Colors.text-muted; font-size: Typography.lg; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // `query` excludes IME preedit, so while a word is still being
            // composed it reads "" over an emptied list; a header with nothing
            // under it is noise.
            if root.query == "" && root.conversations.length > 0: Text {
                text: "Suggested chats";
                color: Colors.text-muted;
                font-size: Typography.xs;
                horizontal-alignment: left;
                height: 20px;
                vertical-stretch: 0;
            }

            // People — exact-handle resolution (resolve-on-Enter, no enumeration).
            if root.query-is-handle || root.person-status != "": VerticalLayout {
                spacing: Spacing.xxs;
                Text {
                    text: "People";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                }
                if root.person-status == "found": PersonRow {
                    interactive: root.show;
                    name: root.person-name;
                    handle: root.person-handle;
                    clicked => { root.person-selected(root.person-id); }
                }
                if root.person-status == "searching": Text {
                    text: "Searching @" + root.person-handle + "…";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                }
                if root.person-status == "notfound": Text {
                    text: "No user @" + root.person-handle;
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                }
                if root.person-status == "error": Text {
                    text: root.person-error;
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    wrap: word-wrap;
                }
                // Tappable: a phone user has no ↵ to press, and the IME's
                // action key is not guaranteed to reach `accepted`.
                // `person-handle` is the query with a leading "@" dropped.
                if root.person-status == "": Rectangle {
                    height: Spacing.touch-target-min;
                    border-radius: Spacing.radius-sm;
                    background: find-touch.has-hover ? Colors.surface-hover : transparent;
                    find-touch := TouchArea {
                        enabled: root.show;
                        mouse-cursor: pointer;
                        clicked => { root.resolve(root.query); }
                    }
                    HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.sm;
                        Text {
                            text: "👤";
                            color: Colors.primary;
                            font-size: Typography.sm;
                            width: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Find @" + root.person-handle;
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "↵";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                min-height: 40px;
                viewport-width: self.width;
                viewport-height: results-list.preferred-height;
                results-list := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    spacing: Spacing.xxs;

                    // Jump to (conversations). An empty query is already titled
                    // "Recent conversations" above; two headers stacked there.
                    if (root.category == "all" || root.category == "chats") && root.query != "" && root.conversations.length > 0: Text {
                        text: "Jump to";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                    }
                    for c[i] in root.conversations: ConvRow {
                        visible: root.category == "all" || root.category == "chats";
                        interactive: root.show;
                        item-id: c.id;
                        name: c.name;
                        conv-type: c.conv-type;
                        unread-count: c.unread-count;
                        selected: i == root.selected-index;
                        clicked(id, t) => { root.conversation-selected(id, t); }
                    }

                    // Messages (content)
                    if root.category != "all" && root.category != "chats" && root.messages.length > 0: Text {
                        text: root.category == "all" ? "Messages and shared content"
                            : root.category == "media" ? "Photos and videos"
                            : root.category == "files" ? "Files"
                            : root.category == "links" ? "Links"
                            : root.category == "voice" ? "Voice messages" : "Messages";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                    }
                    if root.category != "media" && root.category != "chats": VerticalLayout {
                        for m[j] in root.messages: VerticalLayout {
                            property <bool> section-start: root.category == "all" && j < root.message-kinds.length
                                && (j == 0 || root.message-kinds[j] != root.message-kinds[max(0, j - 1)]);
                            if self.section-start: Text {
                                height: 22px;
                                text: root.message-kinds[j] == "media" ? "Photos and videos"
                                    : root.message-kinds[j] == "files" ? "Files"
                                    : root.message-kinds[j] == "links" ? "Links"
                                    : root.message-kinds[j] == "voice" ? "Voice messages" : "Messages";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }
                            MsgRow {
                                interactive: root.show;
                                message-id: m.message-id;
                                channel-name: m.channel-name;
                                sender-name: m.sender-name;
                                content-preview: m.content-preview;
                                preview-before: m.preview-before;
                                preview-match: m.preview-match;
                                preview-after: m.preview-after;
                                match-term: root.query;
                                highlight-start: m.highlight-start;
                                highlight-end: m.highlight-end;
                                timestamp: m.timestamp;
                                selected: (root.conversations.length + j) == root.selected-index;
                                clicked(id) => { root.message-selected(id); }
                            }
                        }
                    }
                    if root.category == "media": media-grid := Rectangle {
                        property <int> columns: root.width < 600px ? 2 : 4;
                        property <length> gutter: Spacing.sm;
                        property <length> tile: (self.width - (self.columns - 1) * self.gutter) / self.columns;
                        height: Math.ceil(root.messages.length / self.columns) * (self.tile + self.gutter);
                        for m[index] in root.messages: Rectangle {
                            x: mod(index, media-grid.columns) * (media-grid.tile + media-grid.gutter);
                            y: Math.floor(index / media-grid.columns) * (media-grid.tile + media-grid.gutter);
                            width: media-grid.tile;
                            height: media-grid.tile;
                            border-radius: Spacing.radius-md;
                            background: Colors.inset;
                            clip: true;
                            accessible-role: button;
                            accessible-label: m.content-preview;
                            if index < root.has-thumbnails.length && root.has-thumbnails[index]: Image {
                                width: 100%; height: 100%; source: root.thumbnails[index]; image-fit: cover;
                            }
                            if index >= root.has-thumbnails.length || !root.has-thumbnails[index]: Image {
                                source: Icons.image; width: 30px; height: 30px;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                colorize: Colors.text-muted;
                            }
                            Rectangle { y: parent.height - 38px; height: 38px; width: 100%; background: Materials.thick;
                                Text { text: m.content-preview; color: Colors.text-primary; font-size: Typography.xs;
                                    x: Spacing.sm; width: parent.width - 2 * Spacing.sm; height: 100%; vertical-alignment: center; overflow: elide; }
                            }
                            TouchArea { enabled: root.show; mouse-cursor: pointer; clicked => { root.message-selected(m.message-id); } }
                        }
                    }
                    for section[i] in ["Messages", "Media", "Files", "Links", "Voice"]: Rectangle {
                        visible: (root.category == "all" || root.category == section.to-lowercase()) && root.category-counts[i + 2] > root.page-limits[i + 2];
                        height: self.visible ? Spacing.touch-target-min : 0px;
                        border-radius: Spacing.radius-lg;
                        background: more-touch.pressed ? Materials.pressed : more-touch.has-hover ? Colors.surface-hover : Colors.inset;
                        more-touch := TouchArea { enabled: parent.visible; mouse-cursor: pointer; clicked => { root.show-more(section.to-lowercase()); } }
                        Text { text: "Show more " + section.to-lowercase(); color: Colors.primary; font-size: Typography.sm; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    if root.searching: Text {
                        text: "Searching this device…";
                        color: Colors.text-muted;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                    }

                    if root.total-count == 0 && root.query != "" && !root.searching && !root.query-is-handle: Text {
                        text: "No matches on this device";
                        color: Colors.text-muted;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
    date-layer := Rectangle {
        property <float> reveal: root.date-sheet-open ? 1 : 0;
        animate reveal { duration: Materials.motion-standard; easing: Materials.glide; }
        visible: root.date-sheet-open || self.reveal > 0;
        opacity: self.reveal;
        width: 100%; height: 100%; background: Materials.scrim;
        TouchArea { enabled: root.date-sheet-open; clicked => { root.date-sheet-open = false; } }
        GlassSurface {
            material-level: 3; elevation: 4;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - Spacing.md + (1 - date-layer.reveal) * 48px;
            width: min(420px, parent.width - 24px);
            height: min(548px, parent.height - 24px);
            border-radius: Spacing.radius-xl;
            transform-origin: { x: self.width / 2, y: self.height };
            transform-scale-x: 94% + date-layer.reveal * 6%;
            transform-scale-y: 94% + date-layer.reveal * 6%;
            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.xs;
                Text { text: "When"; color: Colors.text-primary; font-size: Typography.lg; font-weight: Typography.semibold; }
                Flickable {
                    height: Spacing.touch-target-min;
                    viewport-width: quick-choices.preferred-width;
                    viewport-height: self.height;
                    quick-choices := HorizontalLayout {
                        spacing: Spacing.xs;
                for choice in ["Any time", "Today", "7 days", "30 days", "This year"]: Rectangle {
                    width: max(70px, choice-label.preferred-width + 20px);
                    height: Spacing.touch-target-min; border-radius: Spacing.radius-sm;
                    background: choice-touch.pressed ? Materials.pressed : choice-touch.has-hover ? Materials.hover : transparent;
                    choice-touch := TouchArea { mouse-cursor: pointer; clicked => {
                        root.date-filter = choice == "Today" ? "today" : choice == "7 days" ? "week" : choice == "30 days" ? "month" : choice == "This year" ? "year" : "any";
                        root.date-sheet-open = false;
                        root.filters-changed(root.category, root.sort-order, root.date-filter, root.from-filter, root.in-filter);
                    } }
                    choice-label := Text { text: choice; width: 100%; color: Colors.text-secondary; font-size: Typography.sm; horizontal-alignment: center; height: 100%; vertical-alignment: center; }
                }
                    }
                }
                HorizontalLayout {
                    height: Spacing.touch-target-min;
                    Rectangle { width: Spacing.touch-target-min; height: Spacing.touch-target-min; border-radius: Spacing.radius-lg;
                        background: prev-touch.pressed ? Materials.pressed : prev-touch.has-hover ? Materials.hover : Colors.inset;
                        prev-touch := TouchArea { mouse-cursor: pointer; clicked => { root.calendar-shift(-1); } }
                        Text { text: "‹"; width: 100%; height: 100%; color: Colors.primary; font-size: Typography.lg; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: root.calendar-month; color: Colors.text-primary; font-size: Typography.sm; font-weight: Typography.semibold; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; }
                    Rectangle { width: Spacing.touch-target-min; height: Spacing.touch-target-min; border-radius: Spacing.radius-lg;
                        background: next-touch.pressed ? Materials.pressed : next-touch.has-hover ? Materials.hover : Colors.inset;
                        next-touch := TouchArea { mouse-cursor: pointer; clicked => { root.calendar-shift(1); } }
                        Text { text: "›"; width: 100%; height: 100%; color: Colors.primary; font-size: Typography.lg; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    for weekday in ["M", "T", "W", "T", "F", "S", "S"]: Text {
                        text: weekday; color: Colors.text-muted; font-size: Typography.xs;
                        horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                calendar-grid := Rectangle {
                    height: 6 * Spacing.touch-target-min;
                    for day[index] in root.calendar-days: Rectangle {
                        x: mod(index, 7) * parent.width / 7;
                        y: Math.floor(index / 7) * Spacing.touch-target-min;
                        width: parent.width / 7; height: Spacing.touch-target-min;
                        border-radius: Spacing.radius-lg;
                        background: day.date == root.custom-start || day.date == root.custom-end ? Colors.action-fill
                            : root.custom-start != "" && root.custom-end != "" && day.date > root.custom-start && day.date < root.custom-end ? Colors.selected
                            : day-touch.pressed ? Materials.pressed : day-touch.has-hover ? Materials.hover : transparent;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale-x: day-touch.pressed ? 90% : 100%;
                        transform-scale-y: day-touch.pressed ? 90% : 100%;
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                        day-touch := TouchArea { mouse-cursor: pointer;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.calendar-swipe-start = self.absolute-position.x + self.mouse-x;
                                    root.calendar-swiped = false;
                                }
                                if (event.kind == PointerEventKind.up && abs(self.absolute-position.x + self.mouse-x - root.calendar-swipe-start) > 64px) {
                                    root.calendar-swiped = true;
                                    root.calendar-shift(self.absolute-position.x + self.mouse-x < root.calendar-swipe-start ? 1 : -1);
                                }
                            }
                            clicked => {
                            if (root.calendar-swiped) { root.calendar-swiped = false; return; }
                            if (root.custom-start == "" || root.custom-end != "") {
                                root.custom-start = day.date; root.custom-end = "";
                            } else {
                                if (day.date < root.custom-start) { root.custom-end = root.custom-start; root.custom-start = day.date; }
                                else { root.custom-end = day.date; }
                                root.date-filter = "custom:" + root.custom-start + ".." + root.custom-end;
                                root.date-sheet-open = false;
                                root.filters-changed(root.category, root.sort-order, root.date-filter, root.from-filter, root.in-filter);
                            }
                        } }
                        Text { text: day.label; width: 100%; height: 100%; color: day.date == root.custom-start || day.date == root.custom-end ? Colors.on-action : day.in-month ? Colors.text-primary : Colors.text-muted;
                            font-size: Typography.sm; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Text { text: root.custom-start == "" ? "Tap a start day, then an end day" : root.custom-end == "" ? "Start: " + root.custom-start + " · choose end" : root.custom-start + " – " + root.custom-end;
                    color: Colors.text-muted; font-size: Typography.xs; horizontal-alignment: center; }
            }
        }
    }
    picker-layer := Rectangle {
        property <float> reveal: root.picker-mode != "" ? 1 : 0;
        animate reveal { duration: Materials.motion-standard; easing: Materials.glide; }
        visible: root.picker-mode != "" || self.reveal > 0;
        opacity: self.reveal;
        width: 100%; height: 100%; background: Materials.scrim;
        TouchArea { enabled: root.picker-mode != ""; clicked => { root.picker-mode = ""; } }
        GlassSurface {
            material-level: 3; elevation: 4;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - Spacing.md + (1 - picker-layer.reveal) * 48px;
            width: min(420px, parent.width - 24px);
            height: min(560px, parent.height - 24px);
            border-radius: Spacing.radius-xl;
            transform-origin: { x: self.width / 2, y: self.height };
            transform-scale-x: 94% + picker-layer.reveal * 6%;
            transform-scale-y: 94% + picker-layer.reveal * 6%;
            VerticalLayout {
                padding: Spacing.lg; spacing: Spacing.sm;
                Text { text: root.picker-mode == "from" ? "From a person" : "In a chat"; color: Colors.text-primary; font-size: Typography.lg; font-weight: Typography.semibold; }
                Rectangle {
                    height: Spacing.touch-target-min; border-radius: Spacing.radius-lg;
                    background: Colors.inset;
                    TextInput { text <=> root.picker-query; x: Spacing.md; width: parent.width - 2 * Spacing.md; height: 100%; single-line: true; color: Colors.text-primary; font-size: Typography.sm;
                        edited => { root.picker-request(root.picker-mode, root.picker-query); }
                    }
                }
                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: picker-list.preferred-height;
                    picker-list := VerticalLayout {
                        width: parent.width; spacing: Spacing.xxs;
                        for option in root.picker-options: Rectangle {
                            height: Spacing.touch-target-min + Spacing.xs;
                            border-radius: Spacing.radius-sm;
                            background: option-touch.pressed ? Materials.pressed : option-touch.has-hover ? Materials.hover : transparent;
                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                            transform-scale-x: option-touch.pressed ? 96% : 100%;
                            transform-scale-y: option-touch.pressed ? 96% : 100%;
                            animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                            animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                            option-touch := TouchArea { mouse-cursor: pointer; clicked => {
                                if (root.picker-mode == "from") { root.from-filter = option.id; root.from-label = option.name; }
                                else { root.in-filter = option.id; root.in-label = option.name; }
                                root.picker-mode = "";
                                root.filters-changed(root.category, root.sort-order, root.date-filter, root.from-filter, root.in-filter);
                            } }
                            Rectangle { x: Spacing.sm; y: (parent.height - self.height) / 2; width: 32px; height: 32px; border-radius: self.width / 2; background: Colors.selected; clip: true;
                                if option.has-avatar: Image { source: option.avatar; width: 100%; height: 100%; image-fit: cover; }
                                if !option.has-avatar: Image { source: option.conv-type == "channel" ? Icons.hash : option.conv-type == "private_group" ? Icons.users : Icons.user;
                                    x: 8px; y: 8px; width: 16px; height: 16px; colorize: Colors.primary; }
                            }
                            Text { text: option.name; x: Spacing.sm + 40px; width: parent.width - Spacing.sm - 48px; height: 100%; color: Colors.text-primary;
                                font-size: Typography.sm; vertical-alignment: center; overflow: elide; }
                        }
                        if root.picker-options.length == 0: Text { text: "No matches"; color: Colors.text-muted; font-size: Typography.sm; horizontal-alignment: center; }
                    }
                }
            }
        }
    }
}
