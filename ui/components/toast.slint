import { GlassSurface } from "glass_surface.slint";
import { Materials } from "../theme/materials.slint";
// Toast notification component

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

export component Toast inherits GlassSurface {
    material-level: 3;
    elevation: 4;
    border-radius: Spacing.radius-xl;

    in property <string> message: "";
    in property <string> variant: "info";  // "success", "error", "warning", "info"
    in property <bool> show-toast: false;
    property <length> swipe-start: 0px;
    property <length> swipe-offset: 0px;
    property <bool> swiping: false;

    callback dismissed();

    // Computed variant color
    property <color> variant-color:
        variant == "success" ? Colors.success :
        variant == "error" ? Colors.error :
        variant == "warning" ? Colors.warning :
        Colors.info;

    // Visibility and animation
    visible: root.show-toast || self.opacity > 0;
    opacity: root.show-toast
        ? (root.swiping ? max(0.6, 1 - abs(root.swipe-offset / 240px)) : 1)
        : 0;
    animate opacity { duration: root.swiping ? 0ms : Materials.motion-quick; easing: Materials.glide; }
    transform-scale-x: root.show-toast ? 100% : 86%;
    transform-scale-y: root.show-toast ? 100% : 72%;
    transform-origin: { x: self.width / 2, y: 0px };
    animate transform-scale-x { duration: Materials.motion-standard; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-standard; easing: Materials.spring; }

    // Toast container
    in property <length> max-toast-width: 320px;
    width: root.max-toast-width;
    height: content-layout.preferred-height + Spacing.md * 2;

    // A swipe on the pill dismisses it; the close target remains independent.
    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.show-toast;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.swipe-start = self.mouse-y;
                root.swiping = true;
            }
            if (event.kind == PointerEventKind.move && root.swiping) {
                root.swipe-offset = self.mouse-y - root.swipe-start;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.swipe-offset < -48px || root.swipe-offset > 48px) { root.dismissed(); }
                root.swipe-offset = 0px;
                root.swiping = false;
            }
        }
    }

    content-layout := HorizontalLayout {
        // The variant dot carries status without another material or outline. It
        // already carries success/error/warning/info.
        padding: Spacing.md;
        spacing: Spacing.md;

        // Variant indicator circle
        // A layout ignores `y`, so centre the dot with one of its own.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: variant-color;
            }
        }

        // Message text
        Text {
            text: root.message;
            color: Colors.text-primary;
            font-size: Typography.sm;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // Dismiss button. Centred like the dot: the toast is taller than
        // this row's fixed-size box, which a layout leaves at the top — the
        // ✕ sat above the text axis (RC24 D3).
        VerticalLayout {
            alignment: center;

            Rectangle {
                // 32px was under the touch minimum, on a control whose whole job is
                // to be tapped by someone who wants the message gone.
                width: Spacing.touch-target-min;
                height: Spacing.touch-target-min;
                border-radius: Spacing.radius-sm;
                background: dismiss-area.has-hover ? Colors.surface-hover : transparent;
                transform-scale-x: dismiss-area.pressed ? 88% : 100%;
                transform-scale-y: dismiss-area.pressed ? 88% : 100%;
                animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                // The bundled SVG, not U+2715. Inter has no glyph for that codepoint
                // and Slint's fallback drew a tofu box — so the only way to dismiss a
                // toast was labelled with a missing-character rectangle.
                Image {
                    source: Icons.x;
                    width: 16px;
                    height: 16px;
                    colorize: Colors.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                dismiss-area := TouchArea {
                    width: 100%;
                    height: 100%;
                    enabled: root.show-toast;
                    clicked => {
                        root.dismissed();
                    }
                }
            }
        }
    }
}
