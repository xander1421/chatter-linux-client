import { GlassSurface } from "glass_surface.slint";
// PDF preview panel component
//
// Renders PDF pages inline using pdfium-render. Shows page image
// with navigation controls and export option.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { HeaderButton } from "header_button.slint";
import { DismissButton } from "dismiss_button.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "button.slint";

export component PdfPreviewPanel inherits Rectangle {
    // File info
    in property <string> file-name: "";
    in property <int> page-count: 0;
    in property <int> current-page: 1;
    in property <string> error-message: "";
    in property <bool> external-only: false;
    in property <image> page-image;

    // Callbacks
    callback close-clicked();
    callback open-external-clicked();
    callback page-prev-clicked();
    callback page-next-clicked();

    // Computed properties
    property <bool> has-error: root.error-message != "";
    property <bool> has-image: root.page-image.width > 0 && root.page-image.height > 0;
    property <bool> can-prev: root.current-page > 1;
    property <bool> can-next: root.current-page < root.page-count;

    // Panel styling
    background: Colors.background;
    border-radius: Spacing.radius-panel;
    border-width: 1px;
    border-color: Colors.border;
    clip: true;

    VerticalLayout {
        padding: Spacing.panel-gutter;
        spacing: Spacing.panel-gutter;

        // Header island
        GlassSurface {
            material-level: 2;
            elevation: 3;
            border-radius: Spacing.radius-panel;
            border-width: 1px;
            border-color: Colors.border;

            // As tall as the header buttons, so the file name shares their axis.
            height: Spacing.header-action-box;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: space-between;

                // Left side: file info
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.sm;
                    alignment: start;

                    // File name
                    Text {
                        text: root.file-name;
                        horizontal-stretch: 1;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // PDF badge
                    Rectangle {
                        height: 20px;
                        width: pdf-text.preferred-width + Spacing.sm * 2;
                        background: Colors.surface-control;
                        border-radius: Spacing.radius-control;

                        pdf-text := Text {
                            text: @tr("PDF");
                            color: Colors.text-secondary;
                            font-size: Typography.xs;
                            font-weight: Typography.semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Page count
                    if root.page-count > 0: Text {
                        text: root.current-page + " / " + root.page-count;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }
                }

                // Right side: actions
                HorizontalLayout {
                    spacing: Spacing.header-action-gap;
                    alignment: end;

                    // Open external button
                    HeaderButton {
                        icon: Icons.link;
                        label: @tr("Open externally");
                        clicked => { root.open-external-clicked(); }
                    }

                    // Close button
                    DismissButton {
                        clicked => { root.close-clicked(); }
                    }
                }
            }
        }

        // Main content area
        Rectangle {
            vertical-stretch: 1;
            background: Colors.surface-card;
            border-radius: Spacing.radius-panel;
            clip: true;

            // Error state
            if root.has-error: VerticalLayout {
                alignment: center;
                spacing: Spacing.md;
                padding: Spacing.xl;

                Text {
                    text: "\u{26A0}"; // Warning
                    font-size: Typography.huge;
                    color: Colors.warning;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.error-message;
                    color: Colors.error;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Rendered page image
            if !root.has-error && root.has-image: Image {
                width: 100%;
                height: 100%;
                source: root.page-image;
                image-fit: contain;
            }

            if root.external-only && !root.has-error: VerticalLayout {
                alignment: center;
                spacing: Spacing.md;
                padding: Spacing.xl;
                Image {
                    source: Icons.file;
                    width: Spacing.xl;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    colorize: Colors.text-muted;
                }
                Text {
                    text: @tr("PDF document");
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    font-weight: Typography.semibold;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("View this PDF in another app.");
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Open PDF");
                        border-radius: Spacing.radius-control;
                        clicked => { root.open-external-clicked(); }
                    }
                }
            }

            // Loading state is reserved for an actual inline renderer.
            if !root.external-only && !root.has-error && !root.has-image: VerticalLayout {
                alignment: center;
                spacing: Spacing.md;
                padding: Spacing.xl;

                Text {
                    text: @tr("Loading PDF...");
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }
        }

        // Page navigation island
        if root.page-count > 1 && !root.has-error: GlassSurface {
            height: Spacing.button-height;
            border-radius: Spacing.radius-panel;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.md;

                // Previous page button
                HeaderButton {
                    icon: Icons.chevron-left;
                    label: @tr("Previous page");
                    enabled: root.can-prev;
                    clicked => { root.page-prev-clicked(); }
                }

                // Page indicator
                Text {
                    text: root.current-page + " / " + root.page-count;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }

                // Next page button
                HeaderButton {
                    icon: Icons.chevron-right;
                    label: @tr("Next page");
                    enabled: root.can-next;
                    clicked => { root.page-next-clicked(); }
                }
            }
        }
    }
}
