// PDF preview panel component
//
// Renders PDF pages inline using pdfium-render. Shows page image
// with navigation controls and export option.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component PdfPreviewPanel inherits Rectangle {
    // File info
    in property <string> file-name: "";
    in property <int> page-count: 0;
    in property <int> current-page: 1;
    in property <string> error-message: "";
    in property <image> page-image;

    // Callbacks
    callback close-clicked();
    callback open-external-clicked();
    callback page-prev-clicked();
    callback page-next-clicked();

    // Computed properties
    property <bool> has-error: root.error-message != "";
    property <bool> has-image: root.page-image.width > 0 && root.page-image.height > 0;
    property <bool> can-prev: root.current-page > 1;
    property <bool> can-next: root.current-page < root.page-count;

    // Panel styling
    background: Colors.surface;
    border-radius: Spacing.radius-md;
    clip: true;

    VerticalLayout {
        // Header bar
        Rectangle {
            height: 40px;
            background: Colors.background;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: space-between;

                // Left side: file info
                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;

                    // File name
                    Text {
                        text: root.file-name;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // PDF badge
                    Rectangle {
                        height: 20px;
                        width: pdf-text.preferred-width + Spacing.sm * 2;
                        background: Colors.error.transparentize(0.8);
                        border-radius: Spacing.radius-sm;

                        pdf-text := Text {
                            text: "PDF";
                            color: Colors.error;
                            font-size: Typography.xs;
                            font-weight: Typography.semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Page count
                    if root.page-count > 0: Text {
                        text: root.current-page + " / " + root.page-count;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }
                }

                // Right side: actions
                HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: end;

                    // Open external button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: ext-touch.has-hover ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{2197}"; // North East Arrow
                            font-size: Typography.sm;
                            color: ext-touch.has-hover ? Colors.primary : Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        ext-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-external-clicked();
                            }
                        }
                    }

                    // Close button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: close-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                        border-radius: Spacing.radius-sm;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{2715}"; // X mark
                            font-size: Typography.sm;
                            color: close-touch.has-hover ? Colors.error : Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-clicked();
                            }
                        }
                    }
                }
            }
        }

        // Main content area
        Rectangle {
            vertical-stretch: 1;
            background: Colors.background.mix(Colors.surface, 0.5);

            // Error state
            if root.has-error: VerticalLayout {
                alignment: center;
                spacing: Spacing.md;
                padding: Spacing.xl;

                Text {
                    text: "\u{26A0}"; // Warning
                    font-size: 48px;
                    color: Colors.warning;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.error-message;
                    color: Colors.error;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Rendered page image
            if !root.has-error && root.has-image: Image {
                width: 100%;
                height: 100%;
                source: root.page-image;
                image-fit: contain;
            }

            // Loading/fallback state (no image yet, no error)
            if !root.has-error && !root.has-image: VerticalLayout {
                alignment: center;
                spacing: Spacing.md;
                padding: Spacing.xl;

                Text {
                    text: "Loading PDF...";
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }
        }

        // Footer bar with page navigation
        if root.page-count > 1 && !root.has-error: Rectangle {
            height: 40px;
            background: Colors.background;

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.md;

                // Previous page button
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.can-prev && prev-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;
                    opacity: root.can-prev ? 1.0 : 0.3;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: "\u{2039}"; // Left angle
                        font-size: Typography.lg;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    prev-touch := TouchArea {
                        enabled: root.can-prev;
                        mouse-cursor: root.can-prev ? pointer : default;
                        clicked => {
                            root.page-prev-clicked();
                        }
                    }
                }

                // Page indicator
                Text {
                    text: root.current-page + " / " + root.page-count;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }

                // Next page button
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.can-next && next-touch.has-hover ? Colors.surface-hover : transparent;
                    border-radius: Spacing.radius-sm;
                    opacity: root.can-next ? 1.0 : 0.3;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: "\u{203A}"; // Right angle
                        font-size: Typography.lg;
                        color: Colors.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    next-touch := TouchArea {
                        enabled: root.can-next;
                        mouse-cursor: root.can-next ? pointer : default;
                        clicked => {
                            root.page-next-clicked();
                        }
                    }
                }
            }
        }
    }
}
