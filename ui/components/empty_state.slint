// Reusable empty state component
//
// Shows an icon, message, and optional CTA button when a list has no items.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";

export component EmptyState inherits Rectangle {
    height: 152px * Appearance.text-grow;
    in property <image> icon;
    in property <string> message: "";
    in property <string> cta-text: "";
    in property <bool> show-cta: cta-text != "";

    callback cta-clicked();
    property <float> arrival: 0;
    init => { root.arrival = 1; }
    animate arrival { duration: Materials.motion-emphasized; easing: Materials.spring; }
    opacity: root.arrival;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        y: (1 - root.arrival) * 12px;
        alignment: center;
        spacing: Spacing.xs;
        padding: Spacing.md;

        // Icon in tinted circle
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Colors.primary.with-alpha(0.10);

                Image {
                    source: root.icon;
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Colors.primary;
                }
            }
        }

        // Message text
        Text {
            text: root.message;
            color: Colors.text-muted;
            font-size: Typography.xs;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        // CTA link
        if root.show-cta: Rectangle {
            width: min(root.width - Spacing.md * 2,
                max(Spacing.touch-target-min, cta-label.preferred-width + Spacing.md * 2));
            height: Spacing.touch-target-min;
            border-radius: self.height / 2;
            background: cta-touch.has-hover ? Colors.primary.with-alpha(0.10) : transparent;
            transform-scale-x: cta-touch.pressed ? 94% : 100%;
            transform-scale-y: cta-touch.pressed ? 90% : 100%;
            animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
            animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
            cta-label := Text {
                text: root.cta-text;
                color: Colors.primary;
                font-size: Typography.xs;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                width: 100%;
                height: 100%;
            }
            cta-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.cta-clicked(); }
            }
            accessible-role: button;
            accessible-label: root.cta-text;
            accessible-action-default => { root.cta-clicked(); }
        }
    }
}
