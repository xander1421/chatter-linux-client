// Neo Action Toggle — AI feature toggle with cyan/violet glow
//
// Enhanced toggle for AI features. When checked, emits a colored glow
// ring around the track. Supports two glow modes: "cyan" and "violet".

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component NeoActionToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> disabled: false;
    in property <string> accessible-text: "";
    // "cyan" or "violet" — determines glow color when checked
    in property <string> glow-mode: "cyan";

    accessible-role: switch;
    accessible-label: root.accessible-text;
    accessible-enabled: !root.disabled;
    accessible-checkable: true;
    accessible-checked: root.checked;

    callback toggled(bool);

    // Resolved glow colors based on mode
    property <color> glow-color: glow-mode == "violet" ? Colors.glow-violet : Colors.glow-cyan;
    property <color> glow-soft: glow-mode == "violet" ? Colors.glow-violet-soft : Colors.glow-cyan-soft;

    // Track color: when checked, glow color replaces primary
    property <color> track-color: {
        if checked {
            if touch.has-hover && !disabled {
                glow-color.darker(0.15)
            } else {
                glow-color
            }
        } else {
            if touch.has-hover && !disabled {
                Colors.surface
            } else {
                Colors.surface-hover
            }
        }
    };

    // Dimensions: same as Toggle (44x24) for drop-in replacement
    width: 44px;
    height: 24px;
    opacity: disabled ? 0.5 : 1.0;

    // Outer glow ring (only when checked)
    Rectangle {
        width: parent.width + 4px;
        height: parent.height + 4px;
        x: -2px;
        y: -2px;
        border-radius: 14px;
        background: transparent;
        border-width: root.checked ? 1px : 0px;
        border-color: root.checked ? root.glow-soft : transparent;
        drop-shadow-blur: root.checked ? Spacing.neo-blur-sm : 0px;
        drop-shadow-color: root.checked ? root.glow-soft : transparent;

        animate border-width, border-color, drop-shadow-blur, drop-shadow-color {
            duration: 250ms;
            easing: ease-in-out;
        }
    }

    // Track
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: root.track-color;

        animate background {
            duration: 200ms;
            easing: ease-in-out;
        }

        // Thumb — slides with glow when active
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Colors.text-primary;
            y: 2px;
            x: root.checked ? 22px : 2px;
            drop-shadow-blur: root.checked ? 4px : 0px;
            drop-shadow-color: root.checked ? root.glow-color.with-alpha(0.5) : transparent;

            animate x {
                duration: 200ms;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);  // Snappy overshoot
            }
            animate drop-shadow-blur, drop-shadow-color {
                duration: 250ms;
                easing: ease-in-out;
            }
        }
    }

    // Full-area touch target
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: disabled ? default : pointer;

        clicked => {
            if !disabled {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
