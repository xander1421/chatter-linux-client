import { Spacing } from "../theme/spacing.slint";
// AI feature toggle. State uses a tinted track; the surrounding chrome owns depth.

import { Appearance } from "../theme/appearance.slint";
import { Colors } from "../theme/colors.slint";

export component NeoActionToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> disabled: false;
    in property <string> accessible-text: "";
    // "cyan" or "violet" — determines glow color when checked
    in property <string> glow-mode: "cyan";

    accessible-role: switch;
    accessible-label: root.accessible-text;
    accessible-enabled: !root.disabled;
    accessible-checkable: true;
    accessible-checked: root.checked;

    callback toggled(bool);

    // Resolved glow colors based on mode
    property <color> glow-color: glow-mode == "violet" ? Colors.accent-purple : Colors.primary;

    // Track color: when checked, glow color replaces primary
    property <color> track-color: {
        if checked {
            if touch.has-hover && !disabled {
                glow-color.darker(0.15)
            } else {
                glow-color
            }
        } else {
            if touch.has-hover && !disabled {
                Colors.surface
            } else {
                Colors.surface-hover
            }
        }
    };

    // Match Toggle: a centred 44x24 track inside a 44px hit target.
    width: Spacing.switch-width;
    height: Spacing.button-height;
    opacity: disabled ? 0.5 : 1.0;

    // Track
    Rectangle {
        width: 100%;
        height: Spacing.switch-track-height;
        y: (root.height - self.height) / 2;
        border-radius: self.height / 2;
        background: root.track-color;

        animate background {
            duration: Appearance.reduce-motion ? 0ms : 160ms;
            easing: ease-in-out;
        }

        // Thumb — short state transition, respecting reduced motion.
        Rectangle {
            width: Spacing.switch-thumb;
            height: Spacing.switch-thumb;
            border-radius: self.height / 2;
            background: Colors.on-action;
            y: Spacing.xxs;
            x: root.checked ? parent.width - self.width - Spacing.xxs : Spacing.xxs;

            animate x {
                duration: Appearance.reduce-motion ? 0ms : 160ms;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);  // Snappy overshoot
            }
        }
    }

    // Full-area touch target
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: disabled ? default : pointer;

        clicked => {
            if !disabled {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
