import { GlassSurface } from "glass_surface.slint";
import { Materials } from "../theme/materials.slint";
// Mention autocomplete popup for @user, #channel, @here, @all suggestions

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Avatar } from "avatar.slint";

// Mention suggestion data struct
export struct MentionSuggestion {
    id: string,
    name: string,
    mention-type: string,  // "user", "channel", "here", "all"
    avatar: image,         // Loaded from Rust (empty for non-users)
}

export component MentionAutocomplete inherits GlassSurface {
    // The root remains the stable overlay frame. Its glass child grows up from
    // the composer edge, so the native input and the overlay anchor never move.
    material-enabled: false;

    // Popup visibility
    in property <bool> show: false;
    property <bool> entered: false;
    property <float> reveal: 0;
    animate reveal { duration: Materials.motion-standard; easing: Materials.spring; }
    init => { if (Appearance.reduce-motion && root.show) { root.reveal = 1; } }
    changed show => {
        root.entered = false;
        root.reveal = Appearance.reduce-motion && root.show ? 1 : 0;
    }
    Timer {
        interval: 16ms;
        running: root.show && !root.entered && !Appearance.reduce-motion;
        triggered => { root.entered = true; root.reveal = 1; }
    }
    opacity: root.show ? 1 : 0;
    animate opacity { duration: Materials.motion-quick; easing: Materials.settle; }

    // Suggestions from Rust (max 8 shown)
    in property <[MentionSuggestion]> suggestions: [];

    // Currently selected index (for keyboard navigation)
    in property <int> selected-index: 0;

    // Callbacks
    callback suggestion-selected(string, string);  // (id, display_text like "@alice")
    callback close();

    // Only render when visible
    visible: root.show || self.opacity > 0;

    // Compact popup - responsive width, height based on suggestions
    in property <length> max-popup-width: 240px;
    in property <length> max-popup-height: 1000px;
    width: root.max-popup-width;
    height: min(root.max-popup-height,
        max(40px, Math.min(suggestions.length, 8) * Spacing.button-height * Appearance.text-grow) + Spacing.sm * 2);

    // Block clicks from passing through
    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.show;
    }

    popup := GlassSurface {
        x: 0;
        y: root.height - self.height;
        width: 44px + (root.max-popup-width - 44px) * root.reveal;
        height: 12px + (root.height - 12px) * root.reveal;
        material-level: 3;
        elevation: 4;
        border-radius: min(Spacing.radius-xl, self.height / 2);

        Rectangle {
            width: 100%;
            height: 100%;
            clip: true;
            // Keep every suggestion reachable when the keyboard leaves less
            // room than the full list needs.
            Flickable {
                width: 100%;
                height: 100%;
                immediate-child-press: true;
                viewport-width: self.width;
                viewport-height: suggestion-list.preferred-height;
                suggestion-list := VerticalLayout {
                    width: parent.width;
                    padding: Spacing.sm;
                    spacing: 0;

                for suggestion[index] in root.suggestions: Rectangle {
                    height: Spacing.button-height * Appearance.text-grow;
                    border-radius: Spacing.radius-sm;
                    background: index == root.selected-index ? Colors.tint-strong : (item-area.pressed ? Materials.pressed : item-area.has-hover ? Materials.hover : transparent);
                    animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                    transform-scale-x: item-area.pressed ? 97% : 100%;
                    transform-scale-y: item-area.pressed ? 94% : 100%;
                    animate transform-scale-x { duration: item-area.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                    animate transform-scale-y { duration: item-area.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }

                    HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        spacing: Spacing.sm;

                        // Avatar or icon based on type
                        if suggestion.mention-type == "user": Avatar {
                            size: 28px;
                            y: (parent.height - self.height) / 2;
                            source: suggestion.avatar;
                            name: suggestion.name;
                        }

                        if suggestion.mention-type != "user": Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Spacing.radius-sm;
                            background: Colors.surface-control;
                            // Channel icon
                            if suggestion.mention-type == "channel": Text {
                                text: "#";
                                color: Colors.text-secondary;
                                font-size: Typography.base;
                                font-weight: Typography.semibold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if suggestion.mention-type == "here" || suggestion.mention-type == "all": Image {
                                x: 5px;
                                y: 5px;
                                width: 18px;
                                height: 18px;
                                source: Icons.users;
                                colorize: Colors.text-secondary;
                            }
                        }

                        // Name and type indicator
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Spacing.xxs;

                            // Display name with prefix
                            Text {
                                text: suggestion.mention-type == "user" ? suggestion.name : suggestion.mention-type == "channel" ? "#" + suggestion.name : "@" + suggestion.name;
                                color: index == root.selected-index ? Colors.text-primary : Colors.text-secondary;
                                font-size: Typography.sm;
                                font-weight: index == root.selected-index ? Typography.medium : Typography.normal;
                                overflow: elide;
                            }

                            // Type description (for here/all only)
                            if suggestion.mention-type == "here": Text {
                                text: "Notify online members";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                overflow: elide;
                            }

                            if suggestion.mention-type == "all": Text {
                                text: "Notify all members";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                overflow: elide;
                            }
                        }

                        // Selection indicator for keyboard navigation
                        if index == root.selected-index: Rectangle {
                            width: 4px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 2px;
                            background: Colors.primary;
                        }
                    }

                    item-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.show;
                        clicked => {
                            // Build display text based on type
                            if suggestion.mention-type == "channel" {
                                root.suggestion-selected(suggestion.id, "#" + suggestion.name);
                            } else {
                                root.suggestion-selected(suggestion.id, "@" + suggestion.name);
                            }
                        }
                    }
                }

                // Empty state
                if root.suggestions.length == 0: Rectangle {
                    height: 40px;

                    Text {
                        text: "No suggestions";
                        color: Colors.text-muted;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                }
            }
        }
    }
}
