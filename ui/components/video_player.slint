import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";
import { IconAction } from "icon_action.slint";
import { GlassSurface } from "glass_surface.slint";
import { MediaActions } from "image_viewer.slint";
// Video player modal component
//
// Full-screen video player. The chrome is the image viewer's: a glass header
// above the frame as drawn and a glass footer below it, the same width as the
// media. The footer adds a playback row above the shared media actions.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { DismissButton } from "dismiss_button.slint";
import { Typography } from "../theme/typography.slint";

export component VideoPlayer inherits Rectangle {
    private property <bool> compact-layout: root.width < 600px;
    // Touch platform: the media actions take the 48px Android minimum, as in the image viewer.
    in property <bool> touch: false;
    property <length> action-size: (root.touch ? Spacing.touch-target-min : Spacing.button-height) * Appearance.text-grow;
    // Properties
    in property <bool> show: false;
    property <float> arrival: 0.0;
    animate arrival { duration: Materials.motion-emphasized; easing: Materials.spring; }
    arrival-timer := Timer {
        interval: 1ms;
        running: root.show && root.arrival == 0.0;
        triggered => { root.arrival = 1.0; }
    }
    changed show => { if (!root.show) { root.arrival = 0.0; } }
    in property <image> frame;  // Current video frame
    in property <string> filename: "";
    in property <float> progress: 0.0;  // 0.0 to 1.0
    in property <string> elapsed: "0:00";
    in property <string> duration: "0:00";
    in property <bool> is-playing: false;
    in property <float> volume: 1.0;  // 0.0 to 1.0

    // Callbacks
    in property <string> position-label;
    in property <bool> has-previous;
    in property <bool> has-next;
    callback previous();
    callback next();
    callback download();
    callback open-downloads();
    callback close();
    callback toggle-play-pause();
    callback seek(float);  // position 0.0 to 1.0
    callback set-volume(float);  // volume 0.0 to 1.0

    // Only render when show is true
    visible: root.show;
    background: transparent;
    Rectangle {
        width: 100%; height: 100%;
        background: Materials.scrim-media;
        opacity: root.arrival;
    }

    // Close on backdrop click
    backdrop := TouchArea {
        clicked => { root.close(); }
    }

    // The frame owns the layout, as in the image viewer.
    viewer-area := Rectangle {
        x: root.compact-layout ? Spacing.sm : Spacing.xl;
        y: root.compact-layout ? Spacing.sm : Spacing.xl;
        width: root.width - 2 * self.x;
        height: root.height - 2 * self.y;
        property <length> fit-width: root.frame.width <= 0 || root.frame.height <= 0
            ? self.width : min(self.width, self.height * root.frame.width / root.frame.height);
        property <length> fit-height: root.frame.width <= 0 || root.frame.height <= 0
            ? self.height * 9 / 16 : min(self.height, self.width * root.frame.height / root.frame.width);

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1.0 - root.arrival) * 28px;
            width: viewer-area.fit-width;
            height: viewer-area.fit-height;
            opacity: root.arrival;
            Image { source: root.frame; image-fit: contain; width: 100%; height: 100%; }
            // Tapping the video plays or pauses it.
            TouchArea { clicked => { root.toggle-play-pause(); } }
            if !root.is-playing: Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 40px;
                background: #06101db8;
                Text {
                    text: "\u{25B6}";  // Play triangle
                    color: #ffffff;
                    font-size: 32px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    property <length> footer-height: root.action-size * 2;
    property <length> chrome-width: min(viewer-area.width, max(300px, viewer-area.fit-width));
    property <length> chrome-x: viewer-area.x + (viewer-area.width - root.chrome-width) / 2;
    property <length> chrome-top: (viewer-area.height - viewer-area.fit-height) / 2;
    property <length> header-y: max(viewer-area.y, viewer-area.y + root.chrome-top - 48px * Appearance.text-grow - Spacing.sm);
    property <length> footer-y: min(root.height - root.footer-height - viewer-area.y,
        viewer-area.y + root.chrome-top + viewer-area.fit-height + Spacing.sm);

    GlassSurface {
        x: root.chrome-x;
        y: root.header-y - (1.0 - root.arrival) * 12px;
        width: root.chrome-width;
        height: 48px * Appearance.text-grow;
        material-enabled: true;
        border-radius: Spacing.radius-lg;
        opacity: root.arrival;
        TouchArea { width: 100%; height: 100%; }
        HorizontalLayout {
            padding-left: Spacing.md;
            padding-right: Spacing.md;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.filename; overflow: elide; color: Colors.text-primary; font-size: Typography.base; font-weight: Typography.medium; }
            }
            DismissButton { clicked => { root.close(); } }
        }
    }

    GlassSurface {
        x: root.chrome-x;
        y: root.footer-y + (1.0 - root.arrival) * 12px;
        width: root.chrome-width;
        height: root.footer-height;
        border-radius: Spacing.radius-lg;
        opacity: root.arrival;
        TouchArea { width: 100%; height: 100%; }
        VerticalLayout {
            HorizontalLayout {
                height: root.action-size;
                spacing: Spacing.xs;
                padding-right: Spacing.sm;
                IconAction {
                    size: root.action-size;
                    label: root.is-playing ? "Pause video" : "Play video";
                    icon: root.is-playing ? Icons.pause : Icons.play;
                    clicked => { root.toggle-play-pause(); }
                }
                Text { text: root.elapsed; color: Colors.text-muted; font-size: Typography.xs; vertical-alignment: center; }
                // Seek track: tap or drag anywhere along it.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 6px;
                        background: Colors.surface-hover;
                        border-radius: 3px;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * clamp(root.progress, 0.0, 1.0);
                            animate width { duration: Materials.motion-quick; easing: Materials.settle; }
                            height: 100%;
                            background: Colors.primary;
                            border-radius: 3px;
                        }
                        Rectangle {
                            x: max(0px, min(parent.width - self.width, parent.width * clamp(root.progress, 0.0, 1.0) - self.width / 2));
                            y: -5px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: Colors.primary;
                            visible: root.touch || progress-touch.has-hover || progress-touch.pressed;
                        }
                        progress-touch := TouchArea {
                            y: (parent.height - self.height) / 2;
                            height: root.action-size;
                            mouse-cursor: pointer;
                            clicked => { root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
                            moved => {
                                if self.pressed {
                                    root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                }
                            }
                        }
                    }
                }
                Text { text: root.duration; color: Colors.text-muted; font-size: Typography.xs; vertical-alignment: center; }
                IconAction {
                    size: root.action-size;
                    label: root.volume > 0 ? "Mute video" : "Unmute video";
                    icon: root.volume > 0 ? Icons.volume-2 : Icons.volume-x;
                    clicked => { root.set-volume(root.volume > 0 ? 0.0 : 1.0); }
                }
            }
            MediaActions {
                action-size: root.action-size;
                position-label: root.position-label;
                has-previous: root.has-previous;
                has-next: root.has-next;
                download => { root.download(); }
                open-downloads => { root.open-downloads(); }
                previous => { root.previous(); }
                next => { root.next(); }
            }
        }
    }
}
