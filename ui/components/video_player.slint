import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";
import { IconAction } from "icon_action.slint";
import { GlassSurface } from "glass_surface.slint";
// Video player modal component
//
// Full-screen video player with controls for playback, seeking, and volume.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { DismissButton } from "dismiss_button.slint";
import { Typography } from "../theme/typography.slint";

export component VideoPlayer inherits Rectangle {
    private property <bool> compact-layout: root.width < 600px;
    // Properties
    in property <bool> show: false;
    property <float> arrival: 0.0;
    animate arrival { duration: Materials.motion-emphasized; easing: Materials.spring; }
    arrival-timer := Timer {
        interval: 1ms;
        running: root.show && root.arrival == 0.0;
        triggered => { root.arrival = 1.0; }
    }
    changed show => { if (!root.show) { root.arrival = 0.0; } }
    in property <image> frame;  // Current video frame
    in property <string> filename: "";
    in property <float> progress: 0.0;  // 0.0 to 1.0
    in property <string> elapsed: "0:00";
    in property <string> duration: "0:00";
    in property <bool> is-playing: false;
    in property <float> volume: 1.0;  // 0.0 to 1.0

    // Callbacks
    in property <string> position-label;
    in property <bool> has-previous;
    in property <bool> has-next;
    callback previous();
    callback next();
    callback download();
    callback open-downloads();
    callback close();
    callback toggle-play-pause();
    callback seek(float);  // position 0.0 to 1.0
    callback set-volume(float);  // volume 0.0 to 1.0

    // Only render when show is true
    visible: root.show;
    background: transparent;
    Rectangle {
        width: 100%; height: 100%;
        background: Materials.scrim-media;
        opacity: root.arrival;
    }

    // Close on backdrop click (outside content area)
    backdrop := TouchArea {
        clicked => {
            root.close();
        }
    }

    // Content container - blocks clicks from reaching backdrop
    Rectangle {
        x: root.compact-layout ? 0px : 32px;
        y: (1.0 - root.arrival) * 28px;
        opacity: root.arrival;
        width: parent.width - self.x * 2;
        height: parent.height;
        background: transparent;

        // Block clicks on content area from closing
        TouchArea {}

        // Main layout
        VerticalLayout {
            alignment: center;
            padding: root.compact-layout ? Spacing.sm : Spacing.lg;

        // Header with filename and close button
        GlassSurface {
            material-level: 3;
            elevation: 3;

            height: 48px * Appearance.text-grow;

            // Block clicks on header from closing video
            TouchArea {}

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                alignment: space-between;

                // File info
                VerticalLayout {
                    alignment: center;

                    Text {
                        text: root.filename;
                        horizontal-stretch: 1;
                        // Themed glass header: theme foreground (see image_viewer).
                        color: Colors.text-primary;
                        font-size: Typography.base;
                        font-weight: Typography.medium;
                        overflow: elide;
                    }
                }

                // Close button
                DismissButton {
                    clicked => { root.close(); }
                }
            }
        }

        HorizontalLayout {
            spacing: Spacing.xxs;
            alignment: center;
                IconAction { icon: Icons.chevron-left; label: "Previous media"; enabled: root.has-previous; clicked => { root.previous(); } }
                Text { text: root.position-label; color: Colors.on-media-muted; vertical-alignment: center; }
                IconAction { icon: Icons.chevron-right; label: "Next media"; enabled: root.has-next; clicked => { root.next(); } }
                IconAction { icon: Icons.download; label: "Download"; clicked => { root.download(); } }
                IconAction { icon: Icons.folder; label: "Open downloads"; clicked => { root.open-downloads(); } }
        }

        // Video display area
        Rectangle {
            vertical-stretch: 1;
            min-height: 200px;  // Ensure video area has minimum size
            background: Colors.background;
            border-radius: Spacing.radius-md;

            // Prevent clicks from closing
            TouchArea {
                clicked => {
                    // Toggle play/pause on video click
                    root.toggle-play-pause();
                }
            }

            // Video frame
            Image {
                source: root.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            // Play/pause overlay indicator (shown briefly on toggle)
            if !root.is-playing: Rectangle {
                width: 80px;
                height: 80px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 40px;
                background: #06101db8;
                opacity: root.is-playing ? 0.0 : 1.0;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "\u{25B6}";  // Play triangle
                    color: #ffffff;
                    font-size: 32px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Controls bar
        GlassSurface {
            material-level: 3;
            elevation: 3;

            height: Spacing.button-height + Spacing.fab-size + Spacing.sm * 3;

            // Block clicks on controls from closing video
            TouchArea {}

            VerticalLayout {
                padding: Spacing.sm;
                spacing: Spacing.sm;

                // Progress bar
                Rectangle {
                    height: Spacing.button-height;

                    HorizontalLayout {
                        spacing: Spacing.sm;
                        alignment: stretch;

                        // Elapsed time
                        Text {
                            text: root.elapsed;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                            width: 50px;
                            horizontal-alignment: right;
                        }

                        // Progress track
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 6px;
                                horizontal-stretch: 1;
                                background: Colors.surface-hover;
                                border-radius: 3px;

                                // Progress fill - must be explicitly left-aligned
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: parent.width * clamp(root.progress, 0.0, 1.0);
                                    animate width { duration: Materials.motion-quick; easing: Materials.settle; }
                                    height: 100%;
                                    background: Colors.primary;
                                    border-radius: 3px;
                                }

                                // Seek handle
                                Rectangle {
                                    x: max(0px, min(parent.width - self.width, parent.width * clamp(root.progress, 0.0, 1.0) - self.width / 2));
                                    y: -5px;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: Colors.primary;
                                    visible: progress-touch.has-hover || progress-touch.pressed;
                                    animate x { duration: Materials.motion-quick; easing: Materials.settle; }
                                }

                                progress-touch := TouchArea {
                                    y: (parent.height - self.height) / 2;
                                    height: Spacing.button-height;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        // Calculate seek position
                                        root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                        }
                                    }
                                }
                            }
                        }

                        // Duration
                        Text {
                            text: root.duration;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                            width: 50px;
                        }
                    }
                }

                // Control buttons row
                HorizontalLayout {
                    height: Spacing.fab-size;
                    alignment: center;
                    spacing: Spacing.lg;

                    // Volume control
                    HorizontalLayout {
                        width: Spacing.button-height * 2 + Spacing.md;
                        spacing: Spacing.xs;
                        alignment: center;

                        // Volume icon
                        IconAction {
                            label: root.volume > 0 ? "Mute video" : "Unmute video";
                            icon: root.volume > 0 ? Icons.volume-2 : Icons.volume-x;
                            clicked => { root.set-volume(root.volume > 0 ? 0.0 : 1.0); }
                        }

                        // Volume slider
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            Rectangle {
                                width: Spacing.button-height + Spacing.sm;
                                height: 6px;
                                background: Colors.surface;
                                border-radius: 3px;

                                // Volume fill - must be explicitly left-aligned
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: parent.width * root.volume;
                                    height: 100%;
                                    background: Colors.text-muted;
                                    border-radius: 3px;
                                }

                                volume-touch := TouchArea {
                                    y: (parent.height - self.height) / 2;
                                    height: Spacing.button-height;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.set-volume(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.set-volume(clamp(self.mouse-x / self.width, 0.0, 1.0));
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Play/Pause button
                    IconAction {
                        size: Spacing.fab-size;
                        active: true;
                        label: root.is-playing ? "Pause video" : "Play video";
                        icon: root.is-playing ? Icons.pause : Icons.play;
                        clicked => { root.toggle-play-pause(); }
                    }

                    // Spacer to balance volume control
                    Rectangle {
                        width: Spacing.button-height * 2 + Spacing.md;
                    }
                }
            }
        }

        // Footer hint
        Rectangle {
            height: 24px;

            // Block clicks on footer from closing video
            TouchArea {}

            Text {
                text: "Click video to play/pause \u{2022} Drag progress bar to seek";
                color: Colors.text-muted;
                font-size: Typography.xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    }
}
