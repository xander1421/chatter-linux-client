import { GlassSurface } from "glass_surface.slint";
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";

// The list's floating create action. The host decides when it is visible and
// places it above the mobile dock and the return-to-call bar.
export component ComposeFab inherits GlassSurface {
    callback create-clicked();
    width: Spacing.fab-size;
    height: Spacing.fab-size;
    border-radius: self.width / 2;
    clip: true;
    material-level: 2;
    material-tint: Appearance.glass-effects ? Materials.fab-base : Colors.action-fill;
    background: transparent;
    transform-scale-x: fab-touch.pressed ? 0.92 : 1;
    transform-scale-y: fab-touch.pressed ? 0.88 : 1;
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
    // Keep the teal tint inside the lit rim and the white glyph clear.
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: self.height / 2;
        background: Appearance.glass-effects
            ? (fab-touch.pressed ? Colors.action-active.with-alpha(0.68)
                : fab-touch.has-hover ? Colors.action-hover.with-alpha(0.58)
                : Materials.fab-accent)
            : (fab-touch.pressed ? Colors.action-active
                : fab-touch.has-hover ? Colors.action-hover : transparent);
    }
    accessible-role: button;
    accessible-label: "Create";
    accessible-action-default => { root.create-clicked(); }
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.create-clicked();
                return accept;
            }
            return reject;
        }
    }
    if keys.has-focus: Rectangle {
        border-width: 2px;
        border-color: Colors.focus-ring;
        border-radius: self.width / 2;
    }
    Image {
        source: Icons.plus;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Colors.on-action;
    }
    fab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.create-clicked(); } }
}
