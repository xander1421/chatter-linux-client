// Button component with variants, hover/press states, icons, and loading

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component Button inherits Rectangle {
    in property <string> text: "";
    in property <string> variant: "primary";  // "primary", "secondary", "ghost", "danger"
    in property <bool> disabled: false;
    in property <bool> loading: false;
    in property <image> icon;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: !root.disabled && !root.loading;

    callback clicked();

    // Internal state
    property <bool> hover: false;
    property <bool> pressed: false;

    // Computed background color based on variant and state
    property <color> bg-color: {
        if disabled {
            variant == "primary" ? Colors.primary :
            variant == "secondary" ? Colors.surface :
            variant == "danger" ? Colors.error :
            transparent
        } else if pressed {
            variant == "primary" ? Colors.primary-active :
            variant == "secondary" ? Colors.surface-hover :
            variant == "danger" ? Colors.error-hover :
            Colors.surface-hover.with-alpha(0.2)
        } else if hover {
            variant == "primary" ? Colors.primary-hover :
            variant == "secondary" ? Colors.surface-hover :
            variant == "danger" ? Colors.error-hover :
            Colors.surface.with-alpha(0.1)
        } else {
            variant == "primary" ? Colors.primary :
            variant == "secondary" ? Colors.surface :
            variant == "danger" ? Colors.error :
            transparent
        }
    };

    min-width: 80px;
    height: 44px;
    vertical-stretch: 0;
    border-radius: Spacing.radius-md;
    background: bg-color;
    opacity: disabled ? 0.5 : 1.0;

    // Content layout
    HorizontalLayout {
        alignment: center;
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.sm;

        // Optional icon
        if icon.width > 0 && !loading: Image {
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: Colors.text-primary;
            vertical-alignment: center;
        }

        // Loading spinner (simple animated dots)
        if loading: HorizontalLayout {
            spacing: 2px;
            alignment: center;

            property <float> anim-progress;

            // Three animated dots with staggered opacity
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Colors.text-primary;
                opacity: 0.4 + 0.6 * Math.cos(anim-progress * 360deg);
            }
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Colors.text-primary;
                opacity: 0.4 + 0.6 * Math.cos((anim-progress - 0.33) * 360deg);
            }
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Colors.text-primary;
                opacity: 0.4 + 0.6 * Math.cos((anim-progress - 0.66) * 360deg);
            }

            anim-progress: 0;
            animate anim-progress {
                duration: 1000ms;
                iteration-count: -1;
            }

            init => {
                self.anim-progress = 1.0;
            }
        }

        // Button text
        if !loading: Text {
            text: root.text;
            color: Colors.text-primary;
            font-size: Typography.sm;
            font-weight: Typography.medium;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Interaction area
    touch := TouchArea {
        mouse-cursor: disabled ? default : pointer;

        pointer-event(event) => {
            if !disabled && !loading {
                if event.kind == PointerEventKind.move {
                    hover = true;
                }
            }
        }

        moved => {
            if !disabled && !loading {
                hover = true;
            }
        }

        clicked => {
            if !disabled && !loading {
                root.clicked();
            }
        }
    }

    // Reset hover when mouse leaves
    states [
        hovered when touch.has-hover && !disabled && !loading: {
            hover: true;
        }
        not-hovered when !touch.has-hover: {
            hover: false;
        }
    ]
}
