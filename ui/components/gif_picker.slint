import { GlassSurface } from "glass_surface.slint";
// GIF picker component with search, trending tabs, and preview grid

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { HeaderButton } from "header_button.slint";
import { DismissButton } from "dismiss_button.slint";
import { Skeleton } from "skeleton.slint";
import { Button } from "button.slint";

// GIF data struct for the picker
export struct GifData {
    id: string,
    preview: image,       // Loaded from Rust
    full-url: string,     // URL to send when selected
    width: int,
    height: int,
}

export component GifPicker inherits GlassSurface {
    material-level: 3;
    elevation: 2;
    border-radius: Spacing.radius-xl;

    // Picker visibility
    in property <bool> show: false;

    // Loading state
    in property <bool> loading: false;
    in property <bool> failed: false;

    // GIF results from Rust
    in property <[GifData]> results: [];

    // Search query
    in-out property <string> search-query: "";

    // Callbacks
    callback gif-selected(string, string);  // Returns full GIF URL
    callback search(string);
    callback close();
    callback emoji-mode-requested();  // Switch back to emoji picker

    // Internal state
    property <bool> search-focused: search-input.has-focus;
    property <bool> show-search-results: root.search-query != "";

    // Forward focus to search
    forward-focus: search-input;

    // Only render when visible
    visible: root.show;
    opacity: root.show ? 1 : 0;

    // Picker container — responsive: never exceed parent width
    in property <length> max-picker-width: 320px;
    in property <length> max-picker-height: 400px;
    width: root.max-picker-width;
    height: root.max-picker-height;

    // Block clicks from passing through
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: Spacing.sm;
        spacing: Spacing.sm;

        // Header with emoji toggle, title, and close button
        HorizontalLayout {
            height: Spacing.header-action-box;
            spacing: Spacing.header-action-gap;

            // Emoji toggle — switches back to emoji picker
            HeaderButton {
                icon: Icons.smile;
                label: "Emoji";
                clicked => { root.emoji-mode-requested(); }
            }

            Text {
                text: "GIFs";
                color: Colors.text-primary;
                font-size: Typography.lg;
                font-weight: Typography.semibold;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // Close button
            DismissButton {
                clicked => { root.close(); }
            }
        }

        // Search input
        Rectangle {
            height: 36px;
            border-radius: Spacing.radius-md;
            background: transparent;
            border-width: Spacing.stroke;
            border-color: search-focused ? Colors.primary : Colors.border;

            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;

                // Search icon
                Image {
                    source: Icons.search;
                    colorize: Colors.text-muted;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }

                // Search text input
                search-input := TextInput {
                    horizontal-stretch: 1;
                    height: parent.height;
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                    text <=> root.search-query;

                    edited => {
                        root.search(self.text);
                    }
                }

                // Clear button (shown when search has text)
                if root.search-query != "": Rectangle {
                    width: Spacing.button-height;
                    height: Spacing.button-height;
                    y: (parent.height - self.height) / 2;
                    border-radius: Spacing.radius-full;
                    background: clear-area.has-hover ? Colors.surface-hover : transparent;

                    Image {
                        source: Icons.x;
                        colorize: Colors.text-secondary;
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    clear-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.search-query = "";
                            root.search("");
                        }
                    }
                }
            }
        }

        // Tab bar
        Rectangle {
            height: Spacing.button-height + Spacing.xs * 2;
            background: transparent;
            border-radius: Spacing.radius-md;

            HorizontalLayout {
                padding: Spacing.xs;
                spacing: Spacing.xs;

                // Trending tab
                Rectangle {
                    horizontal-stretch: 1;
                    height: Spacing.button-height;
                    border-radius: Spacing.radius-sm;
                    background: !show-search-results ? Colors.primary.with-alpha(0.2) : (trending-area.has-hover ? Colors.surface-hover : transparent);

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Image {
                            source: Icons.sparkles;
                            colorize: !show-search-results ? Colors.primary : Colors.text-secondary;
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Trending";
                            color: !show-search-results ? Colors.primary : Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: !show-search-results ? Typography.medium : Typography.normal;
                            vertical-alignment: center;
                        }
                    }

                    // Selected indicator
                    if !show-search-results: Rectangle {
                        height: 2px;
                        y: parent.height - 2px;
                        width: parent.width * 60%;
                        x: (parent.width - self.width) / 2;
                        background: Colors.primary;
                        border-radius: 1px;
                    }

                    trending-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.search-query = "";
                            root.search("");
                        }
                    }
                }

                // Search Results tab (only active when searching)
                Rectangle {
                    horizontal-stretch: 1;
                    height: Spacing.button-height;
                    border-radius: Spacing.radius-sm;
                    background: show-search-results ? Colors.primary.with-alpha(0.2) : (results-area.has-hover && root.search-query != "" ? Colors.surface-hover : transparent);
                    opacity: root.search-query != "" ? 1.0 : 0.5;

                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Image {
                            source: Icons.search;
                            colorize: show-search-results ? Colors.primary : Colors.text-secondary;
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Results";
                            color: show-search-results ? Colors.primary : Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: show-search-results ? Typography.medium : Typography.normal;
                            vertical-alignment: center;
                        }
                    }

                    // Selected indicator
                    if show-search-results: Rectangle {
                        height: 2px;
                        y: parent.height - 2px;
                        width: parent.width * 60%;
                        x: (parent.width - self.width) / 2;
                        background: Colors.primary;
                        border-radius: 1px;
                    }

                    results-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.search-query != "";
                    }
                }
            }
        }

        // GIF grid or loading/empty states
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Loading state - show skeleton placeholders
            if root.loading: VerticalLayout {
                spacing: Spacing.sm;
                padding: Spacing.xs;

                // 2 columns, 3 rows of skeleton placeholders
                for row in 3: HorizontalLayout {
                    spacing: Spacing.sm;

                    Skeleton {
                        horizontal-stretch: 1;
                        height: 80px;
                        border-radius: Spacing.radius-md;
                    }

                    Skeleton {
                        horizontal-stretch: 1;
                        height: 80px;
                        border-radius: Spacing.radius-md;
                    }
                }
            }

            // Empty state - no results
            if !root.loading && root.results.length == 0: Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.sm;

                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: show-search-results ? Icons.search : Icons.image;
                            colorize: Colors.text-muted;
                            width: 32px;
                            height: Spacing.button-height;
                        }
                    }

                    Text {
                        text: root.failed ? "Couldn't load GIFs" : (show-search-results ? "No GIFs found" : "No trending GIFs");
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.failed ? "The GIF service is unavailable. Try again later." : (show-search-results ? "Try a different search term" : "Try again later.");
                        wrap: word-wrap;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                    }

                    if root.failed: HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Retry";
                            variant: "secondary";
                            clicked => { root.search(root.search-query); }
                        }
                    }
                }
            }

            // GIF grid - 2 columns
            if !root.loading && root.results.length > 0: Flickable {
                width: 100%;
                height: 100%;
                viewport-height: Math.ceil(root.results.length / 2) * 90px;

                Rectangle {
                    width: parent.width;
                    height: parent.viewport-height;

                    for gif-data[index] in root.results: Rectangle {
                        property <int> grid-row: Math.floor(index / 2);
                        property <int> grid-col: mod(index, 2);
                        property <length> item-width: (parent.width - Spacing.sm) / 2;

                        x: grid-col * (item-width + Spacing.sm);
                        y: grid-row * 90px;
                        width: item-width;
                        height: 85px;
                        border-radius: Spacing.radius-md;
                        background: gif-area.has-hover ? Colors.surface-hover : Colors.background;
                        clip: true;

                        // Hover glow effect

                        // GIF preview image (loaded from Rust)
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: gif-data.preview;
                            image-fit: cover;
                        }

                        gif-area := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.gif-selected(gif-data.id, gif-data.full-url);
                            }
                        }
                    }
                }
            }
        }

        // Klipy attribution
        HorizontalLayout {
            min-height: 16px;
            alignment: center;

            Text {
                text: "Powered by Klipy";
                color: Colors.text-muted;
                font-size: Typography.xs;
                horizontal-alignment: center;
            }
        }
    }
}
