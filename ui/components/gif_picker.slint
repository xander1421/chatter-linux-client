import { GlassSurface } from "glass_surface.slint";
// GIF picker body for the composer drawer: the account's recent GIFs, then
// trending or a search. The drawer owns the material, the search field and
// the Emoji/GIF tabs; this component owns the grid.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Skeleton } from "skeleton.slint";
import { Button } from "button.slint";

// GIF data struct for the picker
export struct GifData {
    id: string,
    preview: image,       // First frame, loaded from Rust; empty until then
    preview-url: string,  // Provider preview, kept for Recent
    full-url: string,     // URL to send when selected
    width: int,
    height: int,
    failed: bool,         // Preview could not be fetched or decoded
}

// One tile. Selectable only once its preview is on screen: a blank tile
// could otherwise send a GIF the user never saw.
component GifTile inherits Rectangle {
    in property <GifData> gif;
    in property <float> reveal: 1.0;
    in property <int> stagger-index: 0;
    callback picked(string, string);
    property <bool> ready: root.gif.preview.width > 0 && !root.gif.failed;

    border-radius: Spacing.radius-md;
    clip: true;
    opacity: root.reveal * (area.pressed ? 0.84 : 1.0);
    animate opacity { duration: Materials.motion-quick; easing: Materials.spring; delay: Appearance.reduce-motion ? 0ms : mod(root.stagger-index, 8) * 18ms; }
    background: root.ready && (area.has-hover || area.pressed) ? Materials.hover : Colors.inset;
    accessible-role: button;
    accessible-label: root.gif.failed ? "GIF " + root.gif.id + ", preview unavailable" : "GIF " + root.gif.id;
    accessible-enabled: root.ready;
    accessible-action-default => { if root.ready { root.picked(root.gif.id, root.gif.full-url); } }

    if root.ready: Image {
        width: parent.width;
        height: parent.height;
        source: root.gif.preview;
        image-fit: cover;
    }
    if !root.ready: Image {
        source: root.gif.failed ? Icons.alert-triangle : Icons.image;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: Colors.text-muted;
        opacity: root.gif.failed ? 1.0 : 0.6;
    }

    area := TouchArea {
        enabled: root.ready;
        mouse-cursor: root.ready ? pointer : default;
        clicked => { root.picked(root.gif.id, root.gif.full-url); }
    }
}

export component GifPicker inherits GlassSurface {
    // The drawer is the material; this is content inside it.
    material-enabled: false;
    elevation: 0;
    border-radius: 0px;

    in property <bool> show: false;
    property <float> reveal-progress: 0.0;
    animate reveal-progress { duration: Materials.motion-standard; easing: Materials.spring; }
    reveal-timer := Timer {
        interval: 1ms;
        running: root.show && root.reveal-progress == 0.0;
        triggered => { root.reveal-progress = 1.0; }
    }
    changed show => { if (!root.show) { root.reveal-progress = 0.0; } }

    // Trending (empty query) or search results, from Rust.
    in property <bool> loading: false;
    in property <bool> failed: false;
    in property <[GifData]> results: [];
    // The signed-in account's sent GIFs, newest first. Local, so it is on
    // screen whether or not the provider answers.
    in property <[GifData]> recent: [];

    // The drawer's query, mirrored so the sections know what they show.
    in-out property <string> search-query: "";

    callback gif-selected(string, string);  // (id, full URL)
    callback search(string);

    property <bool> show-search-results: root.search-query != "";
    property <bool> show-recent: !root.show-search-results && root.recent.length > 0;
    property <bool> show-results: !root.loading && root.results.length > 0;
    property <bool> show-status: !root.loading && root.results.length == 0;

    // Only render when visible
    visible: root.show;
    opacity: root.reveal-progress;

    in property <length> max-picker-width: 320px;
    in property <length> max-picker-height: 400px;
    width: root.max-picker-width;
    height: root.max-picker-height;

    // Grid geometry from the width: as many ~160px columns as fit (never
    // fewer than two), tiles at 16:10 between 72px and 150px tall. Two
    // tiles stretched across a tablet pane were 10:1 strips (RC86).
    property <length> grid-gap: Spacing.sm;
    property <length> grid-width: max(0px, root.width - 2 * Spacing.xs);
    property <int> columns: max(2, Math.floor((root.grid-width + root.grid-gap) / (160px + root.grid-gap)));
    property <length> tile-width: (root.grid-width - (root.columns - 1) * root.grid-gap) / root.columns;
    property <length> tile-height: max(72px, min(150px, root.tile-width * 0.62));
    property <length> row-stride: root.tile-height + root.grid-gap;
    property <length> section-header: 20px * Appearance.text-grow;
    property <length> status-height: root.failed ? 112px : 72px;
    property <length> attribution-height: 20px;
    pure function grid-height(count: int) -> length {
        return Math.ceil(count / root.columns) * root.row-stride;
    }
    property <length> recent-height: root.show-recent
        ? root.section-header + root.grid-height(root.recent.length) : 0px;
    property <length> results-top: root.recent-height;
    property <length> results-height: root.show-results
        ? (root.show-recent ? root.section-header : 0px) + root.grid-height(root.results.length)
        : root.show-status ? root.status-height
        : root.show-recent ? root.section-header : 0px;

    // Block clicks from passing through
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: Spacing.xs;
        spacing: Spacing.xs;

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Loading with nothing local to show: skeleton tiles in the
            // real grid geometry.
            if root.loading && !root.show-recent: Rectangle {
                width: 100%;
                height: 100%;
                clip: true;
                for row in 3: HorizontalLayout {
                    y: row * root.row-stride;
                    height: root.tile-height;
                    spacing: root.grid-gap;
                    for col in root.columns: Skeleton {
                        horizontal-stretch: 1;
                        height: root.tile-height;
                        border-radius: Spacing.radius-md;
                    }
                }
            }

            if !(root.loading && !root.show-recent): gif-grid := Flickable {
                width: 100%;
                height: 100%;
                viewport-height: root.recent-height + root.results-height + root.attribution-height;

                Rectangle {
                    width: parent.width;
                    height: parent.viewport-height;

                    // ── Recent ──
                    if root.show-recent: Text {
                        y: 0px;
                        height: root.section-header;
                        text: "Recent";
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                    }
                    if root.show-recent: Rectangle {
                        y: root.section-header;
                        width: parent.width;
                        height: root.grid-height(root.recent.length);
                        for gif-data[index] in root.recent: GifTile {
                            gif: gif-data;
                            reveal: root.reveal-progress;
                            stagger-index: index;
                            x: mod(index, root.columns) * (root.tile-width + root.grid-gap);
                            y: Math.floor(index / root.columns) * root.row-stride + (1.0 - root.reveal-progress) * 14px;
                            animate y { duration: Materials.motion-standard; easing: Materials.spring; delay: Appearance.reduce-motion ? 0ms : mod(index, 8) * 18ms; }
                            width: root.tile-width;
                            height: root.tile-height;
                            picked(id, url) => { root.gif-selected(id, url); }
                        }
                    }

                    // ── Trending / results ──
                    if root.show-recent && (root.show-results || root.loading): Text {
                        y: root.results-top;
                        height: root.section-header;
                        text: root.loading ? "Loading trending…" : "Trending";
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                    }
                    if root.show-results: Rectangle {
                        y: root.results-top + (root.show-recent ? root.section-header : 0px);
                        width: parent.width;
                        height: root.grid-height(root.results.length);
                        for gif-data[index] in root.results: GifTile {
                            gif: gif-data;
                            reveal: root.reveal-progress;
                            stagger-index: index;
                            x: mod(index, root.columns) * (root.tile-width + root.grid-gap);
                            y: Math.floor(index / root.columns) * root.row-stride + (1.0 - root.reveal-progress) * 14px;
                            animate y { duration: Materials.motion-standard; easing: Materials.spring; delay: Appearance.reduce-motion ? 0ms : mod(index, 8) * 18ms; }
                            width: root.tile-width;
                            height: root.tile-height;
                            picked(id, url) => { root.gif-selected(id, url); }
                        }
                    }

                    // Empty or failed. With recents above it, the provider's
                    // failure is one line and a Retry, not a blank drawer.
                    if root.show-status: VerticalLayout {
                        y: root.results-top;
                        width: parent.width;
                        height: root.status-height;
                        alignment: center;
                        spacing: Spacing.xs;

                        if !root.show-recent: HorizontalLayout {
                            alignment: center;
                            Image {
                                source: root.show-search-results ? Icons.search : Icons.image;
                                colorize: Colors.text-muted;
                                width: 24px;
                                height: 24px;
                            }
                        }

                        Text {
                            text: root.failed ? "Couldn't load GIFs" : (root.show-search-results ? "No GIFs found" : "No trending GIFs");
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.failed ? "The GIF service is unavailable." : (root.show-search-results ? "Try a different search term" : "Try again later.");
                            wrap: word-wrap;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                        }

                        if root.failed: HorizontalLayout {
                            alignment: center;
                            Button {
                                text: "Retry";
                                variant: "secondary";
                                clicked => { root.search(root.search-query); }
                            }
                        }
                    }

                    // Klipy attribution: one centred line below the grid,
                    // inside the scroll, so the last row never sits under it.
                    Text {
                        y: parent.height - root.attribution-height;
                        width: parent.width;
                        height: root.attribution-height;
                        text: "Powered by Klipy";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
