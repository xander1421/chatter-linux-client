import { Toast } from "mod.slint";
import { Spacing } from "../theme/spacing.slint";

// Window-sized host for transient notices and their dismissal timer.
export component ToastOverlay inherits Rectangle {
    in-out property <bool> show-toast;
    in property <string> message;
    in property <string> variant;
    in property <int> secret-chat-starts-pending;
    background: transparent;

    Toast {
        show-toast: root.show-toast;
        message: root.message;
        variant: root.variant;
        max-toast-width: min(360px, root.width - 32px);

        // Top-right is a desktop position. At 411dp the toast is 379px wide —
        // effectively full-bleed — so "top-right" put it squarely over the
        // conversation header, hiding the name of the place the user is in at
        // the exact moment something went wrong there.
        //
        // Narrow screens get the bottom instead, above the composer, which is
        // where Android puts transient messages and where the thumb already is.
        // A width test rather than a platform test, matching the rest of the
        // app's breakpoints (see ui/components/connection_banner.slint).
        property <bool> bottom-anchored: root.width < 520px;

        x: bottom-anchored
            ? (root.width - self.width) / 2
            : root.width - self.width - Spacing.md;
        // Clear of the composer. The host is the inset content layer (like the
        // return-to-call bar), so the system insets are already excluded.
        y: bottom-anchored
            ? root.height - self.height - 80px
            : Spacing.lg;

        dismissed => { root.show-toast = false; }
    }

    // Auto-dismiss timer for toasts
    Timer {
        interval: 5s;
        running: root.show-toast && (root.secret-chat-starts-pending == 0
            || root.message != "Secret chat is getting ready — will start automatically");
        triggered => { root.show-toast = false; }
    }
}
