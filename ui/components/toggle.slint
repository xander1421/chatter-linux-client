import { Spacing } from "../theme/spacing.slint";
import { Materials } from "../theme/materials.slint";
// Toggle switch component with smooth animation

import { Colors } from "../theme/colors.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> disabled: false;
    in property <string> accessible-text: "";

    accessible-role: switch;
    accessible-label: root.accessible-text;
    accessible-enabled: !root.disabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if !root.disabled { root.checked = !root.checked; root.toggled(root.checked); }
    }

    callback toggled(bool);

    // Internal state
    property <bool> hover: false;

    // Computed track color
    property <color> track-color: {
        if checked {
            if hover && !disabled {
                Colors.primary-hover
            } else {
                Colors.primary
            }
        } else {
            if hover && !disabled {
                Colors.control-off.darker(0.1)
            } else {
                Colors.control-off
            }
        }
    };

    // Keep the 44x24 track inside a full-height hit target.
    width: Spacing.switch-width;
    height: Spacing.button-height;
    opacity: disabled ? 0.5 : 1.0;

    // Track
    Rectangle {
        width: 100%;
        height: Spacing.switch-track-height;
        y: (root.height - self.height) / 2;
        border-radius: self.height / 2;
        background: track-color;

        animate background {
            duration: Materials.feedback-duration;
            easing: ease-out;
        }

        // Thumb - 20px circle that slides
        Rectangle {
            width: Spacing.switch-thumb;
            height: Spacing.switch-thumb;
            border-radius: self.height / 2;
            background: Colors.on-action;
            y: Spacing.xxs;
            x: root.checked ? parent.width - self.width - Spacing.xxs : Spacing.xxs;

            animate x {
                duration: Materials.menu-duration;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);  // Slight overshoot for snappy feel
            }
        }
    }

    // Interaction area
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: disabled ? default : pointer;

        clicked => {
            if !disabled {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }

    // Hover state
    states [
        hovered when touch.has-hover && !disabled: {
            hover: true;
        }
        not-hovered when !touch.has-hover: {
            hover: false;
        }
    ]
}
