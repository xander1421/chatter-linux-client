// Toggle switch component with smooth animation

import { Colors } from "../theme/colors.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> disabled: false;
    in property <string> accessible-text: "";

    accessible-role: switch;
    accessible-label: root.accessible-text;
    accessible-enabled: !root.disabled;
    accessible-checkable: true;
    accessible-checked: root.checked;

    callback toggled(bool);

    // Internal state
    property <bool> hover: false;

    // Computed track color
    property <color> track-color: {
        if checked {
            if hover && !disabled {
                Colors.primary-hover
            } else {
                Colors.primary
            }
        } else {
            if hover && !disabled {
                Colors.surface
            } else {
                Colors.surface-hover
            }
        }
    };

    // Dimensions: 44x24 with 20px thumb
    width: 44px;
    height: 24px;
    opacity: disabled ? 0.5 : 1.0;

    // Track
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: track-color;

        animate background {
            duration: 150ms;
            easing: ease-in-out;
        }

        // Thumb - 20px circle that slides
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Colors.text-primary;
            y: 2px;
            x: root.checked ? 22px : 2px;

            animate x {
                duration: 150ms;
                easing: ease-in-out;
            }
        }
    }

    // Interaction area
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: disabled ? default : pointer;

        clicked => {
            if !disabled {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }

    // Hover state
    states [
        hovered when touch.has-hover && !disabled: {
            hover: true;
        }
        not-hovered when !touch.has-hover: {
            hover: false;
        }
    ]
}
