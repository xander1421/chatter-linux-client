import { Spacing } from "../theme/spacing.slint";
import { Materials } from "../theme/materials.slint";
// Toggle switch component with smooth animation

import { Colors } from "../theme/colors.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> disabled: false;
    in property <string> accessible-text: "";

    accessible-role: switch;
    accessible-label: root.accessible-text;
    accessible-enabled: !root.disabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if !root.disabled { root.checked = !root.checked; root.toggled(root.checked); }
    }

    callback toggled(bool);

    // One travelling value drives both the thumb's position and its liquid
    // stretch, so a quick reversal continues from the current shape.
    property <float> travel: checked ? 1 : 0;
    animate travel { duration: Materials.motion-standard; easing: Materials.spring; }

    // Computed track color
    property <color> track-color: {
        if checked {
            if touch.has-hover && !disabled {
                Colors.primary-hover
            } else {
                Colors.primary
            }
        } else {
            if touch.has-hover && !disabled {
                Colors.control-off.darker(0.1)
            } else {
                Colors.control-off
            }
        }
    };

    // Keep the 44x24 track inside a full-height hit target.
    width: Spacing.touch-target-min;
    height: Spacing.touch-target-min;
    opacity: disabled ? 0.5 : 1.0;

    keys := FocusScope {
        width: 0px;
        height: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
    }

    // Track
    Rectangle {
        width: Spacing.switch-width;
        height: Spacing.switch-track-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.height / 2;
        background: track-color;
        border-width: keys.has-focus ? Spacing.stroke : 0px;
        border-color: Colors.focus-ring;

        animate background { duration: Materials.motion-standard; easing: Materials.glide; }

        // Thumb - 20px circle that slides
        Rectangle {
            width: Spacing.switch-thumb + 8px * (root.travel < 0.5 ? root.travel * 2 : (1 - root.travel) * 2);
            height: touch.pressed ? Spacing.switch-thumb - Spacing.xxs : Spacing.switch-thumb;
            border-radius: self.height / 2;
            background: Colors.on-action;
            y: (parent.height - self.height) / 2;
            x: Spacing.xxs + (parent.width - Spacing.switch-thumb - Spacing.xxs * 2) * root.travel
                - (self.width - Spacing.switch-thumb) / 2;
            animate height { duration: Materials.motion-quick; easing: Materials.spring; }
        }
    }

    // Interaction area
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: disabled ? default : pointer;

        clicked => {
            if !disabled {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }

}
