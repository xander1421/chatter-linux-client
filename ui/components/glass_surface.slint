// One material per chrome group. Never instantiate in a message or list row.
// Tint alpha is local to the fill: labels and hit targets stay opaque.
import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Elevation } from "../theme/elevation.slint";

// Callers supply @children, so Slint must inline GlassSurface at each use.
// Keep the material in a childless component instance: its conditional layer
// trees can then share generated code instead of being cloned into every caller.
component GlassMaterial inherits Rectangle {
    in property <bool> material-enabled;
    in property <int> material-level;
    in property <color> material-tint;
    in property <int> elevation;
    in property <bool> backdrop-paused;
    // 1 = the material as designed, 0 = neutral filter values, for which the
    // renderer draws no backdrop layer at all (i-slint-renderer-skia
    // backdrop.rs `filter` returns None). Drops at once, eases back at rest.
    property <float> sampling: root.backdrop-paused ? 0 : 1;
    animate sampling {
        duration: root.backdrop-paused || Appearance.reduce-motion ? 0ms : 160ms;
        easing: ease-out;
    }

    // Elevation shadows (theme/elevation.slint): a wide ambient shadow and a
    // tight contact shadow, both falling downwards. Levels 0-2 cast none here
    // (flat in-content glass); 3 chrome, 4 popover, 5 modal. Elevation's blur
    // tokens are 0 with glass effects off, and these layers are then skipped.
    if root.material-enabled && root.elevation >= 3 && Elevation.chrome-blur > 0: Rectangle {
        border-radius: root.border-radius;
        background: transparent;
        drop-shadow-blur: root.elevation >= 5 ? Elevation.modal-blur
            : root.elevation == 4 ? Elevation.popover-blur : Elevation.chrome-blur;
        drop-shadow-offset-y: root.elevation >= 5 ? Elevation.modal-offset
            : root.elevation == 4 ? Elevation.popover-offset : Elevation.chrome-offset;
        drop-shadow-color: root.elevation >= 5 ? Elevation.modal-shadow
            : root.elevation == 4 ? Elevation.popover-shadow : Elevation.chrome-shadow;
    }
    if root.material-enabled && root.elevation >= 3 && Elevation.chrome-blur > 0: Rectangle {
        border-radius: root.border-radius;
        background: transparent;
        drop-shadow-blur: root.elevation >= 5 ? Elevation.modal-contact-blur
            : root.elevation == 4 ? Elevation.popover-contact-blur : Elevation.chrome-contact-blur;
        drop-shadow-offset-y: root.elevation >= 5 ? Elevation.modal-contact-offset
            : root.elevation == 4 ? Elevation.popover-contact-offset : Elevation.chrome-contact-offset;
        drop-shadow-color: root.elevation >= 5 ? Elevation.modal-contact
            : root.elevation == 4 ? Elevation.popover-contact : Elevation.chrome-contact;
    }
    // SLINT1 builtin integration is intentionally confined to this one element.
    if root.material-enabled: Backdrop {
        border-radius: root.border-radius;
        blur: (Appearance.glass-effects ? (root.material-level == 3
            ? Materials.blur-thick : Materials.blur-regular) : 0px) * root.sampling;
        saturation: 1.0 + ((Appearance.glass-effects ? Materials.saturation : 1.0) - 1.0) * root.sampling;
        brightness: 0.0;
        // Liquid Glass lenses its backdrop at the edges; keep it subtle so
        // text under chrome stays legible.
        refraction: (Appearance.glass-effects ? Materials.refraction : 0.0) * root.sampling;
        Rectangle {
            border-radius: root.border-radius;
            background: root.material-tint;
        }
        if Appearance.glass-effects: Rectangle {
            border-radius: root.border-radius;
            background: Materials.specular;
        }
        if Appearance.glass-effects: Rectangle {
            border-radius: root.border-radius;
            background: Materials.inner-shade;
        }
        // The one optical edge. Glass effects off: no blur and no shadow, so
        // a floating level keeps a flat lit/ink hairline instead.
        if Appearance.glass-effects || root.elevation >= 3: Rectangle {
            x: Materials.glass-edge-width / 2;
            y: self.x;
            width: max(0px, root.width - Materials.glass-edge-width);
            height: max(0px, root.height - Materials.glass-edge-width);
            border-radius: max(0px, root.border-radius - Materials.glass-edge-width / 2);
            border-width: Materials.glass-edge-width;
            border-color: Appearance.glass-effects ? Materials.glass-edge : Elevation.flat-rim;
        }
    }
}

export component GlassSurface inherits Rectangle {
    in property <bool> material-enabled: true;
    // 0 ultra-thin / 1 thin: controlled ambient backgrounds only; 2 regular / 3 thick.
    in property <int> material-level: 2;
    // Level on the theme/elevation.slint scale: 0 flat in-content glass (no
    // shadow), 3 floating chrome, 4 popover/menu, 5 modal/sheet.
    in property <int> elevation: 3;
    // Set while content under this surface is scrolling (the chat chrome
    // binds MessageList.scrolling): the tint stays, the per-frame backdrop
    // blur + refraction of moving pixels stops, and fades back in at rest.
    in property <bool> backdrop-paused: false;
    in property <color> material-tint: material-level == 0 ? Materials.ultra-thin
        : material-level == 1 ? Materials.thin
        : material-level == 3 ? Materials.thick : Materials.regular;
    // Opt in only on transient chrome. No animation exists at idle.
    in property <bool> shown: true;
    in property <length> enter-distance: 0px;
    in property <duration> enter-duration: Materials.menu-duration;
    property <float> open-progress: 0;
    out property <length> entrance-offset: root.enter-distance * (1 - root.open-progress);
    init => { root.open-progress = root.shown ? 1 : 0; }
    changed shown => { root.open-progress = root.shown ? 1 : 0; }
    animate open-progress {
        duration: Appearance.reduce-motion || root.enter-distance == 0px ? 0ms : root.enter-duration;
        easing: Materials.settle;
    }
    border-radius: Spacing.radius-chrome;

    GlassMaterial {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-radius: root.border-radius;
        material-enabled: root.material-enabled;
        material-level: root.material-level;
        material-tint: root.material-tint;
        elevation: root.elevation;
        backdrop-paused: root.backdrop-paused;
    }
    @children
}
