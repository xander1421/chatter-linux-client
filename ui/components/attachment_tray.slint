// Attachment tray component
//
// Horizontal scrollable container for attachments being composed.
// Shows attachments with an "add attachment" button at the end.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { AttachmentItem } from "attachment_item.slint";

export component AttachmentTray inherits Rectangle {
    // Note: For actual model binding, attachments would be provided via
    // a Rust-side ModelRc. The component shows the structure and styling.

    // Callbacks
    callback add-clicked();
    callback remove-clicked(string);
    callback item-clicked(string);

    // Styling
    height: 72px;
    background: transparent;

    Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: self.height;
        interactive: true;

        HorizontalLayout {
            padding: Spacing.sm;
            spacing: Spacing.sm;
            alignment: start;

            // Placeholder attachment items (for preview/testing)
            // In integration, these would be generated from a model

            // Example: AttachmentItem instances would be placed here
            // when integrating with Rust-side data model

            // "Add attachment" button (always at the end)
            Rectangle {
                width: 56px;
                height: 56px;
                background: add-touch.has-hover ? Colors.surface-hover : transparent;
                border-width: 2px;
                border-color: Colors.text-muted;
                border-radius: Spacing.radius-sm;

                // Dashed border effect simulated with background pattern
                // Note: Slint doesn't support dashed borders natively,
                // so we use a semi-transparent border instead

                VerticalLayout {
                    alignment: center;

                    Text {
                        width: 100%;
                        text: "+";
                        font-size: Typography.xxl;
                        color: Colors.text-muted;
                        horizontal-alignment: center;
                    }
                }

                add-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.add-clicked();
                    }
                }
            }
        }
    }
}
