import { GlassSurface } from "glass_surface.slint";
// Emoji picker component with category tabs, search, and emoji grid

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Emoji data struct for the picker
export struct EmojiData {
    emoji: string,
    name: string,
    category: int,
}

export component EmojiPicker inherits GlassSurface {
    material-level: 3;
    elevation: 4;
    border-radius: Spacing.radius-xl;

    // Picker visibility
    in property <bool> show: false;

    // Emoji list from Rust (filtered by category or search)
    in property <[EmojiData]> emoji-list: [];

    // The composer picker offers GIFs; the reaction picker cannot (a GIF is not a reaction).
    in property <bool> show-gif-tab: true;

    // Currently selected category (-1=Recent, 0=Smileys, 1=People, etc.)
    in-out property <int> selected-category: 0;

    // Search query
    in-out property <string> search-query: "";

    // Skin tone (0=default yellow, 1-5=Fitzpatrick modifiers)
    in-out property <int> selected-skin-tone: 0;

    // Callbacks
    callback emoji-selected(string);
    callback close();
    callback category-changed(int);
    callback search-changed(string);
    callback gif-mode-requested();  // Switch to GIF picker
    callback skin-tone-changed(int);

    // Internal state
    property <bool> search-focused: search-input.has-focus;

    // Category icons: Recent (-1), Smileys (0), People (1), etc.
    // Only SMP Emoji_Presentation=Yes code points: 🏳 (U+1F3F3) is ≥ U+1F000 but
    // text-default, and was tofu on Android 10 — flags use 🏁.
    property <[string]> category-icons: ["\u{1F550}", "\u{1F600}", "\u{1F44B}", "\u{1F431}", "\u{1F34E}", "\u{1F680}", "\u{1F3C0}", "\u{1F4A1}", "\u{1F49C}", "\u{1F3C1}"];
    // Map icon index to category value: index 0 → -1 (Recent), index 1 → 0 (Smileys), etc.
    pure function icon-index-to-category(idx: int) -> int { idx - 1; }
    pure function category-to-icon-index(cat: int) -> int { cat + 1; }

    // Forward focus to search
    forward-focus: search-input;

    // Only render when visible
    visible: root.show;
    opacity: root.show ? 1 : 0;

    // Picker container — responsive: never exceed parent width
    in property <length> max-picker-width: 280px;
    in property <length> max-picker-height: 320px;
    width: root.max-picker-width;
    height: root.max-picker-height;

    // Dynamic grid columns based on available width
    property <length> grid-content-width: root.width - 2 * Spacing.sm;
    property <int> emoji-columns: max(4, Math.floor(grid-content-width / 46px));
    property <length> emoji-cell-stride: grid-content-width / emoji-columns;

    // Block clicks from passing through
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: Spacing.sm;
        spacing: Spacing.sm;

        // Search input
        Rectangle {
            height: Spacing.button-height;
            border-radius: Spacing.radius-md;
            background: transparent;
            border-width: Spacing.stroke;
            border-color: search-focused ? Colors.primary : Colors.border;

            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;

                // Search icon — a line icon like every other search field
                Image {
                    source: Icons.search;
                    colorize: Colors.text-secondary;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }

                // Search text input, with a placeholder while empty
                Rectangle {
                    horizontal-stretch: 1;

                    if root.search-query == "": Text {
                        width: 100%;
                        height: 100%;
                        text: "Search emoji";
                        color: Colors.text-muted;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        width: 100%;
                        height: 100%;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                        text <=> root.search-query;

                        edited => {
                            root.search-changed(self.text);
                        }
                    }
                }

                // Clear button (shown when search has text)
                if root.search-query != "": Rectangle {
                    width: Spacing.button-height;
                    height: Spacing.button-height;
                    y: (parent.height - self.height) / 2;
                    border-radius: Spacing.radius-full;
                    background: clear-area.has-hover ? Colors.surface-hover : transparent;

                    Image {
                        source: Icons.x;
                        colorize: Colors.text-secondary;
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    clear-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.search-query = "";
                            root.search-changed("");
                        }
                    }
                }
            }
        }

        // Category tabs (only show when not searching)
        if root.search-query == "": Rectangle {
            height: Spacing.button-height + Spacing.xs * 2;
            background: transparent;
            border-radius: Spacing.radius-md;

            Flickable {
                viewport-width: categories.preferred-width;
                viewport-height: self.height;
                categories := HorizontalLayout {
                    padding: Spacing.xs;
                    spacing: 0;

                    for icon[index] in root.category-icons: Rectangle {
                        property <int> cat: root.icon-index-to-category(index);
                        width: Spacing.button-height;
                        height: Spacing.button-height;
                        border-radius: Spacing.radius-sm;
                        background: cat == root.selected-category ? Colors.primary.with-alpha(0.2) : (tab-area.has-hover ? Colors.surface-hover : transparent);

                        Text {
                            text: icon;
                            font-family: Typography.font-family-emoji;
                            font-size: Typography.base;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Selected indicator
                        if cat == root.selected-category: Rectangle {
                            height: 2px;
                            y: parent.height - 2px;
                            width: parent.width * 60%;
                            x: (parent.width - self.width) / 2;
                            background: Colors.primary;
                            border-radius: 1px;
                        }

                        tab-area := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.selected-category = cat;
                                root.category-changed(cat);
                            }
                        }
                    }

                    // GIF tab — switches to GIF picker
                    if root.show-gif-tab: Rectangle {
                        width: Spacing.button-height;
                        height: Spacing.button-height;
                        border-radius: Spacing.radius-sm;
                        background: gif-tab-area.has-hover ? Colors.surface-hover : transparent;

                        Text {
                            text: "GIF";
                            color: Colors.text-secondary;
                            font-size: Typography.xs;
                            font-weight: Typography.bold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        gif-tab-area := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.gif-mode-requested();
                            }
                        }
                    }
                }
            }
        }

        // Skin tone selector (shown for People & Body category)
        if root.search-query == "" && root.selected-category == 1: Rectangle {
            height: Spacing.button-height;
            background: transparent;
            border-radius: Spacing.radius-sm;

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.none;

                for swatch[tone-idx] in ["\u{1F44B}", "\u{1F44B}\u{1F3FB}", "\u{1F44B}\u{1F3FC}", "\u{1F44B}\u{1F3FD}", "\u{1F44B}\u{1F3FE}", "\u{1F44B}\u{1F3FF}"]: Rectangle {
                    width: Spacing.button-height;
                    height: Spacing.button-height;
                    border-radius: Spacing.radius-sm;
                    background: tone-idx == root.selected-skin-tone ? Colors.primary.with-alpha(0.2) : (tone-area.has-hover ? Colors.surface-hover : transparent);
                    border-width: tone-idx == root.selected-skin-tone ? Spacing.stroke : 0px;
                    border-color: Colors.primary;

                    Text {
                        text: swatch;
                        font-family: Typography.font-family-emoji;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    tone-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.selected-skin-tone = tone-idx;
                            root.skin-tone-changed(tone-idx);
                        }
                    }
                }
            }
        }

        // Search results header (only show when searching)
        if root.search-query != "": Text {
            text: "Search results";
            color: Colors.text-secondary;
            font-size: Typography.xs;
            height: 20px;
            vertical-alignment: center;
        }

        // Emoji grid — columns adapt to available width
        Flickable {
            vertical-stretch: 1;
            viewport-height: Math.ceil(root.emoji-list.length / root.emoji-columns) * 44px;

            // Grid container
            Rectangle {
                width: parent.width;
                height: parent.viewport-height;

                for emoji-data[index] in root.emoji-list: Rectangle {
                    property <int> grid-row: Math.floor(index / root.emoji-columns);
                    property <int> grid-col: mod(index, root.emoji-columns);

                    x: grid-col * root.emoji-cell-stride + (root.emoji-cell-stride - 44px) / 2;
                    y: grid-row * 44px;
                    width: 44px;
                    height: 44px;
                    border-radius: Spacing.radius-sm;
                    background: emoji-area.has-hover ? Colors.surface-hover : transparent;

                    Text {
                        text: emoji-data.emoji;
                        font-family: Typography.font-family-emoji;
                        font-size: Typography.xl;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    emoji-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.emoji-selected(emoji-data.emoji);
                        }
                    }
                }
            }
        }

        // Empty state
        if root.emoji-list.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.sm;

                Text {
                    text: "😕";
                    font-family: Typography.font-family-emoji;
                    font-size: 32px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.search-query != "" ? "No emoji found" : "No emoji in this category";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
