import { GlassSurface } from "glass_surface.slint";
// Emoji picker: category tabs, skin tones and the emoji grid. Standalone
// (the reaction popover) it carries its own search row; embedded in the
// composer drawer the drawer owns search, material and the Emoji/GIF tabs.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Emoji data struct for the picker
export struct EmojiData {
    emoji: string,
    name: string,
    category: int,
}

export component EmojiPicker inherits GlassSurface {
    material-level: 3;
    elevation: 4;
    border-radius: Spacing.radius-xl;

    // Inside another surface (the composer drawer, the reaction popover):
    // flat, no second material or shadow, and no search row of its own.
    in property <bool> embedded: false;
    material-enabled: !root.embedded;
    // Picker visibility
    in property <bool> show: false;
    property <float> reveal-progress: 0.0;
    animate reveal-progress { duration: Materials.motion-standard; easing: Materials.spring; }
    reveal-timer := Timer {
        interval: 1ms;
        running: root.show && root.reveal-progress == 0.0;
        triggered => { root.reveal-progress = 1.0; }
    }
    changed show => { if (!root.show) { root.reveal-progress = 0.0; } }
    // Touch platform: category tabs, tone swatches and emoji cells take the
    // 48px Android minimum; desktop keeps the 44px control slot. Both grow
    // with the text size, as the glyphs in them do.
    in property <bool> touch: false;
    property <length> cell: (root.touch ? Spacing.touch-target-min : Spacing.button-height) * Appearance.text-grow;

    // Emoji list from Rust (filtered by category or search)
    in property <[EmojiData]> emoji-list: [];

    // Currently selected category (-1=Recent, 0=Smileys, 1=People, etc.)
    in-out property <int> selected-category: 0;

    // Search query
    in-out property <string> search-query: "";

    // Skin tone (0=default yellow, 1-5=Fitzpatrick modifiers)
    in-out property <int> selected-skin-tone: 0;

    // Callbacks
    callback emoji-selected(string);
    callback close();
    callback category-changed(int);
    callback search-changed(string);
    callback skin-tone-changed(int);

    // Internal state
    property <bool> search-focused: search-input.has-focus;

    // Category icons: Recent (-1), Smileys (0), People (1), etc.
    // Only SMP Emoji_Presentation=Yes code points: 🏳 (U+1F3F3) is ≥ U+1F000 but
    // text-default, and was tofu on Android 10 — flags use 🏁.
    property <[string]> category-icons: ["\u{1F550}", "\u{1F600}", "\u{1F44B}", "\u{1F431}", "\u{1F34E}", "\u{1F680}", "\u{1F3C0}", "\u{1F4A1}", "\u{1F49C}", "\u{1F3C1}"];
    // The tabs' names, for screen readers and the UI tests; the glyph alone
    // is not a name.
    property <[string]> category-names: ["Recent", "Smileys", "People", "Animals", "Food", "Travel", "Activities", "Objects", "Symbols", "Flags"];
    // Map icon index to category value: index 0 → -1 (Recent), index 1 → 0 (Smileys), etc.
    pure function icon-index-to-category(idx: int) -> int { idx - 1; }
    pure function category-to-icon-index(cat: int) -> int { cat + 1; }

    // Forward focus to search
    forward-focus: search-input;

    // Only render when visible
    visible: root.show;
    opacity: root.reveal-progress;

    // Picker container — responsive: never exceed parent width
    in property <length> max-picker-width: 280px;
    in property <length> max-picker-height: 320px;
    width: root.max-picker-width;
    height: root.max-picker-height;

    // Dynamic grid columns based on available width
    property <length> grid-content-width: root.width - 2 * Spacing.sm;
    property <int> emoji-columns: max(4, Math.floor(grid-content-width / (root.cell + 2px)));
    property <length> emoji-cell-stride: grid-content-width / emoji-columns;

    // Block clicks from passing through
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: root.embedded ? Spacing.xs : Spacing.sm;
        spacing: root.embedded ? Spacing.xs : Spacing.sm;

        // Search lives in the unified drawer when embedded.
        Rectangle {
            visible: !root.embedded;
            height: root.embedded ? 0px : Spacing.button-height;
            // Concentric with the panel: its radius minus the padding.
            border-radius: Spacing.radius-xl - Spacing.sm;
            background: transparent;
            border-width: Spacing.stroke;
            border-color: search-focused ? Colors.primary : Colors.border;

            HorizontalLayout {
                padding-left: Spacing.sm;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;

                // Search icon — a line icon like every other search field
                Image {
                    source: Icons.search;
                    colorize: Colors.text-secondary;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }

                // Search text input, with a placeholder while empty
                Rectangle {
                    horizontal-stretch: 1;

                    if root.search-query == "": Text {
                        width: 100%;
                        height: 100%;
                        text: "Search emoji";
                        color: Colors.text-muted;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        width: 100%;
                        height: 100%;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                        text <=> root.search-query;
                        accessible-label: "Search emoji";

                        edited => {
                            root.search-changed(self.text);
                        }
                    }
                }

                // Clear button (shown when search has text)
                if root.search-query != "": Rectangle {
                    width: Spacing.button-height;
                    height: Spacing.button-height;
                    y: (parent.height - self.height) / 2;
                    border-radius: Spacing.radius-full;
                    background: clear-area.has-hover ? Materials.hover : transparent;
                    accessible-role: button;
                    accessible-label: "Clear search";
                    accessible-action-default => { root.search-query = ""; root.search-changed(""); }

                    Image {
                        source: Icons.x;
                        colorize: Colors.text-secondary;
                        width: 12px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    clear-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.search-query = "";
                            root.search-changed("");
                        }
                    }
                }
            }
        }

        // Category tabs (only show when not searching)
        if root.search-query == "": Rectangle {
            height: root.cell + Spacing.xs * 2;
            background: transparent;
            border-radius: Spacing.radius-md;

            Flickable {
                viewport-width: categories.preferred-width;
                viewport-height: self.height;
                categories := HorizontalLayout {
                    padding: Spacing.xs;
                    spacing: 0;

                    for icon[index] in root.category-icons: Rectangle {
                        property <int> cat: root.icon-index-to-category(index);
                        property <bool> current: cat == root.selected-category;
                        width: root.cell;
                        height: root.cell;
                        border-radius: Spacing.radius-sm;
                        background: current ? Colors.tint-strong
                            : tab-area.pressed ? Materials.pressed
                            : tab-area.has-hover ? Materials.hover : transparent;
                        animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                        accessible-role: tab;
                        accessible-label: root.category-names[index];
                        accessible-item-selected: current;
                        accessible-action-default => { root.selected-category = cat; root.category-changed(cat); }

                        Text {
                            text: icon;
                            font-family: Typography.font-family-emoji;
                            font-size: Typography.base;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Selected indicator
                        if current: Rectangle {
                            height: 2px;
                            y: parent.height - 2px;
                            width: parent.width * 60%;
                            x: (parent.width - self.width) / 2;
                            background: Colors.primary;
                            border-radius: 1px;
                        }

                        tab-area := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.selected-category = cat;
                                root.category-changed(cat);
                            }
                        }
                    }
                }
            }
        }

        // Skin tone selector (shown for People & Body category)
        if root.search-query == "" && root.selected-category == 1: Rectangle {
            height: root.cell;
            background: transparent;
            border-radius: Spacing.radius-sm;

            HorizontalLayout {
                alignment: center;
                spacing: Spacing.none;

                for swatch[tone-idx] in ["\u{1F44B}", "\u{1F44B}\u{1F3FB}", "\u{1F44B}\u{1F3FC}", "\u{1F44B}\u{1F3FD}", "\u{1F44B}\u{1F3FE}", "\u{1F44B}\u{1F3FF}"]: Rectangle {
                    property <bool> current: tone-idx == root.selected-skin-tone;
                    width: root.cell;
                    height: root.cell;
                    border-radius: Spacing.radius-sm;
                    background: current ? Colors.tint-strong
                        : tone-area.pressed ? Materials.pressed
                        : tone-area.has-hover ? Materials.hover : transparent;
                    border-width: current ? Spacing.stroke : 0px;
                    border-color: Colors.primary;
                    accessible-role: button;
                    accessible-label: tone-idx == 0 ? "Default skin tone" : "Skin tone " + tone-idx;
                    accessible-action-default => { root.selected-skin-tone = tone-idx; root.skin-tone-changed(tone-idx); }

                    Text {
                        text: swatch;
                        font-family: Typography.font-family-emoji;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    tone-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.selected-skin-tone = tone-idx;
                            root.skin-tone-changed(tone-idx);
                        }
                    }
                }
            }
        }

        // Search results header (only show when searching)
        if root.search-query != "" && !root.embedded: Text {
            text: "Search results";
            color: Colors.text-secondary;
            font-size: Typography.xs;
            height: 20px;
            vertical-alignment: center;
        }

        // Emoji grid — columns adapt to available width. The empty state is
        // drawn over the same box, so it sits in the middle of the results
        // area rather than under a zero-height grid.
        Rectangle {
            vertical-stretch: 1;

            emoji-grid := Flickable {
                width: 100%;
                height: 100%;
                viewport-height: Math.ceil(root.emoji-list.length / root.emoji-columns) * root.cell;

                // Grid container
                Rectangle {
                    width: parent.width;
                    height: parent.viewport-height;

                    for emoji-data[index] in root.emoji-list: Rectangle {
                        property <int> grid-row: Math.floor(index / root.emoji-columns);
                        property <int> grid-col: mod(index, root.emoji-columns);

                        x: grid-col * root.emoji-cell-stride + (root.emoji-cell-stride - root.cell) / 2;
                        y: grid-row * root.cell + (1.0 - root.reveal-progress) * 12px;
                        opacity: root.reveal-progress;
                        animate y { duration: Materials.motion-standard; easing: Materials.spring; delay: Appearance.reduce-motion ? 0ms : mod(index, 8) * 18ms / Appearance.animation-speed; }
                        animate opacity { duration: Materials.motion-quick; easing: Materials.settle; delay: Appearance.reduce-motion ? 0ms : mod(index, 8) * 18ms / Appearance.animation-speed; }
                        width: root.cell;
                        height: root.cell;
                        border-radius: Spacing.radius-sm;
                        background: emoji-area.pressed ? Materials.pressed
                            : emoji-area.has-hover ? Materials.hover : transparent;
                        accessible-role: button;
                        accessible-label: emoji-data.emoji;
                        accessible-action-default => { root.emoji-selected(emoji-data.emoji); }

                        Text {
                            text: emoji-data.emoji;
                            font-family: Typography.font-family-emoji;
                            font-size: emoji-area.pressed ? Typography.xl * 0.82 : Typography.xl;
                            animate font-size { duration: Materials.motion-quick; easing: Materials.spring; }
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        emoji-area := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.emoji-selected(emoji-data.emoji);
                            }
                        }
                    }
                }
            }

            // Empty state
            if root.emoji-list.length == 0: VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                spacing: Spacing.sm;

                Text {
                    text: root.search-query == "" && root.selected-category == -1 ? "\u{1F550}" : "\u{1F615}";
                    font-family: Typography.font-family-emoji;
                    font-size: Typography.xxxl;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.search-query != "" ? "No emoji found"
                        : root.selected-category == -1 ? "Emoji you use show up here"
                        : "No emoji in this category";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
