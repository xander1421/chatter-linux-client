// A compact checkbox visual inside the shared minimum hit target.
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";

export component Checkbox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: Spacing.button-height;
    height: Spacing.button-height;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled { root.checked = !root.checked; root.toggled(root.checked); }
    }
    Rectangle {
        width: Spacing.switch-thumb;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Spacing.radius-sm;
        border-width: Spacing.stroke;
        border-color: root.checked ? Colors.action-fill : Colors.text-muted;
        background: root.checked ? (touch.pressed ? Colors.action-active : Colors.action-fill)
            : touch.pressed || touch.has-hover ? Colors.surface-hover : transparent;
        opacity: root.enabled ? 1 : 0.38;
        if root.checked: Image {
            source: Icons.check;
            width: Spacing.md;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.on-action;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled { root.checked = !root.checked; root.toggled(root.checked); }
        }
    }
}
