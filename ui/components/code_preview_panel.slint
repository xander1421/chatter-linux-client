import { GlassSurface } from "glass_surface.slint";
// Code preview panel component
//
// Displays syntax-highlighted code with line numbers in a scrollable panel.
// Uses slint-code-view for rendering with selection support.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { HeaderButton } from "header_button.slint";
import { DismissButton } from "dismiss_button.slint";
import { Typography } from "../theme/typography.slint";

export component CodePreviewPanel inherits Rectangle {
    // File info
    in property <string> file-name: "";
    in property <string> language: "";
    in property <int> line-count: 0;

    // Plain text for copy-all functionality
    in property <string> plain-text: "";

    // Callbacks
    callback close-clicked();
    callback copy-clicked();
    callback open-external-clicked();

    // Panel styling
    background: Colors.background;
    border-radius: Spacing.radius-panel;
    border-width: 1px;
    border-color: Colors.border;
    clip: true;

    VerticalLayout {
        padding: Spacing.panel-gutter;
        spacing: Spacing.panel-gutter;

        // Header island
        GlassSurface {
            material-level: 2;
            elevation: 3;
            border-radius: Spacing.radius-panel;
            border-width: 1px;
            border-color: Colors.border;

            // As tall as the header buttons, so the file name shares their axis.
            height: Spacing.header-action-box;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: space-between;

                // Left side: file info
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.sm;
                    alignment: start;

                    // File name
                    Text {
                        text: root.file-name;
                        horizontal-stretch: 1;
                        overflow: elide;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                    }

                    // Language badge
                    if root.language != "": Rectangle {
                        height: 20px;
                        width: lang-text.preferred-width + Spacing.sm * 2;
                        background: transparent;
                        border-width: 1px;
                        border-color: Colors.border;
                        border-radius: Spacing.radius-control;

                        lang-text := Text {
                            text: root.language;
                            color: Colors.text-secondary;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Line count
                    if root.line-count > 0: Text {
                        text: root.line-count + " lines";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }
                }

                // Right side: action buttons
                HorizontalLayout {
                    spacing: Spacing.header-action-gap;
                    alignment: end;

                    // Copy all button
                    HeaderButton {
                        icon: Icons.copy;
                        label: @tr("Copy");
                        clicked => { root.copy-clicked(); }
                    }

                    // Open external button
                    HeaderButton {
                        icon: Icons.link;
                        label: @tr("Open externally");
                        clicked => { root.open-external-clicked(); }
                    }

                    // Close button
                    DismissButton {
                        clicked => { root.close-clicked(); }
                    }
                }
            }
        }

        // Code view: plain text, monospace, scrollable both axes.
        Rectangle {
            vertical-stretch: 1;
            background: Colors.surface-card;
            border-radius: Spacing.radius-panel;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                viewport-height: code-text.preferred-height + Spacing.md * 2;
                viewport-width: max(code-text.preferred-width + Spacing.md * 2, self.width);

                // Read-only TextInput → drag-select + Ctrl+C copy, monospace.
                code-text := TextInput {
                    x: Spacing.md;
                    y: Spacing.sm;
                    text: root.plain-text;
                    read-only: true;
                    single-line: false;
                    color: Colors.text-primary;
                    font-family: Typography.font-family-mono;
                    font-size: Typography.sm;
                    wrap: no-wrap;
                }
            }
        }
    }
}
