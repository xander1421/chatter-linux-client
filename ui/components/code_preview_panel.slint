// Code preview panel component
//
// Displays syntax-highlighted code with line numbers in a scrollable panel.
// Uses slint-code-view for rendering with selection support.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component CodePreviewPanel inherits Rectangle {
    // File info
    in property <string> file-name: "";
    in property <string> language: "";
    in property <int> line-count: 0;

    // Rendered code image from slint-code-view
    in property <image> code-image;

    // Plain text for copy-all functionality
    in property <string> plain-text: "";

    // Selection state (for UI feedback)
    in property <bool> has-selection: false;
    in property <string> selected-text: "";

    // Callbacks
    callback close-clicked();
    callback copy-clicked();
    callback copy-selection-clicked();
    callback open-external-clicked();

    // Pointer events for selection handling
    callback pointer-down(/* x */ length, /* y */ length, /* shift */ bool, /* ctrl */ bool);
    callback pointer-move(/* x */ length, /* y */ length);
    callback pointer-up(/* x */ length, /* y */ length);

    // Code preview background
    property <color> code-background: Colors.code-bg;

    // Panel styling
    background: root.code-background;
    border-radius: Spacing.radius-md;
    clip: true;

    VerticalLayout {
        // Header bar
        Rectangle {
            height: 40px;
            background: Colors.surface;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.sm;
                spacing: Spacing.sm;
                alignment: space-between;

                // Left side: file info
                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;

                    // File name
                    Text {
                        text: root.file-name;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                    }

                    // Language badge
                    if root.language != "": Rectangle {
                        height: 20px;
                        width: lang-text.preferred-width + Spacing.sm * 2;
                        background: Colors.surface-hover;
                        border-radius: Spacing.radius-sm;

                        lang-text := Text {
                            text: root.language;
                            color: Colors.text-secondary;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Line count
                    if root.line-count > 0: Text {
                        text: root.line-count + " lines";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }
                }

                // Right side: action buttons
                HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: end;

                    // Copy selection button (only visible when there's a selection)
                    if root.has-selection: Rectangle {
                        width: 32px;
                        height: 32px;
                        background: copy-sel-touch.has-hover ? Colors.primary.transparentize(0.8) : transparent;
                        border-radius: Spacing.radius-sm;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{2702}"; // Scissors
                            font-size: Typography.sm;
                            color: Colors.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        copy-sel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.copy-selection-clicked();
                            }
                        }
                    }

                    // Copy all button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: copy-touch.has-hover ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{1F4CB}"; // Clipboard
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        copy-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.copy-clicked();
                            }
                        }
                    }

                    // Open external button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: open-touch.has-hover ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{1F517}"; // Link
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        open-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-external-clicked();
                            }
                        }
                    }

                    // Close button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: close-touch.has-hover ? Colors.error.transparentize(0.8) : transparent;
                        border-radius: Spacing.radius-sm;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{2715}"; // X mark
                            font-size: Typography.sm;
                            color: close-touch.has-hover ? Colors.error : Colors.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-clicked();
                            }
                        }
                    }
                }
            }
        }

        // Code view: plain text, monospace, scrollable both axes.
        Flickable {
            vertical-stretch: 1;
            viewport-height: code-text.preferred-height + Spacing.md * 2;
            viewport-width: max(code-text.preferred-width + Spacing.md * 2, self.width);

            // Read-only TextInput → drag-select + Ctrl+C copy, monospace.
            code-text := TextInput {
                x: Spacing.md;
                y: Spacing.sm;
                text: root.plain-text;
                read-only: true;
                single-line: false;
                color: Colors.text-primary;
                font-family: "monospace";
                font-size: Typography.sm;
                wrap: no-wrap;
            }
        }
    }
}
