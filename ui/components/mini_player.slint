// Mini player: controls for the loaded voice message / audio file while its
// conversation is not the one on screen. Playback outlives the conversation
// it started in, so the app places these controls above the current page.

import { Appearance } from "../theme/appearance.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Materials } from "../theme/materials.slint";
import { KeyFocus } from "key_focus.slint";
import { GlassSurface } from "glass_surface.slint";
import { IconAction } from "icon_action.slint";
import { DismissButton } from "dismiss_button.slint";

export component MiniPlayer inherits Rectangle {
    in property <string> title;
    in property <string> sender;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed;
    in property <bool> touch;
    property <bool> phone-layout: root.touch && root.width < 600px;

    callback toggle();  // play / pause
    callback close();   // stop playback
    callback open();    // return to the message

    height: Spacing.touch-target-min + Spacing.sm
        + (root.phone-layout ? 0px : 2 * Spacing.panel-gutter);

    GlassSurface {
        x: root.phone-layout ? 0px : Spacing.panel-gutter;
        y: self.x;
        width: max(0px, parent.width - 2 * self.x);
        height: parent.height - 2 * self.y;
        border-radius: Spacing.radius-panel;
        border-width: 1px;
        border-color: Colors.border;

        HorizontalLayout {
            padding-left: Spacing.md;
            padding-right: Spacing.sm;
            padding-bottom: Spacing.sm;
            spacing: Spacing.sm;

            VerticalLayout {
                alignment: center;
                IconAction {
                    size: Spacing.touch-target-min;
                    visual-size: 32px;
                    active: true;
                    label: root.playing ? @tr("Pause voice message") : @tr("Play voice message");
                    icon: root.playing ? Icons.pause : Icons.play;
                    clicked => { root.toggle(); }
                }
            }

            // Title and sender: the way back to the message.
            Rectangle {
                horizontal-stretch: 1;
                accessible-role: button;
                accessible-label: @tr("Go to message");
                accessible-action-default => { root.open(); }
                KeyFocus { activate => { root.open(); } }

                VerticalLayout {
                    alignment: center;
                    spacing: Spacing.xxs;

                    Text {
                        text: root.title;
                        color: Colors.text-primary;
                        font-size: 13px * Appearance.text-scale;
                        font-weight: Typography.semibold;
                        overflow: elide;
                    }

                    Text {
                        text: root.sender == "" ? root.elapsed : root.sender + " · " + root.elapsed;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        overflow: elide;
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open(); }
                }
            }

            DismissButton {
                plain: true;
                touch: root.touch;
                clicked => { root.close(); }
            }
        }

        Rectangle {
            x: Spacing.panel-gutter;
            y: parent.height - self.height - Spacing.xs;
            width: max(0px, parent.width - 2 * self.x);
            height: 2px;
            border-radius: Spacing.radius-full;
            background: transparent;
            border-width: 1px;
            border-color: Colors.border;

            Rectangle {
                x: 0px;
                width: parent.width * clamp(root.progress, 0.0, 1.0);
                height: parent.height;
                border-radius: parent.border-radius;
                background: Colors.primary;
                animate width { duration: Materials.motion-quick; easing: Materials.settle; }
            }
        }
    }
}
