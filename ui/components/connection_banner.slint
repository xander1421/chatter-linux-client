// Connection status banner — Neo 2.0 with glow effects on reconnecting
//
// Two facts, and the second one is the point of it:
//
//   1. the chatter server cannot be reached;
//   2. what — if anything — still works while that is true.
//
// (2) exists because this app has a serverless BLE mesh, so "no server" is not
// the end of the app the way it is in every other chat client. A banner that
// said only (1) would be telling the user the app is down at the exact moment
// the one feature built for that situation is up.
//
// The honesty rule from `ui/mesh/mesh_context_bar.slint` applies here and is
// load-bearing: never claim the mesh works when it does not. Every value below
// comes from `MeshGlobal` and `connection-state`, both filled by Rust from
// `chatter-core`; the banner chooses wording, never facts. In particular a mesh
// whose service failed to start is said to be down, not quietly omitted, and
// "the mesh is running" is never allowed to read as "your message will arrive"
// — delivery is the context bar's subject, not this one's.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Materials } from "../theme/materials.slint";
import { Elevation } from "../theme/elevation.slint";
import { Icons } from "../theme/icons.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { AnonMode, TorStatus } from "../anon_mode/anon_mode_global.slint";
import { MeshGlobal } from "../mesh/mesh_global.slint";

export component ConnectionBanner inherits Rectangle {
    // "connected", "connecting", "reconnecting", "disconnected", "failed"
    in property <string> connection-state: "connected";
    // The server is settled-unreachable, as opposed to still being tried. Comes
    // from chatter-core (`ConnectionState::is_unreachable`) rather than being
    // re-derived from the string above, so this and the sign-in screens cannot
    // end up disagreeing about it.
    in property <bool> server-unreachable: false;
    in property <int> reconnect-attempt: 0;

    // Dismissing hides the banner, not the fact. The caller keeps a red dot on
    // the sidebar's settings button for as long as the server is unreachable,
    // so closing this trades a paragraph for a pixel rather than for silence.
    // The caller also clears the dismissal on reconnect, so a *later* outage
    // gets a fresh banner instead of being swallowed by an old dismissal.
    in property <bool> suppressed: false;
    callback dismissed();

    // Internal: tracks "just reconnected" for the green flash
    property <bool> just-reconnected: false;

    // Narrow screen. Same idiom as `ui/chat/chat_header.slint` (`tight` /
    // `mesh-tight`): a width test, not a platform test.
    //
    // This banner is drawn on every screen for as long as the server is gone, so
    // on a phone it is the one piece of chrome that must cost a single line. Two
    // sentences at 411dp is nine percent of the display permanently spent on a
    // fact that fits in three words, and it pushes the whole app down to say it.
    // Above the breakpoint there is room for the full wording, so it keeps it.
    property <bool> tight: root.width < 520px;
    // One line of 12px text with breathing room. The close button below is 44px
    // and overflows this by 2px at each edge on purpose: the touch minimum is
    // not negotiable, and it is a transparent box, so nothing shows for it.
    property <length> compact-height: 40px;

    // Tor connect in progress / failed while in shield mode — surface it in the
    // banner (state 1 = connecting, 3 = error; 2 = connected is silent).
    property <bool> tor-connecting: AnonMode.enabled && TorStatus.state == 1;
    property <bool> tor-error: AnonMode.enabled && TorStatus.state == 3;

    // Show banner when not connected (or briefly after reconnect), or while Tor
    // is still establishing / has errored in shield mode.
    property <bool> should-show: !root.suppressed && (
        connection-state == "connecting"
        || connection-state == "reconnecting"
        || connection-state == "disconnected"
        || connection-state == "failed"
        || root.tor-connecting
        || root.tor-error
        || root.just-reconnected);

    // The mesh sentence appears only once the server is settled-unreachable:
    // during "connecting" the honest position is that we do not know yet, and
    // pre-announcing a fallback would be the app talking itself down.
    //
    // And never on a narrow screen, where it is the second of two paragraphs at
    // the top of every screen. What the mesh is doing belongs where the mesh is
    // — the mesh header and its context strip both say it — not stapled above
    // the conversation list.
    //
    // And not while the user is *in* a mesh conversation, where it is said twice.
    // There the header carries the peer count on its own line and the strip below
    // it explains what a send means when nobody is in range — so this sentence
    // repeated "Nobody is in range yet; what you send waits to be carried" a few
    // pixels above a strip saying the same thing, wrapping to two lines to do it.
    // What the banner still says there is the part the mesh surfaces cannot: that
    // the *server* is unreachable, which is why it is open at all.
    property <bool> show-mesh-line:
        !root.tight && MeshGlobal.enabled && root.server-unreachable && MeshGlobal.active-id == "";

    // What is left when the server is gone. Ordered by what the user can act on.
    //
    // `MeshGlobal.running` first, because a mesh that never started is the one
    // case where the answer is "nothing" and saying anything else would be a
    // lie. Then Bluetooth off, which is actionable. Then the ordinary states,
    // where the peer count is the whole signal and zero is normal.
    property <string> radio-down-clause:
        MeshGlobal.radio-down == "bluetooth-off" ? "Bluetooth is off" : "the Bluetooth radio is unavailable";
    property <string> mesh-line:
        !MeshGlobal.running
            ? "The mesh is not running either, so there is nothing to fall back to."
      : !MeshGlobal.radio-running
            // Relay counts are stated rather than summarised as "relays work":
            // a cell rides Nostr, which is servers over the internet, so this is
            // the one mesh path that is not actually infrastructure-free.
            ? (MeshGlobal.relay-count == 0
                ? "Mesh is on, but " + root.radio-down-clause + " and no relay is connected — nothing can carry a message right now."
              : MeshGlobal.relay-count == 1
                ? "Mesh is on but " + root.radio-down-clause + ". Only the 1 connected relay can carry, and relays need internet."
                : "Mesh is on but " + root.radio-down-clause + ". Only the " + MeshGlobal.relay-count + " connected relays can carry, and relays need internet.")
      : MeshGlobal.peer-count == 0
            ? "Mesh is running over Bluetooth. Nobody is in range yet; what you send waits to be carried."
      : MeshGlobal.peer-count == 1
            ? "Mesh is running over Bluetooth — 1 nearby. Mesh conversations do not need the server."
            : "Mesh is running over Bluetooth — " + MeshGlobal.peer-count + " nearby. Mesh conversations do not need the server.";

    visible: root.should-show || self.height > 0px;
    clip: true;
    // Wide: content-driven, because the mesh sentence wraps and the half of it
    // that would get cut is the half that says the mesh is *not* a substitute
    // for the server.
    // Narrow: one fixed line. Nothing in the compact form wraps, so there is
    // nothing for the content to drive.
    height: !root.should-show ? 0px
          : root.tight ? root.compact-height
          : content.preferred-height;
    animate height { duration: Materials.motion-standard; easing: Materials.spring; }

    // Banner color based on state
    property <color> banner-color:
        root.just-reconnected ? Colors.success :
        root.tor-error ? Colors.error :
        root.tor-connecting ? Colors.warning :
        connection-state == "connecting" || connection-state == "reconnecting" ? Colors.warning :
        connection-state == "failed" ? Colors.error :
        Colors.error;  // disconnected

    border-radius: Spacing.radius-chrome;
    background: Colors.surface;

    Rectangle {
        border-radius: root.border-radius;
        background: root.banner-color.with-alpha(0.10);
    }
    // Neo 2.0: glow bloom on connecting/reconnecting states
    drop-shadow-blur: connection-state == "connecting" || connection-state == "reconnecting"
        ? Elevation.halo-blur-strong : 0px;
    drop-shadow-color: connection-state == "connecting" || connection-state == "reconnecting"
        ? Colors.primary.with-alpha(0.2) : transparent;
    drop-shadow-offset-y: connection-state == "connecting" || connection-state == "reconnecting"
        ? 2px : 0px;

    // Bottom border accent
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: root.banner-color.with-alpha(0.3);
    }

    content := VerticalLayout {
        padding-left: root.tight ? Spacing.sm : Spacing.lg;
        padding-right: root.tight ? Spacing.sm : Spacing.lg;
        // Narrow: -2px, i.e. (40 - 44) / 2. The row is the close button's 44px
        // and cannot be less; the negative padding centres that 44px inside the
        // 40px banner instead of letting it hang off the bottom edge. Nothing
        // visible overflows — the button is a transparent box — and the target
        // stays the full 44px. Ordinary padding on top of a 44px row is what
        // turned one sentence into a slab in the first place.
        padding-top: root.tight ? (root.compact-height - Spacing.button-height) / 2 : Spacing.sm;
        padding-bottom: root.tight ? (root.compact-height - Spacing.button-height) / 2 : Spacing.sm;
        spacing: Spacing.xxs;

        HorizontalLayout {
            spacing: root.tight ? Spacing.xs : Spacing.sm;
            alignment: center;

            // Status dot (pulsing for connecting states)
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.banner-color;
                y: (parent.height - self.height) / 2;

                // Pulse animation for connecting/reconnecting
                states [
                    pulsing when connection-state == "connecting" || connection-state == "reconnecting": {
                        opacity: 0.4;
                    }
                ]
                animate opacity { duration: Appearance.reduce-motion ? 0ms : 800ms / Appearance.animation-speed; easing: ease-in-out; }
            }

            // Status text. Two wordings for the same fact: the long one explains
            // the consequence, the short one states the fact and lets the rest of
            // the screen exist. On a phone the consequence — that a message sent
            // now is sent later — is already visible per-message as a pending
            // tick, so the banner does not have to spend a second line on it.
            Text {
                text: root.just-reconnected ? "Connected" :
                      root.tor-error ? (root.tight ? "Tor error — retrying…" : "Tor connection error — retrying…") :
                      root.tor-connecting ? "Connecting over Tor…" :
                      connection-state == "connecting" ? "Connecting…" :
                      connection-state == "reconnecting" ? (root.tight
                          ? "Reconnecting…"
                          : "Reconnecting" + (reconnect-attempt > 0 ? " (attempt " + reconnect-attempt + ")…" : "…")) :
                      connection-state == "failed" ? (root.tight ? "Server unreachable" : "Server unreachable — check your network") :
                      root.tight ? "No server — messages will send later"
                                 : "Server unreachable — messages will send later";
                color: root.banner-color;
                font-size: Typography.xs;
                font-weight: Typography.medium;
                vertical-alignment: center;
                // Narrow: one line, guaranteed. Elide rather than wrap so an
                // unexpectedly long state string cannot re-grow the banner.
                wrap: root.tight ? TextWrap.no-wrap : TextWrap.word-wrap;
                overflow: root.tight ? TextOverflow.elide : TextOverflow.clip;
                min-width: 0px;
                horizontal-stretch: 1;
            }

            // Close. 44px touch target — this sits at the top of the screen on a
            // phone, where a 16px icon is a miss more often than a hit. It stays
            // 44px in the compact banner too, centred in a 40px row, so it is the
            // banner that gives the 4px rather than the target.
            Rectangle {
                width: 44px;
                height: 44px;
                horizontal-stretch: 0;
                border-radius: 6px;
                background: close-touch.has-hover ? root.banner-color.with-alpha(0.15) : transparent;
                transform-scale-x: close-touch.pressed ? 88% : 100%;
                transform-scale-y: close-touch.pressed ? 88% : 100%;
                animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                Image {
                    source: Icons.x;
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: root.banner-color;
                }

                close-touch := TouchArea {
                    clicked => { root.dismissed(); }
                }
                accessible-role: button;
                accessible-label: "Dismiss the connection banner";
            }
        }

        // What still works. Muted rather than coloured: this is the reassuring
        // half, and painting it in the error colour would file it under the
        // problem.
        if root.show-mesh-line: Text {
            text: root.mesh-line;
            color: MeshGlobal.running ? Colors.text-muted : root.banner-color;
            font-size: Typography.xxs;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: root.mesh-line;
        }
    }
}
