// Avatar component with image, fallback initials, and presence indicator

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Appearance } from "../theme/appearance.slint";

// Initials from a display name. Backed by core's `initials_from_name`
// (wired in lib.rs) so every avatar abbreviates a name the same way.
export global AvatarText {
    pure callback initials(string) -> string;
}

export component Avatar inherits Rectangle {
    in property <image> source;
    in property <bool> anonymous: false;
    // A display name: the fallback shows its initials. Prefer this over
    // `fallback-text`, which is rendered verbatim.
    in property <string> name: "";
    in property <string> fallback-text: "";
    in property <length> size: Spacing.avatar-md;
    in property <bool> show-presence: false;
    in property <color> presence-color: Colors.offline;
    // Colored background for letter-based fallback avatars.
    // When set (non-transparent), overrides default surface color for the fallback circle.
    in property <color> fallback-bg: transparent;

    accessible-role: image;
    accessible-label: root.name != "" ? "Avatar for " + root.name
        : root.fallback-text != "" ? "Avatar for " + root.fallback-text : "Avatar";

    width: size;
    height: size;
    background: transparent;

    // Clipped circle holding the image / fallback initials.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.size / 2;
        background: root.source.width > 0 ? Colors.surface : (root.fallback-bg.transparentize(1.0) == root.fallback-bg ? Colors.primary.transparentize(0.7) : root.fallback-bg);
        clip: true;

        if root.source.width > 0: Image {
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: cover;
        }

        if root.source.width <= 0: Text {
            width: 100%;
            height: 100%;
            text: root.name != "" ? AvatarText.initials(root.name) : root.fallback-text;
            color: Colors.text-primary;
            font-size: root.size * 0.4;
            font-weight: Typography.semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Anonymous identities keep their purple ring around real images or initials.
    if root.anonymous: Rectangle {
        x: -2px;
        y: -2px;
        width: root.size + 4px;
        height: root.size + 4px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Colors.group-accent;
        background: transparent;
    }

    // Presence indicator dot — bottom-left, sitting just outside the circle
    // for maximum visibility (no longer clipped by the avatar mask).
    if show-presence: Rectangle {
        width: root.size * 0.28;
        height: self.width;
        x: -1px;
        y: root.height - self.height + 1px;
        border-radius: self.width / 2;
        background: root.presence-color;
        border-width: 2px;
        border-color: Colors.background;
        // Keep the halo at the breathing animation's midpoint. A clock-bound
        // color makes every online avatar redraw the whole window at idle.
        if root.presence-color == Colors.online: Rectangle {
            width: parent.width + 5px;
            height: self.width;
            x: -2.5px;
            y: -2.5px;
            border-radius: self.width / 2;
            background: transparent;
            border-width: 1px;
            border-color: Colors.online.with-alpha(Appearance.reduce-motion ? 0 : 0.28);
        }
    }
}
