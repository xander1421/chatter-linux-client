// Keyboard stop for a hand-built button: a Rectangle with a TouchArea and an
// accessible default action is reachable by mouse and screen reader but not
// by Tab. Place one inside it (it fills the parent): Tab focuses it, Space or
// Return activates, and the focus ring draws over the parent's shape.
import { Colors } from "../theme/colors.slint";

export component KeyFocus inherits Rectangle {
    in property <bool> enabled: true;
    callback activate();
    width: 100%;
    height: 100%;

    keys := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    if keys.has-focus: Rectangle {
        border-width: 2px;
        border-color: Colors.focus-ring;
        border-radius: root.border-radius;
    }
}
