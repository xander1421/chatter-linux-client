// Modal component with header, close button, and content slots

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component Modal inherits Rectangle {
    in property <bool> show: false;
    in property <string> title: "";
    in property <length> modal-width: 480px;
    in property <length> max-modal-height: 600px;

    callback close();

    // Only show when visible
    opacity: root.show ? 1 : 0;
    visible: root.show;

    // Backdrop - full parent coverage
    background: Colors.overlay;

    // Backdrop touch area for click-outside dismissal
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.close();
        }
    }

    // Modal container - centered card with content-based sizing
    modal-container := Rectangle {
        accessible-role: none;
        accessible-description: root.title;
        // Responsive: cap at viewport width minus 32px padding for mobile
        width: min(root.modal-width, parent.width - 32px);
        // Size to content, capped at max-modal-height or viewport
        height: max(200px, min(modal-layout.preferred-height, min(root.max-modal-height, parent.height - 48px)));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Colors.surface;
        border-radius: Spacing.radius-lg;
        clip: true;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;

        // Block clicks on modal from closing
        TouchArea {
            width: 100%;
            height: 100%;
        }

        modal-layout := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;

            // Header row
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Title
                Text {
                    text: root.title;
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    font-weight: Typography.semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Close button — 40px touch target for mobile
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: Spacing.radius-sm;
                    background: close-area.has-hover ? Colors.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Close dialog";

                    // X icon using Unicode character
                    Text {
                        text: "\u{2715}";
                        color: Colors.text-secondary;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    close-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            // Content area
            Rectangle {
                @children
            }
        }
    }
}
