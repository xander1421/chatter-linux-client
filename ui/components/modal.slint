import { GlassSurface } from "glass_surface.slint";
// Modal shell with one glass surface and shared header controls.
// Uses ModalContainer to ensure proper sizing and centering (not full-screen)

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { ModalContainer } from "modal_container.slint";
import { DismissButton } from "dismiss_button.slint";
import { HeaderButton } from "header_button.slint";
import { Icons } from "../theme/icons.slint";

export component Modal inherits Rectangle {
    in property <bool> show: false;
    in property <string> title: "";
    in property <length> modal-width: 480px;
    in property <length> max-modal-height: 600px;
    in property <bool> fill-height: false;
    in property <bool> full-screen: false;
    // Full-screen lists extend behind the header and dock, with scroll insets.
    in property <bool> floating-content: false;
    in property <length> bottom-inset: 0px;
    // A confirm dialog with its own Cancel needs no second way out in the header.
    in property <bool> show-close: true;
    // A tab's root screen (Contacts, Calls, Profile) is where you ARE, not
    // somewhere you were pushed to, so it has nothing to pop back out of: the
    // tab bar is its navigation. Hides the leading chevron; pushed screens
    // keep it.
    in property <bool> root-screen: false;
    // A trailing ⋮ in the header for the screen's overflow actions.
    in property <bool> show-more: false;

    callback close();
    callback more-clicked();

    // The backdrop always covers the whole window, so root.height is the
    // viewport height. Safe-area insets are not plumbed down to modals, so a
    // conservative constant stands in for the Android status + navigation bars
    // (~24dp + ~48dp) so the card can never run off-screen in landscape.
    property <length> viewport-height-cap: max(240px, root.height - 96px);

    ModalContainer {
        show: root.show;
        modal-width: root.modal-width;
        max-modal-height: min(root.max-modal-height, root.viewport-height-cap);
        fill-height: root.fill-height;
        full-screen: root.full-screen;
        bottom-inset: root.floating-content ? 0px : root.bottom-inset;
        close => { root.close(); }

        modal-layout := VerticalLayout {
            padding: Spacing.lg;
            padding-bottom: Spacing.lg + (root.floating-content ? root.bottom-inset : 0px);
            spacing: Spacing.md;

            // Header row.
            //
            // THE dismissal rule, implemented once for every screen that uses
            // `Modal`. `full-screen` is what separates the two shapes, and it
            // is already the property that decides whether this is a page or a
            // card, so nothing new has to be plumbed: full-screen means the
            // user pushed into a page and pops back out of it (chevron,
            // LEADING edge, matching chat_header.slint); otherwise it is a
            // floating dialog they close (X, TRAILING edge). Exactly one of
            // the two exists at a time — never both.
            GlassSurface {
                z: 1;
                material-enabled: root.full-screen;
                border-radius: root.full-screen ? self.height / 2 : 0px;
                height: root.full-screen ? Spacing.header-action-box-touch : Spacing.header-action-box;
                HorizontalLayout {
                    spacing: Spacing.header-action-gap;
                    // The row is as tall as its one control, so title and glyph
                    // share a vertical centre at both densities.

                    if root.full-screen && !root.root-screen: DismissButton {
                        back: true;
                        clicked => { root.close(); }
                    }

                    // Title
                    Text {
                        text: root.title;
                        color: Colors.text-primary;
                        font-size: Typography.lg;
                        font-weight: Typography.semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.show-more: HeaderButton {
                        touch: root.full-screen;
                        icon: Icons.more-vertical;
                        label: "More options";
                        clicked => { root.more-clicked(); }
                    }

                    if !root.full-screen && root.show-close: DismissButton {
                        back: false;
                        clicked => { root.close(); }
                    }
                }
            }

            // Content area - wrapped in a Rectangle to allow @children
            // Vertical stretch ensures it takes available space in the card
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
