// Modal component with header, close button, and content slots — Neo 2.0 styled
// Uses ModalContainer to ensure proper sizing and centering (not full-screen)

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { ModalContainer } from "modal_container.slint";

export component Modal inherits Rectangle {
    in property <bool> show: false;
    in property <string> title: "";
    in property <length> modal-width: 480px;
    in property <length> max-modal-height: 600px;
    in property <bool> fill-height: false;

    callback close();

    // The backdrop always covers the whole window, so root.height is the
    // viewport height. Safe-area insets are not plumbed down to modals, so a
    // conservative constant stands in for the Android status + navigation bars
    // (~24dp + ~48dp) so the card can never run off-screen in landscape.
    property <length> viewport-height-cap: max(240px, root.height - 96px);

    ModalContainer {
        show: root.show;
        modal-width: root.modal-width;
        max-modal-height: min(root.max-modal-height, root.viewport-height-cap);
        fill-height: root.fill-height;
        close => { root.close(); }

        modal-layout := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;

            // Header row
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Title
                Text {
                    text: root.title;
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    font-weight: Typography.semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // Close button — 40px touch target for mobile, Neo hover
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: Spacing.radius-sm;
                    background: close-area.has-hover ? Colors.neo-inset-bg : transparent;
                    border-width: close-area.has-hover ? 1px : 0px;
                    border-color: Colors.neo-inset-shadow;
                    accessible-role: button;
                    accessible-label: "Close dialog";

                    // X icon — SVG, not a Unicode glyph (the glyph is missing
                    // from the Android font and renders as a tofu box)
                    Image {
                        source: Icons.x;
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: close-area.pressed ? Colors.text-muted :
                                  (close-area.has-hover ? Colors.text-primary : Colors.text-secondary);
                    }

                    close-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            // Content area - wrapped in a Rectangle to allow @children
            // Vertical stretch ensures it takes available space in the card
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
