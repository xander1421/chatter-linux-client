// Modal component with header, close button, and content slots

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component Modal inherits Rectangle {
    in property <bool> show: false;
    in property <string> title: "";
    in property <length> modal-width: 480px;

    callback close();

    // Only show when visible
    opacity: root.show ? 1 : 0;
    visible: root.show;

    // Backdrop - full parent coverage
    background: #00000080;

    // Backdrop touch area for click-outside dismissal
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.close();
        }
    }

    // Modal container - centered
    Rectangle {
        width: root.modal-width;
        min-height: 200px;
        max-height: parent.height * 80%;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Colors.surface;
        border-radius: Spacing.radius-lg;

        // Block clicks on modal from closing
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;

            // Header row
            HorizontalLayout {
                spacing: Spacing.md;
                height: 24px;

                // Title
                Text {
                    text: root.title;
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    font-weight: Typography.semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // Close button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-sm;
                    background: close-area.has-hover ? Colors.surface-hover : transparent;

                    // X icon using Unicode character
                    Text {
                        text: "\u{2715}";
                        color: Colors.text-secondary;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    close-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            // Content area - flexible height with @children slot
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
