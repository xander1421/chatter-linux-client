// Modal component with header, close button, and content slots — Neo 2.0 styled
// Uses ModalContainer to ensure proper sizing and centering (not full-screen)

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { ModalContainer } from "modal_container.slint";

export component Modal inherits Rectangle {
    in property <bool> show: false;
    in property <string> title: "";
    in property <length> modal-width: 480px;
    in property <length> max-modal-height: 600px;

    callback close();

    ModalContainer {
        show: root.show;
        modal-width: root.modal-width;
        max-modal-height: root.max-modal-height;
        close => { root.close(); }

        modal-layout := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;

            // Header row
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Title
                Text {
                    text: root.title;
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    font-weight: Typography.semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // Close button — 40px touch target for mobile, Neo hover
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: Spacing.radius-sm;
                    background: close-area.has-hover ? Colors.neo-inset-bg : transparent;
                    border-width: close-area.has-hover ? 1px : 0px;
                    border-color: Colors.neo-inset-shadow;
                    accessible-role: button;
                    accessible-label: "Close dialog";

                    // X icon using Unicode character
                    Text {
                        text: "\u{2715}";
                        color: Colors.text-secondary;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    close-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            // Content area - wrapped in a Rectangle to allow @children
            // Vertical stretch ensures it takes available space in the card
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
