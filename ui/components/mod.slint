// Components module - exports all reusable UI components
//
// Usage: import { Button, Input, Modal } from "components/mod.slint";

// Basic components
export { Avatar } from "avatar.slint";
export { Button } from "button.slint";
export { Input } from "input.slint";
export { Toggle } from "toggle.slint";

// Overlay components
export { Modal } from "modal.slint";
export { ModalContainer } from "modal_container.slint";
export { Toast } from "toast.slint";
export { Tooltip, TooltipArea } from "tooltip.slint";
export { Skeleton } from "skeleton.slint";

// Pickers
export { EmojiPicker, EmojiData } from "emoji_picker.slint";
export { GifPicker, GifData } from "gif_picker.slint";
export { MentionAutocomplete, MentionSuggestion } from "mention_autocomplete.slint";

// Neo 2.0 surface components
export { NeoSurface, NeoInsetSurface, NeoGlassSurface } from "neo_surface.slint";
export { NeoActionToggle } from "neo_action_toggle.slint";

// Status components
export { ConnectionBanner } from "connection_banner.slint";
// Offline / no-account surfaces. Both exist so an unreachable server is a
// stated condition with a way out, rather than a screen that stops responding.
export { OfflineMeshNotice } from "offline_mesh_notice.slint";
export { MeshOnlyBar } from "mesh_only_bar.slint";

// File/Attachment components
export { AttachmentItem } from "attachment_item.slint";
export { AttachmentTray } from "attachment_tray.slint";

// File preview components
export { CodePreviewPanel } from "code_preview_panel.slint";
export { PdfPreviewPanel } from "pdf_preview_panel.slint";
export { ImageViewer } from "image_viewer.slint";
export { VideoPlayer } from "video_player.slint";
