// Input component with focus states, placeholder, validation, and password mode

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component Input inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> password: false;
    in property <bool> disabled: false;
    in property <bool> error: false;
    in property <string> error-message: "";

    accessible-role: text-input;
    accessible-label: root.placeholder;
    accessible-enabled: !root.disabled;

    callback accepted(string);
    callback edited(string);

    // Forward focus to input
    forward-focus: input;

    // Internal state
    property <bool> focused: input.has-focus;

    // Computed border color
    property <color> border-col: {
        if error {
            Colors.error
        } else if focused {
            Colors.primary
        } else {
            Colors.text-muted
        }
    };

    background: transparent;
    height: error && error-message != "" ? 62px : 40px;

    // Main container
    VerticalLayout {
        spacing: Spacing.xs;

        // Input container
        Rectangle {
            height: 40px;
            border-radius: Spacing.radius-md;
            background: Colors.surface;
            border-width: 1px;
            border-color: border-col;
            opacity: disabled ? 0.5 : 1.0;

            // Placeholder text (shown when empty and not focused)
            if root.text == "" && !focused: Text {
                x: Spacing.md;
                width: parent.width - Spacing.md * 2;
                height: 100%;
                text: root.placeholder;
                color: Colors.text-muted;
                font-size: Typography.base;
                vertical-alignment: center;
            }

            // Actual text input (full width for reliable touch targeting)
            input := TextInput {
                x: Spacing.md;
                width: parent.width - Spacing.md * 2;
                height: parent.height;
                color: Colors.text-primary;
                font-size: Typography.base;
                text <=> root.text;
                input-type: root.password ? InputType.password : InputType.text;
                enabled: !root.disabled;
                vertical-alignment: center;

                accepted => {
                    root.accepted(self.text);
                }
                edited => {
                    root.edited(self.text);
                }
            }

            // Full-area touch target to ensure tapping anywhere focuses the input
            TouchArea {
                enabled: !root.disabled;
                clicked => { input.focus(); }
            }
        }

        // Error message
        if error && error-message != "": Text {
            text: root.error-message;
            color: Colors.error;
            font-size: Typography.xs;
        }
    }
}
