// Semantic colors for Chatter. Chrome materials are defined in materials.slint.

import { Appearance } from "appearance.slint";

// Every token has a dark value (left) and a light value (right). Dark is a
// blue-slate ink (#080d13), not pure black: elevation reads as lighter steps of
// one hue. Contrast ratios for every pair are in the 2026-10-04 colour pass
// (~/.cache/chatter-colors/contrast.py); keep body text >= 4.5:1.
// `Appearance.dark` picks; nothing outside this file should need a
// literal colour.
export global Colors {
    // Filled actions have a stable readable foreground in both themes.
    out property <color> action-fill: Appearance.dark ? #117d73 : #0f766e;
    out property <color> action-hover: #076b63;
    out property <color> action-active: #065a54;
    out property <color> on-action: #ffffff;

    // Primary teal. Light uses teal-700 so primary-coloured text passes AA on
    // white (#0d9488 was 3.7:1).
    out property <color> primary: Appearance.dark ? #0d9488 : #0f766e;
    // Includes the selected tab's translucent fill in the contrast budget.
    out property <color> glass-accent: Appearance.dark ? #64ddcc : #07645c;
    out property <color> primary-hover: Appearance.dark ? #0f766e : #115e59;

    // Accent color (orange - complements teal)
    out property <color> accent: Appearance.dark ? #f97316 : #ea580c;

    // Neutral elevation: page < surface (cards) < surface-hover < fill-secondary.
    out property <color> background: Appearance.dark ? #080d13 : #edf1f5;
    out property <color> surface: Appearance.dark ? #141e29 : #ffffff;
    out property <color> surface-hover: Appearance.dark ? #1c2734 : #e6ecf2;
    // Secondary-button fill. Its own step, not `surface`: a secondary button
    // sits on the page AND on cards (which are `surface`), and with no stroke
    // a surface-filled button on a card was a bare label (RC24 D2).
    out property <color> fill-secondary: Appearance.dark ? #263444 : #dfe6ed;
    out property <color> fill-secondary-hover: Appearance.dark ? #304050 : #d3dce6;
    // Off-state track of a switch: >= 3:1 against a card, so "off" is visible.
    out property <color> control-off: Appearance.dark ? #5f7085 : #8795a5;

    // Text: muted is >= 4.5:1 on page, card, hovered row and both bubbles.
    out property <color> text-primary: Appearance.dark ? #eef3f8 : #101a25;
    out property <color> text-secondary: Appearance.dark ? #b6c4d2 : #3e4d5f;
    out property <color> text-muted: Appearance.dark ? #97a8ba : #556677;

    // Status colors are both text and fills (end-call, badges), so dark stays
    // near the 500 step: error is >= 4.6:1 on a card AND holds a white glyph
    // at 3.6:1. Light success moves to 700 for text on white (was 3.8:1).
    out property <color> success: Appearance.dark ? #10b981 : #047857;
    out property <color> warning: Appearance.dark ? #f59e0b : #b45309;
    out property <color> error: Appearance.dark ? #ef4b4b : #dc2626;
    out property <color> info: Appearance.dark ? #3b82f6 : #2563eb;
    // Solid status fills that carry an icon (accept-call). Bright 500 step in
    // both themes with a dark ink glyph, as iOS does: a white glyph on #10b981
    // was 2.5:1, on #f59e0b 2.2:1 (WCAG 1.4.11 needs 3:1). Ink on fill:
    // success 5.84:1 (hover 7.71:1), warning 7.17:1. `success`/`warning`
    // above stay the text tokens.
    out property <color> success-fill: #10b981;
    out property <color> success-fill-hover: #34d399;
    out property <color> on-success: #052e1f;
    out property <color> warning-fill: #f59e0b;
    out property <color> on-warning: #3b1d04;
    // Glyph/label on an `error` fill (decline, end-call badges): white is
    // 3.63:1 on dark #ef4b4b, 4.83:1 on #dc2626, 6.47:1 on #b91c1c. The dark
    // ink text-primary failed light hover (2.71:1).
    out property <color> on-error: #ffffff;
    out property <color> accent-purple: Appearance.dark ? #8b5cf6 : #7c3aed;

    // Presence colors
    // Presence dots are non-text (WCAG 1.4.11 wants 3:1 on what they sit
    // on). Light offline #9ca3af was 2.2:1 on the page; #748393 is 3.4:1 on
    // the page and 3.9:1 on white, and still a step lighter than text-muted.
    // Light away #d97706 was 2.8:1; the warning step is 3.9:1.
    out property <color> online: Appearance.dark ? #10b981 : #059669;
    out property <color> away: Appearance.dark ? #f59e0b : #b45309;
    out property <color> dnd: Appearance.dark ? #ef4444 : #dc2626;
    out property <color> offline: Appearance.dark ? #6b7280 : #748393;

    // Borders and dividers
    out property <color> border: Appearance.dark ? #243242 : #d2dae3;

    // Overlays and tooltips. Content drawn ON an overlay (play buttons, call
    // chips) uses text-primary, so the light overlays are light too.
    out property <color> overlay: Appearance.dark ? #04080c80 : #ffffffa6;
    out property <color> overlay-heavy: Appearance.dark ? #04080ccc : #ffffffd9;

    // Hover variants for status colors
    out property <color> error-hover: Appearance.dark ? #dc2626 : #b91c1c;

    // Code block styling
    out property <color> code-bg: Appearance.dark ? #0b1118 : #e9edf2;
    out property <color> code-text: Appearance.dark ? #d4d4d4 : #1f2328;

    // Group accent (purple for private groups)
    out property <color> group-accent: Appearance.dark ? #9333ea : #7e22ce;

    // Message bubbles — one matched pair on elevation level 2
    // (theme/elevation.slint): same radii, rim, shadow and text treatment;
    // only the tint differs. Peer is the neutral slate one step above the
    // page; own is the brand teal pulled toward the slate hue (OKLCH h 212,
    // C ~0.045 dark / ~0.024 light) and a little lighter than peer, so it
    // reads as "you" without a second accent colour. Both fills are a 2-3%
    // lightness fall from top to bottom (light from above). Contrast for
    // body, timestamp and tick on the bottom (worst) stop is in
    // ~/.cache/chatter-colors-2/contrast.py.
    out property <brush> bubble-own: Appearance.dark
        ? @linear-gradient(180deg, #133c43 0%, #11353b 100%)
        : @linear-gradient(180deg, #dff3f8 0%, #d6eef3 100%);
    out property <brush> bubble-other: Appearance.dark
        ? @linear-gradient(180deg, #202832 0%, #1c242e 100%)
        : @linear-gradient(180deg, #ffffff 0%, #fbfcfd 100%);
    out property <brush> bubble-own-hover: Appearance.dark
        ? @linear-gradient(180deg, #174149 0%, #143a41 100%)
        : @linear-gradient(180deg, #d8eef3 0%, #d0e9ef 100%);
    out property <brush> bubble-other-hover: Appearance.dark
        ? @linear-gradient(180deg, #252d37 0%, #212933 100%)
        : @linear-gradient(180deg, #f6f8fb 0%, #f2f5f9 100%);
    // Solid stand-ins for things drawn ON or BESIDE a bubble that must match
    // it (reaction chips, the hover toolbar, call rows' icon well).
    out property <color> surface-raised: Appearance.dark ? #232c36 : #ffffff;
    // A well inside either bubble (quote, code, file/media placeholder):
    // the same darkening on own and peer, so insets match across the pair.
    out property <color> bubble-inset: Appearance.dark ? #0000003d : #1a2c3e0a;
    // Read receipts / play glyphs inside a bubble: >= 3:1 on both fills.
    out property <color> bubble-accent: Appearance.dark ? #64ddcc : #0f766e;
    // A sender's name on a peer bubble (14px text, so 4.5:1): dark primary
    // #0d9488 was 4.0:1 on the bubble top; the glass accent is 9:1. Light
    // primary already passes (5.3:1).
    out property <color> sender-name: Appearance.dark ? #64ddcc : #0f766e;

    // File category colors
    out property <color> cat-image: Appearance.dark ? #4ade80 : #16a34a;
    out property <color> cat-video: Appearance.dark ? #f472b6 : #db2777;
    out property <color> cat-audio: Appearance.dark ? #a78bfa : #7c3aed;
    out property <color> cat-document: Appearance.dark ? #60a5fa : #2563eb;
    out property <color> cat-code: Appearance.dark ? #fbbf24 : #b45309;
    out property <color> cat-archive: Appearance.dark ? #fb923c : #c2410c;

    // A well pressed into whatever it sits on: text fields, QR plates,
    // selected list rows and options (one step BELOW the page).
    out property <color> inset: Appearance.dark ? #060a0f : #e6ebf0;
    // THE selected-row fill, and the two tints for a selected or active
    // control drawn on chrome (tabs, categories, swatches): one weak step and
    // one strong step of the brand colour, instead of per-file alphas. Light
    // `selected` is a shade below `inset` so a selected row is not the same
    // colour as a hovered one (hover #e6ecf2 ≈ inset #e6ebf0); text-muted
    // stays 4.6:1 on it.
    out property <color> selected: Appearance.dark ? #060a0f : #dde4ec;
    out property <color> tint-weak: primary.with-alpha(0.10);
    out property <color> tint-strong: primary.with-alpha(0.20);
    // Text drawn straight on Materials.scrim-media (a media viewer's
    // backdrop, dark in both themes).
    out property <color> on-media: #eef3f8;
    out property <color> on-media-muted: #b6c4d2;
    // Every 1px rule between rows, sections and header groups.
    out property <color> divider: Appearance.dark ? #97a8ba2b : #5566772b;
}
