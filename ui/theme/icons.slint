// Icon definitions for Chatter
// SVG-based icon system with colorize support for theming
// All icons are Lucide-style: 24x24, stroke-width 2, rounded caps

export global Icons {
    // Communication
    out property <image> phone: @image-url("../icons/phone.svg");
    out property <image> phone-off: @image-url("../icons/phone-off.svg");
    out property <image> video: @image-url("../icons/video.svg");
    out property <image> video-off: @image-url("../icons/video-off.svg");
    out property <image> mic: @image-url("../icons/mic.svg");
    out property <image> mic-off: @image-url("../icons/mic-off.svg");
    out property <image> monitor: @image-url("../icons/monitor.svg");

    // Actions
    out property <image> check: @image-url("../icons/check.svg");
    out property <image> search: @image-url("../icons/search.svg");
    out property <image> settings: @image-url("../icons/settings.svg");
    out property <image> send: @image-url("../icons/send.svg");
    out property <image> edit: @image-url("../icons/edit.svg");
    out property <image> trash: @image-url("../icons/trash.svg");
    out property <image> copy: @image-url("../icons/copy.svg");
    out property <image> download: @image-url("../icons/download.svg");
    out property <image> reply: @image-url("../icons/reply.svg");
    out property <image> pin: @image-url("../icons/pin.svg");

    // Navigation
    out property <image> chevron-left: @image-url("../icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("../icons/chevron-right.svg");
    out property <image> menu: @image-url("../icons/menu.svg");
    out property <image> x: @image-url("../icons/x.svg");
    out property <image> plus: @image-url("../icons/plus.svg");
    out property <image> more-horizontal: @image-url("../icons/more-horizontal.svg");

    // Media controls
    out property <image> play: @image-url("../icons/play.svg");
    out property <image> pause: @image-url("../icons/pause.svg");

    // Content
    out property <image> hash: @image-url("../icons/hash.svg");
    out property <image> star: @image-url("../icons/star.svg");
    out property <image> bookmark: @image-url("../icons/bookmark.svg");
    out property <image> image: @image-url("../icons/image.svg");
    out property <image> file: @image-url("../icons/file.svg");
    out property <image> paperclip: @image-url("../icons/paperclip.svg");
    out property <image> smile: @image-url("../icons/smile.svg");

    // Security & Social
    out property <image> lock: @image-url("../icons/lock.svg");
    out property <image> unlock: @image-url("../icons/unlock.svg");
    out property <image> shield: @image-url("../icons/shield.svg");
    out property <image> users: @image-url("../icons/users.svg");
    out property <image> user-plus: @image-url("../icons/user-plus.svg");
    out property <image> globe: @image-url("../icons/globe.svg");

    // Channel templates
    out property <image> message-circle: @image-url("../icons/message-circle.svg");
    out property <image> folder: @image-url("../icons/folder.svg");
    out property <image> megaphone: @image-url("../icons/megaphone.svg");
    out property <image> clock: @image-url("../icons/clock.svg");
    out property <image> sparkles: @image-url("../icons/sparkles.svg");
    out property <image> link: @image-url("../icons/link.svg");

    // AI Assistant
    out property <image> jarvis: @image-url("../icons/jarvis.svg");
}
