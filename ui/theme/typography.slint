// Typography definitions for Chatter — Neomorphism 2.0
// Inter variable font for crisp, accessible text on soft surfaces

// Bundle Inter so rendering stays consistent regardless of system fonts.
// Upright weights:
import "../../assets/fonts/Inter-Light.ttf";
import "../../assets/fonts/Inter-Regular.ttf";
import "../../assets/fonts/Inter-Medium.ttf";
import "../../assets/fonts/Inter-SemiBold.ttf";
import "../../assets/fonts/Inter-Bold.ttf";
// Italic faces (real, not synthetic):
import "../../assets/fonts/Inter-LightItalic.ttf";
import "../../assets/fonts/Inter-Italic.ttf";
import "../../assets/fonts/Inter-MediumItalic.ttf";
import "../../assets/fonts/Inter-SemiBoldItalic.ttf";
import "../../assets/fonts/Inter-BoldItalic.ttf";

export global Typography {
    // Inter everywhere; glyphs Inter lacks (CJK, emoji) fall back to the
    // system fonts on their own. ONE family name, not a CSS list: Slint 1.17
    // passes the string to parley as a single named family
    // (sharedparley.rs FontFamilyName::named), so "Inter, sans-serif" matched
    // nothing and the whole app rendered in the platform fallback — whose
    // Samsung set has no U+25CF, so every password mask was tofu.
    out property <string> font-family: "Inter";

    // Monospace alias points at Inter too — keep one family across the app.
    // Inline code / code blocks lose fixed-width alignment by design.
    out property <string> font-family-mono: "Inter";

    // Emoji-only Text elements pin this so color glyphs win. Without it,
    // fontconfig fallback can pick a monochrome symbol font (e.g. Font Awesome
    // covers U+1F600+) and emoji render as white outlines.
    out property <string> font-family-emoji: "Noto Color Emoji";

    // Font sizes.
    //
    // Eight rendered steps — 12 / 14 / 16 / 18 / 20 / 24 / 32 / 48 — behind
    // eleven names. The names all survive because they are spread over ~700
    // call sites and renaming them would be a diff nobody could review; what
    // changed is what they resolve to.
    //
    // Two things were wrong with the old scale:
    //
    //   1. It bottomed out at 10px. That is below every mainstream floor
    //      (Material's smallest label is 11sp) and it was used in 28 places —
    //      timestamps, badges, the bottom-nav labels, the mesh peer list — i.e.
    //      exactly the text a phone user reads at arm's length in bad light.
    //   2. Four of the eleven steps (10/11/12/13) sat inside a 3px band. At
    //      arm's length those are not four levels, they are one level rendered
    //      four slightly different ways, which is why the hierarchy read flat:
    //      there was no step big enough to be perceived as a step.
    //
    // So the bottom of the scale collapses onto 12 and the 13 collapses onto
    // 14. Small text now separates from body text by a real 2px, and hierarchy
    // below `base` is carried by weight and colour — which is the right lever
    // at these sizes anyway, and which the components already vary.
    out property <length> xxs: 12px;
    out property <length> xs2: 12px;
    out property <length> xs: 12px;
    out property <length> sm2: 14px;
    out property <length> sm: 14px;
    out property <length> base: 16px;
    out property <length> lg: 18px;
    out property <length> xl: 20px;
    out property <length> xxl: 24px;
    out property <length> xxxl: 32px;
    // Illustration tier — empty-state hero glyphs, not body text.
    out property <length> huge: 48px;

    // Font weights (as integers for Slint)
    out property <int> light: 300;
    out property <int> normal: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
