// Typography definitions for Chatter

// Bundle Inter font so rendering is consistent regardless of system fonts
import "../../assets/fonts/Inter-Regular.ttf";
import "../../assets/fonts/Inter-Medium.ttf";
import "../../assets/fonts/Inter-SemiBold.ttf";
import "../../assets/fonts/Inter-Bold.ttf";

export global Typography {
    // Font family — Inter is bundled, Noto Sans / sans-serif as system fallbacks
    out property <string> font-family: "Inter";

    // Font sizes
    out property <length> xs: 12px;
    out property <length> sm: 14px;
    out property <length> base: 16px;
    out property <length> lg: 18px;
    out property <length> xl: 20px;
    out property <length> xxl: 24px;
    out property <length> xxxl: 32px;

    // Font weights (as integers for Slint)
    out property <int> normal: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
