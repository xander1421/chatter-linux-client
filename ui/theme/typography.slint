// Typography definitions for Chatter — Neomorphism 2.0
// Inter variable font for crisp, accessible text on soft surfaces

// Bundle Inter so rendering stays consistent regardless of system fonts.
// Upright weights:
import "../../assets/fonts/Inter-Light.ttf";
import "../../assets/fonts/Inter-Regular.ttf";
import "../../assets/fonts/Inter-Medium.ttf";
import "../../assets/fonts/Inter-SemiBold.ttf";
import "../../assets/fonts/Inter-Bold.ttf";
// Italic faces (real, not synthetic):
import "../../assets/fonts/Inter-LightItalic.ttf";
import "../../assets/fonts/Inter-Italic.ttf";
import "../../assets/fonts/Inter-MediumItalic.ttf";
import "../../assets/fonts/Inter-SemiBoldItalic.ttf";
import "../../assets/fonts/Inter-BoldItalic.ttf";

export global Typography {
    // Inter everywhere. Sans-serif fallback only kicks in for glyphs Inter lacks
    // (CJK, exotic emoji) — the system picks a substitute then.
    out property <string> font-family: "Inter, sans-serif";

    // Monospace alias points at Inter too — keep one family across the app.
    // Inline code / code blocks lose fixed-width alignment by design.
    out property <string> font-family-mono: "Inter, sans-serif";

    // Emoji-only Text elements pin this so color glyphs win. Without it,
    // fontconfig fallback can pick a monochrome symbol font (e.g. Font Awesome
    // covers U+1F600+) and emoji render as white outlines.
    out property <string> font-family-emoji: "Noto Color Emoji";

    // Font sizes
    out property <length> xxs: 10px;
    out property <length> xs2: 11px;
    out property <length> xs: 12px;
    out property <length> sm2: 13px;
    out property <length> sm: 14px;
    out property <length> base: 16px;
    out property <length> lg: 18px;
    out property <length> xl: 20px;
    out property <length> xxl: 24px;
    out property <length> xxxl: 32px;
    // Illustration tier — empty-state hero glyphs, not body text.
    out property <length> huge: 48px;

    // Font weights (as integers for Slint)
    out property <int> light: 300;
    out property <int> normal: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
