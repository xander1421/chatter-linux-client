// Spacing and sizing tokens for Chatter — Neomorphism 2.0

export global Spacing {
    // Base spacing
    out property <length> xxs: 2px;
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;
    out property <length> xxl: 32px;
    out property <length> xxxl: 48px;

    // Border radius — Neo 2.0 uses generous radii (superellipse-approximate)
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 20px;            // Neo bubble radius (18-24px range)
    out property <length> radius-full: 9999px;

    // Component sizes
    out property <length> avatar-sm: 32px;
    out property <length> avatar-md: 40px;
    out property <length> avatar-lg: 56px;
    out property <length> sidebar-width: 240px;
    out property <length> sidebar-width-collapsed: 60px;
    // Touch icon rail: a 44px slot with 12px gutters either side. The 60px
    // desktop rail leaves a 44px slot only 8px of breathing room, which reads
    // as cramped at phone density.
    out property <length> sidebar-width-collapsed-touch: 68px;
    out property <length> sidebar-width-hidden: 0px;
    out property <length> thread-panel-width: 360px;

    // Mobile-specific
    out property <length> touch-target-min: 48px;
    out property <length> bottom-nav-height: 56px;

    // Neo 2.0 shadow offsets — 145° light angle
    out property <length> neo-offset-sm: 3px;          // Small elements (toggles, chips)
    out property <length> neo-offset-md: 5px;          // Buttons, inputs
    out property <length> neo-offset-lg: 8px;          // Cards, modals, bubbles
    out property <length> neo-blur-sm: 6px;            // Subtle depth
    out property <length> neo-blur-md: 10px;           // Standard depth
    out property <length> neo-blur-lg: 16px;           // Deep depth (modals, popups)
}
