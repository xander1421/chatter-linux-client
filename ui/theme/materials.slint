// Chrome material tokens. Only GlassSurface owns backdrop sampling.
// Visual guidance adapted from Unslop by Damir Sokolovsky, CC BY 4.0:
// https://github.com/heydamir/unslop
import { Appearance } from "appearance.slint";

export global Materials {
    // Blur separates foreground labels from the scene while the low-alpha
    // tints let colour and motion remain visible through chrome.
    out property <color> ultra-thin: Appearance.glass-effects
        ? (Appearance.dark ? #23292a1c : #ffffff24)
        : (Appearance.dark ? #202627 : #fafbfb);
    out property <color> thin: Appearance.glass-effects
        ? (Appearance.dark ? #23292a52 : #ffffff61)
        : (Appearance.dark ? #202627 : #fafbfb);
    out property <color> regular: Appearance.glass-effects
        ? (Appearance.dark ? #23292a66 : #ffffff75)
        : (Appearance.dark ? #202627 : #fafbfb);
    // Chat header and composer float over the conversation: regular glass
    // at 70% of its tint alpha (owner 2026-10-24). Flat mode stays opaque.
    out property <color> chat-chrome: Appearance.glass-effects
        ? regular.transparentize(0.3) : regular;
    // Matching 30% cut of the backdrop darkening under that chrome.
    out property <float> chat-darkening: 0.7;
    // Search gains contrast as its glass travels above the results.
    out property <color> search-raised: Appearance.glass-effects
        ? (Appearance.dark ? #292f30bd : #ffffffe0)
        : (Appearance.dark ? #292f30 : #ffffff);
    // Sheets sample the dimmed backdrop and need a little more tint than
    // regular chrome to separate their controls from the scrim.
    out property <color> thick: Appearance.glass-effects
        ? (Appearance.dark ? #292f3070 : #ffffff80)
        : (Appearance.dark ? #292f30 : #ffffff);
    // Chat headers float over message text; the heavier blur obscures glyphs
    // while this tint still shows the scene's colour and motion.
    out property <color> header-chrome: Appearance.glass-effects
        ? (Appearance.dark ? #292f3094 : #ffffff94)
        : (Appearance.dark ? #292f30 : #ffffff);
    out property <color> opaque: Appearance.dark ? #202627 : #fafbfb;
    // A dark optical base bounds the white FAB glyph against either backdrop.
    out property <color> fab-base: #0a383900;
    // A light page shows through a faint tint, leaving the white glyph on
    // near-white: light mode needs the accent close to solid.
    out property <color> fab-accent: Appearance.dark ? #0f766e55 : #0f766ed9;
    // The single optical edge is local to GlassSurface, never a row/card stroke.
    // Dark: a lit top-left arc that fades out. Light: white chrome on a light
    // page needs a faint cool-ink lower rim to keep its silhouette.
    out property <brush> glass-edge: Appearance.dark
        ? @linear-gradient(160deg, #ffffff26 0%, #ffffff10 22%, #ffffff00 50%, #ffffff00 74%, #ffffff0c 100%)
        : @linear-gradient(160deg, #ffffff80 0%, #ffffff30 24%, #ffffff00 48%, #1820200c 76%, #18202018 100%);
    out property <physical-length> glass-edge-width: 1phx;
    // Physical pixels keep the rim one device pixel even at 2x/3x scale.
    out property <brush> specular: Appearance.dark
        ? @linear-gradient(170deg, #ffffff08 0%, #ffffff04 30%, #ffffff00 55%, #ffffff00 100%)
        : @linear-gradient(170deg, #ffffff18 0%, #ffffff00 45%, #ffffff00 100%);
    // A soft internal falloff, not another stroke around the silhouette.
    out property <brush> inner-shade: Appearance.dark
        ? @linear-gradient(180deg, #00000000 0%, #00000000 78%, #00000014 100%)
        : @linear-gradient(180deg, #00000000 0%, #00000000 82%, #1820200a 100%);
    out property <color> scrim: Appearance.dark ? #02050999 : #08111c40;
    // Media viewers sit on a dark backdrop in both themes, as every photo
    // viewer does; their text uses Colors.on-media. Light `Colors.overlay`
    // washed the whole app white behind an image.
    out property <color> scrim-media: Appearance.dark ? #02050ae6 : #0b1420e0;
    out property <color> hover: Appearance.dark ? #ffffff0c : #15202b0a;
    out property <color> pressed: Appearance.dark ? #ffffff18 : #15202b14;
    // A small tone shift in one neutral ramp keeps chrome quiet in both themes.
    out property <brush> ambient: Appearance.dark
        ? @linear-gradient(180deg, #181d1e 0%, #101314 100%)
        : @linear-gradient(180deg, #f8f9f9 0%, #f4f5f5 100%);
    out property <length> blur-regular: 34px;
    out property <length> blur-thick: 38px;
    out property <length> blur-header: 42px;
    out property <float> saturation: 1.0;
    // Bound bright content behind dark chrome so light labels retain contrast.
    out property <float> chrome-brightness: Appearance.dark ? -0.20 : 0.0;
    // Edge lensing strength for the Backdrop refraction shader (0..1).
    out property <float> refraction: 0.04;
    out property <duration> feedback-duration: Appearance.reduce-motion ? 0ms : 100ms / Appearance.animation-speed;
    out property <duration> menu-duration: Appearance.reduce-motion ? 0ms : 180ms / Appearance.animation-speed;
    out property <duration> sheet-duration: Appearance.reduce-motion ? 0ms : 240ms / Appearance.animation-speed;
    // Shared ease-out, without overshoot. Preserve aliases for existing callers.
    out property <easing> settle: cubic-bezier(0.22, 1, 0.36, 1);
    out property <easing> spring: settle;
    out property <easing> glide: settle;
    out property <duration> motion-quick: Appearance.reduce-motion ? 0ms : 160ms / Appearance.animation-speed;
    out property <duration> motion-standard: Appearance.reduce-motion ? 0ms : 320ms / Appearance.animation-speed;
    out property <duration> motion-emphasized: Appearance.reduce-motion ? 0ms : 480ms / Appearance.animation-speed;
}
