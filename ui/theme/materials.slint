// Chrome material tokens. Only GlassSurface owns backdrop sampling.
import { Appearance } from "appearance.slint";

export global Materials {
    // Blur separates foreground labels from the scene while the low-alpha
    // tints let colour and motion remain visible through chrome.
    out property <color> ultra-thin: Appearance.glass-effects
        ? (Appearance.dark ? #1a26351c : #ffffff24)
        : (Appearance.dark ? #18232f : #fbfdff);
    out property <color> thin: Appearance.glass-effects
        ? (Appearance.dark ? #1a263552 : #ffffff61)
        : (Appearance.dark ? #18232f : #fbfdff);
    out property <color> regular: Appearance.glass-effects
        ? (Appearance.dark ? #1a263566 : #ffffff75)
        : (Appearance.dark ? #18232f : #fbfdff);
    // Search gains contrast as its glass travels above the results.
    out property <color> search-raised: Appearance.glass-effects
        ? (Appearance.dark ? #1c2837bd : #ffffffe0)
        : (Appearance.dark ? #1f2b39 : #ffffff);
    // Sheets sample the dimmed backdrop and need a little more tint than
    // regular chrome to separate their controls from the scrim.
    out property <color> thick: Appearance.glass-effects
        ? (Appearance.dark ? #1c283770 : #ffffff80)
        : (Appearance.dark ? #1f2b39 : #ffffff);
    // Chat headers float over message text; the heavier blur obscures glyphs
    // while this tint still shows the scene's colour and motion.
    out property <color> header-chrome: Appearance.glass-effects
        ? (Appearance.dark ? #1c283794 : #ffffff94)
        : (Appearance.dark ? #1f2b39 : #ffffff);
    out property <color> opaque: Appearance.dark ? #18232f : #fbfdff;
    // A dark optical base bounds the white FAB glyph against either backdrop.
    out property <color> fab-base: #0a383980;
    out property <color> fab-accent: #0f766e61;
    // The single optical edge is local to GlassSurface, never a row/card stroke.
    // Dark: a lit top-left arc that fades out. Light: white chrome on a light
    // page needs a faint cool-ink lower rim to keep its silhouette.
    out property <brush> glass-edge: Appearance.dark
        ? @linear-gradient(160deg, #ffffff66 0%, #ffffff24 22%, #ffffff00 50%, #ffffff00 74%, #ffffff1a 100%)
        : @linear-gradient(160deg, #fffffff0 0%, #ffffff78 24%, #ffffff00 48%, #1a2c3e18 76%, #1a2c3e30 100%);
    out property <physical-length> glass-edge-width: 1phx;
    // Physical pixels keep the rim one device pixel even at 2x/3x scale.
    out property <brush> specular: Appearance.dark
        ? @linear-gradient(170deg, #ffffff0e 0%, #ffffff04 30%, #ffffff00 55%, #ffffff00 100%)
        : @linear-gradient(170deg, #ffffff30 0%, #ffffff00 45%, #ffffff00 100%);
    // A soft internal falloff, not another stroke around the silhouette.
    out property <brush> inner-shade: Appearance.dark
        ? @linear-gradient(180deg, #00000000 0%, #00000000 78%, #0000002b 100%)
        : @linear-gradient(180deg, #00000000 0%, #00000000 82%, #1a2c3e12 100%);
    out property <color> scrim: Appearance.dark ? #02050999 : #08111c40;
    // Media viewers sit on a dark backdrop in both themes, as every photo
    // viewer does; their text uses Colors.on-media. Light `Colors.overlay`
    // washed the whole app white behind an image.
    out property <color> scrim-media: Appearance.dark ? #02050ae6 : #0b1420e0;
    out property <color> hover: Appearance.dark ? #ffffff0c : #15202b0a;
    out property <color> pressed: Appearance.dark ? #ffffff18 : #15202b14;
    // The page behind every screen: a faint teal wash at the top fading into
    // the neutral page colour (Colors.background), cool violet at the foot.
    out property <brush> ambient: Appearance.dark
        ? @linear-gradient(165deg, #10252b 0%, #0a151c 28%, #080d13 58%, #0b0e19 100%)
        : @linear-gradient(165deg, #e2f1f0 0%, #eaf0f4 32%, #edf1f5 62%, #efeff7 100%);
    out property <length> blur-regular: 34px;
    out property <length> blur-thick: 38px;
    out property <length> blur-header: 42px;
    out property <float> saturation: 1.7;
    // Bound bright content behind dark chrome so light labels retain contrast.
    out property <float> chrome-brightness: Appearance.dark ? -0.20 : 0.0;
    // Edge lensing strength for the Backdrop refraction shader (0..1).
    out property <float> refraction: 0.10;
    out property <duration> feedback-duration: Appearance.reduce-motion ? 0ms : 100ms;
    out property <duration> menu-duration: Appearance.reduce-motion ? 0ms : 180ms;
    out property <duration> sheet-duration: Appearance.reduce-motion ? 0ms : 240ms;
    out property <easing> settle: cubic-bezier(0.22, 1.12, 0.36, 1);
    // Shared fluid-motion vocabulary (iOS-style springs). Areas use these
    // instead of local curves so the whole app moves with one feel.
    // `spring`: visible overshoot for things that arrive (bubbles, droplets, pops).
    // `glide`: fast start, long soft landing for things that travel (pages, sheets).
    out property <easing> spring: cubic-bezier(0.34, 1.45, 0.64, 1);
    out property <easing> glide: cubic-bezier(0.2, 0.0, 0.0, 1);
    out property <duration> motion-quick: Appearance.reduce-motion ? 0ms : 160ms;
    out property <duration> motion-standard: Appearance.reduce-motion ? 0ms : 320ms;
    out property <duration> motion-emphasized: Appearance.reduce-motion ? 0ms : 480ms;
}
