import { MessageInfo, MessageInfoModal } from "modals/message_info.slint";
import { ChatLayout, MessageItemData } from "chat/chat_layout.slint";
import { MeshGlobal } from "mesh/mesh_global.slint";
import { ConversationKind } from "chat/conversation_kind.slint";
import { ReactionPicker } from "chat/reaction_picker.slint";
import { MessageContextMenu, MessageMenuActions } from "chat/message_context_menu.slint";
import { SelectionChrome } from "chat/selection_bar.slint";
import { DeleteConfirm } from "chat/delete_confirm.slint";
import { EmojiData } from "components/emoji_picker.slint";
import { MentionAutocomplete, MentionSuggestion } from "components/mention_autocomplete.slint";
import { ImageViewer, EmojiData } from "components/mod.slint";
import { CodePreviewOverlay, PdfPreviewOverlay } from "components/file_previews.slint";
import { VideoPlayer } from "components/mod.slint";
import { IncomingCallModal, DevicePicker, IncomingCallData, AudioDeviceData, ScreenSourceData } from "calls/mod.slint";

// Call, media and message-action surfaces above the modal stack.
export component AppTopOverlays inherits Rectangle {
    in property <string> active-modal;
    in property <[AudioDeviceData]> audio-devices;
    in property <string> audio-elapsed;
    in property <[AudioDeviceData]> audio-output-devices;
    in property <float> audio-progress;
    in property <string> code-preview-filename;
    in property <string> code-preview-language;
    in property <int> code-preview-line-count;
    in property <string> code-preview-plain-text;
    in-out property <bool> code-preview-visible;
    in property <length> context-menu-anchor-bottom;
    in property <length> context-menu-anchor-left;
    in property <length> context-menu-anchor-right;
    in property <length> context-menu-anchor-top;
    in property <length> context-menu-content-top;
    in property <string> context-menu-message-id;
    in property <bool> context-menu-preview-from-thread;
    in property <MessageItemData> context-menu-preview-message;
    in property <bool> context-menu-preview-mobile;
    in property <length> context-menu-preview-row-width;
    in property <length> context-menu-preview-row-x;
    in property <length> context-menu-preview-row-y;
    in property <string> context-menu-sender-id;
    in property <string> context-menu-timestamp-ns;
    in-out property <bool> context-menu-visible;
    in property <length> context-menu-x;
    in property <length> context-menu-y;
    in property <ConversationKind> conversation-kind;
    in property <string> current-playing-attachment-id;
    in-out property <bool> delete-choice-everyone;
    in-out property <bool> delete-choice-me;
    in-out property <bool> delete-choosing;
    in-out property <int> delete-confirm-count;
    in-out property <bool> delete-confirm-everyone;
    in-out property <string> delete-confirm-sender;
    in-out property <string> delete-confirm-timestamp;
    in property <bool> device-picker-presented;
    in property <string> device-picker-type;
    in-out property <bool> device-picker-visible;
    in property <string> exiting-modal;
    in property <string> image-viewer-filename;
    in property <string> image-viewer-size;
    in property <image> image-viewer-source;
    in-out property <bool> image-viewer-visible;
    in property <IncomingCallData> incoming-call-data;
    in property <bool> incoming-call-replaces-active;
    in property <bool> incoming-presented;
    in property <bool> incoming-shown;
    in property <bool> is-dm;
    in property <bool> is-media-playing;
    in property <bool> is-mobile-platform;
    in property <bool> media-viewer-has-next;
    in property <bool> media-viewer-has-previous;
    in property <image> media-viewer-next-thumbnail;
    in property <string> media-viewer-position;
    in property <image> media-viewer-previous-thumbnail;
    in-out property <bool> mention-autocomplete-visible;
    in property <int> mention-selected-index;
    in property <[MentionSuggestion]> mention-suggestions;
    in property <int> pdf-preview-current-page;
    in property <string> pdf-preview-error;
    in property <bool> pdf-preview-external-only;
    in property <string> pdf-preview-filename;
    in property <image> pdf-preview-image;
    in property <int> pdf-preview-page-count;
    in-out property <bool> pdf-preview-visible;
    in property <string> presented-modal;
    in-out property <length> reaction-picker-anchor-x;
    in-out property <length> reaction-picker-anchor-y;
    in property <[EmojiData]> reaction-picker-emojis;
    in-out property <string> reaction-picker-message-id;
    in-out property <string> reaction-picker-search-query;
    in-out property <int> reaction-picker-selected-category;
    in-out property <string> reaction-picker-sender-id;
    in-out property <string> reaction-picker-timestamp-ns;
    in-out property <bool> reaction-picker-visible;
    in-out property <int> reply-focus-serial;
    in property <length> safe-area-top;
    in property <[ScreenSourceData]> screen-sources;
    in-out property <string> selected-audio-device-id;
    in-out property <string> selected-audio-output-id;
    in-out property <string> selected-screen-source-id;
    in-out property <bool> selection-mode;
    in property <bool> sidebar-collapsed;
    in property <bool> sidebar-hidden;
    in property <string> video-player-duration;
    in property <string> video-player-elapsed;
    in property <string> video-player-filename;
    in property <image> video-player-frame;
    in property <bool> video-player-is-playing;
    in property <float> video-player-progress;
    in-out property <bool> video-player-visible;
    in-out property <float> video-player-volume;
    in property <length> viewer-origin-height;
    in property <length> viewer-origin-width;
    in property <length> viewer-origin-x;
    in property <length> viewer-origin-y;
    in property <length> window-height;
    callback accept-incoming-call(string);
    callback audio-device-selected(string);
    callback audio-output-selected(string);
    callback close-code-preview();
    callback close-image-viewer();
    callback close-pdf-preview();
    callback close-video-player();
    callback copy-code();
    callback copy-message(string, string);
    callback decline-incoming-call(string);
    callback delete-everyone-message(string, string);
    callback delete-message(string, string);
    callback download-message(string, string);
    callback edit-message(string, string);
    callback forward-message-action(string, string);
    callback media-viewer-export(bool);
    callback media-viewer-navigate(int);
    callback media-viewer-open-downloads();
    callback mention-suggestion-selected(string, string);
    callback message-clicked(string);
    callback message-selection-toggled(string);
    callback nav-close(string);
    callback open-code-external();
    callback open-pdf-external();
    callback pdf-page-next();
    callback pdf-page-prev();
    callback pin-message(string, string);
    callback react-clicked(string, string, length, length);
    callback reaction-picker-category-changed(int);
    callback reaction-picker-search-changed(string);
    callback reaction-selected(string, string, string, string);
    callback reply-message(string, string);
    callback screen-source-selected(string);
    callback selection-delete-clicked();
    callback thread-clicked(string);
    callback video-player-seek(float);
    callback video-player-set-volume(float);
    callback video-player-toggle-play-pause();
    function is-presented(name: string) -> bool {
        return root.presented-modal == name || root.exiting-modal == name;
    }
    callback focus-back-scope();

    background: transparent;

    // ========== Call overlays (rendered above modals) ==========
    // Incoming call modal
    if root.incoming-presented: IncomingCallModal {
        show: root.incoming-shown;
        call-data: root.incoming-call-data;
        replaces-active: root.incoming-call-replaces-active;

        accept-call => {
            root.accept-incoming-call(root.incoming-call-data.call-id);
        }
        decline-call => {
            root.decline-incoming-call(root.incoming-call-data.call-id);
        }
    }

    // (Active call view is now docked above ChatLayout — see chat column block.)

    // Device picker modal (for audio devices and screen sources)
    if root.device-picker-presented: DevicePicker {
        show: root.device-picker-visible;
        title: root.device-picker-type == "audio" ? "Select Microphone" :
               root.device-picker-type == "audio_output" ? "Select Speaker" : "Select Screen to Share";
        picker-type: root.device-picker-type;
        audio-devices: root.audio-devices;
        selected-audio-id: root.selected-audio-device-id;
        audio-output-devices: root.audio-output-devices;
        selected-audio-output-id: root.selected-audio-output-id;
        screen-sources: root.screen-sources;
        selected-screen-id: root.selected-screen-source-id;

        audio-selected(id) => {
            root.selected-audio-device-id = id;
            root.device-picker-visible = false;
            root.audio-device-selected(id);
        }
        audio-output-selected(id) => {
            root.selected-audio-output-id = id;
            root.device-picker-visible = false;
            root.audio-output-selected(id);
        }
        screen-selected(id) => {
            root.selected-screen-source-id = id;
            root.device-picker-visible = false;
            root.screen-source-selected(id);
        }
        closed => {
            root.device-picker-visible = false;
        }
    }

    // Image viewer overlay (rendered above modals)
    if root.image-viewer-visible: ImageViewer {
        show: true;
        touch: root.is-mobile-platform;
        source: root.image-viewer-source;
        filename: root.image-viewer-filename;
        size-display: root.image-viewer-size;
        thumbnail-x: root.viewer-origin-x;
        thumbnail-y: root.viewer-origin-y;
        thumbnail-width: root.viewer-origin-width;
        thumbnail-height: root.viewer-origin-height;
        position-label: root.media-viewer-position;
        has-previous: root.media-viewer-has-previous;
        has-next: root.media-viewer-has-next;
        previous-thumbnail: root.media-viewer-previous-thumbnail;
        next-thumbnail: root.media-viewer-next-thumbnail;
        previous => { root.media-viewer-navigate(-1); }
        next => { root.media-viewer-navigate(1); }
        download => { root.media-viewer-export(false); }
        copy-image => { root.media-viewer-export(true); }
        open-downloads => { root.media-viewer-open-downloads(); }


        close => {
            root.image-viewer-visible = false;
            root.close-image-viewer();
            root.focus-back-scope();
        }
    }

    // Video player overlay (rendered above modals)
    if root.video-player-visible: VideoPlayer {
        show: true;
        frame: root.video-player-frame;
        filename: root.video-player-filename;
        position-label: root.media-viewer-position;
        has-previous: root.media-viewer-has-previous;
        has-next: root.media-viewer-has-next;
        previous => { root.media-viewer-navigate(-1); }
        next => { root.media-viewer-navigate(1); }
        download => { root.media-viewer-export(false); }
        open-downloads => { root.media-viewer-open-downloads(); }

        progress: root.video-player-progress;
        elapsed: root.video-player-elapsed;
        duration: root.video-player-duration;
        is-playing: root.video-player-is-playing;
        volume: root.video-player-volume;

        close => {
            root.video-player-visible = false;
            root.close-video-player();
        }
        toggle-play-pause => {
            root.video-player-toggle-play-pause();
        }
        seek(pos) => {
            root.video-player-seek(pos);
        }
        set-volume(vol) => {
            root.video-player-volume = vol;
            root.video-player-set-volume(vol);
        }
    }

    // File previews stay above the modal stack.
    if root.code-preview-visible: CodePreviewOverlay {
        width: 100%;
        height: 100%;
        file-name: root.code-preview-filename;
        language: root.code-preview-language;
        line-count: root.code-preview-line-count;
        plain-text: root.code-preview-plain-text;
        close => { root.code-preview-visible = false; root.close-code-preview(); }
        copy => { root.copy-code(); }
        open-external => { root.open-code-external(); }
    }

    if root.pdf-preview-visible: PdfPreviewOverlay {
        width: 100%;
        height: 100%;
        file-name: root.pdf-preview-filename;
        page-count: root.pdf-preview-page-count;
        current-page: root.pdf-preview-current-page;
        error-message: root.pdf-preview-error;
        external-only: root.pdf-preview-external-only;
        page-image: root.pdf-preview-image;
        close => { root.pdf-preview-visible = false; root.close-pdf-preview(); }
        open-external => { root.open-pdf-external(); }
        page-prev => { root.pdf-page-prev(); }
        page-next => { root.pdf-page-next(); }
    }

    // Reaction picker overlay
    ReactionPicker {
        show: root.reaction-picker-visible;
        touch: root.is-mobile-platform;
        message-id: root.reaction-picker-message-id;
        sender-id: root.reaction-picker-sender-id;
        timestamp-ns: root.reaction-picker-timestamp-ns;
        emoji-list: root.reaction-picker-emojis;
        selected-category <=> root.reaction-picker-selected-category;
        search-query <=> root.reaction-picker-search-query;
        // Anchor near button. Flip above if no space below. Clamp horizontally.
        position-x: max(8px, min(root.reaction-picker-anchor-x, root.width - 288px));
        position-y: root.reaction-picker-anchor-y + 360px > root.window-height
            ? max(8px, root.reaction-picker-anchor-y - 360px)
            : root.reaction-picker-anchor-y + 4px;

        reaction-selected(sender-id, timestamp-ns, msg-id, emoji) => {
            root.reaction-picker-visible = false;
            root.reaction-selected(sender-id, timestamp-ns, msg-id, emoji);
        }

        category-changed(category) => {
            root.reaction-picker-category-changed(category);
        }

        search-changed(query) => {
            root.reaction-picker-search-changed(query);
        }

        close => {
            root.reaction-picker-visible = false;
        }
    }

    // Mention autocomplete overlay (positioned above composer cursor)
    MentionAutocomplete {
        show: root.mention-autocomplete-visible;
        suggestions: root.mention-suggestions;
        selected-index: root.mention-selected-index;
        max-popup-width: min(240px, root.width - 32px);
        // Position above the composer
        x: root.sidebar-hidden ? 16px : (root.sidebar-collapsed ? 80px : 280px);
        y: root.window-height - 80px - (Math.min(root.mention-suggestions.length, 8) * 40px + 16px);

        suggestion-selected(id, display) => {
            root.mention-autocomplete-visible = false;
            root.mention-suggestion-selected(id, display);
        }

        close => {
            root.mention-autocomplete-visible = false;
        }
    }

    if root.is-presented("message-info"): MessageInfoModal {
        show: root.active-modal == "message-info";
        close => { root.nav-close("message-info"); }
    }

    MessageContextMenu {
        show: root.context-menu-visible;
        sender-id: root.context-menu-sender-id;
        timestamp-ns: root.context-menu-timestamp-ns;
        message-id: root.context-menu-message-id;
        position-x: root.context-menu-x;
        // This overlay lives in the same inset content rectangle as the
        // composer. Its height already excludes the IME and system bars.
        position-y: root.context-menu-y - root.safe-area-top;
        content-top: root.context-menu-content-top - root.safe-area-top;
        anchor-top: root.context-menu-anchor-top > 0px
            ? root.context-menu-anchor-top - root.safe-area-top : 0px;
        anchor-bottom: root.context-menu-anchor-bottom > 0px
            ? root.context-menu-anchor-bottom - root.safe-area-top : 0px;
        anchor-left: root.context-menu-anchor-left;
        anchor-right: root.context-menu-anchor-right;
        preview-message: root.context-menu-preview-message;
        preview-row-x: root.context-menu-preview-row-x;
        preview-row-y: root.context-menu-preview-row-y - root.safe-area-top;
        preview-row-width: root.context-menu-preview-row-width;
        preview-mobile: root.context-menu-preview-mobile;
        preview-from-thread: root.context-menu-preview-from-thread;
        preview-is-dm: root.is-dm;
        preview-is-anonymous: root.conversation-kind == ConversationKind.anon-dm || root.conversation-kind == ConversationKind.anon-group;
        preview-is-mesh: MeshGlobal.active-id != "";
        preview-playing-attachment-id: root.current-playing-attachment-id;
        preview-media-playing: root.is-media-playing;
        preview-audio-progress: root.audio-progress;
        preview-audio-elapsed: root.audio-elapsed;
        retry-clicked(id) => { root.message-clicked(id); }
        info-clicked(id) => { MessageInfo.open(id); }
        can-thread: root.conversation-kind == ConversationKind.channel;

        close => {
            root.context-menu-visible = false;
        }
        quick-react(sender-id, timestamp-ns, emoji) => {
            root.context-menu-visible = false;
            root.reaction-selected(sender-id, timestamp-ns, root.context-menu-message-id, emoji);
        }
        more-reactions-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.reaction-picker-sender-id = sender-id;
            root.reaction-picker-timestamp-ns = timestamp-ns;
            root.reaction-picker-message-id = root.context-menu-message-id;
            root.reaction-picker-anchor-x = root.context-menu-x;
            root.reaction-picker-anchor-y = root.context-menu-y;
            root.reaction-picker-visible = true;
            root.react-clicked(sender-id, timestamp-ns, root.context-menu-x, root.context-menu-y);
        }
        thread-clicked(id) => {
            root.context-menu-visible = false;
            root.thread-clicked(id);
        }
        select-clicked(id) => {
            root.context-menu-visible = false;
            root.selection-mode = true;
            root.message-selection-toggled(id);
        }
        reply-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.reply-message(sender-id, timestamp-ns);
            root.reply-focus-serial += 1;
        }
        edit-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.edit-message(sender-id, timestamp-ns);
        }
        delete-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.delete-choosing = true;
            root.delete-choice-everyone = MessageMenuActions.delete-for-everyone;
            root.delete-choice-me = MessageMenuActions.delete-for-me;
            root.delete-confirm-sender = sender-id;
            root.delete-confirm-timestamp = timestamp-ns;
            root.delete-confirm-everyone = false;
            root.delete-confirm-count = 1;
        }
        pin-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.pin-message(sender-id, timestamp-ns);
        }
        forward-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.forward-message-action(sender-id, timestamp-ns);
        }
        copy-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.copy-message(sender-id, timestamp-ns);
        }
        download-clicked(sender-id, timestamp-ns) => {
            root.context-menu-visible = false;
            root.download-message(sender-id, timestamp-ns);
        }
    }

    // A single delete names its message; a multi-select leaves the sender
    // empty and deletes the selection with its confirmed scope.
    if root.delete-confirm-count > 0: DeleteConfirm {
        count: root.delete-confirm-count;
        is-dm: root.conversation-kind == ConversationKind.server-dm || root.conversation-kind == ConversationKind.anon-dm;
        for-everyone: root.delete-confirm-everyone;
        choosing: root.delete-choosing;
        can-delete-everyone: root.delete-choice-everyone;
        can-delete-me: root.delete-choice-me;
        scope-chosen(everyone) => {
            root.delete-confirm-everyone = everyone;
            root.delete-choosing = false;
        }
        cancelled => { root.delete-confirm-count = 0; }
        confirmed => {
            root.delete-confirm-count = 0;
            if root.delete-confirm-everyone {
                if root.delete-confirm-sender == "" {
                    SelectionChrome.delete-everyone();
                } else {
                    root.delete-everyone-message(root.delete-confirm-sender, root.delete-confirm-timestamp);
                }
            } else if root.delete-confirm-sender != "" {
                root.delete-message(root.delete-confirm-sender, root.delete-confirm-timestamp);
            } else {
                root.selection-delete-clicked();
            }
        }
    }
}
