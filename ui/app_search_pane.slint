export global SearchPane {
    // ========== Unified search (top bar) ==========
    in property <[QuickSwitcherItem]> unified-search-conversations: [];
    in property <[SearchResult]> unified-search-messages: [];
    in property <bool> unified-search-searching: false;
    in-out property <string> unified-search-query: "";
    in-out property <int> unified-search-caret-end-seq: 0;
    in-out property <bool> unified-search-open: false;
    in-out property <int> unified-search-selected-index: 0;
    in-out property <string> unified-search-category: "all";
    in-out property <string> unified-search-sort: "relevance";
    in-out property <string> unified-search-date: "any";
    in-out property <string> unified-search-from: "";
    in-out property <string> unified-search-in: "";
    in-out property <string> unified-search-from-label: "";
    in-out property <string> unified-search-in-label: "";
    in property <[QuickSwitcherItem]> unified-search-picker-options: [];
    in property <bool> unified-search-picker-searching: false;
    in property <[string]> unified-search-recents: [];
    in property <string> unified-search-calendar-month: "";
    in property <[CalendarDay]> unified-search-calendar-days: [];
    in property <[int]> unified-search-counts: [0, 0, 0, 0, 0, 0, 0];
    in property <[int]> unified-search-page-limits: [50, 50, 50, 50, 50, 50, 50];
    in property <[image]> unified-search-thumbnails: [];
    in property <[bool]> unified-search-has-thumbnails: [];
    in property <[string]> unified-search-message-kinds: [];
    // Loaded from SettingsRepository at startup: "k" | "f" | "both".
    in-out property <string> search-shortcut-pref: "both";
    callback unified-search-opened();
    callback unified-search-closed();
    callback unified-search-changed(string);
    callback unified-search-filters-changed(string, string, string, string, string);
    callback unified-search-recent-selected(string);
    callback unified-search-recent-clear();
    callback unified-search-recent-remove(string);
    callback unified-search-calendar-shift(int);
    callback unified-search-picker-request(string, string);
    callback unified-search-show-more(string);
    callback unified-search-conversation-selected(string, string);
    callback unified-search-message-selected(string);
    // People (exact-handle resolve-on-Enter)
    in property <bool> unified-search-query-is-handle: false;
    in property <string> unified-search-person-status: "";
    in property <string> unified-search-person-error: "";
    in property <string> unified-search-person-id: "";
    in property <string> unified-search-person-name: "";
    in property <string> unified-search-person-handle: "";
    callback unified-search-resolve(string);
    callback unified-search-person-selected(string);
}
