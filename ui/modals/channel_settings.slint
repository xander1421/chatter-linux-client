// ChannelSettingsModal - Modal for viewing and editing channel settings

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Toggle } from "../components/toggle.slint";
import { ScrollView } from "std-widgets.slint";

// Member data for the member list
export struct ChannelMemberData {
    user-id: string,
    display-name: string,
    username: string,
    role: string,  // "owner", "admin", "moderator", "member"
    joined-at: string,
}

export component ChannelSettingsModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <string> channel-description: "";
    // Editable drafts for name/description. Reset by Rust on open (see
    // open_channel_settings) so reopening a different channel starts clean;
    // the name/description Inputs write here and Save reads them.
    in-out property <string> channel-name-draft: "";
    in-out property <string> channel-description-draft: "";
    // Icon picker: Rust sets icon-path (chosen file) + icon-preview on pick;
    // Save reads icon-path to upload. Reset by Rust on open.
    in-out property <string> channel-icon-path: "";
    in-out property <image> channel-icon-preview;
    in-out property <bool> channel-has-icon-preview: false;
    in property <string> channel-type: "public";  // "public", "private", "dm"
    in property <bool> is-archived: false;
    in property <string> created-at: "";
    in property <int> member-count: 0;

    // Current user's permissions
    in property <bool> can-edit: false;
    in property <bool> can-manage-members: false;
    in property <bool> can-archive: false;
    in property <bool> can-delete: false;
    in property <bool> is-owner: false;

    // Notification settings (per user)
    in-out property <string> notification-preference: "all";  // "all", "mentions", "none"
    in-out property <bool> is-muted: false;
    in-out property <bool> ai-enabled: false;

    // Member list
    in property <[ChannelMemberData]> members: [];

    // Loading/error state
    in property <bool> loading: false;
    in property <string> error-message: "";

    // Active section for navigation
    in-out property <string> active-section: "general";  // "general", "notifications", "members", "danger"

    callback close();
    callback save-settings(string, string);  // name, description
    callback pick-channel-icon();  // opens native file picker for the channel icon
    callback change-notification(string);  // preference
    callback toggle-mute(bool);
    callback toggle-ai(bool);
    callback change-member-role(string, string);  // user-id, new-role
    callback remove-member(string);  // user-id
    callback invite-members();  // opens invite modal (private groups)
    callback invite-channel-members();  // opens invite modal (regular channels)
    callback archive-channel();
    callback leave-channel();
    callback delete-channel();

    // Confirmation reveals for the two irreversible actions in Danger Zone.
    // Presentation state only — nothing leaves the UI until the second click.
    // Reset on every open, or a modal closed mid-confirm reopens (possibly on
    // a DIFFERENT channel) already asking to leave or delete.
    property <bool> show-delete-confirm: false;
    property <bool> show-leave-confirm: false;
    changed show-modal => {
        self.show-delete-confirm = false;
        self.show-leave-confirm = false;
    }

    // Private group helper
    property <bool> is-private-group: channel-type == "private-group";

    // Helper to get role display color
    pure function role-color(role: string) -> color {
        if role == "owner" {
            return Colors.warning;
        } else if role == "admin" {
            return Colors.error;
        } else if role == "moderator" {
            return Colors.info;
        } else {
            return Colors.text-secondary;
        }
    }

    // Helper to get channel type icon
    pure function type-icon(t: string) -> string {
        if t == "private" {
            return "\u{1F512}";  // Lock
        } else if t == "dm" {
            return "\u{1F4AC}";  // Speech bubble
        } else {
            return "#";
        }
    }

    Modal {
        show: root.show-modal;
        title: "Channel Settings";
        modal-width: 800px;
        max-modal-height: 820px;
        // Expand the card to the available height (capped at max-modal-height)
        // instead of hugging content — the right panel scrolls.
        fill-height: true;

        close => {
            root.close();
        }

        HorizontalLayout {
            spacing: 0;

            // Left sidebar - section navigation — Neo inset panel
            Rectangle {
                width: 160px;
                background: Colors.neo-inset-bg;
                border-radius: Spacing.radius-md;
                border-width: 1px;
                border-color: Colors.neo-inset-shadow;

                VerticalLayout {
                    padding: Spacing.sm;
                    spacing: Spacing.xs;
                    alignment: start;

                    // General section — Neo nav item
                    Rectangle {
                        height: 36px;
                        background: root.active-section == "general" ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;
                        border-width: root.active-section == "general" ? 1px : 0px;
                        border-color: Colors.neo-highlight;

                        TouchArea {
                            clicked => { root.active-section = "general"; }

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                alignment: start;

                                Text {
                                    text: "\u{2699}\u{FE0F}  General";
                                    color: root.active-section == "general" ? Colors.text-primary : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Notifications section — Neo nav item
                    Rectangle {
                        height: 36px;
                        background: root.active-section == "notifications" ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;
                        border-width: root.active-section == "notifications" ? 1px : 0px;
                        border-color: Colors.neo-highlight;

                        TouchArea {
                            clicked => { root.active-section = "notifications"; }

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                alignment: start;

                                Text {
                                    text: "\u{1F514}  Notifications";
                                    color: root.active-section == "notifications" ? Colors.text-primary : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Members section — Neo nav item
                    if root.can-manage-members: Rectangle {
                        height: 36px;
                        background: root.active-section == "members" ? Colors.surface-hover : transparent;
                        border-radius: Spacing.radius-sm;
                        border-width: root.active-section == "members" ? 1px : 0px;
                        border-color: Colors.neo-highlight;

                        TouchArea {
                            clicked => { root.active-section = "members"; }

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                alignment: start;

                                // U+1F465 is a tofu box on the Galaxy S9 (§112u).
                                Image {
                                    source: Icons.users;
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.active-section == "members" ? Colors.text-primary : Colors.text-secondary;
                                }
                                Rectangle { width: Spacing.sm; }
                                Text {
                                    text: "Members";
                                    color: root.active-section == "members" ? Colors.text-primary : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Danger zone section (only for those with permissions)
                    if root.can-archive || root.can-delete: Rectangle {
                        height: 36px;
                        background: root.active-section == "danger" ? Colors.error.with-alpha(0.1) : transparent;
                        border-radius: Spacing.radius-sm;

                        TouchArea {
                            clicked => { root.active-section = "danger"; }

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                alignment: start;

                                Text {
                                    text: "\u{26A0}\u{FE0F}  Danger Zone";
                                    color: root.active-section == "danger" ? Colors.error : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Right content area
            Rectangle {
                background: transparent;

                ScrollView {
                    viewport-height: content-area.preferred-height;

                    content-area := VerticalLayout {
                        padding: Spacing.md;
                        spacing: Spacing.lg;

                        // ========== General Section ==========
                        if root.active-section == "general": VerticalLayout {
                            spacing: Spacing.md;

                            // Channel header info
                            HorizontalLayout {
                                spacing: Spacing.sm;
                                alignment: start;

                                Text {
                                    text: root.type-icon(root.channel-type);
                                    font-size: Typography.xl;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;

                                    Text {
                                        text: root.channel-name;
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.semibold;
                                    }

                                    Text {
                                        text: root.member-count + " members • Created " + root.created-at;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }
                            }

                            // Divider — Neo
                            Rectangle {
                                height: 1px;
                                background: Colors.neo-inset-shadow;
                            }

                            // Channel name (editable if permitted)
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "Channel Name";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                if root.can-edit: Input {
                                    text: root.channel-name-draft;
                                    placeholder: "Channel name";

                                    edited(value) => {
                                        root.channel-name-draft = value;
                                    }
                                }

                                if !root.can-edit: Text {
                                    text: root.channel-name;
                                    color: Colors.text-primary;
                                    font-size: Typography.base;
                                }
                            }

                            // Channel description
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "Description";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                if root.can-edit: Input {
                                    text: root.channel-description-draft;
                                    placeholder: "Add a description...";

                                    edited(value) => {
                                        root.channel-description-draft = value;
                                    }
                                }

                                if !root.can-edit: Text {
                                    text: root.channel-description != "" ? root.channel-description : "No description";
                                    color: root.channel-description != "" ? Colors.text-primary : Colors.text-muted;
                                    font-size: Typography.base;
                                    font-italic: root.channel-description == "";
                                }
                            }

                            // Channel icon (editable if permitted). Native file
                            // picker → Rust stashes bytes + preview; Save uploads.
                            if root.can-edit: VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "Channel Icon";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    alignment: start;

                                    if root.channel-has-icon-preview: Image {
                                        source: root.channel-icon-preview;
                                        width: 48px;
                                        height: 48px;
                                    }

                                    Button {
                                        text: "Change Icon";
                                        variant: "secondary";
                                        clicked => {
                                            root.pick-channel-icon();
                                        }
                                    }
                                }
                            }

                            // Save name/description/icon edits. Disabled until a
                            // draft differs or an icon was picked, so an
                            // accidental click is a no-op.
                            if root.can-edit: HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: "Save Changes";
                                    variant: "primary";
                                    disabled: root.channel-name-draft == root.channel-name
                                        && root.channel-description-draft == root.channel-description
                                        && !root.channel-has-icon-preview;
                                    clicked => {
                                        root.save-settings(root.channel-name-draft, root.channel-description-draft);
                                    }
                                }
                            }

                        }

                        // ========== Notifications Section ==========
                        if root.active-section == "notifications": VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Notification Preferences";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            // Mute toggle
                            HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Mute Channel";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                    }
                                    Text {
                                        text: "You won't receive any notifications from this channel";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }

                                Toggle {
                                    checked: root.is-muted;
                                    toggled(value) => {
                                        root.toggle-mute(value);
                                    }
                                }
                            }

                            // AI assistant for this channel
                            HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "AI assistant";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                    }
                                    Text {
                                        text: "Let the AI read this channel when you ask it something here. Off by default.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }

                                Toggle {
                                    checked: root.ai-enabled;
                                    toggled(value) => {
                                        root.toggle-ai(value);
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Colors.surface-hover;
                            }

                            Text {
                                text: "When not muted, notify me for:";
                                color: Colors.text-secondary;
                                font-size: Typography.sm;
                            }

                            // All messages — Neo selection card
                            Rectangle {
                                height: 44px;
                                background: root.notification-preference == "all" ? Colors.neo-inset-bg : transparent;
                                border-radius: Spacing.radius-sm;
                                border-width: root.notification-preference == "all" ? 1px : 0;
                                border-color: Colors.glow-cyan.with-alpha(0.4);

                                TouchArea {
                                    clicked => { root.change-notification("all"); }

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            border-width: 2px;
                                            border-color: root.notification-preference == "all" ? Colors.glow-cyan : Colors.neo-inset-shadow;
                                            background: root.notification-preference == "all" ? Colors.glow-cyan : transparent;
                                        }

                                        VerticalLayout {
                                            Text {
                                                text: "All Messages";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                            }
                                            Text {
                                                text: "Get notified for every message";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }
                                    }
                                }
                            }

                            // Mentions only — Neo selection card
                            Rectangle {
                                height: 44px;
                                background: root.notification-preference == "mentions" ? Colors.neo-inset-bg : transparent;
                                border-radius: Spacing.radius-sm;
                                border-width: root.notification-preference == "mentions" ? 1px : 0;
                                border-color: Colors.glow-cyan.with-alpha(0.4);

                                TouchArea {
                                    clicked => { root.change-notification("mentions"); }

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            border-width: 2px;
                                            border-color: root.notification-preference == "mentions" ? Colors.glow-cyan : Colors.neo-inset-shadow;
                                            background: root.notification-preference == "mentions" ? Colors.glow-cyan : transparent;
                                        }

                                        VerticalLayout {
                                            Text {
                                                text: "Mentions Only";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                            }
                                            Text {
                                                text: "Only when someone @mentions you";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }
                                    }
                                }
                            }

                            // None — Neo selection card
                            Rectangle {
                                height: 44px;
                                background: root.notification-preference == "none" ? Colors.neo-inset-bg : transparent;
                                border-radius: Spacing.radius-sm;
                                border-width: root.notification-preference == "none" ? 1px : 0;
                                border-color: Colors.glow-cyan.with-alpha(0.4);

                                TouchArea {
                                    clicked => { root.change-notification("none"); }

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            border-width: 2px;
                                            border-color: root.notification-preference == "none" ? Colors.glow-cyan : Colors.neo-inset-shadow;
                                            background: root.notification-preference == "none" ? Colors.glow-cyan : transparent;
                                        }

                                        VerticalLayout {
                                            Text {
                                                text: "Nothing";
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                            }
                                            Text {
                                                text: "Never notify (still shows unread badge)";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ========== Members Section ==========
                        if root.active-section == "members": VerticalLayout {
                            spacing: Spacing.md;

                            HorizontalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: "Members";
                                    color: Colors.text-primary;
                                    font-size: Typography.lg;
                                    font-weight: Typography.semibold;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.member-count + " total";
                                    color: Colors.text-muted;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }

                                // Invite button for private groups (admins/owners only)
                                if root.is-private-group && root.can-manage-members: Rectangle {
                                    width: invite-btn-text.width + Spacing.md * 2;
                                    height: 28px;
                                    background: invite-btn-touch.has-hover ? Colors.primary.darker(10%) : Colors.primary;
                                    border-radius: Spacing.radius-sm;

                                    invite-btn-text := Text {
                                        text: "+ Invite";
                                        color: Colors.text-primary;
                                        font-size: Typography.xs;
                                        font-weight: Typography.medium;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    invite-btn-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.invite-members(); }
                                    }
                                }

                                // Invite button for regular channels (admins/owners only)
                                if !root.is-private-group && root.can-manage-members: Rectangle {
                                    width: invite-ch-btn-text.width + Spacing.md * 2;
                                    height: 28px;
                                    background: invite-ch-btn-touch.has-hover ? Colors.primary.darker(10%) : Colors.primary;
                                    border-radius: Spacing.radius-sm;

                                    invite-ch-btn-text := Text {
                                        text: "+ Invite";
                                        color: Colors.text-primary;
                                        font-size: Typography.xs;
                                        font-weight: Typography.medium;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    invite-ch-btn-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.invite-channel-members(); }
                                    }
                                }
                            }

                            // Member list
                            for member in root.members: Rectangle {
                                height: 52px;
                                background: transparent;

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    padding: Spacing.xs;

                                    // Avatar placeholder
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: Colors.surface-hover;

                                        Text {
                                            text: member.display-name != "" ? member.display-name : "?";
                                            color: Colors.text-secondary;
                                            font-size: Typography.sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Name and role
                                    VerticalLayout {
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            spacing: Spacing.xs;

                                            Text {
                                                text: member.display-name;
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                            }

                                            if member.role != "member": Rectangle {
                                                width: role-text.width + Spacing.sm;
                                                height: 18px;
                                                background: root.role-color(member.role).with-alpha(0.15);
                                                border-radius: Spacing.radius-sm;

                                                role-text := Text {
                                                    x: Spacing.xs;
                                                    text: member.role;
                                                    color: root.role-color(member.role);
                                                    font-size: Typography.xs;
                                                    font-weight: Typography.medium;
                                                    vertical-alignment: center;
                                                    height: 100%;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "@" + member.username;
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                        }
                                    }

                                    // Actions (only if can manage and not owner)
                                    if root.can-manage-members && member.role != "owner": Button {
                                        text: "Remove";
                                        variant: "ghost";

                                        clicked => {
                                            root.remove-member(member.user-id);
                                        }
                                    }
                                }

                                // Bottom border
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Colors.surface-hover.with-alpha(0.5);
                                }
                            }
                        }

                        // ========== Danger Zone Section ==========
                        if root.active-section == "danger": VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Danger Zone";
                                color: Colors.error;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "These actions are irreversible. Please be certain.";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                            }

                            Rectangle {
                                height: 1px;
                                background: Colors.error.with-alpha(0.3);
                            }

                            // Leave channel. Gated unconditionally, not just
                            // for private channels: leaving a private one has
                            // no rejoin path, and a control that is sometimes
                            // destructive and sometimes not, with no visual
                            // difference, is worse than one that always asks.
                            if !root.is-owner && !root.show-leave-confirm: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Leave Channel";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                    }
                                    Text {
                                        text: "You will lose access to this channel's messages";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }

                                Button {
                                    text: "Leave";
                                    variant: "secondary";

                                    clicked => {
                                        root.show-leave-confirm = true;
                                    }
                                }
                            }

                            if !root.is-owner && root.show-leave-confirm: VerticalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: "Leave \"" + root.channel-name + "\"? You lose access to its messages, and an invite-only channel cannot be rejoined on your own.";
                                    color: Colors.error;
                                    font-size: Typography.sm;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;

                                    Button {
                                        text: "Cancel";
                                        variant: "secondary";
                                        clicked => {
                                            root.show-leave-confirm = false;
                                        }
                                    }

                                    Button {
                                        text: "Leave channel";
                                        variant: "danger";
                                        clicked => {
                                            root.show-leave-confirm = false;
                                            root.leave-channel();
                                        }
                                    }
                                }
                            }

                            // Archive channel
                            if root.can-archive: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: root.is-archived ? "Unarchive Channel" : "Archive Channel";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                    }
                                    Text {
                                        text: root.is-archived ? "Make channel active again" : "Archive to hide from active channels";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }

                                Button {
                                    text: root.is-archived ? "Unarchive" : "Archive";
                                    variant: "secondary";

                                    clicked => {
                                        root.archive-channel();
                                    }
                                }
                            }

                            // Delete channel. H3: the one irreversible action
                            // in this modal was a single click on a button
                            // sitting in the same row rhythm as "Archive" —
                            // one slip and the channel and every message in it
                            // are gone. Same two-step reveal Settings uses for
                            // Delete Account (settings_screen.slint
                            // `show-delete-confirm`): the first click only
                            // asks, and the answer defaults to Cancel.
                            if root.can-delete && !root.show-delete-confirm: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Delete Channel";
                                        color: Colors.error;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                    }
                                    Text {
                                        text: "Permanently delete this channel and all messages";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                    }
                                }

                                Button {
                                    text: "Delete";
                                    variant: "danger";

                                    clicked => {
                                        root.show-delete-confirm = true;
                                    }
                                }
                            }

                            if root.can-delete && root.show-delete-confirm: VerticalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: "Delete \"" + root.channel-name + "\" permanently? Every message in it goes with it. This cannot be undone.";
                                    color: Colors.error;
                                    font-size: Typography.sm;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;

                                    // Cancel first, and it is the non-danger
                                    // variant: the safe answer is the one the
                                    // eye and the thumb land on.
                                    Button {
                                        text: "Cancel";
                                        variant: "secondary";
                                        clicked => {
                                            root.show-delete-confirm = false;
                                        }
                                    }

                                    Button {
                                        text: "Delete channel";
                                        variant: "danger";
                                        clicked => {
                                            root.show-delete-confirm = false;
                                            root.delete-channel();
                                        }
                                    }
                                }
                            }
                        }

                        // Error message
                        if root.error-message != "": Rectangle {
                            height: 40px;
                            background: Colors.error.with-alpha(0.1);
                            border-radius: Spacing.radius-sm;

                            Text {
                                text: root.error-message;
                                color: Colors.error;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
