// ChannelSettingsModal - Modal for viewing and editing channel settings

import { Avatar } from "../components/avatar.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { SettingsRow } from "../components/settings_row.slint";
import { Input } from "../components/input.slint";
import { ToggleRow } from "../components/toggle_row.slint";
import { DisappearingGlobal } from "../chat/disappearing_global.slint";
import { ScrollView } from "std-widgets.slint";
import { MembershipGlobal } from "../chat/membership_global.slint";

// Member data for the member list
export struct ChannelMemberData {
    user-id: string,
    display-name: string,
    username: string,
    role: string,  // "owner", "admin", "moderator", "member"
    joined-at: string,
    // The member's photo; an empty image falls back to initials.
    avatar-source: image,
    // Moderator-muted: the server refuses this member's sends.
    muted: bool,
    // What the viewer may do to this member, computed in core.
    can-ban: bool,
    can-mute: bool,
    // Only the owner may hand the channel to this member.
    can-make-owner: bool,
    // Listed by the server but outside the verified membership: gets no
    // sender keys. Decided in core (`is_unverified_channel_member`).
    unverified: bool,
    // Private groups: anyone but us may be blocked in the group (their
    // posts are dropped on this device), and is shown so.
    can-block: bool,
    blocked: bool,
}

// A banned user in the members pane's Banned list.
export struct BannedMemberData {
    user-id: string,
    display-name: string,
    avatar-source: image,
}

export component ChannelSettingsModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> channel-id: "";
    in property <string> channel-name: "";
    in property <string> channel-description: "";
    // Editable drafts for name/description. Reset by Rust on open (see
    // open_channel_settings) so reopening a different channel starts clean;
    // the name/description Inputs write here and Save reads them.
    in-out property <string> channel-name-draft: "";
    in-out property <string> channel-description-draft: "";
    // Icon picker: Rust sets icon-path (chosen file) + icon-preview on pick;
    // Save reads icon-path to upload. Reset by Rust on open.
    in-out property <image> channel-icon-preview;
    in-out property <bool> channel-has-icon-preview: false;
    // The current conversation's already privacy-shaped configured avatar.
    in property <image> channel-avatar-source;
    in property <bool> channel-has-avatar: false;
    in property <string> channel-type: "public";  // "public", "private", "dm"
    in property <bool> is-archived: false;
    in property <string> created-at: "";
    in property <int> member-count: 0;

    // Current user's permissions
    in property <bool> can-edit: false;
    in property <bool> can-manage-members: false;
    in property <bool> can-archive: false;
    in property <bool> can-delete: false;
    in property <bool> is-owner: false;
    // Core's answer (`can_leave_channel`): a member who is not the owner.
    in property <bool> can-leave: false;
    // Private group blocked on this device (Danger Zone toggles it).
    in property <bool> group-blocked: false;

    // Notification settings (per user)
    in-out property <string> notification-preference: "all";  // "all", "mentions", "none"
    in-out property <bool> is-muted: false;
    in-out property <bool> ai-enabled: false;

    // Member list
    in property <[ChannelMemberData]> members: [];
    // Active bans; only filled for roles that can unban (can-view-bans).
    in property <[BannedMemberData]> banned-members: [];
    in property <bool> can-view-bans: false;
    // The members menu's mute choices.
    private property <[{label: string, minutes: int}]> mute-options: [
        { label: "Mute 1h", minutes: 60 },
        { label: "Mute 1 day", minutes: 1440 },
        { label: "Mute until unmuted", minutes: 0 },
    ];
    // The assignable roles (ownership moves only by transfer), with labels.
    private property <[{role: string, label: string}]> role-options: [
        { role: "member", label: "Member" },
        { role: "moderator", label: "Moderator" },
        { role: "admin", label: "Admin" },
    ];

    // Loading/error state
    in property <bool> loading: false;
    in property <bool> saving: false;
    in property <string> error-message: "";

    // Active section for navigation
    in-out property <string> active-section: "overview";

    callback integrations();
    callback server-calls();
    callback close();
    callback save-settings(string, string);  // name, description
    callback pick-channel-icon();  // opens native file picker for the channel icon
    callback change-notification(string);  // preference
    callback toggle-mute(bool);
    callback toggle-ai(bool);
    callback change-member-role(string, string);  // user-id, new-role
    callback remove-member(string);  // user-id
    callback ban-member(string);  // user-id
    callback set-member-muted(string, bool, int);  // user-id, muted, minutes (0 = until unmuted)
    callback unban-member(string);  // user-id
    callback transfer-ownership(string);  // user-id of the new owner
    callback block-member(string, bool);  // user-id, block (false = unblock)
    callback block-group(bool);  // block (false = unblock)
    callback invite-members();  // opens invite modal (private groups)
    callback invite-channel-members();  // opens invite modal (regular channels)
    callback archive-channel();
    callback leave-channel();
    callback delete-channel();

    // Confirmation reveals for the two irreversible actions in Danger Zone.
    // Presentation state only — nothing leaves the UI until the second click.
    // Reset on every open, or a modal closed mid-confirm reopens (possibly on
    // a DIFFERENT channel) already asking to leave or delete.
    property <bool> show-delete-confirm: false;
    property <bool> show-leave-confirm: false;
    property <bool> show-discard-confirm: false;
    // user-id whose action row (role picker + Remove) is expanded in the
    // member list ("" = none).
    property <string> role-picker-user: "";
    // "remove" / "ban" while that member's action asks for confirmation
    // ("" = none). Nothing leaves the UI until the second tap.
    property <string> confirm-action: "";
    changed role-picker-user => { self.confirm-action = ""; }
    changed show-modal => {
        self.active-section = "overview";
        self.show-delete-confirm = false;
        self.show-leave-confirm = false;
        self.show-discard-confirm = false;
        self.role-picker-user = "";
    }

    // Private group helper
    property <bool> is-private-group: channel-type == "private-group";

    // Helper to get role display color
    pure function role-color(role: string) -> color {
        if role == "owner" {
            return Colors.warning;
        } else if role == "admin" {
            return Colors.error;
        } else if role == "moderator" {
            return Colors.info;
        } else {
            return Colors.text-secondary;
        }
    }

    // Channels with a signed membership log get the Access pane.
    property <bool> has-access-pane: root.channel-type == "public" || root.channel-type == "private";
    // Approval toggle for the next link created.
    property <bool> link-needs-approval: false;
    changed channel-id => { self.link-needs-approval = false; }

    // Phone-width layout switch. No media queries in Slint; this is the one
    // place the breakpoint is decided (§112z).
    property <bool> narrow: root.width < 560px;
    property <int> section-tab: root.active-section == "members" ? 1
        : root.active-section == "access" ? 2
        : root.active-section == "notifications" ? (root.has-access-pane ? 3 : 2) : 0;
    property <bool> has-edits: root.channel-name-draft != root.channel-name
        || root.channel-description-draft != root.channel-description || root.channel-has-icon-preview;
    property <bool> name-invalid: root.channel-name-draft == "";

    Modal {
        show: root.show-modal;
        title: root.is-private-group ? "Group Settings" : "Channel Settings";
        modal-width: 640px;
        max-modal-height: max(240px, root.height - 48px);
        full-screen: root.narrow;
        plain-header: true;
        // Let the card hug short sections; Modal caps taller sections to the
        // viewport and scrolls their content.

        close => {
            if root.has-edits { root.show-discard-confirm = true; }
            else { root.close(); }
        }

        // One content column on every screen; phones use Modal's full-screen page.
        VerticalLayout {
            spacing: 0;

            if root.active-section != "general" && root.active-section != "destructive": Rectangle {
                min-height: Spacing.touch-target-min + Spacing.sm * 2;
                preferred-height: Spacing.touch-target-min + Spacing.sm * 2;
                background: transparent;

                settings-tabs := Rectangle {
                    x: Spacing.md;
                    y: Spacing.sm;
                    width: parent.width - Spacing.md * 2;
                    height: Spacing.touch-target-min;
                    background: Colors.surface-control;
                    border-radius: Spacing.radius-lg;
                    property <int> tab-count: root.has-access-pane ? 4 : 3;

                    Rectangle {
                        x: 4px + root.section-tab * (settings-tabs.width - 8px) / settings-tabs.tab-count;
                        y: 4px;
                        width: (settings-tabs.width - 8px) / settings-tabs.tab-count;
                        height: settings-tabs.height - 8px;
                        background: Colors.surface-section;
                        border-radius: Spacing.radius-md;
                        animate x { duration: Materials.motion-standard; easing: Materials.glide; }
                        animate width { duration: Materials.motion-standard; easing: Materials.glide; }
                    }

                    for tab[index] in root.has-access-pane ? ["Info", "Members", "Access", "Alerts"] : ["Info", "Members", "Alerts"]: Rectangle {
                        x: index * settings-tabs.width / settings-tabs.tab-count;
                        width: settings-tabs.width / settings-tabs.tab-count;
                        height: settings-tabs.height;
                        transform-scale-x: section-touch.pressed ? 0.96 : 1;
                        transform-scale-y: section-touch.pressed ? 0.92 : 1;
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                        Text {
                            text: tab;
                            width: 100%; height: 100%;
                            color: root.section-tab == index ? Colors.text-primary : Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: root.section-tab == index ? Typography.semibold : Typography.medium;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        section-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-section = index == 0 ? "overview" : index == 1 ? "members"
                                    : root.has-access-pane && index == 2 ? "access" : "notifications";
                            }
                        }
                    }
                }
            }

            // Right content area
            Rectangle {
                background: transparent;
                // The scroll viewport may be shorter than its content on a
                // phone. Keep the overview icon below the tab strip even
                // while the layout compresses the content area.
                clip: true;
                min-height: 0px;
                vertical-stretch: 1;
                preferred-height: content-area.preferred-height;

                ScrollView {
                    // Fill the area the layout gave us and scroll inside it.
                    // Sized to the content instead, it was centered in a
                    // shorter parent and the overview's top was cut off.
                    y: 0;
                    height: parent.height;
                    // Pin the viewport to the visible width: content wider than
                    // the card elides instead of scrolling sideways off-screen.
                    viewport-width: self.width;
                    viewport-height: content-area.preferred-height;

                    content-area := VerticalLayout {
                        padding: Spacing.md;
                        spacing: Spacing.lg;

                        if root.show-discard-confirm: VerticalLayout {
                            spacing: Spacing.sm;
                            Text {
                                text: "Discard unsaved changes?";
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                font-weight: Typography.semibold;
                            }
                            HorizontalLayout {
                                spacing: Spacing.sm;
                                Button {
                                    text: "Keep editing"; variant: "secondary";
                                    height: Spacing.touch-target-min;
                                    clicked => { root.show-discard-confirm = false; root.active-section = "general"; }
                                }
                                Button {
                                    text: "Discard"; variant: "destructive";
                                    height: Spacing.touch-target-min;
                                    clicked => { root.show-discard-confirm = false; root.close(); }
                                }
                            }
                        }

                        // Error message
                        if root.error-message != "": Rectangle {
                            min-height: 40px;
                            background: Colors.error.with-alpha(0.1);
                            border-radius: Spacing.radius-sm;

                            VerticalLayout {
                                padding: Spacing.sm;
                                alignment: center;

                                Text {
                                    text: root.error-message;
                                    color: Colors.error;
                                    font-size: Typography.sm;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.active-section != "overview": Button {
                            text: root.has-edits && root.active-section == "general" ? "‹ Info • Unsaved changes" : "‹ Info";
                            variant: "ghost";
                            height: Spacing.touch-target-min;
                            clicked => { root.active-section = "overview"; }
                        }

                        // Messenger-style info page: identity first, then destinations.
                        if root.active-section == "overview": VerticalLayout {
                            spacing: Spacing.lg;
                            alignment: start;
                            VerticalLayout {
                                spacing: Spacing.sm;
                                Rectangle {
                                    height: 80px;
                                    background: transparent;
                                    if root.channel-has-icon-preview || root.channel-has-avatar: Avatar {
                                        source: root.channel-has-icon-preview ? root.channel-icon-preview : root.channel-avatar-source;
                                        name: root.channel-name;
                                        size: 80px;
                                        x: (parent.width - self.width) / 2;
                                    }
                                    if !root.channel-has-icon-preview && !root.channel-has-avatar: Rectangle {
                                        width: 80px; height: 80px; border-radius: 40px; background: Colors.inset;
                                        x: (parent.width - self.width) / 2;
                                        Image {
                                            source: root.is-private-group ? Icons.users : root.channel-type == "private" ? Icons.lock : Icons.hash;
                                            width: 36px; height: 36px;
                                            accessible-label: root.is-private-group ? "Group icon" : root.channel-type == "private" ? "Private channel icon" : "Channel icon";
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            colorize: Colors.text-primary;
                                        }
                                    }
                                }
                                Text {
                                    text: root.channel-name == "" ? (root.loading ? "Loading…" : "Info unavailable") : root.channel-name;
                                    color: Colors.text-primary; font-size: Typography.xl;
                                    font-weight: Typography.semibold; horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: (root.member-count > 0 ? root.member-count + (root.member-count == 1 ? " member" : " members") : "")
                                        + (root.created-at != "" ? " • Created " + root.created-at : "");
                                    color: Colors.text-secondary; font-size: Typography.sm;
                                    horizontal-alignment: center;
                                }
                                if root.can-edit: Rectangle {
                                    horizontal-stretch: 1;
                                    height: Spacing.touch-target-min;
                                    background: transparent;
                                    Button {
                                        width: 220px;
                                        height: Spacing.touch-target-min;
                                        x: (parent.width - self.width) / 2;
                                        text: root.is-private-group ? "Edit group info" : "Edit channel info";
                                        variant: "secondary";
                                        icon: Icons.edit;
                                        clicked => { root.active-section = "general"; }
                                    }
                                }
                            }
                            if root.loading: Text { text: "Loading group info…"; color: Colors.text-secondary; font-size: Typography.sm; }
                            if root.channel-description != "": Text {
                                text: root.channel-description; color: Colors.text-secondary;
                                font-size: Typography.sm; wrap: word-wrap;
                            }
                            if root.channel-description == "" && root.can-edit && !root.loading: Text {
                                text: "Add a description so members know what this is for";
                                color: Colors.text-secondary; font-size: Typography.sm;
                                horizontal-alignment: center; wrap: word-wrap;
                            }
                            if root.has-edits: Text {
                                text: root.is-private-group ? "Unsaved changes to group info" : "Unsaved changes to channel info";
                                color: Colors.warning; font-size: Typography.sm;
                            }
                            if !root.loading: Rectangle {
                                background: Colors.surface-section;
                                border-radius: Spacing.radius-lg;
                                VerticalLayout {
                                    padding-left: Spacing.xs;
                                    padding-right: Spacing.xs;
                                    if root.can-manage-members || root.members.length > 0: SettingsRow {
                                        touch: true;
                                        icon: Icons.users; title: "Members";
                                        detail: root.member-count + (root.member-count == 1 ? " member" : " members");
                                        clicked => { root.active-section = "members"; }
                                    }
                                    if root.can-manage-members || root.members.length > 0: Rectangle { height: 1px; background: Colors.divider; }
                                    if root.has-access-pane: SettingsRow {
                                        touch: true;
                                        icon: Icons.link; title: "Access and invite links";
                                        clicked => { root.active-section = "access"; }
                                    }
                                    if root.has-access-pane: Rectangle { height: 1px; background: Colors.divider; }
                                    SettingsRow {
                                        touch: true;
                                        icon: Icons.bell; title: "Notifications";
                                        detail: root.is-muted ? "Muted" : root.notification-preference == "mentions" ? "Mentions only" : root.notification-preference == "none" ? "Off" : "All messages";
                                        clicked => { root.active-section = "notifications"; }
                                    }
                                    if !root.is-private-group: Rectangle { height: 1px; background: Colors.divider; }
                                    // A channel's timer is fixed at creation:
                                    // a value row, no chevron, not an action.
                                    if !root.is-private-group: SettingsRow {
                                        touch: true;
                                        icon: Icons.clock; title: "Disappearing messages";
                                        detail: DisappearingGlobal.active-label;
                                        clickable: false;
                                        show-chevron: false;
                                    }
                                    if !root.is-private-group && root.channel-type != "dm": Rectangle { height: 1px; background: Colors.divider; }
                                    if !root.is-private-group && root.channel-type != "dm": SettingsRow {
                                        touch: true;
                                        icon: Icons.phone; title: "Call history";
                                        clicked => { root.server-calls(); }
                                    }
                                    if root.is-owner && !root.is-private-group: Rectangle { height: 1px; background: Colors.divider; }
                                    if root.is-owner && !root.is-private-group: SettingsRow {
                                        touch: true;
                                        icon: Icons.settings; title: "Integrations";
                                        clicked => { root.integrations(); }
                                    }
                                }
                            }
                            if root.can-archive || root.can-delete || root.can-leave || root.is-private-group: VerticalLayout {
                                spacing: Spacing.sm;
                                Text { text: root.is-private-group ? "Manage group" : "Manage channel"; color: Colors.text-secondary;
                                    font-size: Typography.sm; font-weight: Typography.medium; }
                                Rectangle {
                                    background: Colors.surface-section;
                                    border-radius: Spacing.radius-lg;
                                    SettingsRow {
                                        touch: true;
                                    icon: Icons.alert-triangle; title: "Leave, archive or delete";
                                    destructive: true;
                                    clicked => { root.active-section = "destructive"; }
                                    }
                                }
                            }
                        }

                        // ========== General Section ==========
                        if root.active-section == "general": VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: root.is-private-group ? "Edit group info" : "Edit channel info";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }
                            // Channel header info
                            HorizontalLayout {
                                spacing: Spacing.sm;
                                alignment: start;

                                if root.channel-has-icon-preview || root.channel-has-avatar: Avatar {
                                    source: root.channel-has-icon-preview ? root.channel-icon-preview : root.channel-avatar-source;
                                    name: root.channel-name;
                                    size: 40px;
                                }
                                if !root.channel-has-icon-preview && !root.channel-has-avatar: Image {
                                    source: root.is-private-group ? Icons.users
                                        : root.channel-type == "private" ? Icons.lock
                                        : root.channel-type == "dm" ? Icons.message-circle : Icons.hash;
                                    width: 24px; height: 24px;
                                    colorize: Colors.text-primary;
                                    accessible-label: root.is-private-group ? "Group icon"
                                        : root.channel-type == "private" ? "Private channel icon" : "Channel icon";
                                }

                                VerticalLayout {
                                    spacing: Spacing.xs;
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text {
                                        text: root.channel-name;
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.semibold;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        // No count once we left: the roster is no longer ours to see,
                                        // and "0 members" contradicted the header.
                                        text: (root.member-count == 0 ? "" : root.member-count + (root.member-count == 1 ? " member" : " members"))
                                            + (root.member-count > 0 && root.created-at != "" ? " • " : "")
                                            + (root.created-at == "" ? "" : "Created " + root.created-at);
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Disappearing messages. A channel's timer is fixed
                            // when it is created (the server refuses to change
                            // it), so this is information, not a control.
                            if !root.is-private-group && DisappearingGlobal.active-label != "Off": HorizontalLayout {
                                spacing: Spacing.sm;
                                Image {
                                    source: Icons.clock;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Colors.text-muted;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Messages disappear after " + DisappearingGlobal.active-label + " (set when the channel was created)";
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    wrap: word-wrap;
                                }
                            }

                            // Divider — Neo
                            Rectangle {
                                height: 1px;
                                background: Colors.divider;
                            }

                            // Channel name (editable if permitted)
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: root.is-private-group ? "Group Name" : "Channel Name";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                if root.can-edit: Input {
                                    control-height: Spacing.touch-target-min;
                                    text: root.channel-name-draft;
                                    placeholder: root.is-private-group ? "Group name" : "Channel name";

                                    error: root.name-invalid;
                                    error-message: root.name-invalid ? "Name is required" : "";
                                    edited(value) => {
                                        root.channel-name-draft = value;
                                    }
                                }

                                if !root.can-edit: Text {
                                    text: root.channel-name;
                                    color: Colors.text-primary;
                                    font-size: Typography.base;
                                    wrap: word-wrap;
                                }
                            }

                            // Channel description
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "Description";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                if root.can-edit: Input {
                                    control-height: Spacing.touch-target-min;
                                    text: root.channel-description-draft;
                                    placeholder: "Add a description...";

                                    edited(value) => {
                                        root.channel-description-draft = value;
                                    }
                                }

                                if !root.can-edit: Text {
                                    text: root.channel-description != "" ? root.channel-description : "No description";
                                    color: root.channel-description != "" ? Colors.text-primary : Colors.text-muted;
                                    font-size: Typography.base;
                                    font-italic: root.channel-description == "";
                                    wrap: word-wrap;
                                }
                            }

                            // Channel icon (editable if permitted). Native file
                            // picker → Rust stashes bytes + preview; Save uploads.
                            if root.can-edit: VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: root.is-private-group ? "Group photo" : "Channel icon";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;
                                    alignment: start;

                                    if root.channel-has-icon-preview: Image {
                                        source: root.channel-icon-preview;
                                        width: 48px;
                                        height: 48px;
                                    }

                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: root.is-private-group ? "Change photo" : "Change icon";
                                        variant: "secondary";
                                        clicked => {
                                            root.pick-channel-icon();
                                        }
                                    }
                                }
                            }

                            // Save name/description/icon edits. Disabled until a
                            // draft differs or an icon was picked, so an
                            // accidental click is a no-op.
                            if root.error-message != "": Text {
                                text: root.error-message;
                                color: Colors.error;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }
                            if root.can-edit: HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: "Save changes";
                                    loading: root.saving;
                                    height: Spacing.touch-target-min;
                                    variant: "primary";
                                    disabled: !root.has-edits || root.name-invalid || root.saving;
                                    clicked => {
                                        root.save-settings(root.channel-name-draft, root.channel-description-draft);
                                    }
                                }
                            }

                        }

                        // ========== Notifications Section ==========
                        if root.active-section == "notifications": VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Notification Preferences";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                                wrap: word-wrap;
                            }

                            // Mute toggle
                            ToggleRow {
                                height: Spacing.touch-target-min;
                                checked <=> root.is-muted;
                                accessible-text: "Mute Channel";
                                toggled(value) => {
                                    root.toggle-mute(value);
                                }

                                Text {
                                    text: "Mute Channel";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "You won't receive any notifications from this channel";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                    wrap: word-wrap;
                                }
                            }

                            // AI assistant for this channel
                            ToggleRow {
                                height: Spacing.touch-target-min;
                                checked <=> root.ai-enabled;
                                accessible-text: "AI assistant";
                                toggled(value) => {
                                    root.toggle-ai(value);
                                }

                                Text {
                                    text: "AI assistant";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Let the AI read this channel when you ask it something here. Off by default.";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Colors.divider;
                            }

                            Text {
                                text: "When not muted, notify me for:";
                                color: Colors.text-secondary;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }

                            // All messages — Neo selection card
                            Rectangle {
                                min-height: Spacing.touch-target-min;
                                background: root.notification-preference == "all" ? Colors.inset : all-touch.pressed ? Materials.pressed : transparent;
                                transform-scale-x: all-touch.pressed ? 0.98 : 1;
                                transform-scale-y: all-touch.pressed ? 0.94 : 1;
                                animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                                animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                                animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                                accessible-role: button;
                                accessible-label: "All messages";
                                accessible-description: root.notification-preference == "all" ? "Selected" : "";
                                accessible-action-default => { root.change-notification("all"); }
                                border-radius: Spacing.radius-sm;

                                HorizontalLayout {
                                    padding: Spacing.sm;
                                    spacing: Spacing.sm;

                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        border-width: Spacing.stroke;
                                        border-color: root.notification-preference == "all" ? Colors.primary : Colors.text-muted;
                                        background: root.notification-preference == "all" ? Colors.primary : transparent;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;

                                        Text {
                                            text: "All Messages";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Get notified for every message";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                all-touch := TouchArea {
                                    clicked => { root.change-notification("all"); }
                                }
                            }

                            // Mentions only — Neo selection card
                            Rectangle {
                                min-height: Spacing.touch-target-min;
                                background: root.notification-preference == "mentions" ? Colors.inset : mentions-touch.pressed ? Materials.pressed : transparent;
                                transform-scale-x: mentions-touch.pressed ? 0.98 : 1;
                                transform-scale-y: mentions-touch.pressed ? 0.94 : 1;
                                animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                                animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                                animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                                accessible-role: button;
                                accessible-label: "Mentions only";
                                accessible-description: root.notification-preference == "mentions" ? "Selected" : "";
                                accessible-action-default => { root.change-notification("mentions"); }
                                border-radius: Spacing.radius-sm;

                                HorizontalLayout {
                                    padding: Spacing.sm;
                                    spacing: Spacing.sm;

                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        border-width: Spacing.stroke;
                                        border-color: root.notification-preference == "mentions" ? Colors.primary : Colors.text-muted;
                                        background: root.notification-preference == "mentions" ? Colors.primary : transparent;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;

                                        Text {
                                            text: "Mentions Only";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Only when someone @mentions you";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                mentions-touch := TouchArea {
                                    clicked => { root.change-notification("mentions"); }
                                }
                            }

                            // None — Neo selection card
                            Rectangle {
                                min-height: Spacing.touch-target-min;
                                background: root.notification-preference == "none" ? Colors.inset : none-touch.pressed ? Materials.pressed : transparent;
                                transform-scale-x: none-touch.pressed ? 0.98 : 1;
                                transform-scale-y: none-touch.pressed ? 0.94 : 1;
                                animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                                animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                                animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                                accessible-role: button;
                                accessible-label: "Nothing";
                                accessible-description: root.notification-preference == "none" ? "Selected" : "";
                                accessible-action-default => { root.change-notification("none"); }
                                border-radius: Spacing.radius-sm;

                                HorizontalLayout {
                                    padding: Spacing.sm;
                                    spacing: Spacing.sm;

                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        border-width: Spacing.stroke;
                                        border-color: root.notification-preference == "none" ? Colors.primary : Colors.text-muted;
                                        background: root.notification-preference == "none" ? Colors.primary : transparent;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;

                                        Text {
                                            text: "Nothing";
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Never notify (still shows unread badge)";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                none-touch := TouchArea {
                                    clicked => { root.change-notification("none"); }
                                }
                            }
                        }

                        // ========== Access Section ==========
                        // Everything here is shaped by chatter-core
                        // (`ChatterClient::channel_access_view`).
                        if root.active-section == "access": VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Access";
                                color: Colors.text-primary;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                                wrap: word-wrap;
                            }

                            if MembershipGlobal.access-public-badge != "": Rectangle {
                                height: public-text.preferred-height + Spacing.sm * 2;
                                background: Colors.warning.with-alpha(0.12);
                                border-radius: Spacing.radius-sm;
                                public-text := Text {
                                    x: Spacing.sm;
                                    width: parent.width - Spacing.sm * 2;
                                    text: MembershipGlobal.access-public-badge;
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Server-run readers (AI integrations): not members
                            // anyone signed in, but they read this channel.
                            for bot in MembershipGlobal.server-operated: HorizontalLayout {
                                spacing: Spacing.sm;
                                Image {
                                    source: Icons.sparkles;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Colors.warning;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    Text {
                                        text: bot.name;
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: bot.label;
                                        color: Colors.warning;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // ---- Join links ----
                            if MembershipGlobal.can-manage-invites: VerticalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: "Join links";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }
                                Text {
                                    text: "Anyone with a link can join. The link can be copied only now, when it is created.";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                    wrap: word-wrap;
                                }

                                ToggleRow {
                                    height: Spacing.touch-target-min;
                                    checked <=> root.link-needs-approval;
                                    accessible-text: "Require approval";
                                    Text {
                                        text: "Require approval";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "People who use the link wait until an admin lets them in";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: "Create link";
                                        variant: "primary";
                                        disabled: MembershipGlobal.access-busy;
                                        loading: MembershipGlobal.access-busy;
                                        clicked => { MembershipGlobal.create-link(root.channel-id, root.link-needs-approval); }
                                    }
                                }

                                if MembershipGlobal.new-link != "": Rectangle {
                                    height: new-link-col.preferred-height + Spacing.sm * 2;
                                    background: Colors.inset;
                                    border-radius: Spacing.radius-sm;
                                    new-link-col := VerticalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;
                                        Text {
                                            text: MembershipGlobal.new-link;
                                            color: Colors.text-primary;
                                            font-size: Typography.xs;
                                            wrap: char-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                height: Spacing.touch-target-min;
                                                text: "Copy link";
                                                variant: "secondary";
                                                clicked => { MembershipGlobal.copy-link(MembershipGlobal.new-link); }
                                            }
                                        }
                                    }
                                }

                                for link in MembershipGlobal.invite-links: HorizontalLayout {
                                    spacing: Spacing.sm;
                                    min-height: Spacing.touch-target-min;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: link.summary;
                                        color: Colors.text-primary;
                                        font-size: Typography.xs;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: "Revoke";
                                        variant: "destructive";
                                        disabled: MembershipGlobal.access-busy;
                                        clicked => { MembershipGlobal.revoke-link(root.channel-id, link.id); }
                                    }
                                }
                            }

                            // ---- Join requests ----
                            if MembershipGlobal.can-approve-joins: VerticalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: MembershipGlobal.join-requests.length == 0 ? "No join requests" : "Join requests";
                                    color: Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                for req in MembershipGlobal.join-requests: VerticalLayout {
                                    spacing: Spacing.xs;
                                    Text {
                                        text: req.display-name;
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.sm;
                                        alignment: start;
                                        Button {
                                            height: Spacing.touch-target-min;
                                            text: "Approve";
                                            variant: "primary";
                                            disabled: MembershipGlobal.access-busy;
                                            clicked => { MembershipGlobal.approve-request(root.channel-id, req.user-id); }
                                        }
                                        Button {
                                            height: Spacing.touch-target-min;
                                            text: "Reject";
                                            variant: "secondary";
                                            disabled: MembershipGlobal.access-busy;
                                            clicked => { MembershipGlobal.reject-request(root.channel-id, req.user-id); }
                                        }
                                    }
                                }
                            }

                            if MembershipGlobal.access-status != "": Text {
                                text: MembershipGlobal.access-status;
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        // ========== Members Section ==========
                        if root.active-section == "members": VerticalLayout {
                            spacing: Spacing.md;

                            HorizontalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: "Members";
                                    color: Colors.text-primary;
                                    font-size: Typography.lg;
                                    font-weight: Typography.semibold;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.member-count + " total";
                                    color: Colors.text-muted;
                                    font-size: Typography.sm;
                                    vertical-alignment: center;
                                }

                                // V1 private-group invitations require the real owner.
                                if root.is-private-group && root.is-owner: Rectangle {
                                    width: max(invite-btn-text.width + Spacing.md * 2, Spacing.touch-target-min);
                                    height: Spacing.touch-target-min;
                                    accessible-role: button;
                                    accessible-label: "Invite members";
                                    accessible-action-default => { root.invite-members(); }
                                    background: invite-btn-touch.has-hover ? Colors.action-hover : Colors.action-fill;
                                    border-radius: Spacing.radius-sm;

                                    invite-btn-text := Text {
                                        text: "+ Invite";
                                        color: Colors.on-action;
                                        font-size: Typography.xs;
                                        font-weight: Typography.medium;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    invite-btn-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.invite-members(); }
                                    }
                                }

                                // Invite button for regular channels (admins/owners only)
                                if !root.is-private-group && root.can-manage-members: Rectangle {
                                    width: max(invite-ch-btn-text.width + Spacing.md * 2, Spacing.touch-target-min);
                                    height: Spacing.touch-target-min;
                                    accessible-role: button;
                                    accessible-label: "Invite members";
                                    accessible-action-default => { root.invite-channel-members(); }
                                    background: invite-ch-btn-touch.has-hover ? Colors.action-hover : Colors.action-fill;
                                    border-radius: Spacing.radius-sm;

                                    invite-ch-btn-text := Text {
                                        text: "+ Invite";
                                        color: Colors.on-action;
                                        font-size: Typography.xs;
                                        font-weight: Typography.medium;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    invite-ch-btn-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.invite-channel-members(); }
                                    }
                                }
                            }

                            // Member list
                            if root.members.length == 0: Text {
                                text: root.loading ? "Loading members…" : "No members to show yet";
                                color: Colors.text-secondary;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                            }
                            for member in root.members: Rectangle {
                                height: member-col.preferred-height;
                                background: root.role-picker-user == member.user-id ? Colors.surface-section : transparent;
                                border-radius: Spacing.radius-md;
                                clip: true;
                                animate height { duration: Materials.motion-standard; easing: Materials.glide; }
                                animate background { duration: Materials.motion-quick; easing: Materials.settle; }

                                member-col := VerticalLayout {
                                    HorizontalLayout {
                                        height: 52px;
                                        spacing: Spacing.sm;
                                        padding: Spacing.xs;

                                        // Photo in a clipped circle, initials when there is none.
                                        Avatar {
                                            size: 36px;
                                            source: member.avatar-source;
                                            // Private-group members are anonymous identities.
                                            anonymous: root.is-private-group;
                                            name: member.display-name;
                                            fallback-text: "?";
                                        }

                                        // Name on its own line so it gets the whole
                                        // column; the role badge sits with the handle
                                        // underneath instead of eating the name.
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            alignment: center;

                                            Text {
                                                text: member.display-name;
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                overflow: elide;
                                            }

                                            if member.role != "member" || member.username != "" || member.muted || member.unverified: HorizontalLayout {
                                                spacing: Spacing.xs;

                                                if member.role != "member": Rectangle {
                                                    width: role-text.preferred-width + Spacing.sm;
                                                    height: Spacing.badge-md;
                                                    background: root.role-color(member.role).with-alpha(0.15);
                                                    border-radius: Spacing.radius-sm;

                                                    role-text := Text {
                                                        x: Spacing.xs;
                                                        text: member.role;
                                                        color: root.role-color(member.role);
                                                        font-size: Typography.xs;
                                                        font-weight: Typography.medium;
                                                        vertical-alignment: center;
                                                        height: 100%;
                                                    }
                                                }

                                                // Moderator mute: the server refuses their sends.
                                                if member.muted: Rectangle {
                                                    width: muted-text.preferred-width + Spacing.sm;
                                                    height: Spacing.badge-md;
                                                    background: Colors.error.with-alpha(0.15);
                                                    border-radius: Spacing.radius-sm;

                                                    muted-text := Text {
                                                        x: Spacing.xs;
                                                        text: "muted";
                                                        color: Colors.error;
                                                        font-size: Typography.xs;
                                                        font-weight: Typography.medium;
                                                        vertical-alignment: center;
                                                        height: 100%;
                                                    }
                                                }

                                                // Outside the verified membership: no sender keys.
                                                if member.unverified: Rectangle {
                                                    width: unverified-text.preferred-width + Spacing.sm;
                                                    height: Spacing.badge-md;
                                                    background: Colors.warning.with-alpha(0.15);
                                                    border-radius: Spacing.radius-sm;

                                                    unverified-text := Text {
                                                        x: Spacing.xs;
                                                        text: "unverified";
                                                        color: Colors.warning;
                                                        font-size: Typography.xs;
                                                        font-weight: Typography.medium;
                                                        vertical-alignment: center;
                                                        height: 100%;
                                                    }
                                                }

                                                // Empty when the peer's handle is not known locally.
                                                if member.username != "": Text {
                                                    text: "@" + member.username;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }

                                                // Badges are fixed-width, so without a stretchable
                                                // child this row caps the name column's max width:
                                                // the name elided and the ⋮ drifted mid-row.
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }

                                        // One ⋮ instead of Role + Remove, which on a phone
                                        // squeezed the name to "…". Tapping it expands the
                                        // action row below. Only if can manage and not owner.
                                        // Also for a moderator/admin who can only mute or ban.
                                        if (root.can-manage-members && member.role != "owner") || member.can-ban || member.can-mute || member.can-make-owner || member.can-block: Rectangle {
                                            width: Spacing.touch-target-min;
                                            height: Spacing.touch-target-min;
                                            border-radius: Spacing.radius-sm;
                                            background: member-more.has-hover || root.role-picker-user == member.user-id
                                                ? Colors.surface-hover : transparent;
                                            transform-scale-x: member-more.pressed ? 0.88 : 1;
                                            transform-scale-y: member-more.pressed ? 0.88 : 1;
                                            animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                                            animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                                            animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                                            accessible-role: button;
                                            accessible-label: "Actions for " + member.display-name;
                                            accessible-action-default => {
                                                root.role-picker-user = root.role-picker-user == member.user-id ? "" : member.user-id;
                                            }

                                            // Icons.more-vertical, not U+22EE (no glyph in Inter).
                                            Image {
                                                source: Icons.more-vertical;
                                                colorize: Colors.text-secondary;
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            member-more := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.role-picker-user = root.role-picker-user == member.user-id ? "" : member.user-id;
                                                }
                                            }
                                        }
                                    }

                                    // Remove / Ban / Make owner confirmation, like Block in user_profile.
                                    if root.role-picker-user == member.user-id && root.confirm-action != "": VerticalLayout {
                                        spacing: Spacing.sm;
                                        padding: Spacing.xs;

                                        Text {
                                            text: root.confirm-action == "ban"
                                                ? "Ban " + member.display-name + "? They will be removed and can't rejoin."
                                                : root.confirm-action == "owner"
                                                ? "Make " + member.display-name + " the owner of " + (root.is-private-group ? "" : "#") + root.channel-name + "? You'll become an admin."
                                                : "Remove " + member.display-name + (root.is-private-group ? " from this group?" : " from this channel?");
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Button {
                                                height: Spacing.touch-target-min;
                                                text: "Cancel";
                                                variant: "secondary";
                                                horizontal-stretch: 1;
                                                clicked => { root.confirm-action = ""; }
                                            }

                                            Button {
                                                height: Spacing.touch-target-min;
                                                text: root.confirm-action == "ban" ? "Ban" : root.confirm-action == "owner" ? "Make owner" : "Remove";
                                                variant: root.confirm-action == "owner" ? "primary" : "destructive";
                                                horizontal-stretch: 1;
                                                clicked => {
                                                    if root.confirm-action == "ban" {
                                                        root.ban-member(member.user-id);
                                                    } else if root.confirm-action == "owner" {
                                                        root.transfer-ownership(member.user-id);
                                                    } else {
                                                        root.remove-member(member.user-id);
                                                    }
                                                    root.role-picker-user = "";
                                                }
                                            }
                                        }
                                    }

                                    // Roles are a server-channel concept (anon groups have
                                    // no role RPC), and ownership moves only by transfer
                                    // ("Make owner…"; the role RPC rejects OWNER), so the
                                    // picker offers only the three assignable roles.
                                    // On a phone the pane is ~230px wide (360dp); the three
                                    // role buttons alone need ~270px, so the actions stack
                                    // one per line there instead of running off the card.
                                    if root.role-picker-user == member.user-id && root.confirm-action == "" && root.narrow: VerticalLayout {
                                        spacing: Spacing.xs;
                                        padding: Spacing.xs;

                                        if !root.is-private-group && root.can-manage-members: VerticalLayout {
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Role";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }

                                            for r in root.role-options: Button {
                                                height: Spacing.touch-target-min;
                                                text: r.label;
                                                variant: r.role == member.role ? "primary" : "secondary";

                                                clicked => {
                                                    root.role-picker-user = "";
                                                    if r.role != member.role {
                                                        root.change-member-role(member.user-id, r.role);
                                                    }
                                                }
                                            }
                                        }

                                        if member.can-mute && member.muted: Button {
                                            height: Spacing.touch-target-min;
                                            text: "Unmute";
                                            variant: "secondary";

                                            clicked => {
                                                root.role-picker-user = "";
                                                root.set-member-muted(member.user-id, false, 0);
                                            }
                                        }

                                        // Timed or until unmuted (minutes 0); the server lifts a timed mute.
                                        if member.can-mute && !member.muted: VerticalLayout {
                                            spacing: Spacing.xs;

                                            Text {
                                                text: "Mute in channel";
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }

                                            for opt in root.mute-options: Button {
                                                height: Spacing.touch-target-min;
                                                text: opt.label;
                                                variant: "secondary";

                                                clicked => {
                                                    root.role-picker-user = "";
                                                    root.set-member-muted(member.user-id, true, opt.minutes);
                                                }
                                            }
                                        }

                                        if member.can-make-owner: Button {
                                            height: Spacing.touch-target-min;
                                            text: "Make owner…";
                                            variant: "secondary";

                                            clicked => { root.confirm-action = "owner"; }
                                        }

                                        if member.can-block: Button {
                                            height: Spacing.touch-target-min;
                                            text: member.blocked ? "Unblock in group" : "Block in group";
                                            variant: "secondary";

                                            clicked => {
                                                root.role-picker-user = "";
                                                root.block-member(member.user-id, !member.blocked);
                                            }
                                        }

                                        if root.can-manage-members && member.role != "owner": Button {
                                            height: Spacing.touch-target-min;
                                            text: root.is-private-group ? "Remove from group" : "Remove from channel";
                                            variant: "destructive";

                                            clicked => { root.confirm-action = "remove"; }
                                        }

                                        if member.can-ban: Button {
                                            height: Spacing.touch-target-min;
                                            text: "Ban (can't rejoin)";
                                            variant: "destructive";

                                            clicked => { root.confirm-action = "ban"; }
                                        }
                                    }

                                    // Wide: one row per group (roles, mute, Remove/Ban).
                                    // All eight buttons on one line ran past the modal edge.
                                    if root.role-picker-user == member.user-id && root.confirm-action == "" && !root.narrow: VerticalLayout {
                                        spacing: Spacing.xs;
                                        padding: Spacing.xs;

                                        if !root.is-private-group && root.can-manage-members: HorizontalLayout {
                                            spacing: Spacing.xs;
                                            alignment: end;

                                            for r in root.role-options: Button {
                                                height: Spacing.touch-target-min;
                                                text: r.label;
                                                variant: r.role == member.role ? "primary" : "secondary";

                                                clicked => {
                                                    root.role-picker-user = "";
                                                    if r.role != member.role {
                                                        root.change-member-role(member.user-id, r.role);
                                                    }
                                                }
                                            }
                                        }

                                        if member.can-mute && member.muted: HorizontalLayout {
                                            alignment: end;

                                            Button {
                                                height: Spacing.touch-target-min;
                                                text: "Unmute";
                                                variant: "secondary";

                                                clicked => {
                                                    root.role-picker-user = "";
                                                    root.set-member-muted(member.user-id, false, 0);
                                                }
                                            }
                                        }

                                        // Timed or until unmuted (minutes 0); the server lifts a timed mute.
                                        if member.can-mute && !member.muted: HorizontalLayout {
                                            spacing: Spacing.xs;
                                            alignment: end;

                                            for opt in root.mute-options: Button {
                                                height: Spacing.touch-target-min;
                                                text: opt.label;
                                                variant: "secondary";

                                                clicked => {
                                                    root.role-picker-user = "";
                                                    root.set-member-muted(member.user-id, true, opt.minutes);
                                                }
                                            }
                                        }

                                        if member.can-make-owner: HorizontalLayout {
                                            alignment: end;

                                            Button {
                                                height: Spacing.touch-target-min;
                                                text: "Make owner…";
                                                variant: "secondary";

                                                clicked => { root.confirm-action = "owner"; }
                                            }
                                        }

                                        if member.can-block: HorizontalLayout {
                                            alignment: end;

                                            Button {
                                                height: Spacing.touch-target-min;
                                                text: member.blocked ? "Unblock in group" : "Block in group";
                                                variant: "secondary";

                                                clicked => {
                                                    root.role-picker-user = "";
                                                    root.block-member(member.user-id, !member.blocked);
                                                }
                                            }
                                        }

                                        if (root.can-manage-members && member.role != "owner") || member.can-ban: HorizontalLayout {
                                            spacing: Spacing.xs;
                                            alignment: end;

                                            if root.can-manage-members && member.role != "owner": Button {
                                                height: Spacing.touch-target-min;
                                                text: "Remove";
                                                variant: "destructive";

                                                clicked => { root.confirm-action = "remove"; }
                                            }

                                            if member.can-ban: Button {
                                                height: Spacing.touch-target-min;
                                                text: "Ban";
                                                variant: "destructive";

                                                clicked => { root.confirm-action = "ban"; }
                                            }
                                        }
                                    }
                                }

                                // Bottom border
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Colors.divider;
                                }
                            }

                            // Banned users (owner/admin only — the roles that can unban).
                            if root.can-view-bans && root.banned-members.length > 0: Text {
                                text: "Banned";
                                color: Colors.text-primary;
                                font-size: Typography.base;
                                font-weight: Typography.semibold;
                            }

                            if root.can-view-bans: VerticalLayout {
                                for banned in root.banned-members: HorizontalLayout {
                                    height: 52px;
                                    spacing: Spacing.sm;
                                    padding: Spacing.xs;

                                    Avatar {
                                        size: 36px;
                                        source: banned.avatar-source;
                                        name: banned.display-name;
                                        fallback-text: "?";
                                    }

                                    Text {
                                        text: banned.display-name;
                                        color: Colors.text-secondary;
                                        font-size: Typography.sm;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: "Unban";
                                        variant: "secondary";
                                        clicked => { root.unban-member(banned.user-id); }
                                    }
                                }
                            }
                        }

                        // ========== Danger Zone Section ==========
                        if root.active-section == "destructive": VerticalLayout {
                            spacing: Spacing.md;

                            Text {
                                text: "Danger Zone";
                                color: Colors.error;
                                font-size: Typography.lg;
                                font-weight: Typography.semibold;
                            }

                            Rectangle {
                                height: 1px;
                                background: Colors.error.with-alpha(0.3);
                            }

                            // Every wrapped Text in these rows pins
                            // `height: self.preferred-height`: a HorizontalLayout
                            // (Slint 1.17) sizes the text column's height as if
                            // it had the whole row, so a description that wraps
                            // beside its button ran under the next row's title.
                            // The pin reads the height at the width it really got.

                            // Leave channel. Gated unconditionally, not just
                            // for private channels: leaving a private one has
                            // no rejoin path, and a control that is sometimes
                            // destructive and sometimes not, with no visual
                            // difference, is worse than one that always asks.
                            if root.can-leave && !root.show-leave-confirm: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text {
                                        text: root.is-private-group ? "Leave Group" : "Leave Channel";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                    Text {
                                        text: root.is-private-group ? "The group and its messages are removed from this device" : "You will lose access to this channel's messages";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                Button {
                                    height: Spacing.touch-target-min;
                                    text: "Leave";
                                    variant: "secondary";

                                    clicked => {
                                        root.show-leave-confirm = true;
                                    }
                                }
                            }

                            if root.can-leave && root.show-leave-confirm: VerticalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: root.is-private-group
                                        ? "Leave " + root.channel-name + "? You can only come back if a member invites you again."
                                        : "Leave #" + root.channel-name + "? You won't get new messages, and an invite-only channel cannot be rejoined on your own.";
                                    color: Colors.error;
                                    font-size: Typography.sm;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;

                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: "Cancel";
                                        variant: "secondary";
                                        clicked => {
                                            root.show-leave-confirm = false;
                                        }
                                    }

                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: root.is-private-group ? "Leave group" : "Leave channel";
                                        variant: "destructive";
                                        clicked => {
                                            root.show-leave-confirm = false;
                                            root.leave-channel();
                                        }
                                    }
                                }
                            }

                            // An owner may not leave while others remain (the
                            // server refuses it for a channel, core for a
                            // group), so say why the Leave row is missing and
                            // point at the way out: Members › ⋮ › Make owner.
                            if root.is-owner && (root.can-delete || (root.is-private-group && !root.can-leave)): HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text {
                                        text: "Transfer Ownership";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                    Text {
                                        text: root.is-private-group ? "Make another member the owner to leave." : "Transfer ownership to leave, or delete the channel.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                Button {
                                    height: Spacing.touch-target-min;
                                    text: "Transfer…";
                                    variant: "secondary";

                                    clicked => {
                                        root.active-section = "members";
                                    }
                                }
                            }

                            // Block this private group on this device: everything
                            // it sends is dropped until unblocked here.
                            if root.is-private-group: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text {
                                        text: root.group-blocked ? "Unblock Group" : "Block Group";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                    Text {
                                        text: root.group-blocked
                                            ? "Messages from this group are being dropped on this device"
                                            : "Drop everything this group sends, on this device";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                Button {
                                    height: Spacing.touch-target-min;
                                    text: root.group-blocked ? "Unblock" : "Block";
                                    variant: root.group-blocked ? "secondary" : "destructive";

                                    clicked => { root.block-group(!root.group-blocked); }
                                }
                            }

                            // Archive channel
                            if root.can-archive: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text {
                                        text: root.is-archived ? "Unarchive Channel" : "Archive Channel";
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                    Text {
                                        text: root.is-archived ? "Make channel active again" : "Archive to hide from active channels";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                Button {
                                    height: Spacing.touch-target-min;
                                    text: root.is-archived ? "Unarchive" : "Archive";
                                    variant: "secondary";

                                    clicked => {
                                        root.archive-channel();
                                    }
                                }
                            }

                            // Delete channel. H3: the one irreversible action
                            // in this modal was a single click on a button
                            // sitting in the same row rhythm as "Archive" —
                            // one slip and the channel and every message in it
                            // are gone. Same two-step reveal Settings uses for
                            // Delete Account (settings_screen.slint
                            // `show-delete-confirm`): the first click only
                            // asks, and the answer defaults to Cancel.
                            if root.can-delete && !root.show-delete-confirm: HorizontalLayout {
                                spacing: Spacing.sm;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Text {
                                        text: "Delete Channel";
                                        color: Colors.error;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                    Text {
                                        text: "Deletes the channel and all its messages. Can't be undone.";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                Button {
                                    height: Spacing.touch-target-min;
                                    text: "Delete";
                                    variant: "destructive";

                                    clicked => {
                                        root.show-delete-confirm = true;
                                    }
                                }
                            }

                            if root.can-delete && root.show-delete-confirm: VerticalLayout {
                                spacing: Spacing.sm;

                                Text {
                                    text: "Delete \"" + root.channel-name + "\" permanently? Every message in it goes with it. This cannot be undone.";
                                    color: Colors.error;
                                    font-size: Typography.sm;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.sm;

                                    // Cancel first, and it is the non-danger
                                    // variant: the safe answer is the one the
                                    // eye and the thumb land on.
                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: "Cancel";
                                        variant: "secondary";
                                        clicked => {
                                            root.show-delete-confirm = false;
                                        }
                                    }

                                    Button {
                                        height: Spacing.touch-target-min;
                                        text: "Delete channel";
                                        variant: "destructive";
                                        clicked => {
                                            root.show-delete-confirm = false;
                                            root.delete-channel();
                                        }
                                    }
                                }
                            }
                        }


                    }
                }
            }
        }
    }
}
