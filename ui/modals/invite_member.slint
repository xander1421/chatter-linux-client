// InviteMemberModal - Modal for inviting users to a channel

import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Icons } from "../theme/icons.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";

// User struct for invite targets
export struct InviteUser {
    id: string,
    display-name: string,
    username: string,
    avatar-source: image,
    has-avatar: bool,
    already-member: bool,
    banned: bool,
    selected: bool,
}

export component InviteMemberModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> channel-name: "";
    in property <bool> private-channel: false;
    in-out property <string> search-text: "";
    in-out property <[InviteUser]> users: [];
    in-out property <int> selected-count: 0;
    in property <bool> loading: false;

    callback close();
    callback toggle-user(int);  // index - toggles selection
    callback invite();  // confirms invite for all selected users
    callback search-changed(string);  // fired on every keystroke so backend can search

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            search-text = "";
        }
    }

    Modal {
        show: root.show-modal;
        title: "Invite members";
        modal-width: 480px;
        max-modal-height: 640px;
        fill-height: true;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // Header text showing channel name
            HorizontalLayout {
                spacing: Spacing.xs;
                alignment: start;
                Text {
                    text: "Invite to";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.private-channel ? Icons.lock : Icons.hash;
                        width: 16px;
                        height: 16px;
                        colorize: Colors.text-secondary;
                        accessible-label: root.private-channel ? "Private channel" : "Public channel";
                    }
                }
                Text {
                    text: root.channel-name;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            // Search input
            Input {
                placeholder: "Search by name or username...";
                text <=> root.search-text;
                edited(q) => { root.search-changed(q); }
            }

            // User list (scrollable)
            Rectangle {
                min-height: 200px;
                vertical-stretch: 1;
                background: Colors.surface;
                border-radius: Spacing.radius-md;

                Flickable {
                    viewport-height: user-list.preferred-height;
                    viewport-width: parent.width;

                    user-list := VerticalLayout {
                        padding: Spacing.xs;

                        for user[index] in root.users: Rectangle {
                            // Members and banned users can't be invited.
                            property <bool> unavailable: user.already-member || user.banned;
                            height: max(52px, Spacing.touch-target-min);
                            accessible-role: checkbox;
                            accessible-label: user.display-name
                                + (user.banned ? ", banned" : user.already-member ? ", already a member" : "");
                            accessible-checkable: !unavailable;
                            accessible-checked: user.selected;
                            accessible-enabled: !unavailable;
                            accessible-action-default => { if !unavailable { root.toggle-user(index); } }
                            background: unavailable ? transparent :
                                (user-touch.pressed ? Materials.pressed : user-touch.has-hover ? Colors.surface-hover : transparent);
                            border-radius: Spacing.radius-md;
                            opacity: unavailable ? 0.5 : 1.0;
                            transform-scale-x: user-touch.pressed ? 0.97 : 1;
                            transform-scale-y: user-touch.pressed ? 0.94 : 1;
                            animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                            animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                            animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                spacing: Spacing.sm;

                                // Avatar
                                Avatar {
                                    size: 36px;
                                    y: (parent.height - self.height) / 2;
                                    source: user.has-avatar ? user.avatar-source : @image-url("");
                                    name: user.display-name;
                                }

                                // Name and username
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: Spacing.xxs;

                                    Text {
                                        text: user.display-name;
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                        overflow: elide;
                                    }

                                    if user.username != "": Text {
                                        text: "@" + user.username;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        overflow: elide;
                                    }
                                }

                                // Member / Banned badge
                                if unavailable: Rectangle {
                                    width: member-text.width + Spacing.sm * 2;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    background: Colors.text-muted.with-alpha(0.2);
                                    border-radius: Spacing.radius-sm;

                                    member-text := Text {
                                        x: Spacing.sm;
                                        text: user.banned ? "Banned" : "Member";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        vertical-alignment: center;
                                        height: 100%;
                                    }
                                }

                                // Checkbox (only for invitable users)
                                if !unavailable: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Spacing.radius-sm;
                                    border-width: user.selected ? 0px : Spacing.stroke;
                                    border-color: Colors.text-muted;
                                    background: user.selected ? Colors.action-fill : transparent;

                                    // Checkmark (shown when selected) — the bundled SVG, as
                                    // components/checkbox.slint draws it; ✓ was a tofu risk.
                                    if user.selected: Image {
                                        source: Icons.check;
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Colors.on-action;
                                    }
                                }
                            }

                            user-touch := TouchArea {
                                enabled: !unavailable;
                                mouse-cursor: unavailable ? default : pointer;

                                clicked => {
                                    if !unavailable {
                                        root.toggle-user(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Footer with action buttons
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Cancel button
                Button {
                    text: "Cancel";
                    variant: "secondary";

                    clicked => {
                        root.close();
                    }
                }

                // Invite button
                Button {
                    text: root.loading ? "" :
                        (root.selected-count == 0 ? "Invite" :
                         root.selected-count == 1 ? "Invite 1 user" :
                         "Invite " + root.selected-count + " users");
                    variant: "primary";
                    disabled: root.selected-count == 0 || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.selected-count > 0 && !root.loading {
                            root.invite();
                        }
                    }
                }
            }
        }
    }
}
