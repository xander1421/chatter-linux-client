// InviteMemberModal - Modal for inviting users to a channel

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";

// User struct for invite targets
export struct InviteUser {
    id: string,
    display-name: string,
    username: string,
    avatar-url: string,
    already-member: bool,
    selected: bool,
}

export component InviteMemberModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> channel-name: "";
    in-out property <string> search-text: "";
    in-out property <[InviteUser]> users: [];
    in-out property <int> selected-count: 0;
    in property <bool> loading: false;

    callback close();
    callback toggle-user(int);  // index - toggles selection
    callback invite();  // confirms invite for all selected users
    callback search-changed(string);  // fired on every keystroke so backend can search

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            search-text = "";
        }
    }

    Modal {
        show: root.show-modal;
        title: "Invite Members";
        modal-width: 480px;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // Header text showing channel name
            Text {
                text: "Invite to #" + root.channel-name;
                color: Colors.text-secondary;
                font-size: Typography.sm;
            }

            // Search input
            Input {
                placeholder: "Search by name or username...";
                text <=> root.search-text;
                edited(q) => { root.search-changed(q); }
            }

            // User list (scrollable)
            Rectangle {
                min-height: 200px;
                max-height: 300px;
                vertical-stretch: 1;
                background: Colors.surface;
                border-radius: Spacing.radius-md;
                border-width: 1px;
                border-color: Colors.text-muted.with-alpha(0.2);

                Flickable {
                    viewport-height: user-list.preferred-height;
                    viewport-width: parent.width;

                    user-list := VerticalLayout {
                        padding: Spacing.xs;

                        for user[index] in root.users: Rectangle {
                            height: 52px;
                            background: user.already-member ? transparent :
                                (user-touch.has-hover ? Colors.surface-hover : transparent);
                            border-radius: Spacing.radius-md;
                            opacity: user.already-member ? 0.5 : 1.0;

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                spacing: Spacing.sm;

                                // Avatar
                                Avatar {
                                    size: 36px;
                                    fallback-text: user.display-name;
                                }

                                // Name and username
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: user.display-name;
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: "@" + user.username;
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        overflow: elide;
                                    }
                                }

                                // Already member badge
                                if user.already-member: Rectangle {
                                    width: member-text.width + Spacing.sm * 2;
                                    height: 20px;
                                    background: Colors.text-muted.with-alpha(0.2);
                                    border-radius: Spacing.radius-sm;

                                    member-text := Text {
                                        x: Spacing.sm;
                                        text: "Member";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        vertical-alignment: center;
                                        height: 100%;
                                    }
                                }

                                // Checkbox (only for non-members)
                                if !user.already-member: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: Spacing.radius-sm;
                                    border-width: user.selected ? 0 : 2px;
                                    border-color: Colors.text-muted;
                                    background: user.selected ? Colors.primary : transparent;

                                    // Checkmark (shown when selected)
                                    if user.selected: Text {
                                        text: "\u{2713}";
                                        color: Colors.text-primary;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }

                            user-touch := TouchArea {
                                enabled: !user.already-member;
                                mouse-cursor: user.already-member ? default : pointer;

                                clicked => {
                                    if !user.already-member {
                                        root.toggle-user(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Footer with action buttons
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Cancel button
                Button {
                    text: "Cancel";
                    variant: "secondary";

                    clicked => {
                        root.close();
                    }
                }

                // Invite button
                Button {
                    text: root.loading ? "" :
                        (root.selected-count == 0 ? "Invite" :
                         root.selected-count == 1 ? "Invite 1 user" :
                         "Invite " + root.selected-count + " users");
                    variant: "primary";
                    disabled: root.selected-count == 0 || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.selected-count > 0 && !root.loading {
                            root.invite();
                        }
                    }
                }
            }
        }
    }
}
