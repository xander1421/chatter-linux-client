import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { UserSearchData } from "friends_data.slint";

// Add-friend tab = the code/QR exchange, nothing else. Finding people by name
// or @handle lives in global search (the header Search); this tab is for
// "let someone add me" (your QR is the hero) and "add someone who shared a
// code" (scan / paste). Shield on → the private code starts a secret chat.
export component FindTab inherits VerticalLayout {
    in property <string> active-tab;
    in property <bool> mobile-mode;
    in property <bool> can-scan;
    in property <bool> loading;
    in-out property <string> code-input;
    in property <int> code-caret-end-seq;
    in property <string> code-status;
    in property <string> my-code;
    in-out property <string> request-note;
    in property <image> qr-code-image;
    in-out property <bool> show-qr;
    in property <bool> effective-private-mode;
    // Kept for host bindings; name search now lives in global search, not here.
    in-out property <string> search-query;
    in property <bool> search-active;
    in property <bool> search-performed;
    in property <UserSearchData> search-result;
    callback search-changed(string);
    callback add-searched-friend(string);
    callback generate-code(bool);
    callback generate-qr(bool);
    callback copy-code();
    callback paste-code();
    callback scan-code();
    callback connect-via-code(string);
    callback code-edited();
    callback close-add();   // the sheet's Back / dismiss

    // Make the QR the hero: generate the code + QR as soon as the tab exists,
    // so it is shown on open, not after a tap.
    function ensure-code() {
        if (root.my-code == "") { root.generate-code(root.effective-private-mode); }
        if (!root.show-qr) { root.generate-qr(root.effective-private-mode); }
    }

    vertical-stretch: 1;

    VerticalLayout {
        init => { root.ensure-code(); }
        vertical-stretch: 1;
        spacing: Spacing.md;

        HorizontalLayout {
            spacing: Spacing.sm;
            Button {
                touch: root.mobile-mode;
                text: "Back";
                variant: "ghost";
                clicked => { root.close-add(); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.effective-private-mode ? "Start a secret chat" : "Add a friend";
                color: Colors.text-primary;
                font-size: Typography.lg;
                font-weight: Typography.bold;
                vertical-alignment: center;
            }
        }

        // ===== QR hero =====
        Rectangle {
            background: Colors.surface;
            border-radius: Spacing.radius-lg;
            drop-shadow-blur: Elevation.card-blur;
            drop-shadow-offset-y: Elevation.card-offset;
            drop-shadow-color: Elevation.card-shadow;
            border-width: Elevation.rim-width;
            border-color: Elevation.card-rim;

            VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.md;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 240px;
                        height: 240px;
                        background: white;
                        border-radius: Spacing.radius-md;
                        Image {
                            source: root.qr-code-image;
                            width: 212px;
                            height: 212px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                        }
                        // Placeholder ring until the QR renders.
                        if !root.show-qr || root.my-code == "": Text {
                            text: "…";
                            color: #999;
                            font-size: Typography.huge;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // The code itself, selectable, with copy / refresh.
                Rectangle {
                    height: 40px;
                    background: Colors.inset;
                    border-radius: Spacing.radius-sm;
                    HorizontalLayout {
                        padding-left: Spacing.sm;
                        padding-right: Spacing.sm;
                        Text {
                            text: root.my-code != "" ? root.my-code : "Creating your code…";
                            color: root.my-code != "" ? Colors.text-primary : Colors.text-muted;
                            font-size: Typography.xs;
                            font-family: Typography.font-family-mono;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Spacing.sm;
                    Button {
                        touch: root.mobile-mode;
                        horizontal-stretch: 1;
                        text: "Copy code";
                        variant: "primary";
                        clicked => { root.copy-code(); }
                    }
                    Button {
                        touch: root.mobile-mode;
                        text: "Refresh";
                        variant: "ghost";
                        clicked => {
                            root.generate-code(root.effective-private-mode);
                            root.generate-qr(root.effective-private-mode);
                        }
                    }
                }

                Text {
                    width: max(0px, parent.width - parent.padding * 2);
                    text: root.effective-private-mode
                        ? "Friends scan this or paste your code to start a secret chat with you."
                        : "Friends scan this or paste your code to add you.";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }
            }
        }

        // ===== Add someone who shared a code =====
        Text {
            text: "Add someone";
            color: Colors.text-secondary;
            font-size: Typography.xs;
            font-weight: Typography.medium;
        }

        HorizontalLayout {
            spacing: Spacing.sm;
            Input {
                horizontal-stretch: 1;
                placeholder: "Paste a code or invite link";
                text <=> root.code-input;
                caret-end-seq: root.code-caret-end-seq;
                edited => { root.code-edited(); }
                accepted(code) => { root.connect-via-code(code); }
            }
            Button {
                touch: root.mobile-mode;
                text: "Paste";
                variant: "ghost";
                clicked => { root.paste-code(); }
            }
            Button {
                touch: root.mobile-mode;
                text: "Connect";
                variant: "primary";
                loading: root.loading;
                clicked => { root.connect-via-code(root.code-input); }
            }
        }

        if root.can-scan: Button {
            touch: root.mobile-mode;
            horizontal-stretch: 1;
            text: "Scan a QR code";
            variant: "secondary";
            clicked => { root.scan-code(); }
        }

        if root.code-status != "": Text {
            text: root.code-status;
            color: (root.code-status == "Friend request sent!" || root.code-status == "Secret chat started!" || root.code-status == "Copied to clipboard!") ? Colors.success :
                   (root.code-status == "Pasted from clipboard" || root.code-status == "Secret chat is getting ready…" || root.code-status == "Connecting…") ? Colors.text-secondary : Colors.error;
            font-size: Typography.xs;
            wrap: word-wrap;
            height: self.preferred-height;
        }

        Rectangle { vertical-stretch: 1; }
    }
}
