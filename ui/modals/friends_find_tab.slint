import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { UserSearchData } from "friends_data.slint";

// Add-friend tab. Identity-first: search a name or @handle (exact match,
// no enumeration — the privacy model invite-member already uses) and add from
// a person preview. Adding by code / showing your own code is the secondary,
// "let someone add me" path below. In Shield, a new contact is a secret chat
// over Tor; that is the only thing that changes, driven by the global toggle.
export component FindTab inherits VerticalLayout {
    in property <string> active-tab;
    in property <bool> mobile-mode;
    in property <bool> can-scan;
    in property <bool> loading;
    in-out property <string> code-input;
    in property <int> code-caret-end-seq;
    in property <string> code-status;
    in property <string> my-code;
    in-out property <string> request-note;
    in property <image> qr-code-image;
    in-out property <bool> show-qr;
    in property <bool> effective-private-mode;
    // Username-first search.
    in-out property <string> search-query;
    in property <bool> search-active;
    in property <bool> search-performed;
    in property <UserSearchData> search-result;
    callback search-changed(string);
    callback add-searched-friend(string);  // user_id
    callback generate-code(bool);
    callback generate-qr(bool);
    callback copy-code();
    callback paste-code();
    callback scan-code();
    callback connect-via-code(string);
    callback code-edited();
    vertical-stretch: 1;

    if root.active-tab == "find": VerticalLayout {
        vertical-stretch: 1;
        spacing: Spacing.md;

        // ===== Hero: find someone by name / @handle =====
        // Shield OFF only: anon mode forbids username lookup (no account link),
        // so in Shield the private-code / secret-chat path below is the way.
        if !root.effective-private-mode: Rectangle {
            vertical-stretch: 0;
            background: Colors.surface;
            border-radius: Spacing.radius-md;
            drop-shadow-blur: Elevation.card-blur;
            drop-shadow-offset-y: Elevation.card-offset;
            drop-shadow-color: Elevation.card-shadow;
            border-width: Elevation.rim-width;
            border-color: Elevation.card-rim;

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.sm;

                Input {
                    horizontal-stretch: 1;
                    placeholder: root.effective-private-mode ? "Search a name or @handle" : "Search a name or @handle";
                    text <=> root.search-query;
                    edited => { root.search-changed(root.search-query); }
                    accepted(q) => { root.search-changed(q); }
                }

                // Result: one exact match → a person you can add.
                if root.search-result.user-id != "": Rectangle {
                    background: Colors.inset;
                    border-radius: Spacing.radius-sm;

                    HorizontalLayout {
                        padding: Spacing.sm;
                        spacing: Spacing.sm;

                        Avatar {
                            size: 40px;
                            source: root.search-result.avatar-source;
                            fallback-text: root.search-result.initials;
                            name: root.search-result.display-name;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Spacing.xxs;

                            Text {
                                text: root.search-result.display-name;
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                font-weight: Typography.semibold;
                                overflow: elide;
                            }

                            Text {
                                text: "@" + root.search-result.username;
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                overflow: elide;
                            }
                        }

                        // Already friends / pending → a quiet status chip.
                        // Otherwise the one action: add (or start a secret chat
                        // when Shield is on).
                        if root.search-result.is-friend || root.search-result.request-sent: Text {
                            text: root.search-result.is-friend ? "Already friends" : "Request sent";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                        }
                        if !root.search-result.is-friend && !root.search-result.request-sent: Button {
                            touch: root.mobile-mode;
                            text: "Add friend";
                            variant: "primary";
                            loading: root.loading;
                            clicked => { root.add-searched-friend(root.search-result.user-id); }
                        }
                    }
                }

                if root.search-result.user-id == "" && root.search-active: Text {
                    text: "Searching…";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                }

                if root.search-result.user-id == "" && !root.search-active
                        && root.search-performed && root.search-query != "": Text {
                    width: max(0px, parent.width - parent.padding * 2);
                    text: "No one found for “" + root.search-query + "”. Check the handle, or add by code below.";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

            }
        }

        // ===== Shield hero: secret chats use a private code =====
        if root.effective-private-mode: Rectangle {
            vertical-stretch: 0;
            background: Colors.surface;
            border-radius: Spacing.radius-md;
            drop-shadow-blur: Elevation.card-blur;
            drop-shadow-offset-y: Elevation.card-offset;
            drop-shadow-color: Elevation.card-shadow;
            border-width: Elevation.rim-width;
            border-color: Elevation.card-rim;

            VerticalLayout {
                padding: Spacing.md;
                spacing: Spacing.xs;

                Text {
                    text: "Start a secret chat";
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    font-weight: Typography.semibold;
                }

                Text {
                    width: max(0px, parent.width - parent.padding * 2);
                    text: "Shield is on. Secret chats are anonymous over Tor and use a private code — share yours below, or paste a friend's.";
                    color: Colors.text-secondary;
                    font-size: Typography.xs;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }
            }
        }

        Rectangle { height: 1px; background: Colors.divider; }

        // ===== Secondary: add by code, or share your own =====
        VerticalLayout {
            spacing: Spacing.sm;

            Text {
                text: "Add by code or link";
                color: Colors.text-secondary;
                font-size: Typography.xs;
                font-weight: Typography.medium;
            }

            Input {
                horizontal-stretch: 1;
                placeholder: "Paste a friend code or invite link";
                text <=> root.code-input;
                caret-end-seq: root.code-caret-end-seq;
                edited => { root.code-edited(); }
                accepted(code) => { root.connect-via-code(code); }
            }

            HorizontalLayout {
                spacing: Spacing.sm;

                Button {
                    touch: root.mobile-mode;
                    horizontal-stretch: 1;
                    text: "Paste";
                    variant: "ghost";
                    clicked => { root.paste-code(); }
                }

                Button {
                    touch: root.mobile-mode;
                    horizontal-stretch: 1;
                    text: "Connect";
                    variant: "secondary";
                    loading: root.loading;
                    clicked => { root.connect-via-code(root.code-input); }
                }
            }

            if root.code-status != "": Text {
                width: max(0px, parent.width - parent.padding * 2);
                text: root.code-status;
                color: (root.code-status == "Friend request sent!" || root.code-status == "Secret chat started!") ? Colors.success :
                       (root.code-status == "Copied to clipboard!" || root.code-status == "Pasted from clipboard"
                        || root.code-status == "Secret chat is getting ready…" || root.code-status == "Connecting…"
                        || root.code-status == "Code scanned — tap connect"
                        || root.code-status == "Code scanned — tap Connect to send the request"
                        || root.code-status == "Chatter uses the camera only to read your friend's QR code.") ? Colors.text-secondary : Colors.error;
                font-size: Typography.xs;
                wrap: word-wrap;
                height: self.preferred-height;
            }

            Input {
                placeholder: "Add a note (optional)";
                text <=> root.request-note;
            }

            if root.can-scan: Button {
                touch: root.mobile-mode;
                horizontal-stretch: 1;
                text: "Scan a friend's QR code";
                variant: "ghost";
                clicked => { root.scan-code(); }
            }
        }

        Rectangle { height: 1px; background: Colors.divider; }

        // ===== Your code (so others can add you) =====
        VerticalLayout {
            spacing: Spacing.xs;

            Text {
                text: "Your code";
                color: Colors.text-secondary;
                font-size: Typography.xs;
                font-weight: Typography.medium;
            }

            Rectangle {
                height: 36px;
                background: Colors.inset;
                border-radius: Spacing.radius-sm;

                HorizontalLayout {
                    padding-left: Spacing.sm;
                    padding-right: Spacing.sm;

                    Text {
                        text: root.my-code != "" ? root.my-code : "Tap Get code to create yours";
                        color: root.my-code != "" ? Colors.text-primary : Colors.text-muted;
                        font-size: Typography.xs;
                        font-family: Typography.font-family-mono;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: Spacing.xs;

                Button {
                    touch: root.mobile-mode;
                    text: root.my-code == "" ? "Get code" : "Refresh";
                    variant: "ghost";
                    horizontal-stretch: 1;
                    clicked => { root.generate-code(root.effective-private-mode); }
                }

                if root.my-code != "": Button {
                    touch: root.mobile-mode;
                    text: "Copy";
                    variant: "ghost";
                    horizontal-stretch: 1;
                    clicked => { root.copy-code(); }
                }

                if root.my-code != "": Button {
                    touch: root.mobile-mode;
                    text: root.show-qr ? "Hide QR" : "Show QR";
                    variant: "ghost";
                    horizontal-stretch: 1;
                    clicked => {
                        if (!root.show-qr) { root.generate-qr(root.effective-private-mode); }
                        else { root.show-qr = false; }
                    }
                }
            }

            if root.show-qr && root.my-code != "": Rectangle {
                background: Colors.inset;
                border-radius: Spacing.radius-md;

                VerticalLayout {
                    alignment: center;
                    padding: Spacing.md;
                    spacing: Spacing.sm;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 168px;
                            height: 168px;
                            background: white;
                            border-radius: Spacing.radius-sm;

                            Image {
                                source: root.qr-code-image;
                                width: 150px;
                                height: 150px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                            }
                        }
                    }

                    Text {
                        text: root.effective-private-mode ? "Scan to start a secret chat" : "Scan to add as a friend";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Fill remaining space so the content sits at the top, not stretched.
        Rectangle { vertical-stretch: 1; }
    }
}
