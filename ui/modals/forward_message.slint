// ForwardMessageModal - Modal for forwarding messages to channels or DMs

import { KeyFocus } from "../components/key_focus.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Icons } from "../theme/icons.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";

// Target struct for forward destinations
export struct ForwardTarget {
    id: string,
    name: string,
    avatar-source: image,
    is-anonymous: bool,
    target-type: string,  // "channel", "group", "dm", or "anon-dm"
    // Invite-only channel: drawn with the chat list's lock, not '#'.
    private-channel: bool,
}

export component ForwardMessageModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> message-preview: "";
    in property <bool> contact-share: false;
    in property <string> contact-name: "";
    in property <image> contact-avatar;
    in-out property <string> search-text: "";
    in property <[ForwardTarget]> targets: [];
    in property <bool> loading: false;

    callback close();
    callback forward(string);  // target_id
    callback search-changed(string);

    // Internal state
    property <string> selected-target-id: "";

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            selected-target-id = "";
            search-text = "";
        }
    }

    Modal {
        show: root.show-modal;
        title: root.contact-share ? @tr("Share contact") : @tr("Forward");
        modal-width: 480px;
        // The list takes the spare height and the buttons stay pinned: sized
        // to content, preview + search + a 300px list overran the 600px cap
        // and the Forward button was cut off at the bottom of a phone sheet.
        max-modal-height: 640px;
        fill-height: true;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // Message preview section
            Rectangle {
                height: 80px;
                background: Colors.surface-card;
                border-radius: Spacing.radius-panel;

                if root.contact-share: HorizontalLayout {
                    padding: Spacing.md;
                    spacing: Spacing.md;

                    Avatar { size: 48px; name: root.contact-name; source: root.contact-avatar; }
                    Text {
                        text: root.contact-name;
                        vertical-alignment: center;
                        color: Colors.text-primary;
                        font-size: Typography.base;
                        font-weight: Typography.semibold;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                if !root.contact-share: VerticalLayout {
                    padding: Spacing.md;

                    Text {
                        text: @tr("Forwarding:");
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                    }

                    Text {
                        text: root.message-preview;
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        overflow: elide;
                        vertical-stretch: 1;
                    }
                }
            }

            // Search input. The narrowing happens in core — this only reports
            // what was typed; the modal never filters `targets` itself.
            Input {
                inset-control: true;
                placeholder: @tr("Search channels or people...");
                text <=> root.search-text;
                edited(query) => {
                    root.search-changed(query);
                }
            }

            // Target list (scrollable)
            Rectangle {
                min-height: 160px;
                vertical-stretch: 1;
                background: Colors.surface-card;
                border-radius: Spacing.radius-panel;

                Flickable {
                    viewport-height: target-list.preferred-height;
                    viewport-width: parent.width;

                    target-list := VerticalLayout {
                        padding: Spacing.sm;

                        for target[index] in root.targets: Rectangle {
                            // Note: Search filtering is done in Rust before passing to UI
                            property <bool> is-selected: root.selected-target-id == target.id;

                            height: 48px * Appearance.text-grow;
                            background: is-selected ? Colors.tint-strong : target-touch.pressed ? Materials.pressed : target-touch.has-hover ? Materials.hover : transparent;
                            border-radius: Spacing.radius-control;
                            transform-scale-x: target-touch.pressed ? 97% : 100%;
                            transform-scale-y: target-touch.pressed ? 94% : 100%;
                            animate transform-scale-x { duration: target-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                            animate transform-scale-y { duration: target-touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                            animate background { duration: Materials.motion-quick; easing: Materials.glide; }
                            accessible-role: list-item;
                            accessible-label: target.name;
                            accessible-item-selected: is-selected;
                            accessible-action-default => { root.selected-target-id = target.id; }
                            KeyFocus { border-radius: parent.border-radius; activate => { root.selected-target-id = target.id; } }

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                // Row is 48px; 8px top/bottom leaves exactly the
                                // 32px avatar, so it and the name are centred.
                                padding-top: Spacing.sm;
                                padding-bottom: Spacing.sm;
                                spacing: Spacing.sm;

                                // Avatar
                                // Saved messages wears its bookmark, as in the chat list.
                                if target.target-type == "saved_messages": Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: transparent;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    Image {
                                        source: Icons.bookmark;
                                        width: 16px;
                                        height: 16px;
                                        colorize: Colors.text-secondary;
                                    }
                                }
                                // An iconless channel wears the chat list's type
                                // glyph (lock = private, '#' = public), not a
                                // letter avatar.
                                if target.target-type == "channel" && target.avatar-source.width == 0: Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: transparent;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    Image {
                                        source: target.private-channel ? Icons.lock : Icons.hash;
                                        width: 16px;
                                        height: 16px;
                                        colorize: Colors.text-secondary;
                                    }
                                }
                                if target.target-type != "saved_messages" && !(target.target-type == "channel" && target.avatar-source.width == 0): Avatar {
                                    size: 32px;
                                    name: target.name;
                                    source: target.avatar-source;
                                    anonymous: target.is-anonymous;
                                }

                                // Name and type
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        accessible-role: none;
                                        text: target.name;
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                        overflow: elide;
                                    }
                                }

                                // Type badge (none for Saved Messages: it is not a DM)
                                if target.target-type != "saved_messages": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: type-text.width + Spacing.sm * 2;
                                        height: 20px;
                                        background: target.target-type == "channel" || target.target-type == "group" || target.target-type == "anon_group" ? Colors.surface-control : Colors.success.with-alpha(0.2);
                                        border-radius: Spacing.radius-sm;

                                        type-text := Text {
                                            x: Spacing.sm;
                                            text: target.target-type == "channel" ? @tr("Channel") : target.target-type == "group" || target.target-type == "anon_group" ? @tr("Group") : target.is-anonymous ? @tr("chat type" => "Secret") : @tr("DM");
                                            color: target.target-type == "channel" || target.target-type == "group" || target.target-type == "anon_group" ? Colors.text-secondary : Colors.success;
                                            font-size: Typography.xs;
                                            font-weight: Typography.medium;
                                            vertical-alignment: center;
                                            height: 100%;
                                        }
                                    }
                                }

                                // Selection indicator
                                if is-selected: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: Colors.action-fill;

                                    // The bundled check, as components/checkbox.slint
                                    // draws it; a text ✓ is a tofu risk.
                                    Image {
                                        source: Icons.check;
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Colors.on-action;
                                    }
                                }
                            }

                            target-touch := TouchArea {
                                clicked => {
                                    root.selected-target-id = target.id;
                                }
                            }
                        }
                    }
                }
            }

            // Footer with action buttons
            HorizontalLayout {
                spacing: Spacing.md;

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Cancel button
                Button {
                    border-radius: Spacing.radius-control;
                    text: @tr("Cancel");
                    variant: "secondary";

                    clicked => {
                        root.close();
                    }
                }

                // Confirm button
                Button {
                    border-radius: Spacing.radius-control;
                    text: root.loading ? "" : root.contact-share ? @tr("Share") : @tr("Forward");
                    variant: "primary";
                    disabled: root.selected-target-id == "" || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.selected-target-id != "" && !root.loading {
                            root.forward(root.selected-target-id);
                        }
                    }
                }
            }
        }
    }
}
