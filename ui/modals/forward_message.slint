// ForwardMessageModal - Modal for forwarding messages to channels or DMs

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";

// Target struct for forward destinations
export struct ForwardTarget {
    id: string,
    name: string,
    target-type: string,  // "channel", "group", "dm", or "anon-dm"
}

export component ForwardMessageModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> message-preview: "";
    in-out property <string> search-text: "";
    in property <[ForwardTarget]> targets: [];
    in property <bool> loading: false;

    callback close();
    callback forward(string);  // target_id
    callback search-changed(string);

    // Internal state
    property <string> selected-target-id: "";

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            selected-target-id = "";
            search-text = "";
        }
    }

    Modal {
        show: root.show-modal;
        title: "Forward Message";
        modal-width: 480px;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // Message preview section
            Rectangle {
                height: 80px;
                background: Colors.surface-hover;
                border-radius: Spacing.radius-md;

                VerticalLayout {
                    padding: Spacing.md;

                    Text {
                        text: "Forwarding:";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                    }

                    Text {
                        text: root.message-preview;
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        overflow: elide;
                        vertical-stretch: 1;
                    }
                }
            }

            // Search input. The narrowing happens in core — this only reports
            // what was typed; the modal never filters `targets` itself.
            Input {
                placeholder: "Search channels or people...";
                text <=> root.search-text;
                edited(query) => {
                    root.search-changed(query);
                }
            }

            // Target list (scrollable)
            Rectangle {
                min-height: 200px;
                max-height: 300px;
                vertical-stretch: 1;
                background: Colors.surface;
                border-radius: Spacing.radius-md;
                border-width: 1px;
                border-color: Colors.text-muted.with-alpha(0.2);

                Flickable {
                    viewport-height: target-list.preferred-height;
                    viewport-width: parent.width;

                    target-list := VerticalLayout {
                        padding: Spacing.xs;

                        for target[index] in root.targets: Rectangle {
                            // Note: Search filtering is done in Rust before passing to UI
                            property <bool> is-selected: root.selected-target-id == target.id;

                            height: 48px;
                            background: is-selected ? Colors.primary.with-alpha(0.2) : target-touch.has-hover ? Colors.surface-hover : transparent;
                            border-radius: Spacing.radius-md;

                            HorizontalLayout {
                                padding-left: Spacing.sm;
                                padding-right: Spacing.sm;
                                spacing: Spacing.sm;

                                // Avatar
                                Avatar {
                                    size: 32px;
                                    name: target.name;
                                }

                                // Name and type
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: target.name;
                                        color: Colors.text-primary;
                                        font-size: Typography.sm;
                                        font-weight: Typography.medium;
                                        overflow: elide;
                                    }
                                }

                                // Type badge
                                Rectangle {
                                    width: type-text.width + Spacing.sm * 2;
                                    height: 20px;
                                    background: target.target-type == "channel" || target.target-type == "group" ? Colors.primary.with-alpha(0.2) : Colors.success.with-alpha(0.2);
                                    border-radius: Spacing.radius-sm;

                                    type-text := Text {
                                        x: Spacing.sm;
                                        text: target.target-type == "channel" ? "#channel" : target.target-type == "group" ? "#group" : "DM";
                                        color: target.target-type == "channel" || target.target-type == "group" ? Colors.primary : Colors.success;
                                        font-size: Typography.xs;
                                        font-weight: Typography.medium;
                                        vertical-alignment: center;
                                        height: 100%;
                                    }
                                }

                                // Selection indicator
                                if is-selected: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: Colors.primary;

                                    // Checkmark using Unicode
                                    Text {
                                        text: "\u{2713}";
                                        color: Colors.text-primary;
                                        font-size: Typography.xs;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }

                            target-touch := TouchArea {
                                clicked => {
                                    root.selected-target-id = target.id;
                                }
                            }
                        }
                    }
                }
            }

            // Footer with action buttons
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Cancel button
                Button {
                    text: "Cancel";
                    variant: "secondary";

                    clicked => {
                        root.close();
                    }
                }

                // Forward button
                Button {
                    text: root.loading ? "" : "Forward";
                    variant: "primary";
                    disabled: root.selected-target-id == "" || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.selected-target-id != "" && !root.loading {
                            root.forward(root.selected-target-id);
                        }
                    }
                }
            }
        }
    }
}
