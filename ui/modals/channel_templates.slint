// ChannelTemplates component - Grid of channel template cards for selection

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";

// Individual template card with proper icon
component TemplateCard inherits Rectangle {
    in property <string> template-id;
    in property <string> name;
    in property <string> description;
    in property <image> icon;
    in property <color> accent-color;
    in property <bool> selected: false;

    callback clicked();

    property <bool> hovered: touch.has-hover;

    height: 110px;
    border-radius: Spacing.radius-lg;
    background: Colors.surface;
    border-width: selected ? 2px : 1px;
    border-color: selected ? accent-color : Colors.text-muted.with-alpha(0.2);

    // Subtle gradient overlay on hover
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Spacing.radius-lg;
        background: hovered ? accent-color.with-alpha(0.05) : transparent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        // Icon container with colored background
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: Spacing.radius-md;
            background: accent-color.with-alpha(0.15);

            Image {
                source: icon;
                width: 24px;
                height: 24px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: accent-color;
            }
        }

        // Text content
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Spacing.xs;

            Text {
                text: name;
                color: selected ? accent-color : Colors.text-primary;
                font-size: Typography.base;
                font-weight: Typography.semibold;
            }

            Text {
                text: description;
                color: Colors.text-secondary;
                font-size: Typography.xs;
                wrap: word-wrap;
            }
        }

        // Selection indicator
        if selected: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: accent-color;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component ChannelTemplates inherits Rectangle {
    in-out property <string> selected-template: "";

    callback template-selected(string);

    background: transparent;

    // Scrollable grid
    Flickable {
        viewport-height: grid-layout.preferred-height;

        grid-layout := VerticalLayout {
            spacing: Spacing.md;
            padding-right: Spacing.sm;  // Space for scrollbar

            // Row 1
            HorizontalLayout {
                spacing: Spacing.md;

                TemplateCard {
                    horizontal-stretch: 1;
                    template-id: "general";
                    name: "General";
                    description: "Open discussion for everyone";
                    icon: Icons.message-circle;
                    accent-color: Colors.info;
                    selected: root.selected-template == "general";

                    clicked => {
                        root.selected-template = "general";
                        root.template-selected("general");
                    }
                }

                TemplateCard {
                    horizontal-stretch: 1;
                    template-id: "project";
                    name: "Project";
                    description: "Focused team collaboration";
                    icon: Icons.folder;
                    accent-color: Colors.success;
                    selected: root.selected-template == "project";

                    clicked => {
                        root.selected-template = "project";
                        root.template-selected("project");
                    }
                }
            }

            // Row 2
            HorizontalLayout {
                spacing: Spacing.md;

                TemplateCard {
                    horizontal-stretch: 1;
                    template-id: "announcement";
                    name: "Announcement";
                    description: "One-way broadcast channel";
                    icon: Icons.megaphone;
                    accent-color: Colors.warning;
                    selected: root.selected-template == "announcement";

                    clicked => {
                        root.selected-template = "announcement";
                        root.template-selected("announcement");
                    }
                }

                TemplateCard {
                    horizontal-stretch: 1;
                    template-id: "ephemeral";
                    name: "Ephemeral";
                    description: "Messages auto-delete after 24h";
                    icon: Icons.clock;
                    accent-color: Colors.error;
                    selected: root.selected-template == "ephemeral";

                    clicked => {
                        root.selected-template = "ephemeral";
                        root.template-selected("ephemeral");
                    }
                }
            }

            // Row 3
            HorizontalLayout {
                spacing: Spacing.md;

                TemplateCard {
                    horizontal-stretch: 1;
                    template-id: "ai-assistant";
                    name: "AI Assistant";
                    description: "Channel with AI bot integration";
                    icon: Icons.sparkles;
                    accent-color: Colors.primary;
                    selected: root.selected-template == "ai-assistant";

                    clicked => {
                        root.selected-template = "ai-assistant";
                        root.template-selected("ai-assistant");
                    }
                }

                TemplateCard {
                    horizontal-stretch: 1;
                    template-id: "private-group";
                    name: "Private Group";
                    description: "Server-invisible group with friends";
                    icon: Icons.shield;
                    accent-color: #9333ea;  // Purple for privacy
                    selected: root.selected-template == "private-group";

                    clicked => {
                        root.selected-template = "private-group";
                        root.template-selected("private-group");
                    }
                }
            }
        }
    }
}
