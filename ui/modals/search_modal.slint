// SearchModal - Search messages in the current channel or all channels

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";

// Search result data structure
export struct SearchResult {
    message-id: string,
    channel-id: string,
    channel-name: string,
    sender-name: string,
    content-preview: string,
    timestamp: string,
    highlight-start: int,
    highlight-end: int,
}

// Individual search result item
component SearchResultItem inherits Rectangle {
    in property <string> message-id;
    in property <string> channel-name;
    in property <string> sender-name;
    in property <string> content-preview;
    in property <string> timestamp;

    callback clicked(string);

    property <bool> hovered: touch.has-hover;

    height: 72px;
    border-radius: Spacing.radius-md;
    background: hovered ? Colors.surface-hover : Colors.surface;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked(root.message-id);
        }
    }

    VerticalLayout {
        padding: Spacing.sm;
        spacing: Spacing.xs;

        // Header row: channel name and timestamp
        HorizontalLayout {
            spacing: Spacing.sm;

            Text {
                text: "# " + root.channel-name;
                color: Colors.primary;
                font-size: Typography.xs;
                font-weight: Typography.semibold;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.timestamp;
                color: Colors.text-muted;
                font-size: Typography.xs;
            }
        }

        // Sender name
        Text {
            text: root.sender-name;
            color: Colors.text-primary;
            font-size: Typography.sm;
            font-weight: Typography.semibold;
        }

        // Content preview
        Text {
            text: root.content-preview;
            color: Colors.text-secondary;
            font-size: Typography.sm;
            overflow: elide;
        }
    }
}

export component SearchModal inherits Rectangle {
    in property <bool> show-modal: false;
    in-out property <string> search-query: "";
    in property <[SearchResult]> search-results: [];
    in property <bool> searching: false;
    in property <int> result-count: 0;
    in-out property <bool> search-all-channels: false;

    callback close();
    callback search(string);
    callback result-clicked(string);  // message-id
    callback toggle-scope();          // toggle all channels vs current

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            root.search-query = "";
        }
    }

    Modal {
        show: root.show-modal;
        title: "Search Messages";
        modal-width: 560px;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // Search input with scope toggle
            VerticalLayout {
                spacing: Spacing.sm;

                Input {
                    placeholder: root.search-all-channels ? "Search all channels..." : "Search current channel...";
                    text <=> root.search-query;

                    edited(text) => {
                        root.search(text);
                    }

                    accepted(text) => {
                        root.search(text);
                    }
                }

                // Scope toggle
                HorizontalLayout {
                    spacing: Spacing.md;
                    alignment: start;

                    Rectangle {
                        width: scope-text.preferred-width + Spacing.md * 2;
                        height: 28px;
                        border-radius: Spacing.radius-sm;
                        background: scope-touch.has-hover ? Colors.surface-hover : Colors.surface;
                        border-width: 1px;
                        border-color: Colors.text-muted.with-alpha(0.2);

                        scope-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.toggle-scope();
                            }
                        }

                        HorizontalLayout {
                            padding-left: Spacing.sm;
                            padding-right: Spacing.sm;
                            spacing: Spacing.xs;
                            alignment: center;

                            // Checkbox indicator
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.search-all-channels ? Colors.primary : Colors.text-muted;
                                background: root.search-all-channels ? Colors.primary : transparent;

                                if root.search-all-channels: Text {
                                    text: "\u{2713}";
                                    color: Colors.text-primary;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            scope-text := Text {
                                text: "Search all channels";
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Result count
                    if root.result-count > 0: Text {
                        text: root.result-count + " results";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        vertical-alignment: center;
                    }
                }
            }

            // Results area
            Rectangle {
                vertical-stretch: 1;
                min-height: 200px;
                max-height: 400px;

                // Loading state
                if root.searching: Rectangle {
                    width: 100%;
                    height: 100%;

                    Text {
                        text: "Searching...";
                        color: Colors.text-muted;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Empty state - no query
                if !root.searching && root.search-query == "": Rectangle {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        spacing: Spacing.sm;
                        alignment: center;

                        Text {
                            text: "\u{1F50D}\u{FE0F}";
                            font-size: 32px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Search for messages";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Type to search message content";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Empty state - no results
                if !root.searching && root.search-query != "" && root.search-results.length == 0: Rectangle {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        spacing: Spacing.sm;
                        alignment: center;

                        Text {
                            text: "No messages found";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Try different search terms";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Results list
                if !root.searching && root.search-results.length > 0: Flickable {
                    viewport-height: results-layout.preferred-height;

                    results-layout := VerticalLayout {
                        spacing: Spacing.xs;

                        for result in root.search-results: SearchResultItem {
                            message-id: result.message-id;
                            channel-name: result.channel-name;
                            sender-name: result.sender-name;
                            content-preview: result.content-preview;
                            timestamp: result.timestamp;

                            clicked(id) => {
                                root.result-clicked(id);
                                root.close();
                            }
                        }
                    }
                }
            }

            // Footer
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "Close";
                    variant: "secondary";

                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}
