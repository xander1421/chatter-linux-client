import { KeyFocus } from "../components/key_focus.slint";
import { Materials } from "../theme/materials.slint";
import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component RequestTabs inherits Flickable {
    in-out property <string> requests-sub-tab;
    in property <int> received-requests-count;
    in property <int> sent-requests-count;
    in property <int> private-requests-count;
    in property <int> group-invites-count;
    in property <int> channel-invites-count;
    z: 1;
    height: max(Spacing.touch-target-min, 36px * Appearance.text-grow);
    // Tab widths and starts, shared by the tabs and the scroll snap below.
    property <length> recv-w: 104px * Appearance.text-grow;
    property <length> sent-w: 88px * Appearance.text-grow;
    property <length> priv-w: 96px * Appearance.text-grow;
    property <length> grp-w: 96px * Appearance.text-grow;
    property <length> chan-w: 112px * Appearance.text-grow;
    property <length> sent-x: root.recv-w + Spacing.xs;
    property <length> priv-x: root.sent-x + root.sent-w + Spacing.xs;
    property <length> grp-x: root.priv-x + root.priv-w + Spacing.xs;
    property <length> chan-x: root.grp-x + root.grp-w + Spacing.xs;
    // Room to scroll the last tab's snap position to the left edge.
    viewport-width: max(request-tabs.preferred-width, root.snap(root.chan-x + root.chan-w) + root.width);
    viewport-height: self.height;
    // A partial trailing tab hints that this row scrolls horizontally.

    // Least scroll that shows a tab ending at `end` whole while the row
    // starts on a tab boundary: a scroll between two starts cut the first
    // visible label ("ent (0)").
    pure function snap(end: length) -> length {
        let need = end - root.width;
        return need <= 0px ? 0px
            : need <= root.sent-x ? root.sent-x
            : need <= root.priv-x ? root.priv-x
            : need <= root.grp-x ? root.grp-x : root.chan-x;
    }

    // Keep the selected tab on screen: on a phone "Channels" sits past the
    // right edge, so opening an invite left the visible tabs all unselected.
    // Re-run on a width change: at init the row may not be laid out yet.
    function reveal-active() {
        self.viewport-x = -(root.requests-sub-tab == "sent" ? root.snap(root.sent-x + root.sent-w)
            : root.requests-sub-tab == "private" ? root.snap(root.priv-x + root.priv-w)
            : root.requests-sub-tab == "groups" ? root.snap(root.grp-x + root.grp-w)
            : root.requests-sub-tab == "channels" ? root.snap(root.chan-x + root.chan-w) : 0px);
    }
    init => { self.reveal-active(); }
    changed requests-sub-tab => { self.reveal-active(); }
    changed width => { self.reveal-active(); }

    request-tabs := HorizontalLayout {
        alignment: start;
        spacing: Spacing.xs;

        recv-tab := Rectangle {

            accessible-role: tab;

            accessible-label: @tr("Received ({})", root.received-requests-count);

            accessible-item-selected: root.requests-sub-tab == "received";

            accessible-action-default => { root.requests-sub-tab = "received"; }
            KeyFocus { border-radius: parent.border-radius; activate => { root.requests-sub-tab = "received"; } }
            width: root.recv-w;
            border-radius: Spacing.radius-control;
            background: root.requests-sub-tab == "received" ? Colors.tint-strong : recv-tab-touch.has-hover ? Materials.hover : transparent;

            VerticalLayout {
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;

                    Text {
                        text: @tr("Received ({})", root.received-requests-count);
                        color: root.requests-sub-tab == "received" ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: root.requests-sub-tab == "received" ? Typography.semibold : Typography.normal;
                    }
                }

            }

            recv-tab-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.requests-sub-tab = "received";
                }
            }
        }

        sent-tab := Rectangle {

            accessible-role: tab;

            accessible-label: @tr("Sent ({})", root.sent-requests-count);

            accessible-item-selected: root.requests-sub-tab == "sent";

            accessible-action-default => { root.requests-sub-tab = "sent"; }
            KeyFocus { border-radius: parent.border-radius; activate => { root.requests-sub-tab = "sent"; } }
            width: root.sent-w;
            border-radius: Spacing.radius-control;
            background: root.requests-sub-tab == "sent" ? Colors.tint-strong : sent-tab-touch.has-hover ? Materials.hover : transparent;

            VerticalLayout {
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;

                    Text {
                        text: @tr("Sent ({})", root.sent-requests-count);
                        color: root.requests-sub-tab == "sent" ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: root.requests-sub-tab == "sent" ? Typography.semibold : Typography.normal;
                    }
                }

            }

            sent-tab-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.requests-sub-tab = "sent";
                }
            }
        }

        priv-tab := Rectangle {

            accessible-role: tab;

            accessible-label: @tr("Private ({})", root.private-requests-count);

            accessible-item-selected: root.requests-sub-tab == "private";

            accessible-action-default => { root.requests-sub-tab = "private"; }
            KeyFocus { border-radius: parent.border-radius; activate => { root.requests-sub-tab = "private"; } }
            width: root.priv-w;
            border-radius: Spacing.radius-control;
            background: root.requests-sub-tab == "private" ? Colors.tint-strong : priv-tab-touch.has-hover ? Materials.hover : transparent;

            VerticalLayout {
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;

                    Text {
                        text: @tr("Private ({})", root.private-requests-count);
                        color: root.requests-sub-tab == "private" ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: root.requests-sub-tab == "private" ? Typography.semibold : Typography.normal;
                    }
                }

            }

            priv-tab-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.requests-sub-tab = "private";
                }
            }
        }

        grp-tab := Rectangle {

            accessible-role: tab;

            accessible-label: @tr("Groups ({})", root.group-invites-count);

            accessible-item-selected: root.requests-sub-tab == "groups";

            accessible-action-default => { root.requests-sub-tab = "groups"; }
            KeyFocus { border-radius: parent.border-radius; activate => { root.requests-sub-tab = "groups"; } }
            width: root.grp-w;
            background: groups-tab-touch.has-hover ? Materials.hover : transparent;

            VerticalLayout {
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;

                    Text {
                        text: @tr("Groups ({})", root.group-invites-count);
                        color: root.requests-sub-tab == "groups" ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: root.requests-sub-tab == "groups" ? Typography.semibold : Typography.normal;
                    }
                }

            }

            groups-tab-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.requests-sub-tab = "groups";
                }
            }
        }

        chan-tab := Rectangle {

            accessible-role: tab;

            accessible-label: @tr("Channels ({})", root.channel-invites-count);

            accessible-item-selected: root.requests-sub-tab == "channels";

            accessible-action-default => { root.requests-sub-tab = "channels"; }
            KeyFocus { border-radius: parent.border-radius; activate => { root.requests-sub-tab = "channels"; } }
            width: root.chan-w;
            background: channels-tab-touch.has-hover ? Materials.hover : transparent;

            VerticalLayout {
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;

                    Text {
                        text: @tr("Channels ({})", root.channel-invites-count);
                        color: root.requests-sub-tab == "channels" ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: root.requests-sub-tab == "channels" ? Typography.semibold : Typography.normal;
                    }
                }

            }

            channels-tab-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.requests-sub-tab = "channels";
                }
            }
        }
    }
}
