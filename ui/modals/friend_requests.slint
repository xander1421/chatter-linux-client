// FriendRequestsModal - Modal for managing friend requests

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Avatar } from "../components/avatar.slint";

// FriendRequest struct for request data
export struct FriendRequest {
    user-id: string,
    display-name: string,
    username: string,
    avatar-url: string,
    sent-at: string,  // formatted date
}

export component FriendRequestsModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> active-tab: "received";  // "received" or "sent"
    in property <[FriendRequest]> received-requests: [];
    in property <[FriendRequest]> sent-requests: [];
    in property <bool> loading: false;

    callback close();
    callback switch-tab(string);
    callback accept(string);   // user_id
    callback decline(string);  // user_id
    callback cancel(string);   // user_id - cancel sent request

    Modal {
        show: root.show-modal;
        title: "Friend Requests";
        modal-width: 480px;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // Tab bar
            HorizontalLayout {
                accessible-role: tab-list;
                accessible-label: "Friend request tabs";
                height: 40px;

                // Received tab
                Rectangle {
                    accessible-role: tab;
                    accessible-label: "Received (" + root.received-requests.length + ")";
                    horizontal-stretch: 1;
                    background: transparent;

                    VerticalLayout {
                        // Tab content
                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 1;

                            Text {
                                text: "Received (" + root.received-requests.length + ")";
                                color: root.active-tab == "received" ? Colors.text-primary : Colors.text-secondary;
                                font-size: Typography.sm;
                                font-weight: root.active-tab == "received" ? Typography.semibold : Typography.normal;
                                vertical-alignment: center;
                            }
                        }

                        // Active indicator
                        Rectangle {
                            height: 2px;
                            background: root.active-tab == "received" ? Colors.primary : transparent;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.switch-tab("received");
                        }
                        mouse-cursor: pointer;
                    }
                }

                // Sent tab
                Rectangle {
                    accessible-role: tab;
                    accessible-label: "Sent (" + root.sent-requests.length + ")";
                    horizontal-stretch: 1;
                    background: transparent;

                    VerticalLayout {
                        // Tab content
                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 1;

                            Text {
                                text: "Sent (" + root.sent-requests.length + ")";
                                color: root.active-tab == "sent" ? Colors.text-primary : Colors.text-secondary;
                                font-size: Typography.sm;
                                font-weight: root.active-tab == "sent" ? Typography.semibold : Typography.normal;
                                vertical-alignment: center;
                            }
                        }

                        // Active indicator
                        Rectangle {
                            height: 2px;
                            background: root.active-tab == "sent" ? Colors.primary : transparent;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.switch-tab("sent");
                        }
                        mouse-cursor: pointer;
                    }
                }
            }

            // Divider below tabs
            Rectangle {
                height: 1px;
                background: Colors.text-muted.with-alpha(0.2);
            }

            // Request list container
            Rectangle {
                min-height: 200px;
                max-height: 400px;
                vertical-stretch: 1;

                // Received tab content
                if root.active-tab == "received": Rectangle {
                    width: 100%;
                    height: 100%;

                    // Empty state for received
                    if root.received-requests.length == 0: Rectangle {
                        width: 100%;
                        height: 100%;

                        Text {
                            text: "No pending friend requests";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Received requests list
                    if root.received-requests.length > 0: Flickable {
                        viewport-height: received-list.preferred-height;
                        viewport-width: parent.width;

                        received-list := VerticalLayout {
                            spacing: Spacing.xs;

                            for request[index] in root.received-requests: Rectangle {
                                height: 64px;
                                background: request-received-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-md;

                                // TouchArea first (behind) for hover detection
                                request-received-touch := TouchArea {}

                                HorizontalLayout {
                                    padding-left: Spacing.sm;
                                    padding-right: Spacing.sm;
                                    spacing: Spacing.sm;

                                    // Avatar
                                    Avatar {
                                        size: 40px;
                                        fallback-text: request.display-name;
                                    }

                                    // Name, username, and time
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: request.display-name;
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: "@" + request.username;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }

                                            Text {
                                                text: request.sent-at;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }
                                    }

                                    // Action buttons
                                    HorizontalLayout {
                                        spacing: Spacing.xs;
                                        alignment: center;

                                        Button {
                                            text: "Accept";
                                            variant: "primary";
                                            disabled: root.loading;

                                            clicked => {
                                                root.accept(request.user-id);
                                            }
                                        }

                                        Button {
                                            text: "Decline";
                                            variant: "ghost";
                                            disabled: root.loading;

                                            clicked => {
                                                root.decline(request.user-id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Sent tab content
                if root.active-tab == "sent": Rectangle {
                    width: 100%;
                    height: 100%;

                    // Empty state for sent
                    if root.sent-requests.length == 0: Rectangle {
                        width: 100%;
                        height: 100%;

                        Text {
                            text: "No outgoing requests";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Sent requests list
                    if root.sent-requests.length > 0: Flickable {
                        viewport-height: sent-list.preferred-height;
                        viewport-width: parent.width;

                        sent-list := VerticalLayout {
                            spacing: Spacing.xs;

                            for request[index] in root.sent-requests: Rectangle {
                                height: 64px;
                                background: request-sent-touch.has-hover ? Colors.surface-hover : transparent;
                                border-radius: Spacing.radius-md;

                                // TouchArea first (behind) for hover detection
                                request-sent-touch := TouchArea {}

                                HorizontalLayout {
                                    padding-left: Spacing.sm;
                                    padding-right: Spacing.sm;
                                    spacing: Spacing.sm;

                                    // Avatar
                                    Avatar {
                                        size: 40px;
                                        fallback-text: request.display-name;
                                    }

                                    // Name, username, and time
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: request.display-name;
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: Spacing.sm;

                                            Text {
                                                text: "@" + request.username;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }

                                            Text {
                                                text: request.sent-at;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }
                                    }

                                    // Cancel button
                                    HorizontalLayout {
                                        alignment: center;

                                        Button {
                                            text: "Cancel";
                                            variant: "ghost";
                                            disabled: root.loading;

                                            clicked => {
                                                root.cancel(request.user-id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
