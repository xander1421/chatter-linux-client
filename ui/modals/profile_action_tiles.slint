import { Button } from "../components/button.slint";
import { Spacing } from "../theme/spacing.slint";
import { Icons } from "../theme/icons.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";
export component ProfileActionTiles inherits HorizontalLayout {
    in property <bool> scoped-member;
    in property <bool> is-muted;
    in property <bool> is-anonymous;
    in property <bool> is-friend;
    callback send-message();
    callback toggle-mute();
    callback start-call(bool);
    callback open-more();
    padding-left: Spacing.md;
    padding-right: Spacing.md;
    spacing: Spacing.xs;

    // "Message" in Anon Mode only for a friend: the friend
    // DM goes over the mailbox there; core has no DM to
    // open with anyone else (resolve_dm_conversation).
    // No Call/Video from a secret chat: LiveKit media would
    // leave Tor and expose the user's IP.
    for act in root.scoped-member ? [
        { id: "mute", label: root.is-muted ? @tr("Unmute conversation") : @tr("Mute conversation"), icon: root.is-muted ? Icons.bell-off : Icons.bell },
        { id: "more", label: @tr("More"), icon: Icons.more-horizontal },
    ] : root.is-anonymous && AnonMode.enabled && !root.is-friend ? [
        { id: "mute", label: root.is-muted ? @tr("Unmute") : @tr("Mute"), icon: root.is-muted ? Icons.bell-off : Icons.bell },
        { id: "more", label: @tr("More"), icon: Icons.more-horizontal },
    ] : root.is-anonymous ? [
        { id: "message", label: @tr("Message"), icon: Icons.message-circle },
        { id: "mute", label: root.is-muted ? @tr("Unmute") : @tr("Mute"), icon: root.is-muted ? Icons.bell-off : Icons.bell },
        { id: "more", label: @tr("More"), icon: Icons.more-horizontal },
    ] : AnonMode.enabled && !root.is-friend ? [
        { id: "mute", label: root.is-muted ? @tr("Unmute") : @tr("Mute"), icon: root.is-muted ? Icons.bell-off : Icons.bell },
        { id: "call", label: @tr("action" => "Call"), icon: Icons.phone },
        { id: "more", label: @tr("More"), icon: Icons.more-horizontal },
    ] : [
        { id: "message", label: @tr("Message"), icon: Icons.message-circle },
        { id: "mute", label: root.is-muted ? @tr("Unmute") : @tr("Mute"), icon: root.is-muted ? Icons.bell-off : Icons.bell },
        { id: "call", label: @tr("action" => "Call"), icon: Icons.phone },
        { id: "more", label: @tr("More"), icon: Icons.more-horizontal },
    ]: Button {
        // Keep the four actions even and readable on narrow profiles.
        horizontal-stretch: 1;
        preferred-width: 0px;
        min-width: 0px;
        height: 62px;
        border-radius: Spacing.radius-control;
        variant: act.id == "message" ? "primary" : "secondary";
        text: act.id == "mute" ? (root.is-muted ? @tr("Unmute") : @tr("Mute")) : act.label;
        label: act.label;
        icon: act.icon;
        icon-above-text: true;
        clicked => {
            if (act.id == "message") {
                root.send-message();
            } else if (act.id == "mute") {
                root.toggle-mute();
            } else if (act.id == "call") {
                root.start-call(false);
            } else {
                root.open-more();
            }
        }
    }
}
