// CreateSectionModal — Create or rename a custom sidebar section
//
// Supports two modes:
//   - Create: empty name + default emoji, "Create" button
//   - Rename: pre-filled name + emoji, "Save" button

import { KeyFocus } from "../components/key_focus.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";

// Common section emoji icons (~50 items). Only emoji that are colour by
// default (Emoji_Presentation=Yes): a symbol that needs U+FE0F to turn colour
// (⚙️ 🛡️ 🏗️ 🏷️ ☁️ ❤️) drew as a NO GLYPH box or a grey glyph on Android 10.
global SectionEmojis {
    out property <[string]> icons: [
        "📁", "📂", "⭐", "🏠", "💼", "🎯", "🔥", "💡", "🎨", "🎮",
        "🎵", "📚", "🔧", "🔩", "🔐", "🔒", "💬", "📢", "🌍", "🚀",
        "💰", "📊", "📈", "🧪", "🔬", "🧱", "🎓", "📝", "✅", "💖",
        "💎", "🌟", "🏆", "👥", "🤝", "📌", "🔖", "📛", "📎", "✨",
        "🌈", "🌙", "⚡", "🎲", "🧩", "🎪", "🌱", "🍀", "🔔", "🎁",
    ];
}

export component CreateSectionModal inherits Rectangle {
    // true = rename mode, false = create mode
    in property <bool> rename-mode: false;
    in property <bool> show-modal: false;
    in property <bool> touch: false;
    in property <bool> loading: false;

    in-out property <string> section-name: "";
    in-out property <string> selected-emoji: "📁";

    // For rename: the section being renamed
    in property <string> section-id: "";

    callback close();
    callback create-section(/* name */ string, /* emoji */ string);
    callback rename-section(/* section-id */ string, /* name */ string, /* emoji */ string);

    // Track whether emoji picker is expanded
    property <bool> picker-open: false;

    function submit(name: string) {
        if name != "" && !root.loading {
            if root.rename-mode {
                root.rename-section(root.section-id, name, root.selected-emoji);
            } else {
                root.create-section(name, root.selected-emoji);
            }
        }
    }

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            section-name = "";
            selected-emoji = "📁";
            picker-open = false;
        }
    }

    Modal {
        show: root.show-modal;
        title: root.rename-mode ? @tr("Rename section") : @tr("New section");
        modal-width: 400px;
        dialog-card: true;
        show-close: false;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;

            // ── Emoji + Name row ──────────────────────────────────
            HorizontalLayout {
                spacing: Spacing.sm;

                // Emoji button — click to toggle picker
                Button {
                    min-width: Spacing.touch-target-min;
                    max-width: Spacing.touch-target-min;
                    height: Spacing.touch-target-min;
                    variant: "secondary";
                    outlined: true;
                    border-radius: Spacing.radius-control;
                    text: root.selected-emoji;
                    text-font-family: Typography.font-family-emoji;
                    label: @tr("Section icon {}", root.selected-emoji);
                    clicked => { root.picker-open = !root.picker-open; }
                }

                // Name input
                name-input := Input {
                    inset-control: true;
                    horizontal-stretch: 1;
                    placeholder: @tr("Section name");
                    text <=> root.section-name;
                    // Created on open: the name is the only thing to type. A
                    // rename starts selected, so typing replaces the old name.
                    init => { if !root.touch { self.focus(); self.select-all(); } }
                    accepted => { root.submit(self.composed-text); }
                }
            }

            // ── Inline emoji grid (shown when picker-open) ────────
            if root.picker-open: grid-box := Rectangle {
                height: 200px;
                background: Colors.surface-card;
                border-radius: Spacing.radius-panel;
                clip: true;

                // Reflow the grid as the card narrows.
                property <int> grid-cols: max(1, Math.floor((self.width - Spacing.sm * 2) / Spacing.button-height));

                Flickable {
                    viewport-height: Math.ceil(SectionEmojis.icons.length / grid-box.grid-cols) * Spacing.button-height + Spacing.sm * 2;
                    viewport-width: parent.width;

                    Rectangle {
                        width: parent.width;
                        height: parent.viewport-height;

                        for icon[index] in SectionEmojis.icons: Rectangle {
                            property <int> grid-row: Math.floor(index / grid-box.grid-cols);
                            property <int> grid-col: mod(index, grid-box.grid-cols);

                            x: Spacing.sm + self.grid-col * Spacing.button-height;
                            y: Spacing.sm + self.grid-row * Spacing.button-height;
                            width: Spacing.button-height;
                            height: Spacing.button-height;
                            border-radius: Spacing.radius-control;
                            background: icon == root.selected-emoji
                                ? Colors.tint-strong
                                : (icon-touch.pressed ? Materials.pressed : icon-touch.has-hover ? Materials.hover : transparent);
                            transform-scale-x: icon-touch.pressed ? 0.82 : 1;
                            accessible-role: button;
                            accessible-label: @tr("Choose icon {}", icon);
                            accessible-checkable: true;
                            accessible-checked: icon == root.selected-emoji;
                            accessible-action-default => {
                                root.selected-emoji = icon;
                                root.picker-open = false;
                            }
                            KeyFocus {
                                border-radius: parent.border-radius;
                                activate => {
                                    root.selected-emoji = icon;
                                    root.picker-open = false;
                                }
                            }
                            transform-scale-y: icon-touch.pressed ? 0.82 : 1;
                            animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                            animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                            animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                            Text {
                                accessible-role: none;
                                text: icon;
                                font-size: Typography.lg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            icon-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-emoji = icon;
                                    root.picker-open = false;
                                }
                            }
                        }
                    }
                }
            }

            // ── Footer buttons ────────────────────────────────────
            HorizontalLayout {
                spacing: Spacing.md;

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    border-radius: Spacing.radius-control;
                    text: @tr("Cancel");
                    variant: "secondary";
                    outlined: true;
                    clicked => { root.close(); }
                }

                Button {
                    border-radius: Spacing.radius-control;
                    text: root.loading ? "" :
                        (root.rename-mode ? @tr("Save") : @tr("Create"));
                    variant: "primary";
                    disabled: name-input.composed-text == "" || root.loading;
                    loading: root.loading;

                    clicked => { root.submit(name-input.composed-text); }
                }
            }
        }
    }
}
