// Channel search result row, used by the Join tab of create_channel.slint.
// (The standalone JoinChannelModal that lived here was never instantiated.)

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

// Search result channel data
export struct SearchResultChannel {
    id: string,
    name: string,
    description: string,
    member-count: int,
    icon: image,
    has-icon: bool,
}

// Individual search result item
export component SearchResultItem inherits Rectangle {
    in property <string> channel-id;
    in property <string> name;
    in property <string> description;
    in property <int> member-count;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;

    callback clicked();

    property <bool> hovered: touch.has-hover;

    height: 64px;
    border-radius: Spacing.radius-md;
    background: selected ? Colors.neo-inset-bg : (hovered ? Colors.surface-hover : Colors.surface);
    border-width: 1px;
    border-color: selected ? Colors.glow-cyan.with-alpha(0.4) : (hovered ? Colors.neo-highlight : Colors.neo-inset-shadow);

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        // Channel icon (image if available, else "#" placeholder)
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: Spacing.radius-md;
            background: root.has-icon ? transparent : Colors.primary.with-alpha(0.2);
            clip: true;

            if root.has-icon: Image {
                source: root.icon;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.has-icon: Text {
                text: "#";
                color: Colors.primary;
                font-size: Typography.lg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // Channel info
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.xs;
            alignment: center;

            HorizontalLayout {
                spacing: Spacing.sm;

                Text {
                    text: root.name;
                    color: selected ? Colors.primary : Colors.text-primary;
                    font-size: Typography.sm;
                    font-weight: Typography.semibold;
                }

                Text {
                    text: root.member-count > 0 ? "\u{2022} " + root.member-count + " members" : "";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }
            }

            if root.description != "": Text {
                text: root.description;
                color: Colors.text-secondary;
                font-size: Typography.xs;
                overflow: elide;
            }
        }
    }
}
