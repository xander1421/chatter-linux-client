// Channel search result row, used by the Join tab of create_channel.slint.
// (The standalone JoinChannelModal that lived here was never instantiated.)

import { KeyFocus } from "../components/key_focus.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

// Search result channel data
export struct SearchResultChannel {
    id: string,
    name: string,
    description: string,
    member-count: int,
    icon: image,
    has-icon: bool,
    // Already a member: shown as joined and opened instead of joined again.
    joined: bool,
}

// Individual search result item
export component SearchResultItem inherits Rectangle {
    in property <string> channel-id;
    in property <string> name;
    in property <string> description;
    in property <int> member-count;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;
    in property <bool> joined: false;

    callback clicked();

    accessible-role: list-item;
    accessible-label: root.name;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    KeyFocus { border-radius: parent.border-radius; activate => { root.clicked(); } }

    property <bool> hovered: touch.has-hover;

    height: max(Spacing.touch-target-min, 68px);
    border-radius: Spacing.radius-md;
    background: selected ? Colors.inset : (touch.pressed ? Materials.pressed : hovered ? Colors.surface-hover : Colors.surface);
    border-width: selected ? Spacing.stroke : 0px;
    border-color: Colors.primary;
    transform-scale-x: touch.pressed ? 0.975 : 1;
    transform-scale-y: touch.pressed ? 0.94 : 1;
    animate background { duration: Materials.motion-quick; easing: Materials.settle; }
    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: Spacing.md;
        spacing: Spacing.md;

        // Channel icon (image if available, else "#" placeholder)
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: Spacing.radius-md;
            background: root.has-icon ? transparent : Colors.primary.with-alpha(0.2);
            clip: true;

            if root.has-icon: Image {
                source: root.icon;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.has-icon: Text {
                text: "#";
                color: Colors.primary;
                font-size: Typography.lg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // Channel info
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.xs;
            alignment: center;

            HorizontalLayout {
                spacing: Spacing.sm;

                Text {
                    accessible-role: none;
                    text: root.name;
                    color: selected ? Colors.primary : Colors.text-primary;
                    font-size: Typography.sm;
                    font-weight: Typography.semibold;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if root.joined: Text {
                    text: "Joined";
                    color: Colors.primary;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }

                Text {
                    text: root.member-count == 1 ? "\u{2022} 1 member"
                        : root.member-count > 0 ? "\u{2022} " + root.member-count + " members" : "";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }
            }

            if root.description != "": Text {
                text: root.description;
                color: Colors.text-secondary;
                font-size: Typography.xs;
                overflow: elide;
            }
        }
    }
}
