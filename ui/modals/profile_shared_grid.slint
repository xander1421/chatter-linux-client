import { Colors } from "../theme/colors.slint";
import { Icons } from "../theme/icons.slint";
import { SharedContentItem, ProfileSharedIcons } from "profile_shared_types.slint";
export component ProfileSharedGrid inherits Rectangle {
    in property <[SharedContentItem]> shared-items;
    callback open-shared-item(string, string, string, string);
    property <length> gutter: 2px;
    property <length> tile: (self.width - root.gutter * 2) / 3;
    height: Math.ceil(root.shared-items.length / 3) * (root.tile + root.gutter);

    for item[index] in root.shared-items: Rectangle {
        x: Math.mod(index, 3) * (root.tile + root.gutter);
        y: Math.floor(index / 3) * (root.tile + root.gutter);
        width: root.tile;
        height: root.tile;
        background: Colors.inset;
        clip: true;
        accessible-role: button;
        accessible-label: item.title;
        accessible-action-default => { root.open-shared-item(item.message-id, item.attachment-id, item.category, item.subtitle); }

        if item.has-thumbnail: Image {
            width: 100%;
            height: 100%;
            source: item.thumbnail;
            image-fit: cover;
        }

        // No thumbnail yet (not downloaded, or a document
        // that landed in Media) — a glyph beats a blank.
        if !item.has-thumbnail: Image {
            source: ProfileSharedIcons.category-icon(item.category);
            width: 28px;
            height: 28px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Colors.text-muted;
        }

        if item.is-video: Rectangle {
            width: 26px;
            height: 26px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 13px;
            background: Colors.overlay-heavy;

            Image {
                source: Icons.play;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Colors.text-primary;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open-shared-item(item.message-id, item.attachment-id, item.category, item.subtitle);
            }
        }
    }
}
