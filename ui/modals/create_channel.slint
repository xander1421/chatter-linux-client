import { Checkbox } from "../components/checkbox.slint";
// CreateChannelModal - Single-page adaptive form.
//
// UX: one-step form with access-model pills (Open / Invite-only / Private group),
// inline reveal for password/TTL/AI, collapsible "More options". Private-group
// path swaps the main form area in place for the friend picker.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { SearchResultChannel, SearchResultItem } from "join_channel.slint";
import { AiIntegrationGlobal } from "../ai/ai_global.slint";
import { MembershipGlobal } from "../chat/membership_global.slint";

// Friend data for private group selection (matches FriendData)
export struct PrivateGroupFriend {
    user-id: string,
    display-name: string,
    username: string,
    selected: bool,
    role: string,
    avatar-source: image,
    // Reached through an anon DM: purple anonymous ring.
    anonymous: bool,
}

export struct AIProviderOption {
    id: string,
    name: string,
}

export struct AIModelOption {
    id: string,
    name: string,
    provider: string,
}

// Simplified config. Encryption + friends-only derived from access model.
export struct CreateChannelConfig {
    is-private: bool,
    is-ephemeral: bool,
    ttl-hours: int,
    max-members: int,
    password: string,
    icon-url: string,
}

export component CreateChannelModal inherits Rectangle {
    in property <bool> show-modal: false;
    in-out property <string> channel-name: "";
    in-out property <string> channel-description: "";
    in-out property <string> selected-template: "";
    in property <string> error-message: "";
    in property <bool> loading: false;

    // Access mode: "open" | "invite" | "private-group"
    in-out property <string> access-mode: "open";

    // Advanced toggles
    in-out property <bool> use-ephemeral: false;
    in-out property <int> ttl-hours: 24;
    in-out property <bool> use-ai: false;
    in-out property <int> max-members: 0;
    in-out property <string> password: "";

    // Icon upload state
    in-out property <string> icon-url: "";
    in-out property <image> icon-preview;
    in-out property <bool> has-icon-preview: false;

    // AI provider/model lists
    in-out property <string> ai-provider: "";
    in-out property <string> ai-model: "";
    in property <[AIProviderOption]> ai-providers: [
        { id: "claude", name: "Claude (Anthropic)" },
        { id: "openai", name: "OpenAI" },
        { id: "ollama", name: "Ollama (Local)" },
    ];
    in property <[AIModelOption]> ai-models: [];
    in property <bool> ai-models-loading: false;
    in property <string> ai-models-error: "";

    // Private-group friend picker state
    in-out property <[PrivateGroupFriend]> available-friends: [];
    in-out property <int> selected-friend-count: 0;

    // Tab switcher: 0 = Create, 1 = Join
    in-out property <int> active-tab: 0;
    // Join tab state
    in-out property <string> join-search-query: "";
    in property <[SearchResultChannel]> join-results: [];
    in property <bool> join-searching: false;
    in property <string> join-error: "";
    in-out property <string> join-selected-id: "";
    in property <bool> join-joining: false;
    callback join-search(string);
    callback join-channel(string);

    callback close();
    // name, description, template, config, ai_provider, ai_model
    callback create(string, string, string, CreateChannelConfig, string, string);
    callback provider-selected(string);
    callback pick-channel-icon();
    callback create-private-group(string, [PrivateGroupFriend]);
    callback toggle-friend-selection(int);
    callback toggle-friend-role(int);
    callback template-selected(string);  // fires when access-mode becomes "private-group" — used by Rust to preload friends

    // Derived flags
    property <bool> is-private-group: root.access-mode == "private-group";
    property <bool> is-invite: root.access-mode == "invite";
    property <bool> is-open: root.access-mode == "open";

    // Collapsible "More options"
    property <bool> more-options-expanded: false;

    // Bumped by the name field's Done to move focus to Description.
    property <int> description-focus-requests: 0;

    // Reset on close
    changed show-modal => {
        if !show-modal {
            root.channel-name = "";
            root.channel-description = "";
            root.selected-template = "";
            root.access-mode = "open";
            root.use-ephemeral = false;
            root.ttl-hours = 24;
            root.use-ai = false;
            root.max-members = 0;
            root.password = "";
            root.icon-url = "";
            root.has-icon-preview = false;
            root.ai-provider = "";
            root.ai-model = "";
            root.more-options-expanded = false;
            root.active-tab = 0;
            root.join-selected-id = "";
            root.join-search-query = "";
        }
    }

    // Selecting private-group pill loads friend list via Rust.
    changed access-mode => {
        if root.access-mode == "private-group" {
            root.template-selected("private-group");
        }
    }

    modal := Modal {
        show: root.show-modal;
        title: "New Channel";
        modal-width: 620px;
        max-modal-height: 720px;
        // Keep one sheet size as the Create/Join indicator travels. Both tabs
        // give their result/body area the spare height and pin their footer.
        fill-height: true;

        close => { root.close(); }

        VerticalLayout {
            spacing: Spacing.md;

            // ============================================================
            // Tab switcher: Create | Join
            // ============================================================
            tab-track := Rectangle {
                height: Spacing.touch-target-min;
                background: Colors.surface-control;
                border-radius: Spacing.radius-lg;

                // One surface travels between tabs, preserving its shape and
                // position instead of replacing two unrelated backgrounds.
                Rectangle {
                    x: root.active-tab == 0 ? 4px : tab-track.width / 2;
                    y: 4px;
                    width: (tab-track.width - 8px) / 2;
                    height: tab-track.height - 8px;
                    background: Colors.surface-section;
                    border-radius: Spacing.radius-md;
                    animate x { duration: Materials.motion-standard; easing: Materials.glide; }
                }

                for tab[index] in ["Create", "Join"]: Rectangle {
                    x: index * tab-track.width / 2;
                    width: tab-track.width / 2;
                    height: tab-track.height;
                    transform-scale-x: tab-touch.pressed ? 0.96 : 1;
                    transform-scale-y: tab-touch.pressed ? 0.92 : 1;
                    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                    Text {
                        text: tab;
                        width: 100%;
                        height: 100%;
                        color: root.active-tab == index ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.sm;
                        font-weight: root.active-tab == index ? Typography.semibold : Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = index; }
                    }
                }
            }

            // ============================================================
            // CREATE TAB
            // ============================================================
            if root.active-tab == 0: VerticalLayout {
            spacing: Spacing.md;

            // ============================================================
            // Scrollable body. The error banner and the Create/Cancel footer
            // live OUTSIDE this Flickable so they stay pinned and reachable
            // even when the viewport is short (Android landscape).
            // ============================================================
            Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: create-body.preferred-height;

            // Beneath the form: a tap on blank space puts the keyboard away.
            // The card's own catch-all never sees it — this Flickable takes
            // the press first.
            TouchArea {
                clicked => { modal.release-focus(); }
            }

            create-body := VerticalLayout {
            spacing: Spacing.lg;

            // ============================================================
            // Identity row: icon + name + description
            // ============================================================
            HorizontalLayout {
                spacing: Spacing.md;

                // Icon upload (64px)
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    spacing: Spacing.xs;

                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: Spacing.radius-md;
                        background: Colors.inset;
                        clip: true;

                        if root.has-icon-preview: Image {
                            source: root.icon-preview;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if !root.has-icon-preview: Image {
                            source: Icons.image;
                            width: 24px;
                            height: 24px;
                            colorize: Colors.text-muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        icon-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-channel-icon(); }
                        }
                    }

                    Text {
                        text: root.has-icon-preview ? "Change" : "Upload";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        width: 64px;
                    }
                }

                // Name + description stack
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.sm;

                    // The IME's Done/Enter arrives as `accepted`. Without a
                    // handler it did nothing, and on a phone the keyboard then
                    // could not be dismissed over "Who can join?". Done moves
                    // to Description; Done there (or on a group's name, which
                    // has none) puts the keyboard away.
                    name-input := Input {
                        placeholder: root.is-private-group ? "Group name" : "Channel name";
                        text <=> root.channel-name;
                        error: root.error-message != "" && root.channel-name == "";
                        error-message: root.error-message != "" && root.channel-name == "" ? "Name is required" : "";
                        accepted => {
                            if root.is-private-group {
                                modal.release-focus();
                            } else {
                                root.description-focus-requests += 1;
                            }
                        }
                    }

                    // Inside an `if`, so the name field cannot call its
                    // focus() directly; it bumps this counter instead.
                    Input {
                        visible: !root.is-private-group;
                        height: root.is-private-group ? 0px : Spacing.button-height;
                        property <int> focus-requests: root.description-focus-requests;
                        changed focus-requests => { self.focus(); }
                        placeholder: "Description (optional)";
                        text <=> root.channel-description;
                        accepted => { modal.release-focus(); }
                    }
                }
            }

            // ============================================================
            // Access model — 3 options, stacked as full-width rows. Side by
            // side at a fixed height their descriptions overflowed on a phone.
            // ============================================================
            VerticalLayout {
                spacing: Spacing.xs;

                Text {
                    text: "Who can join?";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                }

                VerticalLayout {
                    spacing: Spacing.sm;

                    // Open
                    Rectangle {
                        border-radius: Spacing.radius-md;
                        border-width: root.is-open ? Spacing.stroke : 0px;
                        border-color: Colors.primary;
                        background: root.is-open ? Colors.inset : (open-touch.pressed ? Materials.pressed : open-touch.has-hover ? Colors.surface-hover : Colors.surface);
                        transform-scale-x: open-touch.pressed ? 0.985 : 1;
                        transform-scale-y: open-touch.pressed ? 0.96 : 1;
                        animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                        VerticalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.xxs;
                            alignment: center;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                Image {
                                    source: Icons.globe;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-open ? Colors.primary : Colors.text-secondary;
                                }
                                Text {
                                    text: "Open";
                                    color: root.is-open ? Colors.primary : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Anyone finds and joins. New members see messages from when they join.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        open-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.access-mode = "open"; }
                        }
                    }

                    // Invite-only
                    Rectangle {
                        border-radius: Spacing.radius-md;
                        border-width: root.is-invite ? Spacing.stroke : 0px;
                        border-color: Colors.primary;
                        background: root.is-invite ? Colors.inset : (invite-touch.pressed ? Materials.pressed : invite-touch.has-hover ? Colors.surface-hover : Colors.surface);
                        transform-scale-x: invite-touch.pressed ? 0.985 : 1;
                        transform-scale-y: invite-touch.pressed ? 0.96 : 1;
                        animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                        VerticalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.xxs;
                            alignment: center;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                Image {
                                    source: Icons.lock;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-invite ? Colors.primary : Colors.text-secondary;
                                }
                                Text {
                                    text: "Invite-only";
                                    color: root.is-invite ? Colors.primary : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Hidden from discovery. Invite or password to join.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        invite-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.access-mode = "invite"; }
                        }
                    }

                    // Private group
                    Rectangle {
                        border-radius: Spacing.radius-md;
                        border-width: root.is-private-group ? Spacing.stroke : 0px;
                        border-color: Colors.primary;
                        background: root.is-private-group ? Colors.inset : (pg-touch.pressed ? Materials.pressed : pg-touch.has-hover ? Colors.surface-hover : Colors.surface);
                        transform-scale-x: pg-touch.pressed ? 0.985 : 1;
                        transform-scale-y: pg-touch.pressed ? 0.96 : 1;
                        animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                        VerticalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.xxs;
                            alignment: center;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                Image {
                                    source: Icons.shield;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-private-group ? Colors.group-accent : Colors.text-secondary;
                                }
                                Text {
                                    text: "Anon group";
                                    color: root.is-private-group ? Colors.group-accent : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "End-to-end encrypted. Server can't see it exists.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        pg-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.access-mode = "private-group"; }
                        }
                    }
                }

                // Encryption badge (open = no badge; invite/private-group = encrypted badge)
                if root.is-invite || root.is-private-group: HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;
                    Image {
                        source: Icons.shield;
                        width: 12px;
                        height: 12px;
                        colorize: Colors.success;
                        y: 2px;
                    }
                    Text {
                        text: "End-to-end encrypted";
                        color: Colors.success;
                        font-size: Typography.xs;
                    }
                }
            }

            // ============================================================
            // Invite-only → password reveal
            // ============================================================
            if root.is-invite: VerticalLayout {
                spacing: Spacing.xs;

                Text {
                    text: "Password (optional)";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                }

                Input {
                    placeholder: "Anyone with password joins without invite";
                    text <=> root.password;
                }
            }

            // ============================================================
            // Private group → friend picker
            // ============================================================
            if root.is-private-group: VerticalLayout {
                spacing: Spacing.sm;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    Text {
                        text: "Select friends to invite";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        font-weight: Typography.medium;
                    }

                    Text {
                        text: "(" + root.selected-friend-count + " selected)";
                        color: Colors.primary;
                        font-size: Typography.sm;
                    }
                }

                Rectangle {
                    min-height: 160px;
                    max-height: 260px;
                    vertical-stretch: 1;
                    background: Colors.inset;
                    border-radius: Spacing.radius-md;
                    clip: true;

                    if root.available-friends.length == 0: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "No friends yet";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Add friends first to create a private group";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                        }
                    }

                    Flickable {
                        viewport-height: friend-list.preferred-height;

                        friend-list := VerticalLayout {
                            padding: Spacing.xs;
                            spacing: Spacing.xxs;

                            for friend[idx] in root.available-friends: Rectangle {
                                height: max(Spacing.touch-target-min, 48px * Appearance.text-grow);
                                border-radius: Spacing.radius-sm;
                                background: friend.selected ? Colors.inset :
                                            (friend-touch.pressed ? Materials.pressed : friend-touch.has-hover ? Colors.surface-hover : transparent);
                                transform-scale-x: friend-touch.pressed ? 0.97 : 1;
                                transform-scale-y: friend-touch.pressed ? 0.94 : 1;
                                animate background { duration: Materials.motion-quick; easing: Materials.settle; }
                                animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                                animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                                friend-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-friend-selection(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: Spacing.sm;
                                    padding-right: Spacing.sm;
                                    spacing: Spacing.sm;

                                    // Checkbox
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 4px;
                                        border-width: Spacing.stroke;
                                        border-color: friend.selected ? Colors.action-fill : Colors.text-muted;
                                        background: friend.selected ? Colors.action-fill : transparent;
                                        y: (parent.height - self.height) / 2;

                                        if friend.selected: Image {
                                            source: Icons.check;
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            colorize: Colors.on-action;
                                        }
                                    }

                                    Avatar {
                                        size: 32px;
                                        source: friend.avatar-source;
                                        anonymous: friend.anonymous;
                                        name: friend.display-name;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: Spacing.xxs;

                                        Text {
                                            text: friend.display-name;
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: friend.username == "" ? "" : "@" + friend.username;
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            overflow: elide;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Rectangle {
                                            width: friend.selected ? role-text.preferred-width + Spacing.sm * 2 : 0px;
                                            height: Spacing.button-height;
                                            border-radius: Spacing.radius-sm;
                                            background: role-touch.has-hover ? (friend.role == "admin" ? Colors.warning.with-alpha(0.3) : Colors.surface) : (friend.role == "admin" ? Colors.warning.with-alpha(0.2) : Colors.surface-hover);
                                            opacity: friend.selected ? 1 : 0;
                                            clip: true;
                                            animate width { duration: Materials.motion-standard; easing: Materials.spring; }
                                            animate opacity { duration: Materials.motion-quick; easing: Materials.settle; }

                                            role-text := Text {
                                                text: friend.role == "admin" ? "Admin" : "Member";
                                                color: friend.role == "admin" ? Colors.warning : Colors.text-secondary;
                                                font-size: Typography.xs;
                                                font-weight: Typography.medium;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            role-touch := TouchArea {
                                                enabled: friend.selected;
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-friend-role(idx); }
                                            }

                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ============================================================
            // More options (collapsible) — hidden for private-group path
            // ============================================================
            if !root.is-private-group: VerticalLayout {
                spacing: Spacing.xs;

                Rectangle {
                    height: Spacing.button-height;
                    background: transparent;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: Spacing.xs;
                        alignment: center;

                        // Disclosure chevron — SVG, not a Unicode triangle
                        // (the glyph renders as a solid block on Android).
                        // Points right when collapsed, down when expanded.
                        Image {
                            source: Icons.chevron-right;
                            width: 14px;
                            height: 14px;
                            colorize: Colors.text-secondary;
                            transform-rotation: root.more-options-expanded ? 90deg : 0deg;
                            animate transform-rotation { duration: Materials.motion-standard; easing: Materials.spring; }
                        }

                        Text {
                            text: "More options";
                            wrap: no-wrap;
                            horizontal-stretch: 0;
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                            vertical-alignment: center;
                        }
                    }

                    more-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more-options-expanded = !root.more-options-expanded; }
                    }
                }

                if root.more-options-expanded: VerticalLayout {
                    spacing: Spacing.md;
                    padding-left: Spacing.sm;

                    // Auto-delete
                    VerticalLayout {
                        spacing: Spacing.xs;

                        HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            Checkbox {
                                checked <=> root.use-ephemeral;
                                label: "Auto-delete messages";
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.xxs;

                                Text {
                                    text: "Auto-delete messages";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: "Messages expire after the chosen time.";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }
                            }
                        }

                        if root.use-ephemeral: HorizontalLayout {
                            spacing: Spacing.xs;
                            padding-left: Spacing.xxl;
                            alignment: start;

                            Text {
                                text: "After";
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 60px;
                                height: 28px;
                                Input {
                                    width: 100%;
                                    height: 100%;
                                    placeholder: "24";
                                    text: root.ttl-hours;
                                    edited(t) => {
                                        root.ttl-hours = t.to-float();
                                    }
                                }
                            }

                            Text {
                                text: "hours";
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // AI assistant.
                    //
                    // FEAT-5: gated OFF by default on AiIntegrationGlobal,
                    // which mirrors the `ai-channel-template` Cargo feature.
                    // Nothing on this path can supply the provider API key the
                    // server requires, so ticking this box always produced a
                    // channel with no bot in it. Unimplemented is stated, not
                    // faked — see ui/ai/ai_global.slint.
                    if AiIntegrationGlobal.channel-template-enabled: VerticalLayout {
                        spacing: Spacing.xs;

                        HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            Checkbox {
                                checked <=> root.use-ai;
                                label: "Enable AI assistant";
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: Spacing.xxs;

                                Text {
                                    text: "AI assistant";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: "Add an AI bot that replies in this channel.";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }
                            }
                        }

                        if root.use-ai: VerticalLayout {
                            spacing: Spacing.sm;
                            padding-left: Spacing.xxl;

                            // Provider
                            HorizontalLayout {
                                spacing: Spacing.sm;

                                for provider in root.ai-providers: Rectangle {
                                    height: Spacing.button-height;
                                    horizontal-stretch: 1;
                                    border-radius: Spacing.radius-md;
                                    border-width: root.ai-provider == provider.id ? Spacing.stroke : 0px;
                                    border-color: Colors.primary;
                                    background: root.ai-provider == provider.id ? Colors.inset : (provider-touch.has-hover ? Colors.surface-hover : Colors.surface);

                                    Text {
                                        text: provider.name;
                                        color: root.ai-provider == provider.id ? Colors.primary : Colors.text-primary;
                                        font-size: Typography.xs;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    provider-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.ai-provider = provider.id;
                                            root.ai-model = "";
                                            root.provider-selected(provider.id);
                                        }
                                    }
                                }
                            }

                            // Model list
                            if root.ai-provider != "": VerticalLayout {
                                spacing: Spacing.xs;

                                if root.ai-models-loading: Text {
                                    text: "Loading models...";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }

                                if root.ai-models-error != "": VerticalLayout {
                                    spacing: Spacing.xxs;
                                    Text {
                                        text: root.ai-models-error;
                                        color: Colors.error;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                    Button {
                                        text: "Retry";
                                        variant: "secondary";
                                        clicked => { root.provider-selected(root.ai-provider); }
                                    }
                                }

                                Flickable {
                                    max-height: 120px;
                                    viewport-height: model-layout.preferred-height;

                                    model-layout := VerticalLayout {
                                        spacing: Spacing.xxs;

                                        for model in root.ai-models: Rectangle {
                                            height: Spacing.button-height;
                                            border-radius: Spacing.radius-sm;
                                            border-width: root.ai-model == model.id ? Spacing.stroke : 0px;
                                            border-color: Colors.primary;
                                            background: root.ai-model == model.id ? Colors.inset : (model-touch.has-hover ? Colors.surface-hover : Colors.surface);

                                            HorizontalLayout {
                                                padding-left: Spacing.sm;
                                                padding-right: Spacing.sm;

                                                Text {
                                                    text: model.name;
                                                    color: root.ai-model == model.id ? Colors.primary : Colors.text-primary;
                                                    font-size: Typography.xs;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            model-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.ai-model = model.id; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            } // create-body
            } // Flickable

            // ============================================================
            // Error banner
            // ============================================================
            if root.error-message != "" && root.channel-name != "": Text {
                text: root.error-message;
                color: Colors.error;
                font-size: Typography.sm;
                wrap: word-wrap;
            }

            // ============================================================
            // Footer
            // ============================================================
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.close(); }
                }

                // Private-group: uses dedicated callback + requires selected friends
                if root.is-private-group: Button {
                    text: root.loading ? "" : "Create group";
                    variant: "primary";
                    disabled: name-input.composed-text == "" || root.selected-friend-count == 0 || root.loading;
                    loading: root.loading;
                    clicked => {
                        if name-input.composed-text != "" && root.selected-friend-count > 0 && !root.loading {
                            root.create-private-group(name-input.composed-text, root.available-friends);
                        }
                    }
                }

                // Regular channel (open/invite): derive template string from state
                if !root.is-private-group: Button {
                    text: root.loading ? "" : "Create";
                    variant: "primary";
                    disabled: name-input.composed-text == "" || root.loading || (root.use-ai && (root.ai-provider == "" || root.ai-model == ""));
                    loading: root.loading;
                    clicked => {
                        if name-input.composed-text != "" && !root.loading && !(root.use-ai && (root.ai-provider == "" || root.ai-model == "")) {
                            root.create(
                                name-input.composed-text,
                                root.channel-description,
                                root.use-ai ? "ai-assistant" : (root.use-ephemeral ? "ephemeral" : "general"),
                                {
                                    is-private: root.is-invite,
                                    is-ephemeral: root.use-ephemeral,
                                    ttl-hours: root.ttl-hours,
                                    max-members: root.max-members,
                                    password: root.password,
                                    icon-url: root.icon-url,
                                },
                                root.use-ai ? root.ai-provider : "",
                                root.use-ai ? root.ai-model : ""
                            );
                        }
                    }
                }
            }
            }

            // ============================================================
            // JOIN TAB
            // ============================================================
            if root.active-tab == 1: VerticalLayout {
                spacing: Spacing.md;

                // Search input
                VerticalLayout {
                    spacing: Spacing.xs;
                    vertical-stretch: 0;

                    Text {
                        text: "Search channels, or paste a channel ID or invite link";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                    }

                    Input {
                        placeholder: "Name, channel ID or chatter://join/ link";
                        text <=> root.join-search-query;

                        edited(text) => {
                            root.join-search(text);
                        }

                        accepted(text) => {
                            if root.join-search-query.character-count >= 32 {
                                root.join-channel(root.join-search-query);
                            }
                        }
                    }
                }

                // Results take the sheet's spare height, keeping Create and
                // Join the same size while the selection slides between them.
                Rectangle {
                    vertical-stretch: 1;
                    // The children below are free-positioned at height: 100%,
                    // so on a phone-height dialog this box shrinks and its
                    // centred text spilled straight over the Cancel/Join
                    // footer (§112r). Floor the height and clip the overflow.
                    min-height: 104px;
                    clip: true;

                    // Loading state
                    if root.join-searching: Rectangle {
                        width: 100%;
                        height: 100%;

                        Text {
                            text: "Searching...";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Error state
                    if !root.join-searching && root.join-error != "": Rectangle {
                        width: 100%;
                        height: 100%;

                        Text {
                            text: root.join-error;
                            color: Colors.error;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Empty state
                    // A pasted invite link: nothing to search, Join uses it.
                    if !root.join-searching && root.join-error == "" && MembershipGlobal.join-input-is-link: Rectangle {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Spacing.sm;
                            alignment: center;

                            Text {
                                text: "Invite link";
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Press Join to use it. Anyone holding this link can join the channel.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                                width: 100%;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if !root.join-searching && root.join-error == "" && root.join-results.length == 0 && root.join-search-query != "" && !MembershipGlobal.join-input-is-link: Rectangle {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Spacing.sm;
                            alignment: center;

                            Text {
                                text: "No channels found";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Try a different search or paste a channel ID";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                                width: 100%;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Initial state (no search yet)
                    if !root.join-searching && root.join-search-query == "" && root.join-results.length == 0: Rectangle {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Spacing.sm;
                            alignment: center;

                            Text {
                                text: "Search for public channels";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Enter a channel name or paste a channel ID to join directly";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                                width: 100%;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Results list
                    if !root.join-searching && root.join-results.length > 0: Flickable {
                        viewport-height: join-results-layout.preferred-height;

                        join-results-layout := VerticalLayout {
                            spacing: Spacing.sm;

                            for channel in root.join-results: SearchResultItem {
                                channel-id: channel.id;
                                name: channel.name;
                                description: channel.description;
                                member-count: channel.member-count;
                                icon: channel.icon;
                                has-icon: channel.has-icon;
                                selected: channel.id == root.join-selected-id;

                                clicked => {
                                    root.join-selected-id = channel.id;
                                }
                            }
                        }
                    }
                }

                // Footer with action buttons
                HorizontalLayout {
                    spacing: Spacing.md;
                    height: 40px;

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Cancel";
                        variant: "secondary";
                        clicked => { root.close(); }
                    }

                    Button {
                        text: root.join-joining ? "" : "Join";
                        variant: "primary";
                        disabled: root.join-selected-id == "" || root.join-joining;
                        loading: root.join-joining;

                        clicked => {
                            if root.join-selected-id != "" && !root.join-joining {
                                root.join-channel(root.join-selected-id);
                            }
                        }
                    }
                }
            }
        }
    }
}
