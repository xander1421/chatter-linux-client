// CreateChannelModal - Single-page adaptive form.
//
// UX: one-step form with access-model pills (Open / Invite-only / Private group),
// inline reveal for password/TTL/AI, collapsible "More options". Private-group
// path swaps the main form area in place for the friend picker.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { SearchResultChannel, SearchResultItem } from "join_channel.slint";

// Friend data for private group selection (matches FriendData)
export struct PrivateGroupFriend {
    user-id: string,
    display-name: string,
    username: string,
    selected: bool,
    role: string,
}

export struct AIProviderOption {
    id: string,
    name: string,
}

export struct AIModelOption {
    id: string,
    name: string,
    provider: string,
}

// Simplified config. Encryption + friends-only derived from access model.
export struct CreateChannelConfig {
    is-private: bool,
    is-ephemeral: bool,
    ttl-hours: int,
    max-members: int,
    password: string,
    icon-url: string,
}

export component CreateChannelModal inherits Rectangle {
    in property <bool> show-modal: false;
    in-out property <string> channel-name: "";
    in-out property <string> channel-description: "";
    in-out property <string> selected-template: "";
    in property <string> error-message: "";
    in property <bool> loading: false;

    // Access mode: "open" | "invite" | "private-group"
    in-out property <string> access-mode: "open";

    // Advanced toggles
    in-out property <bool> use-ephemeral: false;
    in-out property <int> ttl-hours: 24;
    in-out property <bool> use-ai: false;
    in-out property <int> max-members: 0;
    in-out property <string> password: "";

    // Icon upload state
    in-out property <string> icon-url: "";
    in-out property <image> icon-preview;
    in-out property <bool> has-icon-preview: false;

    // AI provider/model lists
    in-out property <string> ai-provider: "";
    in-out property <string> ai-model: "";
    in property <[AIProviderOption]> ai-providers: [
        { id: "claude", name: "Claude (Anthropic)" },
        { id: "openai", name: "OpenAI" },
        { id: "ollama", name: "Ollama (Local)" },
    ];
    in property <[AIModelOption]> ai-models: [];
    in property <bool> ai-models-loading: false;
    in property <string> ai-models-error: "";

    // Private-group friend picker state
    in-out property <[PrivateGroupFriend]> available-friends: [];
    in-out property <int> selected-friend-count: 0;

    // Tab switcher: 0 = Create, 1 = Join
    in-out property <int> active-tab: 0;
    // Join tab state
    in-out property <string> join-search-query: "";
    in property <[SearchResultChannel]> join-results: [];
    in property <bool> join-searching: false;
    in property <string> join-error: "";
    in-out property <string> join-selected-id: "";
    in property <bool> join-joining: false;
    callback join-search(string);
    callback join-channel(string);

    callback close();
    // name, description, template, config, ai_provider, ai_model
    callback create(string, string, string, CreateChannelConfig, string, string);
    callback provider-selected(string);
    callback pick-channel-icon();
    callback create-private-group(string, [PrivateGroupFriend]);
    callback toggle-friend-selection(int);
    callback toggle-friend-role(int);
    callback template-selected(string);  // fires when access-mode becomes "private-group" — used by Rust to preload friends

    // Derived flags
    property <bool> is-private-group: root.access-mode == "private-group";
    property <bool> is-invite: root.access-mode == "invite";
    property <bool> is-open: root.access-mode == "open";

    // Collapsible "More options"
    property <bool> more-options-expanded: false;

    // Reset on close
    changed show-modal => {
        if !show-modal {
            root.channel-name = "";
            root.channel-description = "";
            root.selected-template = "";
            root.access-mode = "open";
            root.use-ephemeral = false;
            root.ttl-hours = 24;
            root.use-ai = false;
            root.max-members = 0;
            root.password = "";
            root.icon-url = "";
            root.has-icon-preview = false;
            root.ai-provider = "";
            root.ai-model = "";
            root.more-options-expanded = false;
            root.active-tab = 0;
            root.join-selected-id = "";
            root.join-search-query = "";
        }
    }

    // Selecting private-group pill loads friend list via Rust.
    changed access-mode => {
        if root.access-mode == "private-group" {
            root.template-selected("private-group");
        }
    }

    Modal {
        show: root.show-modal;
        title: "New channel";
        modal-width: 620px;
        max-modal-height: 720px;

        close => { root.close(); }

        VerticalLayout {
            spacing: Spacing.md;

            // ============================================================
            // Tab switcher: Create | Join
            // ============================================================
            HorizontalLayout {
                height: 34px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Spacing.radius-md;
                    background: root.active-tab == 0 ? Colors.surface-hover : transparent;
                    border-width: 1px;
                    border-color: root.active-tab == 0 ? Colors.neo-highlight-strong : transparent;

                    Text {
                        text: "Create";
                        color: root.active-tab == 0 ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.sm;
                        font-weight: root.active-tab == 0 ? Typography.semibold : Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    create-tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = 0; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Spacing.radius-md;
                    background: root.active-tab == 1 ? Colors.surface-hover : transparent;
                    border-width: 1px;
                    border-color: root.active-tab == 1 ? Colors.neo-highlight-strong : transparent;

                    Text {
                        text: "Join";
                        color: root.active-tab == 1 ? Colors.text-primary : Colors.text-secondary;
                        font-size: Typography.sm;
                        font-weight: root.active-tab == 1 ? Typography.semibold : Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    join-tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = 1; }
                    }
                }
            }

            // ============================================================
            // CREATE TAB
            // ============================================================
            if root.active-tab == 0: VerticalLayout {
            spacing: Spacing.md;

            // ============================================================
            // Scrollable body. The error banner and the Create/Cancel footer
            // live OUTSIDE this Flickable so they stay pinned and reachable
            // even when the viewport is short (Android landscape).
            // ============================================================
            Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: create-body.preferred-height;

            create-body := VerticalLayout {
            spacing: Spacing.lg;

            // ============================================================
            // Identity row: icon + name + description
            // ============================================================
            HorizontalLayout {
                spacing: Spacing.md;

                // Icon upload (64px)
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    spacing: Spacing.xs;

                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: Spacing.radius-md;
                        background: Colors.neo-inset-bg;
                        border-width: 1px;
                        border-color: icon-touch.has-hover ? Colors.glow-primary : Colors.neo-inset-shadow;
                        clip: true;

                        if root.has-icon-preview: Image {
                            source: root.icon-preview;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if !root.has-icon-preview: Image {
                            source: Icons.image;
                            width: 24px;
                            height: 24px;
                            colorize: Colors.text-muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        icon-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-channel-icon(); }
                        }
                    }

                    Text {
                        text: root.has-icon-preview ? "Change" : "Upload";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        width: 64px;
                    }
                }

                // Name + description stack
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Spacing.sm;

                    Input {
                        placeholder: root.is-private-group ? "Group name" : "Channel name (e.g. team-updates)";
                        text <=> root.channel-name;
                        error: root.error-message != "" && root.channel-name == "";
                        error-message: root.error-message != "" && root.channel-name == "" ? "Name is required" : "";
                    }

                    if !root.is-private-group: Input {
                        placeholder: "Description (optional)";
                        text <=> root.channel-description;
                    }
                }
            }

            // ============================================================
            // Access model — 3 pills
            // ============================================================
            VerticalLayout {
                spacing: Spacing.xs;

                Text {
                    text: "Who can join?";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                }

                HorizontalLayout {
                    spacing: Spacing.sm;

                    // Open
                    Rectangle {
                        height: 80px;
                        horizontal-stretch: 1;
                        border-radius: Spacing.radius-md;
                        border-width: 1px;
                        border-color: root.is-open ? Colors.glow-cyan.with-alpha(0.5) : Colors.neo-inset-shadow;
                        background: root.is-open ? Colors.neo-inset-bg : (open-touch.has-hover ? Colors.surface-hover : Colors.surface);

                        VerticalLayout {
                            padding: Spacing.sm;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                Image {
                                    source: Icons.globe;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-open ? Colors.primary : Colors.text-secondary;
                                }
                                Text {
                                    text: "Open";
                                    color: root.is-open ? Colors.primary : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Anyone finds and joins. History visible to joiners.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        open-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.access-mode = "open"; }
                        }
                    }

                    // Invite-only
                    Rectangle {
                        height: 80px;
                        horizontal-stretch: 1;
                        border-radius: Spacing.radius-md;
                        border-width: 1px;
                        border-color: root.is-invite ? Colors.glow-cyan.with-alpha(0.5) : Colors.neo-inset-shadow;
                        background: root.is-invite ? Colors.neo-inset-bg : (invite-touch.has-hover ? Colors.surface-hover : Colors.surface);

                        VerticalLayout {
                            padding: Spacing.sm;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                Image {
                                    source: Icons.lock;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-invite ? Colors.primary : Colors.text-secondary;
                                }
                                Text {
                                    text: "Invite-only";
                                    color: root.is-invite ? Colors.primary : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Hidden from discovery. Invite or password to join.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        invite-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.access-mode = "invite"; }
                        }
                    }

                    // Private group
                    Rectangle {
                        height: 80px;
                        horizontal-stretch: 1;
                        border-radius: Spacing.radius-md;
                        border-width: 1px;
                        border-color: root.is-private-group ? Colors.group-accent.with-alpha(0.6) : Colors.neo-inset-shadow;
                        background: root.is-private-group ? Colors.neo-inset-bg : (pg-touch.has-hover ? Colors.surface-hover : Colors.surface);

                        VerticalLayout {
                            padding: Spacing.sm;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: Spacing.xs;
                                Image {
                                    source: Icons.shield;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-private-group ? Colors.group-accent : Colors.text-secondary;
                                }
                                Text {
                                    text: "Anon group";
                                    color: root.is-private-group ? Colors.group-accent : Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "End-to-end encrypted. Server can't see it exists.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        pg-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.access-mode = "private-group"; }
                        }
                    }
                }

                // Encryption badge (open = no badge; invite/private-group = encrypted badge)
                if root.is-invite || root.is-private-group: HorizontalLayout {
                    spacing: Spacing.xs;
                    alignment: start;
                    Image {
                        source: Icons.shield;
                        width: 12px;
                        height: 12px;
                        colorize: Colors.success;
                        y: 2px;
                    }
                    Text {
                        text: "End-to-end encrypted";
                        color: Colors.success;
                        font-size: Typography.xs;
                    }
                }
            }

            // ============================================================
            // Invite-only → password reveal
            // ============================================================
            if root.is-invite: VerticalLayout {
                spacing: Spacing.xs;

                Text {
                    text: "Password (optional)";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: Typography.medium;
                }

                Input {
                    placeholder: "Anyone with password joins without invite";
                    text <=> root.password;
                }
            }

            // ============================================================
            // Private group → friend picker
            // ============================================================
            if root.is-private-group: VerticalLayout {
                spacing: Spacing.sm;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    Text {
                        text: "Select friends to invite";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        font-weight: Typography.medium;
                    }

                    Text {
                        text: "(" + root.selected-friend-count + " selected)";
                        color: Colors.primary;
                        font-size: Typography.sm;
                    }
                }

                Rectangle {
                    min-height: 160px;
                    max-height: 260px;
                    vertical-stretch: 1;
                    background: Colors.neo-inset-bg;
                    border-radius: Spacing.radius-md;
                    border-width: 1px;
                    border-color: Colors.neo-inset-shadow;
                    clip: true;

                    if root.available-friends.length == 0: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "No friends yet";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Add friends first to create a private group";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                        }
                    }

                    Flickable {
                        viewport-height: friend-list.preferred-height;

                        friend-list := VerticalLayout {
                            padding: Spacing.xs;
                            spacing: 2px;

                            for friend[idx] in root.available-friends: Rectangle {
                                height: 48px;
                                border-radius: Spacing.radius-sm;
                                background: friend.selected ? Colors.neo-inset-bg :
                                            (friend-touch.has-hover ? Colors.surface-hover : transparent);
                                border-width: friend.selected || friend-touch.has-hover ? 1px : 0px;
                                border-color: friend.selected ? Colors.glow-primary : Colors.neo-highlight;

                                friend-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-friend-selection(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: Spacing.sm;
                                    padding-right: Spacing.sm;
                                    spacing: Spacing.sm;

                                    // Checkbox
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 4px;
                                        border-width: 2px;
                                        border-color: friend.selected ? Colors.primary : Colors.text-muted;
                                        background: friend.selected ? Colors.primary : transparent;
                                        y: (parent.height - self.height) / 2;

                                        if friend.selected: Image {
                                            source: Icons.check;
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            colorize: Colors.text-primary;
                                        }
                                    }

                                    Avatar {
                                        size: 32px;
                                        fallback-text: friend.display-name;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: friend.display-name;
                                            color: Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: friend.username == "" ? "" : "@" + friend.username;
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                            overflow: elide;
                                        }
                                    }

                                    if friend.selected: Rectangle {
                                        width: role-text.width + Spacing.sm * 2;
                                        height: 24px;
                                        border-radius: Spacing.radius-sm;
                                        background: role-touch.has-hover ? (friend.role == "admin" ? Colors.warning.with-alpha(0.3) : Colors.surface) : (friend.role == "admin" ? Colors.warning.with-alpha(0.2) : Colors.surface-hover);
                                        border-width: 1px;
                                        border-color: friend.role == "admin" ? Colors.warning.with-alpha(0.5) : Colors.text-muted.with-alpha(0.3);

                                        role-text := Text {
                                            text: friend.role == "admin" ? "Admin" : "Member";
                                            color: friend.role == "admin" ? Colors.warning : Colors.text-secondary;
                                            font-size: Typography.xs;
                                            font-weight: Typography.medium;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        role-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-friend-role(idx); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ============================================================
            // More options (collapsible) — hidden for private-group path
            // ============================================================
            if !root.is-private-group: VerticalLayout {
                spacing: Spacing.xs;

                Rectangle {
                    height: 28px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: Spacing.xs;
                        alignment: start;

                        // Disclosure chevron — SVG, not a Unicode triangle
                        // (the glyph renders as a solid block on Android).
                        // Points right when collapsed, down when expanded.
                        Image {
                            source: Icons.chevron-right;
                            width: 14px;
                            height: 14px;
                            colorize: Colors.text-secondary;
                            transform-rotation: root.more-options-expanded ? 90deg : 0deg;
                        }

                        Text {
                            text: "More options";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                            vertical-alignment: center;
                        }
                    }

                    more-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more-options-expanded = !root.more-options-expanded; }
                    }
                }

                if root.more-options-expanded: VerticalLayout {
                    spacing: Spacing.md;
                    padding-left: Spacing.sm;

                    // Auto-delete
                    VerticalLayout {
                        spacing: Spacing.xs;

                        HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 2px;
                                border-color: root.use-ephemeral ? Colors.primary : Colors.text-muted;
                                background: root.use-ephemeral ? Colors.primary : transparent;
                                y: (parent.height - self.height) / 2;

                                if root.use-ephemeral: Image {
                                    source: Icons.check;
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Colors.text-primary;
                                }

                                ephemeral-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.use-ephemeral = !root.use-ephemeral; }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Auto-delete messages";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: "Messages expire after the chosen time.";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }
                            }
                        }

                        if root.use-ephemeral: HorizontalLayout {
                            spacing: Spacing.xs;
                            padding-left: 32px;
                            alignment: start;

                            Text {
                                text: "After";
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 60px;
                                height: 28px;
                                Input {
                                    width: 100%;
                                    height: 100%;
                                    placeholder: "24";
                                    text: root.ttl-hours;
                                    edited(t) => {
                                        root.ttl-hours = t.to-float();
                                    }
                                }
                            }

                            Text {
                                text: "hours";
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // AI assistant
                    VerticalLayout {
                        spacing: Spacing.xs;

                        HorizontalLayout {
                            spacing: Spacing.sm;
                            alignment: start;

                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 2px;
                                border-color: root.use-ai ? Colors.primary : Colors.text-muted;
                                background: root.use-ai ? Colors.primary : transparent;
                                y: (parent.height - self.height) / 2;

                                if root.use-ai: Image {
                                    source: Icons.check;
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Colors.text-primary;
                                }

                                ai-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.use-ai = !root.use-ai;
                                        if root.use-ai && root.ai-provider != "" {
                                            root.provider-selected(root.ai-provider);
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "AI assistant";
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                }

                                Text {
                                    text: "Add an AI bot that replies in this channel.";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }
                            }
                        }

                        if root.use-ai: VerticalLayout {
                            spacing: Spacing.sm;
                            padding-left: 32px;

                            // Provider
                            HorizontalLayout {
                                spacing: Spacing.sm;

                                for provider in root.ai-providers: Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: root.ai-provider == provider.id ? Colors.glow-cyan.with-alpha(0.4) : Colors.neo-inset-shadow;
                                    background: root.ai-provider == provider.id ? Colors.neo-inset-bg : (provider-touch.has-hover ? Colors.surface-hover : Colors.surface);

                                    Text {
                                        text: provider.name;
                                        color: root.ai-provider == provider.id ? Colors.primary : Colors.text-primary;
                                        font-size: Typography.xs;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    provider-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.ai-provider = provider.id;
                                            root.ai-model = "";
                                            root.provider-selected(provider.id);
                                        }
                                    }
                                }
                            }

                            // Model list
                            if root.ai-provider != "": VerticalLayout {
                                spacing: Spacing.xs;

                                if root.ai-models-loading: Text {
                                    text: "Loading models...";
                                    color: Colors.text-muted;
                                    font-size: Typography.xs;
                                }

                                if root.ai-models-error != "": VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: root.ai-models-error;
                                        color: Colors.error;
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                    Button {
                                        text: "Retry";
                                        variant: "secondary";
                                        clicked => { root.provider-selected(root.ai-provider); }
                                    }
                                }

                                Flickable {
                                    max-height: 120px;
                                    viewport-height: model-layout.preferred-height;

                                    model-layout := VerticalLayout {
                                        spacing: 2px;

                                        for model in root.ai-models: Rectangle {
                                            height: 32px;
                                            border-radius: Spacing.radius-sm;
                                            border-width: 1px;
                                            border-color: root.ai-model == model.id ? Colors.glow-cyan.with-alpha(0.4) : Colors.neo-inset-shadow;
                                            background: root.ai-model == model.id ? Colors.neo-inset-bg : (model-touch.has-hover ? Colors.surface-hover : Colors.surface);

                                            HorizontalLayout {
                                                padding-left: Spacing.sm;
                                                padding-right: Spacing.sm;

                                                Text {
                                                    text: model.name;
                                                    color: root.ai-model == model.id ? Colors.primary : Colors.text-primary;
                                                    font-size: Typography.xs;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            model-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.ai-model = model.id; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            } // create-body
            } // Flickable

            // ============================================================
            // Error banner
            // ============================================================
            if root.error-message != "" && root.channel-name != "": Text {
                text: root.error-message;
                color: Colors.error;
                font-size: Typography.sm;
                wrap: word-wrap;
            }

            // ============================================================
            // Footer
            // ============================================================
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.close(); }
                }

                // Private-group: uses dedicated callback + requires selected friends
                if root.is-private-group: Button {
                    text: root.loading ? "" : "Create group";
                    variant: "primary";
                    disabled: root.channel-name == "" || root.selected-friend-count == 0 || root.loading;
                    loading: root.loading;
                    clicked => {
                        if root.channel-name != "" && root.selected-friend-count > 0 && !root.loading {
                            root.create-private-group(root.channel-name, root.available-friends);
                        }
                    }
                }

                // Regular channel (open/invite): derive template string from state
                if !root.is-private-group: Button {
                    text: root.loading ? "" : "Create";
                    variant: "primary";
                    disabled: root.channel-name == "" || root.loading || (root.use-ai && (root.ai-provider == "" || root.ai-model == ""));
                    loading: root.loading;
                    clicked => {
                        if root.channel-name != "" && !root.loading && !(root.use-ai && (root.ai-provider == "" || root.ai-model == "")) {
                            root.create(
                                root.channel-name,
                                root.channel-description,
                                root.use-ai ? "ai-assistant" : (root.use-ephemeral ? "ephemeral" : "general"),
                                {
                                    is-private: root.is-invite,
                                    is-ephemeral: root.use-ephemeral,
                                    ttl-hours: root.ttl-hours,
                                    max-members: root.max-members,
                                    password: root.password,
                                    icon-url: root.icon-url,
                                },
                                root.use-ai ? root.ai-provider : "",
                                root.use-ai ? root.ai-model : ""
                            );
                        }
                    }
                }
            }
            }

            // ============================================================
            // JOIN TAB
            // ============================================================
            if root.active-tab == 1: VerticalLayout {
                spacing: Spacing.md;

                // Search input
                VerticalLayout {
                    spacing: Spacing.xs;

                    Text {
                        text: "Search channels or enter channel ID";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                    }

                    Input {
                        placeholder: "Search by name or paste channel ID...";
                        text <=> root.join-search-query;

                        edited(text) => {
                            root.join-search(text);
                        }

                        accepted(text) => {
                            if root.join-search-query.character-count >= 32 {
                                root.join-channel(root.join-search-query);
                            }
                        }
                    }
                }

                // Results area. No min-height: it already scrolls internally,
                // and a floor here would push the Join footer off-screen in
                // landscape. vertical-stretch still gives it all spare room.
                Rectangle {
                    vertical-stretch: 1;
                    max-height: 320px;

                    // Loading state
                    if root.join-searching: Rectangle {
                        width: 100%;
                        height: 100%;

                        Text {
                            text: "Searching...";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Error state
                    if !root.join-searching && root.join-error != "": Rectangle {
                        width: 100%;
                        height: 100%;

                        Text {
                            text: root.join-error;
                            color: Colors.error;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Empty state
                    if !root.join-searching && root.join-error == "" && root.join-results.length == 0 && root.join-search-query != "": Rectangle {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Spacing.sm;
                            alignment: center;

                            Text {
                                text: "No channels found";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Try a different search or paste a channel ID";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Initial state (no search yet)
                    if !root.join-searching && root.join-search-query == "" && root.join-results.length == 0: Rectangle {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Spacing.sm;
                            alignment: center;

                            Text {
                                text: "Search for public channels";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Enter a channel name or paste a channel ID to join directly";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Results list
                    if !root.join-searching && root.join-results.length > 0: Flickable {
                        viewport-height: join-results-layout.preferred-height;

                        join-results-layout := VerticalLayout {
                            spacing: Spacing.sm;

                            for channel in root.join-results: SearchResultItem {
                                channel-id: channel.id;
                                name: channel.name;
                                description: channel.description;
                                member-count: channel.member-count;
                                icon: channel.icon;
                                has-icon: channel.has-icon;
                                selected: channel.id == root.join-selected-id;

                                clicked => {
                                    root.join-selected-id = channel.id;
                                }
                            }
                        }
                    }
                }

                // Footer with action buttons
                HorizontalLayout {
                    spacing: Spacing.md;
                    height: 40px;

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Cancel";
                        variant: "secondary";
                        clicked => { root.close(); }
                    }

                    Button {
                        text: root.join-joining ? "" : "Join";
                        variant: "primary";
                        disabled: root.join-selected-id == "" || root.join-joining;
                        loading: root.join-joining;

                        clicked => {
                            if root.join-selected-id != "" && !root.join-joining {
                                root.join-channel(root.join-selected-id);
                            }
                        }
                    }
                }
            }
        }
    }
}
