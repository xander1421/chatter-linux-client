// CreateChannelModal - Two-step wizard for creating new channels

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { ChannelTemplates } from "channel_templates.slint";

// Friend data for private group selection (matches FriendData)
export struct PrivateGroupFriend {
    user-id: string,
    display-name: string,
    username: string,
    avatar-url: string,
    selected: bool,
    role: string,  // "member" or "admin" - default is "member"
}

// AI provider option
export struct AIProviderOption {
    id: string,
    name: string,
}

// AI model option
export struct AIModelOption {
    id: string,
    name: string,
    provider: string,
}

// Channel configuration for creation (UI struct, distinct from domain::ChannelConfig)
export struct CreateChannelConfig {
    is-private: bool,
    is-encrypted: bool,
    is-ephemeral: bool,
    ttl-hours: int,        // Message TTL in hours (if ephemeral)
    max-members: int,      // 0 = unlimited
    password: string,      // For password-protected channels
    friends-only: bool,
    icon-url: string,      // URL for custom channel icon
}

export component CreateChannelModal inherits Rectangle {
    in property <bool> show-modal: false;
    in-out property <string> channel-name: "";
    in-out property <string> channel-description: "";
    in-out property <string> selected-template: "";
    in property <string> error-message: "";
    in property <bool> loading: false;

    // Channel configuration
    in-out property <bool> is-private: false;
    in-out property <bool> is-encrypted: true;  // Default: encrypted
    in-out property <bool> is-ephemeral: false;
    in-out property <int> ttl-hours: 24;        // Default: 24h
    in-out property <int> max-members: 0;       // 0 = unlimited
    in-out property <string> password: "";
    in-out property <bool> friends-only: false;
    in-out property <string> icon-url: "";      // Custom channel icon URL

    // AI configuration (for ai-assistant template)
    in-out property <string> ai-provider: "";
    in-out property <string> ai-model: "";
    in property <[AIProviderOption]> ai-providers: [
        { id: "claude", name: "Claude (Anthropic)" },
        { id: "openai", name: "OpenAI" },
        { id: "ollama", name: "Ollama (Local)" },
    ];
    in property <[AIModelOption]> ai-models: [];

    // Private group configuration (for private-group template)
    in-out property <[PrivateGroupFriend]> available-friends: [];
    // Count is updated by Rust when friends are toggled
    in-out property <int> selected-friend-count: 0;

    callback close();
    // name, description, template, config, ai_provider, ai_model
    callback create(string, string, string, CreateChannelConfig, string, string);
    callback provider-selected(string);  // Callback to load models for provider
    callback create-private-group(string, [PrivateGroupFriend]);  // name, selected friends
    callback toggle-friend-selection(int);  // index to toggle selection
    callback toggle-friend-role(int);  // index to toggle role (member/admin)
    callback template-selected(string);  // notify rust when template changes

    // Internal state
    property <int> current-step: 1;
    property <bool> is-ai-template: root.selected-template == "ai-assistant";
    property <bool> is-private-group: root.selected-template == "private-group";
    property <int> total-steps: is-ai-template ? 3 : 2;

    // Reset state when modal closes
    changed show-modal => {
        if !show-modal {
            current-step = 1;
            root.channel-name = "";
            root.channel-description = "";
            root.selected-template = "";
            root.is-private = false;
            root.is-encrypted = true;
            root.is-ephemeral = false;
            root.ttl-hours = 24;
            root.max-members = 0;
            root.password = "";
            root.friends-only = false;
            root.icon-url = "";
            root.ai-provider = "";
            root.ai-model = "";
        }
    }

    Modal {
        show: root.show-modal;
        title: "Create Channel";
        modal-width: 620px;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.lg;

            // Step indicator
            HorizontalLayout {
                spacing: Spacing.sm;
                height: 24px;

                // Step 1 indicator
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-full;
                    background: current-step >= 1 ? Colors.primary : Colors.surface-hover;

                    Text {
                        text: "1";
                        color: Colors.text-primary;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Text {
                    text: "Template";
                    color: current-step == 1 ? Colors.text-primary : Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: current-step == 1 ? Typography.semibold : Typography.normal;
                    vertical-alignment: center;
                }

                // Connector line 1->2
                Rectangle {
                    width: 24px;
                    height: 2px;
                    background: current-step >= 2 ? Colors.primary : Colors.text-muted.with-alpha(0.3);
                    y: (parent.height - self.height) / 2;
                }

                // Step 2 indicator
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-full;
                    background: current-step >= 2 ? Colors.primary : Colors.surface-hover;

                    Text {
                        text: "2";
                        color: Colors.text-primary;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                Text {
                    text: "Details";
                    color: current-step == 2 ? Colors.text-primary : Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: current-step == 2 ? Typography.semibold : Typography.normal;
                    vertical-alignment: center;
                }

                // Step 3 indicator (AI template only)
                if root.is-ai-template: Rectangle {
                    width: 24px;
                    height: 2px;
                    background: current-step >= 3 ? Colors.primary : Colors.text-muted.with-alpha(0.3);
                    y: (parent.height - self.height) / 2;
                }

                if root.is-ai-template: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Spacing.radius-full;
                    background: current-step >= 3 ? Colors.primary : Colors.surface-hover;

                    Text {
                        text: "3";
                        color: Colors.text-primary;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                if root.is-ai-template: Text {
                    text: "AI Config";
                    color: current-step == 3 ? Colors.text-primary : Colors.text-secondary;
                    font-size: Typography.sm;
                    font-weight: current-step == 3 ? Typography.semibold : Typography.normal;
                    vertical-alignment: center;
                }
            }

            // Content area
            Rectangle {
                vertical-stretch: 1;
                min-height: 280px;

                // Step 1: Template selection
                if current-step == 1: ChannelTemplates {
                    selected-template <=> root.selected-template;

                    template-selected(template) => {
                        // Notify Rust when template is selected (for loading friends list)
                        root.template-selected(template);
                    }
                }

                // Step 2: Private Group - Friend selection
                if current-step == 2 && root.is-private-group: VerticalLayout {
                    spacing: Spacing.md;

                    // Header with privacy info
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        height: 40px;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: Spacing.radius-md;
                            background: #9333ea.with-alpha(0.15);

                            Image {
                                source: Icons.shield;
                                width: 20px;
                                height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: #9333ea;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Private Group";
                                color: Colors.text-primary;
                                font-size: Typography.base;
                                font-weight: Typography.semibold;
                            }

                            Text {
                                text: "Server cannot see this group exists";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                            }
                        }
                    }

                    // Group name input
                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Group Name";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        Input {
                            placeholder: "e.g., Close Friends";
                            text <=> root.channel-name;
                            error: root.error-message != "" && root.channel-name == "";
                            error-message: root.error-message != "" && root.channel-name == "" ? "Name is required" : "";
                        }
                    }

                    // Friend selection header
                    HorizontalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: "Select Friends to Invite";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        Text {
                            text: "(" + root.selected-friend-count + " selected)";
                            color: Colors.primary;
                            font-size: Typography.sm;
                        }
                    }

                    // Friend list (scrollable)
                    Rectangle {
                        vertical-stretch: 1;
                        background: Colors.surface;
                        border-radius: Spacing.radius-md;
                        border-width: 1px;
                        border-color: Colors.text-muted.with-alpha(0.2);
                        clip: true;

                        if root.available-friends.length == 0: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "No friends yet";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Add friends first to create a private group";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                            }
                        }

                        Flickable {
                            viewport-height: friend-list.preferred-height;

                            friend-list := VerticalLayout {
                                padding: Spacing.xs;
                                spacing: 2px;

                                for friend[idx] in root.available-friends: Rectangle {
                                    height: 48px;
                                    border-radius: Spacing.radius-sm;
                                    background: friend-touch.has-hover ? Colors.surface-hover :
                                                (friend.selected ? Colors.primary.with-alpha(0.1) : transparent);
                                    border-width: friend.selected ? 1px : 0px;
                                    border-color: Colors.primary.with-alpha(0.3);

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;
                                        spacing: Spacing.sm;

                                        // Checkbox
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 4px;
                                            border-width: 2px;
                                            border-color: friend.selected ? Colors.primary : Colors.text-muted;
                                            background: friend.selected ? Colors.primary : transparent;
                                            y: (parent.height - self.height) / 2;

                                            if friend.selected: Image {
                                                source: Icons.check;
                                                width: 12px;
                                                height: 12px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Colors.text-primary;
                                            }
                                        }

                                        // Avatar
                                        Avatar {
                                            size: 32px;
                                            fallback-text: friend.display-name;
                                        }

                                        // Name
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: friend.display-name;
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: "@" + friend.username;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                                overflow: elide;
                                            }
                                        }

                                        // Role selector (only shown when selected)
                                        if friend.selected: Rectangle {
                                            width: role-text.width + Spacing.sm * 2;
                                            height: 24px;
                                            border-radius: Spacing.radius-sm;
                                            background: friend.role == "admin" ? Colors.warning.with-alpha(0.2) : Colors.surface-hover;
                                            border-width: 1px;
                                            border-color: friend.role == "admin" ? Colors.warning.with-alpha(0.5) : Colors.text-muted.with-alpha(0.3);

                                            role-text := Text {
                                                text: friend.role == "admin" ? "Admin" : "Member";
                                                color: friend.role == "admin" ? Colors.warning : Colors.text-secondary;
                                                font-size: Typography.xs;
                                                font-weight: Typography.medium;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            role-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.toggle-friend-role(idx);
                                                }
                                            }
                                        }
                                    }

                                    friend-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.toggle-friend-selection(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Step 2: Regular channel details form
                if current-step == 2 && !root.is-private-group: VerticalLayout {
                    spacing: Spacing.md;

                    // Selected template indicator
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        height: 32px;

                        Text {
                            text: "Template:";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            background: Colors.primary.with-alpha(0.2);
                            border-radius: Spacing.radius-sm;
                            width: template-label.width + Spacing.md * 2;
                            height: 24px;

                            template-label := Text {
                                x: Spacing.md;
                                text: root.selected-template;
                                color: Colors.primary;
                                font-size: Typography.xs;
                                font-weight: Typography.medium;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }
                    }

                    // Channel name input
                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Channel Name";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        Input {
                            placeholder: "e.g., team-updates";
                            text <=> root.channel-name;
                            error: root.error-message != "" && root.channel-name == "";
                            error-message: root.error-message != "" && root.channel-name == "" ? "Name is required" : "";
                        }
                    }

                    // Channel description input
                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Description (optional)";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        Input {
                            placeholder: "What's this channel about?";
                            text <=> root.channel-description;
                        }
                    }

                    // Channel icon URL input
                    VerticalLayout {
                        spacing: Spacing.xs;

                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Image {
                                source: Icons.link;
                                width: 16px;
                                height: 16px;
                                colorize: Colors.text-secondary;
                                y: 2px;
                            }

                            Text {
                                text: "Channel Icon URL (optional)";
                                color: Colors.text-secondary;
                                font-size: Typography.sm;
                                font-weight: Typography.medium;
                            }
                        }

                        Input {
                            placeholder: "https://example.com/icon.png";
                            text <=> root.icon-url;
                        }
                    }

                    // Visibility toggle (Public / Private)
                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Visibility";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        HorizontalLayout {
                            spacing: Spacing.sm;

                            // Public option
                            Rectangle {
                                height: 40px;
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-md;
                                border-width: !root.is-private ? 2px : 1px;
                                border-color: !root.is-private ? Colors.primary : Colors.text-muted.with-alpha(0.3);
                                background: public-touch.has-hover ? Colors.surface-hover : Colors.surface;

                                HorizontalLayout {
                                    padding-left: Spacing.md;
                                    spacing: Spacing.sm;

                                    Image {
                                        source: Icons.globe;
                                        width: 20px;
                                        height: 20px;
                                        colorize: !root.is-private ? Colors.primary : Colors.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Public";
                                            color: !root.is-private ? Colors.primary : Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Anyone can join";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                        }
                                    }
                                }

                                public-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is-private = false;
                                    }
                                }
                            }

                            // Private option
                            Rectangle {
                                height: 40px;
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-md;
                                border-width: root.is-private ? 2px : 1px;
                                border-color: root.is-private ? Colors.primary : Colors.text-muted.with-alpha(0.3);
                                background: private-touch.has-hover ? Colors.surface-hover : Colors.surface;

                                HorizontalLayout {
                                    padding-left: Spacing.md;
                                    spacing: Spacing.sm;

                                    Image {
                                        source: Icons.lock;
                                        width: 20px;
                                        height: 20px;
                                        colorize: root.is-private ? Colors.primary : Colors.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Private";
                                            color: root.is-private ? Colors.primary : Colors.text-primary;
                                            font-size: Typography.sm;
                                            font-weight: Typography.medium;
                                        }

                                        Text {
                                            text: "Invite only";
                                            color: Colors.text-muted;
                                            font-size: Typography.xs;
                                        }
                                    }
                                }

                                private-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is-private = true;
                                    }
                                }
                            }
                        }
                    }

                    // Password field (for private channels)
                    if root.is-private: VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Channel Password (optional)";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        Input {
                            placeholder: "Leave empty for invite-only";
                            text <=> root.password;
                        }
                    }

                    // Advanced settings row
                    HorizontalLayout {
                        spacing: Spacing.md;

                        // Encrypted toggle
                        Rectangle {
                            height: 36px;
                            horizontal-stretch: 1;
                            border-radius: Spacing.radius-md;
                            border-width: root.is-encrypted ? 2px : 1px;
                            border-color: root.is-encrypted ? Colors.success : Colors.text-muted.with-alpha(0.3);
                            background: encrypted-touch.has-hover ? Colors.surface-hover : Colors.surface;

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.sm;

                                Image {
                                    source: root.is-encrypted ? Icons.shield : Icons.unlock;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.is-encrypted ? Colors.success : Colors.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Encrypted";
                                    color: root.is-encrypted ? Colors.success : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                    vertical-alignment: center;
                                }
                            }

                            encrypted-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.is-encrypted = !root.is-encrypted;
                                }
                            }
                        }

                        // Friends only toggle
                        Rectangle {
                            height: 36px;
                            horizontal-stretch: 1;
                            border-radius: Spacing.radius-md;
                            border-width: root.friends-only ? 2px : 1px;
                            border-color: root.friends-only ? Colors.info : Colors.text-muted.with-alpha(0.3);
                            background: friends-touch.has-hover ? Colors.surface-hover : Colors.surface;

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.sm;

                                Image {
                                    source: Icons.users;
                                    width: 16px;
                                    height: 16px;
                                    colorize: root.friends-only ? Colors.info : Colors.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Friends Only";
                                    color: root.friends-only ? Colors.info : Colors.text-secondary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                    vertical-alignment: center;
                                }
                            }

                            friends-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.friends-only = !root.friends-only;
                                }
                            }
                        }
                    }

                    // Error message display
                    if root.error-message != "" && root.channel-name != "": Text {
                        text: root.error-message;
                        color: Colors.error;
                        font-size: Typography.sm;
                    }
                }

                // Step 3: AI configuration (only for ai-assistant template)
                if current-step == 3 && root.is-ai-template: VerticalLayout {
                    spacing: Spacing.md;

                    // Provider selection
                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "AI Provider";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        // Provider buttons (simple button selection)
                        HorizontalLayout {
                            spacing: Spacing.sm;

                            for provider in root.ai-providers: Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-md;
                                border-width: root.ai-provider == provider.id ? 2px : 1px;
                                border-color: root.ai-provider == provider.id ? Colors.primary : Colors.text-muted.with-alpha(0.3);
                                background: provider-touch.has-hover ? Colors.surface-hover : Colors.surface;

                                Text {
                                    text: provider.name;
                                    color: root.ai-provider == provider.id ? Colors.primary : Colors.text-primary;
                                    font-size: Typography.sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }

                                provider-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.ai-provider = provider.id;
                                        root.ai-model = "";
                                        root.provider-selected(provider.id);
                                    }
                                }
                            }
                        }
                    }

                    // Model selection (shown when provider is selected)
                    if root.ai-provider != "": VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Model";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                        }

                        // Model list
                        if root.ai-models.length == 0: Text {
                            text: "Loading models...";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                        }

                        Flickable {
                            max-height: 150px;
                            viewport-height: model-layout.preferred-height;

                            model-layout := VerticalLayout {
                                spacing: Spacing.xs;

                                for model in root.ai-models: Rectangle {
                                    height: 40px;
                                    border-radius: Spacing.radius-md;
                                    border-width: root.ai-model == model.id ? 2px : 1px;
                                    border-color: root.ai-model == model.id ? Colors.primary : Colors.text-muted.with-alpha(0.3);
                                    background: model-touch.has-hover ? Colors.surface-hover : Colors.surface;

                                    HorizontalLayout {
                                        padding-left: Spacing.md;
                                        padding-right: Spacing.md;

                                        Text {
                                            text: model.name;
                                            color: root.ai-model == model.id ? Colors.primary : Colors.text-primary;
                                            font-size: Typography.sm;
                                            vertical-alignment: center;
                                        }
                                    }

                                    model-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.ai-model = model.id;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Error message
                    if root.error-message != "": Text {
                        text: root.error-message;
                        color: Colors.error;
                        font-size: Typography.sm;
                    }
                }
            }

            // Footer with action buttons
            HorizontalLayout {
                spacing: Spacing.md;
                height: 40px;

                // Back button (Step 2 or 3)
                if current-step > 1: Button {
                    text: "Back";
                    variant: "ghost";

                    clicked => {
                        current-step = current-step - 1;
                    }
                }

                // Spacer
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Cancel button
                Button {
                    text: "Cancel";
                    variant: "secondary";

                    clicked => {
                        root.close();
                    }
                }

                // Next button (Step 1)
                if current-step == 1: Button {
                    text: "Next";
                    variant: "primary";
                    disabled: root.selected-template == "";

                    clicked => {
                        if root.selected-template != "" {
                            current-step = 2;
                        }
                    }
                }

                // Next button (Step 2 for AI template) or Create button (Step 2 for non-AI)
                if current-step == 2 && root.is-ai-template: Button {
                    text: "Next";
                    variant: "primary";
                    disabled: root.channel-name == "";

                    clicked => {
                        if root.channel-name != "" {
                            current-step = 3;
                        }
                    }
                }

                // Create button for private group (uses separate callback)
                if current-step == 2 && root.is-private-group: Button {
                    text: root.loading ? "" : "Create Private Group";
                    variant: "primary";
                    disabled: root.channel-name == "" || root.selected-friend-count == 0 || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.channel-name != "" && root.selected-friend-count > 0 && !root.loading {
                            root.create-private-group(root.channel-name, root.available-friends);
                        }
                    }
                }

                // Create button for regular channels
                if current-step == 2 && !root.is-ai-template && !root.is-private-group: Button {
                    text: root.loading ? "" : "Create";
                    variant: "primary";
                    disabled: root.channel-name == "" || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.channel-name != "" && !root.loading {
                            root.create(
                                root.channel-name,
                                root.channel-description,
                                root.selected-template,
                                {
                                    is-private: root.is-private,
                                    is-encrypted: root.is-encrypted,
                                    is-ephemeral: root.is-ephemeral || root.selected-template == "ephemeral",
                                    ttl-hours: root.ttl-hours,
                                    max-members: root.max-members,
                                    password: root.password,
                                    friends-only: root.friends-only,
                                    icon-url: root.icon-url,
                                },
                                "",
                                ""
                            );
                        }
                    }
                }

                // Create button (Step 3 for AI template)
                if current-step == 3: Button {
                    text: root.loading ? "" : "Create";
                    variant: "primary";
                    disabled: root.channel-name == "" || root.ai-provider == "" || root.ai-model == "" || root.loading;
                    loading: root.loading;

                    clicked => {
                        if root.channel-name != "" && root.ai-provider != "" && root.ai-model != "" && !root.loading {
                            root.create(
                                root.channel-name,
                                root.channel-description,
                                root.selected-template,
                                {
                                    is-private: root.is-private,
                                    is-encrypted: root.is-encrypted,
                                    is-ephemeral: root.is-ephemeral,
                                    ttl-hours: root.ttl-hours,
                                    max-members: root.max-members,
                                    password: root.password,
                                    friends-only: root.friends-only,
                                    icon-url: root.icon-url,
                                },
                                root.ai-provider,
                                root.ai-model
                            );
                        }
                    }
                }
            }
        }
    }
}
