import { Checkbox } from "../components/checkbox.slint";
import { Materials } from "../theme/materials.slint";
import { GlassSurface } from "../components/glass_surface.slint";
// RecoveryCodesModal - Displays one-time recovery codes after registration

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";

export component RecoveryCodesModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <[string]> codes: [];
    in property <bool> loading: false;

    property <bool> saved-confirmed: false;

    callback confirmed();
    callback copy-all();

    // Deliberately NOT a `Modal`: no dismissal control, no Escape, no
    // click-outside. Losing these codes is unrecoverable, so the one exit is
    // the Continue button, and that is gated on the "I saved them" checkbox.
    // Same shape as sealed_sender_intro.slint's acknowledge screen.
    opacity: root.show-modal ? 1 : 0;
    visible: root.show-modal;

    // Backdrop
    background: Materials.scrim;

    // Block backdrop clicks (no dismiss allowed)
    TouchArea {
        width: 100%;
        height: 100%;
    }

    // Modal container — centered card with content-based sizing
    GlassSurface {
        material-level: 3;
        elevation: 5;

        width: min(480px, parent.width - 32px);
        height: max(200px, min(content-layout.preferred-height, min(760px, parent.height - 48px)));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Spacing.radius-sheet;

        // Block clicks from passing through
        TouchArea {
            width: 100%;
            height: 100%;
        }

        content-layout := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.md;

            // Title
            Text {
                text: "Save Your Recovery Codes";
                color: Colors.text-primary;
                font-size: Typography.xl;
                font-weight: Typography.semibold;
                horizontal-alignment: center;
            }

            // Subtitle
            Text {
                text: "These codes can recover your account if you forget your password and PIN. Save them somewhere safe. They will not be shown again.";
                color: Colors.text-secondary;
                font-size: Typography.sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: Spacing.sm; }

            // Recovery codes list (single column).
            //
            // Asks for the WHOLE list, not a 120px window into it. These are
            // write-them-down-now codes: a box three rows tall that hides the
            // rest behind a scroll is how someone copies six of ten and loses
            // the account. The Flickable below stays as the last-resort escape
            // hatch for a genuinely short screen, but on a normal phone
            // nothing scrolls and every code is on screen at once.
            Rectangle {
                vertical-stretch: 1;
                // Wants to grow to codes-list.preferred-height (every code
                // visible at once, the normal case) but must be able to
                // shrink below that — pinning min-height to the full list
                // height made this Flickable's "last-resort scroll" comment
                // a lie: the modal could never actually get shorter than
                // all-codes-at-once, so on a short window the Continue
                // button below just got clipped off-screen, unreachable.
                // ~3 rows (32px item + xs spacing) is the real floor.
                min-height: 120px;
                background: Colors.background;
                border-radius: Spacing.radius-md;

                Flickable {
                    viewport-height: codes-list.preferred-height;
                    viewport-width: parent.width;

                    codes-list := VerticalLayout {
                        padding: Spacing.md;
                        spacing: Spacing.xs;

                        for code[i] in root.codes: Rectangle {
                            height: 32px;
                            background: Colors.surface;
                            border-radius: Spacing.radius-sm;

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                alignment: center;

                                Text {
                                    text: (i + 1) + ". ";
                                    color: Colors.text-muted;
                                    font-size: Typography.sm;
                                }
                                Text {
                                    text: code;
                                    color: Colors.text-primary;
                                    font-size: Typography.sm;
                                    font-weight: Typography.medium;
                                    letter-spacing: 1px;
                                }
                            }
                        }
                    }
                }
            }

            // Copy All button
            HorizontalLayout {
                alignment: center;

                Button {
                    text: "Copy All";
                    variant: "secondary";
                    clicked => { root.copy-all(); }
                }
            }

            Rectangle { height: Spacing.xs; }

            // Checkbox: I have saved my recovery codes
            Rectangle {
                min-height: Spacing.button-height;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.saved-confirmed = !root.saved-confirmed; }
                }
                HorizontalLayout {
                    spacing: Spacing.sm;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Checkbox {
                            checked <=> root.saved-confirmed;
                            label: "I have saved my recovery codes";
                        }
                    }
                    Text {
                        text: "I have saved my recovery codes";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle { height: Spacing.sm; }

            // Continue button (disabled until checkbox checked)
            Button {
                text: "Continue";
                variant: "primary";
                disabled: !root.saved-confirmed;
                clicked => { root.confirmed(); }
            }
        }
    }
}
