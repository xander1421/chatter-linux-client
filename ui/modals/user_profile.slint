// UserProfileModal - Modal for viewing user profiles

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Avatar } from "../components/avatar.slint";

export component UserProfileModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> user-id: "";
    in property <string> display-name: "";
    in property <string> username: "";
    in property <image> avatar-source;
    in property <string> initials: "";
    in property <string> status-text: "";  // custom status message
    in property <string> presence: "offline";  // "online", "away", "dnd", "offline"
    in property <string> bio: "";
    in property <bool> is-friend: false;
    in property <bool> is-blocked: false;
    in property <bool> is-self: false;  // viewing own profile
    in property <bool> loading: false;

    callback close();
    callback send-message();  // open DM
    callback edit-profile();   // open edit profile modal
    callback add-friend();
    callback remove-friend();
    callback block-user();
    callback unblock-user();

    // Helper to get presence color from string
    pure function presence-color(p: string) -> color {
        if p == "online" {
            return Colors.online;
        } else if p == "away" {
            return Colors.away;
        } else if p == "dnd" {
            return Colors.dnd;
        } else {
            return Colors.offline;
        }
    }

    // Helper to get presence label
    pure function presence-label(p: string) -> string {
        if p == "online" {
            return "Online";
        } else if p == "away" {
            return "Away";
        } else if p == "dnd" {
            return "Do Not Disturb";
        } else {
            return "Offline";
        }
    }

    Modal {
        show: root.show-modal;
        title: "";  // No title - profile header is visual
        modal-width: 420px;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: 0px;

            // Banner area with colored background
            Rectangle {
                height: 80px;
                background: Colors.primary.with-alpha(0.15);
                border-radius: Spacing.radius-md;

                // Presence dot in top-right corner
                Rectangle {
                    x: parent.width - self.width - Spacing.md;
                    y: Spacing.sm;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.presence-color(root.presence);
                }
            }

            // Avatar overlapping the banner
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 100px;
                    height: 50px; // Only bottom half visible (top half over banner)

                    Avatar {
                        y: -50px;
                        size: 100px;
                        source: root.avatar-source;
                        fallback-text: root.initials;
                        show-presence: false;
                    }
                }
            }

            // Profile info
            VerticalLayout {
                spacing: Spacing.sm;
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                padding-top: Spacing.sm;

                // Display name
                Text {
                    text: root.display-name;
                    color: Colors.text-primary;
                    font-size: Typography.xl;
                    font-weight: Typography.bold;
                    horizontal-alignment: center;
                }

                // Username
                if root.username != "" && root.username != root.display-name: Text {
                    text: "@" + root.username;
                    color: Colors.text-muted;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }

                // Presence row
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.xs;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.presence-color(root.presence);
                    }

                    Text {
                        text: root.presence-label(root.presence);
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                    }
                }

                // Custom status pill
                if root.status-text != "": HorizontalLayout {
                    alignment: center;
                    padding-top: Spacing.xs;

                    Rectangle {
                        width: status-pill-text.width + Spacing.md * 2;
                        height: 28px;
                        background: Colors.surface-hover;
                        border-radius: Spacing.radius-full;

                        status-pill-text := Text {
                            x: Spacing.md;
                            text: root.status-text;
                            color: Colors.text-secondary;
                            font-size: Typography.xs;
                            font-weight: Typography.medium;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                }
            }

            // Bio section
            if root.bio != "": VerticalLayout {
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                padding-top: Spacing.md;
                spacing: Spacing.sm;

                Rectangle {
                    height: 1px;
                    background: Colors.text-muted.with-alpha(0.15);
                }

                Text {
                    text: "ABOUT ME";
                    color: Colors.text-muted;
                    font-size: 11px;
                    font-weight: Typography.bold;
                    letter-spacing: 0.5px;
                }

                Text {
                    text: root.bio;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    wrap: word-wrap;
                    max-height: Typography.sm * 5;
                    overflow: elide;
                }
            }

            // Spacer
            Rectangle {
                height: Spacing.md;
            }

            // Divider before actions
            Rectangle {
                height: 1px;
                background: Colors.text-muted.with-alpha(0.15);
            }

            // Action buttons
            VerticalLayout {
                padding: Spacing.md;
                padding-left: Spacing.lg;
                padding-right: Spacing.lg;
                spacing: Spacing.sm;

                // Self view: Edit Profile button
                if root.is-self: Button {
                    text: "Edit Profile";
                    variant: "primary";
                    clicked => { root.edit-profile(); }
                }

                // Blocked view: Unblock button
                if root.is-blocked && !root.is-self: Button {
                    text: root.loading ? "" : "Unblock User";
                    variant: "danger";
                    loading: root.loading;
                    clicked => {
                        if !root.loading { root.unblock-user(); }
                    }
                }

                // Normal view (not self, not blocked)
                if !root.is-self && !root.is-blocked: HorizontalLayout {
                    spacing: Spacing.sm;

                    Button {
                        text: "Message";
                        variant: "primary";
                        horizontal-stretch: 1;
                        clicked => { root.send-message(); }
                    }

                    if root.is-friend: Button {
                        text: root.loading ? "" : "Remove Friend";
                        variant: "secondary";
                        loading: root.loading;
                        clicked => {
                            if !root.loading { root.remove-friend(); }
                        }
                    }

                    if !root.is-friend: Button {
                        text: root.loading ? "" : "Add Friend";
                        variant: "secondary";
                        loading: root.loading;
                        clicked => {
                            if !root.loading { root.add-friend(); }
                        }
                    }
                }

                // Block option for non-self users (subtle, at the bottom)
                if !root.is-self && !root.is-blocked: HorizontalLayout {
                    alignment: center;

                    block-touch := TouchArea {
                        mouse-cursor: pointer;
                        width: block-text.width;
                        height: 28px;

                        clicked => { root.block-user(); }

                        block-text := Text {
                            text: "Block User";
                            color: block-touch.has-hover ? Colors.error : Colors.text-muted;
                            font-size: Typography.xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
