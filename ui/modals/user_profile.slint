import { SharedContentItem, SharedTab } from "profile_shared_types.slint";
import { ProfileSharedList } from "profile_shared_list.slint";
import { ProfileSharedGrid } from "profile_shared_grid.slint";
import { ProfileSafetyNumber } from "profile_safety_number.slint";
import { ProfileStatusPicker } from "profile_status_picker.slint";
import { ProfileInfoCard } from "profile_info_card.slint";
import { ProfileActionTiles } from "profile_action_tiles.slint";
import { GlassSurface } from "../components/glass_surface.slint";
import { Materials } from "../theme/materials.slint";
// UserProfileModal — the contact/self profile page.
//
// Telegram-shaped: avatar and name on top, a row of square action tiles, an
// info card of value-over-label rows, then the point of the screen — a pill
// tab strip over everything ever shared in this conversation (Media, Files,
// Links, Voice, GIFs, Music), newest first and paged.
//
// The whole page is ONE Flickable so header, buttons, card and grid scroll
// together. It uses `ModalContainer` directly rather than `Modal`: the media
// grid has to run edge to edge, and `Modal` wraps its body in `Spacing.lg`
// padding and a fixed title/close header. Everything the grid needs — the
// backdrop, Escape, click-outside, full-screen and bottom-inset — lives in
// `ModalContainer`, so nothing is reimplemented here except the top bar.

import { Colors } from "../theme/colors.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { ModalContainer } from "../components/modal_container.slint";
import { DismissButton } from "../components/dismiss_button.slint";
import { Button } from "../components/button.slint";
import { Modal } from "../components/modal.slint";
import { Avatar } from "../components/avatar.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";
import { DisappearingSettings } from "../chat/disappearing_settings.slint";
import { DisappearingGlobal } from "../chat/disappearing_global.slint";


export component UserProfileModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <string> user-id: "";
    in property <string> display-name: "";
    in property <string> username: "";
    in property <image> avatar-source;
    in property <bool> is-anonymous: false;
    in property <bool> scoped-member: false;
    in property <string> initials: "";
    in property <string> status-text: "";  // custom status message
    in property <string> presence: "offline";  // "online", "away", "dnd", "offline"
    // Presence rendered as words — "online", "last seen yesterday 4:12 pm".
    // Shaped by core (`ui::chat_data::last_seen_label`) because the fallback
    // wording when we have never seen a timestamp is a product decision, not
    // a rendering one.
    in property <string> last-seen: "";
    in property <string> bio: "";
    in property <bool> is-friend: false;
    in property <bool> is-blocked: false;
    // Core's `can_start_secret_chat`: onion channel available, not Shield,
    // not self, not blocked.
    in property <bool> can-start-secret-chat: false;
    // Block asks first (Signal: "Block <name>? They won't be able to call or
    // message you."); reset whenever another profile is shown.
    property <bool> confirm-block: false;
    // Remove Friend asks too — it is destructive and was instant.
    property <bool> confirm-remove: false;
    // The disappearing-messages choices are unfolded under their row.
    property <bool> timer-picker-open: false;
    changed user-id => { self.timer-picker-open = false; }
    changed display-name => { self.confirm-block = false; self.confirm-remove = false; }
    in property <bool> is-self: false;  // viewing own profile
    in property <bool> is-muted: false;
    in property <bool> loading: false;
    in property <bool> is-verified: false;
    in property <string> safety-number: "";
    in-out property <bool> show-safety-number: false;
    // Username link (self view): shareable chatter://u/… URL + QR that
    // resolves to our username without the server learning it. The QR is
    // behind the glyph on the username row rather than always on screen.
    in property <string> share-link: "";
    in property <image> share-qr;
    in property <string> share-status: "";
    in-out property <bool> show-share-qr: false;

    // Manual presence mode (self view): "auto" | "online" | "away" | "dnd" | "invisible"
    in property <string> status-mode: "auto";

    // "Touch input", same meaning as the Contacts screen's. On a phone this is
    // a full-screen page, so it takes the shared touch geometry instead of
    // desktop density.
    in property <bool> mobile-mode: false;
    in property <length> bottom-inset: 0px;
    // A tab's root screen (see Modal): no back chevron, the tab bar navigates.
    in property <bool> root-screen: false;

    // ── Shared content ────────────────────────────────────────────────
    in property <[SharedTab]> shared-tabs: [];
    in-out property <string> shared-tab: "";
    in property <[SharedContentItem]> shared-items: [];
    in property <bool> shared-loading: false;

    property <length> row-height: root.mobile-mode ? Spacing.row-height-touch : 56px * Appearance.text-grow;
    property <length> avatar-size: root.mobile-mode ? 112px : 96px;
    property <length> name-size: root.mobile-mode ? Typography.xxxl : Typography.xxl;
    property <length> header-stretch: min(36px, max(0px, -page-scroll.viewport-y));

    callback close();
    // Presence picker (self view)
    callback change-status(string /* mode */);
    // Username link actions (self view)
    callback generate-share-link();  // create link (first time) / re-show
    callback copy-share-link();
    callback reset-share-link();     // rotate: old URLs stop resolving
    callback send-message();  // open DM
    callback start-secret-chat();  // open (or start) the secret chat with this user
    callback edit-profile();   // open edit profile modal
    callback add-friend();
    callback remove-friend();
    callback block-user();
    // A blocked profile only points at Friends › Blocked, the one place to
    // unblock or remove someone.
    callback manage-blocked();
    callback view-safety-number();
    callback toggle-verified();
    callback toggle-mute();
    callback start-call(bool /* is-video */);
    callback shared-tab-selected(string /* category */);
    callback shared-load-more();
    callback open-shared-item(string /* message-id */, string /* attachment-id */, string /* category */, string /* selected-url */);

    // Helper to get presence color from string
    pure function presence-color(p: string) -> color {
        if p == "online" {
            return Colors.online;
        } else if p == "away" {
            return Colors.away;
        } else if p == "dnd" {
            return Colors.dnd;
        } else {
            return Colors.offline;
        }
    }

    // Helper to get presence label
    pure function presence-label(p: string) -> string {
        if p == "online" {
            return "Online";
        } else if p == "away" {
            return "Away";
        } else if p == "dnd" {
            return "Do Not Disturb";
        } else {
            return "Offline";
        }
    }


    ModalContainer {
        show: root.show-modal;
        modal-width: 440px;
        // Same conservative viewport carve-out `Modal` applies: safe-area
        // insets are not plumbed into modals, so leave room for the Android
        // status + navigation bars rather than running off-screen.
        max-modal-height: max(240px, root.height - 96px);
        fill-height: root.mobile-mode;
        full-screen: root.mobile-mode;
        bottom-inset: root.mobile-mode ? 0px : root.bottom-inset;

        close => {
            root.close();
        }

        Rectangle {
            // A floating card is sized to its content; a phone page fills the
            // screen. Left to its preferred height on a phone, the page ended
            // where its (under-measured) content did, and everything painted
            // below that edge was not hit-tested.
            preferred-height: profile-header.height + page.preferred-height;
            height: root.mobile-mode ? parent.height : self.preferred-height;

            // ── Top bar ───────────────────────────────────────────────
            // Same rule `Modal` applies, hand-placed only because this screen
            // drives `ModalContainer` directly (the media grid has to run edge
            // to edge, which `Modal`'s padded body cannot do). The glyph, size
            // and label still come from the shared `DismissButton` — only the
            // EDGE is decided here, because that is a position in this layout.
            profile-header := GlassSurface {
                z: 1;
                x: root.mobile-mode ? Spacing.sm : 0px;
                y: root.mobile-mode ? Spacing.sm : 0px;
                width: parent.width - 2 * self.x;
                material-enabled: root.mobile-mode;
                border-radius: root.mobile-mode ? self.height / 2 : 0px;
                height: root.mobile-mode ? Spacing.header-action-box-touch : Spacing.header-action-box;
                HorizontalLayout {
                    padding-left: Spacing.xs;
                    padding-right: Spacing.xs;

                    // Full-screen page → back chevron, leading. Floating card →
                    // X, trailing. The bar carries no title on purpose; the name
                    // below is the title. (No kebab: every action it would hold is
                    // already a tile or a row on this page.)
                    if root.mobile-mode && !root.root-screen: DismissButton {
                        back: true;
                        clicked => { root.close(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if !root.mobile-mode: DismissButton {
                        back: false;
                        clicked => { root.close(); }
                    }
                }
            }

            // ── The page ──────────────────────────────────────────────
            page-scroll := Flickable {
                x: 0;
                y: root.mobile-mode ? 0px : profile-header.height;
                width: parent.width;
                height: parent.height - self.y;
                viewport-width: self.width;
                // At least the visible height: children outside the viewport
                // are not hit-tested, and the page's measured height can fall
                // short of what wrapped text paints, which left the lower
                // buttons on a phone drawn but dead.
                viewport-height: max(self.height, page.preferred-height);
                interactive: page.preferred-height > self.height;
                // Buttons and action tiles contain nested TouchAreas. Deliver
                // their press immediately while retaining drag-to-scroll.
                immediate-child-press: true;

                // Lazy paging: ask for the next page while there is still a
                // screenful of runway, so the grid never visibly runs out.
                // Core ignores the request when a load is already in flight or
                // the last page came back short.
                changed viewport-y => {
                    if (self.viewport-height + self.viewport-y - self.height < self.height) {
                        root.shared-load-more();
                    }
                }

                page := VerticalLayout {
                    padding-top: root.mobile-mode ? profile-header.height + Spacing.sm * 2 : Spacing.none;
                    padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                    alignment: start;
                    spacing: Spacing.md;

                    // ── Avatar ────────────────────────────────────────
                    HorizontalLayout {
                        alignment: center;
                        Avatar {
                            size: root.avatar-size;
                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                            transform-scale-x: 100% + 16% * (root.header-stretch / 36px);
                            transform-scale-y: 100% + 16% * (root.header-stretch / 36px);
                            source: root.avatar-source;
                            anonymous: root.is-anonymous;
                            fallback-text: root.initials;
                            show-presence: false;
                        }
                    }

                    // ── Name + verification badge ─────────────────────
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Text {
                            text: root.display-name;
                            color: Colors.text-primary;
                            font-size: root.name-size;
                            font-weight: Typography.bold;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Signal shows a badge only once verified; an
                        // unverified "?" read as "suspicious person".
                        if !root.is-self && root.is-verified: Rectangle {
                            // A small inline mark beside the name, not a
                            // button-sized tile.
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2;
                            background: Colors.online;
                            accessible-role: button;
                            accessible-label: "Verified — show safety number";

                            Text {
                                text: "\u{2713}";
                                color: Colors.on-action;
                                font-size: Typography.xs;
                                font-weight: Typography.bold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.safety-number == "" {
                                        root.view-safety-number();
                                    }
                                    root.show-safety-number = true;
                                }
                            }
                        }
                    }

                    // ── Last seen / presence line ─────────────────────
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.presence-color(root.presence);
                            }
                        }

                        Text {
                            text: root.last-seen != "" ? root.last-seen : root.presence-label(root.presence);
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            vertical-alignment: center;
                        }
                    }

                    // ── Custom status pill ────────────────────────────
                    if root.status-text != "": HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: status-pill-text.width + Spacing.md * 2;
                            height: 28px;
                            background: Colors.inset;
                            border-radius: Spacing.radius-full;

                            status-pill-text := Text {
                                x: Spacing.md;
                                text: root.status-text;
                                color: Colors.text-secondary;
                                font-size: Typography.xs;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }
                    }

                    // ── Action tiles ──────────────────────────────────
                    // Four equal tiles, icon over label. Self sees only the
                    // one action that applies to their own profile.
                    if !root.is-self && !root.is-blocked: ProfileActionTiles {
                        scoped-member: root.scoped-member;
                        is-muted: root.is-muted;
                        is-anonymous: root.is-anonymous;
                        is-friend: root.is-friend;
                        send-message => { root.send-message(); }
                        toggle-mute => { root.toggle-mute(); }
                        start-call(video) => { root.start-call(video); }
                    }

                    // ── Disappearing messages ─────────────────────────
                    // This DM's timer (Signal's "Disappearing messages" in
                    // conversation settings). Friends only: core has no DM to
                    // announce a timer to anyone else. The row shows the value;
                    // tapping it opens the choices in place.
                    if DisappearingGlobal.dm-can-set && !root.is-self && !root.is-blocked: HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;

                        Rectangle {
                            height: timer-card.preferred-height;
                            background: Colors.inset;
                            border-radius: Spacing.radius-lg;

                            timer-card := VerticalLayout {
                                padding: Spacing.md;
                                spacing: Spacing.sm;

                                timer-row := Rectangle {
                                    height: timer-row-layout.preferred-height;
                                    accessible-role: button;
                                    accessible-label: "Disappearing messages: " + DisappearingGlobal.dm-label;
                                    accessible-action-default => { root.timer-picker-open = !root.timer-picker-open; }

                                    timer-row-layout := HorizontalLayout {
                                        spacing: Spacing.sm;

                                        Image {
                                            source: Icons.clock;
                                            width: 20px;
                                            height: 20px;
                                            y: (parent.height - self.height) / 2;
                                            colorize: Colors.primary;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Spacing.xxs;

                                            Text {
                                                text: "Disappearing messages";
                                                color: Colors.text-primary;
                                                font-size: Typography.base;
                                            }

                                            Text {
                                                text: DisappearingGlobal.dm-label;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.timer-picker-open = !root.timer-picker-open; }
                                    }
                                }

                                if root.timer-picker-open: DisappearingSettings {
                                    peer-id: root.user-id;
                                    current-ttl: DisappearingGlobal.dm-seconds;
                                }
                            }
                        }
                    }

                    if root.is-self: HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;

                        Button {
                            text: "Edit Profile";
                            variant: "primary";
                            clicked => { root.edit-profile(); }
                        }
                    }

                    if root.is-blocked && !root.is-self: VerticalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.sm;

                        Text {
                            text: "You blocked this person. Manage in Contacts › Blocked.";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            wrap: word-wrap;
                        }

                        Button {
                            text: "Open Blocked";
                            variant: "secondary";
                            clicked => { root.manage-blocked(); }
                        }
                    }

                    // ── Info card ─────────────────────────────────────
                    // Value on top, label underneath. Phone number is
                    // deliberately absent: it exists in neither the proto, the
                    // domain model nor the schema, and a faked row is worse
                    // than a missing one. Nothing to show (a peer with no
                    // known handle and no bio) means no card, not an empty one.
                    if root.username != "" || root.bio != "": ProfileInfoCard {
                        username: root.username;
                        bio: root.bio;
                        is-self: root.is-self;
                        share-link: root.share-link;
                        share-qr: root.share-qr;
                        share-status: root.share-status;
                        show-share-qr <=> root.show-share-qr;
                        generate-share-link => { root.generate-share-link(); }
                        copy-share-link => { root.copy-share-link(); }
                        reset-share-link => { root.reset-share-link(); }
                    }

                    // ── Status picker (self view) ─────────────────────
                    if root.is-self: ProfileStatusPicker {
                        status-mode: root.status-mode;
                        change-status(mode) => { root.change-status(mode); }
                    }

                    // ── Safety number (non-self) ──────────────────────
                    if !root.scoped-member && !root.is-self: ProfileSafetyNumber {
                        safety-number: root.safety-number;
                        is-verified: root.is-verified;
                        show-safety-number <=> root.show-safety-number;
                        view-safety-number => { root.view-safety-number(); }
                        toggle-verified => { root.toggle-verified(); }
                    }

                    // ── Secret chat ───────────────────────────────────
                    // Telegram-style: a device-bound conversation over Tor,
                    // its own row beside the regular DM. Hidden where core
                    // cannot start one.
                    if root.can-start-secret-chat && !root.scoped-member && !root.is-self && !root.is-blocked: HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        padding-top: Spacing.sm;

                        Button {
                            text: "Start secret chat";
                            icon: Icons.lock;
                            variant: "secondary";
                            horizontal-stretch: 1;
                            clicked => { root.start-secret-chat(); }
                        }
                    }

                    // ── Add friend ────────────────────────────────────
                    if !root.scoped-member && !root.is-self && !root.is-blocked && !root.is-friend && !AnonMode.enabled: HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;

                        // Core refuses friend requests in Anon Mode (they
                        // reveal the real identity), so the button is not shown.
                        Button {
                            text: root.loading ? "" : "Add Friend";
                            variant: "secondary";
                            horizontal-stretch: 1;
                            loading: root.loading;
                            clicked => {
                                if !root.loading { root.add-friend(); }
                            }
                        }
                    }

                    // ── Shared-content tab strip ──────────────────────
                    // A pill segmented control, not the underlined tabs the
                    // Contacts modal uses: those read as page navigation, this
                    // is a filter over one list.
                    //
                    // The pill is sized from the chip inside it, not the other
                    // way round: 48px shell minus 2px inset either side leaves
                    // each chip exactly at the 48px-token-derived 44px touch
                    // floor. At the old 40px/3px it was 34px, which is a
                    // failed target dressed as a style choice.
                    //
                    // One tab is not a choice: a lone pill looked like a button.
                    // Then — and for the empty state — a plain section header.
                    if !root.is-self && root.shared-tabs.length <= 1 && !root.shared-loading: HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        padding-top: Spacing.sm;

                        Text {
                            text: root.shared-tabs.length == 1 ? root.shared-tabs[0].label : "Shared media";
                            color: Colors.text-muted;
                            font-size: Typography.xs2;
                            font-weight: Typography.bold;
                            letter-spacing: 0.5px;
                        }
                    }

                    if root.shared-tabs.length > 1: HorizontalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;

                        Rectangle {
                            height: Spacing.touch-target-min;
                            border-radius: Spacing.radius-full;
                            background: Colors.inset;

                            HorizontalLayout {
                                padding: Spacing.xxs;
                                spacing: Spacing.xxs;

                                for tab in root.shared-tabs: Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Spacing.radius-full;
                                    background: root.shared-tab == tab.id
                                        ? Colors.tint-strong
                                        : (tab-touch.pressed ? Materials.pressed : tab-touch.has-hover ? Materials.hover : transparent);
                                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                                    transform-scale-x: tab-touch.pressed ? 96% : 100%;
                                    transform-scale-y: tab-touch.pressed ? 92% : 100%;
                                    animate background { duration: Materials.motion-standard; easing: Materials.glide; }
                                    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                                    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                                    accessible-role: button;
                                    accessible-label: "shared-tab-" + tab.id;

                                    Text {
                                        text: tab.label;
                                        color: root.shared-tab == tab.id ? Colors.primary : Colors.text-muted;
                                        font-size: Typography.sm;
                                        font-weight: root.shared-tab == tab.id ? Typography.semibold : Typography.normal;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                        overflow: elide;
                                    }

                                    tab-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.shared-tab-selected(tab.id); }
                                    }
                                }
                            }
                            }
                    }

                    // ── Media / GIF grid ──────────────────────────────
                    // Three flush columns, 2px gutters, edge to edge. Same
                    // absolute-placement trick the section-icon picker uses —
                    // Slint has no wrapping grid over a model.
                    if root.shared-tab == "media" || root.shared-tab == "gif": ProfileSharedGrid {
                        shared-items: root.shared-items;
                        open-shared-item(message-id, attachment-id, category, selected-url) => {
                            root.open-shared-item(message-id, attachment-id, category, selected-url);
                        }
                    }

                    // ── Files / Links / Voice / Music list ────────────
                    if root.shared-tab != "" && root.shared-tab != "media" && root.shared-tab != "gif": ProfileSharedList {
                        shared-items: root.shared-items;
                        mobile-mode: root.mobile-mode;
                        row-height: root.row-height;
                        open-shared-item(message-id, attachment-id, category, selected-url) => {
                            root.open-shared-item(message-id, attachment-id, category, selected-url);
                        }
                    }

                    // Nothing shared yet, or the tab is still loading.
                    if root.shared-tabs.length == 0 && !root.shared-loading && !root.is-self: HorizontalLayout {
                        alignment: center;
                        padding: Spacing.lg;

                        Text {
                            text: "Nothing shared in this conversation yet.";
                            color: Colors.text-muted;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                        }
                    }

                    if root.shared-loading: HorizontalLayout {
                        alignment: center;
                        padding: Spacing.md;

                        Text {
                            text: "Loading…";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                        }
                    }

                    // Destructive actions belong below the profile and shared
                    // content, as quiet text rows instead of primary buttons.
                    if !root.scoped-member && !root.is-self && !root.is-blocked: VerticalLayout {
                        padding-left: Spacing.md;
                        padding-right: Spacing.md;
                        spacing: Spacing.none;

                        if root.is-friend: Rectangle {
                            height: Spacing.touch-target-min;
                            background: remove-touch.has-hover ? Colors.surface-hover : transparent;
                            accessible-role: button;
                            accessible-label: "Remove Friend";
                            accessible-enabled: !root.loading;
                            accessible-action-default => {
                                if !root.loading { root.confirm-block = false; root.confirm-remove = true; }
                            }
                            Text {
                                text: "Remove Friend";
                                color: Colors.error-hover;
                                font-size: Typography.sm;
                                vertical-alignment: center;
                            }
                            remove-touch := TouchArea {
                                enabled: !root.loading;
                                mouse-cursor: pointer;
                                clicked => { root.confirm-block = false; root.confirm-remove = true; }
                            }
                        }

                        Rectangle {
                            height: Spacing.touch-target-min;
                            background: block-touch.has-hover ? Colors.surface-hover : transparent;
                            accessible-role: button;
                            accessible-label: "Block";
                            accessible-action-default => { root.confirm-remove = false; root.confirm-block = true; }
                            Text {
                                text: "Block";
                                color: Colors.error-hover;
                                font-size: Typography.sm;
                                vertical-alignment: center;
                            }
                            block-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.confirm-remove = false; root.confirm-block = true; }
                            }
                        }
                    }

                    // Breathing room so the last grid row clears the bottom
                    // edge (and, full-screen, the floating dock).
                    Rectangle { height: Spacing.xl; }
                }
            }
        }
    }
    // Confirms are real dialogs, like "Delete message?": inline in the page
    // they collided with the Media strip below.
    Modal {
        show: root.confirm-remove && root.is-friend && !root.is-self && !root.is-blocked;
        title: "Remove " + root.display-name + "?";
        modal-width: 400px;
        show-close: false;
        close => { root.confirm-remove = false; }

        VerticalLayout {
            spacing: Spacing.md;

            Text {
                text: "They'll be removed from your friends. Your chat history stays.";
                color: Colors.text-secondary;
                font-size: Typography.sm;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Spacing.sm;
                alignment: end;

                Button {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.confirm-remove = false; }
                }

                Button {
                    text: "Remove";
                    variant: "destructive";
                    clicked => {
                        root.confirm-remove = false;
                        root.remove-friend();
                    }
                }
            }
        }
    }

    Modal {
        show: root.confirm-block && !root.is-self && !root.is-blocked;
        title: "Block " + root.display-name + "?";
        modal-width: 400px;
        show-close: false;
        close => { root.confirm-block = false; }

        VerticalLayout {
            spacing: Spacing.md;

            Text {
                text: "Blocked people can't call or message you. You can unblock them in Contacts › Blocked.";
                color: Colors.text-secondary;
                font-size: Typography.sm;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Spacing.sm;
                alignment: end;

                Button {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => { root.confirm-block = false; }
                }

                Button {
                    text: "Block";
                    variant: "destructive";
                    clicked => {
                        root.confirm-block = false;
                        root.block-user();
                    }
                }
            }
        }
    }
}
