import { GlassSurface } from "../components/glass_surface.slint";
import { Materials } from "../theme/materials.slint";
// FriendsModal - Comprehensive friends management
// Tabs: Add Friend, Friends, Requests, Blocked

import { Colors } from "../theme/colors.slint";
import { Elevation } from "../theme/elevation.slint";
import { Appearance } from "../theme/appearance.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Modal } from "../components/modal.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";

// Friend data structure
export struct FriendData {
    user-id: string,
    display-name: string,
    username: string,
    presence-status: string,  // "online", "away", "dnd", "offline"
    custom-status: string,
    // Anonymous contact flag. When true, `user-id` is the anon_dm_id and
    // selecting the row opens the anon-DM conversation instead of the
    // user profile. Anon rows carry avatars as bytes (no URL), so the
    // Avatar component falls back to `avatar-source` when `has-avatar`
    // is true.
    is-anon: bool,
    avatar-source: image,
    has-avatar: bool,
    // Rendered inside the avatar circle when there is no image. Derived in
    // Rust (`get_initials`) exactly like DMListItemData's, rather than passing
    // the display name and letting it clip.
    initials: string,
}

// Friend request data
export struct FriendRequestData {
    user-id: string,
    display-name: string,
    username: string,
    avatar-source: image,   // For avatar bytes converted to image
    has-avatar: bool,       // Whether avatar-source is valid
    sent-at: string,
    note: string,           // Decrypted intro note (received requests only; empty otherwise)
}

// Blocked user data
export struct BlockedUserData {
    user-id: string,
    display-name: string,
    username: string,
    blocked-at: string,
    anon: bool,       // anon-DM peer block: no friendship to remove
    anon-chat: bool,  // its anon conversation is still stored locally
    avatar-source: image,
}

export component FriendsModal inherits Rectangle {
    in property <bool> show-modal: false;
    // "Touch input", same meaning as the sidebar's. On a phone this modal is
    // effectively a full-screen contacts page, so its rows get the same
    // scan-at-a-glance sizing the conversation list uses rather than the
    // 56px mouse density that leaves a whole screen looking like a dense
    // desktop table.
    in property <bool> mobile-mode: false;
    // A tab's root screen (see Modal): no back chevron, the tab bar navigates.
    in property <bool> root-screen: false;
    // In-app camera scanner exists (Android).
    in property <bool> can-scan: false;
    in property <length> bottom-inset: 0px;
    property <length> row-height: root.mobile-mode ? Spacing.row-height-touch : 56px * Appearance.text-grow;
    property <length> row-avatar: root.mobile-mode ? Spacing.row-avatar-touch : 40px;
    property <length> row-name-size: root.mobile-mode ? Typography.base : Typography.sm;
    property <length> row-sub-size: root.mobile-mode ? Typography.sm : Typography.xs;
    in-out property <string> active-tab: "find";  // "find", "friends", "requests", "blocked"

    // Friends tab data
    in property <[FriendData]> friends: [];

    // Requests tab data
    in-out property <string> requests-sub-tab: "received";  // "received", "sent", "private", "groups", or "channels"
    in property <[FriendRequestData]> received-requests: [];
    in property <[FriendRequestData]> sent-requests: [];
    in property <[FriendRequestData]> private-requests: [];  // Anonymous DM requests
    in property <[FriendRequestData]> group-invites: [];     // Pending anonymous group invites
    in property <[FriendRequestData]> channel-invites: [];   // Pending channel invitations

    // Blocked tab data
    in property <[BlockedUserData]> blocked-users: [];

    // Loading states
    in property <bool> loading: false;
    in property <string> private-request-decision: "";

    // Friend code (privacy-first discovery)
    in-out property <string> my-code: "";
    in-out property <string> code-input: "";
    in-out property <string> code-status: "";
    in-out property <string> request-note: "";  // Optional intro note sent with a friend request
    in-out property <image> qr-code-image;
    in-out property <bool> show-qr: false;
    // Shield decides which code this account generates. Redeeming a code is
    // routed by its format in core; private codes work with Shield off too.
    property <bool> effective-private-mode: AnonMode.enabled;
    changed effective-private-mode => {
        if (root.active-tab == "find") { root.switch-tab("find"); }
    }

    // Callbacks
    callback close();
    callback generate-code(bool);  // bool = private mode
    callback generate-qr(bool);    // bool = private mode
    callback copy-code();
    callback paste-code();                   // System clipboard → code-input
    callback scan-code();                    // Camera QR → code-input
    callback connect-via-code(string);       // Core routes private and server-managed codes
    callback switch-tab(string);

    // Friends actions
    callback view-profile(string);    // user_id
    callback start-dm(string);        // user_id

    // Request actions
    callback accept-request(string);  // user_id
    callback decline-request(string); // user_id
    callback cancel-request(string);  // user_id

    // Private (anon DM) request actions
    callback accept-private-request(string);   // conversation_id
    callback decline-private-request(string);  // conversation_id
    callback block-private-request(string);    // conversation_id

    // Group invite actions
    callback accept-group-invite(string);      // group_id
    callback decline-group-invite(string);     // group_id

    // Channel invite actions
    callback accept-channel-invite(string);    // channel_id
    callback decline-channel-invite(string);   // channel_id

    // Blocked actions. Unblock restores the friend and their DM with its
    // history (blocking never removed them); Remove, after a confirm, ends the
    // friendship and lifts the block, leaving them a stranger. On an anon-DM
    // peer the same callback is "Delete chat": the chat goes, the block stays.
    callback unblock-user(string);    // user_id
    callback remove-blocked-user(string);  // user_id
    // Row whose Remove is awaiting confirmation ("" = none).
    property <string> confirm-remove-id: "";

    Modal {
        floating-content: root.mobile-mode;
        show: root.show-modal;
        title: "Contacts";
        modal-width: 680px;
        max-modal-height: 800px;
        // On a phone this is the Contacts screen, not a dialog over the chat
        // list — the bottom tab bar navigates to it the same way Telegram's
        // does, so it gets the whole viewport.
        full-screen: root.mobile-mode;
        root-screen: root.root-screen;
        bottom-inset: root.bottom-inset;
        fill-height: root.mobile-mode;

        close => {
            root.close();
        }

        VerticalLayout {
            spacing: Spacing.md;
            vertical-stretch: 1;

            // Main tab bar — Neo. Same box height as the dismissal control in
            // the header row above it, so the two rows share one baseline
            // instead of the tabs sitting 4px short of the touch floor.
            GlassSurface {
                material-enabled: root.mobile-mode;
                elevation: 0;
                z: 1;
                height: root.mobile-mode ? Spacing.header-action-box-touch : Spacing.header-action-box;

                // Segmented control, concentric with its shell (the same
                // rule as the Calls tabs): the tabs sit `chrome-inset` inside
                // the glass pill and the selected one is filled at
                // `radius-chrome-inner`, so its fill follows the shell's
                // curve instead of sticking square out past the rounded ends.
                HorizontalLayout {
                    padding: Spacing.chrome-inset;

                    for tab in [
                        { id: "find", label: "Add Friend" },
                        { id: "friends", label: "Friends" },
                        { id: "requests", label: "Requests" },
                        { id: "blocked", label: "Blocked" }
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        border-radius: Spacing.radius-chrome-inner;
                        background: root.active-tab == tab.id ? Colors.tint-strong : (tab-touch.pressed ? Materials.pressed : tab-touch.has-hover ? Materials.hover : transparent);
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale-x: tab-touch.pressed ? 96% : 100%;
                        transform-scale-y: tab-touch.pressed ? 92% : 100%;
                        animate background { duration: Materials.motion-standard; easing: Materials.glide; }
                        animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                        animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }

                        Text {
                            width: 100%;
                            height: 100%;
                            text: tab.label + (tab.id == "requests" && (root.received-requests.length > 0) ?
                                " (" + root.received-requests.length + ")" : "");
                            color: root.active-tab == tab.id ? Colors.text-primary : Colors.text-secondary;
                            font-size: Typography.sm;
                            font-weight: root.active-tab == tab.id ? Typography.semibold : Typography.normal;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // TouchArea on top to capture clicks (fills parent)
                        tab-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-tab = tab.id;
                                root.switch-tab(tab.id);
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Colors.divider;
            }

            // Content area
            Rectangle {
                min-height: 400px;
                vertical-stretch: 1;

                // ===== Friends Tab =====
                if root.active-tab == "friends": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Spacing.sm;

                    // Friends count header
                    Text {
                        z: 1;
                        text: root.friends.length + (root.friends.length == 1 ? " Friend" : " Friends");
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                    }

                    if root.friends.length == 0: Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            // U+1F465 has no glyph in the Galaxy S9's emoji font
                            // and rendered as a tofu box. Use the app's own
                            // icon, like every other empty state (§112u).
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: Icons.users;
                                    width: 40px;
                                    height: 40px;
                                    colorize: Colors.text-muted;
                                }
                            }

                            Text {
                                text: "No friends yet";
                                color: Colors.text-muted;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Use the Add Friend tab to connect";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.friends.length > 0: Rectangle {
                        vertical-stretch: 1;
                        property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                        scroll-friends-list := Flickable {
                            property <length> chrome-inset: parent.chrome-inset;
                            width: parent.width;
                            y: root.mobile-mode ? -parent.chrome-inset : 0px;
                            height: root.mobile-mode ? root.height : parent.height;

                            viewport-height: friends-list.preferred-height;

                            friends-list := VerticalLayout {
                                padding-top: root.mobile-mode ? scroll-friends-list.chrome-inset : Spacing.none;
                                padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                // Rows stack from the TOP. A VerticalLayout with no
                                // alignment distributes its leftover space around
                                // fixed-height children, so one friend in a
                                // full-screen list sank to the bottom of the
                                // viewport with the gap above it.
                                alignment: start;
                                spacing: Spacing.xs;

                                for friend in root.friends: Rectangle {
                                    height: root.row-height;
                                    background: friend-touch.has-hover ? Colors.surface-hover : transparent;
                                    border-radius: Spacing.radius-md;

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Avatar {
                                            size: root.row-avatar;
                                            // `source` was never bound, so every
                                            // contact fell back to text even when
                                            // FriendData carried a decoded avatar.
                                            source: friend.avatar-source;
                                            // Initials, not the whole name: Avatar
                                            // renders this INSIDE the circle, so a
                                            // display name clipped to "xande".
                                            fallback-text: friend.initials;
                                            show-presence: true;
                                            presence-color: friend.presence-status == "online" ? Colors.online
                                            : friend.presence-status == "away" ? Colors.away
                                            : friend.presence-status == "dnd" ? Colors.dnd
                                            : Colors.offline;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: root.mobile-mode ? Spacing.xs : Spacing.xxs;

                                            Text {
                                                text: friend.display-name;
                                                color: Colors.text-primary;
                                                font-size: root.row-name-size;
                                                font-weight: Typography.medium;
                                                overflow: elide;
                                            }

                                            if friend.custom-status != "": Text {
                                                text: friend.custom-status;
                                                color: Colors.text-muted;
                                                font-size: root.row-sub-size;
                                                overflow: elide;
                                            }
                                        }

                                        // No stretch: sharing the row's slack with
                                        // the name, the centred icons drifted with
                                        // the name's length. Fixed, they form one
                                        // right-hand column.
                                        // Centred on the name: fixed 44px buttons in
                                        // a HorizontalLayout otherwise sit at its top.
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 0;
                                            HorizontalLayout {
                                                spacing: Spacing.xs;
                                                alignment: center;
                                                horizontal-stretch: 0;

                                                // Message button
                                                Rectangle {
                                                    width: 44px;
                                                    height: 44px;
                                                    border-radius: Spacing.radius-sm;
                                                    background: msg-touch.has-hover ? Colors.surface : transparent;

                                                    Image {
                                                        source: Icons.message-circle;
                                                        colorize: Colors.text-secondary;
                                                        width: 18px;
                                                        height: 18px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    msg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.start-dm(friend.user-id);
                                                        }
                                                    }
                                                }

                                                // More options: the profile, where Remove
                                                // Friend and Block live behind a confirm.
                                                Rectangle {
                                                    width: 44px;
                                                    height: 44px;
                                                    border-radius: Spacing.radius-sm;
                                                    background: more-touch.has-hover ? Colors.surface : transparent;

                                                    // Icons.more-vertical, not U+22EE:
                                                    // Inter has no vertical-ellipsis glyph
                                                    // and the fallback drew a notdef box.
                                                    Image {
                                                        source: Icons.more-vertical;
                                                        colorize: Colors.text-secondary;
                                                        width: 16px;
                                                        height: 16px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    more-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.view-profile(friend.user-id);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    friend-touch := TouchArea {
                                        clicked => {
                                            root.view-profile(friend.user-id);
                                        }
                                    }
                                }
                            }

                        }
                    }
                }

                // ===== Find Users Tab =====
                if root.active-tab == "find": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Spacing.md;

                    // ===== Friend Code Section ===== — Neo raised card
                    Rectangle {
                        background: Colors.surface;
                        border-radius: Spacing.radius-md;
                        drop-shadow-blur: Elevation.card-blur;
                        drop-shadow-offset-y: Elevation.card-offset;
                        drop-shadow-color: Elevation.card-shadow;
                        border-width: Elevation.rim-width;
                        border-color: Elevation.card-rim;

                        VerticalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.sm;

                            Text {
                                text: "Add Friend via Code";
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                font-weight: Typography.semibold;
                            }

                            // Enter friend's code
                            HorizontalLayout {
                                spacing: Spacing.sm;

                                Input {
                                    horizontal-stretch: 1;
                                    // Short enough for the phone-width field
                                    // beside Paste and Connect (it clipped to
                                    // "Enter friend's cod"); the mode line
                                    // below explains the generated code's mode.
                                    placeholder: "Friend code";
                                    text <=> root.code-input;

                                    accepted(code) => {
                                        root.connect-via-code(code);
                                    }
                                }

                                // Paste from clipboard — Slint's Ctrl+V on Wayland
                                // can't see clipboards written via wl-copy /
                                // wayland-data-control (different protocol),
                                // so this button routes through arboard in
                                // chatter-ui and writes straight into
                                // `code-input`.
                                Button {
                                    text: "Paste";
                                    variant: "ghost";
                                    clicked => {
                                        root.paste-code();
                                    }
                                }

                                Button {
                                    text: "Connect";
                                    variant: "primary";
                                    loading: root.loading;

                                    clicked => {
                                        root.connect-via-code(root.code-input);
                                    }
                                }
                            }

                            // Status message
                            if root.code-status != "": Text {
                                text: root.code-status;
                                color: (root.code-status == "Friend request sent!" || root.code-status == "Secret chat started!") ? Colors.success :
                                       (root.code-status == "Copied to clipboard!" || root.code-status == "Pasted from clipboard"
                                        || root.code-status == "Secret chat is getting ready…" || root.code-status == "Connecting…"
                                        || root.code-status == "Code scanned — tap Connect"
                                        || root.code-status == "Code scanned — tap Connect to send the request"
                                        || root.code-status == "Chatter uses the camera only to read your friend's QR code.") ? Colors.text-secondary : Colors.error;
                                font-size: Typography.xs;
                                // The camera-denied and rationale lines are a
                                // sentence long; unwrapped they were cut off at
                                // the card edge on a phone.
                                wrap: word-wrap;
                                height: self.preferred-height;
                            }

                            // Optional intro note for a friend request or secret
                            // chat invitation. Below code entry: add note → Connect.
                            Input {
                                placeholder: "Add a note (optional)";
                                text <=> root.request-note;
                            }

                            // Read-only mode indicator — implied by shield state,
                            // not toggleable (see effective-private-mode note).
                            HorizontalLayout {
                                spacing: Spacing.sm;
                                alignment: start;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    y: 3px;
                                    background: root.effective-private-mode ? Colors.success : Colors.text-muted;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: Spacing.xxs;

                                    Text {
                                        text: root.effective-private-mode ? "Private mode (Shield)" : "Server-managed";
                                        color: root.effective-private-mode ? Colors.text-primary : Colors.text-secondary;
                                        font-size: Typography.xs;
                                        font-weight: Typography.medium;
                                    }

                                    Text {
                                        text: root.effective-private-mode ? "(Anonymous — over Tor, no account link)" : "(Enable Shield for a private, anonymous contact)";
                                        color: Colors.text-muted.with-alpha(0.7);
                                        font-size: Typography.xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Your friend code — stacked vertically for narrow screens
                            VerticalLayout {
                                spacing: Spacing.xs;

                                Text {
                                    text: "Your code:";
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    height: self.preferred-height;
                                }

                                Rectangle {
                                    height: 36px;
                                    background: Colors.inset;
                                    border-radius: Spacing.radius-sm;

                                    HorizontalLayout {
                                        padding-left: Spacing.sm;
                                        padding-right: Spacing.sm;

                                        Text {
                                            text: root.my-code != "" ? root.my-code : "No code yet — generate one";
                                            color: root.my-code != "" ? Colors.text-primary : Colors.text-muted;
                                            font-size: Typography.xs;
                                            font-family: Typography.font-family-mono;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                // Action buttons row (wraps within available width)
                                HorizontalLayout {
                                    spacing: Spacing.xs;

                                    Button {
                                        text: root.my-code == "" ? "Generate" : "Regenerate";
                                        variant: "ghost";
                                        horizontal-stretch: 1;

                                        clicked => {
                                            root.generate-code(root.effective-private-mode);
                                        }
                                    }

                                    if root.my-code != "": Button {
                                        text: "Copy";
                                        variant: "ghost";
                                        horizontal-stretch: 1;

                                        clicked => {
                                            root.copy-code();
                                        }
                                    }

                                    if root.my-code != "": Button {
                                        text: root.show-qr ? "Hide QR" : "Show QR";
                                        variant: "ghost";
                                        horizontal-stretch: 1;

                                        clicked => {
                                            if (!root.show-qr) {
                                                root.generate-qr(root.effective-private-mode);
                                            }
                                            root.show-qr = !root.show-qr;
                                        }
                                    }
                                }
                            }

                            // QR Code Display — theme-aware card with a small
                            // white quiet-zone around the QR itself so camera
                            // scanners still get the required light background.
                            if root.show-qr && root.my-code != "": Rectangle {
                                background: Colors.inset;
                                border-radius: Spacing.radius-md;

                                VerticalLayout {
                                    alignment: center;
                                    padding: Spacing.md;
                                    spacing: Spacing.sm;

                                    // Centered white tile — wide enough for the
                                    // QR plus ~8px quiet-zone padding each side.
                                    HorizontalLayout {
                                        alignment: center;

                                        Rectangle {
                                            width: 168px;
                                            height: 168px;
                                            background: white;
                                            border-radius: Spacing.radius-sm;

                                            Image {
                                                source: root.qr-code-image;
                                                width: 150px;
                                                height: 150px;
                                                image-fit: contain;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Scan to add as friend";
                                        color: Colors.text-muted;
                                        font-size: Typography.xs;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if root.can-scan: Button {
                                text: "Scan friend's QR code";
                                variant: "secondary";
                                clicked => {
                                    root.scan-code();
                                }
                            }

                        }
                    }

                    // Privacy info section
                    Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "\u{1F517}";  // Link emoji
                                font-family: Typography.font-family-emoji;
                                font-size: Typography.huge;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Share your friend code";
                                color: Colors.text-muted;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Generate your code above and share it with friends";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }

                            // Connection mode explanation
                            HorizontalLayout {
                                alignment: center;

                                Rectangle {
                                    height: 1px;
                                    width: 80%;
                                    background: Colors.divider;
                                }
                            }

                            Text {
                                text: root.effective-private-mode
                                    ? "\u{1F510} Private codes start a secret chat through anonymous mailboxes over Tor"
                                    : "\u{1F517} Server codes send a friend request; private codes start a secret chat over Tor";
                                color: Colors.text-muted.with-alpha(0.7);
                                font-size: Typography.xs;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ===== Requests Tab =====
                if root.active-tab == "requests": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Spacing.sm;

                    // Sub-tab bar
                    HorizontalLayout {
                        z: 1;
                        height: max(Spacing.touch-target-min, 36px * Appearance.text-grow);

                        Rectangle {
                            horizontal-stretch: 1;
                            background: recv-tab-touch.has-hover ? Materials.hover : transparent;

                            VerticalLayout {
                                HorizontalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;

                                    Text {
                                        text: "Received (" + root.received-requests.length + ")";
                                        color: root.requests-sub-tab == "received" ? Colors.text-primary : Colors.text-secondary;
                                        font-size: Typography.xs;
                                        font-weight: root.requests-sub-tab == "received" ? Typography.semibold : Typography.normal;
                                    }
                                }

                                Rectangle {
                                    height: 2px;
                                    background: root.requests-sub-tab == "received" ? Colors.primary : transparent;
                                }
                            }

                            recv-tab-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.requests-sub-tab = "received";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: sent-tab-touch.has-hover ? Materials.hover : transparent;

                            VerticalLayout {
                                HorizontalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;

                                    Text {
                                        text: "Sent (" + root.sent-requests.length + ")";
                                        color: root.requests-sub-tab == "sent" ? Colors.text-primary : Colors.text-secondary;
                                        font-size: Typography.xs;
                                        font-weight: root.requests-sub-tab == "sent" ? Typography.semibold : Typography.normal;
                                    }
                                }

                                Rectangle {
                                    height: 2px;
                                    background: root.requests-sub-tab == "sent" ? Colors.primary : transparent;
                                }
                            }

                            sent-tab-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.requests-sub-tab = "sent";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: priv-tab-touch.has-hover ? Materials.hover : transparent;

                            VerticalLayout {
                                HorizontalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;

                                    Text {
                                        text: "Private (" + root.private-requests.length + ")";
                                        color: root.requests-sub-tab == "private" ? Colors.text-primary : Colors.text-secondary;
                                        font-size: Typography.xs;
                                        font-weight: root.requests-sub-tab == "private" ? Typography.semibold : Typography.normal;
                                    }
                                }

                                Rectangle {
                                    height: 2px;
                                    background: root.requests-sub-tab == "private" ? Colors.primary : transparent;
                                }
                            }

                            priv-tab-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.requests-sub-tab = "private";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: groups-tab-touch.has-hover ? Materials.hover : transparent;

                            VerticalLayout {
                                HorizontalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;

                                    Text {
                                        text: "Groups (" + root.group-invites.length + ")";
                                        color: root.requests-sub-tab == "groups" ? Colors.text-primary : Colors.text-secondary;
                                        font-size: Typography.xs;
                                        font-weight: root.requests-sub-tab == "groups" ? Typography.semibold : Typography.normal;
                                    }
                                }

                                Rectangle {
                                    height: 2px;
                                    background: root.requests-sub-tab == "groups" ? Colors.primary : transparent;
                                }
                            }

                            groups-tab-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.requests-sub-tab = "groups";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: channels-tab-touch.has-hover ? Materials.hover : transparent;

                            VerticalLayout {
                                HorizontalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;

                                    Text {
                                        text: "Channels (" + root.channel-invites.length + ")";
                                        color: root.requests-sub-tab == "channels" ? Colors.text-primary : Colors.text-secondary;
                                        font-size: Typography.xs;
                                        font-weight: root.requests-sub-tab == "channels" ? Typography.semibold : Typography.normal;
                                    }
                                }

                                Rectangle {
                                    height: 2px;
                                    background: root.requests-sub-tab == "channels" ? Colors.primary : transparent;
                                }
                            }

                            channels-tab-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.requests-sub-tab = "channels";
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Colors.divider;
                    }

                    // Received requests
                    if root.requests-sub-tab == "received": VerticalLayout {
                        vertical-stretch: 1;

                        if root.received-requests.length == 0: VerticalLayout {
                            alignment: center;

                            Text {
                                text: "No pending requests";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }

                        if root.received-requests.length > 0: Rectangle {
                            vertical-stretch: 1;
                            property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                            scroll-received-list := Flickable {
                                property <length> chrome-inset: parent.chrome-inset;
                                width: parent.width;
                                y: root.mobile-mode ? -parent.chrome-inset : 0px;
                                height: root.mobile-mode ? root.height : parent.height;
                                viewport-height: received-list.preferred-height;

                                received-list := VerticalLayout {
                                    padding-top: root.mobile-mode ? scroll-received-list.chrome-inset : Spacing.none;
                                    padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                    // Rows stack from the top (see friends-list).
                                    alignment: start;
                                    spacing: Spacing.xs;

                                    for request in root.received-requests: Rectangle {
                                        min-height: 64px;
                                        background: recv-touch.has-hover ? Colors.surface-hover : transparent;
                                        border-radius: Spacing.radius-md;

                                        // TouchArea first (behind) for hover detection
                                        recv-touch := TouchArea {}

                                        HorizontalLayout {
                                            padding: Spacing.sm;
                                            spacing: Spacing.sm;

                                            Avatar {
                                                size: 40px;
                                                source: request.avatar-source;
                                                name: request.display-name;
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                Text {
                                                    text: request.display-name;
                                                    color: Colors.text-primary;
                                                    font-size: Typography.sm;
                                                    font-weight: Typography.medium;
                                                    overflow: elide;
                                                }

                                                if request.note != "": Text {
                                                    text: request.note;
                                                    color: Colors.text-secondary;
                                                    font-size: Typography.xs;
                                                    wrap: word-wrap;
                                                }

                                                if request.sent-at != "": Text {
                                                    text: request.sent-at;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.xs;
                                                alignment: center;

                                                Button {
                                                    text: "Accept";
                                                    variant: "primary";

                                                    clicked => {
                                                        root.accept-request(request.user-id);
                                                    }
                                                }

                                                Button {
                                                    text: "Decline";
                                                    variant: "ghost";

                                                    clicked => {
                                                        root.decline-request(request.user-id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }

                    // Sent requests
                    if root.requests-sub-tab == "sent": VerticalLayout {
                        vertical-stretch: 1;

                        if root.sent-requests.length == 0: VerticalLayout {
                            alignment: center;

                            Text {
                                text: "No outgoing requests";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }

                        if root.sent-requests.length > 0: Rectangle {
                            vertical-stretch: 1;
                            property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                            scroll-sent-list := Flickable {
                                property <length> chrome-inset: parent.chrome-inset;
                                width: parent.width;
                                y: root.mobile-mode ? -parent.chrome-inset : 0px;
                                height: root.mobile-mode ? root.height : parent.height;
                                viewport-height: sent-list.preferred-height;

                                sent-list := VerticalLayout {
                                    padding-top: root.mobile-mode ? scroll-sent-list.chrome-inset : Spacing.none;
                                    padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                    // Rows stack from the top (see friends-list).
                                    alignment: start;
                                    spacing: Spacing.xs;

                                    for request in root.sent-requests: Rectangle {
                                        height: 56px;
                                        background: sent-touch.has-hover ? Colors.surface-hover : transparent;
                                        border-radius: Spacing.radius-md;

                                        // TouchArea first (behind) for hover detection
                                        sent-touch := TouchArea {}

                                        HorizontalLayout {
                                            padding: Spacing.sm;
                                            spacing: Spacing.sm;

                                            Avatar {
                                                size: 40px;
                                                source: request.avatar-source;
                                                name: request.display-name;
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                Text {
                                                    text: request.display-name;
                                                    color: Colors.text-primary;
                                                    font-size: Typography.sm;
                                                    font-weight: Typography.medium;
                                                    overflow: elide;
                                                }

                                            }

                                            HorizontalLayout {
                                                alignment: center;

                                                Button {
                                                    text: "Cancel";
                                                    variant: "ghost";

                                                    clicked => {
                                                        root.cancel-request(request.user-id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }

                    // Private requests (anonymous DMs)
                    if root.requests-sub-tab == "private": VerticalLayout {
                        vertical-stretch: 1;

                        if root.private-requests.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "\u{1F510}";  // Lock emoji
                                font-family: Typography.font-family-emoji;
                                font-size: Typography.huge;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "No private message requests";
                                color: Colors.text-muted;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Private requests use end-to-end encryption\nwith no server involvement";
                                color: Colors.text-muted.with-alpha(0.7);
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }

                        if root.private-requests.length > 0: Rectangle {
                            vertical-stretch: 1;
                            property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                            scroll-private-list := Flickable {
                                property <length> chrome-inset: parent.chrome-inset;
                                width: parent.width;
                                y: root.mobile-mode ? -parent.chrome-inset : 0px;
                                height: root.mobile-mode ? root.height : parent.height;
                                viewport-height: private-list.preferred-height;

                                private-list := VerticalLayout {
                                    padding-top: root.mobile-mode ? scroll-private-list.chrome-inset : Spacing.none;
                                    padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                    // Rows stack from the top (see friends-list).
                                    alignment: start;
                                    spacing: Spacing.xs;

                                    for request in root.private-requests: Rectangle {
                                        height: 72px;
                                        background: priv-touch.has-hover ? Colors.surface-hover : transparent;
                                        border-radius: Spacing.radius-md;

                                        // TouchArea first (behind) for hover detection
                                        priv-touch := TouchArea {}

                                        HorizontalLayout {
                                            padding: Spacing.sm;
                                            spacing: Spacing.sm;

                                            // Lock icon instead of avatar for privacy
                                            Rectangle {
                                                width: 40px;
                                                height: 40px;
                                                border-radius: 20px;
                                                background: Colors.surface;

                                                Text {
                                                    text: "\u{1F510}";  // Lock
                                                    font-size: Typography.xl;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                HorizontalLayout {
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: request.display-name;
                                                        color: Colors.text-primary;
                                                        font-size: Typography.sm;
                                                        font-weight: Typography.medium;
                                                        overflow: elide;
                                                    }

                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        border-radius: 8px;
                                                        background: Colors.primary.with-alpha(0.2);

                                                        Text {
                                                            text: "\u{1F512}";  // Private badge
                                                            font-size: Typography.xxs;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            width: 100%;
                                                            height: 100%;
                                                        }
                                                    }
                                                }

                                                if request.sent-at != "": Text {
                                                    text: request.sent-at;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.xs;
                                                alignment: center;

                                                Button {
                                                    text: "Accept";
                                                    variant: "primary";
                                                    disabled: root.private-request-decision != "";
                                                    loading: root.private-request-decision == request.user-id;

                                                    clicked => {
                                                        root.accept-private-request(request.user-id);
                                                    }
                                                }

                                                Button {
                                                    text: "Decline";
                                                    variant: "ghost";
                                                    disabled: root.private-request-decision != "";
                                                    loading: root.private-request-decision == request.user-id;

                                                    clicked => {
                                                        root.decline-private-request(request.user-id);
                                                    }
                                                }

                                                Button {
                                                    text: "Block";
                                                    variant: "destructive";
                                                    disabled: root.private-request-decision != "";

                                                    clicked => {
                                                        root.block-private-request(request.user-id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }

                    // Group invites (anonymous group invitations)
                    if root.requests-sub-tab == "groups": VerticalLayout {
                        vertical-stretch: 1;

                        if root.group-invites.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: Icons.users;
                                    width: 40px;
                                    height: 40px;
                                    colorize: Colors.text-muted;
                                }
                            }

                            Text {
                                text: "No pending group invites";
                                color: Colors.text-muted;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Group invites use end-to-end encryption\nwith anonymous mailboxes";
                                color: Colors.text-muted.with-alpha(0.7);
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }

                        if root.group-invites.length > 0: Rectangle {
                            vertical-stretch: 1;
                            property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                            scroll-group-invite-list := Flickable {
                                property <length> chrome-inset: parent.chrome-inset;
                                width: parent.width;
                                y: root.mobile-mode ? -parent.chrome-inset : 0px;
                                height: root.mobile-mode ? root.height : parent.height;
                                viewport-height: group-invite-list.preferred-height;

                                group-invite-list := VerticalLayout {
                                    padding-top: root.mobile-mode ? scroll-group-invite-list.chrome-inset : Spacing.none;
                                    padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                    // Rows stack from the top (see friends-list).
                                    alignment: start;
                                    spacing: Spacing.xs;

                                    for invite in root.group-invites: Rectangle {
                                        height: 72px;
                                        background: gi-touch.has-hover ? Colors.surface-hover : transparent;
                                        border-radius: Spacing.radius-md;

                                        gi-touch := TouchArea {}

                                        HorizontalLayout {
                                            padding: Spacing.sm;
                                            spacing: Spacing.sm;

                                            // Private groups are anonymous: ringed avatar,
                                            // like the sidebar row it will become.
                                            Avatar {
                                                size: 40px;
                                                source: invite.avatar-source;
                                                name: invite.display-name;
                                                anonymous: true;
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                HorizontalLayout {
                                                    spacing: Spacing.xs;

                                                    Text {
                                                        text: invite.display-name;
                                                        color: Colors.text-primary;
                                                        font-size: Typography.sm;
                                                        font-weight: Typography.medium;
                                                        overflow: elide;
                                                    }
                                                }

                                                // Inviter info (stored in username field)
                                                if invite.username != "": Text {
                                                    text: "Invited by " + invite.username;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.xs;
                                                alignment: center;

                                                Button {
                                                    text: "Join";
                                                    variant: "primary";

                                                    clicked => {
                                                        root.accept-group-invite(invite.user-id);
                                                    }
                                                }

                                                Button {
                                                    text: "Decline";
                                                    variant: "ghost";

                                                    clicked => {
                                                        root.decline-group-invite(invite.user-id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }

                    // Channel invites (pending channel invitations)
                    if root.requests-sub-tab == "channels": VerticalLayout {
                        vertical-stretch: 1;

                        if root.channel-invites.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: Spacing.sm;

                            Text {
                                text: "\u{0023}";  // Hash
                                font-size: Typography.huge;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "No pending channel invites";
                                color: Colors.text-muted;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Channel invitations you receive will appear here";
                                color: Colors.text-muted.with-alpha(0.7);
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }

                        if root.channel-invites.length > 0: Rectangle {
                            vertical-stretch: 1;
                            property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                            scroll-channel-invite-list := Flickable {
                                property <length> chrome-inset: parent.chrome-inset;
                                width: parent.width;
                                y: root.mobile-mode ? -parent.chrome-inset : 0px;
                                height: root.mobile-mode ? root.height : parent.height;
                                viewport-height: channel-invite-list.preferred-height;

                                channel-invite-list := VerticalLayout {
                                    padding-top: root.mobile-mode ? scroll-channel-invite-list.chrome-inset : Spacing.none;
                                    padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                    // Rows stack from the top (see friends-list).
                                    alignment: start;
                                    spacing: Spacing.xs;

                                    for invite in root.channel-invites: Rectangle {
                                        height: 72px;
                                        background: ci-touch.has-hover ? Colors.surface-hover : transparent;
                                        border-radius: Spacing.radius-md;

                                        ci-touch := TouchArea {}

                                        HorizontalLayout {
                                            padding: Spacing.sm;
                                            spacing: Spacing.sm;

                                            // No "#" chip: the name already reads "#<channel>" (§121).
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: Spacing.xxs;

                                                Text {
                                                    text: invite.display-name;
                                                    color: Colors.text-primary;
                                                    font-size: Typography.sm;
                                                    font-weight: Typography.medium;
                                                    overflow: elide;
                                                }

                                                // "Invited by <name>" (channel_invites.rs puts it in username)
                                                if invite.username != "": Text {
                                                    text: invite.username;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    overflow: elide;
                                                }

                                                // Invitation message (stored in note field)
                                                if invite.note != "": Text {
                                                    text: invite.note;
                                                    color: Colors.text-muted;
                                                    font-size: Typography.xs;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Spacing.xs;
                                                alignment: center;

                                                Button {
                                                    text: "Join";
                                                    variant: "primary";

                                                    clicked => {
                                                        root.accept-channel-invite(invite.user-id);
                                                    }
                                                }

                                                Button {
                                                    text: "Decline";
                                                    variant: "ghost";

                                                    clicked => {
                                                        root.decline-channel-invite(invite.user-id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }
                }

                // ===== Blocked Tab =====
                if root.active-tab == "blocked": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Spacing.sm;

                    // No "0 blocked users" over the empty state saying the same.
                    if root.blocked-users.length > 0: Text {
                        text: root.blocked-users.length + (root.blocked-users.length == 1 ? " blocked user" : " blocked users");
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: Typography.medium;
                    }

                    if root.blocked-users.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: Spacing.sm;

                        // U+1F6AB is another tofu box on the S9 (§112u).
                        HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: Icons.slash;
                                    width: 40px;
                                    height: 40px;
                                    colorize: Colors.text-muted;
                                }
                            }

                            Text {
                                text: "No blocked users";
                                color: Colors.text-muted;
                                font-size: Typography.base;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Users you block won't be able to message you";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                            }
                        }

                    if root.blocked-users.length > 0: Rectangle {
                        vertical-stretch: 1;
                        property <length> chrome-inset: self.absolute-position.y - root.absolute-position.y;
                        scroll-blocked-list := Flickable {
                            property <length> chrome-inset: parent.chrome-inset;
                            width: parent.width;
                            y: root.mobile-mode ? -parent.chrome-inset : 0px;
                            height: root.mobile-mode ? root.height : parent.height;

                            viewport-height: blocked-list.preferred-height;

                            blocked-list := VerticalLayout {
                                padding-top: root.mobile-mode ? scroll-blocked-list.chrome-inset : Spacing.none;
                                padding-bottom: root.mobile-mode ? root.bottom-inset + Spacing.md : Spacing.none;
                                // Rows stack from the top (see friends-list).
                                alignment: start;
                                spacing: Spacing.xs;

                                for user in root.blocked-users: Rectangle {
                                    height: 56px;
                                    background: blocked-touch.has-hover ? Colors.surface-hover : transparent;
                                    border-radius: Spacing.radius-md;

                                    // TouchArea first (behind) for hover detection
                                    blocked-touch := TouchArea {}

                                    HorizontalLayout {
                                        padding: Spacing.sm;
                                        spacing: Spacing.sm;

                                        Avatar {
                                            size: 40px;
                                            source: user.avatar-source;
                                            anonymous: user.anon;
                                            name: user.display-name;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: Spacing.xxs;

                                            Text {
                                                text: user.display-name;
                                                color: Colors.text-primary;
                                                font-size: Typography.sm;
                                                font-weight: Typography.medium;
                                                overflow: elide;
                                            }

                                            if root.confirm-remove-id == user.user-id: Text {
                                                text: user.anon ? "Delete this chat? They stay blocked." : "Remove from friends and unblock?";
                                                color: Colors.text-secondary;
                                                font-size: Typography.xs;
                                                overflow: elide;
                                            }

                                            if root.confirm-remove-id != user.user-id && user.blocked-at != "": Text {
                                                text: "Blocked " + user.blocked-at;
                                                color: Colors.text-muted;
                                                font-size: Typography.xs;
                                            }
                                        }

                                        if root.confirm-remove-id != user.user-id: HorizontalLayout {
                                            alignment: center;
                                            spacing: Spacing.xs;

                                            Button {
                                                text: "Unblock";
                                                variant: "ghost";

                                                clicked => {
                                                    root.unblock-user(user.user-id);
                                                }
                                            }

                                            // An anon peer has no friendship; its second action
                                            // deletes the stored chat (Signal: Delete on a
                                            // blocked chat), and there is none once deleted.
                                            if !user.anon || user.anon-chat: Button {
                                                text: user.anon ? "Delete chat" : "Remove";
                                                variant: "ghost";

                                                clicked => {
                                                    root.confirm-remove-id = user.user-id;
                                                }
                                            }
                                        }

                                        if root.confirm-remove-id == user.user-id: HorizontalLayout {
                                            alignment: center;
                                            spacing: Spacing.xs;

                                            Button {
                                                text: "Cancel";
                                                variant: "ghost";

                                                clicked => {
                                                    root.confirm-remove-id = "";
                                                }
                                            }

                                            Button {
                                                text: user.anon ? "Delete" : "Remove";
                                                variant: "destructive";

                                                clicked => {
                                                    root.confirm-remove-id = "";
                                                    root.remove-blocked-user(user.user-id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                        }
                    }
                }
            }
        }
    }
}
