import { Modal } from "../components/modal.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export struct PinnedItem {
    message-id: string,
    preview: string,
    thumbnail: image,
}

// Core supplies every pin in pin-added order, independent of loaded history.
export component PinnedMessagesModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <[PinnedItem]> items: [];
    callback close();
    callback selected(string);
    Modal {
        show: root.show-modal;
        title: "Pinned messages";
        close => { root.close(); }
        VerticalLayout {
            if root.items.length == 0: Text {
                text: "No pinned messages";
                color: Colors.text-muted;
                font-size: Typography.sm;
            }
            Flickable {
                min-height: 180px;
                max-height: 480px;
                viewport-height: rows.preferred-height;
                rows := VerticalLayout {
                    spacing: Spacing.xs;
                    for item in root.items: Rectangle {
                        accessible-role: button;
                        accessible-label: item.preview;
                        // The content layout already includes its padding.
                        height: max(56px, content.preferred-height);
                        background: touch.has-hover ? Colors.surface-hover : Colors.surface;
                        border-radius: Spacing.radius-md;
                        content := HorizontalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.sm;
                            if item.thumbnail.width > 0: Rectangle {
                                width: 40px;
                                min-height: 40px;
                                vertical-stretch: 1;
                                Rectangle {
                                    width: 40px; height: 40px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Spacing.radius-sm; clip: true;
                                    Image { accessible-label: "Pinned message image"; source: item.thumbnail; width: 100%; height: 100%; image-fit: cover; }
                                }
                            }
                            Text {
                                text: item.preview;
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        touch := TouchArea { clicked => { root.selected(item.message-id); } }
                    }
                }
            }
        }
    }
}
