import { Modal } from "../components/modal.slint";
import { Materials } from "../theme/materials.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export struct PinnedItem {
    message-id: string,
    preview: string,
    thumbnail: image,
}

// Core supplies every pin in pin-added order, independent of loaded history.
export component PinnedMessagesModal inherits Rectangle {
    in property <bool> show-modal: false;
    in property <[PinnedItem]> items: [];
    callback close();
    callback selected(string);
    Modal {
        show: root.show-modal;
        title: "Pinned messages";
        close => { root.close(); }
        VerticalLayout {
            if root.items.length == 0: Text {
                text: "No pinned messages";
                color: Colors.text-muted;
                font-size: Typography.sm;
            }
            Flickable {
                min-height: 180px;
                max-height: 480px;
                viewport-height: rows.preferred-height;
                rows := VerticalLayout {
                    spacing: Spacing.xs;
                    for item in root.items: Rectangle {
                        accessible-role: button;
                        accessible-label: item.preview;
                        // The same guard as the pointer path: the modal only
                        // fades after close, and a fading row is not a target.
                        accessible-action-default => { if root.show-modal { root.selected(item.message-id); } }
                        // The content layout already includes its padding.
                        height: max(56px, content.preferred-height);
                        background: touch.pressed ? Materials.pressed : touch.has-hover ? Colors.surface-hover : Colors.surface;
                        border-radius: Spacing.radius-md;
                        transform-scale-x: touch.pressed ? 97% : 100%;
                        transform-scale-y: touch.pressed ? 94% : 100%;
                        animate transform-scale-x { duration: touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                        animate transform-scale-y { duration: touch.pressed ? Materials.motion-quick : Materials.motion-standard; easing: Materials.spring; }
                        border-width: keys.has-focus ? Spacing.stroke : 0px;
                        border-color: Colors.primary;
                        keys := FocusScope {
                            width: 0px;
                            height: 0px;
                            enabled: root.show-modal;
                            key-pressed(event) => {
                                if event.text == Key.Space || event.text == Key.Return {
                                    if root.show-modal { root.selected(item.message-id); }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        content := HorizontalLayout {
                            padding: Spacing.md;
                            spacing: Spacing.sm;
                            if item.thumbnail.width > 0: Rectangle {
                                width: 40px;
                                min-height: 40px;
                                vertical-stretch: 1;
                                Rectangle {
                                    width: 40px; height: 40px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Spacing.radius-sm; clip: true;
                                    Image { accessible-label: "Pinned message image"; source: item.thumbnail; width: 100%; height: 100%; image-fit: cover; }
                                }
                            }
                            Text {
                                width: max(0px, parent.width - parent.padding-left - parent.padding-right - (item.thumbnail.width > 0 ? 40px + parent.spacing : 0px));
                                text: item.preview;
                                color: Colors.text-primary;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        touch := TouchArea { clicked => { if root.show-modal { root.selected(item.message-id); } } }
                    }
                }
            }
        }
    }
}
