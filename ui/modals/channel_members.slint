import { ChannelMemberData, ChannelRosterRowData } from "channel_member_types.slint";
import { Avatar } from "../components/avatar.slint";
import { Colors } from "../theme/colors.slint";
import { Materials } from "../theme/materials.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Button } from "../components/button.slint";
import { GlassSurface } from "../components/glass_surface.slint";
import { ScrollView } from "std-widgets.slint";

component ListView inherits Flickable {
    out property <length> visible-height: self.height;
    out property <length> visible-width: self.width;
    @children
}

component MemberMenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> destructive: false;
    callback clicked();
    height: Spacing.touch-target-min;
    border-radius: Spacing.radius-sm;
    background: item-touch.pressed ? Materials.pressed : item-touch.has-hover ? Colors.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        spacing: Spacing.md;
        Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            colorize: root.destructive ? Colors.error : Colors.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.destructive ? Colors.error : Colors.text-primary;
            font-size: Typography.sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.selected: Image {
            source: Icons.check;
            width: 18px;
            height: 18px;
            colorize: Colors.primary;
            vertical-alignment: center;
        }
    }
    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ChannelMembersSection inherits Rectangle {
    in property <[ChannelRosterRowData]> roster-rows;
    in property <bool> can-manage-members;
    in property <bool> can-invite;
    in property <bool> can-view-bans;
    in property <string> channel-name;
    in-out property <string> confirm-action;
    in property <bool> is-owner;
    in property <bool> is-private-group;
    in property <bool> loading;
    in property <string> error-message;
    in property <int> member-count;
    in property <[ChannelMemberData]> members;
    in property <bool> narrow;
    in-out property <string> role-picker-user;
    private property <ChannelMemberData> menu-member;
    private property <length> menu-content-height: 28px
        + (!root.is-private-group && root.can-manage-members ? 24px + Spacing.touch-target-min * 3 : 0px)
        + (root.menu-member.can-mute ? 1px + (root.menu-member.muted ? Spacing.touch-target-min : 24px + Spacing.touch-target-min * 3) : 0px)
        + (root.menu-member.can-make-owner || (root.menu-member.can-block && !root.menu-member.invited) ? 1px : 0px)
        + (root.menu-member.can-make-owner ? Spacing.touch-target-min : 0px)
        + (root.menu-member.can-block && !root.menu-member.invited ? Spacing.touch-target-min : 0px)
        + ((root.can-manage-members && root.menu-member.role != "owner") || root.menu-member.can-ban ? 1px : 0px)
        + (root.can-manage-members && root.menu-member.role != "owner" ? Spacing.touch-target-min : 0px)
        + (root.menu-member.can-ban ? Spacing.touch-target-min : 0px);
    callback ban-member(string);
    callback block-member(string, bool);
    callback change-member-role(string, string);
    callback invite-channel-members();
    callback invite-members();
    callback remove-member(string);
    callback set-member-muted(string, bool, int);
    callback transfer-ownership(string);
    callback unban-member(string);

    // Helper to get role display color
    pure function role-color(role: string) -> color {
        if role == "owner" {
            return Colors.warning;
        } else if role == "admin" {
            return Colors.error;
        } else if role == "moderator" {
            return Colors.info;
        } else {
            return Colors.text-secondary;
        }
    }

    // The members menu's mute choices.
    private property <[{label: string, minutes: int}]> mute-options: [
        { label: "Mute 1h", minutes: 60 },
        { label: "Mute 1 day", minutes: 1440 },
        { label: "Mute until unmuted", minutes: 0 },
    ];
    // The assignable roles (ownership moves only by transfer), with labels.
    private property <[{role: string, label: string}]> role-options: [
        { role: "member", label: "Member" },
        { role: "moderator", label: "Moderator" },
        { role: "admin", label: "Admin" },
    ];

    members-layout := VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: Spacing.md;
        alignment: start;

    HorizontalLayout {
        height: Spacing.touch-target-min;
        spacing: Spacing.sm;

        Text {
            text: "Members";
            color: Colors.text-primary;
            font-size: Typography.lg;
            font-weight: Typography.semibold;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.member-count + " total";
            color: Colors.text-muted;
            font-size: Typography.sm;
            vertical-alignment: center;
        }

        // Core decides who may invite (V1 private groups: the real owner).
        if root.is-private-group && root.can-invite: Rectangle {
            width: max(invite-btn-text.width + Spacing.md * 2, Spacing.touch-target-min);
            height: Spacing.touch-target-min;
            accessible-role: button;
            accessible-label: "Invite members";
            accessible-action-default => { root.invite-members(); }
            background: invite-btn-touch.has-hover ? Colors.action-hover : Colors.action-fill;
            border-radius: Spacing.radius-sm;

            invite-btn-text := Text {
                text: "+ Invite";
                color: Colors.on-action;
                font-size: Typography.xs;
                font-weight: Typography.medium;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            invite-btn-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.invite-members(); }
            }
        }

        // Invite button for regular channels (core: role vs. the invite rule)
        if !root.is-private-group && root.can-invite: Rectangle {
            width: max(invite-ch-btn-text.width + Spacing.md * 2, Spacing.touch-target-min);
            height: Spacing.touch-target-min;
            accessible-role: button;
            accessible-label: "Invite members";
            accessible-action-default => { root.invite-channel-members(); }
            background: invite-ch-btn-touch.has-hover ? Colors.action-hover : Colors.action-fill;
            border-radius: Spacing.radius-sm;

            invite-ch-btn-text := Text {
                text: "+ Invite";
                color: Colors.on-action;
                font-size: Typography.xs;
                font-weight: Typography.medium;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            invite-ch-btn-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.invite-channel-members(); }
            }
        }
    }

    if root.error-message != "": Text {
        width: root.width;
        height: 44px;
        text: root.error-message;
        color: Colors.error;
        font-size: Typography.sm;
        wrap: word-wrap;
    }

    // Member list
    if root.members.length == 0: Text {
        width: parent.width;
        text: root.loading ? "Loading members…" : "No members to show yet";
        color: Colors.text-secondary;
        font-size: Typography.sm;
        wrap: word-wrap;
    }
    roster-list := ListView {
        height: max(0px, root.height - Spacing.touch-target-min - Spacing.md
            - (root.error-message != "" ? 44px + Spacing.md : 0px));
        viewport-width: self.width;
        for row in root.roster-rows: Rectangle {
        width: roster-list.width;
        property <ChannelMemberData> member: row.member;
        height: row.kind == "member" || row.kind == "banned" ? 52px : 42px;
        background: row.kind == "member" && root.role-picker-user == member.user-id ? Colors.surface-section : transparent;
        border-radius: Spacing.radius-md;
        clip: true;
        animate height { duration: Materials.motion-standard; easing: Materials.glide; }
        animate background { duration: Materials.motion-quick; easing: Materials.settle; }

        member-col := VerticalLayout {
        if row.kind == "member": VerticalLayout {
            HorizontalLayout {
                height: 52px;
                spacing: Spacing.sm;
                padding-left: Spacing.md;
                padding-right: Spacing.xs;

                // Photo in a clipped circle, initials when there is none.
                Avatar {
                    size: 36px;
                    source: member.avatar-source;
                    // Private-group members are anonymous identities.
                    anonymous: root.is-private-group;
                    name: member.display-name;
                    fallback-text: "?";
                }

                // Name on its own line so it gets the whole
                // column; the role badge sits with the handle
                // underneath instead of eating the name.
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    alignment: center;

                    Text {
                        text: member.display-name;
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        overflow: elide;
                    }

                    if member.role != "member" || member.username != "" || member.muted || member.unverified || member.invited: HorizontalLayout {
                        spacing: Spacing.xs;

                        if member.role != "member": Rectangle {
                            width: role-text.preferred-width + Spacing.sm;
                            height: Spacing.badge-md;
                            background: root.role-color(member.role).with-alpha(0.15);
                            border-radius: Spacing.radius-sm;

                            role-text := Text {
                                x: Spacing.xs;
                                text: member.role;
                                color: root.role-color(member.role);
                                font-size: Typography.xs;
                                font-weight: Typography.medium;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }

                        if member.invited: Rectangle {
                            width: invited-text.preferred-width + Spacing.sm;
                            height: Spacing.badge-md;
                            background: Colors.info.with-alpha(0.15);
                            border-radius: Spacing.radius-sm;

                            invited-text := Text {
                                x: Spacing.xs;
                                text: "invited";
                                color: Colors.info;
                                font-size: Typography.xs;
                                font-weight: Typography.medium;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }

                        // Moderator mute: the server refuses their sends.
                        if member.muted: Rectangle {
                            width: muted-text.preferred-width + Spacing.sm;
                            height: Spacing.badge-md;
                            background: Colors.error.with-alpha(0.15);
                            border-radius: Spacing.radius-sm;

                            muted-text := Text {
                                x: Spacing.xs;
                                text: "muted";
                                color: Colors.error;
                                font-size: Typography.xs;
                                font-weight: Typography.medium;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }

                        // Outside the verified membership: no sender keys.
                        if member.unverified: Rectangle {
                            width: unverified-text.preferred-width + Spacing.sm;
                            height: Spacing.badge-md;
                            background: Colors.warning.with-alpha(0.15);
                            border-radius: Spacing.radius-sm;

                            unverified-text := Text {
                                x: Spacing.xs;
                                text: "unverified";
                                color: Colors.warning;
                                font-size: Typography.xs;
                                font-weight: Typography.medium;
                                vertical-alignment: center;
                                height: 100%;
                            }
                        }

                        // Empty when the peer's handle is not known locally.
                        if member.username != "": Text {
                            text: "@" + member.username;
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Badges are fixed-width, so without a stretchable
                        // child this row caps the name column's max width:
                        // the name elided and the ⋮ drifted mid-row.
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // One ⋮ opens the shared menu without changing row height.
                // Moderators/admins may have only mute or ban actions.
                if (root.can-manage-members && member.role != "owner") || member.can-ban || member.can-mute || member.can-make-owner || member.can-block: Rectangle {
                    width: Spacing.touch-target-min;
                    height: Spacing.touch-target-min;
                    border-radius: Spacing.radius-sm;
                    background: member-more.has-hover || root.role-picker-user == member.user-id
                        ? Colors.surface-hover : transparent;
                    transform-scale-x: member-more.pressed ? 0.88 : 1;
                    transform-scale-y: member-more.pressed ? 0.88 : 1;
                    animate transform-scale-x { duration: Materials.motion-quick; easing: Materials.spring; }
                    animate transform-scale-y { duration: Materials.motion-quick; easing: Materials.spring; }
                    animate background { duration: Materials.feedback-duration; easing: Materials.settle; }
                    accessible-role: button;
                    accessible-label: "Actions for " + member.display-name;
                    accessible-action-default => {
                        root.menu-member = member;
                        root.role-picker-user = root.role-picker-user == member.user-id ? "" : member.user-id;
                    }

                    // Icons.more-vertical, not U+22EE (no glyph in Inter).
                    Image {
                        source: Icons.more-vertical;
                        colorize: Colors.text-secondary;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    member-more := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.menu-member = member;
                            root.role-picker-user = root.role-picker-user == member.user-id ? "" : member.user-id;
                        }
                    }
                }
            }

        }
        }

        // Bottom border
        if row.kind == "member": Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Colors.divider;
        }
        if row.kind == "banned-header": Text {
            text: "Banned";
            color: Colors.text-primary;
            font-size: Typography.base;
            font-weight: Typography.semibold;
            vertical-alignment: center;
        }

        if row.kind == "banned": HorizontalLayout {
            height: 52px;
            spacing: Spacing.sm;
            padding: Spacing.xs;

            Avatar {
                size: 36px;
                source: row.banned.avatar-source;
                name: row.banned.display-name;
                fallback-text: "?";
            }

            Text {
                text: row.banned.display-name;
                color: Colors.text-secondary;
                font-size: Typography.sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Button {
                height: Spacing.touch-target-min;
                text: "Unban";
                variant: "secondary";
                clicked => { root.unban-member(row.banned.user-id); }
            }
        }
        }
    }
    }

    // One menu floats over the list. The roster rows stay 52px high while it
    // is open; on a phone the card rests at the bottom of this tab.
    if root.role-picker-user != "": Rectangle {
        width: root.width;
        height: root.height;
        background: root.narrow ? Materials.scrim : transparent;
        TouchArea {
            clicked => { root.role-picker-user = ""; }
        }

        if root.confirm-action == "": GlassSurface {
            width: min(280px, root.width - Spacing.md * 2);
            height: min(root.height - Spacing.md * 2, root.menu-content-height + Spacing.sm * 2);
            x: root.narrow ? (root.width - self.width) / 2 : root.width - self.width - Spacing.md;
            y: root.narrow ? root.height - self.height - Spacing.sm : Spacing.sm;
            elevation: 4;
            material-level: 3;
            menu-scroll := ScrollView {
                x: Spacing.xs;
                y: Spacing.xs;
                width: parent.width - Spacing.sm;
                height: parent.height - Spacing.sm;
                viewport-width: self.width;
                viewport-height: root.menu-content-height;
                mouse-drag-pan-enabled: true;
                menu-content := VerticalLayout {
                    width: parent.width;
                    spacing: 0px;
                    Text {
                        text: root.menu-member.display-name;
                        color: Colors.text-secondary;
                        font-size: Typography.xs;
                        font-weight: Typography.semibold;
                        height: 28px;
                        vertical-alignment: center;
                    }
                    if !root.is-private-group && root.can-manage-members: Text {
                        text: "ROLE";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        height: 24px;
                        vertical-alignment: center;
                    }
                    if !root.is-private-group && root.can-manage-members: VerticalLayout {
                        for r in root.role-options: MemberMenuItem {
                            icon: Icons.user;
                            label: r.label;
                            selected: r.role == root.menu-member.role;
                            clicked => {
                                root.role-picker-user = "";
                                if r.role != root.menu-member.role {
                                    root.change-member-role(root.menu-member.user-id, r.role);
                                }
                            }
                        }
                    }
                    if root.menu-member.can-mute: Rectangle { height: 1px; background: Colors.divider; }
                    if root.menu-member.can-mute && root.menu-member.muted: MemberMenuItem {
                        icon: Icons.volume-2;
                        label: "Unmute";
                        clicked => {
                            root.role-picker-user = "";
                            root.set-member-muted(root.menu-member.user-id, false, 0);
                        }
                    }
                    if root.menu-member.can-mute && !root.menu-member.muted: VerticalLayout {
                        Text {
                            text: "MUTE IN CHANNEL";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            height: 24px;
                            vertical-alignment: center;
                        }
                        for opt in root.mute-options: MemberMenuItem {
                            icon: Icons.volume-x;
                            label: opt.label;
                            clicked => {
                                root.role-picker-user = "";
                                root.set-member-muted(root.menu-member.user-id, true, opt.minutes);
                            }
                        }
                    }
                    if root.menu-member.can-make-owner || (root.menu-member.can-block && !root.menu-member.invited): Rectangle {
                        height: 1px; background: Colors.divider;
                    }
                    if root.menu-member.can-make-owner: MemberMenuItem {
                        icon: Icons.shield;
                        label: "Make owner…";
                        clicked => { root.confirm-action = "owner"; }
                    }
                    if root.menu-member.can-block && !root.menu-member.invited: MemberMenuItem {
                        icon: root.menu-member.blocked ? Icons.unlock : Icons.lock;
                        label: root.menu-member.blocked ? "Unblock in group" : "Block in group";
                        clicked => {
                            root.role-picker-user = "";
                            root.block-member(root.menu-member.user-id, !root.menu-member.blocked);
                        }
                    }
                    if (root.can-manage-members && root.menu-member.role != "owner") || root.menu-member.can-ban: Rectangle {
                        height: 1px; background: Colors.divider;
                    }
                    if root.can-manage-members && root.menu-member.role != "owner": MemberMenuItem {
                        icon: Icons.trash;
                        label: root.menu-member.invited && root.is-private-group ? "Cancel invite"
                            : root.is-private-group ? "Remove from group" : "Remove from channel";
                        destructive: true;
                        clicked => { root.confirm-action = "remove"; }
                    }
                    if root.menu-member.can-ban: MemberMenuItem {
                        icon: Icons.shield;
                        label: "Ban";
                        destructive: true;
                        clicked => { root.confirm-action = "ban"; }
                    }
                }
            }
        }

        if root.confirm-action != "": GlassSurface {
            width: min(360px, root.width - Spacing.md * 2);
            height: confirm-content.preferred-height + Spacing.md * 2;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            elevation: 5;
            material-level: 3;
            confirm-content := VerticalLayout {
                x: Spacing.md;
                y: Spacing.md;
                width: parent.width - Spacing.md * 2;
                spacing: Spacing.md;
                Text {
                    width: confirm-content.width;
                    text: root.confirm-action == "ban"
                        ? "Ban " + root.menu-member.display-name + "? They will be removed and can't rejoin."
                        : root.confirm-action == "owner"
                        ? "Make " + root.menu-member.display-name + " the owner of " + (root.is-private-group ? "" : "#") + root.channel-name + "? You'll become an admin."
                        : root.menu-member.invited && root.is-private-group
                        ? "Cancel " + root.menu-member.display-name + "'s invite?"
                        : "Remove " + root.menu-member.display-name + (root.is-private-group ? " from this group?" : " from this channel?");
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }
                HorizontalLayout {
                    spacing: Spacing.sm;
                    Button {
                        height: Spacing.touch-target-min;
                        text: "Cancel";
                        variant: "secondary";
                        horizontal-stretch: 1;
                        clicked => { root.confirm-action = ""; }
                    }
                    Button {
                        height: Spacing.touch-target-min;
                        text: root.confirm-action == "ban" ? "Ban" : root.confirm-action == "owner" ? "Make owner" : root.menu-member.invited && root.is-private-group ? "Cancel invite" : "Remove";
                        variant: root.confirm-action == "owner" ? "primary" : "destructive";
                        horizontal-stretch: 1;
                        clicked => {
                            if root.confirm-action == "ban" {
                                root.ban-member(root.menu-member.user-id);
                            } else if root.confirm-action == "owner" {
                                root.transfer-ownership(root.menu-member.user-id);
                            } else {
                                root.remove-member(root.menu-member.user-id);
                            }
                            root.role-picker-user = "";
                        }
                    }
                }
            }
        }
    }
}
