import { Modal } from "../components/modal.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export global MessageInfo {
    in-out property <string> message-id: "";
    in-out property <string> details: "";
    callback open(string);
}

export component MessageInfoModal inherits Modal {
    title: @tr("Message info");
    modal-width: 440px;
    max-modal-height: 460px;
    fill-height: true;

    Rectangle {
        background: Colors.surface-card;
        border-radius: Spacing.radius-panel;

        VerticalLayout {
            padding: Spacing.sm;

            Flickable {
                viewport-width: self.width;
                viewport-height: details.preferred-height;
                details := Text {
                    width: parent.width;
                    text: MessageInfo.details;
                    wrap: word-wrap;
                    color: Colors.text-primary;
                    font-size: Typography.sm;
                }
            }
        }
    }
}
