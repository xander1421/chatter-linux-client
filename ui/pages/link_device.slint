import { KeyFocus } from "../components/key_focus.slint";
import { Materials } from "../theme/materials.slint";
// Link Device page — shown on the new (secondary) device.
//
// Renders the QR code generated by chatter-core's LinkDeviceService and
// displays a live status while polling for the primary device to approve.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { ShieldOnboardingToggle } from "../anon_mode/shield_onboarding.slint";

export component LinkDevicePage inherits Rectangle {
    // Inputs from binding
    in property <image> qr-image;
    in property <string> link-url: "";
    in property <string> status-text: "Waiting for your other device…";
    in property <string> error: "";
    in property <bool> linking: false;
    in property <bool> has-local-identity: false;
    // Touch density for the Shield header control.
    in property <bool> touch: false;
    property <float> arrival: 0;
    animate arrival { duration: Materials.motion-standard; easing: Materials.glide; }
    init => { root.arrival = 1; }

    callback start();          // user clicked "Generate QR" / retry
    callback cancel();         // user wants to bail out
    callback go-to-login();    // back to login
    callback copy-link();      // copy raw URL to clipboard (paste-link fallback)

    background: Materials.ambient;

    flick := Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;
        interactive: content.preferred-height > self.height;

        content := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.none;
            alignment: center;
            // Centre the card (see login.slint).
            cross-axis-alignment: center;

            Rectangle { height: Spacing.xl; }

            Rectangle {
                width: min(480px, flick.width - 2 * Spacing.lg);
                background: Colors.surface;
                border-radius: Spacing.radius-lg;
                transform-origin: { x: self.width / 2, y: 0px };
                transform-scale-x: 96% + root.arrival * 4%;
                transform-scale-y: 94% + root.arrival * 6%;
                opacity: 0.5 + root.arrival * 0.5;

                VerticalLayout {
                    spacing: Spacing.md;
                    padding: Spacing.lg;

                    // Choose before "Generate QR": linking talks to the server
                    // from the first step. Fixed while a link is running.
                    ShieldOnboardingToggle {
                        busy: root.linking;
                        touch: root.touch;
                    }

                    Text {
                        text: "Link this device";
                        color: Colors.primary;
                        font-size: Typography.xxl;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "On your already-signed-in device, open Settings › Linked devices › Manage devices › Link new device, then scan this code.";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if root.has-local-identity: Text {
                        text: "This device still holds another account's keys. Linking a different account will fail. Sign in to that account instead, or clear this app's data first.";
                        color: Colors.error;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // The code grows out of its waiting surface once core has
                    // generated the link. Keep the surface stable while it does.
                    Rectangle {
                        height: 280px;
                        background: root.link-url != "" ? white : Colors.surface-hover;
                        border-radius: Spacing.radius-md;
                        animate background { duration: Materials.motion-standard; easing: Materials.glide; }

                        Image {
                            source: root.qr-image;
                            width: 256px;
                            height: 256px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            opacity: root.link-url != "" ? 1 : 0;
                            animate opacity { duration: Materials.motion-standard; easing: Materials.spring; }
                        }
                        Text {
                            text: root.linking ? "Preparing your secure link…" : "Your QR code will appear here";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            wrap: word-wrap;
                            opacity: root.link-url == "" ? 1 : 0;
                            animate opacity { duration: Materials.motion-quick; easing: Materials.settle; }
                        }
                    }

                    // Paste-link fallback row
                    if root.link-url != "": VerticalLayout {
                        spacing: Spacing.xs;
                        Text {
                            text: "Can't scan? Copy and paste this link into the other device:";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            VerticalLayout {
                                padding: Spacing.sm;
                                // One elided line, not wrapped: the column sized
                                // this row from the URL's UNWRAPPED height (one
                                // line) while it rendered four, so "Copy link"
                                // slid under the verification status (§138).
                                // The button copies the whole URL anyway.
                                Text {
                                    text: root.link-url;
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    overflow: elide;
                                }
                            }
                        }
                        Button {
                            text: "Copy link";
                            variant: "secondary";
                            clicked => { root.copy-link(); }
                        }
                    }

                    // Status (two lines once the verification code is shown).
                    // A direct child of the column so it gets the column's width
                    // and its full wrapped height; centred inside a
                    // HorizontalLayout it overflowed its row onto "Copy link".
                    Text {
                        text: root.status-text;
                        color: root.linking ? Colors.primary : Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if error != "": Text {
                        text: root.error;
                        color: Colors.error;
                        font-size: Typography.sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: Spacing.sm;
                        Button {
                            text: "Cancel";
                            variant: "secondary";
                            clicked => { root.cancel(); }
                        }
                        Button {
                            text: "Generate QR";
                            variant: "primary";
                            disabled: root.linking;
                            clicked => { root.start(); }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Back to login";
                            color: Colors.primary;
                            font-size: Typography.sm;
                            height: Spacing.touch-target-min;
                            vertical-alignment: center;
                            accessible-role: button;
                            accessible-action-default => { root.cancel(); }
                            KeyFocus { activate => { root.cancel(); } }
                            TouchArea { clicked => { root.cancel(); } }
                        }
                    }
                }
            }

            Rectangle { height: Spacing.xl; }
        }
    }
}
