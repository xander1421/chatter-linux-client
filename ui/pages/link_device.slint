import { Materials } from "../theme/materials.slint";
// Link Device page — shown on the new (secondary) device.
//
// Renders the QR code generated by chatter-core's LinkDeviceService and
// displays a live status while polling for the primary device to approve.

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { ShieldOnboardingToggle } from "../anon_mode/shield_onboarding.slint";

export component LinkDevicePage inherits Rectangle {
    // Inputs from binding
    in property <image> qr-image;
    in property <string> link-url: "";
    in property <string> status-text: "Waiting for your other device…";
    in property <string> error: "";
    in property <bool> linking: false;
    // Touch density for the Shield header control.
    in property <bool> touch: false;

    callback start();          // user clicked "Generate QR" / retry
    callback cancel();         // user wants to bail out
    callback go-to-login();    // back to login
    callback copy-link();      // copy raw URL to clipboard (paste-link fallback)

    background: Materials.ambient;

    flick := Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;
        interactive: content.preferred-height > self.height;

        content := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.none;
            alignment: center;
            // Centre the card (see login.slint).
            cross-axis-alignment: center;

            Rectangle { height: Spacing.xl; }

            Rectangle {
                width: min(480px, flick.width - 2 * Spacing.lg);
                background: Colors.surface;
                border-radius: Spacing.radius-lg;

                VerticalLayout {
                    spacing: Spacing.md;
                    padding: Spacing.lg;

                    // Choose before "Generate QR": linking talks to the server
                    // from the first step. Fixed while a link is running.
                    ShieldOnboardingToggle {
                        busy: root.linking;
                        touch: root.touch;
                    }

                    Text {
                        text: "Link this device";
                        color: Colors.primary;
                        font-size: Typography.xxl;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "On your already-signed-in device, open Settings › Active Sessions › View All › Link new device, then scan this code.";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // QR image area (white background for camera contrast)
                    Rectangle {
                        height: 280px;
                        background: white;
                        border-radius: Spacing.radius-md;

                        Image {
                            source: root.qr-image;
                            width: 256px;
                            height: 256px;
                            image-fit: contain;
                        }
                    }

                    // Paste-link fallback row
                    if root.link-url != "": VerticalLayout {
                        spacing: Spacing.xs;
                        Text {
                            text: "Can't scan? Copy and paste this link into the other device:";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            VerticalLayout {
                                padding: Spacing.sm;
                                // One elided line, not wrapped: the column sized
                                // this row from the URL's UNWRAPPED height (one
                                // line) while it rendered four, so "Copy link"
                                // slid under the verification status (§138).
                                // The button copies the whole URL anyway.
                                Text {
                                    text: root.link-url;
                                    color: Colors.text-secondary;
                                    font-size: Typography.xs;
                                    overflow: elide;
                                }
                            }
                        }
                        Button {
                            text: "Copy link";
                            variant: "secondary";
                            clicked => { root.copy-link(); }
                        }
                    }

                    // Status (two lines once the verification code is shown).
                    // A direct child of the column so it gets the column's width
                    // and its full wrapped height; centred inside a
                    // HorizontalLayout it overflowed its row onto "Copy link".
                    Text {
                        text: root.status-text;
                        color: root.linking ? Colors.primary : Colors.text-secondary;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if error != "": Text {
                        text: root.error;
                        color: Colors.error;
                        font-size: Typography.sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: Spacing.sm;
                        Button {
                            text: "Cancel";
                            variant: "secondary";
                            clicked => { root.cancel(); }
                        }
                        Button {
                            text: root.linking ? "Restart" : "Generate QR";
                            variant: "primary";
                            clicked => { root.start(); }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Back to login";
                            color: Colors.primary;
                            font-size: Typography.sm;
                            TouchArea { clicked => { root.go-to-login(); } }
                        }
                    }
                }
            }

            Rectangle { height: Spacing.xl; }
        }
    }
}
