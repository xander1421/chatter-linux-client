import { Materials } from "../theme/materials.slint";
// Register page component with multi-step onboarding flow

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";
import { OfflineMeshNotice } from "../components/offline_mesh_notice.slint";
import { DismissButton } from "../components/dismiss_button.slint";
import { ShieldOnboardingToggle } from "../anon_mode/shield_onboarding.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";

export component RegisterPage inherits Rectangle {
    in-out property <string> display-name: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> confirm-password: "";
    in-out property <string> pin: "";
    in-out property <string> confirm-pin: "";
    in-out property <string> server-url;
    
    in property <bool> loading: false;
    in property <string> error: "";
    in property <image> avatar-source;
    in property <bool> has-avatar: false;
    in property <int> selected-default-idx: -1;
    // Touch density for the Shield header control.
    in property <bool> touch: false;
    
    // Task 1: Username availability
    
    // Internal navigation state (Task 2)
    // Steps: 1: Profile, 2: Password, 3: PIN, 4: Server/Review
    property <int> current-step: 1;
    property <int> total-steps: 4;

    property <bool> submitted: false;
    property <bool> passwords-match: password == confirm-password;
    property <bool> pins-match: pin == confirm-pin;
    
    // Password strength — computed in chatter-core, set from Rust
    in property <int> password-strength: 0;

    // PIN strength — computed in chatter-core, set from Rust
    in property <int> pin-strength: 0;
    
    property <bool> show-advanced: false;

    callback register(string, string, string, string, string);
    callback password-changed(string);
    callback pin-changed(string);
    callback select-avatar();
    callback select-default-avatar(int);
    callback go-to-login();
    callback continue-without-account();

    // Live server reachability and the mesh escape hatch. Step 4 of this wizard
    // is where a serverless install used to strand: "Create Account" is the only
    // control on it, and with no server it can never succeed. See
    // `components/offline_mesh_notice.slint`.
    // Settled-unreachable, computed by chatter-core
    // (`ConnectionState::is_unreachable`) rather than string-matched here.
    in property <bool> server-unreachable: false;
    in property <bool> account-free-surfaces: false;

    background: Materials.ambient;

    VerticalLayout {
        // TopAppBar / Header (Task 2)
        Rectangle {
            height: 56px;
            background: Colors.surface;
            
            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.md;
                
                // Back button (shown after step 1)
                if current-step > 1: DismissButton {
                    back: true;
                    clicked => { current-step -= 1; }
                }
                
                if current-step == 1: Rectangle { width: Spacing.header-action-box-touch; } // Spacer
                
                Text {
                    text: "Create Account";
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    font-weight: Typography.semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Text {
                    text: "Step \{current-step} of \{total-steps}";
                    color: Colors.text-muted;
                    font-size: Typography.xs;
                    vertical-alignment: center;
                }
            }
            
            // Progress bar
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                width: 100%;
                background: Colors.border;
                
                Rectangle {
                    x: 0;
                    height: 100%;
                    width: parent.width * (current-step / total-steps);
                    background: Colors.primary;
                    animate width { duration: 250ms; easing: ease-out; }
                }
            }
        }

        flick := Flickable {
            viewport-height: content.preferred-height;
            interactive: content.preferred-height > self.height;

            content := VerticalLayout {
                padding: Spacing.lg;
                spacing: Spacing.none;
                // Centre the card (see login.slint).
                cross-axis-alignment: center;

                Rectangle { height: Spacing.xl; }

                Rectangle {
                    width: min(480px, flick.width - 2 * Spacing.lg);
                    background: Colors.surface;
                    border-radius: Spacing.radius-lg;

                    VerticalLayout {
                        spacing: Spacing.lg;
                        padding: Spacing.lg;

                        // On every step, so Shield is chosen before anything
                        // is sent — not discovered on the last page.
                        ShieldOnboardingToggle {
                            busy: root.loading;
                            touch: root.touch;
                        }

                        // Both of these used to live inside step 4, which meant a
                        // registration that failed while the user was on any other
                        // step reported nothing at all — and dev-mode
                        // auto-register submits from step 1. The condition is not
                        // step-specific, so neither is where it is said.
                        if error != "": Text {
                            text: root.error;
                            color: Colors.error;
                            font-size: Typography.sm;
                            wrap: word-wrap;
                            min-height: self.preferred-height; // see the step-3 description
                        }

                        if root.server-unreachable: OfflineMeshNotice {
                            account-free-surfaces: root.account-free-surfaces;
                            continue-without-account => { root.continue-without-account(); }
                        }

                        // --- STEP 1: PROFILE ---
                        if current-step == 1: VerticalLayout {
                            spacing: Spacing.md;
                            
                            Text {
                                text: "Set up your profile";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.bold;
                                horizontal-alignment: center;
                            }

                            // Avatar selection
                            HorizontalLayout {
                                alignment: center;
                                spacing: Spacing.md;

                                Rectangle {
                                    accessible-role: button;
                                    accessible-label: "Upload custom avatar";
                                    width: 80px;
                                    height: 80px;
                                    border-radius: 40px;
                                    background: Colors.surface-hover;
                                    clip: true;

                                    Avatar {
                                        size: 80px;
                                        source: root.has-avatar ? root.avatar-source : @image-url("../../assets/icon-256.png");
                                        fallback-text: "+";
                                    }

                                    TouchArea {
                                        enabled: !root.loading;
                                        clicked => { root.select-avatar(); }
                                    }
                                }

                                // Default avatar color presets
                                for preset[i] in [
                                    { color: Colors.primary, letter: "A" },
                                    { color: Colors.info, letter: "B" },
                                    { color: Colors.group-accent, letter: "C" },
                                ]: Rectangle {
                                    accessible-role: button;
                                    accessible-label: "Default avatar " + preset.letter;
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 22px;
                                    background: preset.color;
                                    // Selected state. text-primary, not the usual
                                    // Colors.primary: preset A IS primary.
                                    border-width: root.selected-default-idx == i ? Spacing.stroke : 0px;
                                    border-color: Colors.text-primary;

                                    Text {
                                        text: preset.letter;
                                        color: Colors.text-primary;
                                        font-size: Typography.lg;
                                        font-weight: Typography.semibold;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    TouchArea {
                                        enabled: !root.loading;
                                        clicked => { root.select-default-avatar(i); }
                                    }
                                }
                            }

                            // Display name
                            Input {
                                placeholder: "Display name";
                                text <=> root.display-name;
                                disabled: root.loading;
                            }

                            // No availability check: the server exposes no
                            // username-lookup RPC, so the field is a plain
                            // input and registration reports a clash
                            // (OPEN-ITEMS §82).
                            Input {
                                placeholder: "Username";
                                text <=> root.username;
                                disabled: root.loading;
                            }

                            Button {
                                text: "Continue";
                                variant: "primary";
                                disabled: display-name == "" || username == "";
                                clicked => { current-step = 2; }
                            }
                        }

                        // --- STEP 2: PASSWORD ---
                        if current-step == 2: VerticalLayout {
                            spacing: Spacing.md;
                            
                            Text {
                                text: "Secure your account";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.bold;
                                horizontal-alignment: center;
                            }

                            // Password
                            Input {
                                placeholder: "Password";
                                password: true;
                                text <=> root.password;
                                disabled: root.loading;
                                edited(text) => { root.password-changed(text); }
                            }

                            // Password strength meter (4 segments)
                            if root.password-strength > 0: VerticalLayout {
                                accessible-role: text;
                                accessible-label: "Password strength: " + (root.password-strength == 1 ? "Weak" :
                                    root.password-strength == 2 ? "Fair" :
                                    root.password-strength == 3 ? "Good" : "Strong");
                                spacing: Spacing.xs;
                                HorizontalLayout {
                                    spacing: Spacing.xs;
                                    height: 6px;
                                    
                                    for i in 4: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 4px;
                                        border-radius: 2px;
                                        background: i < root.password-strength ? 
                                            (root.password-strength == 1 ? Colors.error : 
                                             root.password-strength == 2 ? Colors.warning :
                                             root.password-strength == 3 ? Colors.info : Colors.success) : 
                                            Colors.surface-hover;
                                    }
                                }
                                Text {
                                    text: root.password-strength == 1 ? "Weak" :
                                          root.password-strength == 2 ? "Fair" :
                                          root.password-strength == 3 ? "Good" : "Strong";
                                    color: root.password-strength == 1 ? Colors.error : 
                                           root.password-strength == 2 ? Colors.warning :
                                           root.password-strength == 3 ? Colors.info : Colors.success;
                                    font-size: Typography.xxs;
                                }
                            }

                            // Confirm password
                            Input {
                                placeholder: "Confirm password";
                                password: true;
                                text <=> root.confirm-password;
                                disabled: root.loading;
                                error: password != "" && confirm-password != "" && !passwords-match;
                                error-message: "Passwords do not match";
                            }

                            Button {
                                text: "Continue";
                                variant: "primary";
                                disabled: password == "" || !passwords-match || password-strength < 2;
                                clicked => { current-step = 3; }
                            }
                        }

                        // --- STEP 3: PIN ---
                        if current-step == 3: VerticalLayout {
                            spacing: Spacing.md;
                            
                            Text {
                                text: "Create recovery PIN";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.bold;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Your PIN protects your encryption key backup. You'll need it to recover messages if you lose this device.";
                                color: Colors.text-muted;
                                font-size: Typography.sm;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                // A wrapped Text inside an `if` under-reports its
                                // height to the enclosing layout (Slint 1.17 sizes
                                // it at the wrong width), so the card came out
                                // ~2 lines short and Continue hung off its bottom.
                                min-height: self.preferred-height;
                            }

                            Input {
                                placeholder: "Create a PIN (8+ characters)";
                                password: true;
                                text <=> root.pin;
                                disabled: root.loading;
                                edited(text) => { root.pin-changed(text); }
                            }

                            // PIN strength (3 segments: weak/fair/strong)
                            if root.pin-strength > 0: HorizontalLayout {
                                accessible-role: text;
                                accessible-label: "PIN strength: " + (root.pin-strength == 1 ? "Weak" :
                                    root.pin-strength == 2 ? "Fair" : "Strong");
                                spacing: Spacing.xs;
                                height: 8px;
                                Rectangle {
                                    horizontal-stretch: 1; height: 4px; border-radius: 2px;
                                    background: root.pin-strength == 1 ? Colors.error : (root.pin-strength == 2 ? Colors.warning : Colors.success);
                                }
                                Rectangle {
                                    horizontal-stretch: 1; height: 4px; border-radius: 2px;
                                    background: root.pin-strength >= 2 ? (root.pin-strength == 3 ? Colors.success : Colors.warning) : Colors.surface-hover;
                                }
                                Rectangle {
                                    horizontal-stretch: 1; height: 4px; border-radius: 2px;
                                    background: root.pin-strength == 3 ? Colors.success : Colors.surface-hover;
                                }
                            }

                            // Confirm PIN
                            Input {
                                placeholder: "Confirm PIN";
                                password: true;
                                text <=> root.confirm-pin;
                                disabled: root.loading;
                                error: pin != "" && confirm-pin != "" && !root.pins-match;
                                error-message: "PINs do not match";
                            }

                            Button {
                                text: "Continue";
                                variant: "primary";
                                disabled: pin == "" || !pins-match || pin-strength < 2;
                                clicked => { current-step = 4; }
                            }
                        }

                        // --- STEP 4: REVIEW & SERVER ---
                        if current-step == 4: VerticalLayout {
                            spacing: Spacing.md;
                            
                            Text {
                                text: "Finalize Registration";
                                color: Colors.text-primary;
                                font-size: Typography.xl;
                                font-weight: Typography.bold;
                                horizontal-alignment: center;
                            }

                            // Server selection
                            Input {
                                placeholder: "Server URL";
                                text <=> root.server-url;
                                disabled: root.loading;
                            }

                            HorizontalLayout {
                                spacing: Spacing.sm;
                                Button {
                                    text: "Localhost";
                                    variant: "secondary";
                                    horizontal-stretch: 1;
                                    disabled: root.loading;
                                    clicked => { root.server-url = "http://localhost:50051"; }
                                }
                                Button {
                                    text: "Official";
                                    variant: "secondary";
                                    horizontal-stretch: 1;
                                    disabled: root.loading;
                                    clicked => { root.server-url = "https://api.chatter.example.com"; }
                                }
                            }

                            if root.loading && AnonMode.onboarding-progress != "": Text {
                                text: AnonMode.onboarding-progress;
                                color: Colors.text-secondary;
                                font-size: Typography.sm;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            Button {
                                text: loading ? "" : "Create Account";
                                variant: "primary";
                                loading: root.loading;
                                disabled: root.loading || server-url == "";

                                clicked => {
                                    root.register(root.username, root.password, root.display-name, root.pin, root.server-url);
                                }
                            }
                        }

                        // Login link (only on first step)
                        if current-step == 1: HorizontalLayout {
                            alignment: center;
                            spacing: Spacing.xs;
                            Text { text: "Already have an account?"; color: Colors.text-secondary; font-size: Typography.sm; }
                            Text {
                                text: "Sign in";
                                color: Colors.primary;
                                font-size: Typography.sm;
                                font-weight: Typography.medium;
                                TouchArea { clicked => { root.go-to-login(); } }
                            }
                        }
                    }
                }

                // Bottom spacer
                Rectangle { height: Spacing.xl; }
            }
        }
    }
}
