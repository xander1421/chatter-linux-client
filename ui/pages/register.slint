// Register page component with validation and password confirmation

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { Avatar } from "../components/avatar.slint";

export component RegisterPage inherits Rectangle {
    in-out property <string> display-name: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> confirm-password: "";
    in-out property <string> pin: "";
    in-out property <string> confirm-pin: "";
    in-out property <string> server-url;
    in property <bool> loading: false;
    in property <string> error: "";
    in property <image> avatar-source;
    in property <bool> has-avatar: false;
    in property <int> selected-default-idx: -1;

    property <bool> submitted: false;
    property <bool> passwords-match: password == confirm-password;
    property <bool> pins-match: pin == confirm-pin;
    property <int> pin-length: pin.character-count;
    property <bool> pin-is-weak: pin-length > 0 && pin-length < 4;
    property <bool> pin-is-medium: pin-length >= 4 && pin-length < 6;
    property <bool> pin-is-strong: pin-length >= 6;
    property <bool> show-advanced: false;

    callback register(string, string, string, string, string);
    callback select-avatar();
    callback select-default-avatar(int);
    callback go-to-login();

    background: Colors.background;

    Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;
        // Only allow scrolling when content overflows the screen.
        // Prevents Flickable from stealing touch events from buttons on Android
        // (Flickable's 100ms gesture disambiguation swallows taps with finger wobble).
        interactive: content.preferred-height > self.height;

        content := VerticalLayout {
            padding: Spacing.lg;
            spacing: 0px;

            // Top spacer (pushes form down a bit, collapses when scrolling)
            Rectangle { height: Spacing.xl; }

            Rectangle {
                max-width: 400px;
                horizontal-stretch: 0;
                background: Colors.surface;
                border-radius: Spacing.radius-lg;

                VerticalLayout {
                    spacing: Spacing.md;
                    padding: Spacing.lg;

                    Text {
                        text: "Chatter";
                        color: Colors.primary;
                        font-size: Typography.xxxl;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Create your account";
                        color: Colors.text-secondary;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                    }

                    // Avatar selection
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.md;

                        Rectangle {
                            width: 72px;
                            height: 72px;
                            border-radius: 36px;
                            background: Colors.surface-hover;
                            clip: true;

                            Avatar {
                                size: 72px;
                                source: root.has-avatar ? root.avatar-source : @image-url("../../assets/icon-256.png");
                                fallback-text: "+";
                            }

                            TouchArea {
                                enabled: !root.loading;
                                clicked => { root.select-avatar(); }
                            }
                        }

                        // Default avatar color presets (letter-based, professional)
                        for preset[i] in [
                            { color: #0d9488, letter: "A" },
                            { color: #3b82f6, letter: "B" },
                            { color: #8b5cf6, letter: "C" },
                        ]: Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: preset.color;
                            border-width: 2px;
                            border-color: root.selected-default-idx == i ? Colors.text-primary : transparent;

                            Text {
                                text: preset.letter;
                                color: Colors.text-primary;
                                font-size: 16px;
                                font-weight: Typography.semibold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            TouchArea {
                                enabled: !root.loading;
                                clicked => { root.select-default-avatar(i); }
                            }
                        }
                    }

                    // Display name
                    Input {
                        placeholder: "Display name";
                        text <=> root.display-name;
                        disabled: root.loading;
                    }

                    // Username
                    Input {
                        placeholder: "Username";
                        text <=> root.username;
                        disabled: root.loading;
                    }

                    // Password
                    Input {
                        placeholder: "Password";
                        password: true;
                        text <=> root.password;
                        disabled: root.loading;
                    }

                    // Confirm password
                    Input {
                        placeholder: "Confirm password";
                        password: true;
                        text <=> root.confirm-password;
                        disabled: root.loading;
                    }

                    // PIN section with explanation
                    VerticalLayout {
                        spacing: Spacing.xs;

                        // Explanation of what PIN protects
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: "\u{1F512}";
                                font-size: Typography.xs;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Your PIN protects your encryption key backup. If you lose your device, you'll need this PIN to recover your messages.";
                                color: Colors.text-muted;
                                font-size: Typography.xs;
                                wrap: word-wrap;
                            }
                        }

                        Input {
                            placeholder: "Create a PIN (at least 4 digits)";
                            password: true;
                            text <=> root.pin;
                            disabled: root.loading;
                        }

                        // PIN strength indicator
                        if root.pin-length > 0: HorizontalLayout {
                            spacing: Spacing.xs;
                            height: 8px;

                            // Strength bar
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: 2px;
                                background: root.pin-is-weak ? Colors.error : (root.pin-is-medium ? Colors.warning : Colors.success);
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: 2px;
                                background: root.pin-is-medium || root.pin-is-strong ? (root.pin-is-strong ? Colors.success : Colors.warning) : Colors.surface-hover;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: 2px;
                                background: root.pin-is-strong ? Colors.success : Colors.surface-hover;
                            }

                            Text {
                                text: root.pin-is-weak ? "Weak" : (root.pin-is-medium ? "Good" : "Strong");
                                color: root.pin-is-weak ? Colors.error : (root.pin-is-medium ? Colors.warning : Colors.success);
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        // Confirm PIN
                        Input {
                            placeholder: "Confirm PIN";
                            password: true;
                            text <=> root.confirm-pin;
                            disabled: root.loading;
                            error: root.submitted && root.confirm-pin != "" && !root.pins-match;
                            error-message: "PINs do not match";
                        }
                    }

                    // Advanced settings toggle
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;

                        Image {
                            source: root.show-advanced ? Icons.chevron-left : Icons.chevron-right;
                            width: 12px;
                            height: 12px;
                            colorize: Colors.text-muted;
                            y: (parent.height - self.height) / 2;
                            transform-rotation: root.show-advanced ? -90deg : 0deg;
                        }

                        Text {
                            text: "Advanced";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-advanced = !root.show-advanced; }
                            }
                        }
                    }

                    // Server URL (hidden behind Advanced)
                    if root.show-advanced: Input {
                        placeholder: "Server URL";
                        text <=> root.server-url;
                        disabled: root.loading;
                    }

                    if root.show-advanced: HorizontalLayout {
                        spacing: Spacing.sm;

                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            Text { text: "Localhost"; font-size: Typography.xs; color: Colors.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.server-url = "http://localhost:50051"; } }
                        }

                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            Text { text: "LAN"; font-size: Typography.xs; color: Colors.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.server-url = "http://192.168.0.7:50051"; } }
                        }

                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            Text { text: "Tunnel"; font-size: Typography.xs; color: Colors.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.server-url = "https://seeker-dance-ignored-clusters.trycloudflare.com"; } }
                        }
                    }

                    // Validation errors
                    if submitted && !passwords-match: Text {
                        text: "Passwords do not match";
                        color: Colors.error;
                        font-size: Typography.sm;
                    }

                    if submitted && !pins-match && confirm-pin != "": Text {
                        text: "PINs do not match";
                        color: Colors.error;
                        font-size: Typography.sm;
                    }

                    if submitted && pin-is-weak: Text {
                        text: "PIN must be at least 4 digits";
                        color: Colors.error;
                        font-size: Typography.sm;
                    }

                    if error != "": Text {
                        text: root.error;
                        color: Colors.error;
                        font-size: Typography.sm;
                        wrap: word-wrap;
                    }

                    // Register button
                    Button {
                        text: loading ? "" : "Create Account";
                        variant: "primary";
                        loading: root.loading;
                        disabled: root.loading;

                        clicked => {
                            submitted = true;
                            if display-name != "" && username != "" && password != "" && confirm-password != "" && pin != "" && confirm-pin != "" && server-url != "" && passwords-match && pins-match && !pin-is-weak {
                                root.register(root.username, root.password, root.display-name, root.pin, root.server-url);
                            }
                        }
                    }

                    // Login link
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Text {
                            text: "Already have an account?";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                        }

                        Text {
                            text: "Sign in";
                            color: Colors.primary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;

                            TouchArea {
                                clicked => { root.go-to-login(); }
                            }
                        }
                    }
                }
            }

            // Bottom spacer
            Rectangle { height: Spacing.xl; }
        }
    }
}
