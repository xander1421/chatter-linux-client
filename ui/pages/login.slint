// Login page component

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";

export component LoginPage inherits Rectangle {
    in-out property <string> username: "";
    in-out property <string> password: "";

    callback login(string, string);
    callback register();

    background: Colors.background;

    VerticalLayout {
        alignment: center;
        spacing: Spacing.lg;
        padding: Spacing.xl;

        Text {
            text: "Welcome to Chatter";
            color: Colors.text-primary;
            font-size: 24px;
            horizontal-alignment: center;
        }

        Input {
            placeholder: "Username";
            text <=> root.username;
        }

        Input {
            placeholder: "Password";
            password: true;
            text <=> root.password;
        }

        Button {
            text: "Login";
            clicked => {
                root.login(root.username, root.password);
            }
        }
    }
}
