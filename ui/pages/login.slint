// Login page component

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";

export component LoginPage inherits Rectangle {
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> pin: "";
    in-out property <string> server-url: "https://seeker-dance-ignored-clusters.trycloudflare.com";
    in-out property <string> sso-issuer-url: "";
    in-out property <string> sso-client-id: "chatter-app";
    in property <bool> loading: false;
    in property <string> error: "";

    property <bool> submitted: false;
    property <bool> show-advanced: false;

    callback login(string, string, string, string);
    callback sso-login(string, string, string);
    callback register();
    callback go-to-recovery();

    background: Colors.background;

    Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;
        interactive: content.preferred-height > self.height;

        content := VerticalLayout {
            padding: Spacing.lg;
            spacing: 0px;

            Rectangle { height: Spacing.xl * 2; }

            Rectangle {
                max-width: 400px;
                horizontal-stretch: 0;
                background: Colors.surface;
                border-radius: Spacing.radius-lg;

                VerticalLayout {
                    spacing: Spacing.md;
                    padding: Spacing.lg;

                    Text {
                        text: "Chatter";
                        color: Colors.primary;
                        font-size: Typography.xxxl;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Sign in to continue";
                        color: Colors.text-secondary;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                    }

                    // Username
                    Input {
                        placeholder: "Username";
                        text <=> root.username;
                        disabled: root.loading;
                    }

                    // Password
                    Input {
                        placeholder: "Password";
                        password: true;
                        text <=> root.password;
                        disabled: root.loading;
                    }

                    // PIN (optional) with explanation
                    VerticalLayout {
                        spacing: 2px;

                        Input {
                            placeholder: "PIN (optional)";
                            password: true;
                            text <=> root.pin;
                            disabled: root.loading;
                        }

                        Text {
                            text: "Enter your PIN to restore encryption keys on this device";
                            color: Colors.text-muted;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }

                    // Advanced settings toggle
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;

                        Image {
                            source: root.show-advanced ? Icons.chevron-left : Icons.chevron-right;
                            width: 12px;
                            height: 12px;
                            colorize: Colors.text-muted;
                            y: (parent.height - self.height) / 2;
                            // Rotate down when expanded
                            transform-rotation: root.show-advanced ? -90deg : 0deg;
                        }

                        Text {
                            text: "Advanced";
                            color: Colors.text-muted;
                            font-size: Typography.xs;
                            vertical-alignment: center;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-advanced = !root.show-advanced; }
                            }
                        }
                    }

                    // Server URL (hidden behind Advanced)
                    if root.show-advanced: Input {
                        placeholder: "Server URL";
                        text <=> root.server-url;
                        disabled: root.loading;
                    }

                    if root.show-advanced: HorizontalLayout {
                        spacing: Spacing.sm;

                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            Text { text: "Localhost"; font-size: Typography.xs; color: Colors.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.server-url = "http://localhost:50051"; } }
                        }

                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            Text { text: "LAN"; font-size: Typography.xs; color: Colors.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.server-url = "http://192.168.0.7:50051"; } }
                        }

                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            background: Colors.surface-hover;
                            border-radius: Spacing.radius-sm;
                            Text { text: "Tunnel"; font-size: Typography.xs; color: Colors.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.server-url = "https://seeker-dance-ignored-clusters.trycloudflare.com"; } }
                        }
                    }

                    if error != "": Text {
                        text: root.error;
                        color: Colors.error;
                        font-size: Typography.sm;
                        wrap: word-wrap;
                    }

                    // Forgot password
                    HorizontalLayout {
                        alignment: end;
                        Text {
                            text: "Forgot password?";
                            color: Colors.primary;
                            font-size: Typography.xs;
                            TouchArea {
                                clicked => { root.go-to-recovery(); }
                            }
                        }
                    }

                    // Login button
                    Button {
                        text: loading ? "" : "Sign In";
                        variant: "primary";
                        loading: root.loading;
                        disabled: root.loading;

                        clicked => {
                            submitted = true;
                            if username != "" && password != "" && server-url != "" {
                                root.login(root.username, root.password, root.server-url, root.pin);
                            }
                        }
                    }

                    // SSO divider
                    HorizontalLayout {
                        spacing: Spacing.sm;
                        Rectangle { height: 1px; background: Colors.border; vertical-stretch: 0; horizontal-stretch: 1; y: (parent.height - self.height) / 2; }
                        Text { text: "or"; color: Colors.text-muted; font-size: Typography.xs; vertical-alignment: center; }
                        Rectangle { height: 1px; background: Colors.border; vertical-stretch: 0; horizontal-stretch: 1; y: (parent.height - self.height) / 2; }
                    }

                    // SSO login button
                    Button {
                        text: loading ? "" : "Login with SSO";
                        variant: "secondary";
                        loading: root.loading;
                        disabled: root.loading;

                        clicked => {
                            if server-url != "" {
                                root.sso-login(root.server-url, root.sso-issuer-url, root.sso-client-id);
                            }
                        }
                    }

                    // SSO config (in Advanced section)
                    if root.show-advanced: VerticalLayout {
                        spacing: 2px;
                        Input {
                            placeholder: "SSO Issuer URL (e.g. http://localhost:8180/realms/chatter)";
                            text <=> root.sso-issuer-url;
                            disabled: root.loading;
                        }
                        Input {
                            placeholder: "SSO Client ID";
                            text <=> root.sso-client-id;
                            disabled: root.loading;
                        }
                    }

                    // Register link
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Text {
                            text: "Don't have an account?";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                        }

                        Text {
                            text: "Register";
                            color: Colors.primary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;

                            TouchArea {
                                clicked => { root.register(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: Spacing.xl; }
        }
    }
}
