import { Materials } from "../theme/materials.slint";
// Login page component

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";
import { OfflineMeshNotice } from "../components/offline_mesh_notice.slint";
import { ShieldOnboardingToggle } from "../anon_mode/shield_onboarding.slint";
import { AnonMode } from "../anon_mode/anon_mode_global.slint";

export component LoginPage inherits Rectangle {
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> pin: "";
    in-out property <string> server-url: "";
    // The endpoint this build is actually configured for (CHATTER_SERVER_URL,
    // or the compiled-in default). Seeded from Rust — never hardcode an IP
    // here; the previous literal was one dev's LAN address and was dead for
    // everyone else.
    in property <string> configured-server-url: "";
    in property <bool> loading: false;
    in property <string> error: "";
    // The server asked this login for a proof of work (an account with recent
    // failed attempts); the device is solving it, which can take seconds.
    in property <bool> verifying: false;
    // Live server reachability and the mesh escape hatch — see
    // `components/offline_mesh_notice.slint` for why this screen needs a way out
    // of itself at all.
    // Settled-unreachable, computed by chatter-core
    // (`ConnectionState::is_unreachable`) rather than string-matched here.
    in property <bool> server-unreachable: false;
    in property <bool> account-free-surfaces: false;
    // Set when login failed because this device has no Signal identity key and
    // the original is provably unrecoverable (no backup, or a destroyed one).
    // Only then is starting over the right offer — for a wrong PIN or an
    // unreachable server the real key is still out there, and chatter-core
    // refuses the reset rather than letting the UI decide.
    in property <bool> identity-reset-available: false;
    // Touch density for the Shield header control.
    in property <bool> touch: false;

    property <bool> submitted: false;
    property <float> arrival: 0;
    animate arrival { duration: Materials.motion-standard; easing: Materials.glide; }
    init => { root.arrival = 1; }
    property <length> error-nudge: 0px;
    changed error => {
        if root.error != "" {
            root.error-nudge = -8px;
            error-settle.start(); error-settle.restart();
        }
    }
    error-settle := Timer {
        interval: 16ms;
        running: false;
        triggered => { self.running = false; root.error-nudge = 0px; }
    }

    // Shared by the Sign In button and the keyboard's Done key on the
    // password and PIN fields.
    function submit() {
        if root.loading { return; }
        submitted = true;
        if username != "" && password != "" && server-url != "" {
            root.login(root.username, root.password, root.server-url, root.pin);
        }
    }

    callback login(string, string, string, string);
    callback register();
    callback go-to-recovery();
    callback go-to-link-device();
    callback continue-without-account();
    callback accept-new-identity();

    background: Materials.ambient;

    flick := Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;
        interactive: content.preferred-height > self.height;

        content := VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.none;
            // Centre the card: a max-width alone left-aligns it, so on a
            // tablet it sat against the left edge of a 1000dp+ screen.
            cross-axis-alignment: center;

            Rectangle { height: Spacing.xl * 2; }

            Rectangle {
                width: min(480px, flick.width - 2 * Spacing.lg);
                background: Colors.surface;
                border-radius: Spacing.radius-lg;
                transform-origin: { x: self.width / 2, y: 0px };
                transform-scale-x: 96% + root.arrival * 4%;
                transform-scale-y: 94% + root.arrival * 6%;
                opacity: 0.5 + root.arrival * 0.5;

                VerticalLayout {
                    spacing: Spacing.md;
                    padding: Spacing.lg;

                    ShieldOnboardingToggle {
                        busy: root.loading;
                        touch: root.touch;
                    }

                    Text {
                        text: "Chatter";
                        color: Colors.primary;
                        font-size: Typography.xxxl;
                        font-weight: Typography.bold;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Sign in to continue";
                        color: Colors.text-secondary;
                        font-size: Typography.base;
                        horizontal-alignment: center;
                    }

                    // Username
                    Input {
                        placeholder: "Username";
                        text <=> root.username;
                        disabled: root.loading;
                    }

                    // Password
                    Input {
                        placeholder: "Password";
                        password: true;
                        text <=> root.password;
                        disabled: root.loading;
                        accepted => { root.submit(); }
                    }

                    // PIN with explanation
                    VerticalLayout {
                        spacing: Spacing.xxs;

                        Input {
                            placeholder: "PIN";
                            password: true;
                            text <=> root.pin;
                            disabled: root.loading;
                            accepted => { root.submit(); }
                        }

                        Text {
                            text: "Your account PIN. Needed on a new device to restore your encryption keys.";
                            color: Colors.text-muted;
                            font-size: Typography.xxs;
                            wrap: word-wrap;
                        }
                    }

                    // Server URL (always visible — required for connection)
                    Input {
                        placeholder: "Server URL";
                        text <=> root.server-url;
                        disabled: root.loading;
                    }

                    HorizontalLayout {
                        spacing: Spacing.sm;

                        Button {
                            text: "Localhost";
                            variant: "secondary";
                            horizontal-stretch: 1;
                            disabled: root.loading;
                            clicked => { root.server-url = "http://localhost:50051"; }
                        }

                        Button {
                            text: "LAN";
                            variant: "secondary";
                            horizontal-stretch: 1;
                            disabled: root.loading;
                            clicked => { root.server-url = root.configured-server-url; }
                        }

                    }

                    if error != "": Rectangle {
                        min-height: error-copy.preferred-height + Spacing.sm * 2;
                        background: Colors.error.with-alpha(0.1);
                        border-radius: Spacing.radius-sm;
                        error-copy := Text {
                            x: Spacing.sm + root.error-nudge;
                            y: Spacing.sm;
                            width: parent.width - Spacing.sm * 2;
                            text: root.error;
                            color: Colors.error;
                            font-size: Typography.sm;
                            wrap: word-wrap;
                            animate x { duration: Materials.motion-quick; easing: Materials.spring; }
                        }
                    }

                    if root.loading && root.verifying: Text {
                        text: "Verifying this sign-in on your device… this can take a few seconds.";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    // Destructive and irreversible, so it is a deliberate
                    // second action rather than something login does for you.
                    if root.identity-reset-available: VerticalLayout {
                        spacing: Spacing.sm;

                        Text {
                            text: "Starting over gives this device new encryption keys. Your old messages stay unreadable, and each of your contacts will be asked to verify you again.";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                            wrap: word-wrap;
                        }

                        Button {
                            text: "Start over with new keys";
                            variant: "destructive";
                            disabled: root.loading;
                            clicked => { root.accept-new-identity(); }
                        }
                    }

                    // Next to the error, because when the server is down the
                    // error above is "failed to connect" and this is the rest of
                    // that sentence.
                    if root.server-unreachable: OfflineMeshNotice {
                        account-free-surfaces: root.account-free-surfaces;
                        continue-without-account => { root.continue-without-account(); }
                    }

                    // Forgot password
                    HorizontalLayout {
                        alignment: end;
                        Text {
                            text: "Forgot password?";
                            color: Colors.primary;
                            font-size: Typography.xs;
                            height: Spacing.touch-target-min;
                            vertical-alignment: center;
                            accessible-role: button;
                            accessible-action-default => { root.go-to-recovery(); }
                            TouchArea {
                                clicked => { root.go-to-recovery(); }
                            }
                        }
                    }

                    if root.loading && AnonMode.onboarding-progress != "": Text {
                        text: AnonMode.onboarding-progress;
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    // Login button
                    Button {
                        text: loading ? "" : "Sign in";
                        variant: "primary";
                        loading: root.loading;
                        disabled: root.loading;

                        clicked => { root.submit(); }
                    }

                    // Register link
                    HorizontalLayout {
                        alignment: center;
                        spacing: Spacing.xs;

                        Text {
                            text: "Don't have an account?";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                        }

                        Text {
                            text: "Register";
                            color: Colors.primary;
                            font-size: Typography.sm;
                            font-weight: Typography.medium;
                            height: Spacing.touch-target-min;
                            vertical-alignment: center;
                            accessible-role: button;
                            accessible-action-default => { root.register(); }

                            TouchArea {
                                clicked => { root.register(); }
                            }
                        }
                    }

                    // Link existing account on this device
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Link to an existing account on another device";
                            color: Colors.primary;
                            font-size: Typography.xs;
                            min-height: Spacing.touch-target-min;
                            vertical-alignment: center;
                            accessible-role: button;
                            accessible-action-default => { root.go-to-link-device(); }
                            wrap: word-wrap;
                            TouchArea {
                                clicked => { root.go-to-link-device(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: Spacing.xl; }
        }
    }
}
