import { Materials } from "../theme/materials.slint";
// Account Recovery page for entering recovery code and new credentials

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { Input } from "../components/input.slint";

export component AccountRecoveryPage inherits Rectangle {
    in-out property <string> username: "";
    in-out property <string> recovery-code: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in-out property <string> new-pin: "";
    in property <bool> loading: false;
    in property <string> error: "";
    in property <string> success: "";

    // Internal validation state
    property <bool> submitted: false;
    property <bool> username-empty: username == "";
    property <bool> recovery-code-empty: recovery-code == "";
    property <bool> new-password-empty: new-password == "";
    property <bool> confirm-password-empty: confirm-password == "";
    property <bool> new-pin-empty: new-pin == "";
    property <bool> passwords-match: new-password == confirm-password;
    property <bool> fields-valid: !username-empty && !recovery-code-empty && !new-password-empty && !confirm-password-empty && !new-pin-empty && passwords-match;
    property <float> arrival: 0;
    animate arrival { duration: Materials.motion-standard; easing: Materials.glide; }
    init => { root.arrival = 1; }
    property <length> error-nudge: 0px;
    changed error => {
        if root.error != "" {
            root.error-nudge = -8px;
            error-settle.restart();
        }
    }
    error-settle := Timer {
        interval: 16ms;
        running: false;
        triggered => { self.running = false; root.error-nudge = 0px; }
    }

    callback recover(string, string, string, string);  // username, recovery_code, new_password, new_pin
    callback go-to-login();

    background: Materials.ambient;

    // The form scrolls when the keyboard covers it (login.slint does the
    // same): five inputs plus the IME do not fit a phone.
    flick := Flickable {
        width: 100%;
        height: 100%;
        viewport-height: max(self.height, content.preferred-height);
        interactive: content.preferred-height > self.height;

    content := VerticalLayout {
        padding: Spacing.md;
        alignment: center;
        // Centre the card (see login.slint).
        cross-axis-alignment: center;

        Rectangle {
            width: min(480px, flick.width - 2 * Spacing.md);
            background: Colors.surface;
            border-radius: Spacing.radius-lg;
            transform-origin: { x: self.width / 2, y: 0px };
            transform-scale-x: 96% + root.arrival * 4%;
            transform-scale-y: 94% + root.arrival * 6%;
            opacity: 0.5 + root.arrival * 0.5;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;
                padding: Spacing.xl;

                // App logo/title
                Text {
                    text: "Chatter";
                    color: Colors.primary;
                    font-size: Typography.xxxl;
                    font-weight: Typography.bold;
                    horizontal-alignment: center;
                }

                // Subtitle
                Text {
                    text: "Account Recovery";
                    color: Colors.text-primary;
                    font-size: Typography.xl;
                    font-weight: Typography.semibold;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Enter a recovery code to reset your password and PIN";
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // Spacer
                Rectangle { height: Spacing.sm; }

                // Username field
                VerticalLayout {
                    spacing: Spacing.xs;

                    Text {
                        text: "Username";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                    }

                    Input {
                        placeholder: "Enter your username";
                        text <=> root.username;
                        disabled: root.loading;
                        error: submitted && username-empty;
                        error-message: submitted && username-empty ? "Username is required" : "";
                    }
                }

                // Recovery code field
                VerticalLayout {
                    spacing: Spacing.xs;

                    Text {
                        text: "Recovery Code";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                    }

                    Text {
                        text: "8 characters, uppercase letters and digits";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                    }

                    Input {
                        placeholder: "e.g., ABCD1234";
                        text <=> root.recovery-code;
                        disabled: root.loading;
                        error: submitted && recovery-code-empty;
                        error-message: submitted && recovery-code-empty ? "Recovery code is required" : "";
                    }
                }

                // Password fields
                VerticalLayout {
                    spacing: Spacing.md;

                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "New Password";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                        }

                        Input {
                            placeholder: "New password";
                            password: true;
                            text <=> root.new-password;
                            disabled: root.loading;
                            error: submitted && new-password-empty;
                            error-message: submitted && new-password-empty ? "Password is required" : "";
                        }
                    }

                    VerticalLayout {
                        spacing: Spacing.xs;

                        Text {
                            text: "Confirm Password";
                            color: Colors.text-secondary;
                            font-size: Typography.sm;
                        }

                        Input {
                            placeholder: "Confirm password";
                            password: true;
                            text <=> root.confirm-password;
                            disabled: root.loading;
                            error: submitted && (confirm-password-empty || (!confirm-password-empty && !passwords-match));
                            error-message: {
                                if submitted && confirm-password-empty {
                                    "Please confirm your password"
                                } else if submitted && !passwords-match {
                                    "Passwords do not match"
                                } else {
                                    ""
                                }
                            };
                        }
                    }
                }

                // PIN field
                VerticalLayout {
                    spacing: Spacing.xs;

                    Text {
                        text: "New recovery PIN";
                        color: Colors.text-secondary;
                        font-size: Typography.sm;
                    }

                    Text {
                        text: "Use at least 8 characters; keep it somewhere safe.";
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                    }

                    Input {
                        placeholder: "PIN (8+ characters)";
                        password: true;
                        text <=> root.new-pin;
                        disabled: root.loading;
                        error: submitted && new-pin-empty;
                        error-message: submitted && new-pin-empty ? "PIN is required (8+ characters)" : "";
                    }
                }

                // Success message display
                if success != "": Rectangle {
                    background: Colors.success.with-alpha(0.1);
                    border-radius: Spacing.radius-md;

                    HorizontalLayout {
                        padding: Spacing.md;

                        Text {
                            text: root.success;
                            color: Colors.success;
                            font-size: Typography.sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Error message display
                if error != "": Rectangle {
                    min-height: error-copy.preferred-height + Spacing.md * 2;
                    background: Colors.error.with-alpha(0.1);
                    border-radius: Spacing.radius-md;

                    error-copy := Text {
                        x: Spacing.md + root.error-nudge;
                        y: Spacing.md;
                        width: parent.width - Spacing.md * 2;
                        text: root.error;
                        color: Colors.error;
                        font-size: Typography.sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        animate x { duration: Materials.motion-quick; easing: Materials.spring; }
                    }
                }

                // Spacer
                Rectangle { height: Spacing.sm; }

                // Recover Account button
                Button {
                    text: loading ? "" : "Recover Account";
                    variant: "primary";
                    loading: root.loading;
                    disabled: root.loading || (submitted && !fields-valid);

                    clicked => {
                        submitted = true;
                        if fields-valid {
                            root.recover(root.username, root.recovery-code, root.new-password, root.new-pin);
                        }
                    }
                }

                // Back to login link
                HorizontalLayout {
                    alignment: center;
                    spacing: Spacing.xs;

                    Button {
                        text: "Back to Login";
                        variant: "ghost";
                        clicked => { root.go-to-login(); }
                    }
                }
            }
        }
    }
    }
}
