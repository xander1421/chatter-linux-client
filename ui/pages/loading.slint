// Loading page component with animated spinner and customizable messages

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component LoadingPage inherits Rectangle {
    in property <string> message: "Loading...";
    in property <string> secondary-message: "";

    background: Colors.background;

    // Centered content
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;

                // Animated spinner (three dots with wave animation)
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    property <float> anim-progress;

                    // Three dots with staggered vertical position using cosine wave
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Colors.primary;
                        y: -6px * Math.cos(anim-progress * 360deg);
                    }
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Colors.primary;
                        y: -6px * Math.cos((anim-progress - 0.33) * 360deg);
                    }
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Colors.primary;
                        y: -6px * Math.cos((anim-progress - 0.66) * 360deg);
                    }

                    anim-progress: 0;
                    animate anim-progress {
                        duration: 1200ms;
                        iteration-count: -1;
                    }

                    init => {
                        self.anim-progress = 1.0;
                    }
                }

                // Primary message
                Text {
                    text: root.message;
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    horizontal-alignment: center;
                }

                // Secondary message (only shown if not empty)
                if secondary-message != "": Text {
                    text: root.secondary-message;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
