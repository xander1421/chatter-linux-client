import { Materials } from "../theme/materials.slint";
import { Appearance } from "../theme/appearance.slint";
// Loading page component with animated spinner and customizable messages

import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";

export component LoadingPage inherits Rectangle {
    in property <string> message: "Loading...";
    in property <string> secondary-message: "";

    background: Materials.ambient;

    // Centered content
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                alignment: center;
                spacing: Spacing.lg;

                // A small pool and three droplets; the pool remains visible
                // when motion is reduced, so loading is never a blank screen.
                Rectangle {
                    width: 124px;
                    height: 58px;
                    background: transparent;
                    property <float> anim-progress: 0;
                    animate anim-progress {
                        duration: Materials.motion-emphasized;
                        easing: Materials.settle;
                        iteration-count: Appearance.reduce-motion ? 1 : -1;
                    }
                    init => { self.anim-progress = 1; }

                    Rectangle {
                        x: 12px;
                        y: 37px;
                        width: 100px;
                        height: 14px;
                        border-radius: 7px;
                        background: Colors.primary.with-alpha(0.16);
                    }
                    for dot[i] in [0, 1, 2]: Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        x: 35px + i * 21px;
                        y: 30px - 16px * max(0, Math.cos((parent.anim-progress - i * 0.28) * 360deg));
                        background: Colors.primary;
                    }
                }

                // Primary message
                Text {
                    text: root.message;
                    color: Colors.text-primary;
                    font-size: Typography.lg;
                    horizontal-alignment: center;
                }

                // Secondary message (only shown if not empty)
                if secondary-message != "": Text {
                    text: root.secondary-message;
                    color: Colors.text-secondary;
                    font-size: Typography.sm;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
