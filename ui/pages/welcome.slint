import { Materials } from "../theme/materials.slint";
import { Colors } from "../theme/colors.slint";
import { Spacing } from "../theme/spacing.slint";
import { Typography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { Button } from "../components/button.slint";

export component WelcomePage inherits Rectangle {
    in property <string> display-name: "there";
    in property <bool> touch;

    callback add-friends();
    callback browse-channels();
    callback get-started();

    background: Colors.background;

    private property <float> reveal: 0;
    animate reveal { duration: Materials.motion-emphasized; easing: Materials.spring; }
    init => { root.reveal = 1; }

    flick := Flickable {
        width: 100%;
        height: 100%;
        viewport-height: max(self.height, content.preferred-height);
        viewport-width: self.width;
        interactive: content.preferred-height > self.height;

        content := VerticalLayout {
            height: flick.viewport-height;
            alignment: center;
            cross-axis-alignment: center;
            spacing: Spacing.panel-gutter;
            padding: Spacing.panel-gutter;
            opacity: root.reveal;

            Rectangle {
                width: min(400px, flick.width - 2 * Spacing.panel-gutter);
                background: Colors.surface-card;
                border-radius: Spacing.radius-panel;

                VerticalLayout {
                    padding: Spacing.sm;
                    spacing: Spacing.sm;

                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: Icons.shield;
                            width: 20px;
                            height: 20px;
                            colorize: Colors.text-secondary;
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: @tr("Welcome to Chatter!");
                        color: Colors.text-primary;
                        font-size: Typography.sm;
                        font-weight: Typography.semibold;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Hi {}, your account is ready.", root.display-name);
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("All messages are end-to-end encrypted");
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                width: min(400px, flick.width - 2 * Spacing.panel-gutter);
                background: Colors.surface-card;
                border-radius: Spacing.radius-panel;

                VerticalLayout {
                    padding: Spacing.sm;
                    spacing: Spacing.sm;

                    Text {
                        text: @tr("Get started").to-uppercase();
                        color: Colors.text-muted;
                        font-size: Typography.xxs;
                        font-weight: Typography.semibold;
                        letter-spacing: self.font-size * 0.06;
                    }

                    Button {
                        text: @tr("Add friends");
                        accessible-description: @tr("Find people you know on Chatter");
                        icon: Icons.user-plus;
                        variant: "secondary";
                        border-radius: Spacing.radius-control;
                        touch: root.touch;
                        clicked => { root.add-friends(); }
                    }
                    Text {
                        text: @tr("Find people you know on Chatter");
                        accessible-role: none;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Browse channels");
                        accessible-description: @tr("Join public conversations");
                        icon: Icons.hash;
                        variant: "secondary";
                        border-radius: Spacing.radius-control;
                        touch: root.touch;
                        clicked => { root.browse-channels(); }
                    }
                    Text {
                        text: @tr("Join public conversations");
                        accessible-role: none;
                        color: Colors.text-muted;
                        font-size: Typography.xs;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Continue to Chatter");
                        border-radius: Spacing.radius-control;
                        touch: root.touch;
                        clicked => { root.get-started(); }
                    }
                }
            }
        }
    }
}
