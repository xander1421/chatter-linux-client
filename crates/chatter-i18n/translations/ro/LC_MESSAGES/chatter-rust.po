#: crates/chatter-core/src/client/membership.rs:161
msgid "Verified revision {}, state code {}."
msgstr "Revizia verificată: {}, cod de stare: {}."

#: crates/chatter-core/src/client/membership.rs:171
msgid "Membership not verified yet — sending is paused"
msgstr "Lista de membri nu este verificată încă — trimiterea este suspendată"

#: crates/chatter-core/src/client/membership.rs:172
msgid ""
"This device has no verified member list for this channel yet, so it does not "
"know who may receive your messages. Sending resumes once the channel's "
"signed membership log verifies."
msgstr ""
"Acest dispozitiv nu are încă o listă verificată de membri pentru acest "
"canal, așa că nu știe cine poate primi mesajele tale. Trimiterea se reia "
"când jurnalul semnat al membrilor canalului este verificat."

#: crates/chatter-core/src/client/membership.rs:179
msgid "Membership could not be verified — sending is paused"
msgstr "Lista de membri nu a putut fi verificată — trimiterea este suspendată"

#: crates/chatter-core/src/client/membership.rs:182
msgid ""
"A change to this channel's member list was not signed by someone allowed to "
"make it, or did not match the list this device holds. It was not applied, "
"and nobody it named receives your messages. Sending resumes when a later "
"change verifies. {}"
msgstr ""
"O modificare a listei de membri a acestui canal nu a fost semnată de cineva "
"care avea voie să o facă, sau nu se potrivea cu lista de pe acest "
"dispozitiv. Nu a fost aplicată, iar nimeni dintre cei numiți nu primește "
"mesajele tale. Trimiterea se reia când o modificare ulterioară este "
"verificată. {}"

#: crates/chatter-core/src/client/membership.rs:190
msgid "The server is showing members different member lists"
msgstr "Serverul le arată membrilor liste de membri diferite"

#: crates/chatter-core/src/client/membership.rs:191
msgid ""
"Another member, or the server's log, has a different member list at a "
"revision this device already verified. Sending stays paused for this channel "
"until you resume it. Compare the state code below with another member over a "
"channel you trust first: resuming sends only to the members this device "
"verified, and a new mismatch pauses it again. {}"
msgstr ""
"Un alt membru, sau jurnalul serverului, are o listă de membri diferită la o "
"revizie pe care acest dispozitiv a verificat-o deja. Trimiterea rămâne "
"suspendată pe acest canal până o reiei. Compară mai întâi codul de stare de "
"mai jos cu un alt membru, pe un canal în care ai încredere: dacă reiei, se "
"trimite doar membrilor verificați de acest dispozitiv, iar o nepotrivire "
"nouă suspendă trimiterea din nou. {}"

