{
  "source": "localPackages/BitFoundation/Sources/BitFoundation/CompressionUtil.swift + Constants.swift",
  "derivation": "should_compress values computed by hand from the Swift expression `Set(data).count / min(count,256) < 0.9` with threshold 100. decompress inputs are RAW DEFLATE (RFC 1951) streams produced by python zlib.compressobj(9, DEFLATED, -15); Apple's COMPRESSION_ZLIB through compression_encode_buffer emits the same framing (no 2-byte zlib header, no adler32 trailer) though not necessarily the same bytes. An implementation using zlib framing fails these.",
  "should_compress": [
    {
      "name": "empty",
      "input_hex": "",
      "expected": false,
      "unique_bytes": 0,
      "sample_size": 0,
      "note": "Below threshold."
    },
    {
      "name": "99_identical_bytes",
      "input_hex": "414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141",
      "expected": false,
      "unique_bytes": 1,
      "sample_size": 99,
      "note": "PRIORITY: one below Constants.compressionThresholdBytes = 100."
    },
    {
      "name": "100_identical_bytes",
      "input_hex": "41414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141",
      "expected": true,
      "unique_bytes": 1,
      "sample_size": 100,
      "note": "PRIORITY: exactly at the threshold; `>=` means this one compresses."
    },
    {
      "name": "101_identical_bytes",
      "input_hex": "4141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141",
      "expected": true,
      "unique_bytes": 1,
      "sample_size": 101,
      "note": "PRIORITY: above the threshold."
    },
    {
      "name": "219_distinct_bytes",
      "input_hex": "",
      "expected": false,
      "unique_bytes": 219,
      "sample_size": 219,
      "note": "PRIORITY: uniqueRatio = 219/219 = 1.0, not < 0.9 -> refused."
    },
    {
      "name": "256_distinct_bytes",
      "input_hex": "",
      "expected": false,
      "unique_bytes": 256,
      "sample_size": 256,
      "note": "uniqueRatio = 256/256 = 1.0 -> refused."
    },
    {
      "name": "512_bytes_two_cycles_of_256",
      "input_hex": "",
      "expected": false,
      "unique_bytes": 256,
      "sample_size": 256,
      "note": "The asymmetry that matters: uniqueByteCount counts the WHOLE payload (256) while sampleSize is capped at 256, so ratio = 1.0 -> refused, even though the payload is trivially compressible."
    },
    {
      "name": "300_bytes_230_distinct",
      "input_hex": "",
      "expected": true,
      "unique_bytes": 230,
      "sample_size": 256,
      "note": "uniqueByteCount = 230 over sampleSize 256 -> 0.898 < 0.9 -> compress. Sits one unique byte below the cutoff."
    },
    {
      "name": "300_bytes_231_distinct",
      "input_hex": "",
      "expected": false,
      "unique_bytes": 231,
      "sample_size": 256,
      "note": "uniqueByteCount = 231 over sampleSize 256 -> 0.902 -> refused. The neighbour of the previous case, on the other side of the line."
    }
  ],
