      "check_encode": true,
      "check_decode": true,
      "derivation": "Hand-encoded; Flags.isRSR = 0x10 per BinaryProtocol.Flags."
    },
    {
      "name": "v2_no_route",
      "note": "v2 header is 16 bytes: the payload-length field widens from 2 to 4. HAS_ROUTE stays clear when there is no route.",
      "packet": {
        "version": 2,
        "msg_type": 2,
        "ttl": 5,
        "timestamp": 1750000000000,
        "sender_id": "0011223344556677",
        "recipient_id": "8899aabbccddeeff",
        "payload_hex": "76322d6e6f2d726f757465",
