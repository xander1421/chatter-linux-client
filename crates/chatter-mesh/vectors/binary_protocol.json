      },
      "padding": false,
      "encoded_hex": "0102030000018bcfe5680009000a00112233445566778899aabbccddeeff73747261792d666c6167",
      "check_encode": false,
      "check_decode": true,
      "derivation": "Built by hand: the v1_basic frame shape with the flags byte forced to 0x09 and NO route bytes present, because BinaryProtocol.decode gates hasRoute on `version >= 2` before reading anything (line 320)."
    },
    {
      "name": "v1_high_entropy_payload_not_compressed",
      "note": "PRIORITY: 219 bytes is well over the 100-byte threshold, but all 219 bytes are distinct so uniqueRatio = 1.0 >= 0.9 and shouldCompress returns false. The payload must appear verbatim, IS_COMPRESSED clear.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 3,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": null,
        "payload_hex": "",
        "signature_hex": null,
        "route": null,
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Payload is bytes 0x00..0xDA. shouldCompress: uniqueByteCount = 219, sampleSize = min(219,256) = 219, ratio = 1.0, not < 0.9 -> false."
    },
    {
      "name": "v1_padding_refuses_when_gap_exceeds_255",
      "note": "PRIORITY: the same 241-byte frame with padding requested. optimalBlockSize(241) = 512 because 241+16 > 256, and pad() then refuses because 512-241 = 271 > 255. The frame goes out unpadded -- identical bytes to the padding:false vector above.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 3,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": null,
        "payload_hex": "",
        "signature_hex": null,
        "route": null,
        "is_rsr": false
      },
      "padding": true,
      "encoded_hex": "",
      "check_encode": true,
      "check_decode": true,
      "derivation": "MessagePadding.optimalBlockSize(241): 241+16 = 257 > 256, <= 512 -> 512. MessagePadding.pad: paddingNeeded = 271, guard paddingNeeded <= 255 fails -> returns data unchanged."
    },
    {
      "name": "v1_payload_99_bytes_uncompressed",
      "note": "PRIORITY: 99 bytes is one below Constants.compressionThresholdBytes (100), so a maximally compressible payload still ships raw. An implementation built from BinaryProtocol's doc comment ('payloads > 256 bytes') would agree here and disagree at 100.",
