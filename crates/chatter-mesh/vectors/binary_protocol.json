      "padding": false,
      "encoded_hex": "02020500000192cc091400090000000800112233445566778899aabbccddeeff02aabbcc00000000008899aabbccddeeff7061642d74657374",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Field values from BinaryProtocolTests.packetWithRoutePadsShortHop (hop 0xAABBCC); zero-padding per BinaryProtocol.encode lines 156-162."
    },
    {
      "name": "v1_route_dropped_on_encode",
      "note": "A v1 packet carrying a route must encode without it and without the HAS_ROUTE flag. Encode-only: decoding these bytes yields route = null, which is not equal to the input packet.",
      "packet": {
        "version": 1,
        "msg_type": 1,
        "ttl": 6,
        "timestamp": 1720000000000,
        "sender_id": "0102030405060708",
        "recipient_id": "1112131415161718",
        "payload_hex": "76312d6e6f2d726f757465",
        "signature_hex": null,
        "route": [
          "0102030405060708",
          "1112131415161718"
        ],
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "0101060000019077fd300001000b0102030405060708111213141516171876312d6e6f2d726f757465",
      "check_encode": true,
      "check_decode": false,
      "derivation": "Field values from BinaryProtocolTests.v1PacketIgnoresRouteOnEncode; bytes hand-encoded. `originalRoute` is gated on version >= 2 (BinaryProtocol.swift:154)."
    },
    {
      "name": "v1_has_route_flag_ignored_on_decode",
      "note": "PRIORITY: a v1 frame with HAS_ROUTE (0x08) set must have the flag ignored, not treated as an error and not consumed as route bytes. Decode-only: re-encoding produces flags 0x01.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 3,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": "8899aabbccddeeff",
        "payload_hex": "73747261792d666c6167",
        "signature_hex": null,
