    {
      "name": "v2_routed_three_hops",
      "note": "Source-routed v2 frame. Route is a 1-byte hop count followed by 3 x 8 bytes, placed after the recipient and BEFORE the payload. payloadLength in the header is 10 -- the payload only -- while 25 route bytes ride outside it.",
      "packet": {
        "version": 2,
        "msg_type": 1,
        "ttl": 6,
        "timestamp": 1720000000000,
        "sender_id": "0102030405060708",
        "recipient_id": "2122232425262728",
        "payload_hex": "726f7574652d74657374",
        "signature_hex": null,
        "route": [
          "0102030405060708",
          "1112131415161718",
          "2122232425262728"
        ],
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "0201060000019077fd3000090000000a0102030405060708212223242526272803010203040506070811121314151617182122232425262728726f7574652d74657374",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Field values from BinaryProtocolTests.packetWithRouteRoundTrip; bytes hand-encoded per BinaryProtocol.encode lines 223-228.",
      "header_payload_length": 10
    },
    {
      "name": "v2_route_short_hop_zero_padded",
      "note": "A route hop shorter than 8 bytes is right-padded with zeros, never truncated or rejected. The packet here already carries the padded form because our hops are fixed 8-byte arrays.",
      "packet": {
        "version": 2,
        "msg_type": 2,
        "ttl": 5,
        "timestamp": 1730000000000,
        "sender_id": "0011223344556677",
        "recipient_id": "8899aabbccddeeff",
        "payload_hex": "7061642d74657374",
        "signature_hex": null,
        "route": [
          "aabbcc0000000000",
