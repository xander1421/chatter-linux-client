{
  "source": "localPackages/BitFoundation/Sources/BitFoundation/BinaryProtocol.swift + Tests/BitFoundationTests/BinaryProtocolTests.swift",
  "note": "check_encode/check_decode say which directions apply. Vectors with both true are exact round trips.",
  "vectors": [
    {
      "name": "v1_minimal_empty_payload",
      "note": "The exact 22-byte frame BinaryProtocolTests.boundaryConditions builds byte-by-byte as its 'minimum valid size' case. Its comment says 21 bytes; the literal it actually appends is 22 (14-byte header + 8-byte sender).",
      "packet": {
        "version": 1,
        "msg_type": 1,
        "ttl": 10,
        "timestamp": 0,
        "sender_id": "0101010101010101",
        "recipient_id": null,
        "payload_hex": "",
        "signature_hex": null,
        "route": null,
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "01010a00000000000000000000000101010101010101",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Transcribed verbatim from BinaryProtocolTests.swift:784-801."
    },
    {
      "name": "v1_basic_unpadded",
      "note": "Baseline v1 frame: 14-byte header, 8-byte sender, no recipient, no signature, uncompressed 12-byte payload. flags = 0x00.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 3,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": null,
        "payload_hex": "74657374207061796c6f6164",
        "signature_hex": null,
        "route": null,
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "0102030000018bcfe5680000000c001122334455667774657374207061796c6f6164",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Hand-encoded per BinaryProtocol.encode: version|type|ttl|ts_be64|flags|len_be16|sender. 14+8+12 = 34 bytes."
    },
    {
      "name": "v1_basic_padded",
      "note": "Same packet with padding on: 34 bytes -> optimalBlockSize(34) = 256 -> 222 PKCS#7 bytes of value 0xDE appended.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 3,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": null,
        "payload_hex": "74657374207061796c6f6164",
        "signature_hex": null,
        "route": null,
        "is_rsr": false
      },
      "padding": true,
      "encoded_hex": "",
      "check_encode": true,
      "check_decode": true,
      "derivation": "optimalBlockSize(34): 34+16=50 <= 256. pad appends 256-34 = 222 bytes of 0xDE (222 = 0xDE)."
    },
    {
      "name": "v1_recipient_and_signature",
      "note": "flags = 0x03 (HAS_RECIPIENT|HAS_SIGNATURE). The 64 signature bytes sit after the payload, outside payloadLength.",
      "packet": {
        "version": 1,
        "msg_type": 17,
        "ttl": 7,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": "8899aabbccddeeff",
        "payload_hex": "6869",
        "signature_hex": "abababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab",
        "route": null,
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "0111070000018bcfe5680003000200112233445566778899aabbccddeeff6869abababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Hand-encoded. payloadLength = 2 (payload only); signature and recipient are never counted in it. Signature value 0xAB x 64 is TestConstants.testSignature."
    },
    {
      "name": "v1_broadcast_recipient",
      "note": "Explicit all-0xFF broadcast recipient. flags = 0x01: the field is present and its value is the broadcast address.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 4,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": "ffffffffffffffff",
        "payload_hex": "68656c6c6f206d657368",
        "signature_hex": null,
        "route": null,
        "is_rsr": false
      },
      "padding": false,
      "encoded_hex": "0102040000018bcfe5680001000a0011223344556677ffffffffffffffff68656c6c6f206d657368",
      "check_encode": true,
      "check_decode": true,
      "derivation": "Hand-encoded."
    },
    {
      "name": "v1_absent_recipient",
      "note": "Byte-for-byte the previous packet with the recipient field omitted entirely: flags 0x00 and 8 fewer bytes. Absent is not broadcast.",
      "packet": {
