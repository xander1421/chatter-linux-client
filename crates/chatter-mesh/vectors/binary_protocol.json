      "derivation": "Hand-encoded."
    },
    {
      "name": "v1_is_rsr_flag",
      "note": "IS_RSR is flag bit 0x10 and is orthogonal to the others; here combined with HAS_RECIPIENT for flags = 0x11.",
      "packet": {
        "version": 1,
        "msg_type": 2,
        "ttl": 0,
        "timestamp": 1700000000000,
        "sender_id": "0011223344556677",
        "recipient_id": "8899aabbccddeeff",
        "payload_hex": "73796e632d616e73776572",
