{
  "area": "Relay-to-client frame parsing (NIP-01)",
  "source": "bitchat/Nostr/NostrRelayManager.swift (private enum ParsedInbound)",
  "note": "bitchat's ParsedInbound handles EVENT, EOSE, OK and NOTICE and returns nil for everything else - including CLOSED, which it silently drops. The CLOSED vector is therefore marked tolerant: a parser may surface it or ignore it, but must not panic and must not mistake it for another frame.",
  "well_formed": [
    {
      "name": "event",
      "kind": "event",
      "frame": "[\"EVENT\",\"sub1\",{\"id\":\"aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91\",\"pubkey\":\"007e6b733d0044dd63e6f110079b9ff53ebce38712b17e755e97ced9a3cdfb01\",\"created_at\":1700000000,\"kind\":20000,\"tags\":[[\"g\",\"u4pru\"]],\"content\":\"hello mesh\",\"sig\":\"7066b0d94037d73aa38da340377ffeb6d44a513f2e08d29365550955977ca5a61ed8914ae738bafd4040b47f12459b31e547c8485ecf1686301d3cb41e3b6c11\"}]",
      "subscription_id": "sub1",
      "event_id": "aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91",
      "derivation": "Frame shape transcribed from ParsedInbound; the embedded event is events.json/geohash_chat_minimal, signature included."
    },
    {
      "name": "eose",
      "kind": "eose",
      "frame": "[\"EOSE\",\"sub1\"]",
      "subscription_id": "sub1",
      "derivation": "Transcribed from ParsedInbound: array.count >= 2 with a string at index 1."
    },
    {
      "name": "ok_accepted",
      "kind": "ok",
      "frame": "[\"OK\",\"aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91\",true,\"\"]",
      "event_id": "aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91",
      "accepted": true,
      "message": "",
      "derivation": "Transcribed from ParsedInbound."
    },
    {
      "name": "ok_rejected",
      "kind": "ok",
      "frame": "[\"OK\",\"aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91\",false,\"blocked: pubkey not allowed\"]",
      "event_id": "aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91",
      "accepted": false,
      "message": "blocked: pubkey not allowed",
      "derivation": "Transcribed from ParsedInbound."
    },
    {
      "name": "ok_without_reason",
      "kind": "ok",
      "frame": "[\"OK\",\"aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91\",true]",
      "event_id": "aa2c5f2a045ba3fb2deef15c1af4467755989b117089a038949270ec564bba91",
      "accepted": true,
      "message": null,
      "derivation": "ParsedInbound accepts a 3-element OK and substitutes \"no reason given\"."
    },
    {
      "name": "notice",
      "kind": "notice",
      "frame": "[\"NOTICE\",\"rate limited\"]",
      "message": "rate limited",
      "derivation": "Transcribed from ParsedInbound."
    },
    {
      "name": "closed",
      "kind": "closed",
      "frame": "[\"CLOSED\",\"sub1\",\"error: bad filter\"]",
      "subscription_id": "sub1",
      "message": "error: bad filter",
      "tolerant": true,
      "derivation": "NIP-01 CLOSED. bitchat's parser has no case for it and drops it."
    }
  ],
