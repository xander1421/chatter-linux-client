  "relay_urls": {
    "source": "bitchat/Nostr/NostrRelayURL.swift (normalized / directoryAddress)",
    "note": "`directory_address` is what GeoRelayDirectory.parseCSV stores as the host for each CSV row, so these govern how the bundled relay list is read. The `:443` cases matter: the default port for the wss scheme is dropped, so a CSV row written as host:443 is stored WITHOUT the port and must compare equal to the same host written bare.",
    "derivation": "Hand-evaluated from NostrRelayURL.swift: scheme lowercased and mapped (wss/https -> wss, ws/http -> ws), host lowercased, the scheme's default port dropped, a bare \"/\" path emptied, fragment dropped. The raw values with :443 are transcribed from relays/online_relays_gps.csv.",
    "normalize": [
      {
        "raw": "wss://relay.damus.io",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io"
      },
      {
        "raw": "relay.damus.io",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io"
      },
      {
        "raw": "relay.damus.io",
        "default_scheme": null,
        "expected": null,
        "why": "no scheme in the input and no default supplied"
      },
      {
        "raw": "https://relay.damus.io",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io",
        "why": "https is mapped onto wss"
      },
      {
        "raw": "http://relay.damus.io",
        "default_scheme": "wss",
        "expected": "ws://relay.damus.io",
        "why": "http is mapped onto ws"
      },
      {
        "raw": "WSS://Relay.Damus.IO",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io",
        "why": "scheme and host are lowercased"
      },
      {
        "raw": "wss://relay.damus.io:443",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io",
        "why": "443 is the default port for wss and is dropped"
      },
      {
        "raw": "ws://relay.damus.io:80",
        "default_scheme": "wss",
        "expected": "ws://relay.damus.io",
        "why": "80 is the default port for ws and is dropped"
      },
      {
        "raw": "wss://relay.damus.io:7777",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io:7777",
        "why": "a non-default port is kept"
      },
      {
        "raw": "wss://relay.damus.io/",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io",
        "why": "a bare / path is emptied"
      },
      {
        "raw": "wss://relay.damus.io/nostr",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io/nostr",
        "why": "a real path is kept"
      },
      {
        "raw": "wss://relay.damus.io#frag",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io",
        "why": "the fragment never reaches the wire"
      },
      {
        "raw": "  relay.damus.io  ",
        "default_scheme": "wss",
        "expected": "wss://relay.damus.io",
        "why": "surrounding whitespace is trimmed"
      },
      {
        "raw": "",
        "default_scheme": "wss",
        "expected": null,
        "why": "empty"
      },
      {
        "raw": "   ",
        "default_scheme": "wss",
        "expected": null,
        "why": "whitespace only"
      },
      {
        "raw": "ftp://relay.damus.io",
        "default_scheme": "wss",
        "expected": null,
        "why": "only ws/wss/http/https are accepted"
      },
      {
        "raw": "wss://",
        "default_scheme": "wss",
        "expected": null,
        "why": "no host"
      }
    ],
    "directory_address": [
      {
        "raw": "relay.lab.rytswd.com",
        "expected": "relay.lab.rytswd.com",
        "source": "relays/online_relays_gps.csv row 1"
      },
      {
        "raw": "relay.paulstephenborile.com:443",
        "expected": "relay.paulstephenborile.com",
        "source": "relays/online_relays_gps.csv row 2",
        "why": "the explicit :443 is the wss default and is stripped"
      },
      {
        "raw": "relay.binaryrobot.com",
        "expected": "relay.binaryrobot.com",
        "source": "relays/online_relays_gps.csv row 3"
      },
      {
        "raw": "nostr-2.21crypto.ch",
        "expected": "nostr-2.21crypto.ch",
        "source": "relays/online_relays_gps.csv row 4"
      },
      {
        "raw": "spookstr2.nostr1.com:443",
        "expected": "spookstr2.nostr1.com",
        "source": "relays/online_relays_gps.csv row 5"
      },
      {
        "raw": "wss://relay.zone667.com",
        "expected": "relay.zone667.com",
        "source": "Derived: an explicit scheme is stripped back off."
      },
      {
        "raw": "not a host",
        "expected": null,
        "source": "Derived: spaces are not valid in a host."
      }
    ]
  }
